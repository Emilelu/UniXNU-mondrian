+/* K60_SMMU_L1: one 4 KiB LPAE level-1 table for the SE stage-1 identity map.
+ * Declared here because k60_se_smmu_identity_map() (defined below) uses it. */
+/* Forward declarations for the SPMI helpers used by stage20. The definitions
+ * and the other forward declarations sit below this block. The mapping
+ * variables are only needed by the definitions, not here. */
+static int k60_spmi_find(uint16_t ppid, uint16_t *out_apid);
+static bool k60_spmi_read(uint16_t apid, uint8_t reg, uint8_t *buf, uint32_t len);
