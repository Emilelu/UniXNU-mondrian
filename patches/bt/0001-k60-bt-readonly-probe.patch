diff --git a/bsd/dev/qbt_k60.c b/bsd/dev/qbt_k60.c
index 4b07f72..c20d6e6 100644
--- a/bsd/dev/qbt_k60.c
+++ b/bsd/dev/qbt_k60.c
@@ -1004,6 +1004,236 @@ static void k60_xo_release(void) {
     k60_gpio_output(K60_BT_XO_GPIO, false, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
 }
 
+/* ------------------------------------------------------------------------- */
+/* S1c probe: delayed, marker-by-marker read-only GENI checkpoint              */
+/* Spec: docs/research/bt/S1-PROBE-SPEC.md.  Every risky access is announced  */
+/* before it happens, so a hang leaves the fatal step as the last console     */
+/* line instead of a silent zero-byte boot.                                   */
+/* ------------------------------------------------------------------------- */
+
+/* GENI SE register map: evidence linux-geni-se-v6.6.h:78-86 (0x40/0x64/0x68),
+ * :132-134 (FW_REV_PROTOCOL), qcom-geni-se.c:114 (QUP_HW_VER_REG 0x4),
+ * linux-geni-se-v6.6.h:287 (QUP_SE_VERSION_2_5).  0x2ac/0xc40/0xd40/0xe40
+ * decide 06-DEEP-DIVE.md F2/F3. */
+#define K60_SE_GENI_STATUS          0x040u
+#define K60_GENI_IF_DISABLE_RO      0x064u
+#define K60_GENI_FW_REVISION_RO     0x068u
+#define K60_QUP_HW_VER_REG          0x004u
+#define K60_G_MANUAL_RFR            0x2ACu
+#define K60_SE_DMA_TX_IRQ_STAT      0xC40u
+#define K60_SE_DMA_RX_IRQ_STAT      0xD40u
+#define K60_SE_RSVD_0E40            0xE40u
+
+/* SE20 root clock = gcc_qupv3_wrap2_s5_clk_src: cmd_rcgr 0x2e618, vendor
+ * k60-android-gcc-waipio.c:1370-1387 (mnd_width 16, hid_width 5,
+ * clk_rcg2_ops, enable_safe_config).  Linux clk-rcg2.c:24-31 CMD_UPDATE
+ * BIT(0) / CMD_ROOT_EN BIT(1) / CMD_ROOT_OFF BIT(31); clk-rcg2.c:64-75 the
+ * RCG counts as enabled only while ROOT_OFF is clear; clk-rcg2.c:981-1002 the
+ * force-enable path writes ROOT_EN and polls is_enabled.  The touch line had
+ * to do exactly this for QUP0 SE4 before its first SE read
+ * (patches/xnu/zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-pong-touch-console.patch:307-339).
+ * 0500 never touches this register before k60_bt_power_on(), so the probe
+ * inspects it (s5), turns the root on (s6) and programs TCXO/1 (s7). */
+#define K60_SE20_RCG_CMD            (K60_GCC_WRAP2_SE20_CMD_RCGR + 0x00u)
+#define K60_SE20_RCG_CFG            (K60_GCC_WRAP2_SE20_CMD_RCGR + 0x04u)
+#define K60_SE20_RCG_DFSR           (K60_GCC_WRAP2_SE20_CMD_RCGR + 0x14u)
+#define K60_RCG_CMD_UPDATE          (1u << 0)
+#define K60_RCG_CMD_ROOT_EN         (1u << 1)
+#define K60_RCG_CMD_ROOT_OFF        (1u << 31)
+/* CFG divider / source / mode / hw-ctl mask, clk-rcg2.c:33-40. */
+#define K60_RCG_CFG_MASK            0x371fu
+#define K60_RCG_CFG_HW_CTRL         (1u << 20)
+
+#define K60_PROBE_DELAY_SECS        20u
+#define K60_PROBE_MAX_DELAY_SECS    120u
+#define K60_PROBE_MAX_STEP          9u
+#define K60_PROBE_DRAIN_US          2000u
+
+static void k60_probe_mark(const char *step) {
+    k60_log(NULL, 1, step);
+    /* Let the CDC ring drain before the next register access: if that access
+     * wedges the bus, this line is already on the host side. */
+    IODelay(K60_PROBE_DRAIN_US);
+}
+
+static void k60_probe_u32(const char *tag, uint32_t value) {
+    char line[160];
+    snprintf(line, sizeof(line), "probe: %s=%08x", tag, value);
+    k60_log(NULL, 1, line);
+    IODelay(K60_PROBE_DRAIN_US);
+}
+
+static int k60_bt_probe(unsigned step) {
+    char line[192];
+
+    k60_probe_mark("probe: s1 map gcc/uart/qup");
+    int e = k60_map(&k60.gcc, K60_GCC_BASE, K60_GCC_SIZE);
+    if (!e) e = k60_map(&k60.uart, K60_BT_UART_BASE, K60_BT_UART_SIZE);
+    if (!e) e = k60_map(&k60.qup, K60_BT_QUP_WRAPPER_BASE, K60_BT_QUP_WRAPPER_SIZE);
+    if (e) {
+        snprintf(line, sizeof(line), "probe: map failed e=%d", e);
+        k60_log(NULL, 1, line);
+        return e;
+    }
+    snprintf(line, sizeof(line), "probe: s1 mapped gcc=%llx uart=%llx qup=%llx step=%u",
+             (unsigned long long)(uintptr_t)k60.gcc.va,
+             (unsigned long long)(uintptr_t)k60.uart.va,
+             (unsigned long long)(uintptr_t)k60.qup.va, step);
+    k60_log(NULL, 1, line);
+    IODelay(K60_PROBE_DRAIN_US);
+
+    if (step >= 2) {
+        k60_probe_mark("probe: s2 read gpll0_cmd");
+        uint32_t v = k60_read32(&k60.gcc, K60_GCC_GPLL0_CMD);
+        k60_probe_u32("s2 gpll0_cmd", v);
+        k60_probe_mark("probe: s2 write gpll0_cmd");
+        k60_write32(&k60.gcc, K60_GCC_GPLL0_CMD, v | 1u);
+        k60_probe_mark("probe: s2 poll gpll0 lock");
+        unsigned spins = 0, locked = 0;
+        for (; spins < 1000; spins++) {
+            if (k60_read32(&k60.gcc, 0x0u) & (1u << 31)) { locked = 1; break; }
+            IODelay(1);
+        }
+        snprintf(line, sizeof(line), "probe: s2 locked=%u spins=%u", locked, spins);
+        k60_log(NULL, 1, line);
+        IODelay(K60_PROBE_DRAIN_US);
+        if (!locked) return -ETIMEDOUT;
+    }
+
+    if (step >= 3) {
+        k60_probe_mark("probe: s3 read qup vote");
+        uint32_t v = k60_read32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE);
+        k60_probe_u32("s3 qup_vote_before", v);
+        k60_probe_mark("probe: s3 write qup vote");
+        k60_write32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE, v | K60_GCC_VOTE_ALL);
+        k60_probe_mark("probe: s3 read qup vote back");
+        v = k60_read32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE);
+        k60_probe_u32("s3 qup_vote_after", v);
+    }
+
+    if (step >= 4) {
+        static const char *const names[5] = { "core", "core2x", "m_ahb", "s_ahb", "se20" };
+        static const uint32_t regs[5] = {
+            K60_GCC_WRAP2_CORE_HALT, K60_GCC_WRAP2_CORE_2X_HALT,
+            K60_GCC_WRAP2_M_AHB_HALT, K60_GCC_WRAP2_S_AHB_HALT,
+            K60_GCC_WRAP2_SE20_HALT,
+        };
+        for (unsigned i = 0; i < 5; i++) {
+            snprintf(line, sizeof(line), "probe: s4 read halt %s", names[i]);
+            k60_probe_mark(line);
+            uint32_t v = k60_read32(&k60.gcc, regs[i]);
+            snprintf(line, sizeof(line), "probe: s4 halt %s=%08x", names[i], v);
+            k60_log(NULL, 1, line);
+            IODelay(K60_PROBE_DRAIN_US);
+        }
+    }
+
+    if (step >= 5) {
+        /* Is the SE20 root clock actually running?  Touch needed this check
+         * before its first SE read; 0500 never performs it. */
+        k60_probe_mark("probe: s5 read se20 rcg cmd");
+        uint32_t cmd = k60_read32(&k60.gcc, K60_SE20_RCG_CMD);
+        snprintf(line, sizeof(line), "probe: s5 rcg_cmd=%08x root_off=%u root_en=%u update=%u",
+                 cmd, (cmd >> 31) & 1u, (cmd >> 1) & 1u, cmd & 1u);
+        k60_log(NULL, 1, line);
+        IODelay(K60_PROBE_DRAIN_US);
+        k60_probe_mark("probe: s5 read se20 rcg cfg");
+        uint32_t cfg = k60_read32(&k60.gcc, K60_SE20_RCG_CFG);
+        snprintf(line, sizeof(line),
+                 "probe: s5 rcg_cfg=%08x div=%u sel=%u mode=%u hw_ctrl=%u",
+                 cfg, cfg & 0x1fu, (cfg >> 8) & 7u, (cfg >> 12) & 3u, (cfg >> 20) & 1u);
+        k60_log(NULL, 1, line);
+        IODelay(K60_PROBE_DRAIN_US);
+        k60_probe_mark("probe: s5 read se20 rcg dfsr");
+        k60_probe_u32("s5 rcg_dfsr", k60_read32(&k60.gcc, K60_SE20_RCG_DFSR));
+    }
+
+    if (step >= 6) {
+        /* clk_rcg2_set_force_enable(): set ROOT_EN, then poll ROOT_OFF clear
+         * (clk-rcg2.c:981-1002, 500 x 1 us). */
+        k60_probe_mark("probe: s6 enable se20 rcg root");
+        uint32_t cmd = k60_read32(&k60.gcc, K60_SE20_RCG_CMD);
+        k60_write32(&k60.gcc, K60_SE20_RCG_CMD, cmd | K60_RCG_CMD_ROOT_EN);
+        unsigned spins = 0;
+        uint32_t v = cmd;
+        for (; spins < 500; spins++) {
+            v = k60_read32(&k60.gcc, K60_SE20_RCG_CMD);
+            if (!(v & K60_RCG_CMD_ROOT_OFF)) break;
+            IODelay(1);
+        }
+        snprintf(line, sizeof(line), "probe: s6 root_on=%u spins=%u cmd=%08x",
+                 (v & K60_RCG_CMD_ROOT_OFF) ? 0u : 1u, spins, v);
+        k60_log(NULL, 1, line);
+        IODelay(K60_PROBE_DRAIN_US);
+        if (v & K60_RCG_CMD_ROOT_OFF) return -ETIMEDOUT;
+    }
+
+    if (step >= 7) {
+        /* Same safe configuration the touch line parks its RCG on: source =
+         * BI_TCXO (sel 0, always on), divider 1, hw-ctl bit set, then latch
+         * with CMD_UPDATE (clk-rcg2.c:33-40, :111-135). */
+        k60_probe_mark("probe: s7 read se20 rcg cfg for write");
+        uint32_t cfg = k60_read32(&k60.gcc, K60_SE20_RCG_CFG);
+        k60_probe_u32("s7 rcg_cfg_before", cfg);
+        k60_probe_mark("probe: s7 write se20 rcg cfg tcxo/1");
+        k60_write32(&k60.gcc, K60_SE20_RCG_CFG,
+                    (cfg & ~K60_RCG_CFG_MASK) | K60_RCG_CFG_HW_CTRL | 1u);
+        k60_probe_u32("s7 rcg_cfg_after", k60_read32(&k60.gcc, K60_SE20_RCG_CFG));
+        k60_probe_mark("probe: s7 latch se20 rcg update");
+        uint32_t cmd = k60_read32(&k60.gcc, K60_SE20_RCG_CMD);
+        k60_write32(&k60.gcc, K60_SE20_RCG_CMD,
+                    cmd | K60_RCG_CMD_ROOT_EN | K60_RCG_CMD_UPDATE);
+        unsigned spins = 0;
+        uint32_t v = cmd;
+        for (; spins < 500; spins++) {
+            v = k60_read32(&k60.gcc, K60_SE20_RCG_CMD);
+            if (!(v & (K60_RCG_CMD_UPDATE | K60_RCG_CMD_ROOT_OFF))) break;
+            IODelay(1);
+        }
+        snprintf(line, sizeof(line), "probe: s7 latched=%u spins=%u cmd=%08x",
+                 (v & (K60_RCG_CMD_UPDATE | K60_RCG_CMD_ROOT_OFF)) ? 0u : 1u, spins, v);
+        k60_log(NULL, 1, line);
+        IODelay(K60_PROBE_DRAIN_US);
+    }
+
+    if (step >= 8) {
+        static const char *const names[4] = { "status", "if_disable", "fw_rev", "rfr" };
+        static const uint32_t offs[4] = {
+            K60_SE_GENI_STATUS, K60_GENI_IF_DISABLE_RO,
+            K60_GENI_FW_REVISION_RO, K60_G_MANUAL_RFR,
+        };
+        for (unsigned i = 0; i < 4; i++) {
+            snprintf(line, sizeof(line), "probe: s8 read se %s", names[i]);
+            k60_probe_mark(line);
+            uint32_t v = k60_read32(&k60.uart, offs[i]);
+            snprintf(line, sizeof(line), "probe: s8 se %s=%08x", names[i], v);
+            k60_log(NULL, 1, line);
+            IODelay(K60_PROBE_DRAIN_US);
+        }
+        k60_probe_mark("probe: s8 read qup hw ver");
+        k60_probe_u32("s8 qup_hw_ver", k60_read32(&k60.qup, K60_QUP_HW_VER_REG));
+    }
+
+    if (step >= 9) {
+        static const char *const names[4] = { "dma_tx", "dma_rx", "rsvd_e40", "status2" };
+        static const uint32_t offs[4] = {
+            K60_SE_DMA_TX_IRQ_STAT, K60_SE_DMA_RX_IRQ_STAT,
+            K60_SE_RSVD_0E40, K60_SE_GENI_STATUS,
+        };
+        for (unsigned i = 0; i < 4; i++) {
+            snprintf(line, sizeof(line), "probe: s9 read se %s", names[i]);
+            k60_probe_mark(line);
+            uint32_t v = k60_read32(&k60.uart, offs[i]);
+            snprintf(line, sizeof(line), "probe: s9 se %s=%08x", names[i], v);
+            k60_log(NULL, 1, line);
+            IODelay(K60_PROBE_DRAIN_US);
+        }
+    }
+
+    k60_probe_mark("probe: done");
+    return 0;
+}
+
 static int k60_bt_power_on(void) {
     if (k60.powered) return 0;
     if (!k60.warm_boot) {
@@ -1139,14 +1369,38 @@ static void k60_worker(void *arg, wait_result_t wait_result) {
 #ifdef KERNEL
     thread_set_thread_name(current_thread(), "k60-bluetooth");
