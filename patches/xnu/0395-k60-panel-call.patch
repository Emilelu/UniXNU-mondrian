 native_pong_ui_services_start(void)
 {
+	/* K60: light the panel before any scanout so SpringBoard is visible. */
+	if (!k60_panel_on()) {
+		IOLog("K60 DISPLAY: panel bring-up failed; continuing with canvas only\n");
+	}
 	uint32_t keybag = 0;
 	if (PE_parse_boot_argn("pong_software_keybag", &keybag, sizeof(keybag)) && keybag) {
 		MiniAppleKeyStoreStart();
