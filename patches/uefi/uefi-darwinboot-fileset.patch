   CopyMem ((VOID *)(UINTN)TrampolineAddress, (VOID *)(UINTN)DarwinEnter, TrampolineBytes);
@@ -787,6 +860,9 @@ Boot (
              (UINT8 *)Image + Kernel.Segments[Index].FileOffset, (UINTN)Kernel.Segments[Index].FileSize);
   }
   Args = (DARWIN_BOOT_ARGS *)(UINTN)ArgsAddress;
+  // The page comes from AllocatePages and is not zeroed: clear every field
+  // the kernel reads, including the padding and BootFlags.
+  ZeroMem (Args, sizeof (*Args));
   Args->Revision = 2;
   Args->Version = 2;
   Args->VirtualBase = Kernel.Base;
@@ -943,7 +1019,7 @@ DarwinBootEntry (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
