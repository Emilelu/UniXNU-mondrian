+/* ------------------------------------------------------------------------- */
+/* K60 board constants (M: live FDT; see EVIDENCE.md)                        */
+/* ------------------------------------------------------------------------- */
+
+#define AW882XX_I2C_PA              0x00880000u
+#define AW882XX_I2C_SIZE            0x00004000u
+#define AW882XX_TLMM_PA             0x0f000000u
+#define AW882XX_TLMM_SIZE           0x000d0000u
+#define AW882XX_GCC_PA              0x00100000u
+#define AW882XX_GCC_SIZE            0x000a0000u
+
+#define AW882XX_ADDR_TOP            0x34u
+#define AW882XX_ADDR_BOT            0x35u
+#define AW882XX_I2C_GPIO_SCL        56u
+#define AW882XX_I2C_GPIO_SDA        57u
+#define AW882XX_RESET_GPIO_TOP      1u
+#define AW882XX_RESET_GPIO_BOT      3u
+#define AW882XX_IRQ_GPIO_TOP        88u
+#define AW882XX_IRQ_GPIO_BOT        63u
+#define AW882XX_SPKSW_GPIO          52u
+#define AW882XX_SOUND_CHANNEL_TOP   0u
+#define AW882XX_SOUND_CHANNEL_BOT   1u
+
+/* FDT interrupt flags are 0x2008 (raw); the task/board description calls
+ * this falling-edge. TODO(aw882xx): decode against the final TLMM
+ * interrupt-controller binding; do not silently rewrite. */
+#define AW882XX_IRQ_FLAGS           0x2008u
+
+/* TLMM mux helper values copied from PongAudio.cpp:117-126 pattern.
+ * TODO(aw882xx): confirm the K60 qup15 function number is 1; the FDT says
+ * function "qup15" and zizhan's audit confirms the same SE15 pin group. */
+#define AW882XX_TLMM_CFG_GPIO       0x00000201u  /* function 0 + bit9 */
+#define AW882XX_TLMM_CFG_I2C        0x00000007u  /* function 1 + 2mA */
+
+/* ------------------------------------------------------------------------- */
+/* GENI I2C engine (adapted from pong-power/GeniI2c.c/h, BSD-2-Clause)      */
+/* ------------------------------------------------------------------------- */
+
+#define GENI_FW_REVISION            0x0068u
+#define GENI_IF_DISABLE             0x0064u
+#define GENI_CLK_CFG                0x0048u
+#define GENI_BYTE_GRAN              0x0254u
+#define GENI_DMA_MODE               0x0258u
+#define GENI_TX_PACK0               0x0260u
+#define GENI_TX_PACK1               0x0264u
+#define GENI_TX_LEN                 0x026cu
+#define GENI_RX_LEN                 0x0270u
+#define GENI_SCL_COUNTERS           0x0278u
+#define GENI_RX_PACK0               0x0284u
+#define GENI_RX_PACK1               0x0288u
+#define GENI_M_CMD0                 0x0600u
+#define GENI_M_CMD_CTRL             0x0604u
+#define GENI_M_IRQ_STATUS           0x0610u
+#define GENI_M_IRQ_EN               0x0614u
+#define GENI_M_IRQ_CLEAR            0x0618u
+#define GENI_TX_FIFO                0x0700u
+#define GENI_RX_FIFO                0x0780u
+#define GENI_RX_FIFO_STATUS         0x0804u
+#define GENI_TX_WATERMARK           0x080cu
+#define GENI_SE_IRQ_EN              0x0e1cu
+
+#define GENI_M_CMD_DONE             (1u << 0)
+#define GENI_M_CMD_OVERRUN          (1u << 1)
+#define GENI_M_ILLEGAL_CMD          (1u << 2)
+#define GENI_M_CMD_FAILURE          (1u << 3)
+#define GENI_M_CMD_CANCEL           (1u << 4)
+#define GENI_M_CMD_ABORT            (1u << 5)
+#define GENI_M_GP_IRQ               (0x3fu << 9)
+#define GENI_M_TX_WATERMARK         (1u << 30)
+#define GENI_M_ERRORS               (GENI_M_CMD_OVERRUN | GENI_M_ILLEGAL_CMD | \
+	GENI_M_CMD_FAILURE | GENI_M_GP_IRQ)
+#define GENI_M_IRQ_WANTED           (GENI_M_CMD_DONE | GENI_M_ERRORS | \
+	GENI_M_CMD_CANCEL | GENI_M_CMD_ABORT | GENI_M_TX_WATERMARK)
+#define GENI_SE_M_IRQ_EN            (1u << 2)
+#define GENI_CMD_CTRL_ABORT         (1u << 1)
+#define GENI_CMD_CTRL_CANCEL        (1u << 2)
+#define GENI_PROTO_I2C              3u
+#define GENI_OP_WRITE               1u
+#define GENI_OP_READ                2u
+#define GENI_STOP_STRETCH           (1u << 2)
+
+typedef struct {
+	uint32_t (*read)(void *ctx, uint32_t reg);
+	void (*write)(void *ctx, uint32_t reg, uint32_t value);
+	void *ctx;
+} Aw882xxGeniIo;
+
+enum {
+	Aw882xxGeniIdle = 0,
+	Aw882xxGeniTxWait,
+	Aw882xxGeniWriteDone,
+	Aw882xxGeniReadDone,
+	Aw882xxGeniCancelling,
+	Aw882xxGeniAborting
+};
+
+enum {
+	Aw882xxGeniPending = 0,
+	Aw882xxGeniDone = 1,
+	Aw882xxGeniFailed = 2
+};
+
+enum {
+	Aw882xxGeniOk = 0,
+	Aw882xxGeniErrBusy = 1,
+	Aw882xxGeniErrBus = 2,
+	Aw882xxGeniErrTimeout = 3,
+	Aw882xxGeniErrNoData = 4,
+	Aw882xxGeniErrState = 5
+};
+
+typedef struct {
+	Aw882xxGeniIo io;
+	uint8_t address;
+	uint8_t phase;
+	uint8_t reading;
+	uint8_t hold;
+	uint8_t error;
+	uint8_t data;
+	uint8_t tx_words;
+	uint8_t rx_length;
+	uint32_t tx[2];
+	uint32_t length;
+	uint32_t rx;
+	uint32_t error_status;
+	uint32_t done;
+	uint32_t failed;
+	uint32_t timeouts;
+	uint32_t stray;
+} Aw882xxGeni;
+
+static uint32_t
+aw882xx_geni_rd(Aw882xxGeni *g, uint32_t reg)
+{
+	return g->io.read(g->io.ctx, reg);
+}
+
+static void
+aw882xx_geni_wr(Aw882xxGeni *g, uint32_t reg, uint32_t value)
+{
+	g->io.write(g->io.ctx, reg, value);
+}
+
+static int
+aw882xx_geni_prepare(Aw882xxGeni *g, const Aw882xxGeniIo *io, uint8_t address,
+    uint32_t *config)
+{
+	memset(g, 0, sizeof(*g));
+	g->io = *io;
+	g->address = address;
+	const uint32_t proto = (aw882xx_geni_rd(g, GENI_FW_REVISION) >> 8) & 0xffu;
+	const uint32_t clock = aw882xx_geni_rd(g, GENI_CLK_CFG);
+	if (config != NULL) {
+		*config = (proto << 24) | (clock & 0xffffffu);
+	}
+	if (proto != GENI_PROTO_I2C || (aw882xx_geni_rd(g, GENI_IF_DISABLE) & 1u) ||
+	    !(clock & 1u) || !aw882xx_geni_rd(g, GENI_SCL_COUNTERS)) {
+		return -1;
+	}
+	aw882xx_geni_wr(g, GENI_DMA_MODE, 0);
+	aw882xx_geni_wr(g, GENI_TX_PACK0, 0x7f8fe);
+	aw882xx_geni_wr(g, GENI_TX_PACK1, 0xffefe);
+	aw882xx_geni_wr(g, GENI_RX_PACK0, 0x7f8fe);
+	aw882xx_geni_wr(g, GENI_RX_PACK1, 0xffefe);
+	aw882xx_geni_wr(g, GENI_BYTE_GRAN, 0);
+	aw882xx_geni_wr(g, GENI_TX_WATERMARK, 0);
+	aw882xx_geni_wr(g, GENI_M_IRQ_CLEAR, 0xffffffffu);
+	aw882xx_geni_wr(g, GENI_M_IRQ_EN, GENI_M_IRQ_WANTED);
+	aw882xx_geni_wr(g, GENI_SE_IRQ_EN,
+	    aw882xx_geni_rd(g, GENI_SE_IRQ_EN) | GENI_SE_M_IRQ_EN);
+	return 0;
+}
+
+static void
+aw882xx_geni_write_command(Aw882xxGeni *g, const uint8_t *bytes,
+    uint32_t length, int hold)
+{
+	g->tx[0] = 0;
+	g->tx[1] = 0;
+	for (uint32_t i = 0; i < length; ++i) {
+		g->tx[i / 4] |= (uint32_t)bytes[i] << (8 * (i % 4));
+	}
+	g->tx_words = (uint8_t)((length + 3) / 4);
+	g->length = length;
+	g->hold = (uint8_t)hold;
+	aw882xx_geni_wr(g, GENI_TX_LEN, length);
+	aw882xx_geni_wr(g, GENI_M_CMD0, (GENI_OP_WRITE << 27) |
+	    ((uint32_t)g->address << 9) | (hold ? GENI_STOP_STRETCH : 0));
+	aw882xx_geni_wr(g, GENI_TX_WATERMARK, 1);
+	g->phase = Aw882xxGeniTxWait;
+}
+
+static int
+aw882xx_geni_start_write_bytes(Aw882xxGeni *g, const uint8_t *bytes,
+    uint32_t length)
+{
+	if (g->phase != Aw882xxGeniIdle || length == 0 || length > 8) {
+		return -1;
+	}
+	g->reading = 0;
+	g->error = Aw882xxGeniOk;
+	aw882xx_geni_write_command(g, bytes, length, 0);
+	return 0;
+}
+
+static int
+aw882xx_geni_start_read_bytes(Aw882xxGeni *g, const uint8_t *bytes,
+    uint32_t length, uint32_t read_length)
+{
+	if (g->phase != Aw882xxGeniIdle || length == 0 || length > 4 ||
+	    read_length == 0 || read_length > 4) {
+		return -1;
+	}
+	g->reading = 1;
+	g->rx_length = (uint8_t)read_length;
+	g->error = Aw882xxGeniOk;
+	aw882xx_geni_write_command(g, bytes, length, 1);
+	return 0;
+}
+
+static int
+aw882xx_geni_finish(Aw882xxGeni *g, int error, uint32_t status)
+{
+	g->phase = Aw882xxGeniIdle;
+	aw882xx_geni_wr(g, GENI_TX_WATERMARK, 0);
+	if (!error) {
+		g->done++;
+		return Aw882xxGeniDone;
+	}
+	g->error = (uint8_t)error;
+	g->error_status = status;
+	g->failed++;
+	return Aw882xxGeniFailed;
+}
+
+static int
+aw882xx_geni_event(Aw882xxGeni *g, uint32_t status)
+{
+	if (!status) {
+		return Aw882xxGeniPending;
+	}
+	switch (g->phase) {
+	case Aw882xxGeniIdle:
+		g->stray++;
+		return Aw882xxGeniPending;
+	case Aw882xxGeniCancelling:
+		if (status & GENI_M_CMD_CANCEL) {
+			return aw882xx_geni_finish(g, Aw882xxGeniErrTimeout,
+			    g->error_status);
+		}
+		return Aw882xxGeniPending;
+	case Aw882xxGeniAborting:
+		if (status & GENI_M_CMD_ABORT) {
+			return aw882xx_geni_finish(g, Aw882xxGeniErrTimeout,
+			    g->error_status);
+		}
+		return Aw882xxGeniPending;
+	default:
+		break;
+	}
+	if (status & GENI_M_ERRORS) {
+		return aw882xx_geni_finish(g, Aw882xxGeniErrBus, status);
+	}
+	if (g->phase == Aw882xxGeniTxWait) {
+		if (status & GENI_M_TX_WATERMARK) {
+			for (unsigned i = 0; i < g->tx_words; ++i) {
+				aw882xx_geni_wr(g, GENI_TX_FIFO, g->tx[i]);
+			}
+			aw882xx_geni_wr(g, GENI_TX_WATERMARK, 0);
+			g->phase = Aw882xxGeniWriteDone;
+		}
+		if (!(status & GENI_M_CMD_DONE)) {
+			return Aw882xxGeniPending;
+		}
+		if (g->phase == Aw882xxGeniTxWait) {
+			return aw882xx_geni_finish(g, Aw882xxGeniErrState, status);
+		}
+	}
+	if (!(status & GENI_M_CMD_DONE)) {
+		return Aw882xxGeniPending;
+	}
+	if (g->phase == Aw882xxGeniWriteDone) {
+		if (!g->reading) {
+			return aw882xx_geni_finish(g, Aw882xxGeniOk, 0);
+		}
+		aw882xx_geni_wr(g, GENI_RX_LEN, g->rx_length);
+		aw882xx_geni_wr(g, GENI_M_CMD0, (GENI_OP_READ << 27) |
+		    ((uint32_t)g->address << 9));
+		g->phase = Aw882xxGeniReadDone;
+		return Aw882xxGeniPending;
+	}
+	if (!(aw882xx_geni_rd(g, GENI_RX_FIFO_STATUS) & 0x1ffffffu)) {
+		return aw882xx_geni_finish(g, Aw882xxGeniErrNoData, status);
+	}
+	g->rx = aw882xx_geni_rd(g, GENI_RX_FIFO);
+	g->data = (uint8_t)g->rx;
+	return aw882xx_geni_finish(g, Aw882xxGeniOk, 0);
+}
+
+static int
+aw882xx_geni_poll(Aw882xxGeni *g)
+{
+	const uint32_t status = aw882xx_geni_rd(g, GENI_M_IRQ_STATUS);
+	if (status) {
+		aw882xx_geni_wr(g, GENI_M_IRQ_CLEAR, status);
+	}
+	return g->phase == Aw882xxGeniIdle ? Aw882xxGeniPending :
+	    aw882xx_geni_event(g, status);
+}
+
+static int
+aw882xx_geni_timeout(Aw882xxGeni *g)
+{
+	switch (g->phase) {
+	case Aw882xxGeniIdle:
+		return Aw882xxGeniPending;
+	case Aw882xxGeniCancelling:
+		aw882xx_geni_wr(g, GENI_M_CMD_CTRL, GENI_CMD_CTRL_ABORT);
+		g->phase = Aw882xxGeniAborting;
+		return Aw882xxGeniPending;
+	case Aw882xxGeniAborting:
+		return aw882xx_geni_finish(g, Aw882xxGeniErrTimeout,
+		    g->error_status);
+	default:
+		g->timeouts++;
+		g->error_status = aw882xx_geni_rd(g, GENI_M_IRQ_STATUS);
+		aw882xx_geni_wr(g, GENI_TX_WATERMARK, 0);
+		aw882xx_geni_wr(g, GENI_M_CMD_CTRL, GENI_CMD_CTRL_CANCEL);
+		g->phase = Aw882xxGeniCancelling;
+		return Aw882xxGeniPending;
+	}
+}
+
+/* ------------------------------------------------------------------------- */
+/* MMIO windows                                                              */
+/* ------------------------------------------------------------------------- */
+
+typedef struct {
+	vm_offset_t gcc;
+	vm_offset_t tlmm;
+	vm_offset_t i2c;
+	Aw882xxGeni geni;
+	uint32_t i2c_config;
+	bool mapped;
+	bool geni_ready;
+} Aw882xxBus;
+
+static Aw882xxBus g_aw882xx_bus;
+
+static uint32_t
+aw882xx_gcc_read(uint32_t off)
+{
+	return *(volatile uint32_t *)(g_aw882xx_bus.gcc + off);
+}
+
+static void
+aw882xx_gcc_write(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(g_aw882xx_bus.gcc + off) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint32_t
+aw882xx_tlmm_read(uint32_t off)
+{
+	return *(volatile uint32_t *)(g_aw882xx_bus.tlmm + off);
+}
+
+static void
+aw882xx_tlmm_write(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(g_aw882xx_bus.tlmm + off) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint32_t
+aw882xx_i2c_read_reg(void *ctx, uint32_t reg)
+{
+	__unused Aw882xxBus *bus = ctx;
+	return *(volatile uint32_t *)(g_aw882xx_bus.i2c + reg);
+}
+
+static void
+aw882xx_i2c_write_reg(void *ctx, uint32_t reg, uint32_t value)
+{
+	__unused Aw882xxBus *bus = ctx;
+	*(volatile uint32_t *)(g_aw882xx_bus.i2c + reg) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static bool
+aw882xx_wait_cbcrc(uint32_t off, unsigned timeout_ms)
+{
+	for (unsigned i = 0; i < timeout_ms; ++i) {
+		const uint32_t v = aw882xx_gcc_read(off);
+		if (!(v & (1u << 31)) || (v & 2u)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+aw882xx_bus_map(void)
+{
+	if (g_aw882xx_bus.mapped) {
+		return true;
+	}
+	g_aw882xx_bus.gcc = ml_io_map(AW882XX_GCC_PA, AW882XX_GCC_SIZE);
+	g_aw882xx_bus.tlmm = ml_io_map(AW882XX_TLMM_PA, AW882XX_TLMM_SIZE);
+	g_aw882xx_bus.i2c = ml_io_map(AW882XX_I2C_PA, AW882XX_I2C_SIZE);
+	if (!g_aw882xx_bus.gcc || !g_aw882xx_bus.tlmm || !g_aw882xx_bus.i2c) {
+		return false;
+	}
+	g_aw882xx_bus.mapped = true;
+	return true;
+}
+
+static void
+aw882xx_pin_config(unsigned gpio, uint32_t config, int level)
+{
+	const uint32_t reg = gpio * 0x1000u;
+	const uint32_t old = aw882xx_tlmm_read(reg);
+	uint32_t newcfg = (old & ~0x3ffu) | (config & 0x3ffu);
+	if (old & (1u << 11)) {
+		newcfg |= 1u << 12;
+	}
+	if (level >= 0) {
+		aw882xx_tlmm_write(reg + 4, level ? 2u : 0u);
+	}
+	aw882xx_tlmm_write(reg, newcfg);
+	if (level >= 0) {
+		aw882xx_tlmm_write(reg + 4, level ? 2u : 0u);
+	}
+}
+
+/* ------------------------------------------------------------------------- */
+/* AW882xx register protocol -- TODO: the byte order/width below is the     */
+/* Pong TFA9873-style 1-byte register + 2-byte big-endian data format and   */
+/* is NOT verified for AW882xx. Replace with the vendor driver definition.  */
+/* ------------------------------------------------------------------------- */
+
+static bool
+aw882xx_i2c_transfer(uint8_t address, const uint8_t *tx, uint32_t tx_len,
+    uint16_t *value)
+{
+	Aw882xxGeni *g = &g_aw882xx_bus.geni;
+	g->address = address;
+	int r;
+	if (value != NULL) {
+		r = aw882xx_geni_start_read_bytes(g, tx, tx_len, 2);
+	} else {
+		r = aw882xx_geni_start_write_bytes(g, tx, tx_len);
+	}
+	if (r != 0) {
+		return false;
+	}
+	for (unsigned phase = 0; phase < 3; ++phase) {
+		for (unsigned i = 0; i < 1000; ++i) {
+			r = aw882xx_geni_poll(g);
+			if (r == Aw882xxGeniDone) {
+				if (value != NULL) {
+					*value = (uint16_t)(((g->rx & 0xffu) << 8) |
+					    ((g->rx >> 8) & 0xffu));
+				}
+				return true;
+			}
+			if (r == Aw882xxGeniFailed) {
+				return false;
+			}
+			delay(1);
+		}
+		if (aw882xx_geni_timeout(g) != Aw882xxGeniPending) {
+			break;
+		}
+	}
+	return false;
+}
+
+static bool
+aw882xx_reg_read(uint8_t address, uint8_t reg, uint16_t *value)
+{
+	const uint8_t tx[1] = { reg };
+	return aw882xx_i2c_transfer(address, tx, sizeof(tx), value);
+}
+
+static bool
+aw882xx_reg_write(uint8_t address, uint8_t reg, uint16_t value)
+{
+	const uint8_t tx[3] = { reg, (uint8_t)(value >> 8), (uint8_t)value };
+	return aw882xx_i2c_transfer(address, tx, sizeof(tx), NULL);
+}
