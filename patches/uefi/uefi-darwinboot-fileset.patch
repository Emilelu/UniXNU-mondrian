   ZeroMem (Kernel, sizeof (*Kernel));
-  Count = U32 (Data + 16);
-  End = 32 + U32 (Data + 20);
+  Count = U32 (Header + 16);
+  End = 32 + U32 (Header + 20);
   Offset = 32;
   HasEntry = FALSE;
