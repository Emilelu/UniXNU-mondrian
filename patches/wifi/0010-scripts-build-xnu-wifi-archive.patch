From: UniXNU contributors
Subject: [PATCH] k60: force-load the PongWifi kernel archive

The WiFi port builds libPongWifiNative.a but nothing links it. 0009 produces the
archive and the PongWifi sources expect their classes to be present in the
kernel, so without a force_load the archive is inert: the driver compiles, the
symbols exist on disk, and the kernel has none of them.

This adds the archive the same way every other probe archive is added - a
KERNEL_EXTRA_ARCHIVES entry with -Wl,-force_load plus a dependency so make
rebuilds when the archive changes. The gate is XNU_PONG_WIFI, which defaults to
0, so a tree that has not built the archive still links.

--- a/scripts/build-xnu-4k-baseline.sh
+++ b/scripts/build-xnu-4k-baseline.sh
@@ -902,9 +902,15 @@
   if [ "$CONSTANT_UPLOADS_PROBE" = 1 ]; then
     CONSTANT_UPLOADS_ARCHIVE=$ROOT/build/constant-uploads-probe/libConstantUploadsProbe.a
     test -f "$CONSTANT_UPLOADS_ARCHIVE"
     KERNEL_EXTRA_ARCHIVES="$KERNEL_EXTRA_ARCHIVES -Wl,-force_load,$CONSTANT_UPLOADS_ARCHIVE"
     KERNEL_ARCHIVE_DEPENDENCIES="$KERNEL_ARCHIVE_DEPENDENCIES $CONSTANT_UPLOADS_ARCHIVE"
   fi
+  if [ "${XNU_PONG_WIFI:-0}" = 1 ]; then
+    PONG_WIFI_ARCHIVE=${XNU_PONG_WIFI_ARCHIVE:-$ROOT/build/pong-wifi/libPongWifiNative.a}
+    test -f "$PONG_WIFI_ARCHIVE"
+    KERNEL_EXTRA_ARCHIVES="$KERNEL_EXTRA_ARCHIVES -Wl,-force_load,$PONG_WIFI_ARCHIVE"
+    KERNEL_ARCHIVE_DEPENDENCIES="$KERNEL_ARCHIVE_DEPENDENCIES $PONG_WIFI_ARCHIVE"
+  fi
   if [ "${XNU_ARMVIRT_PLATFORM:-0}" = 1 ]; then
     ARMVIRT_ARCHIVE=$ROOT/build/armvirt-platform/libArmVirtPlatform.a
     test -f "$ARMVIRT_ARCHIVE"
