+/*
+ * 0308: automatic return to fastboot.
+ *
+ * The serial console is one-way: to read a boot's log the operator has to
+ * power-cycle the phone by hand and catch fastboot. Writing the Xiaomi
+ * "bootloader" restart reason into IMEM and issuing PSCI SYSTEM_RESET makes
+ * the phone walk back into fastboot on its own, which is exactly what the
+ * UEFI keypad helper already does on the other side of the same fence
+ * (uefi-mondrian K60KeypadDeviceLib.c: AutoResetToFastboot ->
+ * Wr32(0x146AA65C, 0x77665500) then EfiResetCold). Address and cookie come
+ * from that code and from the live DT node
+ * qcom,msm-imem@146aa000 / restart_reason@65c.
+ *
+ * Two triggers, both gated by k60_usblog_reset=<seconds> (0 = never):
+ *   - the console ring has been quiet for that many seconds, and
+ *   - the log has ended at a known-fatal event (panic or a critical exit).
+ * The first keeps a healthy boot readable for as long as a human needs; the
+ * second avoids sitting on a dead machine for the whole window.
+ */
+#define K60_IMEM_PA              0x146AA000u    /* msm-imem@146aa000 */
+#define K60_IMEM_SIZE            0x00001000u
+#define K60_IMEM_RESTART_REASON  0x65cu         /* restart_reason@65c */
+#define K60_RESTART_REASON_BOOTLOADER 0x77665500u
+
+static int k60_usblog_reset = -1;       /* -1: arg not parsed yet */
+
+static int
+k60_usblog_reset_arg(void)
+{
+	int seconds = 0;
+
+	PE_parse_boot_argn("k60_usblog_reset", &seconds, sizeof(seconds));
+	return seconds;
+}
+
+/*
+ * 0319: Pong-style restart reason (ported from
+ * pong-boot-capture/PongBootCapture.h, Chengdong-Yu/pong-boot-capture).
+ *
+ * The bootloader reads the PMIC SDAM7100 cell ("restart@48 bits<1 7>", APPS
+ * EE0) - not just IMEM - when deciding where to go after a reset. That is why
+ * writing IMEM alone still landed in Android. Pong's markTarget():
+ *
+ *     value = (before & 1) | (target << 1);
+ *     target 1 = REC        -> IMEM 0x77665502
+ *     target 2 = bootloader -> IMEM 0x77665500
+ *
+ * The SPMI side is a v7 transaction: an observer read of the SDAM cell, then a
+ * channel command 0x48<<4 carrying the new byte in the channel data register.
+ */
+#define K60_SPMI_CORE_PA     0x0C400000u
+#define K60_SPMI_CORE_SIZE   0x00003000u
+#define K60_SPMI_CONFIG_PA   0x0C42D000u
+#define K60_SPMI_CONFIG_SIZE 0x00004000u
+#define K60_SPMI_OBSERVER_PA 0x0C440000u
+#define K60_SPMI_CHANNEL_PA  0x0C500000u
+
+static unsigned    k60_spmi_apid;
+static vm_offset_t k60_spmi_observer;
+static vm_offset_t k60_spmi_channel;
+static vm_offset_t k60_imem;
+
+static bool
+k60_spmi_wait(vm_offset_t w, uint32_t off)
+{
+	for (unsigned n = 0; n < 100000; n++) {
+		uint32_t s = *(volatile uint32_t *)(w + off + 8);
+		if (s & 1) {
+			return (s & 15) == 1;
+		}
+	}
+	return false;
+}
+
+static bool
+k60_sd_read_cell(uint8_t *v)
+{
+	*(volatile uint32_t *)(k60_spmi_observer + k60_spmi_apid * 0x20) =
+	    (1u << 27) | (0x48u << 4);
+	if (!k60_spmi_wait(k60_spmi_observer, k60_spmi_apid * 0x20)) {
+		return false;
+	}
+	*v = (uint8_t)(*(volatile uint32_t *)(k60_spmi_observer +
+	    k60_spmi_apid * 0x20 + 0x18) & 0xff);
+	return true;
+}
+
+static bool
+k60_prime_restart(int target)
+{
+	vm_offset_t core = ml_io_map(K60_SPMI_CORE_PA, K60_SPMI_CORE_SIZE);
+	vm_offset_t cfg  = ml_io_map(K60_SPMI_CONFIG_PA, K60_SPMI_CONFIG_SIZE);
+	uint32_t version, count;
+	int apid = -1;
+
+	if (!core || !cfg) {
+		return false;
+	}
+	version = *(volatile uint32_t *)core;
+	count = *(volatile uint32_t *)(core + 4) & 0x7ff;
+	if (version < 0x70000000u || version >= 0x80000000u || !count || count > 1024) {
+		return false;
+	}
+	for (uint32_t n = 0; n < count; n++) {
+		uint32_t slave = *(volatile uint32_t *)(core + 0x2000 + 4 * n);
+		uint32_t cfgv  = *(volatile uint32_t *)(cfg + 4 * n);
+		if (((slave >> 8) & 0xfff) == 0x71 && (cfgv & 7) == 0) {
+			apid = (int)n;
+			break;
+		}
+	}
+	if (apid < 0) {
+		return false;
+	}
+	k60_spmi_apid = (unsigned)apid;
+	k60_spmi_observer = ml_io_map(K60_SPMI_OBSERVER_PA,
+	    (k60_spmi_apid * 0x20 + 0x20 + 4095) & ~4095u);
+	k60_spmi_channel = ml_io_map(K60_SPMI_CHANNEL_PA + k60_spmi_apid * 4096, 4096);
+	k60_imem = ml_io_map(K60_IMEM_PA, K60_IMEM_SIZE);
+	if (!k60_spmi_observer || !k60_spmi_channel || !k60_imem) {
+		return false;
+	}
+	{
+		uint8_t before = 0, after = 0, value;
+
+		if (!k60_sd_read_cell(&before)) {
+			return false;
+		}
+		value = (uint8_t)((before & 1) | (target << 1));
+		*(volatile uint32_t *)(k60_spmi_channel + 0x10) = value;
+		*(volatile uint32_t *)k60_spmi_channel = 0x48u << 4;
+		if (!k60_spmi_wait(k60_spmi_channel, 0) || !k60_sd_read_cell(&after) ||
+		    after != value) {
+			return false;
+		}
+	}
+	*(volatile uint32_t *)(k60_imem + K60_IMEM_RESTART_REASON) =
+	    (target == 1) ? 0x77665502u : K60_RESTART_REASON_BOOTLOADER;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return *(volatile uint32_t *)(k60_imem + K60_IMEM_RESTART_REASON) ==
+	    ((target == 1) ? 0x77665502u : K60_RESTART_REASON_BOOTLOADER);
+}
+
+/*
+ * Publish the restart reason and hand the machine to the native reboot path.
+ * pong uses reboot_kernel(RB_QUICK) rather than a bare PSCI call: the latter
+ * can simply return, which is what left this board sitting at the panic screen.
+ */
+static void
+k60_usblog_reset_to_fastboot(void)
+{
+	bool primed = k60_prime_restart(2);
+
+	printf("K60 USBLOG: restart reason %s\n",
+	    primed ? "published" : "FAILED to publish");
+	delay(1500000);
+
+	{
+		register uint64_t x0 __asm__("x0") = 0x84000009u;
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		printf("K60 USBLOG: SMC SYSTEM_RESET returned 0x%llx\n", x0);
+	}
+	{
+		register uint64_t x0 __asm__("x0") = 0x84000009u;
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+		__asm__ volatile ("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		printf("K60 USBLOG: HVC SYSTEM_RESET returned 0x%llx\n", x0);
+	}
+	{
+		register uint64_t x0 __asm__("x0") = 0xC4000009u;
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		printf("K60 USBLOG: SMC SYSTEM_RESET2 returned 0x%llx\n", x0);
+	}
+	printf("K60 USBLOG: all conduits returned; trying reboot_kernel\n");
+	reboot_kernel(0x400, NULL);
+	printf("K60 USBLOG: reboot_kernel returned\n");
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
