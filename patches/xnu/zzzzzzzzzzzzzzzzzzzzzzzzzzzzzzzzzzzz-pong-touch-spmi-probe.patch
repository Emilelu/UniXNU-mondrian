--- a/bsd/dev/pong_goodix.c
+++ b/bsd/dev/pong_goodix.c
@@ -641,6 +641,60 @@
 
 /* Declared ahead of its definition: goodix_apply_config resets the chip
  * through it so the SPI mode is re-confirmed on that path too. */
+/* Read-only look at the SPMI arbiter. pong_buttons.c proves the observer
+ * window answers on this board; this asks that same window for the arbiter's
+ * identity and for the channel map, which a later regulator vote depends on. */
+#define SPMI_CORE_PHYS     0xc400000UL
+#define SPMI_OBSERVER_PHYS 0xc440000UL
+
+static vm_offset_t spmi_core, spmi_obs;
+
+static uint32_t spmi_rd(uint32_t off)
+{
+    return *(volatile uint32_t *)(spmi_core + off);
+}
+
+static uint32_t spmi_obs_rd(uint32_t ch, uint32_t off)
+{
+    return *(volatile uint32_t *)(spmi_obs + 0x80u * ch + off);
+}
+
+static void spmi_probe(void)
+{
+    uint32_t nz = 0, s0 = 0, s1 = 0, s2 = 0;
+
+    if (!spmi_core) {
+        spmi_core = ml_io_map(SPMI_CORE_PHYS, 0x3000);
+        spmi_obs = ml_io_map(SPMI_OBSERVER_PHYS, 0x80000);
+    }
+    if (!spmi_core || !spmi_obs) {
+        printf("K60SPMI map failed core=%#llx obs=%#llx\n",
+            (unsigned long long)spmi_core, (unsigned long long)spmi_obs);
+        return;
+    }
+    printf("K60SPMI ver=%#x channels=%u\n", spmi_rd(0x000), spmi_rd(0x004) & 0x7ff);
+    {
+        uint32_t sid2 = 0, sid2a = 0, sid2b = 0, sid2c = 0;
+        for (uint32_t n = 0; n < 768; n++) {
+            uint32_t v = spmi_rd(0x1400 + 4 * n);
+            if (((v >> 8) & 0xf) != 2) {
+                continue;
+            }
+            if (sid2 == 0) {
+                sid2a = (v >> 8) & 0xfff;
+            } else if (sid2 == 1) {
+                sid2b = (v >> 8) & 0xfff;
+            } else if (sid2 == 2) {
+                sid2c = (v >> 8) & 0xfff;
+            }
+            sid2++;
+        }
+        printf("K60SPMI sid2=%u ch=%#x %#x %#x\n", sid2, sid2a, sid2b, sid2c);
+        printf("K60SPMI probe_status=%#x\n", spmi_obs_rd(0, 0x08));
+    }
+    printf("K60SPMI obs_status0=%#x\n", spmi_obs_rd(0, 0x08));
+}
+
 static void touch_reset(void);
 
 static bool
