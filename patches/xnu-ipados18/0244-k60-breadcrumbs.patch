+#define K60_DIAG_PA             0xA73FF000ULL
+#define K60_DIAG_MAGIC          0xB0000000U
+
+static int k60_diag_phys_ok = 1;
+
+static void
+k60_diag_stage(unsigned int id)
+{
+	if (!k60_diag_phys_ok) {
+		return;
+	}
+	*(volatile uint64_t *)(uintptr_t)(K60_DIAG_PA + (8 * id)) =
+	    (uint64_t)K60_DIAG_MAGIC + id;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+#endif /* PONG */
