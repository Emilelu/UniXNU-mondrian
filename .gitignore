# Local Apple restore inputs and generated images
/apple/
/out/
/build/
/reference/
/refer/
/firmware/*
# The Bluetooth firmware set is vendor data pulled from the device, but it is
# small and scripts/stage-bluetooth-firmware.py consumes it, so the whole set
# is tracked and a clean checkout can stage and verify the bytes.
!/firmware/bluetooth/
!/firmware/bluetooth/**
/artifacts/
/evidence/
*.ipsw
*.dmg
*.cdr
*.img
*.bin
*.fw
*.mdt
*.b01
*.b02
*.im4p
*.im4m
*.trustcache
*.ramdisk
*.lzfse
*.partial
*.dSYM/
*.o
*.a
*.dylib
# The extension rules below would drop the .bin half of the Bluetooth
# firmware set that the negation above re-includes; keep those tracked.
!/firmware/bluetooth/qca/*.bin
*.metallib
*.air
*.kc
*.kernelcache
*.log
!scripts/tests/fixtures/*.log
# Fixtures live in per-suite subdirectories too; without this line the gpu27
# fixtures were ignored, so the committed judge test passed only on the machine
# that wrote it (P-205 family).
!scripts/tests/fixtures/*/*.log
# The post-flip fixtures sit one level deeper than the others; without this
# line they are untracked and the test passes only where it was written (P-205).
!scripts/tests/fixtures/*/*/*.log
.DS_Store
__pycache__/
*.py[cod]
/local.toml
mac-build/*/cache/
*.fat
mac-build/*/build-report.json
build/
/.cache/

# AOCI runtime state (baseline, ledger, transactions)
.aoci/*
!.aoci/config.json
