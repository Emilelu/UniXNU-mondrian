diff --git a/bsd/dev/k60_metal.c b/bsd/dev/k60_metal.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/k60_metal.c
@@ -0,0 +1,244 @@
+/*-
+ * K60 Metal plugin deployment.
+ *
+ * The Adreno Metal plugin bundle is 51 MB, far too large for a kernel blob
+ * (0340's libpong-ui is 111 KB and already costs a 614 KB patch). It therefore
+ * travels inside the boot payload image, which the firmware leaves as a FAT
+ * volume at /dev/md0, and this copies it onto the writable Data volume before
+ * launchd starts.
+ *
+ * Why it has to happen at all: drivers/PongAdreno/PongAdrenoAccelerator.cpp:44
+ * publishes MetalPluginName=PongAdrenoMetal on the IOAcceleratorES service, and
+ * the system then loads /System/Library/Extensions/<that name>.bundle. That
+ * bundle is not in the sealed root, so nothing loads and the compositor falls
+ * back to software -- the flat, blurred-free dock this port shows.
+ *
+ * The two seed files next to the bundle are what the plugin checks first
+ * (drivers/PongMetal/PongMetalPlugin.mm:170-199):
+ *     PongAdrenoMetal.publish   the single byte '1'
+ *     PongAdrenoMetal.clients   one process name per line (backboardd, ...)
+ * with a strict test: a regular file, st_uid == 0, and no group/other write bit.
+ * Hence mode 0644 and owner 0:0, set through the vnode attribute call below.
+ */
+
+#include <sys/types.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+#include <sys/kauth.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/mount.h>
+#include <sys/vfs_context.h>
+#include <pexpert/pexpert.h>
+
+extern dev_t mdevlookup(int);
+
+#define K60_METAL_STAGE   "/private/var/pong/md0"
+#define K60_METAL_DEST    "/private/var/pong"
+#define K60_METAL_SRC     "/private/var/pong/PongAdrenoMetal.bundle"
+#define K60_METAL_TARGET  "/System/Library/Extensions/PongAdrenoMetal.bundle"
+
+static int k60_metal_stage_state = -1;
+
+static const char * const k60_metal_files[] = {
+	"PongAdrenoMetal.bundle/Info.plist",
+	"PongAdrenoMetal.bundle/PongAdrenoMetal",
+	"PongAdrenoMetal.bundle/PongMetalBridge.dylib",
+	"PongAdrenoMetal.bundle/libvulkan_freedreno.dylib",
+	"PongAdrenoMetal.publish",
+	"PongAdrenoMetal.clients",
+};
+
+/* Build "dir/name" into out. Plain string calls: the kernel has no snprintf. */
+static void
+k60_metal_path(char *out, size_t cap, const char *dir, const char *name)
+{
+	(void)strlcpy(out, dir, cap);
+	(void)strlcat(out, "/", cap);
+	(void)strlcat(out, name, cap);
+}
+
+/* Create or truncate path at mode 0644 and write len bytes into it. */
+static int
+k60_metal_write(const char *path, const void *data, int len)
+{
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int error, resid = 0;
+
+	error = vnode_open(path, O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("K60METAL: vnode_open %s error=%d\n", path, error);
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)data, len, 0,
+	    UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), &resid, current_proc());
+	if (!error && resid != 0) {
+		error = EIO;
+	}
+	/* The plugin requires st_uid == 0 and no group/other write bit. */
+	if (!error) {
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_mode);
+		VATTR_WANTED(&va, va_uid);
+		VATTR_WANTED(&va, va_gid);
+		va.va_mode = S_IFREG | 0644;
+		va.va_uid = 0;
+		va.va_gid = 0;
+		(void)vnode_setattr(vp, &va, ctx);
+	}
+	vnode_close(vp, 0, ctx);
+	printf("K60METAL: wrote %s bytes=%d resid=%d error=%d\n", path, len, resid, error);
+	return error;
+}
+
+/* Read one file out of the staged FAT volume and write it onto Data. */
+static int
+k60_metal_copy(const char *name)
+{
+	char from[256], to[256];
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	uint8_t *buf;
+	off_t size;
+	int error, resid = 0;
+
+	k60_metal_path(from, sizeof(from), K60_METAL_STAGE "/METAL", name);
+	k60_metal_path(to, sizeof(to), K60_METAL_DEST, name);
+
+	error = vnode_lookup(from, 0, &vp, ctx);
+	if (error) {
+		printf("K60METAL: lookup %s error=%d\n", from, error);
+		return error;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	error = vnode_getattr(vp, &va, ctx);
+	size = error ? 0 : (off_t)va.va_data_size;
+	if (size <= 0 || size > (off_t)(64u << 20)) {
+		printf("K60METAL: %s size %lld unusable\n", from, (long long)size);
+		vnode_put(vp);
+		return EINVAL;
+	}
+	buf = (uint8_t *)kalloc((vm_size_t)size);
+	if (!buf) {
+		vnode_put(vp);
+		return ENOMEM;
+	}
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)size, 0,
+	    UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid, NULL);
+	vnode_put(vp);
+	if (!error && resid != 0) {
+		error = EIO;
+	}
+	if (!error) {
+		error = k60_metal_write(to, buf, (int)size);
+	} else {
+		printf("K60METAL: read %s error=%d resid=%d\n", from, error, resid);
+	}
+	kfree(buf, (vm_size_t)size);
+	return error;
+}
+
+/* Mount the payload volume at the staging directory. */
+static int
+k60_metal_mount_stage(proc_t p, user_addr_t scratch)
+{
+	struct mount_args request = {
+	    .type = scratch, .path = scratch + 0x40,
+	    .flags = MNT_RDONLY, .data = scratch + 0x120 };
+	int32_t result = 0;
+	int error;
+
+	if ((error = copyout("msdos", request.type, 6)) ||
+	    (error = copyout(K60_METAL_STAGE, request.path, sizeof(K60_METAL_STAGE))) ||
+	    (error = copyout("/dev/md0", request.data, 10))) {
+		return error;
+	}
+	k60_metal_stage_state = 1;
+	error = mount(p, &request, &result);
+	k60_metal_stage_state = 2;
+	printf("K60METAL: mount md0 error=%d result=%d\n", error, result);
+	return error;
+}
+
+/*
+ * Deploy the bundle and bind it where the loader looks for plugins.
+ *
+ * The bind is a single directory, deliberately without MNT_UNION: binding the
+ * *parent* /System/Library/Extensions broke the dyld shared cache (P-93 --
+ * launchd then could not load /usr/lib/libSystem.B.dylib and pid 1 exited).
+ * Replacing only PongAdrenoMetal.bundle leaves that directory untouched.
+ */
+int
+k60_metal_deploy(proc_t p, user_addr_t scratch)
+{
+	struct mount_args request = {
+	    .type = scratch + 0x200, .path = scratch + 0x240,
+	    .flags = MNT_RDONLY, .data = scratch + 0x320 };
+	int32_t result = 0;
+	vnode_t probe = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	int i, error, deployed = 0;
+
+	(void)mdevlookup(0);
+
+	error = vnode_lookup(K60_METAL_SRC "/PongAdrenoMetal", 0, &probe, ctx);
+	if (error == 0) {
+		vnode_put(probe);
+		printf("K60METAL: bundle already present\n");
+	} else {
+		error = vnode_lookup(K60_METAL_STAGE, 0, &probe, ctx);
+		if (error) {
+			printf("K60METAL: no staging directory (%d); skipping\n", error);
+			return error;
+		}
+		vnode_put(probe);
+		if ((error = k60_metal_mount_stage(p, scratch)) != 0) {
+			return error;
+		}
+		for (i = 0; i < (int)(sizeof(k60_metal_files) / sizeof(k60_metal_files[0])); i++) {
+			if (k60_metal_copy(k60_metal_files[i]) == 0) {
+				deployed++;
+			}
+		}
+		printf("K60METAL: deployed %d/%d file(s)\n", deployed,
+		    (int)(sizeof(k60_metal_files) / sizeof(k60_metal_files[0])));
+		if (deployed == 0) {
+			return ENOENT;
+		}
+	}
+
+	/* bindfs needs the mount point to exist; the sealed root has no such bundle. */
+	if (vnode_lookup(K60_METAL_TARGET, 0, &probe, ctx) == 0) {
+		vnode_put(probe);
+	} else {
+		struct mkdir_args md;
+		int32_t mret = 0;
+
+		md.path = scratch + 0x300;
+		md.mode = 0755;
+		if ((error = copyout(K60_METAL_TARGET, md.path,
+		    sizeof(K60_METAL_TARGET))) != 0) {
+			return error;
+		}
+		error = mkdir(p, &md, &mret);
+		printf("K60METAL: mkdir target error=%d ret=%d\n", error, mret);
+		if (error) {
+			return error;
+		}
+	}
+	if ((error = copyout("bindfs", request.type, 7)) ||
+	    (error = copyout(K60_METAL_TARGET, request.path,
+	        sizeof(K60_METAL_TARGET))) ||
+	    (error = copyout(K60_METAL_SRC, request.data, sizeof(K60_METAL_SRC)))) {
+		return error;
+	}
+	error = mount(p, &request, &result);
+	printf("K60METAL: bind error=%d result=%d -> %s\n", error, result,
+	    error ? "NOT visible" : "visible to the loader");
+	return error;
+}
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7772,6 +7772,12 @@
 	printf("K60DATA mount returned error=%d result=%d rw=%u\n", error, result, k60_data_rw);
 	if (error) goto done;
 	k60_data_mounted = 1;
+	/* K60: place the Metal plugin bundle and bind it where the loader looks */
+	{
+		extern int k60_metal_deploy(proc_t, user_addr_t);
+
+		(void)k60_metal_deploy(p, scratch);
+	}
 	/* 0340: place the UI compatibility library on the Data volume */
 	{
 		extern int k60_uilib_deploy(void);
