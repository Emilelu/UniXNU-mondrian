+            memcpy(q->reply, e, n); q->reply_length = n; q->complete = true;
+            return;
+        }
+        if (n >= 6 && e[0] == 0x0f && (e[4] | (unsigned)e[5] << 8) == q->wait_opcode && e[2]) {
+            memcpy(q->reply, e, n); q->reply_length = n; q->complete = true;
+            return;
+        }
+    }
