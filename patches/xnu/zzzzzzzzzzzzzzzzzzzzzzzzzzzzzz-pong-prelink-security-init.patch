 	result = OSRuntimeInitializeCPP(this);
-	if (result == KERN_SUCCESS) {
+	if (result == KERN_SUCCESS && isPrelinked() &&
+	    k60_skip_prelinked_start(getIdentifierCString())) {
+		/* These components only validate Apple platform state that a
+		 * non-Apple boot cannot supply.  Leaving them unstarted keeps
+		 * result at KERN_SUCCESS, which is what their dependents check.
+		 */
+		printf("NATIVEPRELINK: skip start of %s\n", getIdentifierCString());
+	} else if (result == KERN_SUCCESS) {
 		result = startfunc(kmod_info, kmodStartData);
 	}
 
+	/* An explicitly linked security initializer must run with its real
