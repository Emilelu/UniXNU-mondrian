--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -3120,6 +3120,34 @@
 #endif
 	}
 
+	/*
+	 * K60 cartography: paint four quadrants and an origin marker with the
+	 * geometry the kernel believes it has.  The colours that land where tell
+	 * us the base offset, the stride ratio and any flip: TL red, TR green,
+	 * BL blue, BR white, and a 64x64 yellow square at the believed origin.
+	 * Written after vc_initialize() cleared the screen.
+	 */
+	if ((vinfo.v_baseaddr != 0) && (vinfo.v_rowbytes != 0) && (vinfo.v_height > 8)) {
+		volatile uint32_t *all = (volatile uint32_t *)(uintptr_t)vinfo.v_baseaddr;
+		unsigned int words = vinfo.v_rowbytes / 4;
+		unsigned int x, y;
+		for (y = 0; y < vinfo.v_height; y++) {
+			for (x = 0; x < words; x++) {
+				uint32_t colour;
+				if (y < vinfo.v_height / 2) {
+					colour = (x < words / 2) ? 0x000000FF : 0x0000FF00;
+				} else {
+					colour = (x < words / 2) ? 0x00FF0000 : 0x00FFFFFF;
+				}
+				all[y * words + x] = colour;
+			}
+		}
+		for (y = 0; (y < 64) && (y < vinfo.v_height); y++) {
+			for (x = 0; (x < 64) && (x < words); x++) {
+				all[y * words + x] = 0x0000FFFF;
+			}
+		}
+	}
 	/* Console initialization/acquisition may clear the existing mapping. */
 	boot_progress_bind(vinfo.v_baseaddr, vinfo.v_width, vinfo.v_height,
 	    vinfo.v_rowbytes, vinfo.v_depth);
