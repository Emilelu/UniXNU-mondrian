 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
@@ -725,6 +819,16 @@
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
