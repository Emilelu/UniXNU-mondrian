+/*
+ * 0411: out-of-band beacon on the CDC bulk IN endpoint (0x81, physical EP3).
+ * RESEARCH.md 24.8: in mode 1 the host port opens, DTR is set, and zero bytes
+ * arrive, so the console cannot witness its own gate. This path touches
+ * neither the ramoops ring, nor the log cursor, nor the console TRB: it
+ * composes the line in its own DMA slice and starts one transfer on its own
+ * TRB; the completion handler retires it.
+ *
+ * The buffer accumulates, because the first beacon is raised during
+ * SET_CONFIGURATION, when the host has not opened the port yet and a transfer
+ * would stay pending forever. Each later beacon replaces that pending
+ * transfer with one that carries every line written so far, so opening the
+ * port at any time still yields the whole history once and in order.
+ */
+static void
+ud_beacon(const char *msg)
+{
+	static const char prefix[] = "K60BEACON: ";
+	uint8_t *data = (uint8_t *)(ud.dma + UD_BEACON_DATA);
+	volatile uint32_t *trb = (volatile uint32_t *)(ud.dma + UD_BEACON_TRB);
+	uint64_t bpa;
+	uint64_t tpa;
+	uint32_t n;
+	uint32_t i;
+	int rc;
+
+	if (k60_usbvend_mode != 1 || !ud.configured || ud.failed) {
+		return;
+	}
+	if (ud.tx_active && !ud.beacon_pending) {
+		/* a console transfer owns EP3 right now */
+		return;
+	}
+	n = ud.beacon_len;
+	if (n + 1 >= UD_BEACON_MAX) {
+		n = 0;                 /* wrap: the newest line wins */
+	}
+	for (i = 0; prefix[i] != 0 && n + 1 < UD_BEACON_MAX; i++) {
+		data[n++] = (uint8_t)prefix[i];
+	}
+	for (i = 0; msg[i] != 0 && n + 1 < UD_BEACON_MAX; i++) {
+		data[n++] = (uint8_t)msg[i];
+	}
+	data[n++] = (uint8_t)'\n';
+	ud.beacon_len = n;
+	if (ud.beacon_pending) {
+		uint8_t res = ud.transferResource[3];
+
+		if (res) {
+			(void)ud_epcmd_full(3, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM |
+				DEPCMD_PARAM(res), 0, 0, 0);
+			ud.transferResource[3] = 0;
+		}
+		ud.beacon_pending = false;
+	}
+	bpa = ud.dma_pa + UD_BEACON_DATA;
+	tpa = ud.dma_pa + UD_BEACON_TRB;
+	trb[0] = (uint32_t)bpa;
+	trb[1] = (uint32_t)(bpa >> 32);
+	trb[2] = n;
+	trb[3] = TRBCTL_NORMAL | TRB_HWO | TRB_LST | TRB_IOC;
+	ud_sync(UD_BEACON_TRB, 16);
+	ud_sync(UD_BEACON_DATA, n);
+	rc = ud_epcmd(3, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32),
+	    (uint32_t)tpa, 0);
+	if (rc == 0) {
+		ud.beacon_pending = true;
+		ud.transferResource[3] = (uint8_t)((dwc_rd(DEPCMD(3)) >> 16) & 0x7f);
+		/* keep the console off EP3 until this transfer retires */
+		ud.tx_active = true;
+	}
+}
