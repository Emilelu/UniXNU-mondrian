+/* ------------------------------------------------------------------------- */
+/* S1b probe: delayed, marker-by-marker read-only GENI checkpoint              */
+/* Spec: docs/research/bt/S1-PROBE-SPEC.md.  Every risky access is announced  */
+/* before it happens, so a hang leaves the fatal step as the last console     */
+/* line instead of a silent zero-byte boot.                                   */
+/* ------------------------------------------------------------------------- */
+
+/* GENI SE register map: evidence linux-geni-se-v6.6.h:78-86 (0x40/0x64/0x68),
+ * :132-134 (FW_REV_PROTOCOL), qcom-geni-se.c:114 (QUP_HW_VER_REG 0x4),
+ * linux-geni-se-v6.6.h:287 (QUP_SE_VERSION_2_5).  0x2ac/0xc40/0xd40/0xe40
+ * decide 06-DEEP-DIVE.md F2/F3. */
+#define K60_SE_GENI_STATUS          0x040u
+#define K60_GENI_IF_DISABLE_RO      0x064u
+#define K60_GENI_FW_REVISION_RO     0x068u
+#define K60_QUP_HW_VER_REG          0x004u
+#define K60_G_MANUAL_RFR            0x2ACu
+#define K60_SE_DMA_TX_IRQ_STAT      0xC40u
+#define K60_SE_DMA_RX_IRQ_STAT      0xD40u
+#define K60_SE_RSVD_0E40            0xE40u
+
+#define K60_PROBE_DELAY_SECS        20u
+#define K60_PROBE_MAX_DELAY_SECS    120u
+#define K60_PROBE_MAX_STEP          6u
+#define K60_PROBE_DRAIN_US          2000u
+
+static void k60_probe_mark(const char *step) {
+    k60_log(NULL, 1, step);
+    /* Let the CDC ring drain before the next register access: if that access
+     * wedges the bus, this line is already on the host side. */
+    IODelay(K60_PROBE_DRAIN_US);
+}
+
+static void k60_probe_u32(const char *tag, uint32_t value) {
+    char line[160];
+    snprintf(line, sizeof(line), "probe: %s=%08x", tag, value);
+    k60_log(NULL, 1, line);
+    IODelay(K60_PROBE_DRAIN_US);
+}
+
+static int k60_bt_probe(unsigned step) {
+    char line[192];
+
+    k60_probe_mark("probe: s1 map gcc/uart/qup");
+    int e = k60_map(&k60.gcc, K60_GCC_BASE, K60_GCC_SIZE);
+    if (!e) e = k60_map(&k60.uart, K60_BT_UART_BASE, K60_BT_UART_SIZE);
+    if (!e) e = k60_map(&k60.qup, K60_BT_QUP_WRAPPER_BASE, K60_BT_QUP_WRAPPER_SIZE);
+    if (e) {
+        snprintf(line, sizeof(line), "probe: map failed e=%d", e);
+        k60_log(NULL, 1, line);
+        return e;
+    }
+    snprintf(line, sizeof(line), "probe: s1 mapped gcc=%llx uart=%llx qup=%llx step=%u",
+             (unsigned long long)(uintptr_t)k60.gcc.va,
+             (unsigned long long)(uintptr_t)k60.uart.va,
+             (unsigned long long)(uintptr_t)k60.qup.va, step);
+    k60_log(NULL, 1, line);
+    IODelay(K60_PROBE_DRAIN_US);
+
+    if (step >= 2) {
+        k60_probe_mark("probe: s2 read gpll0_cmd");
+        uint32_t v = k60_read32(&k60.gcc, K60_GCC_GPLL0_CMD);
+        k60_probe_u32("s2 gpll0_cmd", v);
+        k60_probe_mark("probe: s2 write gpll0_cmd");
+        k60_write32(&k60.gcc, K60_GCC_GPLL0_CMD, v | 1u);
+        k60_probe_mark("probe: s2 poll gpll0 lock");
+        unsigned spins = 0, locked = 0;
+        for (; spins < 1000; spins++) {
+            if (k60_read32(&k60.gcc, 0x0u) & (1u << 31)) { locked = 1; break; }
+            IODelay(1);
+        }
+        snprintf(line, sizeof(line), "probe: s2 locked=%u spins=%u", locked, spins);
+        k60_log(NULL, 1, line);
+        IODelay(K60_PROBE_DRAIN_US);
+        if (!locked) return -ETIMEDOUT;
+    }
+
+    if (step >= 3) {
+        k60_probe_mark("probe: s3 read qup vote");
+        uint32_t v = k60_read32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE);
+        k60_probe_u32("s3 qup_vote_before", v);
+        k60_probe_mark("probe: s3 write qup vote");
+        k60_write32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE, v | K60_GCC_VOTE_ALL);
+        k60_probe_mark("probe: s3 read qup vote back");
+        v = k60_read32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE);
+        k60_probe_u32("s3 qup_vote_after", v);
+    }
+
+    if (step >= 4) {
+        static const char *const names[5] = { "core", "core2x", "m_ahb", "s_ahb", "se20" };
+        static const uint32_t regs[5] = {
+            K60_GCC_WRAP2_CORE_HALT, K60_GCC_WRAP2_CORE_2X_HALT,
+            K60_GCC_WRAP2_M_AHB_HALT, K60_GCC_WRAP2_S_AHB_HALT,
+            K60_GCC_WRAP2_SE20_HALT,
+        };
+        for (unsigned i = 0; i < 5; i++) {
+            snprintf(line, sizeof(line), "probe: s4 read halt %s", names[i]);
+            k60_probe_mark(line);
+            uint32_t v = k60_read32(&k60.gcc, regs[i]);
+            snprintf(line, sizeof(line), "probe: s4 halt %s=%08x", names[i], v);
+            k60_log(NULL, 1, line);
+            IODelay(K60_PROBE_DRAIN_US);
+        }
+    }
+
+    if (step >= 5) {
+        static const char *const names[4] = { "status", "if_disable", "fw_rev", "rfr" };
+        static const uint32_t offs[4] = {
+            K60_SE_GENI_STATUS, K60_GENI_IF_DISABLE_RO,
+            K60_GENI_FW_REVISION_RO, K60_G_MANUAL_RFR,
+        };
+        for (unsigned i = 0; i < 4; i++) {
+            snprintf(line, sizeof(line), "probe: s5 read se %s", names[i]);
+            k60_probe_mark(line);
+            uint32_t v = k60_read32(&k60.uart, offs[i]);
+            snprintf(line, sizeof(line), "probe: s5 se %s=%08x", names[i], v);
+            k60_log(NULL, 1, line);
+            IODelay(K60_PROBE_DRAIN_US);
+        }
+        k60_probe_mark("probe: s5 read qup hw ver");
+        k60_probe_u32("s5 qup_hw_ver", k60_read32(&k60.qup, K60_QUP_HW_VER_REG));
+    }
+
+    if (step >= 6) {
+        static const char *const names[4] = { "dma_tx", "dma_rx", "rsvd_e40", "status2" };
+        static const uint32_t offs[4] = {
+            K60_SE_DMA_TX_IRQ_STAT, K60_SE_DMA_RX_IRQ_STAT,
+            K60_SE_RSVD_0E40, K60_SE_GENI_STATUS,
+        };
+        for (unsigned i = 0; i < 4; i++) {
+            snprintf(line, sizeof(line), "probe: s6 read se %s", names[i]);
+            k60_probe_mark(line);
+            uint32_t v = k60_read32(&k60.uart, offs[i]);
+            snprintf(line, sizeof(line), "probe: s6 se %s=%08x", names[i], v);
+            k60_log(NULL, 1, line);
+            IODelay(K60_PROBE_DRAIN_US);
+        }
+    }
+
+    k60_probe_mark("probe: done");
+    return 0;
+}
+
