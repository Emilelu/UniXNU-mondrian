+# Extract from this Pong's modem_a, read-only. Keep these local, outside Git.
+# scripts/prepare-pong-wifi.py records the actual inventory and board inputs.
+image/qca6490/amss.bin
+image/qca6490/amss20.bin
+image/qca6490/m3.bin
+image/qca6490/regdb.bin
+image/qca6490/bdwlan.*
