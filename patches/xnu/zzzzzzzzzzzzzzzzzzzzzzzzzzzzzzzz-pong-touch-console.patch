+/* Goodix Berlin-D on Redmi K60 / SM8475. Adapted from HackiOS
+ * redwood_goodix.c (APSL 2.0) and the Pong driver. Board resources come
+ * from the K60 live FDT; Berlin framing follows the Linux transport. */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/pong_input.h>
+#include <kern/sched_prim.h>
+#include <pexpert/device_tree.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+static vm_offset_t gpio_pages[7], gcc_qup, gcc_core, gcc_vote, gcc_pll, se;
+static uint64_t tlmm_phys, gcc_phys, se_phys;
+static uint32_t pins[6], bitbang_pins[4], gpio_offset, avdd_gpio, max_x, max_y;
+static uint32_t touch_stage, touch_delay_ms, spi_hz, flip;
+static bool force_rcg, bitbang_wiring;
+
+static bool
+property(DTEntry entry, const char *name, void *out, unsigned size)
+{
+    void *value = NULL; unsigned length = 0;
+    if (SecureDTGetProperty(entry, name, &value, &length) != kSuccess || length != size) return false;
+    memcpy(out, value, size); return true;
+}
+
+static bool
+configuration(void)
+{
+    DTEntry entry;
+    if (SecureDTLookupEntry(NULL, "/arm-io/pong-touch", &entry) != kSuccess) return false;
+    /* GPIO fallback requires an independently established role tuple:
+     * MISO, MOSI, CLK, CS. The qup4 pad set alone proves no direction. */
+    bitbang_wiring = property(entry, "bitbang-pins", bitbang_pins, sizeof(bitbang_pins));
+    uint32_t mask = 0;
+    if (bitbang_wiring) {
+        for (unsigned i = 0; i < 4; i++) {
+            if (bitbang_pins[i] < 16 || bitbang_pins[i] > 19 || (mask & (1u << (bitbang_pins[i] - 16)))) {
+                bitbang_wiring = false;
+                break;
+            }
+            mask |= 1u << (bitbang_pins[i] - 16);
+        }
+        bitbang_wiring = bitbang_wiring && mask == 15 && bitbang_pins[3] == 19;
+    }
+    return property(entry,"spi-base",&se_phys,8) && property(entry,"tlmm-base",&tlmm_phys,8) &&
+        property(entry,"gcc-base",&gcc_phys,8) && property(entry,"gpio-offset",&gpio_offset,4) &&
+        property(entry,"pins",pins,sizeof(pins)) && property(entry,"avdd-gpio",&avdd_gpio,4) &&
+        property(entry,"max-x",&max_x,4) && property(entry,"max-y",&max_y,4) &&
+        se_phys==0x990000 && tlmm_phys==0xf000000 && gcc_phys==0x100000 &&
+        gpio_offset==0x100000 && pins[0]==16 && pins[1]==17 && pins[2]==18 &&
+        pins[3]==19 && pins[4]==21 && pins[5]==20 && avdd_gpio==71 &&
+        max_x==14400 && max_y==32000;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	assert_wait_deadline((event_t)&touch_stage, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- pins (TLMM) ------------------------------------------------------------------------------- */
+
+#define TLMM_PHYS               tlmm_phys
+/* io_submap is shared with every other device. Map exactly GPIO16-21 and
+ * GPIO71, one 4 KiB page each; never create a biased pointer from a failed map. */
+#define IO_PAGE_SIZE            0x1000UL
+#define GPIO_PAGE(n)            gpio_pages[(n) == avdd_gpio ? 6u : (n) - 16u]
+#define GPIO_CFG(n)             (GPIO_PAGE(n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (GPIO_PAGE(n) + 4)     /* bit 0 in, bit 1 out */
+#define GPIO_IRQ_CFG(n)         (GPIO_PAGE(n) + 8)
+#define GPIO_IRQ_STATUS(n)      (GPIO_PAGE(n) + 12)
+#define PULL_NONE               0
+#define PULL_UP                 3
+
+/* pins[0..3] are ascending qup4 pads. GPIO SPI uses separately proven
+ * directions: bitbang-pins is MISO/MOSI/CLK/CS, never a permutation probe. */
+#define PIN_MISO                bitbang_pins[0]
+#define PIN_MOSI                bitbang_pins[1]
+#define PIN_CLK                 bitbang_pins[2]
+#define PIN_CS                  pins[3]
+#define PIN_INT                 pins[4]      /* active-low report hint, never a power-good indication */
+#define PIN_RESET               pins[5]     /* low = in reset */
+#define PIN_FUNCTION_SPI        1           /* cape TLMM qup4 on GPIO16-19 */
+
+static bool
+pins_map(void)
+{
+    printf("Pong touch: mapping only TLMM GPIO16-21 and GPIO71 pages\n");
+    for (unsigned i = 0; i < 6; i++) {
+        vm_offset_t page = ml_io_map(TLMM_PHYS + gpio_offset + 0x1000UL * pins[i], IO_PAGE_SIZE);
+        if (!page) return false;
+        gpio_pages[pins[i] - 16] = page;
+    }
+    gpio_pages[6] = ml_io_map(TLMM_PHYS + gpio_offset + 0x1000UL * avdd_gpio, IO_PAGE_SIZE);
+    return gpio_pages[6] != 0;
+}
+
+static void
+gpio_configure(unsigned pin, unsigned function, unsigned pull, unsigned ma, bool output)
+{
+	uint32_t value = pull | function << 2 | (ma / 2 - 1) << 6 | (output ? 1u << 9 : 0);
+	wr(GPIO_CFG(pin), (rd(GPIO_CFG(pin)) & ~0x3ffu) | value);
+}
+
+static void
+gpio_set(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), high ? 2 : 0);
+}
+
+static bool
+gpio_get(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+gpio_output(unsigned pin, bool high, unsigned pull, unsigned ma)
+{
+	gpio_set(pin, high);            /* the level first, so that the pin never drives the wrong one */
+	gpio_configure(pin, 0, pull, ma, true);
+}
+
+/* ---- K60 supplies ------------------------------------------------------------------------------- */
+
+static void
+io_supply_on(void)
+{
+    /* AVDD is a load-switch GPIO. IOVDD is pm8350c_l2 at 1.8 V, not the
+     * Pong ldoc3/ldoc12 pair. No RSC, TCS or command-database access is safe
+     * on this board. Retained IOVDD is a prerequisite, NOT measured power. */
+    printf("Pong touch: require retained pm8350c_l2 IOVDD 1.8 V; no rail vote or power-good claim\n");
+    gpio_output(avdd_gpio, true, PULL_NONE, 6);
+    sleep_ms(15);
+    printf("Pong touch: AVDD GPIO%u enabled, IRQ=%u (level only)\n", avdd_gpio, gpio_get(PIN_INT));
+}
+
+/* ---- clocks (GCC) -------------------------------------------------------------------------------- */
+
+#define GCC_PHYS                gcc_phys
+#define GCC_QUP_OFFSET          0x27000UL
+#define GCC_CORE_OFFSET         0x33000UL
+#define GCC_VOTE_OFFSET         0x62000UL
+#define GCC_VOTE                (gcc_vote + 0x0008)    /* application processor branch votes */
+#define VOTE_QUP0_CORE_2X       (1u << 9)
+#define VOTE_QUP0_CORE          (1u << 8)
+#define VOTE_QUP0_M_AHB         (1u << 6)
+#define VOTE_QUP0_S_AHB         (1u << 7)
+#define VOTE_QUP0_SE4           (1u << 14)             /* wrapper 0 serial engine 4 */
+#define VOTE_QUP0_ALL           (VOTE_QUP0_CORE_2X | VOTE_QUP0_CORE | VOTE_QUP0_M_AHB | VOTE_QUP0_S_AHB | VOTE_QUP0_SE4)
+#define GCC_QUP0_CORE_CBCR      (gcc_core + 0x0000)
+#define GCC_QUP0_CORE_2X_CBCR   (gcc_core + 0x000c)
+#define GCC_QUP0_M_AHB_CBCR     (gcc_qup + 0x0004)      /* bit 31 off, bit 1 hardware clock gating */
+#define GCC_QUP0_S_AHB_CBCR     (gcc_qup + 0x0008)
+#define GCC_QUP0_SE4_CBCR       (gcc_qup + 0x04dc)
+#define GCC_QUP0_SE4_CMD        (gcc_qup + 0x04e4)
+#define GCC_QUP0_SE4_CFG        (gcc_qup + 0x04e8)
+#define GCC_QUP0_SE4_DFSR       (gcc_qup + 0x04f8)
+#define GCC_QUP0_SE4_PERF_CFG(l) (gcc_qup + 0x0500 + 4 * (l))
+#define GCC_QUP0_SE4_PERF_M(l)  (gcc_qup + 0x0540 + 4 * (l))
+#define GCC_QUP0_SE4_PERF_N(l)  (gcc_qup + 0x0580 + 4 * (l))
+#define CLOCK_OFF               (1u << 31)
+#define HWCG                    (1u << 1)               /* gcc-sm8450.c: hwcg_bit = 1 on the AHB branches */
+/* gcc_gpll0 (gcc-sm8450.c:50-55): enable_reg 0x62018 BIT(0), offset 0x0, LUCID_EVO.
+ * PLL_MODE = offset + 0x0 and its lock indication is BIT(31) (clk-alpha-pll.c:16,34). */
+#define GCC_GPLL0_ENABLE        (gcc_vote + 0x0018)
+#define VOTE_GPLL0              (1u << 0)
+#define GCC_GPLL0_MODE          (gcc_pll + 0x0000)
+#define PLL_LOCK                (1u << 31)
+#define XO_HZ                   19200000
+#define CMD_UPDATE              (1u << 0)
+#define CMD_ROOT_EN             (1u << 1)
+#define CMD_ROOT_OFF            (1u << 31)
+
+static uint32_t se_source_hz, se_clock_select;
+
+/* Existing staged argument: 1 maps, 2 pins/AVDD, 3 GCC, 4 +core clocks,
+ * 5 identify only, 6 real input, 7 GPIO-only identification (no GCC/SE).
+ * The normal K60 path is stage 6, with an 8-second deferred start. */
+
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	static const uint32_t parent[8] = { XO_HZ, 600000000, 0, 0, 0, 0, 300000000, 0 };
+	uint64_t hz = parent[cfg >> 8 & 7];
+	uint32_t divider = cfg & 0x1f, mode = cfg >> 12 & 3;
+
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffff) + (m & 0xffff);
+
+		if (n) {
+			hz = hz * (m & 0xffff) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+static bool
+cbcr_running(uint32_t cbcr)
+{
+	/* TouchProbe.cpp:406 -- a hardware-clock-gated branch (bit 1) reports CLK_OFF while
+	 * idle and wakes on the next access, so only a branch without that bit must have
+	 * CLK_OFF clear. Demanding CLK_OFF==0 from a gated branch is a false negative. */
+	return !(cbcr & CLOCK_OFF) || (cbcr & HWCG);
+}
+
+static bool
+clocks_map(void)
+{
+    printf("Pong touch: mapping GCC QUP/PLL/vote pages, no serial-engine access\n");
+    gcc_qup = ml_io_map(GCC_PHYS + GCC_QUP_OFFSET, IO_PAGE_SIZE);
+    gcc_vote = ml_io_map(GCC_PHYS + GCC_VOTE_OFFSET, IO_PAGE_SIZE);
+    gcc_pll = ml_io_map(GCC_PHYS, IO_PAGE_SIZE);
+    if (!gcc_qup || !gcc_vote || !gcc_pll) return false;
+    if (touch_stage >= 4) {
+        gcc_core = ml_io_map(GCC_PHYS + GCC_CORE_OFFSET, IO_PAGE_SIZE);
+        if (!gcc_core) return false;
+    }
+    return true;
+}
+
+static bool
+clock_wait(vm_offset_t address, uint32_t mask, uint32_t value)
+{
+    for (unsigned i = 0; i < 10000; i++) {
+        if ((rd(address) & mask) == value) return true;
+        sleep_us(10);
+    }
+    return false;
+}
+
+static bool
+clocks_on(void)
+{
+    uint32_t m_ahb = 0, s_ahb = 0, core = 0, core2x = 0, se4 = 0;
+    bool ready = false;
+
+    printf("Pong touch: GCC GPLL0 vote at %#llx\n", (unsigned long long)(GCC_PHYS + 0x62018));
+    wr(GCC_GPLL0_ENABLE, rd(GCC_GPLL0_ENABLE) | VOTE_GPLL0);
+    if (!clock_wait(GCC_GPLL0_MODE, PLL_LOCK, PLL_LOCK)) {
+        printf("Pong touch: GPLL0 did not lock (mode %#x); refusing SE access\n", rd(GCC_GPLL0_MODE));
+        return false;
+    }
+    wr(GCC_VOTE, rd(GCC_VOTE) | VOTE_QUP0_ALL);
+    if ((rd(GCC_VOTE) & VOTE_QUP0_ALL) != VOTE_QUP0_ALL) {
+        printf("Pong touch: GCC refused QUP0 vote %#x\n", rd(GCC_VOTE));
+        return false;
+    }
+
+    /* clk-rcg2's shared RCG sequence forces the root before changing
+     * configuration. ROOT_OFF is status, never the enable request. */
+    wr(GCC_QUP0_SE4_CMD, rd(GCC_QUP0_SE4_CMD) | CMD_ROOT_EN);
+    if (!clock_wait(GCC_QUP0_SE4_CMD, CMD_ROOT_OFF, 0)) {
+        printf("Pong touch: SE4 root did not turn on; refusing SE access\n");
+        return false;
+    }
+    se_source_hz = 0;
+    se_clock_select = 0;
+    if ((rd(GCC_QUP0_SE4_DFSR) & 1) && !force_rcg) {
+        /* Keep the vendor DFS tables intact and select a real rate through
+         * GENI_CLK_SEL. Never infer axes or protocol from clock registers. */
+        for (uint32_t level = 0; level < 8; level++) {
+            uint32_t hz = rcg_rate(rd(GCC_QUP0_SE4_PERF_CFG(level)), rd(GCC_QUP0_SE4_PERF_M(level)),
+                rd(GCC_QUP0_SE4_PERF_N(level)));
+            if (hz >= spi_hz && (!se_source_hz || hz < se_source_hz)) {
+                se_source_hz = hz;
+                se_clock_select = level;
+            }
+        }
+        if (!se_source_hz) {
+            printf("Pong touch: no usable SE4 DFS rate; refusing SE access\n");
+            return false;
+        }
+    } else {
+        /* TCXO, undivided. CFG bit20 is hardware clock control; preserve
+         * unrelated fields. ROOT_OFF is read-only: ROOT_EN is the request. */
+        wr(GCC_QUP0_SE4_CFG, (rd(GCC_QUP0_SE4_CFG) & ~0x371fu) | (1u << 20) | 1u);
+        se_source_hz = XO_HZ;
+    }
+    wr(GCC_QUP0_SE4_CMD, rd(GCC_QUP0_SE4_CMD) | CMD_ROOT_EN | CMD_UPDATE);
+    if (!clock_wait(GCC_QUP0_SE4_CMD, CMD_UPDATE | CMD_ROOT_OFF, 0)) {
+        printf("Pong touch: SE4 root/update timeout (cmd %#x); refusing SE access\n", rd(GCC_QUP0_SE4_CMD));
+        return false;
+    }
+
+    printf("Pong touch: checking GCC QUP0 clocks, stage %u\n", touch_stage);
+    for (unsigned i = 0; i < 2000; i++) {
+        m_ahb = rd(GCC_QUP0_M_AHB_CBCR);
+        s_ahb = rd(GCC_QUP0_S_AHB_CBCR);
+        se4 = rd(GCC_QUP0_SE4_CBCR);
+        ready = cbcr_running(m_ahb) && cbcr_running(s_ahb) && !(se4 & CLOCK_OFF);
+        if (touch_stage >= 4) {
+            core = rd(GCC_QUP0_CORE_CBCR);
+            core2x = rd(GCC_QUP0_CORE_2X_CBCR);
+            ready = ready && !(core & CLOCK_OFF) && !(core2x & CLOCK_OFF);
+        }
+        if (ready) break;
+        sleep_us(10);
+    }
+    printf("Pong touch: clocks vote=%#x m=%#x s=%#x se4=%#x core=%#x core2x=%#x src=%u sel=%u\n",
+        rd(GCC_VOTE), m_ahb, s_ahb, se4, core, core2x, se_source_hz, se_clock_select);
+    if (!ready) printf("Pong touch: clocks not ready; refusing serial-engine access\n");
+    return ready;
+}
+
+/* ---- SPI through the serial engine (GENI) ---------------------------------------------------------- */
+
+#define SE_PHYS                 se_phys
+#define SE_SIZE                 0x4000UL
+#define GENI_FORCE_DEFAULT      (se + 0x020)
+#define GENI_OUTPUT_CTRL        (se + 0x024)
+#define GENI_CGC_CTRL           (se + 0x028)
+#define GENI_STATUS             (se + 0x040)    /* bit 0: a command is running */
+#define GENI_SER_M_CLK_CFG      (se + 0x048)    /* bit 0 enable, [15:4] divider */
+#define GENI_IF_DISABLE_RO      (se + 0x064)    /* bit 0: no FIFO interface */
+#define GENI_FW_REVISION_RO     (se + 0x068)    /* [15:8] protocol: 1 = SPI */
+#define GENI_CLK_SEL            (se + 0x07c)
+#define SPI_CPHA                (se + 0x224)
+#define SPI_LOOPBACK            (se + 0x22c)
+#define SPI_CPOL                (se + 0x230)
+#define SPI_DEMUX_OUTPUT_INV    (se + 0x24c)
+#define SPI_DEMUX_SEL           (se + 0x250)
+#define GENI_BYTE_GRAN          (se + 0x254)
+#define GENI_DMA_MODE_EN        (se + 0x258)
+#define SPI_TRANS_CFG           (se + 0x25c)
+#define GENI_TX_PACKING_CFG0    (se + 0x260)
+#define GENI_TX_PACKING_CFG1    (se + 0x264)
+#define SPI_WORD_LEN            (se + 0x268)
+#define SPI_TX_TRANS_LEN        (se + 0x26c)
+#define SPI_RX_TRANS_LEN        (se + 0x270)
+#define SPI_DELAY_COUNTERS      (se + 0x278)
+#define GENI_RX_PACKING_CFG0    (se + 0x284)
+#define GENI_RX_PACKING_CFG1    (se + 0x288)
+#define GENI_M_CMD0             (se + 0x600)    /* [31:27] operation */
+#define GENI_M_CMD_CTRL         (se + 0x604)    /* bit 2 cancel, bit 1 abort */
+#define GENI_M_IRQ_STATUS       (se + 0x610)
+#define GENI_M_IRQ_EN           (se + 0x614)
+#define GENI_M_IRQ_CLEAR        (se + 0x618)
+#define GENI_S_IRQ_CLEAR        (se + 0x648)
+#define GENI_TX_FIFO            (se + 0x700)
+#define GENI_RX_FIFO            (se + 0x780)
+#define GENI_TX_FIFO_STATUS     (se + 0x800)    /* [27:0] words */
+#define GENI_RX_FIFO_STATUS     (se + 0x804)    /* bit 31 last, [30:28] bytes of the last word, [24:0] words */
+#define GENI_TX_WATERMARK       (se + 0x80c)
+#define GENI_RX_WATERMARK       (se + 0x810)
+#define GENI_RX_RFR_WATERMARK   (se + 0x814)
+#define SE_DMA_TX_IRQ_CLR       (se + 0xc44)
+#define SE_DMA_RX_IRQ_CLR       (se + 0xd44)
+#define SE_GSI_EVENT_EN         (se + 0xe18)
+#define SE_IRQ_EN               (se + 0xe1c)
+#define SE_HW_PARAM_0           (se + 0xe24)    /* [21:16] FIFO depth in words */
+#define SE_DMA_GENERAL_CFG      (se + 0xe30)
+
+#define M_CMD_DONE              (1u << 0)
+#define M_CMD_CANCEL            (1u << 4)
+#define M_CMD_ABORT             (1u << 5)
+#define M_ERRORS                ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define SPI_FULL_DUPLEX         (3u << 27)
+
+static uint32_t fifo_depth;
+
+/* 0 = ready; otherwise why the engine cannot be used */
+static const char *
+geni_spi_init(uint32_t hz, bool *gpio_spi)
+{
+	uint32_t divider, fw = rd(GENI_FW_REVISION_RO), interfaces = rd(GENI_IF_DISABLE_RO);
+	*gpio_spi = (interfaces & 1) != 0;
+	printf("Pong touch: SE4 firmware=%#x protocol=%u interfaces=%#x\n", fw, (fw >> 8) & 0xff, interfaces);
+	/* Vendor GENI selects GSI when FIFO_IF_DISABLE is set. Never force FIFO,
+	 * invent a depth or access its data path; use the physical GPIO bus. */
+	if (*gpio_spi) return "the serial engine's FIFO interface is disabled";
+	if ((fw >> 8 & 0xff) != 1) return "the serial engine has no SPI firmware";
+	uint32_t geometry = rd(SE_HW_PARAM_0);
+	fifo_depth = geometry >> 16 & 0x3f;
+	if (fifo_depth < 4 || ((geometry >> 24) & 0x3f) != 32) {
+		return "the serial engine reports no usable 32-bit FIFO";
+	}
+	printf("Pong touch: GENI FIFO depth=%u, width=32 bits\n", fifo_depth);
+	if (rd(GENI_STATUS) & 1) return "the serial engine has an active command";
+	wr(SE_IRQ_EN, 0);       /* SPI605 has no handler: disable SE outputs, not pollable status. */
+	wr(SE_GSI_EVENT_EN, 0);
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(GENI_S_IRQ_CLEAR, 0xffffffff);
+	wr(SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	wr(GENI_CGC_CTRL, rd(GENI_CGC_CTRL) | 0x7f);
+	wr(SE_DMA_GENERAL_CFG, rd(SE_DMA_GENERAL_CFG) | 0xf);
+	wr(GENI_OUTPUT_CTRL, 0x7f);
+	wr(GENI_FORCE_DEFAULT, 1);
+	wr(GENI_DMA_MODE_EN, rd(GENI_DMA_MODE_EN) & ~1u);
+	wr(GENI_RX_WATERMARK, fifo_depth - 3);
+	wr(GENI_RX_RFR_WATERMARK, fifo_depth - 2);
+	wr(GENI_TX_WATERMARK, 0);
+	/* Local status sources stay enabled for polling; no interrupt output
+	 * is enabled toward the GIC, regardless of the bootloader's IRQ mask. */
+	wr(GENI_M_IRQ_EN, 0x7fc0007f);
+
+	/* mode 0, chip select 0, 8 bits, most significant first, four bytes in a FIFO word */
+	wr(SPI_LOOPBACK, 0);
+	wr(SPI_DEMUX_SEL, 0);
+	wr(SPI_CPHA, 0);
+	wr(SPI_CPOL, 0);
+	wr(SPI_DEMUX_OUTPUT_INV, 0);
+	wr(SPI_TRANS_CFG, rd(SPI_TRANS_CFG) & ~2u);
+	wr(SPI_DELAY_COUNTERS, 0);
+	wr(GENI_TX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_TX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_RX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_RX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_BYTE_GRAN, 0);
+	wr(SPI_WORD_LEN, 8 - 4);
+
+	divider = (se_source_hz + hz - 1) / hz;
+	if (!divider || divider > 0xfff) return "the SPI divider is outside the GENI clock range";
+	wr(GENI_CLK_SEL, se_clock_select & 7);
+	wr(GENI_SER_M_CLK_CFG, divider << 4 | 1);
+	printf("Pong touch: GENI clock=%#x source=%u SPI<=%u Hz, IRQ outputs off\n",
+	    rd(GENI_SER_M_CLK_CFG), se_source_hz, hz);
+	return NULL;
+}
+
+static void
+geni_drain(uint8_t *rx, uint32_t length, uint32_t *received)
+{
+	uint32_t status = rd(GENI_RX_FIFO_STATUS), words = status & 0x01ffffff, bytes = words * 4;
+	if (words > fifo_depth) return; /* inaccessible/bad status must not cause an unbounded MMIO drain */
+
+	if (status & 0x80000000u) {
+		uint32_t valid = status >> 28 & 7;
+
+		if (valid && valid < 4) {
+			if (words) bytes -= 4 - valid;
+		}
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		uint32_t word = rd(GENI_RX_FIFO);
+
+		for (int j = 0; j < 4 && bytes; j++, bytes--) {
+			if (*received < length) {
+				if (rx) {
+					rx[*received] = (uint8_t)(word >> (8 * j));
+				}
+				(*received)++;
+			}
+		}
+	}
+}
+
+static bool
+geni_recover(void)
+{
+    wr(GENI_M_CMD_CTRL, 1u << 2);
+    for (unsigned i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & (M_CMD_CANCEL | M_CMD_DONE)); i++) sleep_us(100);
+    if (!(rd(GENI_M_IRQ_STATUS) & (M_CMD_CANCEL | M_CMD_DONE))) {
+        wr(GENI_M_CMD_CTRL, 1u << 1);
+        for (unsigned i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & (M_CMD_ABORT | M_CMD_DONE)); i++) sleep_us(100);
+    }
+    bool idle = !(rd(GENI_STATUS) & 1);
+    if (idle) {
+        for (uint32_t i = 0; i < fifo_depth && (rd(GENI_RX_FIFO_STATUS) & 0x01ffffff); i++) (void)rd(GENI_RX_FIFO);
+    }
+    wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+    if (!idle) printf("Pong touch: GENI cancel/abort did not stop the active command\n");
+    return idle;
+}
+
+/* One transfer with the chip selected throughout: `length` bytes out (zeros without tx) and as many in. */
+static bool
+geni_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	static unsigned complaints;
+	uint32_t sent = 0, received = 0, status = 0;
+	uint64_t deadline;
+
+	if (!length || length > 1032) return false;
+	for (unsigned i = 0; i < 2000 && (rd(GENI_STATUS) & 1); i++) sleep_us(100);
+	if ((rd(GENI_STATUS) & 1) && !geni_recover()) return false;
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(SPI_TX_TRANS_LEN, length);
+	wr(SPI_RX_TRANS_LEN, length);
+	wr(GENI_M_CMD0, SPI_FULL_DUPLEX);
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint32_t queued = rd(GENI_TX_FIFO_STATUS) & 0x0fffffff;
+		if (queued > fifo_depth) break;
+		/* Reserve one word as in the existing FIFO path; bound every inner
+		 * refill even if a hardware status register stops changing. */
+		uint32_t available = fifo_depth - queued;
+		while (sent < length && available > 1) {
+			available--;
+			uint32_t word = 0;
+
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)(tx ? tx[sent] : 0) << (8 * j);
+			}
+			wr(GENI_TX_FIFO, word);
+		}
+		status = rd(GENI_M_IRQ_STATUS);
+		geni_drain(rx, length, &received);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if (status & M_CMD_DONE) {
+			geni_drain(rx, length, &received);
+			wr(GENI_M_IRQ_CLEAR, status);
+			if (sent == length && received == length) {
+				return true;
+			}
+			break;
+		}
+	}
+	if (complaints++ < 8) {
+		printf("goodix: SPI transfer of %u bytes failed: status %#x, sent %u, received %u\n", length, status, sent,
+		    received);
+	}
+	(void)geni_recover();
+	return false;
+}
+
+/* ---- SPI by hand, on the same pins ----------------------------------------------------------------- */
+
+static bool
+bitbang_init(void)
+{
+    if (!bitbang_wiring) {
+        printf("Pong touch: GPIO SPI unavailable: qup4 pin roles not established in bitbang-pins; no pads driven\n");
+        return false;
+    }
+    gpio_output(PIN_CS, true, PULL_UP, 6);
+    gpio_configure(PIN_MISO, 0, PULL_NONE, 6, false);
+    gpio_output(PIN_CLK, false, PULL_NONE, 6);
+    gpio_output(PIN_MOSI, false, PULL_NONE, 6);
+    return true;
+}
+
+/* GPIO runs far faster than a Berlin-D samples; 2 us per half period is
+ * the measured working rate (see the two prior bring-ups). */
+static uint32_t bb_delay_us = 2;
+
+static void
+bb_half_delay(void)
+{
+    if (bb_delay_us) sleep_us(bb_delay_us);
+}
+
+static bool
+bitbang_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+    if (!length || length > 1032) return false;
+    /* Mode 0, MSB first, with CS held for the entire Berlin frame. The
+     * explicit half-cycle delays bound GPIO SPI to at most 500 kHz. */
+    gpio_set(PIN_CS, false);
+    bb_half_delay();
+    for (uint32_t i = 0; i < length; i++) {
+        uint8_t out = tx ? tx[i] : 0, in = 0;
+        for (int bit = 7; bit >= 0; bit--) {
+            gpio_set(PIN_MOSI, (out >> bit) & 1);
+            bb_half_delay();
+            gpio_set(PIN_CLK, true);
+            bb_half_delay();
+            in = (uint8_t)(in << 1 | gpio_get(PIN_MISO));
+            gpio_set(PIN_CLK, false);
+        }
+        if (rx) rx[i] = in;
+        /* A maximum-size ID/description read must not busy-spin for the
+         * whole transfer. CS stays asserted while this thread yields. */
+        if (i && (i & 63u) == 63u) sleep_ms(1);
+    }
+    bb_half_delay();
+    gpio_set(PIN_CS, true);
+    return true;   /* clocks ran, not a chip ACK: probe/checksum is required */
+}
+
+static bool (*spi_transfer)(const uint8_t *tx, uint8_t *rx, uint32_t length);
+
+/* ---- the Goodix chip ------------------------------------------------------------------------------- */
+
+#define GOODIX_FW_VERSION       0x10014         /* 28 bytes */
+#define GOODIX_IC_INFO          0x10070         /* a 16-bit length, then that many bytes */
+#define GOODIX_MAX_READ         1024
+#define GOODIX_MAX_TOUCHES      10
+#define GOODIX_STATUS_TOUCH     0x80
+#define GOODIX_STATUS_REQUEST   0x40
+#define GOODIX_REQUEST_RESET    3
+
+static uint8_t spi_tx[8 + GOODIX_MAX_READ], spi_rx[8 + GOODIX_MAX_READ];
+static uint32_t touch_address, command_address, fw_buffer_address;
+
+/* Berlin-D answers no register until the boot-option handshake has run:
+ * write 8 x 0xAA to 0x10000 and require the same eight bytes back. It is
+ * also the only independent proof of the MISO/MOSI/CLK/CS assignment. */
+#define GOODIX_BOOTOPTION_ADDR  0x10000
+#define GOODIX_DEV_CONFIRM_VAL  0xAA
+
+static bool goodix_read(uint32_t address, uint8_t *data, uint32_t length);
+static bool goodix_write(uint32_t address, const uint8_t *data, uint32_t length);
+
+static bool
+goodix_dev_confirm(void)
+{
+	uint8_t tx[8], rx[8];
+
+	memset(tx, GOODIX_DEV_CONFIRM_VAL, sizeof(tx));
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		memset(rx, 0, sizeof(rx));
+		if (!goodix_write(GOODIX_BOOTOPTION_ADDR, tx, sizeof(tx))) return false;
+		if (!goodix_read(GOODIX_BOOTOPTION_ADDR, rx, sizeof(rx))) return false;
+		if (memcmp(tx, rx, sizeof(tx)) == 0) {
+			printf("goodix: device confirm OK (0x10000 = 8 x 0xAA)\n");
+			return true;
+		}
+		printf("goodix: device confirm mismatch %02x %02x (attempt %u)\n", rx[0], rx[1], attempt);
+		sleep_ms(5);
+	}
+	printf("goodix: device confirm FAILED; check AVDD(GPIO71)/IOVDD/RESET/SPI\n");
+	return false;
+}
+
+static bool
+goodix_read(uint32_t address, uint8_t *data, uint32_t length)
+{
+	if (length > GOODIX_MAX_READ) {
+		return false;
+	}
+	spi_tx[0] = 0xf1;
+	spi_tx[1] = (uint8_t)(address >> 24);
+	spi_tx[2] = (uint8_t)(address >> 16);
+	spi_tx[3] = (uint8_t)(address >> 8);
+	spi_tx[4] = (uint8_t)address;
+	spi_tx[5] = spi_tx[6] = spi_tx[7] = 0xff;
+	memset(spi_tx + 8, 0, length);
+	if (!spi_transfer(spi_tx, spi_rx, 8 + length)) {
+		return false;
+	}
+	memcpy(data, spi_rx + 8, length);
+	return true;
+}
+
+static bool
+goodix_write(uint32_t address, const uint8_t *data, uint32_t length)
+{
+	if (length > GOODIX_MAX_READ) {
+		return false;
+	}
+	spi_tx[0] = 0xf0;
+	spi_tx[1] = (uint8_t)(address >> 24);
+	spi_tx[2] = (uint8_t)(address >> 16);
+	spi_tx[3] = (uint8_t)(address >> 8);
+	spi_tx[4] = (uint8_t)address;
+	memcpy(spi_tx + 5, data, length);
+	return spi_transfer(spi_tx, NULL, 5 + length);
+}
+
+/* Berlin blocks end in the little-endian 16-bit sum of all preceding bytes.
+ * Dummy-line detection belongs to identification, not contact checksums:
+ * a valid ID0 finger at (0,0) or a zero-contact release can contain zeros. */
+static bool
+goodix_checksum_ok(const uint8_t *data, uint32_t length)
+{
+    uint32_t sum = 0;
+    if (length < 2) return false;
+    for (uint32_t i = 0; i < length - 2; i++) sum += data[i];
+    return (uint16_t)sum == (uint16_t)(data[length - 2] | data[length - 1] << 8);
+}
+
+static bool
+goodix_dummy_data(const uint8_t *data, uint32_t length)
+{
+    for (uint32_t i = 0; i < length; i++) {
+        if (data[i] != 0 && data[i] != 0xff) return false;
+    }
+    return true;
+}
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void
+touch_reset(void)
+{
+	gpio_set(PIN_RESET, false);
+	sleep_ms(2);
+	gpio_set(PIN_RESET, true);
+	sleep_ms(100);
+}
+
+/* Is the chip there and running its firmware? Finds where it keeps the touch report. */
+static bool
+goodix_probe(bool verbose)
+{
+    static uint8_t info[GOODIX_MAX_READ];
+    uint8_t version[28];
+    uint32_t length, offset;
+    touch_address = command_address = fw_buffer_address = 0;
+
+    if (!goodix_dev_confirm()) return false;
+    if (!goodix_read(GOODIX_FW_VERSION, version, sizeof(version))) {
+        printf("goodix: firmware-version SPI transfer failed at %#x\n", GOODIX_FW_VERSION);
+        return false;
+    }
+    if (goodix_dummy_data(version, sizeof(version))) {
+        printf("goodix: firmware-version contains only bus default bytes, no chip response\n");
+        return false;
+    }
+    if (!goodix_checksum_ok(version, sizeof(version))) {
+        printf("goodix: firmware-version checksum invalid (tail %02x %02x)\n", version[26], version[27]);
+        return false;
+    }
+    if (verbose) printf("goodix: chip \"%.6s\", firmware \"%.8s\" %02x.%02x.%02x.%02x, sensor %u\n",
+        (const char *)version, (const char *)version + 10, version[18], version[19], version[20], version[21], version[23]);
+
+    if (!goodix_read(GOODIX_IC_INFO, info, 2)) {
+        printf("goodix: IC-info length transfer failed\n");
+        return false;
+    }
+    length = le16(info);
+    if (length < 2 + 16 + 10 + 4 + 5 + 52 + 2 || length >= GOODIX_MAX_READ) {
+        printf("goodix: IC-info length %u is outside the Berlin description bounds\n", length);
+        return false;
+    }
+    if (!goodix_read(GOODIX_IC_INFO, info, length)) {
+        printf("goodix: IC-info transfer failed (%u bytes)\n", length);
+        return false;
+    }
+    if (le16(info) != length || goodix_dummy_data(info, length) || !goodix_checksum_ok(info, length)) {
+        printf("goodix: IC-info length/dummy/checksum validation failed (%u bytes)\n", length);
+        return false;
+    }
+    /* Linux Berlin ABI: length + version(16) + features(10) + four counts,
+     * then active-scan/mutual/self-TX/self-RX/stylus u16 frequency lists. */
+    uint32_t end = length - 2;  /* exclude the checksum from every bounds test */
+    offset = 2 + 16 + 10 + 4;
+    for (unsigned i = 0; i < 5; i++) {
+        if (offset >= end) {
+            printf("goodix: IC-info list %u has no count\n", i);
+            return false;
+        }
+        uint32_t bytes = 2u * info[offset++];
+        if (bytes > end - offset) {
+            printf("goodix: IC-info list %u overruns description\n", i);
+            return false;
+        }
+        offset += bytes;
+    }
+    if (offset > end || end - offset < 52) {
+        printf("goodix: IC-info misc is truncated (length %u, offset %u)\n", length, offset);
+        return false;
+    }
+    uint32_t address = le32(info + offset + 44), command = le32(info + offset);
+    uint16_t head = le16(info + offset + 48), point = le16(info + offset + 50);
+    if (!address || address > 0xffffffffu - (8 + 8 * GOODIX_MAX_TOUCHES + 2) || head != 8 || point != 8) {
+        printf("goodix: unsupported report ABI address=%#x head=%u point=%u\n", address, head, point);
+        return false;
+    }
+    /* misc+52/+54 are reserved1/reserved2 in the Berlin wire ABI, NOT axes.
+     * K60's raw limits remain the validated ADT 14400x32000. */
+    fw_buffer_address = le32(info + offset + 18);
+    touch_address = address;
+    command_address = command;
+    if (verbose) printf("goodix: IC-info length=%u misc=%u touch=%#x command=%#x head=%u point=%u raw axes=%ux%u\n",
+        length, offset, touch_address, command_address, head, point, max_x, max_y);
+    return true;
+}
