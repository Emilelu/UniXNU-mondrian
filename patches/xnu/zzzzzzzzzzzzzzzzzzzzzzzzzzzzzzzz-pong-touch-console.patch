+	/*
+	 * K60_BITBANG_FALLBACK (zizhan 0002-zizhan-fts.patch:970-982): drive the same
+	 * four pads as GPIOs instead -- SPI mode 0, data set while the clock is low
+	 * and sampled on the rising edge.
+	 *
+	 * The pads MUST be returned to GPIO function here: the GENI attempt above
+	 * muxed them to qup4 (function 1), and while they belong to the serial engine
+	 * gpio_set() no longer moves the pin, so every transfer reads back 0x00/0xff.
+	 * This is why the earlier bit-bang probe could never work.
+	 */
+	gpio_configure(PIN_MISO, 0, PULL_NONE, 6, false);
+	gpio_configure(PIN_MOSI, 0, PULL_NONE, 6, true);
+	gpio_configure(PIN_CLK, 0, PULL_NONE, 6, true);
+	gpio_configure(PIN_CS, 0, PULL_UP, 6, true);
+	bitbang_in = PIN_MISO;
+	bitbang_out = PIN_MOSI;
+	bitbang_clk = PIN_CLK;
+	bitbang_cs = PIN_CS;
+	bitbang_init();
+	spi_transfer = bitbang_transfer;
+
+	k60_touch_power_cycle();
+	printf("K60S19: bitbang reset done int=%u\n", gpio_get(PIN_INT));
+	/*
+	 * K60_POWER_VERIFY: read the GPIO output latches back instead of trusting
+	 * the write. The upstream ruby probe found its controller had never been
+	 * powered because nobody checked the digital-IO switch -- its P0 snapshot
+	 * read "GPIO do30 = 0x00401000 -> IOVDD pin110 bit14 = 0, switch off" and
+	 * every later stage read all zeros. The lesson recorded there is to read the
+	 * output register, not to assume the store took effect.
+	 *
+	 * TLMM bit layout (pinctrl-msm): CFG[1:0]=pull, CFG[5:2]=function,
+	 * CFG[9]=output enable; IO[0]=input level, IO[1]=output level.
+	 */
+	printf("K60S19: gpio71(AVDD)  cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(71u)), (unsigned)rd(GPIO_IO(71u)),
+	    ((unsigned)rd(GPIO_CFG(71u)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(71u)) >> 1) & 1u);
+	printf("K60S19: gpio20(RESET) cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_RESET)), (unsigned)rd(GPIO_IO(PIN_RESET)),
+	    ((unsigned)rd(GPIO_CFG(PIN_RESET)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(PIN_RESET)) >> 1) & 1u);
+	printf("K60S19: gpio21(INT)   cfg=%#x io=%#x -> in=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_INT)), (unsigned)rd(GPIO_IO(PIN_INT)),
+	    (unsigned)rd(GPIO_IO(PIN_INT)) & 1u);
+	/*
+	 * K60_POWER_VERIFY: read the GPIO output latches back instead of trusting
+	 * the write. The upstream ruby probe found its controller had never been
+	 * powered because nobody checked the digital-IO switch -- its P0 snapshot
+	 * read "GPIO do30 = 0x00401000 -> IOVDD pin110 bit14 = 0, switch off" and
+	 * every later stage read all zeros. The lesson recorded there is to read the
+	 * output register, not to assume the store took effect.
+	 *
+	 * TLMM bit layout (pinctrl-msm): CFG[1:0]=pull, CFG[5:2]=function,
+	 * CFG[9]=output enable; IO[0]=input level, IO[1]=output level.
+	 */
+	printf("K60S19: gpio71(AVDD)  cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(71u)), (unsigned)rd(GPIO_IO(71u)),
+	    ((unsigned)rd(GPIO_CFG(71u)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(71u)) >> 1) & 1u);
+	printf("K60S19: gpio20(RESET) cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_RESET)), (unsigned)rd(GPIO_IO(PIN_RESET)),
+	    ((unsigned)rd(GPIO_CFG(PIN_RESET)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(PIN_RESET)) >> 1) & 1u);
+	printf("K60S19: gpio21(INT)   cfg=%#x io=%#x -> in=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_INT)), (unsigned)rd(GPIO_IO(PIN_INT)),
+	    (unsigned)rd(GPIO_IO(PIN_INT)) & 1u);
+	/*
+	 * K60_POWER_VERIFY: read the GPIO output latches back instead of trusting
+	 * the write. The upstream ruby probe found its controller had never been
+	 * powered because nobody checked the digital-IO switch -- its P0 snapshot
+	 * read "GPIO do30 = 0x00401000 -> IOVDD pin110 bit14 = 0, switch off" and
+	 * every later stage read all zeros. The lesson recorded there is to read the
+	 * output register, not to assume the store took effect.
+	 *
+	 * TLMM bit layout (pinctrl-msm): CFG[1:0]=pull, CFG[5:2]=function,
+	 * CFG[9]=output enable; IO[0]=input level, IO[1]=output level.
+	 */
+	printf("K60S19: gpio71(AVDD)  cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(71u)), (unsigned)rd(GPIO_IO(71u)),
+	    ((unsigned)rd(GPIO_CFG(71u)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(71u)) >> 1) & 1u);
+	printf("K60S19: gpio20(RESET) cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_RESET)), (unsigned)rd(GPIO_IO(PIN_RESET)),
+	    ((unsigned)rd(GPIO_CFG(PIN_RESET)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(PIN_RESET)) >> 1) & 1u);
+	printf("K60S19: gpio21(INT)   cfg=%#x io=%#x -> in=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_INT)), (unsigned)rd(GPIO_IO(PIN_INT)),
+	    (unsigned)rd(GPIO_IO(PIN_INT)) & 1u);
+	/*
+	 * K60_POWER_VERIFY: read the GPIO output latches back instead of trusting
+	 * the write. The upstream ruby probe found its controller had never been
+	 * powered because nobody checked the digital-IO switch -- its P0 snapshot
+	 * read "GPIO do30 = 0x00401000 -> IOVDD pin110 bit14 = 0, switch off" and
+	 * every later stage read all zeros. The lesson recorded there is to read the
+	 * output register, not to assume the store took effect.
+	 *
+	 * TLMM bit layout (pinctrl-msm): CFG[1:0]=pull, CFG[5:2]=function,
+	 * CFG[9]=output enable; IO[0]=input level, IO[1]=output level.
+	 */
+	printf("K60S19: gpio71(AVDD)  cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(71u)), (unsigned)rd(GPIO_IO(71u)),
+	    ((unsigned)rd(GPIO_CFG(71u)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(71u)) >> 1) & 1u);
+	printf("K60S19: gpio20(RESET) cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_RESET)), (unsigned)rd(GPIO_IO(PIN_RESET)),
+	    ((unsigned)rd(GPIO_CFG(PIN_RESET)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(PIN_RESET)) >> 1) & 1u);
+	printf("K60S19: gpio21(INT)   cfg=%#x io=%#x -> in=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_INT)), (unsigned)rd(GPIO_IO(PIN_INT)),
+	    (unsigned)rd(GPIO_IO(PIN_INT)) & 1u);
+	/*
+	 * K60_POWER_VERIFY: read the GPIO output latches back instead of trusting
+	 * the write. The upstream ruby probe found its controller had never been
+	 * powered because nobody checked the digital-IO switch -- its P0 snapshot
+	 * read "GPIO do30 = 0x00401000 -> IOVDD pin110 bit14 = 0, switch off" and
+	 * every later stage read all zeros. The lesson recorded there is to read the
+	 * output register, not to assume the store took effect.
+	 *
+	 * TLMM bit layout (pinctrl-msm): CFG[1:0]=pull, CFG[5:2]=function,
+	 * CFG[9]=output enable; IO[0]=input level, IO[1]=output level.
+	 */
+	printf("K60S19: gpio71(AVDD)  cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(71u)), (unsigned)rd(GPIO_IO(71u)),
+	    ((unsigned)rd(GPIO_CFG(71u)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(71u)) >> 1) & 1u);
+	printf("K60S19: gpio20(RESET) cfg=%#x io=%#x -> out_en=%u level=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_RESET)), (unsigned)rd(GPIO_IO(PIN_RESET)),
+	    ((unsigned)rd(GPIO_CFG(PIN_RESET)) >> 9) & 1u,
+	    ((unsigned)rd(GPIO_IO(PIN_RESET)) >> 1) & 1u);
+	printf("K60S19: gpio21(INT)   cfg=%#x io=%#x -> in=%u\n",
+	    (unsigned)rd(GPIO_CFG(PIN_INT)), (unsigned)rd(GPIO_IO(PIN_INT)),
+	    (unsigned)rd(GPIO_IO(PIN_INT)) & 1u);
+	/*
+	 * K60_BITBANG_MISO_PROBE: sample the four pads now that the chip is powered
+	 * and out of reset. A pad that ignores the internal pull is being driven by
+	 * the controller; one that follows the pull means nothing drives it, so the
+	 * power or reset sequence is wrong rather than the SPI framing.
+	 */
+	{
+		static const unsigned cand[4] = {16u, 17u, 18u, 19u};
+		for (unsigned i = 0; i < 4; i++) {
+			unsigned up = k60_sample_with_pull(cand[i], PULL_UP);
+			unsigned dn = k60_sample_with_pull(cand[i], 1u);
+			printf("K60S19: powered gpio%u up=%u down=%u -> %s\n",
+			    cand[i], up, dn, (up == dn) ? "DRIVEN" : "FLOATING");
+		}
+		/* restore the SPI roles after the pull sampling */
+		bitbang_init();
+		printf("K60S19: powered int=%u reset=%u\n",
+		    gpio_get(PIN_INT), gpio_get(PIN_RESET));
+	}
+	/*
+	 * dev_confirm is off unless k60_touch_dev_confirm=1. See the note on
+	 * k60_touch_dev_confirm: it writes eight 0xAA bytes to 0x10000, which is
+	 * misc.cmd_addr, not scratch memory.
+	 */
+	if (k60_touch_minimal) {
+		printf("K60S19: bitbang dev_confirm SKIP (minimal path)\n");
+	} else if (k60_touch_dev_confirm) {
+		printf("K60S19: bitbang dev_confirm -> %s\n", goodix_dev_confirm() ? "OK" : "fail");
+	} else {
+		printf("K60S19: bitbang dev_confirm SKIP (0x10000 is cmd_addr)\n");
+	}
+	sleep_ms(100);
+	if (goodix_probe(true)) {
+		printf("K60S19: bitbang goodix_probe -> OK (SPI by GPIO path)\n");
+		/*
+		 * K60_SCAN_ENABLE: mirror the vendor brl_select_spi_mode exactly.
+		 *
+		 * That function (goodix_core.ko + brl_select_spi_mode, read in full)
+		 * writes 0xC900 = 0x01, reads it back, and retries up to five times until
+		 * the read-back equals 0x01:
+		 *     buf_write[0] = 0x01; buf_read[0] = 0x00;
+		 *     loop up to 5: write(0xc900, buf_write, 1);
+		 *                    read (0xc900, buf_read,  1);
+		 *                    if (buf_read[0] == buf_write[0]) break;  // == 0x01
+		 * The frame area staying static (CHANGED NO across the whole log) while
+		 * dev_confirm and goodix_probe both pass means the scan engine is not
+		 * started; this handshake is the vendor's own enable sequence.
+		 */
+		if (k60_touch_minimal) {
+			printf("K60S19: 0xc900 SPI-enable SKIP (minimal path)\n");
+		} else {
+			const uint8_t one = 0x01;
+			uint8_t rb = 0;
+			bool spi_ok = false;
+
+			for (int attempt = 0; attempt < 5; attempt++) {
+				if (!goodix_write(0xc900u, &one, 1)) {
+					continue;
+				}
+				rb = 0;
+				if (goodix_read(0xc900u, &rb, 1) && rb == one) {
+					spi_ok = true;
+					break;
+				}
+				sleep_ms(5);
+			}
+			printf("K60S19: 0xc900 SPI-enable write/verify -> %s (rb=%02x)\n",
+			    spi_ok ? "OK" : "FAIL", rb);
+			if (!spi_ok) {
+				return false;
+			}
+		}
+		/*
+		 * K60_FRAME_CLEAR_TEST: the 0x10308 frame area never changes across 79
+		 * full sweeps of 0x10000..0x11000, while 0x10400..0x10fe0 changes on
+		 * every sweep. The sensor is sampling but no report frame is ever
+		 * composed, so test whether the frame area is writable at all. The
+		 * reference protocol writes one zero byte there to clear sync after
+		 * reading a frame (references/ruby-bringup/docs/touch-goodix-9916r.md
+		 * section 5.3); we have never written it because we never saw a frame.
+		 */
+		{
+			uint8_t before[8], after[8], after2[8];
+			const uint8_t zero = 0;
+			bool ok;
+
+			if (goodix_read(touch_address, before, sizeof(before))) {
+				printf("K60S19: FRAME before %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    before[0], before[1], before[2], before[3],
+				    before[4], before[5], before[6], before[7]);
+			}
+			ok = goodix_write(touch_address, &zero, 1);
+			printf("K60S19: FRAME clear write -> %s\n", ok ? "accepted" : "FAILED");
+			if (goodix_read(touch_address, after, sizeof(after))) {
+				printf("K60S19: FRAME after  %02x %02x %02x %02x %02x %02x %02x %02x  (%s)\n",
+				    after[0], after[1], after[2], after[3],
+				    after[4], after[5], after[6], after[7],
+				    memcmp(before, after, sizeof(before)) ? "WROTE" : "unchanged");
+			}
+			sleep_ms(200);
+			if (goodix_read(touch_address, after2, sizeof(after2))) {
+				printf("K60S19: FRAME +200ms %02x %02x %02x %02x %02x %02x %02x %02x  (%s)\n",
+				    after2[0], after2[1], after2[2], after2[3],
+				    after2[4], after2[5], after2[6], after2[7],
+				    memcmp(after, after2, sizeof(after)) ? "refilled" : "static");
+			}
+			printf("K60S19: FRAME command_address=%#x\n", command_address);
+		}
+		/* K60_DIAG_LEVEL: the sweeps print hundreds of lines; only on request. */
+		if (k60_touch_diag >= 1) {
+			k60_frame_scan();
+			k60_multi_addr_probe();
+		}
+		return true;
+	}
+	printf("K60S19: bitbang goodix_probe -> fail\n");
+	return false;
+}
+/* ==== end K60_STAGE19_GENI_POWER ========================================== */
