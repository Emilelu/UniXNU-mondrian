diff --git a/bsd/dev/pong_thermal.c b/bsd/dev/pong_thermal.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/dev/pong_thermal.c
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. */
+/* Pong SM8475 thermal sensors: read-only tsens v2 reader for the XNU kernel.
+ *
+ * This file is the master copy. patches/xnu/0617-k60-thermal-tsens.patch carries
+ * it into the XNU tree verbatim as bsd/dev/pong_thermal.c; the patch is what the
+ * kernel build sees, because the kernel cannot include drivers/PongThermal.
+ * scripts/check-thermal-kernel-patch.py fails when the two copies differ.
+ *
+ * What it does: maps the two TM windows and the two SROT windows, reads the
+ * hardware version and the enable bit, then samples all 32 sensors once a second,
+ * prints the five pressure-level domains and hands the resulting level to
+ * bsd/dev/pong_thermal_pm.cpp, which publishes it through IOPMrootDomain. It never
+ * writes a register, never touches an interrupt, and never programs a trip point:
+ * those need calibration coefficients this board does not expose
+ * (docs/research/thermal/01 section 4).
+ *
+ * Register map: mainline Linux drivers/thermal/qcom/tsens-v2.c:12-27, 94-101.
+ * Board addresses: DTB /soc/thermal-sensor@c263000 and @c265000, reg[0] = TM and
+ * reg[1] = SROT (docs/research/thermal/01-SAME-HARDWARE.md section 2). */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <sys/pong_thermal.h>
+#include <sys/pong_thermal_level.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* bsd/dev/pong_thermal_pm.cpp: hands one pressure level to IOPMrootDomain. It returns
+ * without doing anything until IOKit has a root domain, which is why it is called every
+ * round rather than once from pong_thermal_init. */
+extern void pong_thermal_pm_publish(unsigned int level);
+
+#define PONG_THERMAL_WINDOW     0x1000UL
+#define PONG_THERMAL_POLL_MS    1000
+#define PONG_THERMAL_HEARTBEAT  30   /* poll rounds between unconditional lines */
+
+struct pong_thermal_controller {
+	uint64_t tm_phys;
+	uint64_t srot_phys;
+	const char *label;
+	volatile uint32_t *tm;
+	volatile uint32_t *srot;
+	uint32_t hw_ver;
+	uint32_t ctrl;
+	int mapped;
+};
+
+static struct pong_thermal_controller pong_thermal_controllers[PONG_THERMAL_CONTROLLERS] = {
+	{ 0x0c263000ull, 0x0c222000ull, "tsens0", 0, 0, 0, 0, 0 },
+	{ 0x0c265000ull, 0x0c223000ull, "tsens1", 0, 0, 0, 0, 0 },
+};
+
+static uint32_t
+pong_thermal_rd(const volatile uint32_t *base, uint32_t offset)
+{
+	return base[offset / 4u];
+}
+
+/* One 32-bit load per sensor; the caller owns the mapping. */
+static int
+pong_thermal_sample(struct pong_thermal_controller *c, unsigned base_slot,
+    int32_t milli_c[PONG_THERMAL_SENSOR_COUNT], uint32_t raw[PONG_THERMAL_SENSORS_PER_CONTROLLER])
+{
+	struct pong_thermal_reading reading;
+	unsigned i;
+	int valid = 0;
+
+	if (!c->mapped) {
+		for (i = 0; i < PONG_THERMAL_SENSORS_PER_CONTROLLER; i++) {
+			milli_c[base_slot + i] = INT32_MIN;
+			raw[i] = 0;
+		}
+		return 0;
+	}
+	for (i = 0; i < PONG_THERMAL_SENSORS_PER_CONTROLLER; i++) {
+		raw[i] = pong_thermal_rd(c->tm, PONG_THERMAL_TM_SN_STATUS(i));
+		if (pong_thermal_decode(raw[i], &reading) == PONG_THERMAL_OK) {
+			milli_c[base_slot + i] = reading.milli_c;
+			valid++;
+		} else {
+			milli_c[base_slot + i] = INT32_MIN;
+		}
+	}
+	return valid;
+}
+
+static void
+pong_thermal_read_all(int32_t milli_c[PONG_THERMAL_SENSOR_COUNT])
+{
+	uint32_t raw[PONG_THERMAL_SENSORS_PER_CONTROLLER];
+	unsigned c;
+
+	for (c = 0; c < PONG_THERMAL_CONTROLLERS; c++) {
+		(void)pong_thermal_sample(&pong_thermal_controllers[c],
+		    c * PONG_THERMAL_SENSORS_PER_CONTROLLER, milli_c, raw);
+	}
+}
+
+/* Boot-time dump: one line per sensor, so a serial capture names every sensor.
+ * The percentages are the value the pressure-level consumer will see. */
+static void
+pong_thermal_dump(void)
+{
+	int32_t milli_c[PONG_THERMAL_SENSOR_COUNT];
+	uint32_t raw[PONG_THERMAL_SENSORS_PER_CONTROLLER];
+	unsigned c, i;
+
+	for (c = 0; c < PONG_THERMAL_CONTROLLERS; c++) {
+		struct pong_thermal_controller *ctl = &pong_thermal_controllers[c];
+
+		if (!ctl->mapped) {
+			printf("PongThermal: %s not mapped; skipping\n", ctl->label);
+			continue;
+		}
+		printf("PongThermal: %s tm=%#llx srot=%#llx ver=%u.%u.%u ctrl=%#x enabled=%d\n",
+		    ctl->label, (unsigned long long)ctl->tm_phys,
+		    (unsigned long long)ctl->srot_phys,
+		    PONG_THERMAL_VER_MAJOR(ctl->hw_ver), PONG_THERMAL_VER_MINOR(ctl->hw_ver),
+		    PONG_THERMAL_VER_STEP(ctl->hw_ver), ctl->ctrl,
+		    pong_thermal_ctrl_enabled(ctl->ctrl));
+		(void)pong_thermal_sample(ctl, c * PONG_THERMAL_SENSORS_PER_CONTROLLER, milli_c, raw);
+		for (i = 0; i < PONG_THERMAL_SENSORS_PER_CONTROLLER; i++) {
+			const struct pong_thermal_sensor *sensor =
+			    pong_thermal_sensor_at(c * PONG_THERMAL_SENSORS_PER_CONTROLLER + i);
+			int32_t mc = milli_c[c * PONG_THERMAL_SENSORS_PER_CONTROLLER + i];
+
+			if (sensor == 0) {
+				continue;
+			}
+			if (mc == INT32_MIN) {
+				printf("PongThermal: %s[%u] %s zone%u raw=%#x no-valid-reading\n",
+				    ctl->label, i, sensor->name, sensor->zone, raw[i]);
+			} else {
+				printf("PongThermal: %s[%u] %s zone%u %d.%d C\n",
+				    ctl->label, i, sensor->name, sensor->zone,
+				    (int)(mc / 1000), (int)((mc < 0 ? -mc : mc) % 1000) / 100);
+			}
+		}
+	}
+}
+
+/* Five pressure-level domains, hottest sensor of each. The macOS side reads the
+ * same five groups (docs/research/thermal/05-PRESSURE-LEVEL.md section 2). */
+static void
+pong_thermal_domains(int32_t domains[PONG_THERMAL_DOMAINS])
+{
+	int32_t milli_c[PONG_THERMAL_SENSOR_COUNT];
+
+	pong_thermal_read_all(milli_c);
+	pong_thermal_domain_max(milli_c, domains);
+}
+
+static void
+pong_thermal_worker(void *arg, wait_result_t result)
+{
+	int32_t domains[PONG_THERMAL_DOMAINS];
+	int32_t previous[PONG_THERMAL_DOMAINS];
+	K60TlState level_state;
+	uint64_t deadline;
+	unsigned round = 0, i;
+
+	(void)arg;
+	(void)result;
+	for (i = 0; i < PONG_THERMAL_DOMAINS; i++) {
+		previous[i] = INT32_MIN;
+	}
+	memset(&level_state, 0, sizeof(level_state));
+	for (;;) {
+		bool changed = false;
+		unsigned level;
+
+		pong_thermal_domains(domains);
+		for (i = 0; i < PONG_THERMAL_DOMAINS; i++) {
+			/* one-degree bucket: a quieter log than 32 lines a second */
+			if (domains[i] == INT32_MIN || previous[i] == INT32_MIN ||
+			    domains[i] / 1000 != previous[i] / 1000) {
+				changed = true;
+			}
+			previous[i] = domains[i];
+		}
+		if (changed || ++round >= PONG_THERMAL_HEARTBEAT) {
+			round = 0;
+			printf("PongThermal: little=%d big=%d gpu=%d npu=%d ddr=%d mC\n",
+			    domains[PONG_THERMAL_DOMAIN_LITTLE], domains[PONG_THERMAL_DOMAIN_BIG],
+			    domains[PONG_THERMAL_DOMAIN_GPU], domains[PONG_THERMAL_DOMAIN_NPU],
+			    domains[PONG_THERMAL_DOMAIN_DDR]);
+		}
+		/* Hysteresis lives in k60tl_step: a trip already crossed is released only
+		 * below its temperature minus the DT's hysteresis. Publishing is a no-op
+		 * until the root domain exists, and after that only on a level change. */
+		level = k60tl_step(&level_state, domains);
+		pong_thermal_pm_publish(level);
+		clock_interval_to_deadline(PONG_THERMAL_POLL_MS, NSEC_PER_MSEC, &deadline);
+		assert_wait_deadline((event_t)pong_thermal_controllers, THREAD_UNINT, deadline);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+pong_thermal_init(void)
+{
+	uint32_t enabled = 1;
+	thread_t thread;
+	unsigned c;
+
+	/* Absent boot-arg leaves the compiled-in default alone: PE_parse_boot_argn
+	 * returns FALSE both for "absent" and for "0", so its result is ignored. */
+	(void)PE_parse_boot_argn("pong_thermal", &enabled, sizeof(enabled));
+	if (enabled == 0) {
+		printf("PongThermal: disabled by boot-arg pong_thermal=0\n");
+		return;
+	}
+	for (c = 0; c < PONG_THERMAL_CONTROLLERS; c++) {
+		struct pong_thermal_controller *ctl = &pong_thermal_controllers[c];
+
+		ctl->tm = (volatile uint32_t *)ml_io_map((vm_offset_t)ctl->tm_phys,
+		    PONG_THERMAL_WINDOW);
+		ctl->srot = (volatile uint32_t *)ml_io_map((vm_offset_t)ctl->srot_phys,
+		    PONG_THERMAL_WINDOW);
+		if (ctl->tm == 0 || ctl->srot == 0) {
+			printf("PongThermal: %s window mapping failed (tm=%p srot=%p)\n",
+			    ctl->label, (void *)ctl->tm, (void *)ctl->srot);
+			continue;
+		}
+		ctl->mapped = 1;
+		ctl->hw_ver = pong_thermal_rd(ctl->srot, PONG_THERMAL_SROT_HW_VER);
+		ctl->ctrl = pong_thermal_rd(ctl->srot, PONG_THERMAL_SROT_CTRL);
+	}
+	pong_thermal_dump();
+	if (!pong_thermal_controllers[0].mapped && !pong_thermal_controllers[1].mapped) {
+		printf("PongThermal: no controller mapped; not polling\n");
+		return;
+	}
+	if (kernel_thread_start(pong_thermal_worker, 0, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("PongThermal: polling %u controllers every %u ms\n",
+		    PONG_THERMAL_CONTROLLERS, PONG_THERMAL_POLL_MS);
+	} else {
+		printf("PongThermal: worker thread failed; boot snapshot only\n");
+	}
+}
+#endif /* PONG */
diff --git a/bsd/dev/pong_thermal_level.c b/bsd/dev/pong_thermal_level.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/dev/pong_thermal_level.c
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. */
+/* Data and arithmetic for the board's thermal pressure level. No register, no IOKit, no
+ * allocation: the whole file runs on the host (scripts/tests/test-k60-thermal-level.c).
+ * Threshold provenance is in docs/research/thermal/05-PRESSURE-LEVEL.md §2, one line per
+ * number, all from the decompiled board DTS (docs/research/thermal/01-SAME-HARDWARE.md §5). */
+/* The same file ships twice: as this master copy, which the host test compiles with
+ * -I drivers/PongThermal, and as bsd/dev/pong_thermal_level.c inside the kernel patch,
+ * where the header is bsd/sys/pong_thermal_level.h. The guard keeps the two copies
+ * byte-identical, which scripts/check-thermal-kernel-patch.py enforces. */
+#if defined(KERNEL)
+#include <sys/pong_thermal_level.h>
+#else
+#include "K60ThermalLevel.h"
+#endif
+
+/* CPU cluster 0 (cpu-0-0..3): emerg 110 C / 10 C (:7706, :7707), reset-mon 115 C / 5 C
+ * (:7700, :7701), thermal-engine 125 C / 1 C (:7688, :7689). The big cluster
+ * (cpu-1-0..8) has the same three numbers (:7239, :7233, :7221), so both clusters share
+ * one table. */
+static const K60TlTrip k60tl_cpu_trips[K60TlTrips] = {
+    {110000, 10000}, {115000, 5000}, {125000, 1000}
+};
+
+/* GPU: tj 95 C / 5 C (:7601, :7602), reset-mon 115 C / 5 C (:7595, :7596), engine
+ * 125 C / 1 C (:7583, :7584). */
+static const K60TlTrip k60tl_gpu_trips[K60TlTrips] = {
+    {95000, 5000}, {115000, 5000}, {125000, 1000}
+};
+
+/* NPU: junction 95 C / 5 C (:7874, :7875), reset-mon 115 C / 5 C (:7868, :7869),
+ * engine 125 C / 1 C (:7856, :7857). */
+static const K60TlTrip k60tl_npu_trips[K60TlTrips] = {
+    {95000, 5000}, {115000, 5000}, {125000, 1000}
+};
+
+/* DDR: ddr0 90 C / 5 C (:8009, :8010), reset-mon 115 C / 5 C (:8016, :8017), engine
+ * 125 C / 1 C (:8003, :8004). */
+static const K60TlTrip k60tl_ddr_trips[K60TlTrips] = {
+    {90000, 5000}, {115000, 5000}, {125000, 1000}
+};
+
+static const char *const k60tl_input_names[K60TlInputs] = {
+    "cpu-little", "cpu-big", "gpu", "npu", "ddr"
+};
+
+static const char *const k60tl_level_names[5] = {
+    "nominal", "moderate", "heavy", "trapping", "sleeping"
+};
+
+/* tsens0 idx 0..15 then tsens1 idx 0..15 (drivers/PongThermal/K60Tsens.c table order). */
+static const uint8_t k60tl_sensor_input[32] = {
+    K60TlNoInput, K60TlNoInput, K60TlNoInput, K60TlNoInput,          /* aoss-0, cpuss-0..2 */
+    K60TlNoInput,                                                    /* cpuss-3 */
+    K60TlCpuBig, K60TlCpuBig, K60TlCpuBig, K60TlCpuBig,              /* cpu-1-0..3 */
+    K60TlCpuBig, K60TlCpuBig, K60TlCpuBig, K60TlCpuBig,              /* cpu-1-4..7 */
+    K60TlCpuBig,                                                     /* cpu-1-8 */
+    K60TlGpu, K60TlGpu,                                              /* gpuss-0/1 */
+    K60TlNoInput,                                                    /* aoss-1 */
+    K60TlCpuLittle, K60TlCpuLittle, K60TlCpuLittle, K60TlCpuLittle,  /* cpu-0-0..3 */
+    K60TlNpu, K60TlNpu, K60TlNpu,                                    /* nspss-0..2 */
+    K60TlNoInput,                                                    /* video */
+    K60TlDdr,                                                        /* ddr */
+    K60TlNoInput, K60TlNoInput, K60TlNoInput, K60TlNoInput,          /* mdmss-0..3 */
+    K60TlNoInput, K60TlNoInput                                       /* camera-0/1 */
+};
+
+const K60TlTrip *k60tl_trips(unsigned input)
+{
+    switch (input) {
+    case K60TlCpuLittle:
+    case K60TlCpuBig:   return k60tl_cpu_trips;
+    case K60TlGpu:      return k60tl_gpu_trips;
+    case K60TlNpu:      return k60tl_npu_trips;
+    case K60TlDdr:      return k60tl_ddr_trips;
+    default:            return (const K60TlTrip *)0;
+    }
+}
+
+const char *k60tl_input_name(unsigned input)
+{
+    return input < K60TlInputs ? k60tl_input_names[input] : "?";
+}
+
+const char *k60tl_level_name(unsigned level)
+{
+    return level <= K60TlSleeping ? k60tl_level_names[level] : "?";
+}
+
+unsigned k60tl_input_of_sensor(unsigned sensor)
+{
+    return sensor < 32u ? k60tl_sensor_input[sensor] : K60TlNoInput;
+}
+
+unsigned k60tl_input_level(unsigned crossed_before, int32_t milli_c,
+                           const K60TlTrip *trips, unsigned trips_count,
+                           unsigned *crossed_after)
+{
+    unsigned level = 0;
+
+    if (crossed_after != (unsigned *)0) *crossed_after = 0;
+    if (trips == (const K60TlTrip *)0 || trips_count == 0u) return 0;
+    if (milli_c == K60TL_NO_READING) return 0;
+
+    for (unsigned t = 0; t < trips_count; ++t) {
+        /* A trip already crossed is released only below temperature - hysteresis. */
+        const int32_t threshold = crossed_before > t
+            ? trips[t].milli_c - trips[t].hysteresis_mc
+            : trips[t].milli_c;
+        if (milli_c < threshold) break;
+        level = t + 1u;
+    }
+    if (crossed_after != (unsigned *)0) *crossed_after = level;
+    return level;
+}
+
+unsigned k60tl_step(K60TlState *state, const int32_t *milli_c)
+{
+    unsigned worst = K60TlNominal;
+
+    for (unsigned i = 0; i < K60TlInputs; ++i) {
+        const int32_t mc = milli_c != (const int32_t *)0 ? milli_c[i] : K60TL_NO_READING;
+        const unsigned before = state != (K60TlState *)0 ? state->crossed[i] : 0u;
+        unsigned after = 0;
+        const unsigned level = k60tl_input_level(before, mc, k60tl_trips(i),
+                                                 K60TlTrips, &after);
+        if (state != (K60TlState *)0) state->crossed[i] = (uint8_t)after;
+        if (level > worst) worst = level;
+    }
+    return worst;
+}
+
+/* IOPM.h:764 normal, :765 danger, :768 warning, :769 trap. Sleeping is never reported on
+ * this board, so it shares the trap value; an out-of-range level is treated as nominal. */
+unsigned k60tl_platform_value(unsigned level)
+{
+    switch (level) {
+    case K60TlNominal:  return 0u;    /* kIOPMThermalLevelNormal */
+    case K60TlModerate: return 5u;    /* kIOPMThermalLevelDanger */
+    case K60TlHeavy:    return 100u;  /* kIOPMThermalLevelWarning */
+    case K60TlTrapping: return 110u;  /* kIOPMThermalLevelTrap */
+    case K60TlSleeping: return 110u;  /* never produced: no trip point stands for it */
+    default:            return 0u;
+    }
+}
diff --git a/bsd/dev/pong_thermal_pm.cpp b/bsd/dev/pong_thermal_pm.cpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/dev/pong_thermal_pm.cpp
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. */
+/* Pong SM8475 thermal pressure level: the publisher.
+ *
+ * This file is the master copy. patches/xnu/0617-k60-thermal-tsens.patch carries
+ * it into the XNU tree verbatim as bsd/dev/pong_thermal_pm.cpp;
+ * scripts/check-thermal-kernel-patch.py fails when the two copies differ.
+ *
+ * What it does: hands the board's pressure level (nominal / moderate / heavy /
+ * trapping, computed by bsd/dev/pong_thermal_level.c) to the one thermal entry
+ * point this kernel already has, IOPMrootDomain::systemPowerEventOccurred, under
+ * the key kIOPMThermalLevelWarningKey. It installs no actuator and programs no
+ * clock: docs/research/thermal/TRIP-DESIGN.md section 3.5 is the decision record.
+ *
+ * Why this is C++: systemPowerEventOccurred takes an OSSymbol and an OSObject,
+ * which only exist in C++. bsd/conf/files had no .cpp before this file; the
+ * build system has always supported it (makedefs/MakeInc.rule:423-428 turns
+ * .cpp into .cpo, bsd/conf/Makefile.template:72 has the %CXXFILES hook).
+ *
+ * The call is made from the thermal worker thread, not from the PM work loop.
+ * That is the supported shape: IOPMrootDomain::setThermalState re-dispatches
+ * itself through gIOPMWorkLoop->runAction when it is called outside the gate
+ * (iokit/Kernel/IOPMrootDomain.cpp:8119-8136), and the property update takes
+ * featuresDictLock (:8154-8156). What has not been shown on hardware is that a
+ * non-Apple kext-side caller is harmless; docs/research/thermal/08-KERNEL-DRIVER.md
+ * section 7.4 keeps that as an open question for the first boot. */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(PONG)
+
+#include <IOKit/IOService.h>
+#include <IOKit/pwr_mgt/IOPM.h>
+
+/* RootDomain.h pulls IOPMPrivate.h in its XNU_KERNEL_PRIVATE section
+ * (iokit/IOKit/pwr_mgt/RootDomain.h:37-39), and iokit/IOKit/pwr_mgt/Makefile
+ * lists IOPMPrivate.h in NOT_EXPORT_HEADERS, so the exported copy under
+ * EXPORT_HDRS/iokit/IOKit/pwr_mgt/ does not carry it and a bsd object cannot
+ * see it (bsd's INCFLAGS only reach EXPORT_HDRS, EXTERNAL_HEADERS and the
+ * fakeroot usr/local/include tree). Rather than copy a header into the build
+ * output or widen the upstream export list, close the private section for the
+ * length of this one include: the declarations this file needs, class
+ * IOPMrootDomain (:151) and both systemPowerEventOccurred overloads (:177-183),
+ * sit outside XNU_KERNEL_PRIVATE. The two headers RootDomain.h includes
+ * unconditionally are taken first so the window only covers RootDomain.h
+ * itself. */
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <sys/vnode.h>
+#undef XNU_KERNEL_PRIVATE
+#include <IOKit/pwr_mgt/RootDomain.h>
+#define XNU_KERNEL_PRIVATE 1
+
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+#include <sys/pong_thermal_level.h>
+#include <sys/systm.h>
+
+/* The event key, created once. Every IOPMrootDomain key in the tree is made this
+ * way and never released (iokit/Kernel/IOPMrootDomain.cpp:1535-1538). */
+static const OSSymbol *pong_thermal_pm_key;
+
+/* What was last accepted by the root domain, so an unchanged level costs nothing. */
+static unsigned int pong_thermal_pm_last_level;
+static int pong_thermal_pm_have_last;
+
+/* The level-to-value table lives in bsd/dev/pong_thermal_level.c (k60tl_platform_value),
+ * where scripts/tests/test-k60-thermal-level.c can check it on the host against
+ * iokit/IOKit/pwr_mgt/IOPM.h:763-772. Only the two platform values, 100 and 110, move
+ * IOPMrootDomain::thermalWarningState (iokit/Kernel/IOPMrootDomain.cpp:8133-8134); the
+ * others are recorded in the "Power Status" dictionary and broadcast (:8172-8188). */
+
+/* Called once per sampling round by the worker in bsd/dev/pong_thermal.c.
+ *
+ * Before IOKit has started there is no root domain: bsd_init calls
+ * pong_thermal_init (bsd/kern/bsd_init.c:1166-1167) long before IOKitBSDInit
+ * (:1325), so the first rounds return here and the first successful call is the
+ * moment the publisher goes live. A missing root domain is not an error. */
+extern "C" void
+pong_thermal_pm_publish(unsigned int level)
+{
+	IOPMrootDomain *root;
+	OSNumber *number;
+	uint32_t value;
+
+	if (pong_thermal_pm_have_last && level == pong_thermal_pm_last_level) {
+		return;
+	}
+	root = IOService::getPMRootDomain();
+	if (root == NULL) {
+		return;
+	}
+	if (!pong_thermal_pm_key) {
+		pong_thermal_pm_key = OSSymbol::withCStringNoCopy(kIOPMThermalLevelWarningKey);
+		if (!pong_thermal_pm_key) {
+			return;
+		}
+	}
+	value = (uint32_t)k60tl_platform_value(level);
+	/* withNumber hands back a retained object; the root domain keeps its own
+	 * reference in the "Power Status" dictionary (:8172), so this one is dropped
+	 * right after the call, as overload one does (:8103-8116). */
+	number = OSNumber::withNumber((unsigned long long)value, 32);
+	if (number == NULL) {
+		return;
+	}
+	(void)root->systemPowerEventOccurred(pong_thermal_pm_key, (OSObject *)number);
+	number->release();
+	pong_thermal_pm_last_level = level;
+	pong_thermal_pm_have_last = 1;
+	printf("PongThermal: level %s (%u) published as %s=%u\n",
+	    k60tl_level_name(level), level, kIOPMThermalLevelWarningKey, value);
+}
+
+#endif /* PONG */
