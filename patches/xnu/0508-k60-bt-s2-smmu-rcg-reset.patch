+/* ------------------------------------------------------------------------- */
+/* apps_smmu bypass for the QUPV3_2 stream (F1)                              */
+/* ------------------------------------------------------------------------- */
+/*
+ * The live device tree binds the wrapper to the apps SMMU:
+ *   qcom,qupv3_2_geni_se@8c0000 { iommus = <&apps_smmu 0x483 0>; ... }
+ * (mondrian.dts:10707-10720), so every GENI DMA descriptor is translated.
+ * bsd/dev/k60_usblog.c (patches/xnu/0300) already installs a bypass context
+ * for the DWC3 stream 0 on this exact board and the UFS driver does the same
+ * for stream 0xe0; this is that planner, reduced to one stream and to the
+ * struct k60_region accessors.  Sources: drivers/NativeUfs/SmmuTakeover.h
+ * (SMMUv2 planner) and ArmSmmu4KProgram.c:77-78 (stage-2-only bank rejection).
+ */
+#define K60_APPS_SMMU_BASE          0x15000000u
+#define K60_APPS_SMMU_SIZE          0x00100000u
+#define K60_BT_SMMU_SID             0x483u
+#define K60_SMMU_BANKS              78u   /* upper bound; IDR1.NUMCB wins */
+#define K60_SMMU_GROUPS             120u  /* upper bound; IDR0.NUMSMRG wins */
+#define K60_SMMU_IDR0               0x020u
+#define K60_SMMU_IDR1               0x024u
+#define K60_SMMU_IDR2               0x028u
+#define K60_SMMU_SMR(n)             (0x800u + 4u * (n))
+#define K60_SMMU_S2CR(n)            (0xc00u + 4u * (n))
+#define K60_SMMU_CBAR(n)            (0x1000u + 4u * (n))
+#define K60_SMMU_CBA2R(n)           (0x1800u + 4u * (n))
+
+struct k60_smmu_plan {
+    unsigned slot, bank, pages;
+    uint32_t smr, s2cr, previous_bank;
+    int reuse, migrate;
+    const char *error;
+};
+
+static unsigned k60_smmu_addr_bits(unsigned code) {
+    switch (code) {
+    case 0: return 32; case 1: return 36; case 2: return 40;
+    case 3: return 42; case 4: return 44; case 5: return 48;
+    default: return 0;
+    }
+}
+
+static void k60_smmu_plan_bank(uint16_t stream, uint64_t dma, uint64_t bytes,
+                               unsigned owned_banks, unsigned owned_groups,
+                               unsigned bank_from_top, struct k60_smmu_plan *p) {
+    memset(p, 0, sizeof(*p));
+    p->slot = 0xffffffffU;
+    p->previous_bank = 0xffffffffU;
+    uint32_t idr0 = k60_read32(&k60.smmu, K60_SMMU_IDR0);
+    uint32_t idr2 = k60_read32(&k60.smmu, K60_SMMU_IDR2);
+    unsigned count = idr0 & 255u;
+    if (!(idr0 & (1u << 30)) || !(idr2 & (1u << 12))) {
+        p->error = "SMMU AArch64 stage 1 unsupported";
+        return;
+    }
+    for (unsigned shift = 0; shift <= 8; shift += 4) {
+        unsigned bits = k60_smmu_addr_bits((idr2 >> shift) & 15u);
+        if (!bits || !bytes || dma >= (1ULL << bits) || bytes > (1ULL << bits) - dma) {
+            p->error = "DMA exceeds SMMU address width";
+            return;
+        }
+    }
+    uint32_t idr1 = k60_read32(&k60.smmu, K60_SMMU_IDR1);
+    unsigned banks = idr1 & 255u;
+    if (!owned_banks || !owned_groups || !banks || !count) {
+        p->error = "empty SMMU ownership/capability range";
+        return;
+    }
+    if (banks > owned_banks) banks = owned_banks;
+    if (count > owned_groups) count = owned_groups;
+    p->pages = 1u << (((idr1 >> 28) & 7u) + 1u);
+    if ((idr1 >> 31) || !count || p->pages > 128u || banks < 2u || banks > 128u ||
+        (p->pages + banks) * 4096u > 0x100000u) {
+        p->error = "unsupported SMMU geometry";
+        return;
+    }
+    if (count > 128u) {
+        p->error = "unsupported stream-match group count";
+        return;
+    }
+    if (bank_from_top >= banks - 1u) {
+        p->error = "no free context bank";
+        return;
+    }
+    p->bank = banks - 1u - bank_from_top;
+    if (p->bank < ((idr1 >> 16) & 255u)) {   /* stage-2-only bank */
+        p->error = "context bank is stage-2 only";
+        return;
+    }
+    unsigned matches = 0;
+    for (unsigned i = 0; i < count; i++) {
+        uint32_t smr = k60_read32(&k60.smmu, K60_SMMU_SMR(i));
+        if (!(smr & 0x80000000u)) {
+            if (!p->reuse && !p->migrate) p->slot = i;
+            continue;
+        }
+        uint32_t s2cr = k60_read32(&k60.smmu, K60_SMMU_S2CR(i));
+        uint32_t mask = (smr >> 16) & 0x7fffu;
+        int match = ((smr ^ stream) & 0xffffu & ~mask) == 0;
+        int translate = ((s2cr >> 16) & 3u) == 0;
+        unsigned mapped_bank = s2cr & 255u;
+        int our_bank = translate && mapped_bank == p->bank;
+        if (match) {
+            ++matches;
+            if (matches > 1u || mask || !translate || mapped_bank >= banks) {
+                p->slot = i;
+                p->smr = smr;
+                p->s2cr = s2cr;
+                p->error = "conflicting bluetooth stream mapping";
+                return;
+            }
+            p->reuse = our_bank;
+            p->migrate = !our_bank;
+            p->previous_bank = mapped_bank;
+            p->slot = i;
+            p->smr = smr;
+            p->s2cr = s2cr;
+        } else if (our_bank) {
+            p->slot = i;
+            p->smr = smr;
+            p->s2cr = s2cr;
+            p->error = "reserved context bank already used";
+            return;
+        }
+    }
+    uint32_t sctlr = k60_read32(&k60.smmu, (p->pages + p->bank) * 4096u);
+    if ((sctlr & 1u) || (p->reuse && (sctlr ||
+        k60_read32(&k60.smmu, K60_SMMU_CBAR(p->bank)) != 0x10000u ||
+        (k60_read32(&k60.smmu, K60_SMMU_CBA2R(p->bank)) & ~1u)))) {
+        p->error = "reserved context bank not bypass";
+        return;
+    }
+    if (p->slot == 0xffffffffU) p->error = "no free stream-match group";
+}
+
+static int k60_smmu_retryable(const char *error) {
+    return !strcmp(error, "reserved context bank already used") ||
+           !strcmp(error, "reserved context bank not bypass");
+}
+
+static void k60_smmu_plan(uint16_t stream, uint64_t dma, uint64_t bytes,
+                          unsigned owned_banks, unsigned owned_groups,
+                          struct k60_smmu_plan *p) {
+    k60_smmu_plan_bank(stream, dma, bytes, owned_banks, owned_groups, 0, p);
+    if (!p->error || !k60_smmu_retryable(p->error)) return;
+    struct k60_smmu_plan first = *p;
+    for (unsigned attempt = 1; attempt < 8; attempt++) {
+        k60_smmu_plan_bank(stream, dma, bytes, owned_banks, owned_groups, attempt, p);
+        if (!p->error) return;
+        if (!k60_smmu_retryable(p->error)) break;
+    }
+    *p = first;
+}
+
+/* Every write is read back; a mismatch aborts before any DMA is enabled. */
+static const char *k60_smmu_configure(const struct k60_smmu_plan *p, uint16_t stream) {
+    unsigned cb = (p->pages + p->bank) * 4096u;
+    if (p->error) return p->error;
+    if (!p->reuse) k60_write32(&k60.smmu, cb, 0);
+    if (k60_read32(&k60.smmu, cb) != 0) return "SMMU bypass disable readback";
+    if (k60_read32(&k60.smmu, K60_SMMU_CBA2R(p->bank)) != 1u)
+        k60_write32(&k60.smmu, K60_SMMU_CBA2R(p->bank), 1u);
+    if (!p->reuse) k60_write32(&k60.smmu, K60_SMMU_CBAR(p->bank), 0x10000u);
+    if (k60_read32(&k60.smmu, K60_SMMU_CBA2R(p->bank)) != 1u ||
+        k60_read32(&k60.smmu, K60_SMMU_CBAR(p->bank)) != 0x10000u ||
+        k60_read32(&k60.smmu, cb) != 0) {
+        return "SMMU VA64 bypass readback";
+    }
+    if (!p->reuse) {
+        k60_write32(&k60.smmu, K60_SMMU_S2CR(p->slot), p->bank);
+        if (k60_read32(&k60.smmu, K60_SMMU_S2CR(p->slot)) != p->bank)
+            return "SMMU stream context readback";
+        if (!p->migrate)
+            k60_write32(&k60.smmu, K60_SMMU_SMR(p->slot), 0x80000000u | stream);
+    }
+    if (k60_read32(&k60.smmu, K60_SMMU_SMR(p->slot)) != (0x80000000u | stream) ||
+        k60_read32(&k60.smmu, K60_SMMU_S2CR(p->slot)) != p->bank) {
+        return "SMMU stream mapping readback";
+    }
+    return NULL;
+}
+
+/* Install the bypass context for the BT stream.  On any failure nothing
+ * DMA-capable is enabled and the caller must not start the controller. */
+static int k60_smmu_bypass(uint64_t dma, uint64_t bytes) {
+    int e = k60_map(&k60.smmu, K60_APPS_SMMU_BASE, K60_APPS_SMMU_SIZE);
+    if (e) return e;
+    struct k60_smmu_plan plan;
+    k60_smmu_plan(K60_BT_SMMU_SID, dma, bytes, K60_SMMU_BANKS, K60_SMMU_GROUPS, &plan);
+    char line[192];
+    if (plan.error) {
+        snprintf(line, sizeof(line), "smmu plan failed sid %#x: %s",
+                 K60_BT_SMMU_SID, plan.error);
+        k60_log(NULL, 1, line);
+        return -EIO;
+    }
+    snprintf(line, sizeof(line),
+             "smmu plan sid %#x slot %u bank %u firmware-bank %u action %s dma %#llx",
+             K60_BT_SMMU_SID, plan.slot, plan.bank, plan.previous_bank,
+             plan.migrate ? "migrate" : plan.reuse ? "reuse" : "install",
+             (unsigned long long)dma);
+    k60_log(NULL, 1, line);
+    const char *why = k60_smmu_configure(&plan, K60_BT_SMMU_SID);
+    snprintf(line, sizeof(line),
+             "smmu sid %#x slot %u bank %u SMR %#x S2CR %#x CBAR %#x CBA2R %#x SCTLR %#x",
+             K60_BT_SMMU_SID, plan.slot, plan.bank,
+             k60_read32(&k60.smmu, K60_SMMU_SMR(plan.slot)),
+             k60_read32(&k60.smmu, K60_SMMU_S2CR(plan.slot)),
+             k60_read32(&k60.smmu, K60_SMMU_CBAR(plan.bank)),
+             k60_read32(&k60.smmu, K60_SMMU_CBA2R(plan.bank)),
+             k60_read32(&k60.smmu, (plan.pages + plan.bank) * 4096u));
+    k60_log(NULL, 1, line);
+    if (why) {
+        snprintf(line, sizeof(line), "smmu configure failed: %s", why);
+        k60_log(NULL, 1, line);
+        return -EIO;
+    }
+    return 0;
+}
