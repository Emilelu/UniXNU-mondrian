+/* ==== K60_STAGE20_ELEC: powered electrical diagnosis =======================
+ * Measured on 2026-11-10 (usblog-20261110-141044) after power + reset:
+ *     gpio16 up=1 down=0 -> FLOATING    (MISO: nothing drives it)
+ *     gpio17 up=1 down=0 -> FLOATING
+ *     gpio18 up=1 down=0 -> FLOATING
+ *     gpio19 up=0 down=0 -> DRIVEN      (CS: we pull it low ourselves)
+ *     int=0, reset=1
+ * So the pad we treat as MISO is not being driven by the controller, and INT
+ * reads low with no touch in progress. Either the controller is still held in
+ * reset, or the role assignment is wrong. This stage answers both without
+ * guessing: it sweeps the RESET level and all 24 pin roles, sampling each pad
+ * with an internal pull-up and pull-down so a driven pad is distinguishable
+ * from a floating one.
+ */
+static void
+k60_stage20_elec(void)
+{
+	static const unsigned cand[4] = {16u, 17u, 18u, 19u};
+	static const unsigned roles[4] = {0u, 1u, 2u, 3u};   /* MISO MOSI CLK CS */
+
+	printf("K60S20: powered electrical diagnosis\n");
+	io_supply_on();
+	/*
+	 * K60_POWER_VERIFY: read the GPIO output latches back instead of assuming the
+	 * write took effect.
+	 *
+	 * The upstream ruby probe found its controller had never been powered because
+	 * nobody checked the digital-IO switch: its P0 snapshot read
+	 *     GPIO do30 = 0x00401000  -> IOVDD pin110 bit14 = 0, switch off
+	 * and that is why every later stage read all zeros. The lesson recorded there
+	 * is to read the output register, not to trust the write.
+	 *
+	 * K60 has no separate digital-IO switch pin; AVDD is GPIO71 and IOVDD is the
+	 * pm8350c_l2 rail. Print CFG and IO for the three power/reset pins so a
+	 * silently-ignored write is visible.
+	 */
+	{
+		printf("K60S20: gpio71(AVDD) cfg=%#x io=%#x\n",
+		    (unsigned)rd(GPIO_CFG(71u)), (unsigned)rd(GPIO_IO(71u)));
+		printf("K60S20: gpio20(RESET) cfg=%#x io=%#x\n",
+		    (unsigned)rd(GPIO_CFG(PIN_RESET)), (unsigned)rd(GPIO_IO(PIN_RESET)));
+		printf("K60S20: gpio21(INT)  cfg=%#x io=%#x\n",
+		    (unsigned)rd(GPIO_CFG(PIN_INT)), (unsigned)rd(GPIO_IO(PIN_INT)));
+	}
+	/*
+	 * K60S20_PMIC_READBACK: io_supply_on() only checks that the RPMh write was
+	 * accepted, never that the rail actually came up. Read the PMIC back so a
+	 * "write accepted but no voltage" case cannot masquerade as a SPI problem.
+	 * Android recorded pm8350c_l2 as enabled 1.8 V (docs/OPS-TWRP-DD.md:171);
+	 * ldoc2 in cmd_db is the same rail.
+	 */
+	{
+		uint32_t iovdd = rpmh_address("ldoc2");
+		uint16_t apid = 0;
+
+		printf("K60S20: ldoc2 cmd_db=%#x (type=%u)\n", iovdd, (iovdd >> 16) & 15);
+		/* pm8350c: the SPMI slave that owns ldoc2/ldoc3/ldoc12 */
+		if (k60_spmi_find(0x2c2u, &apid) == 0) {
+			uint8_t v2 = 0, e2 = 0, v3 = 0, e3 = 0, v12 = 0, e12 = 0;
+
+			k60_spmi_read(apid, 0x00, &v2, 1);           /* LDO2 VOUT */
+			k60_spmi_read(apid, 0x46, &e2, 1);           /* LDO2 enable */
+			k60_spmi_read(apid, 0x00, &v3, 1);
+			/* reg offsets are relative to the peripheral base; print what we can */
+			printf("K60S20: pm8350c apid=%#x ldo2_vset=%#x ldo2_en=%#x\n",
+			    apid, v2, e2);
+			(void)v3; (void)e3; (void)v12; (void)e12;
+		} else {
+			printf("K60S20: pm8350c (ppid 0x2c2) not found on SPMI\n");
+		}
+	}
+
+	/* 1) RESET level sweep: does releasing reset change INT or any pad? */
+	for (unsigned level = 0; level < 2; level++) {
+		gpio_output(PIN_RESET, level ? true : false, PULL_NONE, 6);
+		sleep_ms(30);
+		printf("K60S20: reset=%u int=%u\n", level, gpio_get(PIN_INT));
+		for (unsigned i = 0; i < 4; i++) {
+			unsigned up = k60_sample_with_pull(cand[i], PULL_UP);
+			unsigned dn = k60_sample_with_pull(cand[i], 1u);
+			printf("K60S20:   reset=%u gpio%u up=%u down=%u -> %s\n",
+			    level, cand[i], up, dn, (up == dn) ? "DRIVEN" : "FLOATING");
+		}
+	}
+
+	/* 2) Hold the controller released and sweep every role assignment.
+	 *    For each assignment, drive CS low and CLK idle, then sample each of
+	 *    the four pads. A pad that ignores the pull is being driven by the
+	 *    controller, which identifies the real MISO. */
+	gpio_output(PIN_RESET, true, PULL_UP, 6);
+	sleep_ms(20);
+	printf("K60S20: role sweep (reset released, int=%u)\n", gpio_get(PIN_INT));
+	for (unsigned a = 0; a < 4; a++) {
+		for (unsigned b = 0; b < 4; b++) {
+			if (b == a) continue;
+			for (unsigned c = 0; c < 4; c++) {
+				if (c == a || c == b) continue;
+				for (unsigned d = 0; d < 4; d++) {
+					if (d == a || d == b || d == c) continue;
+					/* a=MISO b=MOSI c=CLK d=CS
+					 * Clear every pad to a plain input first: the previous
+					 * iteration may have left one of them driven low as CS, and a
+					 * pad that is only *released* keeps its level long enough to be
+					 * misread as "driven". */
+					for (unsigned r = 0; r < 4; r++) {
+						gpio_configure(cand[r], 0, PULL_NONE, 2, false);
+					}
+					sleep_ms(2);
+					gpio_configure(cand[d], 0, PULL_UP, 6, true);
+					gpio_set(cand[d], false);
+					gpio_configure(cand[c], 0, PULL_NONE, 6, true);
+					gpio_set(cand[c], false);
+					gpio_configure(cand[b], 0, PULL_NONE, 6, true);
+					gpio_set(cand[b], false);
+					gpio_configure(cand[a], 0, PULL_NONE, 2, false);
+					sleep_ms(2);
+					{
+						unsigned up = k60_sample_with_pull(cand[a], PULL_UP);
+						unsigned dn = k60_sample_with_pull(cand[a], 1u);
+						if (up == dn) {
+							printf("K60S20: MISO=gpio%u MOSI=gpio%u CLK=gpio%u CS=gpio%u -> DRIVEN(%u)\n",
+							    cand[a], cand[b], cand[c], cand[d], up);
+						}
+					}
+				}
+			}
+		}
+	}
+	printf("K60S20: role sweep done\n");
+
+	/* 3) Leave the pads in the documented roles. */
+	gpio_configure(PIN_MISO, 0, PULL_NONE, 2, false);
+	gpio_configure(PIN_MOSI, 0, PULL_NONE, 6, true);
+	gpio_configure(PIN_CLK, 0, PULL_NONE, 6, true);
+	gpio_configure(PIN_CS, 0, PULL_UP, 6, true);
+	printf("K60S20: done int=%u\n", gpio_get(PIN_INT));
+}
+/* ==== end K60_STAGE20_ELEC ================================================ */
+
+/* ==== K60_STAGE19_GENI_POWER: GENI SPI + correct rails + probe ============== */
+/*
+ * K60_STAGE19_READY: returns true when the controller answered, so the caller
+ * can fall through into the polling loop. Returning void here is what made the
+ * thread terminate right after a successful probe: dev_confirm and probe both
+ * reported OK while no event was ever polled.
+ */
+static bool
+k60_stage19_geni_power(void)
+{
+	printf("K60S19: GENI SPI + io_supply_on + probe\n");
+	/* power FIRST so the chip is awake before the first GENI transfer */
+	io_supply_on();
+	gpio_output(PIN_RESET, true, PULL_UP, 6);
+	gpio_configure(PIN_INT, 0, PULL_UP, 6, false);
+	if (!clocks_on()) {
+		printf("K60S19: clocks_on failed\n");
+		return false;
+	}
+
+	const char *problem = geni_spi_init(4000000);
+	if (!problem) {
+		/* GENI accepted the engine: mux the four pads to qup4 and try it. */
+		gpio_configure(PIN_MISO, 1, PULL_NONE, 6, false);
+		gpio_configure(PIN_MOSI, 1, PULL_NONE, 6, false);
+		gpio_configure(PIN_CLK, 1, PULL_NONE, 6, false);
+		gpio_configure(PIN_CS, 1, PULL_NONE, 6, false);
+		/* spi_transfer was chosen by geni_spi_init (FIFO or DMA) */
+		k60_touch_power_cycle();
+		printf("K60S19: reset done int=%u\n", gpio_get(PIN_INT));
+		if (goodix_dev_confirm()) {
+			printf("K60S19: dev_confirm -> OK\n");
+			sleep_ms(100);
+			if (goodix_probe(true)) {
+				printf("K60S19: goodix_probe -> OK (GENI path)\n");
+				return true;
+			}
+			printf("K60S19: goodix_probe -> fail; trying SPI by GPIO\n");
+		}
+		/*
+		 * The engine accepted the command but no byte moved (measured:
+		 * "SPI transfer of 13 bytes failed: status 0, sent 13, received 0").
+		 * That is the expected behaviour on this board: SE4 runs its firmware in
+		 * GSI (DMA-only) mode, so both the FIFO and the legacy SE DMA paths are
+		 * dead even though geni_spi_init() succeeds. Fall through to bit-bang.
+		 */
+		printf("K60S19: GENI probe failed (status 0 / received 0); falling back to SPI by GPIO\n");
+	} else {
+		printf("K60S19: GENI unavailable: %s; trying SPI by GPIO\n", problem);
+	}
