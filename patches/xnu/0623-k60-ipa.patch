+/* ------------------------------------------------------------------ *
+ * M2 runtime: the Pong IPA5.1 command-DMA owner.
+ *
+ * The structures below mirror drivers/PongAdreno/ArmSmmu4K/ArmSmmu4K.h,
+ * ArmSmmu4KContext.h and ArmSmmu4KProgram.h.  bsd/dev does not see the
+ * osfmk driver include roots, so the ABI is declared locally.
+ * ------------------------------------------------------------------ */
+typedef struct {
+    unsigned input_bits;
+    unsigned output_bits;
+    uint64_t table_physical;
+    size_t leaf_budget;
+} K60IpaArmSmmuConfig;
+
+typedef struct {
+    uint64_t iova, physical, bytes;
+    unsigned permissions;
+    unsigned writeback;
+    unsigned shareability;
+} K60IpaArmSmmuRange;
+
+typedef struct {
+    uint64_t root_physical;
+    uint64_t mair;
+    size_t table_pages, leaf_pages;
+    unsigned start_level;
+    unsigned upper_region;
+} K60IpaArmSmmuResult;
+
+typedef struct {
+    const K60IpaArmSmmuConfig *lower, *upper;
+    const K60IpaArmSmmuResult *lower_tables, *upper_tables;
+    uint32_t id0, id2;
+    unsigned asid;
+    unsigned coherent_walk;
+    unsigned stall_on_fault, continue_after_fault;
+    unsigned polled_faults;
+    unsigned ignore_top_byte;
+    unsigned shared_asid;
+} K60IpaArmSmmuContext;
+
+typedef struct {
+    uint32_t cbar, cba2r, tcr, tcr2, mair0, mair1, sctlr, reserved_zero;
+    uint64_t ttbr0, ttbr1;
+} K60IpaArmSmmuImage;
+
+typedef struct {
+    void *cookie;
+    size_t register_bytes;
+    int (*read32)(void *, size_t, uint32_t *);
+    int (*read64)(void *, size_t, uint64_t *);
+    int (*write32)(void *, size_t, uint32_t);
+    int (*write64)(void *, size_t, uint64_t);
+    int (*barrier)(void *);
+    unsigned polled_faults;
+} K60IpaArmSmmuIo;
+
+typedef struct {
+    uint64_t context_offset;
+    uint32_t id0, id1, id2, phase, writes, poll_reads, fault_status;
+    uint32_t readback_valid, enabled, disabled_verified, tlb_synchronized;
+    uint32_t must_retain_tables;
+    K60IpaArmSmmuImage readback;
+} K60IpaArmSmmuProgramResult;
+
+extern int ArmSmmu4KBuild(const K60IpaArmSmmuConfig *, const K60IpaArmSmmuRange *,
+    size_t, uint64_t *, size_t, K60IpaArmSmmuResult *);
+extern int ArmSmmu4KProgramDisabledContext(const K60IpaArmSmmuIo *, unsigned,
+    const K60IpaArmSmmuContext *, unsigned, K60IpaArmSmmuProgramResult *);
+
+typedef struct {
+    volatile uint8_t *smmu;
+} K60IpaSmmuView;
+
+typedef struct {
+    volatile uint8_t *gsi;
+    volatile uint8_t *ipa;
+    uint8_t *ring;
+    uint64_t ring_pa;
+    uint8_t *tables;
+    uint64_t tables_pa;
+    K60IpaGsi state;
+} K60IpaRuntime;
+
+static K60IpaRuntime k60_ipa_runtime;
+
+static uint32_t
+k60_ipa_rt_read_gsi(void *cookie, uint32_t offset)
+{
+    K60IpaRuntime *rt = cookie;
+
+    return *(volatile uint32_t *)(rt->gsi + offset);
+}
+
+static void
+k60_ipa_rt_write_gsi(void *cookie, uint32_t offset, uint32_t value)
+{
+    K60IpaRuntime *rt = cookie;
+
+    *(volatile uint32_t *)(rt->gsi + offset) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint32_t
+k60_ipa_rt_read_ipa(void *cookie, uint32_t offset)
+{
+    K60IpaRuntime *rt = cookie;
+
+    return *(volatile uint32_t *)(rt->ipa + offset);
+}
+
+static void
+k60_ipa_rt_write_ipa(void *cookie, uint32_t offset, uint32_t value)
+{
+    K60IpaRuntime *rt = cookie;
+
+    *(volatile uint32_t *)(rt->ipa + offset) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+k60_ipa_rt_delay_us(void *cookie, uint32_t microseconds)
+{
+    (void)cookie;
+    delay((int)microseconds);
+}
+
+static uint64_t
+k60_ipa_rt_now_ms(void *cookie)
+{
+    clock_sec_t secs = 0;
+    clock_nsec_t nsecs = 0;
+
+    (void)cookie;
+    clock_get_system_nanotime(&secs, &nsecs);
+    return (uint64_t)secs * 1000u + (uint64_t)nsecs / 1000000u;
+}
+
+static void
+k60_ipa_rt_sync(void *cookie, const void *address, size_t bytes, int direction)
+{
+    K60IpaRuntime *rt = cookie;
+    uintptr_t value = (uintptr_t)address;
+    uintptr_t ring = (uintptr_t)rt->ring;
+    uintptr_t tables = (uintptr_t)rt->tables;
+    uint64_t physical = 0;
+
+    (void)direction;
+    if (value >= ring && value < ring + K60_IPA_GSI_RING_BYTES) {
+        physical = rt->ring_pa + (value - ring);
+    } else if (value >= tables && value < tables + K60_IPA_GSI_TABLE_BYTES) {
+        physical = rt->tables_pa + (value - tables);
+    }
+    if (physical != 0) {
+        flush_dcache64((addr64_t)physical, (unsigned)bytes, TRUE);
+    }
+}
+
+static uint32_t
+k60_ipa_smmu_read(void *context, unsigned offset)
+{
+    K60IpaSmmuView *view = context;
+
+    return *(volatile uint32_t *)(view->smmu + offset);
+}
+
+static int
+k60_ipa_smmu_read32(void *cookie, size_t offset, uint32_t *value)
+{
+    K60IpaSmmuView *view = cookie;
+
+    *value = *(volatile uint32_t *)(view->smmu + offset);
+    return 0;
+}
+
+static int
+k60_ipa_smmu_read64(void *cookie, size_t offset, uint64_t *value)
+{
+    K60IpaSmmuView *view = cookie;
+
+    *value = *(volatile uint64_t *)(view->smmu + offset);
+    return 0;
+}
+
+static int
+k60_ipa_smmu_write32(void *cookie, size_t offset, uint32_t value)
+{
+    K60IpaSmmuView *view = cookie;
+
+    *(volatile uint32_t *)(view->smmu + offset) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+    return 0;
+}
+
+static int
+k60_ipa_smmu_write64(void *cookie, size_t offset, uint64_t value)
+{
+    K60IpaSmmuView *view = cookie;
+
+    *(volatile uint64_t *)(view->smmu + offset) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+    return 0;
+}
+
+static int
+k60_ipa_smmu_barrier(void *cookie)
+{
+    (void)cookie;
+    __asm__ volatile("dsb sy" ::: "memory");
+    return 0;
+}
+
+static int
+k60_ipa_runtime_alloc(uint8_t **va, uint64_t *pa, vm_size_t bytes,
+    vm_offset_t mask)
+{
+    vm_offset_t address = 0;
+    ppnum_t page;
+
+    if (kmem_alloc_contig(kernel_map, &address, bytes, mask, 0, 0,
+        KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) !=
+        KERN_SUCCESS) {
+        return K60IpaRuntimeFailed;
+    }
+    page = pmap_find_phys(kernel_pmap, (addr64_t)address);
+    if (page == 0 || ptoa_64(page) + bytes > (1ull << 36)) {
+        return K60IpaRuntimeFailed;
+    }
+    *va = (uint8_t *)address;
+    *pa = ptoa_64(page);
+    return K60IpaOk;
+}
+
+/* SMEM item 497 is the shared IPA filter/route region. Pong allocates it from
+ * the modem partition under the TCSR SMEM mutex before mapping it; merely
+ * finding it works only when an earlier boot stage happened to create it. */
+static int
+k60_ipa_runtime_smem_item(K60Smem *smem, K60SmemPartition *partition,
+    uint32_t *offset, uint32_t *length)
+{
+    volatile uint8_t *mutex;
+    unsigned i;
+    int rc, locked = 0;
+
+    mutex = (volatile uint8_t *)(uintptr_t)ml_io_map_unmappable(
+        (vm_offset_t)K60_IPA_SMEM_MUTEX_BASE,
+        (vm_size_t)K60_IPA_SMEM_MUTEX_BYTES, 0x7);
+    if (mutex == 0) {
+        printf("K60IPA M2 SMEM mutex map failed\n");
+        return K60IpaMapFailed;
+    }
+    for (i = 0; i < 1000u; i++) {
+        *(volatile uint32_t *)mutex = 1u;
+        k60_ipa_fence();
+        if (*(volatile uint32_t *)mutex == 1u) {
+            locked = 1;
+            break;
+        }
+        delay(10);
+    }
+    if (!locked) {
+        printf("K60IPA M2 SMEM mutex timeout\n");
+        return K60IpaSmmuFailed;
+    }
+    rc = k60_smem_alloc(smem, partition, K60_IPA_SMEM_ITEM,
+        K60_IPA_SMEM_MIN_BYTES, offset, length);
+    if (rc == K60SmemExists) {
+        rc = k60_smem_find(smem, partition, K60_IPA_SMEM_ITEM, offset,
+            length);
+    }
+    *(volatile uint32_t *)mutex = 0u;
+    k60_ipa_fence();
+    return rc;
+}
+
+
+static int
+k60_ipa_runtime_smmu(K60IpaRuntime *rt)
+{
+    K60IpaSmmuView view;
+    K60IpaSmmuPlan plan;
+    K60IpaArmSmmuConfig config;
+    K60IpaArmSmmuRange ranges[3];
+    K60IpaArmSmmuResult built;
+    K60IpaArmSmmuContext context;
+    K60IpaArmSmmuIo io;
+    K60IpaArmSmmuProgramResult programmed;
+    K60Smem smem;
+    K60SmemPartition partition;
+    volatile uint8_t *smmu;
+    volatile uint8_t *smem_window;
+    uint64_t smem_address, smem_start, smem_size;
+    uint32_t smem_offset = 0, smem_length = 0;
+    int rc, status;
+
+    smmu = (volatile uint8_t *)(uintptr_t)ml_io_map_unmappable(
+        (vm_offset_t)K60_IPA_SMMU_BASE, (vm_size_t)K60_IPA_SMMU_BYTES, 0x7);
+    if (smmu == 0) {
+        printf("K60IPA M2 SMMU map failed\n");
+        return K60IpaMapFailed;
+    }
+    printf("K60IPA M2 SMMU idr id0=%#x id1=%#x id2=%#x\n",
+        *(volatile uint32_t *)(smmu + 0x20u),
+        *(volatile uint32_t *)(smmu + 0x24u),
+        *(volatile uint32_t *)(smmu + 0x28u));
+    view.smmu = smmu;
+    rc = k60_ipa_smmu_plan(&plan, K60_IPA_RUNTIME_SID,
+        K60_IPA_RUNTIME_IOVA, K60_IPA_GSI_RING_BYTES,
+        k60_ipa_smmu_read, &view, 78u, 120u);
+    if (rc != K60IpaSmmuOk) {
+        printf("K60IPA M2 SMMU plan failed: %s\n",
+            plan.error ? plan.error : "unknown");
+        return K60IpaSmmuFailed;
+    }
+
+    smem_window = (volatile uint8_t *)(uintptr_t)ml_io_map_unmappable(
+        (vm_offset_t)K60_IPA_SMEM_BASE, (vm_size_t)K60_IPA_SMEM_BYTES, 0x7);
+    if (smem_window == 0) {
+        printf("K60IPA M2 SMEM map failed\n");
+        return K60IpaMapFailed;
+    }
+    smem.base = smem_window;
+    smem.size = K60_IPA_SMEM_BYTES;
+    rc = k60_smem_partition(&smem, 0, 1, &partition);
+    if (rc != K60SmemOk) {
+        printf("K60IPA M2 SMEM partition missing rc=%d\n", rc);
+        return K60IpaSmmuFailed;
+    }
+    rc = k60_ipa_runtime_smem_item(&smem, &partition, &smem_offset,
+        &smem_length);
+    if (rc != K60SmemOk || smem_length < K60_IPA_SMEM_MIN_BYTES ||
+        smem_offset > K60_IPA_SMEM_BYTES - K60_IPA_SMEM_MIN_BYTES) {
+        printf("K60IPA M2 SMEM item 497 allocation failed rc=%d offset=%u length=%u\n",
+            rc, smem_offset, smem_length);
+        return K60IpaSmmuFailed;
+    }
+    smem_address = K60_IPA_SMEM_BASE + smem_offset;
+    smem_start = smem_address & ~0xfffull;
+    smem_size = ((smem_address + K60_IPA_SMEM_MIN_BYTES + 0xfffull) &
+        ~0xfffull) - smem_start;
+
+    config.input_bits = 32u;
+    config.output_bits = 36u;
+    config.table_physical = rt->tables_pa;
+    config.leaf_budget = (size_t)((K60_IPA_GSI_RING_BYTES + 0x2000u +
+        smem_size) / 4096u);
+    ranges[0].iova = 0x146a8000u;
+    ranges[0].physical = 0x146a8000u;
+    ranges[0].bytes = 0x2000u;
+    ranges[0].permissions = 3u;
+    ranges[0].writeback = 2u;
+    ranges[0].shareability = 2u;
+    ranges[1].iova = K60_IPA_RUNTIME_IOVA;
+    ranges[1].physical = rt->ring_pa;
+    ranges[1].bytes = K60_IPA_GSI_RING_BYTES;
+    ranges[1].permissions = 3u;
+    ranges[1].writeback = 1u;
+    ranges[1].shareability = 3u;
+    ranges[2].iova = smem_start;
+    ranges[2].physical = smem_start;
+    ranges[2].bytes = smem_size;
+    ranges[2].permissions = 3u;
+    ranges[2].writeback = 0u;
+    ranges[2].shareability = 2u;
+    status = ArmSmmu4KBuild(&config, ranges, 3u,
+        (uint64_t *)(uintptr_t)rt->tables, K60_IPA_GSI_TABLE_BYTES / 4096u,
+        &built);
+    if (status != 0) {
+        printf("K60IPA M2 SMMU table build failed status=%d\n", status);
+        return K60IpaSmmuFailed;
+    }
+    flush_dcache64((addr64_t)rt->tables_pa,
+        (unsigned)(built.table_pages * 4096u), TRUE);
+
+    memset(&context, 0, sizeof(context));
+    context.lower = &config;
+    context.lower_tables = &built;
+    context.id0 = *(volatile uint32_t *)(smmu + 0x20u);
+    context.id2 = *(volatile uint32_t *)(smmu + 0x28u);
+    context.asid = K60_IPA_RUNTIME_SID;
+    context.coherent_walk = 1u;
+    context.polled_faults = 1u;
+    context.ignore_top_byte = 1u;
+    context.shared_asid = 1u;
+    memset(&io, 0, sizeof(io));
+    io.cookie = &view;
+    io.register_bytes = K60_IPA_SMMU_BYTES;
+    io.read32 = k60_ipa_smmu_read32;
+    io.read64 = k60_ipa_smmu_read64;
+    io.write32 = k60_ipa_smmu_write32;
+    io.write64 = k60_ipa_smmu_write64;
+    io.barrier = k60_ipa_smmu_barrier;
+    io.polled_faults = 1u;
+    memset(&programmed, 0, sizeof(programmed));
+    status = ArmSmmu4KProgramDisabledContext(&io, plan.bank, &context, 20000u,
+        &programmed);
+    if (status != 0) {
+        printf("K60IPA M2 SMMU program failed status=%d phase=%u FSR=%#x\n",
+            status, programmed.phase, programmed.fault_status);
+        return K60IpaSmmuFailed;
+    }
+    printf("K60IPA M2 SMMU context id0=%#x id1=%#x id2=%#x cbar=%#x sctlr=%#x\n",
+        programmed.id0, programmed.id1, programmed.id2,
+        programmed.readback.cbar, programmed.readback.sctlr);
+    *(volatile uint32_t *)(smmu + 0xc00u + 4u * plan.slot) = plan.bank;
+    if (!plan.migrate && !plan.reuse) {
+        *(volatile uint32_t *)(smmu + 0x800u + 4u * plan.slot) =
+            0x80000000u | K60_IPA_RUNTIME_SID;
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    if (*(volatile uint32_t *)(smmu + 0xc00u + 4u * plan.slot) != plan.bank ||
+        *(volatile uint32_t *)(smmu + 0x800u + 4u * plan.slot) !=
+        (0x80000000u | K60_IPA_RUNTIME_SID)) {
+        printf("K60IPA M2 SMMU stream readback failed\n");
+        return K60IpaSmmuFailed;
+    }
+    printf("K60IPA M2 SMMU bank=%u slot=%u pages=%u leaf=%u smem=%#llx/%#llx\n",
+        plan.bank, plan.slot, built.table_pages, built.leaf_pages,
+        (unsigned long long)smem_start, (unsigned long long)smem_size);
+    return K60IpaOk;
+}
+
+
+static int
+k60_ipa_runtime_gsi_init(K60IpaRuntime *rt)
+{
+    K60IpaGsiConfig config;
+    int rc;
+
+    memset(&config, 0, sizeof(config));
+    config.callbacks.read_gsi = k60_ipa_rt_read_gsi;
+    config.callbacks.write_gsi = k60_ipa_rt_write_gsi;
+    config.callbacks.read_reg = k60_ipa_rt_read_ipa;
+    config.callbacks.write_reg = k60_ipa_rt_write_ipa;
+    config.callbacks.delay_us = k60_ipa_rt_delay_us;
+    config.callbacks.now_ms = k60_ipa_rt_now_ms;
+    config.callbacks.sync = k60_ipa_rt_sync;
+    config.callbacks.cookie = rt;
+    config.ring = rt->ring;
+    config.ring_size = K60_IPA_GSI_RING_BYTES;
+    config.ring_iova = K60_IPA_RUNTIME_IOVA;
+    config.tables = rt->tables;
+    config.tables_size = K60_IPA_GSI_TABLE_BYTES;
+    config.tables_iova = K60_IPA_RUNTIME_IOVA + K60_IPA_GSI_RING_BYTES;
+    config.gsi_bytes = K60_GSI_BYTES;
+    rc = k60_ipa_gsi_init(&rt->state, &config);
+    if (rc != K60IpaOk) {
+        printf("K60IPA M2 GSI init failed rc=%d\n", rc);
+    }
+    return rc;
+}
+
+static int
+k60_ipa_runtime_gsi(K60IpaRuntime *rt)
+{
+    uint64_t deadline;
+    int rc;
+
+    rc = k60_ipa_gsi_start(&rt->state);
+    if (rc != K60IpaOk) {
+        printf("K60IPA M2 GSI start failed rc=%d stage=%u\n", rc,
+            rt->state.stage);
+        return rc;
+    }
+    deadline = k60_ipa_rt_now_ms(rt) + 5000u;
+    while (rt->state.stage != 10u && k60_ipa_rt_now_ms(rt) < deadline) {
+        rc = k60_ipa_gsi_poll(&rt->state);
+        if (rc == K60IpaOk) {
+            continue;
+        }
+        if (rc != K60IpaNotReady) {
+            printf("K60IPA M2 GSI poll failed rc=%d stage=%u\n", rc,
+                rt->state.stage);
+            return rc;
+        }
+        delay(1000);
+    }
+    if (rt->state.stage != 10u || rt->state.error != K60IpaOk) {
+        printf("K60IPA M2 GSI timeout stage=%u error=%d completed=%u\n",
+            rt->state.stage, rt->state.error, rt->state.completed_commands);
+        return K60IpaRuntimeFailed;
+    }
+    printf("K60IPA M2 GSI ready stage=%u channels=%u events=%u restricted=%#x sram=%#x completed=%u\n",
+        rt->state.stage, rt->state.channels, rt->state.events,
+        rt->state.restricted, rt->state.sram_bytes,
+        rt->state.completed_commands);
+    return K60IpaOk;
+}
+
+static int
+k60_ipa_runtime_start(volatile uint8_t *gsi, volatile uint8_t *ipa)
+{
+    int enabled = 0;
+    int rc;
+
+    /* Value 1 runs the M1 firmware/PAS path only; value 2 additionally
+     * enables the M2 runtime. The extra level keeps the shared 608-byte
+     * boot-argument budget intact. */
+    if (!PE_parse_boot_argn("pong_ipa", &enabled, sizeof(enabled)) ||
+        enabled < 2) {
+        printf("K60IPA M2 runtime gated pong_ipa=%d\n", enabled);
+        return K60IpaOk;
+    }
+    if (gsi == 0 || ipa == 0) {
+        return K60IpaBadArgument;
+    }
+    memset(&k60_ipa_runtime, 0, sizeof(k60_ipa_runtime));
+    k60_ipa_runtime.gsi = gsi;
+    k60_ipa_runtime.ipa = ipa;
+    rc = k60_ipa_runtime_alloc(&k60_ipa_runtime.ring,
+        &k60_ipa_runtime.ring_pa, K60_IPA_GSI_RING_BYTES, 0xffffu);
+    if (rc != K60IpaOk) {
+        printf("K60IPA M2 ring allocation failed rc=%d\n", rc);
+        return rc;
+    }
+    rc = k60_ipa_runtime_alloc(&k60_ipa_runtime.tables,
+        &k60_ipa_runtime.tables_pa, K60_IPA_GSI_TABLE_BYTES, 0xfffu);
+    if (rc != K60IpaOk) {
+        printf("K60IPA M2 table allocation failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA M2 ring=%#llx tables=%#llx\n",
+        (unsigned long long)k60_ipa_runtime.ring_pa,
+        (unsigned long long)k60_ipa_runtime.tables_pa);
+    /* k60_ipa_gsi_init() zeroes the 0x8000-byte table block; build the SMMU
+     * page tables only after that so the init cannot erase them. */
+    rc = k60_ipa_runtime_gsi_init(&k60_ipa_runtime);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+    rc = k60_ipa_runtime_smmu(&k60_ipa_runtime);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+    return k60_ipa_runtime_gsi(&k60_ipa_runtime);
+}
+
+int
+k60_ipa_firmware_start(const void *blob, uint64_t size)
+{
+    K60IpaFirmwarePlan plan;
+    vm_offset_t firmware, metadata, gsi_map;
+    int rc;
+
+    if (!blob) {
+        return K60IpaBadArgument;
+    }
+    rc = k60_ipa_clock_vote();
+    if (rc != K60IpaOk) {
+        printf("K60IPA IP0 clock unavailable rc=%d\n", rc);
+        return rc;
+    }
+    rc = k60_ipa_firmware_check(blob, size, &plan);
+    if (rc != K60IpaOk) {
+        printf("K60IPA firmware check failed rc=%d size=%llu\n", rc,
+            (unsigned long long)size);
+        return rc;
+    }
+    printf("K60IPA firmware plan span=%#llx metadata=%#llx loads=%u\n",
+        (unsigned long long)plan.span, (unsigned long long)plan.metadata,
+        plan.load_segments);
+    /* The TZ-owned GSI global block must not be overwritten. A set EE0 bit
+     * before PAS means another manager already owns the block; Pong checks
+     * the same status before its signed firmware load. */
+    gsi_map = ml_io_map_unmappable((vm_offset_t)K60_GSI_BASE,
+        (vm_size_t)K60_GSI_BYTES, 0x7);
+    if (gsi_map == 0) {
+        printf("K60IPA cannot map GSI view %#x\n", K60_GSI_BASE);
+        return K60IpaMapFailed;
+    }
+    {
+        K60IpaGsiCaps caps;
+
+        rc = k60_ipa_gsi_check((void *)(uintptr_t)gsi_map, K60_GSI_BYTES,
+            &caps);
+        printf("K60IPA pre-PAS GSI status=%#x channels=%u events=%u cmd=%u ev0=%u\n",
+            caps.status, caps.channels, caps.events, caps.command_state,
+            caps.event_state);
+        if (rc != K60IpaOk) {
+            printf("K60IPA GSI not available for IPA rc=%d\n", rc);
+            return rc;
+        }
+    }
+    /* Both IPA regions are DDR carveouts, not device memory: use the same
+     * VM_WIMG_DEFAULT flag K60ModemBoot and K60AdspBoot use. */
+    firmware = ml_io_map_unmappable((vm_offset_t)K60_IPA_FIRMWARE_BASE,
+        (vm_size_t)K60_IPA_FIRMWARE_BYTES, 0x2);
+    if (firmware == 0) {
+        printf("K60IPA cannot map firmware region %#x\n",
+            K60_IPA_FIRMWARE_BASE);
+        return K60IpaMapFailed;
+    }
+    metadata = ml_io_map_unmappable((vm_offset_t)K60_IPA_METADATA_BASE,
+        (vm_size_t)K60_IPA_METADATA_BYTES, 0x2);
+    if (metadata == 0) {
+        printf("K60IPA cannot map metadata region %#x\n",
+            K60_IPA_METADATA_BASE);
+        return K60IpaMapFailed;
+    }
+    rc = k60_ipa_firmware_stage(blob, size, (void *)firmware,
+        K60_IPA_FIRMWARE_BYTES, (void *)metadata, K60_IPA_METADATA_BYTES,
+        &plan);
+    if (rc != K60IpaOk) {
+        printf("K60IPA firmware stage failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA firmware staged at %#x metadata=%#x\n",
+        K60_IPA_FIRMWARE_BASE, K60_IPA_METADATA_BASE);
+    rc = k60_ipa_pas_call(K60M_SCM_PAS_INIT_IMAGE,
+        k60_modem_scm_args(2, K60M_SCM_VAL, K60M_SCM_RW, 0),
+        K60_IPA_PAS_ID, K60_IPA_METADATA_BASE, 0);
+    if (rc != K60IpaOk) {
+        printf("K60IPA init_image failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA init_image ok\n");
+    rc = k60_ipa_pas_call(K60M_SCM_PAS_MEM_SETUP,
+        k60_modem_scm_args(3, 0, 0, 0), K60_IPA_PAS_ID,
+        K60_IPA_FIRMWARE_BASE, plan.span);
+    if (rc != K60IpaOk) {
+        printf("K60IPA mem_setup failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA mem_setup ok base=%#x span=%#llx\n",
+        K60_IPA_FIRMWARE_BASE, (unsigned long long)plan.span);
+    rc = k60_ipa_pas_call(K60M_SCM_PAS_AUTH_AND_RESET,
+        k60_modem_scm_args(1, 0, 0, 0), K60_IPA_PAS_ID, 0, 0);
+    if (rc != K60IpaOk) {
+        printf("K60IPA auth_and_reset failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA auth_and_reset ok\n");
+    {
+        uint32_t status = *(volatile uint32_t *)(gsi_map + 0x25000);
+        uint32_t channels = *(volatile uint32_t *)(gsi_map + 0x25040) & 0xffu;
+        uint32_t events = *(volatile uint32_t *)(gsi_map + 0x25050) & 0xffu;
+
+        printf("K60IPA post-PAS GSI status=%#x channels=%u events=%u\n",
+            status, channels, events);
+        if ((status & 1u) == 0) {
+            printf("K60IPA GSI EE0 not enabled after auth\n");
+        }
+    }
+    {
+        volatile uint8_t *cfg = (volatile uint8_t *)(uintptr_t)
+            ml_io_map_unmappable((vm_offset_t)K60_IPA_CFG_BASE, 0x20000, 0x7);
+        uint32_t version, comp;
+
+        if (cfg == NULL) {
+            printf("K60IPA cannot map cfg page %#x\n", K60_IPA_CFG_BASE);
+            return K60IpaMapFailed;
+        }
+        version = *(volatile uint32_t *)(cfg + K60_IPA_VERSION_REG);
+        comp = *(volatile uint32_t *)(cfg + K60_IPA_COMP_HW_VERSION_REG);
+        printf("K60IPA version=%#x comp=%#x\n", version, comp);
+        if (version == 0 || version == 0xffffffffu) {
+            printf("K60IPA IPAREADY not set\n");
+            return K60IpaNotReady;
+        }
+        rc = k60_ipa_resources_prepare((void *)(uintptr_t)cfg, 0x20000);
+        printf("K60IPA resources ready=%d\n", rc == K60IpaOk);
+        if (rc != K60IpaOk) {
+            return rc;
+        }
+        rc = k60_ipa_runtime_start((volatile uint8_t *)(uintptr_t)gsi_map,
+            (volatile uint8_t *)cfg);
+        if (rc != K60IpaOk) {
+            printf("K60IPA M2 runtime failed rc=%d\n", rc);
+            return rc;
+        }
+    }
+    return K60IpaOk;
+}
+#else /* K60_HOST_TEST */
+int
+k60_ipa_firmware_start(const void *blob, uint64_t size)
+{
+    (void)blob;
+    (void)size;
+    return K60IpaNotReady;
+}
+#endif /* K60_HOST_TEST */
+
+#ifndef K60_HOST_TEST
+int
+k60_ipa_probe_from_handoff(void)
+{
+    vm_offset_t ram;
+    int enabled = 0;
+    int clock_probe = 0;
+    int rc;
+
+    if (!PE_parse_boot_argn("pong_ipa", &enabled, sizeof(enabled)) ||
+        enabled == 0) {
+        return 0;
+    }
+    printf("K60IPA probe begin\n");
+    /* Default-off single-variable qualification of the IP0 clock vote:
+     * ipclk=1 maps command DB and DRV-2, places exactly one TCS4 command and
+     * stops before the payload FAT, PAS, SMMU and GSI. */
+    if (PE_parse_boot_argn("ipclk", &clock_probe, sizeof(clock_probe)) &&
+        clock_probe != 0) {
+        printf("K60IPA clock probe begin\n");
+        rc = k60_ipa_clock_vote();
+        printf("K60IPA clock probe result rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA firmware source=%#x bytes=%u\n",
+        K60_IPA_FW_REGION_BASE, K60_IPA_METADATA_OFFSET);
+    ram = ml_io_map_unmappable((vm_offset_t)K60_IPA_FW_REGION_BASE,
+        (vm_size_t)K60_IPA_METADATA_OFFSET, 0x2);
+    if (ram == 0) {
+        printf("K60IPA cannot map ipa_fw_region %#x\n",
+            K60_IPA_FW_REGION_BASE);
+        return -1;
+    }
+    return k60_ipa_firmware_start((const uint8_t *)(uintptr_t)ram,
+        K60_IPA_METADATA_OFFSET);
+}
+#else /* K60_HOST_TEST */
+int
+k60_ipa_probe_from_handoff(void)
+{
+    return K60IpaNotReady;
+}
+#endif /* K60_HOST_TEST */
+
+int
+k60_ipa_probe(void)
+{
+    printf("K60IPA probe: cfg=0x%x gsi=0x%x irq=%u/%u state=not-ready\n",
+        K60_IPA_CFG_BASE, K60_GSI_BASE, K60_IPA_IRQ, K60_GSI_IRQ);
+    return K60IpaNotReady;
+}
diff --git a/bsd/dev/pong_mdt.h b/bsd/dev/pong_mdt.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_mdt.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Ported from pong-power QcomMdt.h, Copyright (c) 2026 UniXNU contributors,
+ * SPDX-License-Identifier: BSD-2-Clause-Patent. Renamed to the K60 namespace.
+ *
+ * Qualcomm signed firmware images (.mbn, an ELF32 or ELF64 whose program headers carry the segment types in p_flags) as the peripheral
+ * authentication service takes them: the metadata handed to the secure world (the ELF and program headers followed by the hash
+ * segment), the extent of the loadable segments and where each one goes in the carveout. Pure parsing over a read callback: no
+ * allocation, no hardware, so the same code runs in the kernel and in the host tests. */
+#ifndef K60_MDT_H
+#define K60_MDT_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define K60_MDT_MAX_SEGMENTS 64u
+#define K60_MDT_TYPE_MASK (7u << 24)
+#define K60_MDT_TYPE_HASH (2u << 24)
+#define K60_MDT_RELOCATABLE (1u << 27)
+
+/* Reads length bytes at offset of the image file into to; returns 0 on success. */
+typedef int (*K60MdtRead)(void *context, uint64_t offset, void *to, size_t length);
+
+typedef struct {
+    uint64_t file_offset, file_size, memory_size, address;  /* address: p_paddr */
+    uint32_t flags;
+    uint8_t load;  /* a loadable segment (PT_LOAD, not the hash, memory size not zero) */
+} K60MdtSegment;
+
+typedef struct {
+    uint8_t elf64;
+    uint32_t count;
+    K60MdtSegment segment[K60_MDT_MAX_SEGMENTS];
+    int hash;                        /* index of the hash segment */
+    uint64_t header_size;            /* p_filesz of the first program header: ELF header plus program headers */
+    uint64_t min_address, max_address;  /* of the loadable segments */
+    uint8_t relocatable;
+    uint64_t file_size;
+} K60MdtImage;
+
+enum {
+    K60MdtOk = 0,
+    K60MdtReadError = -1,
+    K60MdtNotElf = -2,
+    K60MdtBadHeaders = -3,
+    K60MdtNoHash = -4,
+    K60MdtTooMany = -5,
+    K60MdtNoSegments = -6,
+    K60MdtOutside = -7,
+    K60MdtTooSmall = -8,
+};
+
+/* Parses the ELF and program headers of an image of file_size bytes. */
+int k60_mdt_parse(K60MdtImage *image, uint64_t file_size, K60MdtRead read, void *context);
+
+/* Bytes of the metadata blob for the authentication service: the header part and the hash segment. */
+uint64_t k60_mdt_metadata_size(const K60MdtImage *image);
+
+/* Writes the metadata blob (k60_mdt_metadata_size bytes) to to. The hash segment must lie inside the file: images split into .bNN
+ * files are joined into one .mbn on the host before they are installed. */
+int k60_mdt_metadata(const K60MdtImage *image, K60MdtRead read, void *context, uint8_t *to, uint64_t capacity);
+
+/* Bytes the loadable segments span (the end rounded up to 4 KiB, minus the lowest address): the size to hand to the memory setup call
+ * of a relocatable image. */
+uint64_t k60_mdt_span(const K60MdtImage *image);
+
+/* Offset of a loadable segment inside a carveout of region_size bytes at region_base: relocatable images are placed by their offset from
+ * the lowest segment, fixed ones by their address. Returns K60MdtOutside if the segment does not fit. */
+int k60_mdt_place(const K60MdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset);
+
+/* A split image (NAME.b00, NAME.b01, ... as found on the device's firmware partition) read as the joined image: the bytes of program
+ * header i's segment come from piece i (NAME.bNN) at the segment's file offset, piece 0 being the ELF and program headers; whatever
+ * lies between the pieces reads as zero. The pieces are the caller's files. */
+typedef int (*K60MdtPieceRead)(void *context, unsigned piece, uint64_t offset, void *to, size_t length);
+typedef struct {
+    uint32_t count;
+    struct {uint64_t offset, size;} piece[K60_MDT_MAX_SEGMENTS];  /* size 0: no piece file for this header */
+    uint64_t size;                                                  /* bytes of the joined image */
+} K60MdtSplit;
+
+/* Lays out the pieces from the headers (the bytes of NAME.b00, or the start of NAME.mdt). */
+int k60_mdt_split(K60MdtSplit *split, const uint8_t *headers, size_t length);
+/* Reads a range of the joined image. */
+int k60_mdt_split_read(const K60MdtSplit *split, K60MdtPieceRead read, void *context, uint64_t offset, void *to, size_t length);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/pong_mdt.c b/bsd/dev/pong_mdt.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_mdt.c
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Ported from pong-power QcomMdt.c, Copyright (c) 2026 UniXNU contributors. */
+#include "pong_mdt.h"
+
+#define PT_LOAD_ 1u
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static uint64_t le64(const uint8_t *p) {return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+
+int k60_mdt_parse(K60MdtImage *image, uint64_t file_size, K60MdtRead read, void *context)
+{
+    uint8_t e[64];
+    if (!image || !read) return K60MdtReadError;
+    *image = (K60MdtImage){0};
+    image->hash = -1;
+    image->file_size = file_size;
+    if (file_size < 52 || read(context, 0, e, file_size < 64 ? 52 : 64)) return file_size < 52 ? K60MdtTooSmall : K60MdtReadError;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 /* little endian */) return K60MdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (!elf64 && e[4] != 1) return K60MdtNotElf;
+    if (elf64 && file_size < 64) return K60MdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return K60MdtBadHeaders;
+    if (phnum > K60_MDT_MAX_SEGMENTS) return K60MdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, file_size)) return K60MdtBadHeaders;
+    image->elf64 = (uint8_t)elf64;
+    image->count = phnum;
+    uint64_t lo = UINT64_MAX, hi = 0;
+    for (unsigned i = 0; i < phnum; ++i) {
+        uint8_t p[56];
+        if (read(context, phoff + (uint64_t)i * phentsize, p, phentsize)) return K60MdtReadError;
+        K60MdtSegment *s = &image->segment[i];
+        const uint32_t type = le32(p);
+        if (elf64) {
+            s->flags = le32(p + 4); s->file_offset = le64(p + 8); s->address = le64(p + 24);
+            s->file_size = le64(p + 32); s->memory_size = le64(p + 40);
+        } else {
+            s->file_offset = le32(p + 4); s->address = le32(p + 12); s->file_size = le32(p + 16);
+            s->memory_size = le32(p + 20); s->flags = le32(p + 24);
+        }
+        if ((s->flags & K60_MDT_TYPE_MASK) == K60_MDT_TYPE_HASH) {
+            if (image->hash < 0) image->hash = (int)i;
+            continue;
+        }
+        if (type != PT_LOAD_ || !s->memory_size) continue;
+        if (s->file_size > s->memory_size) return K60MdtBadHeaders;
+        if (s->address + s->memory_size < s->address) return K60MdtBadHeaders;
+        s->load = 1;
+        if (s->flags & K60_MDT_RELOCATABLE) image->relocatable = 1;
+        if (s->address < lo) lo = s->address;
+        if (s->address + s->memory_size > hi) hi = s->address + s->memory_size;
+    }
+    if (image->hash < 0) return K60MdtNoHash;
+    if (hi == 0) return K60MdtNoSegments;
+    image->header_size = image->segment[0].file_size;
+    /* The first program header (PT_NULL) covers the ELF header and the program headers themselves. */
+    if (!image->header_size || !fits(0, image->header_size, file_size) || image->header_size < phoff + (uint64_t)phentsize * phnum)
+        return K60MdtBadHeaders;
+    image->min_address = lo;
+    image->max_address = hi;
+    return K60MdtOk;
+}
+
+uint64_t k60_mdt_metadata_size(const K60MdtImage *image)
+{
+    return image->header_size + image->segment[image->hash].file_size;
+}
+
+int k60_mdt_metadata(const K60MdtImage *image, K60MdtRead read, void *context, uint8_t *to, uint64_t capacity)
+{
+    const K60MdtSegment *hash = &image->segment[image->hash];
+    if (capacity < k60_mdt_metadata_size(image)) return K60MdtTooSmall;
+    uint64_t hash_offset;
+    /* A hash packed right behind the headers (the split .mdt form) or a hash segment inside the file. */
+    if (image->header_size + hash->file_size == image->file_size) hash_offset = image->header_size;
+    else if (fits(hash->file_offset, hash->file_size, image->file_size)) hash_offset = hash->file_offset;
+    else return K60MdtOutside;
+    if (read(context, 0, to, (size_t)image->header_size)) return K60MdtReadError;
+    if (read(context, hash_offset, to + image->header_size, (size_t)hash->file_size)) return K60MdtReadError;
+    return K60MdtOk;
+}
+
+/* The secure world takes the span with its end rounded up to a 4 KiB page and refuses an unaligned one. */
+uint64_t k60_mdt_span(const K60MdtImage *image) {return ((image->max_address + 0xfff) & ~0xfffull) - image->min_address;}
+
+int k60_mdt_place(const K60MdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset)
+{
+    if (index >= image->count || !image->segment[index].load) return K60MdtOutside;
+    const K60MdtSegment *s = &image->segment[index];
+    uint64_t at;
+    if (image->relocatable) at = s->address - image->min_address;
+    else if (s->address >= region_base) at = s->address - region_base;
+    else return K60MdtOutside;
+    if (!fits(at, s->memory_size, region_size)) return K60MdtOutside;
+    if (s->file_size && !fits(s->file_offset, s->file_size, image->file_size)) return K60MdtOutside;
+    *offset = at;
+    return K60MdtOk;
+}
+
+int k60_mdt_split(K60MdtSplit *split, const uint8_t *headers, size_t length)
+{
+    if (!split || !headers) return K60MdtReadError;
+    *split = (K60MdtSplit){0};
+    if (length < 52) return K60MdtTooSmall;
+    const uint8_t *e = headers;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 || (e[4] != 1 && e[4] != 2)) return K60MdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (elf64 && length < 64) return K60MdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return K60MdtBadHeaders;
+    if (phnum > K60_MDT_MAX_SEGMENTS) return K60MdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, length)) return K60MdtBadHeaders;
+    split->count = phnum;
+    for (unsigned i = 0; i < phnum; ++i) {
+        const uint8_t *p = e + phoff + (uint64_t)i * phentsize;
+        const uint64_t offset = elf64 ? le64(p + 8) : le32(p + 4), size = elf64 ? le64(p + 32) : le32(p + 16);
+        if (offset + size < offset) return K60MdtBadHeaders;
+        split->piece[i].offset = offset;
+        split->piece[i].size = size;
+        if (size && offset + size > split->size) split->size = offset + size;
+    }
+    /* piece 0 must be the headers themselves */
+    if (split->piece[0].offset || split->piece[0].size < phoff + (uint64_t)phentsize * phnum) return K60MdtBadHeaders;
+    return K60MdtOk;
+}
+
+int k60_mdt_split_read(const K60MdtSplit *split, K60MdtPieceRead read, void *context, uint64_t offset, void *to, size_t length)
+{
+    uint8_t *out = to;
+    if (!split || !read || !to || !fits(offset, length, split->size)) return K60MdtOutside;
+    while (length) {
+        /* the piece holding offset, or else the distance to the next piece */
+        uint64_t take = length, gap_end = split->size;
+        int hit = -1;
+        for (unsigned i = 0; i < split->count; ++i) {
+            const uint64_t at = split->piece[i].offset, size = split->piece[i].size;
+            if (!size) continue;
+            if (offset >= at && offset - at < size) {hit = (int)i; break;}
+            if (at > offset && at < gap_end) gap_end = at;
+        }
+        if (hit >= 0) {
+            const uint64_t left = split->piece[hit].offset + split->piece[hit].size - offset;
+            if (take > left) take = left;
+            if (read(context, (unsigned)hit, offset - split->piece[hit].offset, out, (size_t)take)) return K60MdtReadError;
+        } else {
+            if (take > gap_end - offset) take = gap_end - offset;
+            for (uint64_t i = 0; i < take; ++i) out[i] = 0;
+        }
+        out += take;
+        offset += take;
+        length -= (size_t)take;
+    }
+    return K60MdtOk;
+}
diff --git a/bsd/dev/pong_ipa_gsi.h b/bsd/dev/pong_ipa_gsi.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_ipa_gsi.h
@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* K60 IPA GSI 3.0 command DMA owner (M2, host-testable).
+ *
+ * This is the C port of the Pong baseband PongModemIpaDma.h command-DMA
+ * owner (BSD-2-Clause-Patent). It keeps the Pong GSI3.0 register offsets and
+ * the Pong sequence: EE0 event ownership, event0/command12 allocation, event
+ * and command ring context programming, IPA endpoint 14 DMA mode, and the
+ * IPA5.1 header/context/filter/route table commands.
+ *
+ * M2 scope and integration boundaries:
+ *  - All MMIO goes through K60IpaGsiCallbacks. The host test supplies byte
+ *    arrays; the kernel supplies ml_io_map_unmappable() views of the GSI
+ *    window (0x3e04000, 0xfc000 bytes) and the IPA register block
+ *    (0x3f40000, 0x20000 bytes).
+ *  - The caller owns both DMA blocks: a 1 MiB ring block and a 0x8000 table
+ *    block, both physically contiguous. In the kernel they come from
+ *    kmem_alloc_contig(); the ring must be 64 KiB aligned and the tables page
+ *    aligned. They stay owned until k60_ipa_gsi_stop().
+ *  - The SMMU context for those blocks is not programmed here. The caller
+ *    must establish the SID 0x5c0 mapping (K60IpaSmmu in the kernel) and pass
+ *    the resulting IOVAs. The 0x8000 table block is reserved for that
+ *    builder and is only zeroed by this module.
+ *  - Completion is polled from the event shadow at ring+0x18000. GSI IRQ 432
+ *    is neither installed nor acknowledged here; a later kernel glue layer
+ *    may use it to call k60_ipa_gsi_poll() sooner. Without that glue the
+ *    command path remains polled, matching Pong's conservative owner.
+ *  - No dynamic allocation and no C++: every buffer is caller supplied, so
+ *    the same code runs in the host test and in the kernel.
+ */
+
+#ifndef K60_IPA_GSI_H
+#define K60_IPA_GSI_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "pong_ipa.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define K60_IPA_GSI_RING_BYTES          0x00100000u
+#define K60_IPA_GSI_TABLE_BYTES         0x00008000u
+#define K60_IPA_GSI_RING_ALIGN          0x00010000u
+#define K60_IPA_GSI_PAGE_SIZE           0x00001000u
+#define K60_IPA_GSI_TRE_BYTES           16u
+#define K60_IPA_GSI_TRE_COUNT           256u
+#define K60_IPA_GSI_EVENT_OFFSET        0x00010000u
+#define K60_IPA_GSI_EVENT_BYTES         0x00001000u
+#define K60_IPA_GSI_EVENT_SHADOW_OFFSET 0x00018000u
+#define K60_IPA_GSI_PAYLOAD_OFFSET      0x00020000u
+#define K60_IPA_GSI_PAYLOAD_BYTES       32u
+#define K60_IPA_GSI_HEADER_OFFSET       0x00030000u
+#define K60_IPA_GSI_HEADER_BYTES        0x00010000u
+#define K60_IPA_GSI_TABLE_OFFSET        0x00040000u
+#define K60_IPA_GSI_TABLE_BLOCK_BYTES   0x00001000u
+#define K60_IPA_GSI_ENDPOINT            14u
+#define K60_IPA_GSI_ENDPOINT_OFFSET     (0x1000u + K60_IPA_GSI_ENDPOINT * 0x80u)
+#define K60_IPA_GSI_MAX_BATCH           8u
+#define K60_IPA_GSI_MAX_PAYLOAD         24u
+
+/* Extra negative status codes used below; the API also returns K60IpaOk,
+ * K60IpaBadArgument, K60IpaNotReady and K60IpaGsiBusy from K60Ipa.h. */
+enum {
+    K60IpaGsiNoDevice = -10,
+    K60IpaGsiNoMemory = -11,
+    K60IpaGsiInvalid = -12,
+    K60IpaGsiIoError = -13,
+    K60IpaGsiTimeout = -14,
+};
+
+typedef uint32_t (*K60IpaGsiRead32)(void *cookie, uint32_t offset);
+typedef void (*K60IpaGsiWrite32)(void *cookie, uint32_t offset, uint32_t value);
+typedef void (*K60IpaGsiDelayUs)(void *cookie, uint32_t microseconds);
+typedef uint64_t (*K60IpaGsiNowMs)(void *cookie);
+
+enum {
+    K60IpaGsiSyncClean = 1,
+    K60IpaGsiSyncInvalidate = 2,
+};
+
+/* Optional cache maintenance hook. "clean" publishes CPU-written ring,
+ * payload and table bytes to the device; "invalidate" makes device-written
+ * event pages visible to the CPU. NULL is allowed for coherent host tests. */
+typedef void (*K60IpaGsiSync)(void *cookie, const void *address, size_t bytes,
+    int direction);
+
+typedef struct {
+    K60IpaGsiRead32 read_gsi;
+    K60IpaGsiWrite32 write_gsi;
+    K60IpaGsiRead32 read_reg;
+    K60IpaGsiWrite32 write_reg;
+    K60IpaGsiDelayUs delay_us;
+    K60IpaGsiNowMs now_ms;
+    K60IpaGsiSync sync;
+    void *cookie;
+} K60IpaGsiCallbacks;
+
+typedef struct {
+    K60IpaGsiCallbacks callbacks;
+    uint8_t *ring;          /* 1 MiB contiguous DMA block, CPU view */
+    size_t ring_size;
+    uint64_t ring_iova;     /* SID 0x5c0 IOVA of ring, 64 KiB aligned */
+    uint8_t *tables;        /* 0x8000 SMMU table block, CPU view */
+    size_t tables_size;
+    uint64_t tables_iova;
+    uint32_t gsi_bytes;     /* size of the GSI window reachable by callbacks */
+} K60IpaGsiConfig;
+
+typedef struct {
+    K60IpaGsiConfig config;
+    K60IpaGsiCaps caps;
+    uint32_t stage;
+    uint32_t channels;
+    uint32_t events;
+    uint32_t channel_state;
+    uint32_t event_state;
+    uint32_t restricted;
+    uint32_t sram_bytes;
+    uint32_t producer;
+    uint32_t event_read;
+    uint32_t last_tre;
+    uint32_t last_event;
+    uint32_t completed_commands;
+    uint32_t failure_regs[8];
+    uint64_t deadline_ms;
+    int error;
+    int pending;
+    int initialized;
+} K60IpaGsi;
+
+/* Bind a caller-owned context to its callbacks and DMA blocks. This clears
+ * the 1 MiB ring and 0x8000 tables. It performs no MMIO. */
+int k60_ipa_gsi_init(K60IpaGsi *gsi, const K60IpaGsiConfig *config);
+
+/* Post-firmware capability check through the same callbacks. Unlike the
+ * pre-PAS k60_ipa_gsi_check() in K60Ipa.c, this expects EE0 to be enabled:
+ * status must not be all-ones, bit 0 must be set, there must be more than
+ * the command channel and at least one event, and command12/event0 must be
+ * unowned. */
+int k60_ipa_gsi_check_caps(K60IpaGsi *gsi, K60IpaGsiCaps *caps);
+
+/* Start EE0 ownership, event0 and command channel 12, program both ring
+ * contexts and IPA endpoint 14, then submit the first HDR_INIT_LOCAL command.
+ * Returns with stage 5 and one command pending; drive k60_ipa_gsi_poll(). */
+int k60_ipa_gsi_start(K60IpaGsi *gsi);
+
+/* Advance the staged IPA5.1 initialization and complete pending commands.
+ * Returns K60IpaOk when a step completed (or there was nothing to do),
+ * K60IpaNotReady while a command is still outstanding, or a negative error. */
+int k60_ipa_gsi_poll(K60IpaGsi *gsi);
+
+/* Submit one immediate command through command channel 12 (1..24 payload
+ * bytes; the slot itself is 32 bytes). Only one batch may be outstanding. */
+int k60_ipa_gsi_submit(K60IpaGsi *gsi, uint32_t opcode, const void *payload,
+    size_t payload_bytes);
+
+/* Reset command channel 12 if it was started and clear the local software
+ * state. Caller memory and its SMMU mapping remain owned by the caller. */
+int k60_ipa_gsi_stop(K60IpaGsi *gsi);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* K60_IPA_GSI_H */
diff --git a/bsd/dev/pong_ipa_gsi.c b/bsd/dev/pong_ipa_gsi.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_ipa_gsi.c
@@ -0,0 +1,829 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* K60 IPA GSI 3.0 command DMA owner, ported from PongModemIpaDma.h.
+ *
+ * The register offsets, command opcodes and staged IPA5.1 table geometry are
+ * hardware facts taken from the Pong baseband command-DMA owner. All MMIO is
+ * routed through K60IpaGsiCallbacks so the host test exercises this exact
+ * sequence without mapping anything. The SMMU mapping and GSI IRQ are
+ * deliberately left to the kernel glue; see K60IpaGsi.h.
+ */
+
+#include "pong_ipa_gsi.h"
+
+#ifdef K60_HOST_TEST
+#include <string.h>
+#else
+#include <sys/systm.h>
+#endif
+
+_Static_assert(K60_IPA_GSI_RING_BYTES == 0x100000u, "1 MiB ring block");
+_Static_assert(K60_IPA_GSI_TABLE_BYTES == 0x8000u, "0x8000 table block");
+_Static_assert(K60_IPA_GSI_TRE_BYTES * K60_IPA_GSI_TRE_COUNT == 0x1000u,
+    "256 16-byte TREs fill one event page");
+_Static_assert(K60_IPA_GSI_ENDPOINT_OFFSET == 0x1700u,
+    "IPA endpoint 14 lives at 0x1000 + 14 * 0x80");
+_Static_assert(K60_IPA_GSI_EVENT_OFFSET + K60_IPA_GSI_EVENT_BYTES <=
+    K60_IPA_GSI_EVENT_SHADOW_OFFSET, "event ring precedes its shadow");
+_Static_assert(K60_IPA_GSI_PAYLOAD_OFFSET >= K60_IPA_GSI_EVENT_SHADOW_OFFSET + 64u,
+    "payload slots follow the event shadow");
+_Static_assert(K60_IPA_GSI_HEADER_OFFSET + K60_IPA_GSI_HEADER_BYTES ==
+    K60_IPA_GSI_TABLE_OFFSET, "headers precede filter/route tables");
+_Static_assert(K60_IPA_GSI_TABLE_OFFSET + K60_IPA_GSI_TABLE_BLOCK_BYTES <=
+    K60_IPA_GSI_RING_BYTES, "filter/route tables fit the ring block");
+
+enum {
+    K60IpaGsiCmdAllocate = 0,
+    K60IpaGsiCmdStart = 1,
+    K60IpaGsiCmdReset = 2,
+};
+
+typedef struct {
+    uint16_t opcode;
+    uint8_t bytes;
+    uint8_t payload[K60_IPA_GSI_MAX_PAYLOAD];
+} K60IpaGsiImmediate;
+
+static uint32_t
+k60_ipa_gsi_read_gsi(const K60IpaGsi *gsi, uint32_t offset)
+{
+    const K60IpaGsiCallbacks *io = &gsi->config.callbacks;
+
+    return io->read_gsi(io->cookie, offset);
+}
+
+static void
+k60_ipa_gsi_write_gsi(K60IpaGsi *gsi, uint32_t offset, uint32_t value)
+{
+    const K60IpaGsiCallbacks *io = &gsi->config.callbacks;
+
+    io->write_gsi(io->cookie, offset, value);
+}
+
+static uint32_t
+k60_ipa_gsi_read_reg(const K60IpaGsi *gsi, uint32_t offset)
+{
+    const K60IpaGsiCallbacks *io = &gsi->config.callbacks;
+
+    return io->read_reg(io->cookie, offset);
+}
+
+static void
+k60_ipa_gsi_write_reg(K60IpaGsi *gsi, uint32_t offset, uint32_t value)
+{
+    const K60IpaGsiCallbacks *io = &gsi->config.callbacks;
+
+    io->write_reg(io->cookie, offset, value);
+}
+
+static void
+k60_ipa_gsi_sync(K60IpaGsi *gsi, const void *address, size_t bytes,
+    int direction)
+{
+    const K60IpaGsiCallbacks *io = &gsi->config.callbacks;
+
+    if (io->sync != NULL) {
+        io->sync(io->cookie, address, bytes, direction);
+    }
+}
+
+static uint64_t
+k60_ipa_gsi_now_ms(const K60IpaGsi *gsi)
+{
+    const K60IpaGsiCallbacks *io = &gsi->config.callbacks;
+
+    return io->now_ms(io->cookie);
+}
+
+static void
+k60_ipa_gsi_delay_us(const K60IpaGsi *gsi, uint32_t microseconds)
+{
+    const K60IpaGsiCallbacks *io = &gsi->config.callbacks;
+
+    io->delay_us(io->cookie, microseconds);
+}
+
+static void
+k60_ipa_gsi_le16(uint8_t *p, uint16_t value)
+{
+    p[0] = (uint8_t)value;
+    p[1] = (uint8_t)(value >> 8);
+}
+
+static void
+k60_ipa_gsi_le32(uint8_t *p, uint32_t value)
+{
+    k60_ipa_gsi_le16(p, (uint16_t)value);
+    k60_ipa_gsi_le16(p + 2, (uint16_t)(value >> 16));
+}
+
+static void
+k60_ipa_gsi_le64(uint8_t *p, uint64_t value)
+{
+    k60_ipa_gsi_le32(p, (uint32_t)value);
+    k60_ipa_gsi_le32(p + 4, (uint32_t)(value >> 32));
+}
+
+static uint32_t
+k60_ipa_gsi_from32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+        ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint64_t
+k60_ipa_gsi_from64(const uint8_t *p)
+{
+    return (uint64_t)k60_ipa_gsi_from32(p) |
+        ((uint64_t)k60_ipa_gsi_from32(p + 4) << 32);
+}
+
+static int
+k60_ipa_gsi_fail(K60IpaGsi *gsi, int error)
+{
+    if (gsi->error == K60IpaOk) {
+        gsi->error = error;
+    }
+    return error;
+}
+
+int
+k60_ipa_gsi_init(K60IpaGsi *gsi, const K60IpaGsiConfig *config)
+{
+    if (gsi == NULL || config == NULL) {
+        return K60IpaBadArgument;
+    }
+    if (config->callbacks.read_gsi == NULL || config->callbacks.write_gsi == NULL ||
+        config->callbacks.read_reg == NULL || config->callbacks.write_reg == NULL ||
+        config->callbacks.delay_us == NULL || config->callbacks.now_ms == NULL) {
+        return K60IpaBadArgument;
+    }
+    if (config->ring == NULL || config->ring_size < K60_IPA_GSI_RING_BYTES ||
+        config->tables == NULL || config->tables_size < K60_IPA_GSI_TABLE_BYTES) {
+        return K60IpaBadArgument;
+    }
+    if (((uintptr_t)config->ring & (K60_IPA_GSI_RING_ALIGN - 1u)) != 0 ||
+        ((uintptr_t)config->tables & (K60_IPA_GSI_PAGE_SIZE - 1u)) != 0) {
+        return K60IpaBadArgument;
+    }
+    if (config->ring_iova == 0 || config->tables_iova == 0 ||
+        (config->ring_iova & (K60_IPA_GSI_RING_ALIGN - 1u)) != 0 ||
+        (config->tables_iova & (K60_IPA_GSI_PAGE_SIZE - 1u)) != 0) {
+        return K60IpaBadArgument;
+    }
+    if (config->gsi_bytes < K60_GSI_EVENT_BASE + 4u) {
+        return K60IpaBadArgument;
+    }
+
+    memset(gsi, 0, sizeof(*gsi));
+    gsi->config = *config;
+    if (gsi->config.gsi_bytes == 0) {
+        gsi->config.gsi_bytes = K60_GSI_BYTES;
+    }
+    memset(gsi->config.ring, 0, K60_IPA_GSI_RING_BYTES);
+    memset(gsi->config.tables, 0, K60_IPA_GSI_TABLE_BYTES);
+    k60_ipa_gsi_sync(gsi, gsi->config.ring, K60_IPA_GSI_RING_BYTES,
+        K60IpaGsiSyncClean);
+    k60_ipa_gsi_sync(gsi, gsi->config.tables, K60_IPA_GSI_TABLE_BYTES,
+        K60IpaGsiSyncClean);
+    gsi->initialized = 1;
+    return K60IpaOk;
+}
+
+int
+k60_ipa_gsi_check_caps(K60IpaGsi *gsi, K60IpaGsiCaps *caps)
+{
+    uint32_t command_offset;
+    uint32_t event_offset;
+
+    if (gsi == NULL || caps == NULL || !gsi->initialized) {
+        return K60IpaBadArgument;
+    }
+    if (gsi->config.gsi_bytes <= K60_GSI_STATUS_OFFSET) {
+        return K60IpaBadArgument;
+    }
+    command_offset = K60_GSI_CHANNEL_BASE +
+        K60_GSI_COMMAND_CHANNEL * K60_GSI_CHANNEL_STRIDE;
+    event_offset = K60_GSI_EVENT_BASE + K60_GSI_EVENT0 * 0x80u;
+    if (gsi->config.gsi_bytes <= command_offset + 4u ||
+        gsi->config.gsi_bytes <= event_offset + 4u) {
+        return K60IpaBadArgument;
+    }
+
+    caps->status = k60_ipa_gsi_read_gsi(gsi, K60_GSI_STATUS_OFFSET);
+    caps->channels = k60_ipa_gsi_read_gsi(gsi, K60_GSI_CHANNELS_OFFSET);
+    caps->events = k60_ipa_gsi_read_gsi(gsi, K60_GSI_EVENTS_OFFSET);
+    caps->command_state =
+        (k60_ipa_gsi_read_gsi(gsi, command_offset) >> 20) & 0xfu;
+    caps->event_state =
+        (k60_ipa_gsi_read_gsi(gsi, event_offset) >> 20) & 0xfu;
+
+    /* This is the post-firmware check: PAS AUTH_AND_RESET leaves EE0
+     * enabled, so bit 0 must be set. The pre-PAS k60_ipa_gsi_check() in
+     * K60Ipa.c rejects an enabled EE0 because another owner holds it. */
+    if (caps->status == 0xffffffffu || (caps->status & 1u) == 0) {
+        return K60IpaGsiNoDevice;
+    }
+    if (caps->channels <= K60_GSI_COMMAND_CHANNEL || caps->events == 0) {
+        return K60IpaNotReady;
+    }
+    if (caps->command_state != 0 || caps->event_state != 0) {
+        return K60IpaGsiBusy;
+    }
+    return K60IpaOk;
+}
+
+static int
+k60_ipa_gsi_owned_events(K60IpaGsi *gsi, uint32_t events)
+{
+    uint32_t value;
+
+    /* Native gsi_register_device arms the EE-local interrupt types before
+     * ALLOCATE. A polled owner still has to arm and acknowledge its actual
+     * sources; masking the GIC line is not a substitute for configuring the
+     * GSI completion engine. Never clear foreign rings. */
+    k60_ipa_gsi_write_gsi(gsi, 0x25220u, 1u);
+    value = k60_ipa_gsi_read_gsi(gsi, 0x25088u);
+    k60_ipa_gsi_write_gsi(gsi, 0x25088u, value | 0x4cu);
+    value = k60_ipa_gsi_read_gsi(gsi, 0x25204u);
+    k60_ipa_gsi_write_gsi(gsi, 0x25204u, value | 1u);
+    value = k60_ipa_gsi_read_gsi(gsi, 0x25210u);
+    k60_ipa_gsi_write_gsi(gsi, 0x25210u, value | 0xeu);
+    value = k60_ipa_gsi_read_gsi(gsi, 0x250acu);
+    k60_ipa_gsi_write_gsi(gsi, 0x250acu, value | events);
+
+    if (k60_ipa_gsi_read_gsi(gsi, 0x25220u) != 1u ||
+        (k60_ipa_gsi_read_gsi(gsi, 0x25088u) & 0x4cu) != 0x4cu ||
+        (k60_ipa_gsi_read_gsi(gsi, 0x25204u) & 1u) == 0 ||
+        (k60_ipa_gsi_read_gsi(gsi, 0x25210u) & 0xeu) != 0xeu ||
+        (k60_ipa_gsi_read_gsi(gsi, 0x250acu) & events) != events) {
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+    }
+    return K60IpaOk;
+}
+
+static int
+k60_ipa_gsi_command(K60IpaGsi *gsi, int event, uint32_t id, uint32_t opcode,
+    uint32_t expected)
+{
+    uint32_t offset;
+    uint32_t source;
+    uint32_t mask;
+    uint32_t clear;
+    uint32_t bit;
+    uint32_t old_mask;
+    uint32_t old_type;
+    uint32_t type;
+    uint32_t actual = 0;
+    uint64_t end;
+    int done = 0;
+
+    if (gsi == NULL || id >= 32u || opcode > 0xffu) {
+        return K60IpaGsiInvalid;
+    }
+    offset = event != 0 ? K60_GSI_EVENT_BASE + id * 0x80u :
+        K60_GSI_CHANNEL_BASE + id * K60_GSI_CHANNEL_STRIDE;
+    if (opcode == K60IpaGsiCmdAllocate &&
+        ((k60_ipa_gsi_read_gsi(gsi, offset) >> 20) & 0xfu) != 0) {
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiBusy);
+    }
+    /* Mirror the native command-control acknowledgement even though this
+     * owner polls. Clear and mask only this allocated resource; stale
+     * mailbox bits must not survive ALLOCATE -> START. */
+    source = event != 0 ? 0x2509cu : 0x25090u;
+    mask = event != 0 ? 0x250a0u : 0x25094u;
+    clear = event != 0 ? 0x250a4u : 0x25098u;
+    bit = 1u << id;
+    old_mask = k60_ipa_gsi_read_gsi(gsi, mask);
+    old_type = k60_ipa_gsi_read_gsi(gsi, 0x25088u);
+    type = event != 0 ? 2u : 1u;
+    k60_ipa_gsi_write_gsi(gsi, clear, bit);
+    k60_ipa_gsi_write_gsi(gsi, mask, old_mask | bit);
+    k60_ipa_gsi_write_gsi(gsi, 0x25088u, old_type | type);
+    k60_ipa_gsi_write_gsi(gsi, event != 0 ? 0x25010u : 0x25008u,
+        id | (opcode << 24));
+
+    end = k60_ipa_gsi_now_ms(gsi) + 50u;
+    do {
+        actual = (k60_ipa_gsi_read_gsi(gsi, offset) >> 20) & 0xfu;
+        if (actual == expected) {
+            if (event == 0) {
+                gsi->channel_state = actual;
+            }
+            done = 1;
+            break;
+        }
+        if (actual == 15u) {
+            break;
+        }
+        k60_ipa_gsi_delay_us(gsi, 10u);
+    } while (k60_ipa_gsi_now_ms(gsi) < end);
+
+    if ((k60_ipa_gsi_read_gsi(gsi, source) & bit) != 0) {
+        k60_ipa_gsi_write_gsi(gsi, clear, bit);
+    }
+    k60_ipa_gsi_write_gsi(gsi, mask, old_mask);
+    k60_ipa_gsi_write_gsi(gsi, 0x25088u, old_type);
+    if (!done) {
+        return k60_ipa_gsi_fail(gsi,
+            actual == 15u ? K60IpaGsiIoError : K60IpaGsiTimeout);
+    }
+    return K60IpaOk;
+}
+
+static int
+k60_ipa_gsi_submit_batch(K60IpaGsi *gsi, const K60IpaGsiImmediate *commands,
+    uint32_t count)
+{
+    uint32_t i;
+
+    if (gsi == NULL || commands == NULL) {
+        return K60IpaBadArgument;
+    }
+    if (gsi->pending) {
+        return K60IpaGsiBusy;
+    }
+    if (count == 0 || count > K60_IPA_GSI_MAX_BATCH) {
+        return K60IpaBadArgument;
+    }
+    if (gsi->stage < 4u) {
+        return K60IpaNotReady;
+    }
+    if (gsi->error != K60IpaOk) {
+        return gsi->error;
+    }
+
+    for (i = 0; i < count; i++) {
+        uint32_t index = (gsi->producer + i) & (K60_IPA_GSI_TRE_COUNT - 1u);
+        uint8_t *payload = gsi->config.ring + K60_IPA_GSI_PAYLOAD_OFFSET +
+            index * K60_IPA_GSI_PAYLOAD_BYTES;
+        uint8_t *tre = gsi->config.ring + index * K60_IPA_GSI_TRE_BYTES;
+
+        if (commands[i].bytes == 0 ||
+            commands[i].bytes > K60_IPA_GSI_MAX_PAYLOAD) {
+            return k60_ipa_gsi_fail(gsi, K60IpaGsiInvalid);
+        }
+        memset(payload, 0, K60_IPA_GSI_PAYLOAD_BYTES);
+        memcpy(payload, commands[i].payload, commands[i].bytes);
+        memset(tre, 0, K60_IPA_GSI_TRE_BYTES);
+        k60_ipa_gsi_le64(tre, gsi->config.ring_iova +
+            K60_IPA_GSI_PAYLOAD_OFFSET + index * K60_IPA_GSI_PAYLOAD_BYTES);
+        k60_ipa_gsi_le16(tre + 8, commands[i].opcode);
+        k60_ipa_gsi_le32(tre + 12, (3u << 16) |
+            (i + 1u == count ? 0x600u : 1u));
+        k60_ipa_gsi_sync(gsi, payload, K60_IPA_GSI_PAYLOAD_BYTES,
+            K60IpaGsiSyncClean);
+        k60_ipa_gsi_sync(gsi, tre, K60_IPA_GSI_TRE_BYTES,
+            K60IpaGsiSyncClean);
+    }
+    gsi->last_tre = (gsi->producer + count - 1u) &
+        (K60_IPA_GSI_TRE_COUNT - 1u);
+    gsi->producer = (gsi->producer + count) &
+        (K60_IPA_GSI_TRE_COUNT - 1u);
+    gsi->pending = 1;
+    gsi->deadline_ms = k60_ipa_gsi_now_ms(gsi) + 1000u;
+    k60_ipa_gsi_write_gsi(gsi, 0x24000u + 12u * 8u + 4u, 0u);
+    k60_ipa_gsi_write_gsi(gsi, 0x24000u + 12u * 8u,
+        (uint32_t)(gsi->config.ring_iova +
+            (uint64_t)gsi->producer * K60_IPA_GSI_TRE_BYTES));
+    return K60IpaOk;
+}
+
+int
+k60_ipa_gsi_submit(K60IpaGsi *gsi, uint32_t opcode, const void *payload,
+    size_t payload_bytes)
+{
+    K60IpaGsiImmediate command;
+
+    if (gsi == NULL || payload == NULL || payload_bytes == 0 ||
+        payload_bytes > K60_IPA_GSI_MAX_PAYLOAD) {
+        return K60IpaBadArgument;
+    }
+    memset(&command, 0, sizeof(command));
+    command.opcode = (uint16_t)opcode;
+    command.bytes = (uint8_t)payload_bytes;
+    memcpy(command.payload, payload, payload_bytes);
+    return k60_ipa_gsi_submit_batch(gsi, &command, 1u);
+}
+
+static int
+k60_ipa_gsi_poll_owned_events(K60IpaGsi *gsi, uint32_t events)
+{
+    uint32_t global;
+    uint32_t general;
+    uint32_t pending;
+
+    global = k60_ipa_gsi_read_gsi(gsi, 0x25200u);
+    general = k60_ipa_gsi_read_gsi(gsi, 0x2520cu);
+    if ((global & 1u) != 0 || (general & 0xeu) != 0) {
+        gsi->failure_regs[5] = k60_ipa_gsi_read_gsi(gsi, 0x25240u);
+        gsi->failure_regs[6] = global;
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+    }
+    pending = k60_ipa_gsi_read_gsi(gsi, 0x250a8u) & events;
+    if (pending != 0) {
+        k60_ipa_gsi_write_gsi(gsi, 0x250b0u, pending);
+    }
+    return K60IpaOk;
+}
+
+static int
+k60_ipa_gsi_completion(K60IpaGsi *gsi)
+{
+    uint64_t pointer;
+    uint64_t base;
+    uint32_t index;
+    uint32_t visited = 0;
+    int done = 0;
+
+    if (k60_ipa_gsi_poll_owned_events(gsi, 1u) != K60IpaOk) {
+        return gsi->error;
+    }
+    /* The firmware writes the owned event shadow when it generates an
+     * event. MMIO context snapshots alone are not enough for the GSI3.0
+     * producer pointer. */
+    k60_ipa_gsi_sync(gsi, gsi->config.ring + K60_IPA_GSI_EVENT_SHADOW_OFFSET,
+        64u, K60IpaGsiSyncInvalidate);
+    pointer = k60_ipa_gsi_from64(gsi->config.ring +
+        K60_IPA_GSI_EVENT_SHADOW_OFFSET);
+    base = gsi->config.ring_iova + K60_IPA_GSI_EVENT_OFFSET;
+    if (pointer < base || pointer >= base + K60_IPA_GSI_EVENT_BYTES ||
+        ((pointer - base) & (K60_IPA_GSI_TRE_BYTES - 1u)) != 0) {
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+    }
+    index = (uint32_t)((pointer - base) / K60_IPA_GSI_TRE_BYTES);
+    while (gsi->event_read != index && visited++ < K60_IPA_GSI_TRE_COUNT) {
+        const uint8_t *event = gsi->config.ring + K60_IPA_GSI_EVENT_OFFSET +
+            gsi->event_read * K60_IPA_GSI_TRE_BYTES;
+        uint64_t tre;
+        uint32_t event_status;
+
+        /* Event pages were cleaned before GSI took ownership; the CPU
+         * never writes them after that handoff, so invalidate only. */
+        k60_ipa_gsi_sync(gsi, event, K60_IPA_GSI_TRE_BYTES,
+            K60IpaGsiSyncInvalidate);
+        tre = k60_ipa_gsi_from64(event);
+        event_status = event[11];
+        gsi->last_event = event_status;
+        if (event[15] != K60_GSI_COMMAND_CHANNEL ||
+            tre < gsi->config.ring_iova ||
+            tre >= gsi->config.ring_iova + K60_IPA_GSI_EVENT_BYTES ||
+            ((tre - gsi->config.ring_iova) & (K60_IPA_GSI_TRE_BYTES - 1u)) != 0) {
+            return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+        }
+        if (event_status != 1u && event_status != 2u) {
+            return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+        }
+        if ((uint32_t)((tre - gsi->config.ring_iova) /
+            K60_IPA_GSI_TRE_BYTES) == gsi->last_tre) {
+            done = 1;
+        }
+        gsi->event_read = (gsi->event_read + 1u) &
+            (K60_IPA_GSI_TRE_COUNT - 1u);
+    }
+    if (visited != 0) {
+        k60_ipa_gsi_write_gsi(gsi, 0x24804u, 0u);
+        k60_ipa_gsi_write_gsi(gsi, 0x24800u,
+            (uint32_t)(base + ((gsi->event_read + K60_IPA_GSI_TRE_COUNT - 1u) &
+            (K60_IPA_GSI_TRE_COUNT - 1u)) * K60_IPA_GSI_TRE_BYTES));
+    }
+    if (done) {
+        gsi->pending = 0;
+        gsi->completed_commands++;
+        return K60IpaOk;
+    }
+    if (k60_ipa_gsi_now_ms(gsi) >= gsi->deadline_ms) {
+        uint32_t channel = K60_GSI_CHANNEL_BASE +
+            K60_GSI_COMMAND_CHANNEL * K60_GSI_CHANNEL_STRIDE;
+
+        gsi->failure_regs[0] = k60_ipa_gsi_read_gsi(gsi, channel + 16u);
+        gsi->failure_regs[1] = k60_ipa_gsi_read_gsi(gsi, channel + 24u);
+        gsi->failure_regs[2] = k60_ipa_gsi_read_gsi(gsi, channel + 0x40u);
+        gsi->failure_regs[3] = k60_ipa_gsi_read_gsi(gsi, channel + 0x44u);
+        gsi->failure_regs[4] = k60_ipa_gsi_read_gsi(gsi, channel + 0x48u);
+        gsi->failure_regs[7] = k60_ipa_gsi_read_gsi(gsi, 0x1c000u + 16u);
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiTimeout);
+    }
+    return K60IpaNotReady;
+}
+
+static int
+k60_ipa_gsi_init_headers(K60IpaGsi *gsi)
+{
+    static const uint32_t guarded[] = {
+        0x1288u, 0x1308u, 0x1388u, 0x1408u, 0x1488u, 0x1528u,
+        0x15c8u, 0x1668u, 0x1708u, 0x1b40u, 0x3898u, 0x4ee8u,
+    };
+    K60IpaGsiImmediate header;
+    uint32_t geometry;
+    uint32_t i;
+    uint32_t back;
+
+    geometry = k60_ipa_gsi_read_reg(gsi, 0x40u);
+    gsi->restricted = (geometry >> 16) * 8u;
+    gsi->sram_bytes = (geometry & 0xffffu) * 8u;
+    /* Cold boot, before INIT_DRIVER transfers SRAM ownership to MPSS.
+     * Native ipa_setup_apps_pipes starts with HDR_INIT_LOCAL; there is no
+     * invented HPS pipeline-clear wait before the tables exist. */
+    if (gsi->sram_bytes < 0x5000u ||
+        gsi->restricted > 0xffffu - 0x5000u) {
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiNoDevice);
+    }
+    /* Match _ipa_init_sram_v3 on IPA5.1: two 4-byte canaries immediately
+     * before each shared table/header/context, modem memory and PDN region.
+     * Do not write the uC shared area at 0x1000. */
+    for (i = 0; i < sizeof(guarded) / sizeof(guarded[0]); i++) {
+        for (back = 4u; back <= 8u; back += 4u) {
+            uint32_t address = 0x10000u + gsi->restricted + guarded[i] - back;
+
+            k60_ipa_gsi_write_reg(gsi, address, 0xdeadbeefu);
+            if (k60_ipa_gsi_read_reg(gsi, address) != 0xdeadbeefu) {
+                return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+            }
+        }
+    }
+
+    memset(gsi->config.ring + K60_IPA_GSI_HEADER_OFFSET, 0,
+        K60_IPA_GSI_HEADER_BYTES);
+    k60_ipa_gsi_sync(gsi, gsi->config.ring + K60_IPA_GSI_HEADER_OFFSET,
+        K60_IPA_GSI_HEADER_BYTES, K60IpaGsiSyncClean);
+    memset(&header, 0, sizeof(header));
+    header.opcode = 9u;
+    header.bytes = 16u;
+    k60_ipa_gsi_le64(header.payload, gsi->config.ring_iova +
+        K60_IPA_GSI_HEADER_OFFSET);
+    k60_ipa_gsi_le32(header.payload + 8, 0x420u |
+        ((gsi->restricted + 0x1708u) << 12));
+    if (k60_ipa_gsi_submit_batch(gsi, &header, 1u) != K60IpaOk) {
+        return gsi->error;
+    }
+    gsi->stage = 5u;
+    return K60IpaOk;
+}
+
+static int
+k60_ipa_gsi_init_contexts(K60IpaGsi *gsi)
+{
+    static const uint32_t offsets[] = { 0x1b40u, 0x3898u, 0x2868u, 0x4ee8u };
+    static const uint32_t sizes[] = { 0xd20u, 0xd48u, 0xa48u, 0x118u };
+    K60IpaGsiImmediate commands[4];
+    uint32_t i;
+
+    memset(commands, 0, sizeof(commands));
+    for (i = 0; i < 4u; i++) {
+        commands[i].opcode = 0x13u;
+        commands[i].bytes = 16u;
+        k60_ipa_gsi_le16(commands[i].payload + 2, (uint16_t)sizes[i]);
+        k60_ipa_gsi_le16(commands[i].payload + 4,
+            (uint16_t)(gsi->restricted + offsets[i]));
+        k60_ipa_gsi_le64(commands[i].payload + 8, gsi->config.ring_iova +
+            K60_IPA_GSI_HEADER_OFFSET);
+    }
+    if (k60_ipa_gsi_submit_batch(gsi, commands, 4u) != K60IpaOk) {
+        return gsi->error;
+    }
+    gsi->stage = 7u;
+    return K60IpaOk;
+}
+
+static int
+k60_ipa_gsi_init_tables(K60IpaGsi *gsi)
+{
+    static const uint32_t opcodes[] = { 3u, 4u, 7u, 8u };
+    static const uint32_t hash[] = { 0x1288u, 0x1388u, 0x1488u, 0x15c8u };
+    static const uint32_t plain[] = { 0x1308u, 0x1408u, 0x1528u, 0x1668u };
+    const uint64_t empty_table = (K60_IPA_GSI_TABLE_BLOCK_BYTES / 8u) * 128u + 1u;
+    uint8_t *filter;
+    uint8_t *route;
+    uint64_t bitmap;
+    K60IpaGsiImmediate commands[4];
+    uint32_t i;
+
+    /* NothingOSS ipahal_{rt,flt}_generate_empty_img uses local SRAM on
+     * IPA5.1. Local encoding is (byte_offset / 8) * 128 + 1. */
+    filter = gsi->config.ring + K60_IPA_GSI_TABLE_OFFSET + 0x100u;
+    route = gsi->config.ring + K60_IPA_GSI_TABLE_OFFSET + 0x200u;
+    memset(gsi->config.ring + K60_IPA_GSI_TABLE_OFFSET, 0,
+        K60_IPA_GSI_TABLE_BLOCK_BYTES);
+    bitmap = (1ull << 1) | (1ull << 2) | (1ull << 5) | (1ull << 6) |
+        (1ull << 7) | (1ull << 10) | (1ull << 12) | (1ull << 15);
+    k60_ipa_gsi_le64(filter, bitmap);
+    for (i = 0; i < 8u; i++) {
+        k60_ipa_gsi_le64(filter + 8u + i * 8u, empty_table);
+    }
+    for (i = 0; i < 19u; i++) {
+        k60_ipa_gsi_le64(route + i * 8u, empty_table);
+    }
+    k60_ipa_gsi_sync(gsi, gsi->config.ring + K60_IPA_GSI_TABLE_OFFSET,
+        K60_IPA_GSI_TABLE_BLOCK_BYTES, K60IpaGsiSyncClean);
+
+    memset(commands, 0, sizeof(commands));
+    for (i = 0; i < 4u; i++) {
+        uint32_t size = i < 2u ? 72u : 152u;
+        uint64_t address = gsi->config.ring_iova + K60_IPA_GSI_TABLE_OFFSET +
+            (i < 2u ? 0x100u : 0x200u);
+        uint64_t fields;
+
+        commands[i].opcode = (uint16_t)opcodes[i];
+        commands[i].bytes = 24u;
+        k60_ipa_gsi_le64(commands[i].payload, address);
+        fields = (uint64_t)size |
+            ((uint64_t)(gsi->restricted + hash[i]) << 12) |
+            ((uint64_t)size << 28) |
+            ((uint64_t)(gsi->restricted + plain[i]) << 40);
+        k60_ipa_gsi_le64(commands[i].payload + 8, fields);
+        k60_ipa_gsi_le64(commands[i].payload + 16, address);
+    }
+    if (k60_ipa_gsi_submit_batch(gsi, commands, 4u) != K60IpaOk) {
+        return gsi->error;
+    }
+    gsi->stage = 9u;
+    return K60IpaOk;
+}
+
+int
+k60_ipa_gsi_start(K60IpaGsi *gsi)
+{
+    K60IpaGsiCaps caps;
+    uint64_t event_iova;
+    uint64_t channel_iova;
+    uint32_t endpoint;
+    uint32_t channel;
+    uint32_t value;
+    uint32_t offset;
+    int rc;
+
+    if (gsi == NULL || !gsi->initialized) {
+        return K60IpaBadArgument;
+    }
+    if (gsi->stage != 0u) {
+        return K60IpaGsiBusy;
+    }
+    gsi->stage = 1u;
+    gsi->error = K60IpaOk;
+
+    rc = k60_ipa_gsi_check_caps(gsi, &caps);
+    if (rc != K60IpaOk) {
+        return k60_ipa_gsi_fail(gsi, rc);
+    }
+    gsi->caps = caps;
+    gsi->channels = caps.channels;
+    gsi->events = caps.events;
+    gsi->event_state = caps.event_state;
+
+    rc = k60_ipa_gsi_owned_events(gsi, 1u);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+    /* Event0 and command channel 12 are real EE0 allocations; context
+     * fields follow GSI3.0, with ERINDEX in CNTXT1 rather than older CNTXT0. */
+    rc = k60_ipa_gsi_command(gsi, 1, K60_GSI_EVENT0, K60IpaGsiCmdAllocate, 1u);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+
+    event_iova = gsi->config.ring_iova + K60_IPA_GSI_EVENT_OFFSET;
+    k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE,
+        (16u << 24) | (1u << 7) | 2u);
+    k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE + 4u, 4096u);
+    k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE + 8u,
+        (uint32_t)event_iova);
+    k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE + 12u,
+        (uint32_t)(event_iova >> 32));
+    for (offset = 32u; offset <= 52u; offset += 4u) {
+        k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE + offset, 0u);
+    }
+    /* Original ipa_dp.c: non-NAPI command ring count 1, 16 cycles of the
+     * 32 kHz moderation clock. Zero/zero moderation is not the Pong policy. */
+    k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE + 32u, (1u << 16) | 16u);
+    k60_ipa_gsi_le64(gsi->config.ring + K60_IPA_GSI_EVENT_SHADOW_OFFSET,
+        event_iova);
+    k60_ipa_gsi_sync(gsi, gsi->config.ring + K60_IPA_GSI_EVENT_SHADOW_OFFSET,
+        64u, K60IpaGsiSyncClean);
+    k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE + 48u,
+        (uint32_t)(gsi->config.ring_iova + K60_IPA_GSI_EVENT_SHADOW_OFFSET));
+    k60_ipa_gsi_write_gsi(gsi, K60_GSI_EVENT_BASE + 52u,
+        (uint32_t)((gsi->config.ring_iova + K60_IPA_GSI_EVENT_SHADOW_OFFSET) >> 32));
+    value = k60_ipa_gsi_read_gsi(gsi, K60_GSI_EVENT_BASE + 4u);
+    if (value != 4096u ||
+        k60_ipa_gsi_read_gsi(gsi, K60_GSI_EVENT_BASE + 8u) !=
+        (uint32_t)event_iova) {
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+    }
+    k60_ipa_gsi_write_gsi(gsi, 0x24804u, 0u);
+    k60_ipa_gsi_write_gsi(gsi, 0x24800u,
+        (uint32_t)(event_iova + K60_IPA_GSI_EVENT_BYTES -
+        K60_IPA_GSI_TRE_BYTES));
+
+    rc = k60_ipa_gsi_command(gsi, 0, K60_GSI_COMMAND_CHANNEL,
+        K60IpaGsiCmdAllocate, 1u);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+    channel = K60_GSI_CHANNEL_BASE +
+        K60_GSI_COMMAND_CHANNEL * K60_GSI_CHANNEL_STRIDE;
+    channel_iova = gsi->config.ring_iova;
+    k60_ipa_gsi_write_gsi(gsi, channel, (16u << 24) | (1u << 7) | 2u);
+    k60_ipa_gsi_write_gsi(gsi, channel + 4u, 4096u);
+    k60_ipa_gsi_write_gsi(gsi, channel + 8u, (uint32_t)channel_iova);
+    k60_ipa_gsi_write_gsi(gsi, channel + 12u, (uint32_t)(channel_iova >> 32));
+    /* GSI3.0 moved QOS from the older +0x5c to +0x48; +0x5c is scratch4.
+     * bit24 makes the doorbell address-valued, and low_weight=15 matches
+     * the command channel's native policy. */
+    value = (1u << 24) | (1u << 10) | (24u << 16) | 15u;
+    k60_ipa_gsi_write_gsi(gsi, channel + 0x48u, value);
+    for (offset = 0x4cu; offset <= 0x70u; offset += 4u) {
+        k60_ipa_gsi_write_gsi(gsi, channel + offset, 0u);
+    }
+    if (k60_ipa_gsi_read_gsi(gsi, channel + 0x48u) != value ||
+        k60_ipa_gsi_read_gsi(gsi, channel + 4u) != 4096u ||
+        k60_ipa_gsi_read_gsi(gsi, channel + 8u) != (uint32_t)channel_iova) {
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+    }
+    gsi->stage = 3u;
+
+    /* Prepare the real IPA command endpoint 14 in DMA-only mode to LAN
+     * consumer 16; no WAN/RX channel is started or published here. */
+    endpoint = K60_IPA_GSI_ENDPOINT_OFFSET;
+    k60_ipa_gsi_write_reg(gsi, endpoint + 8u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 12u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 16u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 20u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 32u, 3u | (16u << 4));
+    k60_ipa_gsi_write_reg(gsi, endpoint + 36u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 52u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 56u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 60u, 0u);
+    k60_ipa_gsi_write_reg(gsi, endpoint + 64u, 0u);
+    if (k60_ipa_gsi_read_reg(gsi, endpoint + 32u) != (3u | (16u << 4))) {
+        return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+    }
+    k60_ipa_gsi_write_gsi(gsi, 0x25220u, 1u);
+    rc = k60_ipa_gsi_command(gsi, 0, K60_GSI_COMMAND_CHANNEL,
+        K60IpaGsiCmdStart, 2u);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+    gsi->stage = 4u;
+    return k60_ipa_gsi_init_headers(gsi);
+}
+
+int
+k60_ipa_gsi_poll(K60IpaGsi *gsi)
+{
+    uint32_t expected;
+    int rc;
+
+    if (gsi == NULL || !gsi->initialized) {
+        return K60IpaBadArgument;
+    }
+    if (gsi->error != K60IpaOk) {
+        return gsi->error;
+    }
+    if (gsi->stage < 4u || !gsi->pending) {
+        return K60IpaOk;
+    }
+    rc = k60_ipa_gsi_completion(gsi);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+    if (gsi->stage == 5u) {
+        gsi->stage = 6u;
+        return k60_ipa_gsi_init_contexts(gsi);
+    }
+    if (gsi->stage == 7u) {
+        gsi->stage = 8u;
+        expected = gsi->restricted + 0x1b40u;
+        k60_ipa_gsi_write_reg(gsi, 0x478u, expected);
+        if (k60_ipa_gsi_read_reg(gsi, 0x478u) != expected) {
+            return k60_ipa_gsi_fail(gsi, K60IpaGsiIoError);
+        }
+        return k60_ipa_gsi_init_tables(gsi);
+    }
+    if (gsi->stage == 9u) {
+        gsi->stage = 10u;
+    }
+    return K60IpaOk;
+}
+
+int
+k60_ipa_gsi_stop(K60IpaGsi *gsi)
+{
+    int rc = K60IpaOk;
+
+    if (gsi == NULL || !gsi->initialized) {
+        return K60IpaBadArgument;
+    }
+    if (gsi->stage >= 4u && gsi->error == K60IpaOk) {
+        rc = k60_ipa_gsi_command(gsi, 0, K60_GSI_COMMAND_CHANNEL,
+            K60IpaGsiCmdReset, 0u);
+    }
+    gsi->pending = 0;
+    gsi->stage = 0u;
+    gsi->producer = 0u;
+    gsi->event_read = 0u;
+    gsi->last_tre = 0u;
+    gsi->last_event = 0u;
+    gsi->deadline_ms = 0u;
+    gsi->error = K60IpaOk;
+    return rc;
+}
diff --git a/bsd/dev/pong_ipa_smmu.h b/bsd/dev/pong_ipa_smmu.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_ipa_smmu.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* K60 IPA SMMU stream planner and configuration.
+ *
+ * C port of drivers/NativeUfs/SmmuTakeover.h (BSD-2-Clause-Patent):
+ * planUfsSmmuBank -> k60_ipa_smmu_bank(), planUfsSmmu -> k60_ipa_smmu_plan(),
+ * configureUfsSmmu -> k60_ipa_smmu_configure(), ufsSmmuAddressBits ->
+ * k60_ipa_smmu_address_bits().
+ *
+ * The register model is ARM SMMUv2 (IHI 0062D.c sections 1.6 and 3.7) as
+ * exposed by the K60 qcom,qsmmu-v500 instance: IDR0/IDR1/IDR2 at
+ * 0x20/0x24/0x28, SMR at 0x800 + 4*i, S2CR at 0xc00 + 4*i, SCTLR at
+ * (pages + bank) * 4096, CBAR at 0x1000 + 4*bank, CBA2R at 0x1800 + 4*bank.
+ *
+ * IPA stream 0x5c0 uses Iova 0x20000000, a 1 MiB ring and 32 KiB of
+ * ArmSmmu4K tables with ownedBanks 78 and ownedGroups 120. Planning is
+ * read-only; the caller must quiesce the IPA queue, own the SMMU mapping
+ * and keep an MMIO barrier in the write callback before calling configure.
+ */
+
+#ifndef K60_IPA_SMMU_H
+#define K60_IPA_SMMU_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Register accessors: offset is a byte offset in the owned SMMU mapping.
+ * The read callback returns the 32-bit register value. The write callback
+ * must complete an MMIO barrier before it returns.
+ */
+typedef uint32_t (*K60IpaSmmuRead)(void *context, unsigned offset);
+typedef void (*K60IpaSmmuWrite)(void *context, unsigned offset, uint32_t value);
+
+typedef struct {
+    unsigned slot;
+    unsigned bank;
+    unsigned pages;
+    uint32_t smr;
+    uint32_t s2cr;
+    unsigned previous_bank;
+    int reuse;
+    int migrate;
+    const char *error;
+} K60IpaSmmuPlan;
+
+enum {
+    K60IpaSmmuOk = 0,
+    K60IpaSmmuBadArgument = -1,
+    K60IpaSmmuUnsupported = -2,
+    K60IpaSmmuReadback = -3
+};
+
+/* Plan a context bank and stream-match slot for one IPA stream. Returns 0 on
+ * success; on refusal returns K60IpaSmmuUnsupported and leaves plan->error
+ * pointing at a static reason string. plan must not be NULL. */
+int k60_ipa_smmu_plan(K60IpaSmmuPlan *plan, uint16_t stream, uint64_t dma,
+    uint64_t bytes, K60IpaSmmuRead read, void *context,
+    unsigned owned_banks, unsigned owned_groups);
+
+/* Program a successful plan. Returns 0 after every readback matches; on
+ * failure returns K60IpaSmmuReadback and sets *error to a static string.
+ * The caller must quiesce the IPA queue and own the SMMU mapping first. */
+int k60_ipa_smmu_configure(const K60IpaSmmuPlan *plan, uint16_t stream,
+    K60IpaSmmuRead read, K60IpaSmmuWrite write, void *context,
+    const char **error);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* K60_IPA_SMMU_H */
diff --git a/bsd/dev/pong_ipa_smmu.c b/bsd/dev/pong_ipa_smmu.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_ipa_smmu.c
@@ -0,0 +1,323 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* K60 IPA SMMU planner and configuration.
+ *
+ * Line-by-line C translation of the UFS SMMU takeover template,
+ * drivers/NativeUfs/SmmuTakeover.h (BSD-2-Clause-Patent):
+ * planUfsSmmuBank(), planUfsSmmu(), configureUfsSmmu() and
+ * ufsSmmuAddressBits(), renamed for the IPA stream and expressed with a
+ * context pointer instead of a C++ read/write lambda.
+ *
+ * Source facts: ARM IHI 0062D.c sections 1.6 and 3.7. The Pong
+ * qcom,qsmmu-v500 instance exposes 78 owned context banks and 120
+ * owned stream-match groups; IPA uses stream 0x5c0 with Iova 0x20000000,
+ * a 1 MiB ring and 32 KiB of ArmSmmu4K tables.
+ */
+
+#include "pong_ipa_smmu.h"
+
+#define K60_IPA_SMMU_IDR0        0x20u
+#define K60_IPA_SMMU_IDR1        0x24u
+#define K60_IPA_SMMU_IDR2        0x28u
+#define K60_IPA_SMMU_SMR(i)      (0x800u + 4u * (i))
+#define K60_IPA_SMMU_S2CR(i)     (0xc00u + 4u * (i))
+#define K60_IPA_SMMU_SCTLR(p, b) (((p) + (b)) * 4096u)
+#define K60_IPA_SMMU_CBAR(bank)  (0x1000u + 4u * (bank))
+#define K60_IPA_SMMU_CBA2R(bank) (0x1800u + 4u * (bank))
+
+/* ARM IHI 0062D.c sections 1.6 and 3.7: VA64=0 still rejects inputs above
+ * 32 bits with SCTLR.M=0. With VA64=1 the bypass range is bounded by all
+ * three hardware widths, not TCR2.PASize (which only limits translation).
+ */
+static unsigned
+k60_ipa_smmu_address_bits(unsigned code)
+{
+    switch (code) {
+    case 0:
+        return 32;
+    case 1:
+        return 36;
+    case 2:
+        return 40;
+    case 3:
+        return 42;
+    case 4:
+        return 44;
+    case 5:
+        return 48;
+    default:
+        return 0;
+    }
+}
+
+static void
+k60_ipa_smmu_plan_defaults(K60IpaSmmuPlan *p)
+{
+    p->slot = 0xffffffffU;
+    p->bank = 0;
+    p->pages = 0;
+    p->smr = 0;
+    p->s2cr = 0;
+    p->previous_bank = 0xffffffffU;
+    p->reuse = 0;
+    p->migrate = 0;
+    p->error = 0;
+}
+
+static int
+k60_ipa_smmu_same(const char *left, const char *right)
+{
+    while (*left != '\0' && *left == *right) {
+        ++left;
+        ++right;
+    }
+    return *left == *right;
+}
+
+/* Translation of planUfsSmmuBank(): try one context bank, counting down from
+ * the top of the owned range with bank_from_top. */
+static K60IpaSmmuPlan
+k60_ipa_smmu_bank(uint16_t stream, uint64_t dma, uint64_t bytes,
+    K60IpaSmmuRead read, void *context, unsigned owned_banks,
+    unsigned owned_groups, unsigned bank_from_top)
+{
+    K60IpaSmmuPlan p;
+    uint32_t idr0;
+    uint32_t idr1;
+    uint32_t idr2;
+    unsigned count;
+    unsigned banks;
+    unsigned matches;
+    unsigned shift;
+    unsigned i;
+
+    k60_ipa_smmu_plan_defaults(&p);
+    idr0 = read(context, K60_IPA_SMMU_IDR0);
+    idr2 = read(context, K60_IPA_SMMU_IDR2);
+    count = idr0 & 255u;
+    if (!(idr0 & (1U << 30)) || !(idr2 & (1U << 12))) {
+        p.error = "SMMU AArch64 stage 1 unsupported";
+        return p;
+    }
+    for (shift = 0; shift <= 8u; shift += 4u) {
+        unsigned bits = k60_ipa_smmu_address_bits((idr2 >> shift) & 15u);
+
+        if (!bits || !bytes || dma >= (1ULL << bits) ||
+            bytes > (1ULL << bits) - dma) {
+            p.error = "DMA exceeds SMMU address width";
+            return p;
+        }
+    }
+    idr1 = read(context, K60_IPA_SMMU_IDR1);
+    banks = idr1 & 255u;
+    /* DT and ID registers are independent upper bounds. Firmware can expose
+     * fewer resources than the Android DT describes (Pong ID1.NUMCB=75,
+     * DT limit=78). Intersect the bounds; never expand the hardware range. */
+    if (!owned_banks || !owned_groups || !banks || !count) {
+        p.error = "empty SMMU ownership/capability range";
+        return p;
+    }
+    if (banks > owned_banks) {
+        banks = owned_banks;
+    }
+    if (count > owned_groups) {
+        count = owned_groups;
+    }
+    p.pages = 1U << (((idr1 >> 28) & 7u) + 1u);
+    if ((idr1 >> 31) || !count || p.pages > 128 || banks < 2 || banks > 128 ||
+        (p.pages + banks) * 4096u > 0x100000u) {
+        p.error = "unsupported SMMU geometry";
+        return p;
+    }
+    if (count > 128) {
+        p.error = "unsupported stream-match group count";
+        return p;
+    }
+    if (bank_from_top >= banks - 1) {
+        p.error = "no free context bank";
+        return p;
+    }
+    p.bank = banks - 1 - bank_from_top;
+    matches = 0;
+    for (i = 0; i < count; ++i) {
+        uint32_t smr = read(context, K60_IPA_SMMU_SMR(i));
+        uint32_t s2cr;
+        uint32_t mask;
+        unsigned mapped_bank;
+        int match;
+        int translate;
+        int our_bank;
+
+        if (!(smr & 0x80000000U)) {
+            if (!p.reuse && !p.migrate) {
+                p.slot = i;
+            }
+            continue;
+        }
+        s2cr = read(context, K60_IPA_SMMU_S2CR(i));
+        mask = (smr >> 16) & 0x7fffu;
+        match = ((smr ^ stream) & 0xffffu & ~mask) == 0;
+        translate = ((s2cr >> 16) & 3u) == 0;
+        mapped_bank = s2cr & 255u;
+        our_bank = translate && mapped_bank == p.bank;
+        if (match) {
+            ++matches;
+            /* A single exact firmware mapping for the IPA SID is the handoff
+             * to migrate after the queue is stopped. Never accept a masked
+             * mapping, a non-translation type, or a context bank outside the
+             * owned range. */
+            if (matches > 1 || mask || !translate || mapped_bank >= banks) {
+                p.slot = i;
+                p.smr = smr;
+                p.s2cr = s2cr;
+                p.error = "conflicting IPA stream mapping";
+                return p;
+            }
+            p.reuse = our_bank;
+            p.migrate = !our_bank;
+            p.previous_bank = mapped_bank;
+            p.slot = i;
+            p.smr = smr;
+            p.s2cr = s2cr;
+        } else if (our_bank) {
+            p.slot = i;
+            p.smr = smr;
+            p.s2cr = s2cr;
+            p.error = "reserved context bank already used";
+            return p;
+        }
+    }
+    {
+        uint32_t sctlr = read(context, K60_IPA_SMMU_SCTLR(p.pages, p.bank));
+
+        if ((sctlr & 1u) || (p.reuse &&
+            (sctlr || read(context, K60_IPA_SMMU_CBAR(p.bank)) != 0x10000u ||
+             (read(context, K60_IPA_SMMU_CBA2R(p.bank)) & ~1u)))) {
+            p.error = "reserved context bank not bypass";
+            return p;
+        }
+    }
+    if (p.slot == 0xffffffffU) {
+        p.error = "no free stream-match group";
+    }
+    return p;
+}
+
+static int
+k60_ipa_smmu_retryable(const char *error)
+{
+    return k60_ipa_smmu_same(error, "reserved context bank already used") ||
+        k60_ipa_smmu_same(error, "reserved context bank not bypass");
+}
+
+/* Translation of planUfsSmmu(): bounded warm-reset fallback over
+ * bankFromTop 1..7, intersected with the owned ranges above. Keep exact SID
+ * matching, firmware migration and VA64 checks. */
+int
+k60_ipa_smmu_plan(K60IpaSmmuPlan *plan, uint16_t stream, uint64_t dma,
+    uint64_t bytes, K60IpaSmmuRead read, void *context,
+    unsigned owned_banks, unsigned owned_groups)
+{
+    K60IpaSmmuPlan first;
+    unsigned attempt;
+
+    if (!plan || !read) {
+        if (plan) {
+            k60_ipa_smmu_plan_defaults(plan);
+            plan->error = "SMMU missing plan or read callback";
+        }
+        return K60IpaSmmuBadArgument;
+    }
+    first = k60_ipa_smmu_bank(stream, dma, bytes, read, context,
+        owned_banks, owned_groups, 0);
+    if (!first.error) {
+        *plan = first;
+        return K60IpaSmmuOk;
+    }
+    /* An inexact/masked SID is still an unconditional refusal; the planner
+     * already migrates an exact mapping from another bank. */
+    if (!k60_ipa_smmu_retryable(first.error)) {
+        *plan = first;
+        return K60IpaSmmuUnsupported;
+    }
+    for (attempt = 1; attempt < 8u; ++attempt) {
+        K60IpaSmmuPlan next = k60_ipa_smmu_bank(stream, dma, bytes, read,
+            context, owned_banks, owned_groups, attempt);
+
+        if (!next.error) {
+            *plan = next;
+            return K60IpaSmmuOk;
+        }
+        if (!k60_ipa_smmu_retryable(next.error)) {
+            break;
+        }
+    }
+    *plan = first;
+    return K60IpaSmmuUnsupported;
+}
+
+/* Translation of configureUfsSmmu(). The caller must first quiesce the IPA
+ * queue. The planner refuses other streams sharing this bank and enabled
+ * translation; no live context is disabled here. The write callback must
+ * complete an MMIO barrier before it returns. */
+int
+k60_ipa_smmu_configure(const K60IpaSmmuPlan *plan, uint16_t stream,
+    K60IpaSmmuRead read, K60IpaSmmuWrite write, void *context,
+    const char **error)
+{
+    unsigned cb;
+
+    if (!plan || !read || !write || !error) {
+        if (error) {
+            *error = "SMMU missing configure argument";
+        }
+        return K60IpaSmmuBadArgument;
+    }
+    *error = 0;
+    if (plan->error) {
+        *error = plan->error;
+        return K60IpaSmmuUnsupported;
+    }
+    cb = K60_IPA_SMMU_SCTLR(plan->pages, plan->bank);
+    if (!plan->reuse) {
+        write(context, cb, 0);
+    }
+    if (read(context, cb) != 0) {
+        *error = "SMMU bypass disable readback";
+        return K60IpaSmmuReadback;
+    }
+    /* Set VA64 before exposing a newly allocated stream. Repair an exclusive
+     * existing 32-bit bypass too; do not silently reuse the faulty state. */
+    if (read(context, K60_IPA_SMMU_CBA2R(plan->bank)) != 1u) {
+        write(context, K60_IPA_SMMU_CBA2R(plan->bank), 1u);
+    }
+    if (!plan->reuse) {
+        write(context, K60_IPA_SMMU_CBAR(plan->bank), 0x10000u);
+    }
+    if (read(context, K60_IPA_SMMU_CBA2R(plan->bank)) != 1u ||
+        read(context, K60_IPA_SMMU_CBAR(plan->bank)) != 0x10000u ||
+        read(context, cb) != 0) {
+        *error = "SMMU VA64 bypass readback";
+        return K60IpaSmmuReadback;
+    }
+    if (!plan->reuse) {
+        /* For a firmware handoff the SMR is already the exact IPA SID.
+         * Configure the new bank first, then atomically change only this
+         * slot's S2CR. */
+        write(context, K60_IPA_SMMU_S2CR(plan->slot), plan->bank);
+        if (read(context, K60_IPA_SMMU_S2CR(plan->slot)) != plan->bank) {
+            *error = "SMMU stream context readback";
+            return K60IpaSmmuReadback;
+        }
+        if (!plan->migrate) {
+            write(context, K60_IPA_SMMU_SMR(plan->slot),
+                0x80000000u | stream);
+        }
+    }
+    if (read(context, K60_IPA_SMMU_SMR(plan->slot)) !=
+            (0x80000000u | stream) ||
+        read(context, K60_IPA_SMMU_S2CR(plan->slot)) != plan->bank) {
+        *error = "SMMU stream mapping readback";
+        return K60IpaSmmuReadback;
+    }
+    return K60IpaSmmuOk;
+}
