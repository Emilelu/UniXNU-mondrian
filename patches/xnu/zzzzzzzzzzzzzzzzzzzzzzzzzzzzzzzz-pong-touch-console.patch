+static uint8_t
+goodix_command_ack(void)
+{
+	uint8_t ack[8];
+	uint8_t last = 0xff;
+	for (unsigned t = 0; t < 20; t++) {
+		if (goodix_read(command_address, ack, sizeof(ack))) {
+			last = ack[1];
+			if (last != 0x00 && last != 0xff) break;
+		}
+		sleep_ms(20);
+	}
+	return last;
+}
+
+static bool
+goodix_command(uint8_t len, uint8_t cmd, const uint8_t *data, uint32_t bytes, const char *what)
+{
+	uint8_t frame[8] = { 0 };
+	uint32_t sum = (uint32_t)len + cmd;
+
+	if (!command_address || bytes + 4 > (uint32_t)sizeof(frame) - 2) return false;
+	frame[2] = len;
+	frame[3] = cmd;
+	for (uint32_t i = 0; i < bytes; i++) {
+		frame[4 + i] = data[i];
+		sum += data[i];
+	}
+	frame[len] = (uint8_t)(sum & 0xff);
+	frame[len + 1] = (uint8_t)(sum >> 8);
+	if (!goodix_write(command_address, frame, sizeof(frame))) return false;
+	uint8_t ack = goodix_command_ack();
+	printf("goodix: %s ack=%02x\n", what, ack);
+	return ack == 0x80;
+}
+
+static bool
+goodix_apply_config(uint32_t fw_buffer)
+{
+	unsigned off = 0, bad = 0;
+	const uint8_t coordinate = 0x00;
+
+	if (!fw_buffer) {
+		printf("goodix: CFG skip (IC-info reports no fw_buffer)\n");
+		return false;
+	}
+	if (!goodix_command(4, 0x04, NULL, 0, "CFG-START")) return false;
+	while (off < sizeof(k60_cfg)) {
+		unsigned chunk = sizeof(k60_cfg) - off < 64 ? sizeof(k60_cfg) - off : 64;
+		uint8_t back[64];
+		if (!goodix_write(fw_buffer + off, k60_cfg + off, chunk)) { bad++; break; }
+		if (!goodix_read(fw_buffer + off, back, chunk) || memcmp(back, k60_cfg + off, chunk) != 0) bad++;
+		off += chunk;
+	}
+	printf("goodix: CFG-DL wrote=%u/%u bad=%u\n", off, (unsigned)sizeof(k60_cfg), bad);
+	if (off != sizeof(k60_cfg) || bad) return false;
+	if (!goodix_command(4, 0x05, NULL, 0, "CFG-WRITE")) return false;
+	if (!goodix_command(4, 0x06, NULL, 0, "CFG-EXIT")) return false;
+	gpio_set(PIN_RESET, false);
+	sleep_ms(2);
+	gpio_set(PIN_RESET, true);
+	sleep_ms(100);
+	if (!goodix_command(5, 0x90, &coordinate, 1, "COORD-MODE")) return false;
+	sleep_ms(50);
+	return true;
+}
+
+/* Which fingers were down in the last report, and where. */
+static struct {
+	bool down, seen;
+	uint32_t x, y;
+} contact[GOODIX_MAX_TOUCHES];
+
+static bool
+goodix_contacts_valid(const uint8_t *touches, uint32_t count)
+{
+    uint32_t ids = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        const uint8_t *t = touches + 8 * i;
+        uint32_t id = t[0] >> 4, kind = t[0] & 0xf;
+        if (kind == 1 || kind == 3) continue;  /* Berlin stylus/hover, not a finger */
+        if (id >= GOODIX_MAX_TOUCHES || (ids & (1u << id))) return false;
+        ids |= 1u << id;
+    }
+    return true;
+}
+
+static void
+goodix_release(void)
+{
+    for (uint32_t id = 0; id < GOODIX_MAX_TOUCHES; id++) {
+        if (!contact[id].down) continue;
+        contact[id].down = false;
+        pong_touch_post(PONG_TOUCH_UP, id, contact[id].x, contact[id].y);
+    }
+}
+
+static void
+goodix_report(const uint8_t *touches, uint32_t count)
+{
+    static unsigned shown;
+    for (unsigned id = 0; id < GOODIX_MAX_TOUCHES; id++) contact[id].seen = false;
+    for (uint32_t i = 0; i < count; i++) {
+        const uint8_t *t = touches + 8 * i;
+        uint32_t id = t[0] >> 4, kind = t[0] & 0xf;
+        if (kind == 1 || kind == 3) continue;
+        uint32_t raw_x = le16(t + 2), raw_y = le16(t + 4);
+        /* The ADT contains raw axes, not panel pixels. This is the only
+         * raw-axis conversion; userland merely decodes the fixed u16 ABI. */
+        uint32_t x = raw_x >= max_x ? 65535u : raw_x * 65535u / max_x;
+        uint32_t y = raw_y >= max_y ? 65535u : raw_y * 65535u / max_y;
+        if (flip & 1) x = 65535u - x;
+        if (flip & 2) y = 65535u - y;
+        uint32_t type = contact[id].down ? PONG_TOUCH_MOVE : PONG_TOUCH_DOWN;
+        if (!contact[id].down || contact[id].x != x || contact[id].y != y) {
+            pong_touch_post(type, id, x, y);
+            if (shown++ < 8) printf("goodix: type=%u finger=%u raw=%u,%u normalized=%u,%u\n",
+                type, id, raw_x, raw_y, x, y);
+        }
+        contact[id].seen = contact[id].down = true;
+        contact[id].x = x;
+        contact[id].y = y;
+    }
+    /* Goodix IDs are stable hardware slots; omitted slots are real releases. */
+    for (uint32_t id = 0; id < GOODIX_MAX_TOUCHES; id++) {
+        if (contact[id].down && !contact[id].seen) {
+            contact[id].down = false;
+            pong_touch_post(PONG_TOUCH_UP, id, contact[id].x, contact[id].y);
+        }
+    }
+}
+
+/* Read a real Berlin frame, publish only validated contacts, then clear its
+ * status through the physical SPI transport. A failed ACK is not success. */
+static bool
+goodix_poll(void)
+{
+    static uint8_t report[8 + 8 * GOODIX_MAX_TOUCHES + 2];
+    static unsigned complaints;
+    const uint8_t zero = 0;
+    const uint32_t first = 8 + 8 * 2 + 2;
+    bool valid = true, reset = false;
+    uint32_t count = 0;
+
+    if (!touch_address) return false; /* failed re-identification must not read address zero */
+    if (!goodix_read(touch_address, report, first)) return false;
+    if (!report[0]) return true;  /* no event does NOT mean all contacts lifted */
+    if (!goodix_checksum_ok(report, 8)) {
+        if (complaints++ < 8) printf("goodix: invalid report header checksum\n");
+        valid = false;
+    } else {
+        if (report[0] & GOODIX_STATUS_TOUCH) {
+            count = report[2] & 0xf;
+            if (count > GOODIX_MAX_TOUCHES) {
+                valid = false;
+            } else if (count > 2 && !goodix_read(touch_address + first, report + first, 8 * (count - 2))) {
+                /* Linux Berlin continuation starts after the already-read
+                 * 26 bytes, including the first two bytes of contact 3. */
+                valid = false;
+            }
+            if (valid && count && !goodix_checksum_ok(report + 8, 8 * count + 2)) valid = false;
+            if (valid && !goodix_contacts_valid(report + 8, count)) valid = false;
+        }
+        if (report[0] & GOODIX_STATUS_REQUEST) reset = report[2] == GOODIX_REQUEST_RESET;
+    }
+    if (!goodix_write(touch_address, &zero, 1)) {
+        if (complaints++ < 8) printf("goodix: report status clear failed\n");
+        return false;
+    }
+    if (!valid) {
+        if (complaints++ < 8) printf("goodix: invalid contact report (%u contacts)\n", count);
+        return false;
+    }
+    if (reset) {
+        /* Reset ends all previous physical contacts. Re-identify the ABI
+         * before another read; never preserve stuck HID fingers across reset. */
+        goodix_release();
+        touch_reset();
+        if (!goodix_probe(true)) return false;
+        return goodix_write(touch_address, &zero, 1);
+    }
+    if (report[0] & GOODIX_STATUS_TOUCH) goodix_report(report + 8, count);
+    return true;
+}
