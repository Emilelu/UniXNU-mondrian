@@ -62,6 +62,21 @@
 static OSSharedPtr<const OSSymbol> gIOCPUStateKey;
 static OSSharedPtr<OSString> gIOCPUStateNames[kIOCPUStateCount];
 
+#if !defined(PONG)
+// The exported kext SDK omits this internal IOService method. Keep the
+// completion notification in XNU, after the native driver tried every CPU.
+// This series is built by the 27 board only, and its machine configuration
+// (BCM2837) defines neither PONG nor BCM2837 as a macro, so the guard is the
+// negation: a `#if defined(PONG)` copy compiles to nothing here and leaves
+// ArmCpu.cpp:580 with an undefined symbol. The 16.6.1 board keeps its own
+// file, patches/xnu/zzzzzzzzzzzzzzzzzzzzzz-pong-cpu-start-completion.patch.
+extern "C" void
+pong_cpu_startup_finished(IOCPUInterruptController *controller)
+{
+	controller->cpusRunning();
+}
+#endif
