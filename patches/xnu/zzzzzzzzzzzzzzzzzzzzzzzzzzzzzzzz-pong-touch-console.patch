+/* Is the chip there and running its firmware? Finds where it keeps the touch report. */
+static bool
+goodix_probe(bool verbose)
+{
+	static uint8_t info[GOODIX_MAX_READ];
+	uint8_t version[28];
+	uint32_t length, offset;
+
+	if (!goodix_read(GOODIX_FW_VERSION, version, sizeof(version))) {
+		return false;
+	}
+	if (!goodix_checksum_ok(version, sizeof(version))) {
+		if (verbose) {
+			printf("goodix: no valid firmware version: %02x %02x %02x %02x %02x %02x %02x %02x ... %02x %02x\n",
+			    version[0], version[1], version[2], version[3], version[4], version[5], version[6], version[7],
+			    version[26], version[27]);
+		}
+		return false;
+	}
+	printf("goodix: chip \"%.6s\", firmware \"%.8s\" %02x.%02x.%02x.%02x, sensor %u\n", (const char *)version,
+	    (const char *)version + 10, version[18], version[19], version[20], version[21], version[23]);
+
+	if (!goodix_read(GOODIX_IC_INFO, info, 2)) {
+		return false;
+	}
+	length = le16(info);
+	if (length < 40 || length >= GOODIX_MAX_READ || !goodix_read(GOODIX_IC_INFO, info, length) ||
+	    !goodix_checksum_ok(info, length)) {
+		printf("goodix: bad chip description (length %u)\n", length);
+		return false;
+	}
+	/* the length, the version (16 bytes), the features (10), four counts, then five lists of 16-bit numbers */
+	offset = 2 + 16 + 10 + 4;
+	for (int i = 0; i < 5; i++) {
+		if (offset >= length) {
+			return false;
+		}
+		offset += 1 + 2u * info[offset];
+	}
+	if (offset + 48 + 2 > length) {
+		printf("goodix: chip description too short (%u, lists end at %u)\n", length, offset);
+		return false;
+	}
+	/*
+	 * K60_TOUCH_ADDR: keep the documented frame address.
+	 *
+	 * references/ruby-bringup/docs/touch-goodix-9916r.md section 5.3 states the
+	 * touch data address is 0x10308 and that its P2 stage read real frames from
+	 * exactly there (checksum valid, raw x/y inside the panel range). misc+44
+	 * holds that value, so take it.
+	 *
+	 * misc+24 (0x10400) is kept as an alternate for diagnostics only. It does
+	 * change on every sample, but the values hover in a narrow band
+	 * (0x26fe..0x2719) which is a DC offset with noise, not finger motion, and
+	 * its bytes 3..7 are a fixed e8 08 e8 08 01. That signature says the analog
+	 * front end is not converting, which matches section 3.2: an undervolted
+	 * AVDD lets the ROM answer (dev_confirm and the version block read fine) while
+	 * the scan engine never produces a report. The earlier revision swapped the
+	 * two addresses on the strength of the "it changes" observation alone, which
+	 * was not a documented reason.
+	 */
+	touch_address = le32(info + offset + 44);
+	touch_address_alt = le32(info + offset + 24);
+	command_address = le32(info + offset + 0);      /* (the "misc" part: the command buffer comes first) */
+	{
+		printf("goodix: misc candidates");
+		for (unsigned c = 0; c + 4 <= 56; c += 4) {
+			uint32_t v = le32(info + offset + c);
+			if (v >= 0x10000u && v < 0x11000u) {
+				printf(" +%u=%#x", c, v);
+			}
+		}
+		printf("\n");
+		printf("goodix: using touch_address=%#x (misc+44 per ruby doc 5.3), alt=%#x (misc+24)\n",
+		    touch_address, touch_address_alt);
