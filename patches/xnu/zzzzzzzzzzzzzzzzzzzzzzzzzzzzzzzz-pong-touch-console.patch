+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+
+static vm_offset_t tlmm, gcc, se, rsc, cmd_db, wrapper;
+static uint64_t wrapper_phys;
+
+/* K60_SMMU_L1: one 4 KiB LPAE level-1 table for the SE stage-1 identity map
+ * (see k60_se_smmu_identity_map). Declared with the other MMIO/global
+ * state at the top of the file so every user below sees it. */
+static uint64_t smmu_l1[512] __attribute__((aligned(4096)));
+static uint64_t tlmm_phys, gcc_phys, se_phys, rsc_phys, cmd_db_phys;
+static uint32_t pins[6], gpio_offset, max_x, max_y;
+/* apps_smmu window: mapped by the thread, used by k60_se_smmu_bypass() and geni_dma_address().
+ * se_smmu_bypass is true only once the touch SE stream reads back as an AArch64 stage-1
+ * context with stage-2 bypass, which is what makes a kvtophys() address a legal SE DMA
+ * address; se_smmu_warned keeps the one-shot reports to one line each. */
+static vm_offset_t smmu;
+/* Context bank we programmed (and its page offset) so the DMA path can read the
+ * fault registers for exactly that context. */
+static unsigned smmu_ctx_pages;
+static unsigned smmu_ctx_bank;
+static bool se_smmu_bypass;
+static bool se_smmu_warned;
+
+static bool
+property(DTEntry entry, const char *name, void *out, unsigned size)
+{
+    void *value = NULL; unsigned length = 0;
+    if (SecureDTGetProperty(entry, name, &value, &length) != kSuccess || length != size) return false;
+    memcpy(out, value, size); return true;
+}
+
+static bool
+configuration(void)
+{
+    DTEntry entry;
+    if (SecureDTLookupEntry(NULL, "/arm-io/pong-touch", &entry) != kSuccess) return false;
+    return property(entry,"spi-base",&se_phys,8) && property(entry,"tlmm-base",&tlmm_phys,8) &&
+        property(entry,"gcc-base",&gcc_phys,8) && property(entry,"rsc-base",&rsc_phys,8) &&
+        property(entry,"cmd-db-base",&cmd_db_phys,8) && property(entry,"gpio-offset",&gpio_offset,4) &&
+        property(entry,"pins",pins,sizeof(pins)) && (property(entry,"panel-max-x",&max_x,4) || property(entry,"max-x",&max_x,4)) &&
+        (property(entry,"panel-max-y",&max_y,4) || property(entry,"max-y",&max_y,4)) && se_phys==0x990000 && tlmm_phys==0xf000000 &&
+        gcc_phys==0x100000 && rsc_phys==0x17a20000 && cmd_db_phys==0x80860000 &&
+        gpio_offset==0x100000 && pins[0]==16 && pins[1]==17 && pins[2]==18 &&
+        pins[3]==19 && pins[4]==21 && pins[5]==20 && max_x>=1080 && max_y>=2412;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	assert_wait_deadline((event_t)&cmd_db, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- pins (TLMM) ------------------------------------------------------------------------------- */
+
+#define TLMM_PHYS               tlmm_phys
+/* K60_WINDOW_BUDGET: io_submap is IO_MAP_SIZE = 8 MiB for the WHOLE kernel
+ * (osfmk/arm/io_map.c:65) and io_map() raises a panic on KERN_NO_SPACE instead
+ * of returning NULL (kmem_alloc with KMA_NOFAIL -> __kmem_failed_panic). Asking
+ * for 2 MiB here plus 448 KiB of GCC pushed the touch thread past the budget and
+ * the boot died with an empty console, which looks like a register hang but is
+ * really an out-of-address-space panic. Only GPIO_CFG/GPIO_IO are touched, and
+ * they live at gpio_offset + 0x1000*n with n in {16,17,18,19,21,20}, so the
+ * window must span 0x1000*21 + 4 = 0x15004. 0x20000 (128 KiB) covers every pin
+ * with headroom and still saves 1.88 MiB of the shared submap.
+ * P-64: an earlier 64 KiB value left pin 20 outside the mapping and the first
+ * gpio_set() on it took a kernel data abort (far = base + 0x14004). */
+/*
+ * K60_TLMM_WINDOW: the window has to cover the highest pin this driver touches.
+ *
+ * GPIO_CFG(n) = tlmm + gpio_offset + 0x1000 * n, so pin n lives at physical
+ * TLMM_PHYS + gpio_offset + 0x1000*n. With gpio_offset = 0x100000 and the old
+ * TLMM_SIZE = 0x20000 the window ended at 0x120000, which covered gpio20
+ * (0x114000) and gpio21 (0x115000) but NOT gpio71 (0x147000) -- the AVDD
+ * load-switch enable. Measured on device: gpio20/21 read back sane CFG values
+ * while gpio71 read cfg=0 (output never enabled), which is exactly an
+ * out-of-window access.
+ *
+ * 0x80000 covers pin 71 (needs 0x58000) with headroom and still fits the 8 MiB
+ * io_submap budget (about 0.83 MiB is in use).
+ */
+#define TLMM_SIZE               0x80000UL
+#define GPIO_CFG(n)             (tlmm + gpio_offset + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + gpio_offset + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define PULL_NONE               0
+#define PULL_UP                 3
+
+#define PIN_MISO                pins[0]
+#define PIN_MOSI                pins[1]
+#define PIN_CLK                 pins[2]
+#define PIN_CS                  pins[3]
+#define PIN_INT                 pins[4]      /* low = the chip has a report */
+#define PIN_RESET               pins[5]     /* low = in reset */
+#define PIN_FUNCTION_SPI        1       /* "qup15" */
+
+static void
+gpio_configure(unsigned pin, unsigned function, unsigned pull, unsigned ma, bool output)
+{
+	uint32_t value = pull | function << 2 | (ma / 2 - 1) << 6 | (output ? 1u << 9 : 0);
+	wr(GPIO_CFG(pin), (rd(GPIO_CFG(pin)) & ~0x3ffu) | value);
+}
+
+static void
+gpio_set(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), high ? 2 : 0);
+}
+
+static bool
+gpio_get(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+gpio_output(unsigned pin, bool high, unsigned pull, unsigned ma)
+{
+	gpio_set(pin, high);            /* the level first, so that the pin never drives the wrong one */
+	gpio_configure(pin, 0, pull, ma, true);
+}
+
+/* ---- the I/O supply (RPMh) ----------------------------------------------------------------------- */
+
+#define CMD_DB_PHYS             cmd_db_phys
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                rsc_phys    /* the application processor's "DRV 2" */
+#define RSC_SIZE                0x10000UL
+/*
+ * K60_TCS4: drive ACTIVE TCS4, not slot 0.
+ *
+ * The zizhan shared RPMh owner spells the assignment out
+ * (UniXNU-zizhan/drivers/PongPower/PongRpmh.cpp):
+ *   "APSS DRV2 (0x17a20000) ... SLEEP0..2, ACTIVE3..4, WAKE5..6; the GPU leases
+ *    active TCS3, these clients share active TCS4 under one sleeping lock"
+ * and computes the base as 0xd00 + 4*0x2a0. This driver used 0xd00 (slot 0),
+ * which is one of the sleep slots: the command is written but the RPMh never
+ * consumes it, so the rail was never actually programmed. That is why
+ * io_supply_on() "succeeded" while nothing changed.
+ */
+#define TCS_SLOT(n)             (0xd00UL + 0x2a0UL * (n))
+#define TCS_BASE                TCS_SLOT(4)     /* ACTIVE TCS4, shared */
+#define TCS_OTHER               TCS_SLOT(3)     /* ACTIVE TCS3, leased by the GPU */
+#define TCS(reg)                (rsc + TCS_BASE + (reg))
+#define TCS_IRQ_ENABLE          0x00
+#define TCS_IRQ_STATUS          0x04
+#define TCS_IRQ_CLEAR           0x08
+#define TCS_WAIT_FOR_COMPLETION 0x10
+#define TCS_CONTROL             0x14
+#define TCS_CONTROL_ENABLE      (1u << 16)
+#define TCS_CONTROL_TRIGGER     (1u << 24)
+#define TCS_STATUS              0x18            /* 0 while busy */
+#define TCS_CMD_STATUS          0x3c            /* 0x10100 == the command completed */
+
+/* Busy-wait without yielding: the reference owner uses IODelay(10) here and the
+ * RPMh engine keeps running while the CPU spins. */
+static inline void
+IOPauseFor(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		__asm__ volatile("yield" ::: "memory");
+	}
+}
+#define TCS_CMD_ENABLE          0x1c
+#define TCS_CMD_MSGID(n)        (0x30 + 20 * (n))
+#define TCS_CMD_ADDR(n)         (0x34 + 20 * (n))
+#define TCS_CMD_DATA(n)         (0x38 + 20 * (n))
+#define MSGID_WRITE_4_BYTES     0x10008
+#define MSGID_RESPONSE          0x100
+
+#define VRM_VOLTAGE             0               /* a regulator's registers, from its address: millivolts */
+#define VRM_ENABLE              4
+#define VRM_MODE                8
+#define VRM_MODE_LDO_HPM        7
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+/* The RPMh address of a resource by its name in the command database the boot loader left; 0 = none. */
+static uint32_t
+rpmh_address(const char *name)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)cmd_db;
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		printf("goodix: no command database (magic %02x %02x %02x %02x)\n", db->magic[0], db->magic[1], db->magic[2],
+		    db->magic[3]);
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512 ||
+            144u + slave->header_offset + slave->count * sizeof(*entry) > CMD_DB_SIZE) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+static bool
+rpmh_wait(uint32_t reg, uint32_t mask, uint32_t value, const char *what)
+{
+	for (int i = 0; i < 2000; i++) {
+		if ((rd(TCS(reg)) & mask) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	printf("goodix: RPMh: timeout waiting for %s (register %#x = %#x)\n", what, reg, rd(TCS(reg)));
+	return false;
+}
+
+/* Send up to three register writes to RPMh and wait until they are done. */
+static bool
+rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
+{
+	uint32_t irq_enable;
+	bool done;
+
+	/*
+	 * K60_TCS_PRECHECK: the reference implementation refuses to issue a vote
+	 * unless the slot set reports that ACTIVE TCS4 exists and is idle, and unless
+	 * no pending transaction in the GPU's TCS3 targets the same address. Without
+	 * these two checks a write can be accepted by the register block and still
+	 * never be executed, which looks exactly like a successful call.
+	 */
+	{
+		uint32_t caps = rd(rsc + 0x0c);
+		unsigned count_max = (caps >> 12) & 63u;
+		unsigned ncpt = (caps >> 27) & 31u;
+		uint32_t ver = rd(rsc + 0x00);
+
+		printf("goodix: RPMh caps=%#x count=%u ncpt=%u ver=%#x tcs4_idle=%u\n",
+		    caps, count_max, ncpt, ver, rd(rsc + TCS_BASE + 0x18) ? 1u : 0u);
+		if (((ver >> 16) & 0xffu) >= 3u || count_max < 8u || ncpt < 1u ||
+		    !rd(rsc + TCS_BASE + 0x18)) {
+			printf("goodix: RPMh ACTIVE TCS4 unavailable, refusing the vote\n");
+			return false;
+		}
+		if (!rd(rsc + TCS_OTHER + 0x18)) {
+			uint32_t mask = rd(rsc + TCS_OTHER + 0x1c);
+
+			for (unsigned i = 0; i < ncpt && i < 16u; i++) {
+				if ((mask & (1u << i)) &&
+				    rd(rsc + TCS_OTHER + 0x34 + 20u * i) == address[0]) {
+					printf("goodix: RPMh conflicting transaction on TCS3\n");
+					return false;
+				}
+			}
+		}
+	}
+	irq_enable = rd(TCS(TCS_IRQ_ENABLE));
+
+	/* the slot set must be idle, and switched off the way the hardware wants it: trigger, then enable */
+	for (int i = 0; rd(TCS(TCS_STATUS)) == 0; i++) {
+		if (i > 2000) {
+			printf("goodix: RPMh: the command slots stay busy\n");
+			return false;
+		}
+		sleep_us(100);
+	}
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	for (unsigned i = 0; i < count; i++) {
+		wr(TCS(TCS_CMD_MSGID(i)), MSGID_WRITE_4_BYTES | MSGID_RESPONSE);
+		wr(TCS(TCS_CMD_ADDR(i)), address[i]);
+		wr(TCS(TCS_CMD_DATA(i)), data[i]);
+	}
+	wr(TCS(TCS_WAIT_FOR_COMPLETION), (1u << count) - 1);
+	wr(TCS(TCS_CMD_ENABLE), (1u << count) - 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable | 1);        /* the status bit follows the enable; the interrupt itself stays masked */
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE | TCS_CONTROL_TRIGGER);
+
+	/*
+	 * K60_TCS_COMPLETION: wait on the command status, not on the interrupt
+	 * status register.
+	 *
+	 * Measured on device: with ACTIVE TCS4 the precheck passed (caps 0x800c8104,
+	 * count 8, ncpt 16, version 2, slot idle) but IRQ_STATUS never left zero, so
+	 * the old wait always timed out. The reference shared owner polls a different
+	 * pair of registers and treats the transaction as done when the command
+	 * status reports completion (0x10100) and the slot is idle again, while a
+	 * "progressed" flag absorbs the race where the slot looks idle before the
+	 * engine has even started:
+	 *
+	 *   unsigned st = rsc.r(b+0x3c), idle = rsc.r(b+0x18);
+	 *   if ((st & 0x10100) != 0x10100 || !idle) progressed = true;
+	 *   if ((st & 0x10100) == 0x10100 && idle &&
+	 *       (progressed || (rsc.r(0xd04) & (1u<<4)))) { done = true; break; }
+	 *
+	 * The interrupt is cleared at the RSC level (0xd08 bit 4), not in the TCS.
+	 */
+	done = false;
+	{
+		bool progressed = false;
+		uint64_t deadline;
+
+		clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+		do {
+			uint32_t st = rd(TCS(TCS_CMD_STATUS));
+			uint32_t idle = rd(TCS(TCS_STATUS));
+
+			if ((st & 0x10100u) != 0x10100u || !idle) {
+				progressed = true;
+			}
+			if ((st & 0x10100u) == 0x10100u && idle &&
+			    (progressed || (rd(rsc + 0xd04) & (1u << 4)))) {
+				done = true;
+				break;
+			}
+			IOPauseFor(10);
+		} while (mach_absolute_time() < deadline);
+	}
+	if (!done) {
+		printf("goodix: RPMh request did not complete"
+		    " (cmd_status=%#x tcs_status=%#x rsc_irq=%#x)\n",
+		    rd(TCS(TCS_CMD_STATUS)), rd(TCS(TCS_STATUS)), rd(rsc + 0xd04));
+	}
+	wr(TCS(TCS_CMD_ENABLE), 0);
+	wr(rsc + 0xd08, 1u << 4);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable);
+	return done;
+}
+
+/* K60 DT: IOVDD = vdd-supply = pm8350c_l2 (1.8 V), AVDD = goodix,avdd-gpio
+ * = GPIO71. Pong used ldoc3/ldoc12; those are NOT K60's touch rails.
+ * rpmh_address() resolves the cmd_db address at run time, so no register
+ * constant is guessed here. */
+static bool
+/*
+ * K60_PMIC_VOUT: write the rail voltage explicitly instead of trusting the
+ * enable bit alone.
+ *
+ * The upstream ruby bring-up hit exactly this and recorded it as the root cause
+ * of its own all-zero reads (references/ruby-bringup/docs/touch-goodix-9916r.md
+ * section 3.2):
+ *
+ *     vtp: Bringing 1800000uV into 3300000-3300000uV
+ *     VMC: Bringing 3000000uV into 1800000-1800000uV
+ *
+ *   "LK/PMIC defaults to VMC=3.0V and VTP=1.8V and Android changes them later.
+ *    Writing only the enable bit leaves AVDD undervolted and the controller does
+ *    not start at all."
+ *
+ * Their sequence (section 3.3): read EN/VOUT, disable, write VOUT, read back,
+ * then IOVDD, then enable. K60 reaches the PMIC through RPMh rather than MT6360
+ * SMBus, so the voltage and the enable go out as one RPMh command and the
+ * read-back is the only independent confirmation we have.
+ */
+io_supply_on(void)
+{
+    uint32_t iovdd = rpmh_address("ldoc2");
+    uint32_t avdd_rail;
+    if (!iovdd) { printf("goodix: cmd_db has no ldoc2\n"); return false; }
+    if (((iovdd >> 16) & 15) != 4) { printf("goodix: ldoc2 %#x is not a VRM\n", iovdd); return false; }
+
+    /*
+     * Step 1: put both rails in a known-off state so the following VOUT write is
+     * the only thing that can bring them up.
+     */
+    {
+        uint32_t address[3] = {iovdd, iovdd + 4, iovdd + 8};
+        uint32_t off[3] = {0, 0, 4};
+        (void)rpmh_write(address, off, 3);
+        sleep_ms(20);
+    }
+
+    /*
+     * Step 2: write the voltage and enable together. The value 1800 is the
+     * IOVDD set point Android runs (docs/OPS-TWRP-DD.md:171
+     * pm8350c_l2 enabled 1800000 uV).
+     */
+    {
+        uint32_t address[3] = {iovdd, iovdd + 4, iovdd + 8};
+        uint32_t data[3] = {1800, 1, 4};
+        if (!rpmh_write(address, data, 3)) {
+            printf("goodix: RPMh ldoc2 write failed\n");
+            return false;
+        }
+    }
+    /* ruby section 3.3: LDO3 needs 30 ms, LDO2 another 15 ms before the pads
+     * are switched to GPIO and reset is released. */
+    sleep_ms(30);
+    sleep_ms(15);
+
+    /*
+     * Step 3: read the rail back. rpmh_address returns the command address, so a
+     * second RPMh window is not a read path; report what cmd_db and the PMIC
+     * observer say instead, and never claim the rail is up without it.
+     */
+    avdd_rail = rpmh_address("ldoc3");
+    printf("goodix: rails written iovdd=%#x avdd=%#x (ldoc3)\n", iovdd, avdd_rail);
+
+    /* AVDD is a GPIO load-switch enable on K60, not a PMIC rail. */
+    gpio_output(71u, true, PULL_NONE, 6);
+    sleep_ms(15);
+    printf("goodix: rails on (ldoc2=%#x, AVDD gpio71=1)\n", iovdd);
+    return true;
+}
+
+/* ---- clocks (GCC) -------------------------------------------------------------------------------- */
+
+#define GCC_PHYS                gcc_phys
+#define GCC_SIZE                0x70000UL
+#define GCC_VOTE                (gcc + 0x62008)         /* the application processor's votes */
+#define VOTE_QUP0_CORE_2X       (1u << 9)
+#define VOTE_QUP0_CORE          (1u << 8)
+#define VOTE_QUP0_M_AHB         (1u << 6)
+#define VOTE_QUP0_S_AHB         (1u << 7)
+#define VOTE_QUP0_SE4           (1u << 14)             /* Pong: wrapper 0 serial engine 4 */
+#define GCC_QUP0_CORE_CBCR      (gcc + 0x33000)         /* gcc_qupv3_wrap0_core_clk, no hwcg */
+#define GCC_QUP0_CORE_2X_CBCR   (gcc + 0x3300c)         /* gcc_qupv3_wrap0_core_2x_clk, no hwcg */
+#define GCC_QUP0_M_AHB_CBCR     (gcc + 0x27004)         /* bit 31: the clock is off, bit 1: hwcg */
+#define GCC_QUP0_S_AHB_CBCR     (gcc + 0x27008)
+#define GCC_QUP0_SE4_CBCR       (gcc + 0x274dc)
+#define GCC_QUP0_SE4_CMD        (gcc + 0x274e4)         /* bit 0: take the new configuration */
+#define GCC_QUP0_SE4_CFG        (gcc + 0x274e8)         /* [4:0] 2*divider-1, [10:8] source, [13:12] mode */
+#define GCC_QUP0_SE4_DFSR       (gcc + 0x274f8)         /* bit 0: the engine chooses among preset rates itself */
+#define GCC_QUP0_SE4_PERF_CFG(l) (gcc + 0x27500 + 4 * (l))
+#define GCC_QUP0_SE4_PERF_M(l)  (gcc + 0x27540 + 4 * (l))
+#define GCC_QUP0_SE4_PERF_N(l)  (gcc + 0x27580 + 4 * (l))
+#define CLOCK_OFF               (1u << 31)
+#define HWCG                    (1u << 1)               /* gcc-sm8450.c: hwcg_bit = 1 on the AHB branches */
+/* gcc_gpll0 (gcc-sm8450.c:50-55): enable_reg 0x62018 BIT(0), offset 0x0, LUCID_EVO.
+ * PLL_MODE = offset + 0x0 and its lock indication is BIT(31) (clk-alpha-pll.c:16,34). */
+#define GCC_GPLL0_ENABLE        (gcc + 0x62018)
+#define VOTE_GPLL0              (1u << 0)
+#define GCC_GPLL0_MODE          (gcc + 0x0000)
+#define PLL_LOCK                (1u << 31)
+#define XO_HZ                   19200000
+
+static uint32_t se_source_hz, se_clock_select;
+
+/* K60_DIAG_STAGE: k60_touch_se=<n> selects how far bring_up() is allowed to go.
+ * Nothing else changes: with the boot-arg absent the driver still returns
+ * before starting the thread. See DIAGNOSIS-GUIDE.md for the stage table. */
+static unsigned touch_stage;
+/* K60_FIFO_ESCAPE: see geni_spi_init(). 0 reproduces the old behaviour. */
+int k60_touch_allow_fifo_disabled;
+/* K60_FORCE_RCG: 1 = program the RCG divider even when DFS mode is advertised. */
+int k60_touch_force_rcg;
+
+/* K60_GENI_DMA: FIFO_IF_DISABLE is set, so the SE must move bytes with its
+ * internal DMA master. spi_use_dma is chosen once in geni_spi_init(), which
+ * also installs spi_transfer; callers must not overwrite the pointer. */
+static bool spi_use_dma;
+/* K60_TOUCH_DMA: the SE DMA path must be requested explicitly (k60_touch_dma=1).
+ * The default stays on the old, non-crashing FIFO probe so a DMA fault cannot
+ * reset the machine before the USB console is up. */
+static int k60_touch_dma_enable;
+/* K60_KEEP_CS: official transfer_dma ORs FRAGMENTATION into M_CMD0 only for
+ * keep_cs; the working reference passes 0. Default off, k60_touch_keep_cs=1 to force. */
+static int k60_touch_keep_cs;
+static bool (*spi_transfer)(const uint8_t *tx, uint8_t *rx, uint32_t length);
+static bool geni_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length);
+static bool geni_dma_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length);
+/* apps_smmu takeover: only true when the touch SE stream is proven to be in bypass. */
+static bool k60_se_smmu_bypass(void);
+
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	static const uint32_t parent[8] = { XO_HZ, 600000000, 0, 0, 0, 0, 300000000, 0 };
+	uint64_t hz = parent[cfg >> 8 & 7];
+	uint32_t divider = cfg & 0x1f, mode = cfg >> 12 & 3;
+
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffff) + (m & 0xffff);
+
+		if (n) {
+			hz = hz * (m & 0xffff) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+static bool
+cbcr_running(uint32_t cbcr)
+{
+	/* TouchProbe.cpp:406 -- a hardware-clock-gated branch (bit 1) reports CLK_OFF while
+	 * idle and wakes on the next access, so only a branch without that bit must have
+	 * CLK_OFF clear. Demanding CLK_OFF==0 from a gated branch is a false negative. */
+	return !(cbcr & CLOCK_OFF) || (cbcr & HWCG);
+}
+
+static bool
+clocks_on(void)
+{
+	uint32_t m_ahb = 0, s_ahb = 0, core = 0, core2x = 0, se4 = 0, vote;
+	const char *problem = NULL;
+	bool ok = false;
+
+	/* K60_DIAG_STAGE.  A boot that dies produces no console at all, and the
+	 * ramoops ring does not survive the reset (every single capture in
+	 * evidence/ prints "K60PREV none"), so a printf-only probe cannot be read
+	 * back.  The only per-step observable is therefore "did the whole boot
+	 * survive", so every group of accesses sits behind its own stage number.
+	 *
+	 *   1  GPIO reset/int only                      (usblog-20261108-213652 proved it)
+	 *   2  QUP0 vote + DFSR + SE4 RCG + M/S/SE4 CBCR (proved in 221038 / 233955)
+	 *   3  GPLL0: RMW of 0x62018 and read of 0x100000   <-- never executed before
+	 *   4  CORE / CORE_2X CBCR at 0x33000 / 0x3300c     <-- never executed before
+	 *   5  geni_spi_init(): first touch of the 0x990000 window
+	 *   6  io_supply_on(): the RPMh RSC writes
+	 */
+	printf("Pong touch: DIAG clocks entry stage=%u\n", touch_stage);
+	if (touch_stage < 3) {
+		printf("Pong touch: DIAG stop in clocks_on (no GCC access)\n");
+		return false;
+	}
+
+	if (touch_stage >= 3) {
+		/* stage 3: the two accesses this round introduced.  GPLL0 feeds
+		 * gcc_qupv3_wrap0_s4_clk_src (gcc-sm8450.c gcc_parent_map_0:
+		 * 0 TCXO, 1 GPLL0 main, 6 GPLL0 even); 0x62018 bit0 is its enable
+		 * (gcc-sm8450.c:39-47), 0x0 is PLL_MODE with lock at bit31. */
+		printf("Pong touch: DIAG s3 pre-gpll0 (first access 0x%llx)\n",
+		    (unsigned long long)(GCC_PHYS + 0x62018));
+		wr(GCC_GPLL0_ENABLE, rd(GCC_GPLL0_ENABLE) | VOTE_GPLL0);
+		printf("Pong touch: DIAG s3 gpll0 enable ok\n");
+		for (int i = 0; i < 10000; i++) {
+			if (rd(GCC_GPLL0_MODE) & PLL_LOCK) break;
+			sleep_us(10);
+		}
+		printf("Pong touch: DIAG s3 gpll0 vote=%08x mode=%08x\n",
+		    rd(GCC_GPLL0_ENABLE), rd(GCC_GPLL0_MODE));
+	}
+
+	printf("Pong touch: DIAG s2 pre-vote (first access 0x%llx)\n",
+	    (unsigned long long)(GCC_PHYS + 0x62008));
+	vote = rd(GCC_VOTE);
+	printf("Pong touch: DIAG s2 vote=%08x\n", vote);
+	wr(GCC_VOTE, vote | VOTE_QUP0_CORE_2X | VOTE_QUP0_CORE | VOTE_QUP0_M_AHB | VOTE_QUP0_S_AHB);
+	printf("Pong touch: DIAG s2 post-vote\n");
+	extern int k60_touch_force_rcg;
+	if ((rd(GCC_QUP0_SE4_DFSR) & 1) && !k60_touch_force_rcg) {
+		/* K60_PERF_DUMP: the clock never starts (cbcr bit30=0) and dfsr bit0=1
+		 * says the RCG is in DFS mode, so print every preset level: cfg/m/n and
+		 * the rate rcg_rate() derives. This is what tells us whether a usable
+		 * level exists at all and which one the hardware is actually on. */
+		for (uint32_t level = 0; level < 8; level++) {
+			uint32_t pc = rd(GCC_QUP0_SE4_PERF_CFG(level));
+			uint32_t pm = rd(GCC_QUP0_SE4_PERF_M(level));
+			uint32_t pn = rd(GCC_QUP0_SE4_PERF_N(level));
+			printf("Pong touch: PERF[%u] cfg=%#x m=%#x n=%#x hz=%u\n",
+			    level, pc, pm, pn, rcg_rate(pc, pm, pn));
+		}
+		/* preset rates: the lowest that is at least 4 MHz */
+		for (uint32_t level = 0; level < 8; level++) {
+			uint32_t hz = rcg_rate(rd(GCC_QUP0_SE4_PERF_CFG(level)), rd(GCC_QUP0_SE4_PERF_M(level)),
+			    rd(GCC_QUP0_SE4_PERF_N(level)));
+
+			if (hz >= 4000000 && (se_source_hz == 0 || hz < se_source_hz)) {
+				se_source_hz = hz;
+				se_clock_select = level;
+			}
+		}
+		if (se_source_hz == 0) {
+			problem = "no usable preset clock rate";
+			goto out;
+		}
+		/* K60_ROOT_ON: the real blocker is CMD_ROOT_OFF (CMD bit31), not
+		 * DFS_EN. Linux clk-rcg2.c:74 says the root is enabled only when
+		 * (cmd & CMD_ROOT_OFF) == 0; our CMD reads 0x80000000, i.e. the RCG
+		 * root is switched OFF, so no rate -- DFS or not -- produces a clock.
+		 * DFS_EN itself is DFSR bit0 and already reads 1 (dfsr=0x21).
+		 * Clearing ROOT_OFF and committing with CMD_UPDATE (CMD bit0) is the
+		 * documented enable sequence (clk-rcg2.c:118-128). */
+		printf("Pong touch: ROOT_ON pre cmd=%#x cbcr=%#x\n",
+		    rd(GCC_QUP0_SE4_CMD), rd(GCC_QUP0_SE4_CBCR));
+		wr(GCC_QUP0_SE4_CMD, rd(GCC_QUP0_SE4_CMD) & ~(1u << 31));
+		wr(GCC_QUP0_SE4_CMD, rd(GCC_QUP0_SE4_CMD) | 1u);
+		for (int i = 0; i < 500 && (rd(GCC_QUP0_SE4_CMD) & 1u); i++) {
+			sleep_us(10);
+		}
+		printf("Pong touch: ROOT_ON post cmd=%#x cbcr=%#x\n",
+		    rd(GCC_QUP0_SE4_CMD), rd(GCC_QUP0_SE4_CBCR));
+	} else {
+		/* the crystal, undivided: nothing else has to be running */
+		/* gcc_qupv3_wrap0_s4_clk_src sets hw_clk_ctrl (clk-rcg2.c:553-555, CFG bit 20),
+		 * so preserve it. hid_width is 5: the divider is bits [4:0] within 0x371f. */
+		printf("Pong touch: DIAG s2 pre-rcg\n");
+		wr(GCC_QUP0_SE4_CFG, (rd(GCC_QUP0_SE4_CFG) & ~0x371fu) | (1u << 20) | 1);
+		wr(GCC_QUP0_SE4_CMD, rd(GCC_QUP0_SE4_CMD) | 1);
+		for (int i = 0; i < 500 && (rd(GCC_QUP0_SE4_CMD) & 1); i++) {
+			sleep_us(10);
+		}
+		printf("Pong touch: DIAG s2 post-rcg cmd=%08x\n", rd(GCC_QUP0_SE4_CMD));
+		if (rd(GCC_QUP0_SE4_CMD) & 1) {
+			problem = "the serial engine's clock does not take its configuration";
+			goto out;
+		}
+		se_source_hz = XO_HZ;
+		se_clock_select = 0;
+	}
+	wr(GCC_VOTE, rd(GCC_VOTE) | VOTE_QUP0_SE4);
+	/* 2. Verify the branches before anything reads the engine.
+	 * M_AHB and S_AHB are hardware-clock-gated (bit1 set): such a branch reports CLK_OFF
+	 * while idle and wakes on access, so CLK_OFF alone does NOT mean "not running"
+	 * (clk-branch.c:61-72, TouchProbe.cpp:404-406). */
+	printf("Pong touch: DIAG s2 pre-cbcr\n");
+	for (int i = 0; i < 2000; i++) {
+		m_ahb = rd(GCC_QUP0_M_AHB_CBCR);
+		s_ahb = rd(GCC_QUP0_S_AHB_CBCR);
+		se4 = rd(GCC_QUP0_SE4_CBCR);
+		ok = cbcr_running(m_ahb) && cbcr_running(s_ahb) && !(se4 & CLOCK_OFF);
+		if (ok) break;
+		sleep_us(10);
+	}
+	printf("Pong touch: DIAG s2 post-cbcr m=%08x s=%08x se=%08x ok=%u\n",
+	    m_ahb, s_ahb, se4, ok);
+
+	if (touch_stage < 4) {
+		printf("Pong touch: DIAG stop before CORE/CORE_2X\n");
+		goto out;
+	}
+
+	/* stage 4: the QUP0 core branches.  Offset 0x33000 / 0x3300c per
+	 * gcc-sm8450.c:1939-1947 and 1926-1934; halt_check BRANCH_HALT_VOTED. */
+	printf("Pong touch: DIAG s4 pre-core (0x%llx, 0x%llx)\n",
+	    (unsigned long long)(GCC_PHYS + 0x33000), (unsigned long long)(GCC_PHYS + 0x3300c));
+	core = rd(GCC_QUP0_CORE_CBCR);
+	printf("Pong touch: DIAG s4 core=%08x\n", core);
+	core2x = rd(GCC_QUP0_CORE_2X_CBCR);
+	printf("Pong touch: DIAG s4 core2x=%08x\n", core2x);
+	ok = ok && !(core & CLOCK_OFF) && !(core2x & CLOCK_OFF);
+	printf("Pong touch: DIAG s4 verdict ok=%u\n", ok);
+
+out:
+	vote = rd(GCC_VOTE);
+	/* The CORE pair is only printed when its stage allowed the read: stage 1 and
+	 * 2 must touch nothing that has never been touched on a K60, otherwise the
+	 * staged probe would reintroduce the very doubt it is meant to remove. */
+	if (touch_stage >= 4) {
+		printf("Pong touch: clocks vote=%08x cbcr m=%08x s=%08x se=%08x core=%08x core2x=%08x\n",
+		    vote, rd(GCC_QUP0_M_AHB_CBCR), rd(GCC_QUP0_S_AHB_CBCR), rd(GCC_QUP0_SE4_CBCR),
+		    rd(GCC_QUP0_CORE_CBCR), rd(GCC_QUP0_CORE_2X_CBCR));
+	} else if (touch_stage >= 2) {
+		printf("Pong touch: clocks vote=%08x cbcr m=%08x s=%08x se=%08x core=-- core2x=--\n",
+		    vote, rd(GCC_QUP0_M_AHB_CBCR), rd(GCC_QUP0_S_AHB_CBCR), rd(GCC_QUP0_SE4_CBCR));
+	} else {
+		printf("Pong touch: clocks vote=(not read) no GCC register touched\n");
+	}
+	printf("Pong touch: clocks se4 cfg=%08x cmd=%08x dfsr=%08x src_hz=%u sel=%u\n",
+	    rd(GCC_QUP0_SE4_CFG), rd(GCC_QUP0_SE4_CMD), rd(GCC_QUP0_SE4_DFSR), se_source_hz, se_clock_select);
+	if (problem) {
+		printf("Pong touch: clocks verdict=halted (%s)\n", problem);
+	} else {
+		printf("Pong touch: clocks verdict=%s\n", ok ? "running" : "halted");
+	}
+	if (!ok) {
+		printf("Pong touch: clocks halted, refusing to touch serial engine %#llx\n", se_phys);
+	}
+	return ok;
+}
+
+/* ---- SPI through the serial engine (GENI) ---------------------------------------------------------- */
+
+#define SE_PHYS                 se_phys
+#define SE_SIZE                 0x4000UL
+#define GENI_FORCE_DEFAULT      (se + 0x020)
+#define GENI_OUTPUT_CTRL        (se + 0x024)
+#define GENI_CGC_CTRL           (se + 0x028)
+#define GENI_STATUS             (se + 0x040)    /* bit 0: a command is running */
+#define GENI_SER_M_CLK_CFG      (se + 0x048)    /* bit 0 enable, [15:4] divider */
+#define GENI_IF_DISABLE_RO      (se + 0x064)    /* bit 0: no FIFO interface */
+#define GENI_FW_REVISION_RO     (se + 0x068)    /* [15:8] protocol: 1 = SPI */
+#define GENI_CLK_SEL            (se + 0x07c)
+/* K60_SE_IF_ENABLE: upstream Linux grew three writable SE-interface registers that
+ * v6.6 does not have. They live in the SE config window, after the CSR block:
+ *   SE_GENI_CLK_CTRL       0x2000   BIT(0) = SER_CLK_SEL
+ *   SE_DMA_IF_EN           0x2004   BIT(0) = DMA_IF_EN      <- the SE's DMA interface
+ *   SE_FIFO_IF_DISABLE     0x2008   BIT(0) = FIFO_IF_DISABLE
+ * References (line numbers):
+ *  - Linux 7.0.14 drivers/soc/qcom/qcom-geni-se.c:230-232 (the three offsets),
+ *    :277-278, which defines DMA_IF_EN as BIT(0) under the
+ *    "GENI_DMA_IF_EN fields" heading (the literal comment marker is omitted
+ *    here on purpose: writing it would close this block comment early).
+ *  - Same file :1284 "geni_setbits32(se->base + SE_DMA_IF_EN, DMA_IF_EN);"
+ *    with the comment at :1283 "Serial engine DMA interface is enabled.",
+ *    and :1286-1290 which drives SE_FIFO_IF_DISABLE from the chosen mode
+ *    (clear for GENI_SE_FIFO, set otherwise).
+ *  - Same file :1279-1281 shows the RAM-programming completion handshake:
+ *    set PROG_RAM_{S,H}CLK_OFF, write SE_GENI_CLK_CTRL, clear them again.
+ *  - Same SoC family, this board's own BT GENI component
+ *    QcaBluetooth/src/qbt_geni_regs.h:68 "#define G_DMA_IF_EN 0x2004u" and
+ *    QcaBluetooth/src/qbt_geni.c:56
+ *    "wr(g,G_DMA_MODE,1);wr(g,G_DMA_IF_EN,rd(g,G_DMA_IF_EN)|1);" -- i.e. every
+ *    working GENI DMA user on this platform sets 0x2004 bit0, and nothing in the
+ *    touch driver ever did. GENI_IF_DISABLE_RO (0x064) bit0 is only the read-only
+ *    mirror of 0x2008. */
+/* These three are offsets of the QUP **wrapper** base, not the SE base:
+ * Linux qcom-geni-se.c:1374 maps wrapper->base from the wrapper's reg[0], and
+ * geni_se_config_packing() then writes wrapper_base + 0x2000/0x2004/0x2008.
+ * On K60 /soc/spi@990000 has qcom,wrapper-core = <0xc4>, i.e. the wrapper is
+ * /soc/qcom,qupv3_0_geni_se@9c0000 -> physical 0x9c0000. Writing them at
+ * se_phys + 0x2004 (0x992004) hits an unimplemented address and the kernel
+ * takes a data abort (observed far = se + 0x2004). */
+#define QUPV3_0_WRAPPER_PHYS    0x9c0000UL
+#define SE_GENI_CLK_CTRL        (wrapper + 0x2000)
+#define SE_DMA_IF_EN            (wrapper + 0x2004)   /* bit 0: serial engine DMA interface enable */
+#define SE_FIFO_IF_DISABLE      (wrapper + 0x2008)   /* bit 0: the writable form of 0x064 */
+#define DMA_IF_EN               (1u << 0)
+#define FIFO_IF_DISABLE         (1u << 0)
+#define SER_CLK_SEL             (1u << 0)
+#define PROG_RAM_HCLK_OFF       (1u << 8)       /* qcom-geni-se.c:248 (CFG_AHB... block) */
+#define SPI_CPHA                (se + 0x224)
+#define SPI_LOOPBACK            (se + 0x22c)
+#define SPI_CPOL                (se + 0x230)
+#define SPI_DEMUX_OUTPUT_INV    (se + 0x24c)
+#define SPI_DEMUX_SEL           (se + 0x250)
+#define GENI_BYTE_GRAN          (se + 0x254)
+#define GENI_DMA_MODE_EN        (se + 0x258)
+#define SPI_TRANS_CFG           (se + 0x25c)
+#define GENI_TX_PACKING_CFG0    (se + 0x260)
+#define GENI_TX_PACKING_CFG1    (se + 0x264)
+#define SPI_WORD_LEN            (se + 0x268)
+#define SPI_TX_TRANS_LEN        (se + 0x26c)
+#define SPI_RX_TRANS_LEN        (se + 0x270)
+#define SPI_DELAY_COUNTERS      (se + 0x278)
+#define GENI_RX_PACKING_CFG0    (se + 0x284)
+#define GENI_RX_PACKING_CFG1    (se + 0x288)
+#define GENI_M_CMD0             (se + 0x600)    /* [31:27] operation, [15:0] params */
+/* Linux geni_se_setup_m_cmd(): m_cmd = (cmd << M_OPCODE_SHFT) | (params & M_PARAMS_MSK)
+ * and spi-geni-qcom.c:898 passes FRAGMENTATION on every transfer.
+ * CORRECTED: FRAGMENTATION is BIT(2), not BIT(0). Three independent sources:
+ *  - Linux v6.6 drivers/spi/spi-geni-qcom.c:69  "#define FRAGMENTATION BIT(2)"
+ *    (the neighbour lines :67-70 define SPI_PRE_CMD_DELAY BIT(0), TIMESTAMP_BEFORE
+ *    BIT(1), FRAGMENTATION BIT(2), TIMESTAMP_AFTER BIT(3), POST_CMD_DELAY BIT(4)).
+ *  - downstream SM8475 5.10 spi-geni-qcom.downstream.c:62  "#define FRAGMENTATION BIT(2)"
+ *  - local official component QcomGeniSpi/GeniSpi.h:86
+ *    "#define GENI_M_PARAM_FRAGMENTATION (1u<<2)"
+ * The old value (1u) was SPI_PRE_CMD_DELAY, i.e. the engine was asked for a pre-command
+ * delay instead of fragmentation; that is what made M_CMD0 read back 0x8000001 while
+ * the driver printed it as "FRAGMENTATION". */
+#define M_PARAMS_FRAGMENTATION  (1u << 2)
+/* SPI chip-select opcodes for SE_GENI_M_CMD0 (spi-geni-qcom.c:63-64).
+ * The SE drives its own CS; with the four pads muxed to qup4 the GPIO-level CS
+ * from the bit-bang path has no effect, so a transfer command issued without a
+ * preceding SPI_CS_ASSERT is dropped by the sequencer. */
+#define SPI_CS_ASSERT           8
+#define SPI_CS_DEASSERT         9
+#define GENI_M_CMD_CTRL         (se + 0x604)    /* bit 2 cancel, bit 1 abort */
+#define GENI_M_IRQ_STATUS       (se + 0x610)
+#define GENI_M_IRQ_EN           (se + 0x614)
+#define GENI_M_IRQ_CLEAR        (se + 0x618)
+#define GENI_S_IRQ_CLEAR        (se + 0x648)
+#define GENI_TX_FIFO            (se + 0x700)
+#define GENI_RX_FIFO            (se + 0x780)
+#define GENI_TX_FIFO_STATUS     (se + 0x800)    /* [27:0] words */
+#define GENI_RX_FIFO_STATUS     (se + 0x804)    /* bit 31 last, [30:28] bytes of the last word, [24:0] words */
+#define GENI_TX_WATERMARK       (se + 0x80c)
+#define GENI_RX_WATERMARK       (se + 0x810)
+#define GENI_RX_RFR_WATERMARK   (se + 0x814)
+#define SE_DMA_TX_IRQ_CLR       (se + 0xc44)
+#define SE_DMA_RX_IRQ_CLR       (se + 0xd44)
+#define SE_GSI_EVENT_EN         (se + 0xe18)
+#define SE_IRQ_EN               (se + 0xe1c)
+#define SE_HW_PARAM_0           (se + 0xe24)    /* [29:24] FIFO width in bits, [21:16] FIFO depth in words */
+#define SE_HW_PARAM_1           (se + 0xe28)    /* [29:24] RX FIFO width in bits */
+#define SE_DMA_GENERAL_CFG      (se + 0xe30)
+/* SE DMA master registers. Offsets verified against Linux qcom-geni-se.c /
+ * geni-se.h (SM8475 layout) and the local QcomGeniSpi/GeniSpi.h. */
+#define SE_DMA_TX_PTR_L         (se + 0xc30)
+#define SE_DMA_TX_PTR_H         (se + 0xc34)
+#define SE_DMA_TX_ATTR          (se + 0xc38)
+#define SE_DMA_TX_LEN           (se + 0xc3c)
+#define SE_DMA_TX_IRQ_STAT      (se + 0xc40)
+#define SE_DMA_TX_IRQ_EN_SET    (se + 0xc4c)
+#define SE_DMA_TX_LEN_IN        (se + 0xc54)
+#define SE_DMA_TX_FSM_RST       (se + 0xc58)
+#define SE_DMA_RX_PTR_L         (se + 0xd30)
+#define SE_DMA_RX_PTR_H         (se + 0xd34)
+#define SE_DMA_RX_ATTR          (se + 0xd38)
+#define SE_DMA_RX_LEN           (se + 0xd3c)
+#define SE_DMA_RX_IRQ_STAT      (se + 0xd40)
+#define SE_DMA_RX_IRQ_EN_SET    (se + 0xd4c)
+#define SE_DMA_RX_LEN_IN        (se + 0xd54)
+#define SE_DMA_RX_FSM_RST       (se + 0xd58)
+
+#define M_CMD_DONE              (1u << 0)
+/* Linux geni-se.h: M_COMMON_GENI_M_IRQ_EN = GENMASK(6,1) | M_IO_DATA_DEASSERT_EN
+ * | M_IO_DATA_ASSERT_EN | M_RX/TX_FIFO_RD/WR_ERR_EN = 0x33c0007e.
+ * geni_se_init() ORs this in; geni_se_select_dma_mode() then clears
+ * M_CMD_DONE_EN | M_TX_FIFO_WATERMARK_EN | M_RX_FIFO_WATERMARK_EN | M_RX_FIFO_LAST_EN. */
+#define M_COMMON_GENI_M_IRQ_EN  0x33c0007eu
+/* Linux geni-se.h: S_COMMON_GENI_S_IRQ_EN = GENMASK(6,1) | S_IO_DATA_ASSERT_EN
+ * | S_IO_DATA_DEASSERT_EN | S_RX_FIFO_RD/WR_ERR_EN = 0x03c0007e.
+ * Official QcomGeniSpi sets both M and S enables (GeniSpi.c:94). */
+#define S_COMMON_GENI_S_IRQ_EN  0x03c0007eu
+/* 0x644, NOT 0x614: 0x614 is SE_GENI_M_IRQ_EN.
+ * v6.6 geni-se.h:94, 7.0.14 qcom-geni-se.c:205 and official GeniSpi.h:38 all
+ * say 0x644 (GeniSpi.h:36 shows M_IRQ_EN = 0x614 for contrast). */
+#define SE_GENI_S_IRQ_EN        (se + 0x644)
+/* The four bits DMA mode must have clear (geni_se_select_dma_mode). */
+#define M_FIFO_ONLY_IRQ_BITS    ((1u << 0) | (1u << 26) | (1u << 27) | (1u << 30))
+/* GENI_M_CMD_CTRL_REG bits (geni-se.h.v6.6:150-153): these are WRITE-command bits,
+ * NOT the status bits that report completion. The old names M_CMD_CANCEL/M_CMD_ABORT
+ * were also used as SE_GENI_M_IRQ_STATUS completion masks, which is wrong: completion
+ * is reported by M_CMD_CANCEL_EN (BIT 4) / M_CMD_ABORT_EN (BIT 5) (geni-se.h.v6.6:170-171).
+ * The two definitions now say which register each belongs to. */
+#define M_GENI_CMD_CANCEL       (1u << 2)       /* write: SE_GENI_M_CMD_CTRL_REG */
+#define M_GENI_CMD_ABORT        (1u << 1)       /* write: SE_GENI_M_CMD_CTRL_REG */
+#define M_ERRORS                ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define SPI_FULL_DUPLEX         (3u << 27)
+#define DMA_DONE                (1u << 0)
+#define DMA_EOT                 (1u << 1)
+#define DMA_AHB_ERR             (1u << 2)
+#define DMA_RESET_DONE          (1u << 3)
+#define DMA_TX_ATTR_EOT_BUF     (1u << 0)
+/* Packing vector fields, from QcomGeniSpi/GeniSpi.h:146-151 (identical to
+ * Linux qcom-geni-se.c:413-418). One vector is 10 bits. */
+#define GENI_PACK_START_SHIFT   5       /* GeniSpi.h:146 */
+#define GENI_PACK_DIR_SHIFT     4       /* GeniSpi.h:147 */
+#define GENI_PACK_LEN_SHIFT     1       /* GeniSpi.h:148 */
+#define GENI_PACK_STOP          (1u << 0)   /* GeniSpi.h:149 */
+#define GENI_PACK_VECTOR_SHIFT  10      /* GeniSpi.h:150 */
+#define GENI_PACK_VECTORS       4       /* GeniSpi.h:151 */
+#define GENI_WORD_LEN_MIN       4       /* GeniSpi.h:104 (Linux: MIN_WORD_LEN, spi-geni-qcom.c:43) */
+#define GENI_WORD_LEN_MSK       0x3ffu  /* 10 bits (Linux: WORD_LEN_MSK GENMASK(9,0), spi-geni-qcom.c:42) */
+#define SE_HW_TX_FIFO_WIDTH_SHIFT 24    /* geni-se.h.v6.6:256 (TX_FIFO_WIDTH_SHFT) */
+#define SE_HW_TX_FIFO_WIDTH_MSK 0x3fu   /* geni-se.h.v6.6:255 (TX_FIFO_WIDTH_MSK GENMASK(29,24)) */
+/* QUP wrapper hardware version, wrapper base + 0x4 (Linux 7.0.14 :179,
+ * official GeniSpi.h:77). Drives the FIFO-depth mask and oversampling. */
+#define QUPV3_HW_VER_REG        0x4u
+/* QUP wrapper registers (7.0.14 qcom-geni-se.c:180-193):
+ *   QUPV3_SE_AHB_M_CFG      0x118  AHB_M_CLK_CGC_ON = BIT(0)
+ *   QUPV3_COMMON_CGC_CTRL   0x21c  COMMON_CSR_SLV_CLK_CGC_ON = BIT(0)
+ * geni_se_config_packing() enables both (:1223-1225). The AHB_M clock gate is
+ * the one the SE's DMA master needs in order to move data: leave it shut and
+ * the engine accepts M_CMD0 but never issues a transfer. */
+#define QUPV3_SE_AHB_M_CFG      0x118u
+#define QUPV3_COMMON_CGC_CTRL   0x21cu
+#define AHB_M_CLK_CGC_ON        (1u << 0)
+#define COMMON_CSR_SLV_CLK_CGC_ON (1u << 0)
+static uint32_t qup_hw_version;
+static uint32_t qup_oversampling = 1;
+
+static uint32_t fifo_depth;
+static uint32_t fifo_width_bits;        /* SE_HW_PARAM_0 [29:24], bits per FIFO word */
+
+/* geni_spi_read_info() from QcomGeniSpi/GeniSpi.c:20-35, reduced to the two
+ * fields the packing algorithm needs. fifo_width_bits is the width of one FIFO
+ * word in bits (32 on every QUPv3 SE) and is what decides how many protocol
+ * words get packed into one FIFO word. */
+static uint32_t
+k60_geni_read_info(void)
+{
+	uint32_t hw_param0 = rd(SE_HW_PARAM_0), hw_param1 = rd(SE_HW_PARAM_1);
+
+	fifo_width_bits = hw_param0 >> SE_HW_TX_FIFO_WIDTH_SHIFT & SE_HW_TX_FIFO_WIDTH_MSK;   /* GeniSpi.c:33 */
+	printf("Pong touch: GENI read_info hw_param0=%#x hw_param1=%#x fifo_width_bits=%u rx_width=%u\n",
+	    hw_param0, hw_param1, fifo_width_bits,
+	    hw_param1 >> 24 & 0x3f);
+	if (!fifo_width_bits) {
+		printf("Pong touch: GENI hw_param0 reports fifo width 0, assuming 32\n");
+		fifo_width_bits = 32;
+	}
+	return fifo_width_bits;
+}
+
+/* config_packing() from QcomGeniSpi/GeniSpi.c:38-66, transliterated line for
+ * line. Called with bpw = 8 and pack_words = fifo_width_bits/bpw, which for a
+ * 32-bit FIFO word is 4, so all four vectors are used:
+ *   vector i = (idx << 5) | (msb_first << 4) | ((len - 1) << 1); the last one
+ *   also gets STOP. With bpw=8 MSB-first: start 7, 15, 23, 31, len 8 each, so
+ *   cfg0 = 0xfe | (0x1fe << 10) = 0x0007f8fe and
+ *   cfg1 = 0x2fe | (0x3ff << 10) = 0x000ffefe.
+ * MEASURED RESULT: those are exactly the two values the patch used to hard-code.
+ * So the packing vectors were never the defect - they already matched the
+ * official output bit for bit (verified by packing_sim.py over every bpw/pack/
+ * msb combination). This port therefore does not change behaviour; it replaces
+ * a magic constant with the algorithm that derives it and adds the runtime
+ * fifo-reading that makes the derivation honest. The actual "DMA never starts"
+ * defect was the M_CMD0 / descriptor ordering in geni_dma_transfer(). */
+static void
+geni_config_packing(uint32_t bpw, uint32_t pack_words, int msb_first)
+{
+	uint32_t cfg[GENI_PACK_VECTORS] = {0};
+	int idx_start = msb_first ? (int)bpw - 1 : 0, idx = idx_start;      /* GeniSpi.c:40 */
+	int idx_delta = msb_first ? -8 : 8;                                 /* GeniSpi.c:41 */
+	uint32_t ceil_bpw = (bpw + 7) & ~7u;                                /* GeniSpi.c:42 */
+	uint32_t iter = ceil_bpw * pack_words / 8;                          /* GeniSpi.c:43 */
+	int temp_bpw = (int)bpw;                                            /* GeniSpi.c:44 */
+	uint32_t cfg0, cfg1;
+
+	if (iter == 0 || iter > GENI_PACK_VECTORS) {                        /* GeniSpi.c:45 */
+		printf("Pong touch: GENI packing iter=%u out of range, not configured\n", iter);
+		return;
+	}
+	for (uint32_t i = 0; i < iter; i++) {                               /* GeniSpi.c:46 */
+		int len = (temp_bpw < 8 ? temp_bpw : 8) - 1;                /* GeniSpi.c:47 */
+
+		cfg[i] = ((uint32_t)idx << GENI_PACK_START_SHIFT) |          /* GeniSpi.c:48 */
+		    ((uint32_t)(msb_first != 0) << GENI_PACK_DIR_SHIFT) |
+		    ((uint32_t)len << GENI_PACK_LEN_SHIFT);                  /* GeniSpi.c:49 */
+		if (temp_bpw <= 8) {                                        /* GeniSpi.c:50 */
+			idx = (int)(i + 1) * 8 + idx_start;                 /* GeniSpi.c:51 */
+			temp_bpw = (int)bpw;                                /* GeniSpi.c:52 */
+		} else {
+			idx += idx_delta;                                   /* GeniSpi.c:54 */
+			temp_bpw -= 8;                                      /* GeniSpi.c:55 */
+		}
+	}
+	cfg[iter - 1] |= GENI_PACK_STOP;                                    /* GeniSpi.c:58 */
+	cfg0 = cfg[0] | (cfg[1] << GENI_PACK_VECTOR_SHIFT);                  /* GeniSpi.c:59 */
+	cfg1 = cfg[2] | (cfg[3] << GENI_PACK_VECTOR_SHIFT);                  /* GeniSpi.c:60 */
+	wr(GENI_TX_PACKING_CFG0, cfg0);                                     /* GeniSpi.c:61 */
+	wr(GENI_TX_PACKING_CFG1, cfg1);                                     /* GeniSpi.c:62 */
+	wr(GENI_RX_PACKING_CFG0, cfg0);                                     /* GeniSpi.c:63 */
+	wr(GENI_RX_PACKING_CFG1, cfg1);                                     /* GeniSpi.c:64 */
+	if (pack_words || bpw == 32) {                                      /* GeniSpi.c:65 */
+		wr(GENI_BYTE_GRAN, bpw / 16);
+	}
+	printf("Pong touch: GENI fifo_width_bits=%u pack=%u packcfg0=%#x packcfg1=%#x wordlen=%#x bytegran=%#x\n",
+	    fifo_width_bits, pack_words, cfg0, cfg1,
+	    (bpw - GENI_WORD_LEN_MIN) & GENI_WORD_LEN_MSK, rd(GENI_BYTE_GRAN));
+}
+
+/* set_word_len() from QcomGeniSpi/GeniSpi.c:68-72. pack_words is 4 whenever
+ * bpw divides fifo_width_bits, otherwise 1 (one protocol word per FIFO word). */
+static void
+geni_set_word_len(uint32_t bpw, int msb_first)
+{
+	uint32_t pack = (fifo_width_bits % bpw) ? 1 : fifo_width_bits / bpw;    /* GeniSpi.c:69 */
+
+	geni_config_packing(bpw, pack, msb_first);                              /* GeniSpi.c:70 */
+	wr(SPI_WORD_LEN, (bpw - GENI_WORD_LEN_MIN) & GENI_WORD_LEN_MSK);        /* GeniSpi.c:71 */
+}
+
+/* 0 = ready; otherwise why the engine cannot be used */
+static const char *
+geni_spi_init(uint32_t hz)
+{
+	uint32_t divider;
+
+	if ((rd(GENI_FW_REVISION_RO) >> 8 & 0xff) != 1) {
+		return "the serial engine has no SPI firmware";
+	}
+	/* K60_FIFO_ESCAPE: the board reports FIFO_IF_DISABLE (0x064 bit0 = 1).
+	 * Official QcomGeniSpi has two escape hatches (GeniSpi.c:80): use_dma, or
+	 * allow_fifo_disabled ("try FIFO mode even when FIFO_IF_DISABLE is set",
+	 * GeniSpi.h:208). k60_touch_fifo=1 keeps the old FIFO attempt for one boot;
+	 * otherwise the SE's internal DMA master is used (use_dma path). */
+	extern int k60_touch_allow_fifo_disabled;
+	if (rd(GENI_IF_DISABLE_RO) & 1) {
+		if (k60_touch_allow_fifo_disabled) {
+			printf("Pong touch: FIFO_IF_DISABLE set but k60_touch_fifo=1, trying anyway\n");
+		} else if (k60_touch_dma_enable) {
+			spi_use_dma = true;
+			printf("Pong touch: GENI FIFO disabled, using DMA path (k60_touch_dma=1)\n");
+		} else {
+			/* Linux spi_geni_init():695-720 does NOT treat FIFO_IF_DISABLE as
+			 * fatal in software: if it cannot get a GPI DMA channel it warns
+			 * and falls through to GENI_SE_FIFO anyway. Do the same here --
+			 * refusing the engine would rule out the only path left without
+			 * GPI support. */
+			printf("Pong touch: GENI reports FIFO_IF_DISABLE, but Linux falls back to FIFO here; trying FIFO\n");
+		}
+	}
+	{
+		uint32_t hw = rd(SE_HW_PARAM_0);
+		uint32_t major, minor, mask;
+
+		/* Official geni_spi_read_info(): the FIFO-depth field moved in QUP 3.10. */
+		if (wrapper) {
+			qup_hw_version = rd(wrapper + QUPV3_HW_VER_REG);
+		}
+		major = qup_hw_version >> 28;
+		minor = (qup_hw_version >> 16) & 0xfffu;
+		mask = ((major == 3 && minor >= 10) || major > 3) ? 0xff0000u : 0x3f0000u;
+		fifo_depth = (hw & mask) >> 16;
+		/* Official geni_spi_init():96-97 */
+		qup_oversampling = (major == 1 && minor == 0) ? 2 : 1;
+		printf("Pong touch: QUP hw_ver=%#x major=%u minor=%u mask=%#x depth=%u oversampling=%u\n",
+		    qup_hw_version, major, minor, mask, fifo_depth, qup_oversampling);
+	}
+	/* geni_spi_init() calls geni_spi_read_info() first (GeniSpi.c:75); the
+	 * FIFO width it reads is the input to the packing algorithm. */
+	(void)k60_geni_read_info();
+	{
+		/* K60_GENI_FW_CHECK: is the sequencer's program RAM actually loaded?
+		 * Linux geni_load_fw() fills SE_GENI_CFG_RAMN (0x1010) and the GENI
+		 * primitive table at SE_GENI_CFG_REG0 (0x100+n*4), and writes
+		 * SE_GENI_INIT_CFG_REVISION (0x0). Android's kernel does this at
+		 * driver probe; XNU boots with no such loader. If these read zero the
+		 * sequencer cannot execute any opcode -- which is exactly the observed
+		 * failure: M_CMD0 accepted, ACTIVE stuck, no IRQ, no DMA, no fault,
+		 * even for a bare SPI_CS_ASSERT. Read-only, all inside the mapped
+		 * 0x4000 SE window. */
+		/* K60_SE_PAGE0_ONLY: every SE offset at or above 0x1000 takes a data
+		 * abort on this QUP (measured: se+0x1010 for SE_GENI_CFG_RAMN,
+		 * se+0x2004 and wrapper+0x2004 for the config region). Only page 0 of
+		 * the SE window is hardware-backed, so the sequencer cannot be running
+		 * a downloaded program and there is nothing to read above 0xFFF.
+		 * Report only page 0: INIT_CFG_REVISION and the GENI primitive table. */
+		printf("Pong touch: GENI prog init_rev=%#x cfg_rev_s=%#x cfg0..7=%#x/%#x/%#x/%#x/%#x/%#x/%#x/%#x\n",
+		    (unsigned)rd(se + 0x0), (unsigned)rd(se + 0x4),
+		    (unsigned)rd(se + 0x100), (unsigned)rd(se + 0x104),
+		    (unsigned)rd(se + 0x108), (unsigned)rd(se + 0x10c),
+		    (unsigned)rd(se + 0x110), (unsigned)rd(se + 0x114),
+		    (unsigned)rd(se + 0x118), (unsigned)rd(se + 0x11c));
+	}
+	printf("Pong touch: GENI hw_param0=%#x fifo_depth=%u if_disable=%#x\n",
+	    rd(SE_HW_PARAM_0), fifo_depth, rd(GENI_IF_DISABLE_RO));
+	if (!spi_use_dma && fifo_depth < 4) {
+		printf("Pong touch: GENI reports fifo_depth=%u (<4); using 4 anyway like the FIFO fallback path\n",
+		    fifo_depth);
+	}
+	if (fifo_depth < 4) {
+		printf("Pong touch: fifo_depth=%u < 4, using 4\n", fifo_depth);
+		fifo_depth = 4;
+	}
+	wr(SE_GSI_EVENT_EN, 0);
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(GENI_S_IRQ_CLEAR, 0xffffffff);
+	wr(SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	wr(GENI_CGC_CTRL, rd(GENI_CGC_CTRL) | 0x7f);
+	/* K60_QUP_AHB_MASTER: the DMA master's AHB clock gate. 7.0.14 enables this in
+	 * geni_se_config_packing():1223 with AHB_M_CLK_CGC_ON, and the common CSR
+	 * slave clock at :1225. Without the AHB_M gate the SE accepts a command but
+	 * its DMA master can never issue a transfer. */
+	if (wrapper) {
+		wr(wrapper + QUPV3_SE_AHB_M_CFG, rd(wrapper + QUPV3_SE_AHB_M_CFG) | AHB_M_CLK_CGC_ON);
+		wr(wrapper + QUPV3_COMMON_CGC_CTRL,
+		    rd(wrapper + QUPV3_COMMON_CGC_CTRL) | COMMON_CSR_SLV_CLK_CGC_ON);
+		printf("Pong touch: QUP wrapper ahb_m_cfg=%#x common_cgc=%#x\n",
+		    rd(wrapper + QUPV3_SE_AHB_M_CFG), rd(wrapper + QUPV3_COMMON_CGC_CTRL));
+	}
+	wr(SE_DMA_GENERAL_CFG, rd(SE_DMA_GENERAL_CFG) | 0xf);
+	wr(GENI_OUTPUT_CTRL, 0x7f);
+	wr(GENI_FORCE_DEFAULT, 1);
+	wr(GENI_DMA_MODE_EN, spi_use_dma ? (rd(GENI_DMA_MODE_EN) | 1u) : (rd(GENI_DMA_MODE_EN) & ~1u));
+	/* K60_SE_IF_ENABLE -- THE BLOCKER. GENI_DMA_MODE_EN (0x258) only tells the protocol
+	 * sequencer which transport to use; the byte-moving interface itself is gated by
+	 * SE_DMA_IF_EN (0x2004 bit0), and that gate is closed at reset. Linux 7.0.14
+	 * qcom-geni-se.c:1283-1290 opens it and then drives SE_FIFO_IF_DISABLE from the mode:
+	 *     geni_setbits32(se->base + SE_DMA_IF_EN, DMA_IF_EN);
+	 *     if (mode == GENI_SE_FIFO) geni_clrbits32(se->base + SE_FIFO_IF_DISABLE, FIFO_IF_DISABLE);
+	 *     else                     geni_setbits32(se->base + SE_FIFO_IF_DISABLE, FIFO_IF_DISABLE);
+	 * This board's own BT GENI transport does the same at QcaBluetooth/src/qbt_geni.c:56
+	 *     wr(g,G_DMA_MODE,1); wr(g,G_DMA_IF_EN,rd(g,G_DMA_IF_EN)|1);
+	 * The touch driver set 0x258 but never 0x2004, so M_CMD0 was accepted by the
+	 * sequencer (STATUS bit0 = M_GENI_CMD_ACTIVE stuck, cmd0 reads back) while the DMA
+	 * master stayed disconnected: no descriptor is ever fetched, hence stat_tx=0,
+	 * stat_rx=0, txin=0, rxin=0 and no M_CMD_DONE. Linux v6.6/v5.10 do not have these
+	 * registers in their source at all, which is why an audit against v6.6 could not
+	 * find the missing step. */
+	/*
+	 * K60_QUP_NO_CONFIG_REGION: DISABLED -- this block is documentation only.
+	 *
+	 * The QUP config region at +0x2000 is NOT implemented on this SoC's QUP.
+	 * Measured on device: touching it takes a kernel data abort, and the fault
+	 * address is base + 0x2004 for BOTH candidate bases:
+	 *     se_phys + 0x2004 = 0x992004   -> far = se + 0x2004      (abort)
+	 *     wrapper  + 0x2004 = 0x9c2004  -> far = wrapper + 0x2004 (abort)
+	 * A data abort (not a read returning 0) means the address is unbacked, so
+	 * SE_GENI_CLK_CTRL / SE_DMA_IF_EN / SE_FIFO_IF_DISABLE exist only on newer
+	 * QUP revisions. Linux 7.0.14 has them; the v6.6 and 5.10 trees used for the
+	 * rest of this driver do not.
+	 *
+	 * The original intent (from Linux 7.0.14 qcom-geni-se.c:1283-1290 and the
+	 * board's own BT transport at QcaBluetooth/src/qbt_geni.c:56) was:
+	 *     geni_setbits32(se->base + SE_DMA_IF_EN, DMA_IF_EN);
+	 *     if (mode == GENI_SE_FIFO) clrbits(SE_FIFO_IF_DISABLE, FIFO_IF_DISABLE);
+	 *     else                      setbits(SE_FIFO_IF_DISABLE, FIFO_IF_DISABLE);
+	 * Kept below, never executed, so a future board with the newer QUP can be
+	 * enabled by flipping the condition.
+	 */
+	if (0) {
+		wr(SE_DMA_IF_EN, rd(SE_DMA_IF_EN) | DMA_IF_EN);
+		wr(SE_FIFO_IF_DISABLE, spi_use_dma ? (rd(SE_FIFO_IF_DISABLE) | FIFO_IF_DISABLE)
+		    : (rd(SE_FIFO_IF_DISABLE) & ~FIFO_IF_DISABLE));
+		printf("Pong touch: GENI if_en dma=%#x fifo_disable=%#x mode_en=%#x ro_if_disable=%#x\n",
+		    rd(SE_DMA_IF_EN), rd(SE_FIFO_IF_DISABLE), rd(GENI_DMA_MODE_EN), rd(GENI_IF_DISABLE_RO));
+	}
+	wr(GENI_RX_WATERMARK, fifo_depth - 3);
+	wr(GENI_RX_RFR_WATERMARK, fifo_depth - 2);
+	wr(GENI_TX_WATERMARK, 0);
+	/* the status bits we poll follow these enables; the interrupt itself stays masked at the GIC */
+	wr(SE_IRQ_EN, rd(SE_IRQ_EN) | 0xf);
+	wr(GENI_M_IRQ_EN, (rd(GENI_M_IRQ_EN) | M_COMMON_GENI_M_IRQ_EN) & ~M_FIFO_ONLY_IRQ_BITS);
+	/* GeniSpi.c:94 sets the secondary sequencer's common enables too. */
+	wr(SE_GENI_S_IRQ_EN, rd(SE_GENI_S_IRQ_EN) | S_COMMON_GENI_S_IRQ_EN);
+	/* M_FIFO_ONLY_IRQ_BITS are already clear in the write above
+	 * (geni_se_select_dma_mode does the same clearing in Linux). */
+
+	/* mode 0, chip select 0, 8 bits, most significant first, four bytes in a FIFO word */
+	wr(SPI_LOOPBACK, 0);
+	wr(SPI_DEMUX_SEL, 0);
+	wr(SPI_CPHA, 0);
+	wr(SPI_CPOL, 0);
+	wr(SPI_DEMUX_OUTPUT_INV, 0);
+	wr(SPI_TRANS_CFG, rd(SPI_TRANS_CFG) & ~2u);
+	wr(SPI_DELAY_COUNTERS, 0);
+	/* 8 bits per word, MSB first (SPI mode 0): the official set_word_len()
+	 * (GeniSpi.c:68-72) derives pack_words from the FIFO width and programs
+	 * the four packing vectors with config_packing() (GeniSpi.c:38-66).
+	 * Note that this derives the same cfg0/cfg1 the previous hard-coded
+	 * constants already had (0x0007f8fe / 0x000ffefe); the packing registers
+	 * were not the reason DMA failed. It also makes the BYTE_GRAN write
+	 * conditional exactly as the official code does (GeniSpi.c:65) instead of
+	 * unconditional, so the register now follows the same rule as upstream. */
+	geni_set_word_len(8, 1);
+
+	/* Official GeniSpi.c:139-148: div = ceil(sclk_hz / (oversampling * speed_hz)).
+	 * The oversampling factor comes from the QUP hardware version
+	 * (geni_spi_init:96-97): 2 for QUP 1.0, else 1. */
+	{
+		uint64_t denom = (uint64_t)qup_oversampling * hz;
+
+		divider = (uint32_t)((se_source_hz + denom - 1) / denom);
+	}
+	wr(GENI_CLK_SEL, se_clock_select & 7);
+	wr(GENI_SER_M_CLK_CFG, (divider ? divider : 1) << 4 | 1);
+	spi_transfer = spi_use_dma ? geni_dma_transfer : geni_transfer;
+	return NULL;
+}
+
+static void
+geni_drain(uint8_t *rx, uint32_t length, uint32_t *received)
+{
+	uint32_t status = rd(GENI_RX_FIFO_STATUS), words = status & 0x01ffffff, bytes = words * 4;
+	if (words > fifo_depth) return; /* inaccessible/bad status must not cause an unbounded MMIO drain */
+
+	if (status & 0x80000000u) {
+		uint32_t valid = status >> 28 & 7;
+
+		if (valid && valid < 4) {
+			bytes -= 4 - valid;
+		}
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		uint32_t word = rd(GENI_RX_FIFO);
+
+		for (int j = 0; j < 4 && bytes; j++, bytes--) {
+			if (*received < length) {
+				if (rx) {
+					rx[*received] = (uint8_t)(word >> (8 * j));
+				}
+				(*received)++;
+			}
+		}
+	}
+}
+
+/* K60_M_CMD_ABORT: clear a stuck M_GENI_CMD_ACTIVE before issuing a new command.
+ * STATUS bit0 stuck at 0x41 means the primary sequencer still believes a command is
+ * running, so every later M_CMD0 write is ignored. Linux never has to do this because
+ * it arms the interrupt first; polling drivers must. This is exactly the manual
+ * cancel/abort sequence of QcomGeniSpi/GeniSpi.c:281-289 recover() and
+ * geni-se.h.v6.6:366-396 (geni_se_cancel_m_cmd -> CTRL BIT(2), then
+ * geni_se_abort_m_cmd -> CTRL BIT(1)) and the completion bits are M_CMD_CANCEL_EN
+ * (BIT(4)) / M_CMD_ABORT_EN (BIT(5)) in SE_GENI_M_IRQ_STATUS (geni-se.h.v6.6:170-171).
+ * Returns true when the sequencer ended up idle. */
+#define M_IRQ_CANCEL_DONE       (1u << 4)       /* geni-se.h.v6.6:170 M_CMD_CANCEL_EN */
+#define M_IRQ_ABORT_DONE        (1u << 5)       /* geni-se.h.v6.6:171 M_CMD_ABORT_EN */
+
+static bool
+geni_abort_active(void)
+{
+	if (!(rd(GENI_STATUS) & 1)) {
+		return true;                    /* already idle */
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(GENI_M_CMD_CTRL, M_GENI_CMD_CANCEL);
+	for (int i = 0; i < 2000; i++) {
+		if (rd(GENI_M_IRQ_STATUS) & M_IRQ_CANCEL_DONE) {
+			break;
+		}
+		if (!(rd(GENI_STATUS) & 1)) {
+			break;
+		}
+		sleep_us(50);
+	}
+	if (rd(GENI_STATUS) & 1) {
+		wr(GENI_M_CMD_CTRL, M_GENI_CMD_ABORT);
+		for (int i = 0; i < 2000; i++) {
+			if (rd(GENI_M_IRQ_STATUS) & M_IRQ_ABORT_DONE) {
+				break;
+			}
+			if (!(rd(GENI_STATUS) & 1)) {
+				break;
+			}
+			sleep_us(50);
+		}
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	return !(rd(GENI_STATUS) & 1);
+}
+
+static void
+geni_recover(void)
+{
+	wr(GENI_M_CMD_CTRL, M_GENI_CMD_CANCEL);
+	for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_IRQ_CANCEL_DONE); i++) {
+		sleep_us(100);
+	}
+	if (!(rd(GENI_M_IRQ_STATUS) & M_IRQ_CANCEL_DONE)) {
+		wr(GENI_M_CMD_CTRL, M_GENI_CMD_ABORT);
+		for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_IRQ_ABORT_DONE); i++) {
+			sleep_us(100);
+		}
+	}
+	for (int i = 0; i < 64 && (rd(GENI_RX_FIFO_STATUS) & 0x01ffffff); i++) {
+		(void)rd(GENI_RX_FIFO);
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+}
+
+/* One transfer with the chip selected throughout: `length` bytes out (zeros without tx) and as many in. */
+static bool
+geni_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	static unsigned complaints;
+	uint32_t sent = 0, received = 0, status = 0;
+	uint64_t deadline;
+
+	for (int i = 0; rd(GENI_STATUS) & 1; i++) {
+		if (i > 2000) {
+			geni_recover();
+			break;
+		}
+		sleep_us(100);
+	}
+	/* Same stale-M_GENI_CMD_ACTIVE problem as the DMA path: the FIFO run of
+	 * evidence/usblog-20261109-192021 shows geni_transfer() reaching STATUS=0x41 and
+	 * never clearing it, after which every later M_CMD0 is ignored. */
+	(void)geni_abort_active();
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	/* K60_GENI_DIAG: what does the engine look like before the command? */
+	printf("Pong touch: GENI pre status=%#x clk_cfg=%#x trans_cfg=%#x word_len=%#x\n",
+	    rd(GENI_STATUS), rd(GENI_SER_M_CLK_CFG), rd(SPI_TRANS_CFG), rd(SPI_WORD_LEN));
+	/* K60_CLK_PROOF: is the SE's SPI branch clock really running, and did the
+	 * RCG divider take? clk_cfg reads back 0x51, so the register accepted the
+	 * write; this tells us whether the GCC side agrees. */
+	{
+		uint32_t se4 = rd(GCC_QUP0_SE4_CBCR);
+		uint32_t cfg = rd(GCC_QUP0_SE4_CFG);
+		uint32_t cmd = rd(GCC_QUP0_SE4_CMD);
+		printf("Pong touch: CLKPROOF se4_cbcr=%#x off=%u on=%u hwcg=%u\n",
+		    se4, (se4 >> 31) & 1, (se4 >> 30) & 1, (se4 >> 1) & 1);
+		printf("Pong touch: CLKPROOF se4_cfg=%#x cmd=%#x dfsr=%#x\n",
+		    cfg, cmd, rd(GCC_QUP0_SE4_DFSR));
+	}
+	wr(SPI_TX_TRANS_LEN, length);
+	wr(SPI_RX_TRANS_LEN, length);
+	printf("Pong touch: GENI lens tx=%#x rx=%#x\n",
+	    rd(SPI_TX_TRANS_LEN), rd(SPI_RX_TRANS_LEN));
+	/* M_CMD0 = (opcode << 27) | params (geni-se.h.v6.6:336). SPI_FULL_DUPLEX is
+	 * already the shifted opcode (0x18000000) and M_PARAMS_FRAGMENTATION is BIT(2),
+	 * so the OR is a plain field merge: 0x18000000 | 0x4 = 0x18000004. */
+	wr(GENI_M_CMD0, SPI_FULL_DUPLEX | (k60_touch_keep_cs ? M_PARAMS_FRAGMENTATION : 0));
+	printf("Pong touch: GENI cmd0 readback=%#x status=%#x\n",
+	    rd(GENI_M_CMD0), rd(GENI_STATUS));
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		while (sent < length && (rd(GENI_TX_FIFO_STATUS) & 0x0fffffff) + 1 < fifo_depth) {
+			uint32_t word = 0;
+
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)(tx ? tx[sent] : 0) << (8 * j);
+			}
+			wr(GENI_TX_FIFO, word);
+		}
+		status = rd(GENI_M_IRQ_STATUS);
+		/* K60_XFER_TRACE: the command is accepted (cmd0 reads back) but
+		 * M_CMD_DONE never appears and the RX FIFO stays empty. Print the
+		 * engine state for the first few iterations only. */
+		{
+			static unsigned trace;
+			if (trace < 8) {
+				printf("Pong touch: XFER[%u] irq=%#x gst=%#x txf=%#x rxf=%#x sent=%u rcv=%u\n",
+				    trace, status, rd(GENI_STATUS), rd(GENI_TX_FIFO_STATUS),
+				    rd(GENI_RX_FIFO_STATUS), sent, received);
+				trace++;
+			}
+		}
+		geni_drain(rx, length, &received);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if (status & M_CMD_DONE) {
+			geni_drain(rx, length, &received);
+			wr(GENI_M_IRQ_CLEAR, status);
+			if (received == length) {
+				return true;
+			}
+			break;
+		}
+	}
+	if (complaints++ < 8) {
+		printf("goodix: SPI transfer of %u bytes failed: status %#x, sent %u, received %u\n", length, status, sent,
+		    received);
+	}
+	geni_recover();
+	return false;
+}
+
+/* ---- SPI by hand, on the same pins ----------------------------------------------------------------- */
+
+static unsigned bitbang_in, bitbang_out;
+/* K60_BB_DELAY_ARG: k60_touch_bb_us=<n> overrides the half-period (0 = off). */
+/* 2 us is the half-period every working K60 boot used; -1 (no delay) never worked.
+ * Keeping it as the default removes k60_touch_bb_us from the boot-args budget. */
+static int k60_touch_bb_us = 2;
+/*
+ * K60_DIAG_LEVEL: 0 = only the 5-second heartbeat, 1 = also the region sweeps,
+ * 2 = also the per-report byte dumps. The diagnostics are extremely chatty (the
+ * region sweep alone prints one line per 32-byte block on every sample) and the
+ * console is a slow serial line, so leaving them on makes the whole boot crawl.
+ * boot-arg: k60_touch_diag=<0|1|2>
+ */
+static int k60_touch_diag;
+/*
+ * K60_TOUCH_MINIMAL: do exactly what the working driver does and nothing else.
+ *
+ * hakios.goodix.c:1398-1450 (PHK110, same GT9916 Berlin-D, real touch working)
+ * runs only power_on -> clocks -> SPI init -> pins -> touch_reset -> probe, then
+ * polls. It never writes dev_confirm's 0xAA pattern, never touches 0xc900, never
+ * downloads a config and never sends a mode command. Every one of those returns
+ * ack=0x80 for us while 0x10308 and 0x30084 stay static, so one of them may be
+ * what keeps the scan engine idle. minimal=1 drops them all.
+ */
+static int k60_touch_minimal;
+/*
+ * K60_SKIP_DEV_CONFIRM: dev_confirm writes eight 0xAA bytes to 0x10000.
+ *
+ * 0x10000 is misc.cmd_addr -- the first field of the command block, not a
+ * scratch area. Writing 0xAA there pokes the command state machine, and the
+ * only implementation that works on real GT9916 hardware
+ * (references/phk110-port hakios.goodix.c bring_up) never issues this command
+ * at all. Measured here: with dev_confirm the chip reports frames whose touch
+ * count is always 0 (0x10400 byte2 = 0x00) while 0x10308 never changes.
+ * Skip it by default; k60_touch_dev_confirm=1 brings it back.
+ */
+static int k60_touch_dev_confirm;
+
+/* K60_PIN_PERMUTE: bitbang roles as variables so the probe can try all 24 assignments. */
+static unsigned bitbang_clk, bitbang_cs;
+
+static void
+bitbang_init(void)
+{
+	if (!bitbang_clk) bitbang_clk = PIN_CLK;
+	if (!bitbang_cs) bitbang_cs = PIN_CS;
+	gpio_output(bitbang_cs, true, PULL_NONE, 6);
+	gpio_output(bitbang_clk, false, PULL_NONE, 6);
+	gpio_output(bitbang_out, false, PULL_NONE, 6);
+	gpio_configure(bitbang_in, 0, PULL_NONE, 2, false);
+}
+
+/*
+ * K60_BB_DELAY: half-period delay for the bit-bang SPI clock.
+ *
+ * The GPIO block is mapped VM_WIMG_IO (nGnRnE), so back-to-back MMIO stores are
+ * ordered and the loop can run at tens of MHz -- far above what a Goodix
+ * BerlinD controller samples reliably. The upstream ruby bring-up measured the
+ * same problem and settled on 2 us per half period (~250 kHz):
+ *   0168-ruby-spi3-touch.patch:1703  gt.bb_delay_us = 2;
+ * Its driver keeps the value tunable from a boot argument (:1710), which is how
+ * they found it. Reproduce both here; k60_touch_bb_us=0 disables the delay so a
+ * run can still be compared against the old behaviour.
+ */
+static uint32_t bb_delay_us = 2;
+
+static void
+bb_half_delay(void)
+{
+	if (bb_delay_us) {
+		sleep_us(bb_delay_us);
+	}
+}
+
+static bool
+bitbang_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	if (!bitbang_clk) bitbang_clk = PIN_CLK;
+	if (!bitbang_cs) bitbang_cs = PIN_CS;
+	gpio_set(bitbang_cs, false);
+	bb_half_delay();
+	for (uint32_t i = 0; i < length; i++) {
+		uint8_t out = tx ? tx[i] : 0, in = 0;
+
+		for (int bit = 7; bit >= 0; bit--) {
+			/* SPI mode 0: data is set while the clock is low and
+			 * sampled on the rising edge; every edge gets the
+			 * half-period delay so the controller can follow. */
+			gpio_set(bitbang_out, out >> bit & 1);
+			bb_half_delay();
+			gpio_set(bitbang_clk, true);
+			bb_half_delay();
+			in = (uint8_t)(in << 1 | gpio_get(bitbang_in));
+			gpio_set(bitbang_clk, false);
+			bb_half_delay();
+		}
+		if (rx) {
+			rx[i] = in;
+		}
+	}
+	bb_half_delay();
+	gpio_set(bitbang_cs, true);
+	bb_half_delay();
+	return true;
+}
+
+/* ---- apps_smmu: the SE DMA master is an SMMU client ----------------------------------------------- */
+/*
+ * K60 live merged FDT (E:/k60-work/reports/live-6033dbec-fdt.dtb, sha256 95c02052…, parsed
+ * 2026-11-10 with a read-only FDT walker):
+ *
+ *   /soc/spi@990000                    qcom,wrapper-core = </soc/qcom,qupv3_0_geni_se@9c0000>
+ *                                      and NO iommus property of its own
+ *   /soc/qcom,qupv3_0_geni_se@9c0000   iommus = <&apps_smmu 0x5a3 0x0>
+ *                                      qcom,iommu-dma-addr-pool = <0x40000000 0x10000000>
+ *   /soc/qcom,qupv3_2_geni_se@8c0000   iommus = <&apps_smmu 0x483 0x0>   <- QCA6490 BT UART
+ *   /soc/apps-smmu@15000000            reg = <0x15000000 0x100000>, #iommu-cells = <2>
+ *
+ * So the touch SE's stream is 0x5a3, NOT 0x483. SID 0x483 belongs to the QUPV3_2 wrapper, whose
+ * only client here is qup_uart@894000, i.e. the Bluetooth UART (0500-k60-bt-qbt-new-files.patch:
+ * 1028 says exactly that). Putting 0x483 into bypass would leave the touch DMA stream untouched
+ * and would also break BT on the next boot.
+ *
+ * Linux maps every SE DMA buffer through the wrapper's IOMMU and hands the engine the resulting
+ * IOVA (qcom-geni-se.c:703-712 geni_se_tx_dma_prep -> dma_map_single(wrapper->dev, ...); rx at
+ * :755-764), so SE_DMA_*_PTR_L/H must never see a bare physical address on a translating stream.
+ * This port instead moves the wrapper's stream into SMMU bypass, which makes the IOVA equal the
+ * physical address kvtophys() already returns.
+ *
+ * The takeover below is NativeUfs/SmmuTakeover.h, the path this platform already proves for SID
+ * 0xe0 (PongUfsTransport.cpp:360-377). That header is C++ and cannot be included from this file,
+ * so it is ported function by function exactly as 0300-k60-usblog-ep0.patch:288-484 ported it for
+ * SID 0. Line references below point at SmmuTakeover.h.
+ */
+#define APPS_SMMU_PHYS          0x15000000UL
+/* K60_SMMU_WINDOW: the context-bank register array is (pages + banks) * 4096
+ * contiguous bytes (SmmuTakeover.h:49), NOT a few KiB: on this part idr1 =
+ * 0x6000004b gives pages=128 and banks=75 -> 0xcb000 for the full set. We only
+ * need one bank, so APPS_SMMU_BANKS caps it to 8 and the window becomes
+ * (128 + 8) * 4096 = 0x88000 plus 0x3c80 of SMR/S2CR tables -> 0x90000 fits
+ * with headroom while staying well inside the 8 MiB io_submap budget.
+ * (0x8000 never worked: the geometry check compares against this very constant.) */
+#define APPS_SMMU_SIZE          0xd0000UL
+#define APPS_SMMU_TOUCH_SID     0x5a3           /* qupv3_0 wrapper: the touch SE's DMA parent */
+#define APPS_SMMU_BT_SID        0x483           /* qupv3_2 wrapper; reported for contrast only */
+/* Use the real hardware bank count (IDR1 says 75). Capping it to 8 made the plan
+ * pick bank 7, and the hardware rewrote S2CR BYPASS to FAULT there -- the UFS
+ * stream works on bank 73 of the same 75, so high banks are the usable ones.
+ * The window below is sized for this count. */
+#define APPS_SMMU_BANKS         75
+#define APPS_SMMU_GROUPS        120             /* DT bound; IDR0.NUMSMRG wins */
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_IDR2               0x028
+#define SMMU_GFSR               0x048
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+#define SMMU_CBAR(n)            (0x1000 + 4 * (n))
+#define SMMU_CBA2R(n)           (0x1800 + 4 * (n))
+/* ARM IHI 0062D.c: S2CR.TYPE is bits [17:16], never [1:0]. 0b01 = bypass. */
+#define SMMU_S2CR_TYPE_MASK     (3u << 16)
+#define SMMU_S2CR_TYPE_TRANS    (0u << 16)
+#define SMMU_S2CR_TYPE_BYPASS   (1u << 16)
+#define SMMU_S2CR_TYPE_FAULT    (2u << 16)
+#define SMMU_CBAR_STAGE1_S2_BYP 0x10000u        /* ARM_SMMU_CBAR_TYPE=1: S1 trans + S2 bypass */
+/* Context-bank registers, relative to the bank base (pages + bank) * 4096.
+ * Offsets from arm-smmu.h: CB_SCTLR=0x0, CB_TTBR0=0x20, CB_TCR=0x30. */
+#define SMMU_CB_SCTLR           0x00u
+#define SMMU_CB_TTBR0           0x20u
+#define SMMU_CB_TCR             0x30u
+#define SMMU_SCTLR_M            (1u << 0)
+/* Fault reporting (arm-smmu.h): GR0_sGFSR 0x48; per-context CB_FSR 0x58,
+ * CB_FAR 0x60 (64-bit), CB_FSYNR0 0x68. */
+#define SMMU_GFSR               0x48u
+#define SMMU_CB_FSR             0x58u
+#define SMMU_CB_FAR             0x60u
+#define SMMU_CB_FSYNR0          0x68u
+#define SMMU_FSR_TF             (1u << 1)   /* translation fault */
+#define SMMU_FSR_PF             (1u << 3)   /* permission fault */
+#define SMMU_FSR_EF             (1u << 4)   /* external fault */
+#define SMMU_FSR_UUT            (1u << 8)   /* unsupported transaction */
+/* TCR for 4 KiB granule, 39-bit VA (T0SZ=25), inner/outer WB-WA, walks cached. */
+#define SMMU_TCR_T0SZ(n)        ((uint32_t)(n) & 0x3fu)
+#define SMMU_TCR_IRGN0_WBWA     (1u << 8)
+#define SMMU_TCR_ORGN0_WBWA     (1u << 10)
+#define SMMU_TCR_SH0_INNER      (3u << 12)
+#define SMMU_TCR_TG0_4K         (0u << 14)
+#define SMMU_TCR_IPS_40BIT      (2u << 32)
+#define SMMU_TCR_VALUE          (SMMU_TCR_T0SZ(25) | SMMU_TCR_IRGN0_WBWA | \
+                                 SMMU_TCR_ORGN0_WBWA | SMMU_TCR_SH0_INNER)
+/* LPAE level-1 block descriptor: output address [47:30], bits[1:0]=01 = block. */
+#define SMMU_L1_BLOCK(pa)       (((uint64_t)(pa) & 0x0000ffffc0000000ull) | 0x1ull)
+#define SMMU_CBA2R_AARCH64      1u              /* ArmSmmu4KContext.c:52 */
+
+/* SmmuTakeover.h:3-9 (UfsSmmuPlan), C form. */
+struct se_smmu_plan {
+	unsigned slot, bank, pages;
+	uint32_t smr, s2cr, previous_bank;
+	int reuse, migrate;
+	const char *error;
+};
+
+/* Declared with the other MMIO windows at the top of the file so k60_se_smmu_bypass() can be
+ * called from the bring-up thread before its definition below. */
+
+/* SmmuTakeover.h:13-20 */
+static unsigned
+smmu_addr_bits(unsigned code)
+{
+	switch (code) {
+	case 0: return 32; case 1: return 36; case 2: return 40;
+	case 3: return 42; case 4: return 44; case 5: return 48;
+	default: return 0;
+	}
+}
+
+/* The smallest of the three IDR2 address widths, or 0 when the hardware reports an unsupported
+ * encoding. VA64=1 does not widen any of them (SmmuTakeover.h:10-12). */
+static unsigned
+smmu_bypass_bits(void)
+{
+	uint32_t idr2;
+	unsigned best = 0;
+
+	if (!smmu) {
+		return 0;
+	}
+	idr2 = rd(smmu + SMMU_IDR2);
+	for (unsigned shift = 0; shift <= 8; shift += 4) {
+		unsigned bits = smmu_addr_bits((idr2 >> shift) & 15);
+
+		if (!bits) {
+			return 0;
+		}
+		if (!best || bits < best) {
+			best = bits;
+		}
+	}
+	return best;
+}
+
+/* Read-only: IDR/SCR0/GFSR plus every enabled stream-match slot. This is the diagnostic the
+ * task asks for first; it writes nothing, so it is safe before any decision is made. */
+static void
+smmu_dump(const char *tag)
+{
+	uint32_t idr0;
+	unsigned groups, shown = 0;
+
+	if (!smmu) {
+		printf("Pong touch: SMMU %s not mapped\n", tag);
+		return;
+	}
+	idr0 = rd(smmu + SMMU_IDR0);
+	printf("Pong touch: SMMU %s id0=%#x id1=%#x id2=%#x scr0=%#x gfsr=%#x\n", tag,
+	    idr0, rd(smmu + SMMU_IDR1), rd(smmu + SMMU_IDR2),
+	    rd(smmu + SMMU_SCR0), rd(smmu + SMMU_GFSR));
+	printf("Pong touch: SMMU %s touch-sid=%#x bypass-bits=%u (bt sid %#x is another wrapper)\n",
+	    tag, APPS_SMMU_TOUCH_SID, smmu_bypass_bits(), APPS_SMMU_BT_SID);
+	groups = idr0 & 0xff;
+	if (groups > APPS_SMMU_GROUPS) {
+		groups = APPS_SMMU_GROUPS;
+	}
+	for (unsigned i = 0; i < groups; i++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(i));
+
+		if (!(smr & 0x80000000U)) {
+			continue;
+		}
+		printf("Pong touch: SMMU %s slot=%u sid=%#x mask=%#x S2CR=%#x\n", tag,
+		    i, smr & 0xffff, (smr >> 16) & 0x7fff, rd(smmu + SMMU_S2CR(i)));
+		if (++shown >= 16) {
+			printf("Pong touch: SMMU %s (further slots not printed)\n", tag);
+			break;
+		}
+	}
+	if (!shown) {
+		printf("Pong touch: SMMU %s no stream-match slot is enabled\n", tag);
+	}
+}
+
+/* Report one SID routing: slot, SMR, S2CR and, for a translation type, the context bank
+ * registers behind it. Read-only. A SID with no enabled slot is a stream the SMMU does not
+ * match at all, which is exactly the case S_CR0.USFCFG decides (fault vs bypass). */
+static void
+smmu_report_sid(const char *tag, uint16_t sid)
+{
+	uint32_t idr0, idr1;
+	unsigned groups, pages;
+
+	if (!smmu) {
+		printf("Pong touch: SMMU %s sid=%#x not mapped\n", tag, sid);
+		return;
+	}
+	idr0 = rd(smmu + SMMU_IDR0);
+	idr1 = rd(smmu + SMMU_IDR1);
+	groups = idr0 & 0xff;
+	if (groups > APPS_SMMU_GROUPS) {
+		groups = APPS_SMMU_GROUPS;
+	}
+	pages = 1U << (((idr1 >> 28) & 7) + 1);
+	for (unsigned i = 0; i < groups; i++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(i));
+		uint32_t s2cr, mask;
+		unsigned type, bank;
+
+		if (!(smr & 0x80000000U) || (smr & 0xffff) != sid) {
+			continue;
+		}
+		mask = (smr >> 16) & 0x7fff;
+		s2cr = rd(smmu + SMMU_S2CR(i));
+		type = (s2cr >> 16) & 3;
+		bank = s2cr & 0xff;
+		printf("Pong touch: SMMU %s sid=%#x slot=%u SMR=%#x mask=%#x S2CR=%#x type=%u(%s) bank=%u\n",
+		    tag, sid, i, smr, mask, s2cr, type,
+		    type == 0 ? "translate" : type == 1 ? "bypass" : type == 2 ? "fault" : "reserved", bank);
+		if (type == 0 && bank < (idr1 & 0xff) && (pages + bank) * 4096 < APPS_SMMU_SIZE) {
+			printf("Pong touch: SMMU %s sid=%#x bank=%u CBAR=%#x CBA2R=%#x SCTLR=%#x exact=%u\n",
+			    tag, sid, bank, rd(smmu + SMMU_CBAR(bank)), rd(smmu + SMMU_CBA2R(bank)),
+			    rd(smmu + (pages + bank) * 4096), (mask == 0));
+		}
+		return;
+	}
+	printf("Pong touch: SMMU %s sid=%#x has NO enabled stream-match slot (unmatched stream)\n",
+	    tag, sid);
+}
+
+/* SmmuTakeover.h:22-93 (planUfsSmmuBank) plus the stage-2-only check from
+ * ArmSmmu4KProgram.c:77-78. Reads only. Every ambiguous case refuses instead of guessing.
+ * dma/bytes may be 0/0 to skip the address-width gate; k60_se_smmu_bypass() then relies on
+ * geni_dma_address() to refuse a physical address the bypass range cannot carry. */
+static void
+smmu_plan_bank(vm_offset_t s, uint16_t stream, uint64_t dma, uint64_t bytes,
+    unsigned owned_banks, unsigned owned_groups, unsigned bank_from_top, struct se_smmu_plan *p)
+{
+	uint32_t idr0 = rd(s + SMMU_IDR0), idr1 = rd(s + SMMU_IDR1), idr2 = rd(s + SMMU_IDR2);
+	unsigned count = idr0 & 0xff, banks, matches = 0;
+	uint32_t sctlr;
+
+	memset(p, 0, sizeof(*p));
+	p->slot = 0xffffffffU;
+	p->previous_bank = 0xffffffffU;
+	if (!(idr0 & (1U << 30)) || !(idr2 & (1U << 12))) {
+		p->error = "SMMU AArch64 stage 1 unsupported";
+		return;
+	}
+	if (bytes) {
+		for (unsigned shift = 0; shift <= 8; shift += 4) {
+			unsigned bits = smmu_addr_bits((idr2 >> shift) & 15);
+
+			if (!bits || dma >= (1ULL << bits) || bytes > (1ULL << bits) - dma) {
+				p->error = "DMA exceeds SMMU address width";
+				return;
+			}
+		}
+	}
+	banks = idr1 & 0xff;
+	if (!owned_banks || !owned_groups || !banks || !count) {
+		p->error = "empty SMMU ownership/capability range";
+		return;
+	}
+	if (banks > owned_banks) {
+		banks = owned_banks;
+	}
+	if (count > owned_groups) {
+		count = owned_groups;
+	}
+	p->pages = 1U << (((idr1 >> 28) & 7) + 1);
+	if ((idr1 >> 31) || !count || p->pages > 128 || banks < 2 || banks > 128 ||
+	    (p->pages + banks) * 4096 > APPS_SMMU_SIZE) {
+		p->error = "unsupported SMMU geometry";
+		return;
+	}
+	if (count > 128) {
+		p->error = "unsupported stream-match group count";
+		return;
+	}
+	if (bank_from_top >= banks - 1) {
+		p->error = "no free context bank";
+		return;
+	}
+	p->bank = banks - 1 - bank_from_top;
+	if (p->bank < ((idr1 >> 16) & 0xff)) {
+		p->error = "context bank is stage-2 only";
+		return;
+	}
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t smr = rd(s + SMMU_SMR(i));
+		uint32_t s2cr, mask;
+		int match, translate, our_bank;
+
+		if (!(smr & 0x80000000U)) {
+			if (!p->reuse && !p->migrate) {
+				p->slot = i;
+			}
+			continue;
+		}
+		s2cr = rd(s + SMMU_S2CR(i));
+		mask = (smr >> 16) & 0x7fff;
+		match = ((smr ^ stream) & 0xffff & ~mask) == 0;
+		translate = (s2cr & SMMU_S2CR_TYPE_MASK) == SMMU_S2CR_TYPE_TRANS;
+		our_bank = translate && (s2cr & 0xff) == p->bank;
+		if (match) {
+			++matches;
+			if (matches > 1 || mask || !translate || (s2cr & 0xff) >= banks) {
+				p->slot = i; p->smr = smr; p->s2cr = s2cr;
+				p->error = "conflicting SE stream mapping";
+				return;
+			}
+			p->reuse = our_bank;
+			p->migrate = !our_bank;
+			p->previous_bank = s2cr & 0xff;
+			p->slot = i; p->smr = smr; p->s2cr = s2cr;
+		} else if (our_bank) {
+			p->slot = i; p->smr = smr; p->s2cr = s2cr;
+			p->error = "reserved context bank already used";
+			return;
+		}
+	}
+	sctlr = rd(s + (p->pages + p->bank) * 4096);
+	if ((sctlr & 1) || (p->reuse && (sctlr ||
+	    rd(s + SMMU_CBAR(p->bank)) != SMMU_CBAR_STAGE1_S2_BYP ||
+	    (rd(s + SMMU_CBA2R(p->bank)) & ~1U)))) {
+		p->error = "reserved context bank not bypass";
+		return;
+	}
+	if (p->slot == 0xffffffffU) {
+		p->error = "no free stream-match group";
+	}
+}
+
+/* SmmuTakeover.h:97-116 (planUfsSmmu): bounded bank-from-top retry. */
+static int
+smmu_plan_retryable(const char *error)
+{
+	return error && (!__builtin_strcmp(error, "reserved context bank already used") ||
+	    !__builtin_strcmp(error, "reserved context bank not bypass"));
+}
+
+static void
+smmu_plan(vm_offset_t s, uint16_t stream, uint64_t dma, uint64_t bytes,
+    unsigned owned_banks, unsigned owned_groups, struct se_smmu_plan *p)
+{
+	struct se_smmu_plan first;
+
+	smmu_plan_bank(s, stream, dma, bytes, owned_banks, owned_groups, 0, p);
+	if (!p->error || !smmu_plan_retryable(p->error)) {
+		return;
+	}
+	first = *p;
+	for (unsigned attempt = 1; attempt < 8; attempt++) {
+		smmu_plan_bank(s, stream, dma, bytes, owned_banks, owned_groups, attempt, p);
+		if (!p->error) {
+			return;
+		}
+		if (!smmu_plan_retryable(p->error)) {
+			break;
+		}
+	}
+	*p = first;
+}
+
+/* SmmuTakeover.h:122-144 (configureUfsSmmu): every write is read back before the next one. The
+ * context is built while SCTLR.M is still 0 and the SID is published last, so a half-configured
+ * bank is never reachable. */
+static const char *
+smmu_configure(vm_offset_t s, const struct se_smmu_plan *p, uint16_t stream)
+{
+	unsigned cb = (p->pages + p->bank) * 4096;
+
+	if (p->error) {
+		return p->error;
+	}
+	if (!p->reuse) {
+		wr(s + cb, 0);
+	}
+	if (rd(s + cb) != 0) {
+		return "SMMU bypass disable readback";
+	}
+	/* VA64 first: the measured DMA buffer sits at 0x9037a5000, i.e. above 4 GiB, and with
+	 * VA64=0 a SCTLR.M=0 bypass still rejects inputs above 32 bits (SmmuTakeover.h:10-12). */
+	if (rd(s + SMMU_CBA2R(p->bank)) != SMMU_CBA2R_AARCH64) {
+		wr(s + SMMU_CBA2R(p->bank), SMMU_CBA2R_AARCH64);
+	}
+	if (!p->reuse) {
+		wr(s + SMMU_CBAR(p->bank), SMMU_CBAR_STAGE1_S2_BYP);
+	}
+	if (rd(s + SMMU_CBA2R(p->bank)) != SMMU_CBA2R_AARCH64 ||
+	    rd(s + SMMU_CBAR(p->bank)) != SMMU_CBAR_STAGE1_S2_BYP || rd(s + cb) != 0) {
+		return "SMMU VA64 bypass readback";
+	}
+	if (!p->reuse) {
+		/* S2CR.TYPE lives in [17:16]; 1 = BYPASS. Writing only the bank
+		 * number leaves TYPE=0 (translate), which is why the device read
+		 * back S2CR=0x7 and the SE DMA still had a translation to resolve. */
+		uint32_t s2cr = SMMU_S2CR_TYPE_BYPASS | (p->bank & 0xffu);
+
+		wr(s + SMMU_S2CR(p->slot), s2cr);
+		if ((rd(s + SMMU_S2CR(p->slot)) & ~SMMU_S2CR_TYPE_MASK) != (p->bank & 0xffu)) {
+			return "SMMU stream context readback";
+		}
+		if (!p->migrate) {
+			wr(s + SMMU_SMR(p->slot), 0x80000000U | stream);
+		}
+	}
+	if (rd(s + SMMU_SMR(p->slot)) != (0x80000000U | stream) ||
+	    (rd(s + SMMU_S2CR(p->slot)) & ~SMMU_S2CR_TYPE_MASK) != (p->bank & 0xffu) ||
+	    (rd(s + SMMU_S2CR(p->slot)) & SMMU_S2CR_TYPE_MASK) != SMMU_S2CR_TYPE_BYPASS) {
+		return "SMMU stream mapping readback";
+	}
+	return NULL;
+}
+
+/* True when this SID is already routed to architectural bypass by an exact SMR match.
+ * S2CR.TYPE=0b01 means the SMMU does not translate the stream at all (ARM IHI 0062D.c),
+ * so a physical address is already the legal DMA address and nothing needs programming.
+ * Read-only: this never writes a register. */
+static bool
+smmu_sid_is_bypass(uint16_t sid)
+{
+	uint32_t idr0;
+	unsigned groups;
+
+	if (!smmu) {
+		return false;
+	}
+	idr0 = rd(smmu + SMMU_IDR0);
+	groups = idr0 & 0xff;
+	if (groups > APPS_SMMU_GROUPS) {
+		groups = APPS_SMMU_GROUPS;
+	}
+	for (unsigned i = 0; i < groups; i++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(i));
+
+		if (!(smr & 0x80000000U) || (smr & 0xffff) != sid) {
+			continue;
+		}
+		/* Only an exact match counts: a masked SMR would capture other streams too,
+		 * and this code must not claim that as the touch SE being in bypass. */
+		if (((smr >> 16) & 0x7fff) != 0) {
+			return false;
+		}
+		return (rd(smmu + SMMU_S2CR(i)) & SMMU_S2CR_TYPE_MASK) == SMMU_S2CR_TYPE_BYPASS;
+	}
+	return false;
+}
+
+/* Put the touch SE's stream into SMMU bypass. Returns true only when the stream reads back as an
+ * exact match on an AArch64 stage-1 / stage-2-bypass context. Nothing is enabled when this fails:
+ * the caller keeps the previous (translating or faulting) stream state. */
+/*
+ * K60_SMMU_IDENTITY: the part refuses S2CR.TYPE=BYPASS (writing 0x10007 reads
+ * back 0x20007, and 0x10048 reads back 0x20048), so the only shape left is the
+ * one UFS already uses on this board: CBAR.TYPE=1 (S1 translate + S2 bypass),
+ * S2CR.TYPE=0 (TRANS) and a real stage-1 table.
+ *
+ * The table is one 4 KiB LPAE L1 with a single 1 GiB block descriptor covering
+ * the region the SE DMA buffers live in, which makes the map an identity map.
+ */
+static bool
+k60_se_smmu_identity_map(uint64_t dma_phys, uint16_t *bank_out)
+{
+	struct se_smmu_plan plan;
+	uint64_t l1_pa, block_pa;
+	unsigned idx;
+	uint32_t cb;
+	unsigned banks_from_idr;
+
+	if (!smmu) {
+		return false;
+	}
+	/*
+	 * The refused BYPASS attempt left S2CR=0x20048 (FAULT + bank) and a valid
+	 * SMR behind, so the planner sees the slot as a conflicting stream. Return
+	 * that slot to the idle shape first: S2CR back to fault with no bank, SMR
+	 * cleared, then plan.
+	 */
+	for (unsigned i = 0; i < (rd(smmu + SMMU_IDR0) & 0xffu); i++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(i));
+
+		if ((smr & 0x80000000u) && (smr & 0xffffu) == APPS_SMMU_TOUCH_SID) {
+			uint32_t was = rd(smmu + SMMU_S2CR(i));
+
+			wr(smmu + SMMU_S2CR(i), SMMU_S2CR_TYPE_FAULT);
+			wr(smmu + SMMU_SMR(i), 0);
+			printf("Pong touch: SMMU identity: cleared stale slot=%u s2cr %#x -> %#x\n",
+			    i, was, rd(smmu + SMMU_S2CR(i)));
+			break;
+		}
+	}
+	/* Pick a bank the same way the bypass path did, but keep the plan only for
+	 * slot/bank selection: we program the context ourselves below. */
+	smmu_plan(smmu, APPS_SMMU_TOUCH_SID, 0, 0, APPS_SMMU_BANKS, APPS_SMMU_GROUPS, &plan);
+	if (plan.error) {
+		printf("Pong touch: SMMU identity plan failed: %s\n", plan.error);
+		return false;
+	}
+	banks_from_idr = rd(smmu + SMMU_IDR1) & 0xff;
+	cb = (plan.pages + plan.bank) * 4096;
+
+	/* A 4 KiB L1 table holds 512 8-byte descriptors; a 1 GiB block entry covers
+	 * 2^30 of VA, so one entry is enough for the DMA buffer's region. */
+	block_pa = dma_phys & ~((1ull << 30) - 1);
+	idx = (unsigned)((dma_phys >> 30) & 0x1ffu);
+	l1_pa = (uint64_t)kvtophys((vm_offset_t)smmu_l1);
+	if (!l1_pa) {
+		printf("Pong touch: SMMU identity: kvtophys(L1) failed\n");
+		return false;
+	}
+	memset(smmu_l1, 0, sizeof(smmu_l1));
+	smmu_l1[idx] = SMMU_L1_BLOCK(block_pa);
+	FlushPoC_DcacheRegion((vm_offset_t)smmu_l1, sizeof(smmu_l1));
+	printf("Pong touch: SMMU identity L1 pa=%#llx idx=%u desc=%#llx block_pa=%#llx\n",
+	    (unsigned long long)l1_pa, idx,
+	    (unsigned long long)smmu_l1[idx], (unsigned long long)block_pa);
+
+	/* Program the bank: disable, TCR, TTBR0, then enable with SCTLR.M. */
+	wr(smmu + cb + SMMU_CB_SCTLR, 0);
+	wr(smmu + cb + SMMU_CB_TCR, SMMU_TCR_VALUE);
+	wr(smmu + cb + SMMU_CB_TTBR0, (uint32_t)l1_pa | 0x1u);   /* ASID 0, CnP */
+	wr(smmu + cb + SMMU_CB_SCTLR, SMMU_SCTLR_M | (1u << 3)); /* M=1, CFCFG? keep minimal */
+	printf("Pong touch: SMMU identity cb=%#x sctlr=%#x tcr=%#x ttbr0=%#x\n",
+	    cb, rd(smmu + cb + SMMU_CB_SCTLR), rd(smmu + cb + SMMU_CB_TCR),
+	    rd(smmu + cb + SMMU_CB_TTBR0));
+
+	/* Publish the stream: SMR first, then S2CR with TYPE=TRANS and the bank.
+	 * CBAR.TYPE=1 (S1 translate + S2 bypass) makes this a pure identity map. */
+	wr(smmu + SMMU_CBAR(plan.bank), SMMU_CBAR_STAGE1_S2_BYP);
+	wr(smmu + SMMU_CBA2R(plan.bank), SMMU_CBA2R_AARCH64);
+	wr(smmu + SMMU_SMR(plan.slot), 0x80000000U | APPS_SMMU_TOUCH_SID);
+	wr(smmu + SMMU_S2CR(plan.slot), (plan.bank & 0xffu));   /* TYPE=0 TRANS */
+	printf("Pong touch: SMMU identity slot=%u SMR=%#x S2CR=%#x cbar=%#x\n",
+	    plan.slot, rd(smmu + SMMU_SMR(plan.slot)), rd(smmu + SMMU_S2CR(plan.slot)),
+	    rd(smmu + SMMU_CBAR(plan.bank)));
+	if (((rd(smmu + SMMU_S2CR(plan.slot)) >> 16) & 3u) != 0) {
+		printf("Pong touch: SMMU identity: S2CR TYPE did not stick\n");
+		return false;
+	}
+	smmu_ctx_pages = plan.pages;
+	smmu_ctx_bank = plan.bank;
+	if (bank_out) {
+		*bank_out = (uint16_t)plan.bank;
+	}
+	return true;
+}
+
+static bool
+k60_se_smmu_bypass(void)
+{
+	struct se_smmu_plan plan;
+	const char *why;
+
+	if (!smmu) {
+		return false;
+	}
+	smmu_dump("pre");
+	/* Already bypassed: the goal state. Report it and change nothing, so a re-entry or a
+	 * firmware-installed bypass is not mistaken for a conflict. */
+	if (smmu_sid_is_bypass(APPS_SMMU_TOUCH_SID)) {
+		printf("Pong touch: SMMU sid=%#x is already in architectural bypass; no write needed\n",
+		    APPS_SMMU_TOUCH_SID);
+		return true;
+	}
+	smmu_plan(smmu, APPS_SMMU_TOUCH_SID, 0, 0, APPS_SMMU_BANKS, APPS_SMMU_GROUPS, &plan);
+	if (plan.error) {
+		printf("Pong touch: SMMU sid=%#x plan failed: %s\n", APPS_SMMU_TOUCH_SID, plan.error);
+		return false;
+	}
+	printf("Pong touch: SMMU sid=%#x slot=%u bank=%u firmware-bank=%u action=%s\n",
+	    APPS_SMMU_TOUCH_SID, plan.slot, plan.bank, plan.previous_bank,
+	    plan.migrate ? "migrate" : plan.reuse ? "reuse" : "install");
+	why = smmu_configure(smmu, &plan, APPS_SMMU_TOUCH_SID);
+	printf("Pong touch: SMMU sid=%#x slot=%u SMR=%#x S2CR=%#x CBAR=%#x CBA2R=%#x SCTLR=%#x\n",
+	    APPS_SMMU_TOUCH_SID, plan.slot,
+	    rd(smmu + SMMU_SMR(plan.slot)), rd(smmu + SMMU_S2CR(plan.slot)),
+	    rd(smmu + SMMU_CBAR(plan.bank)), rd(smmu + SMMU_CBA2R(plan.bank)),
+	    rd(smmu + (plan.pages + plan.bank) * 4096));
+	if (why) {
+		/*
+		 * This part rewrites S2CR.TYPE=BYPASS to FAULT (0x10007 -> 0x20007,
+		 * 0x10048 -> 0x20048), so the architectural-bypass shape is not
+		 * available. Fall back to a stage-1 identity map, which is exactly
+		 * what UFS uses on this board (CBAR.TYPE=1, S2CR.TYPE=0).
+		 */
+		uint16_t ibank = 0;
+
+		printf("Pong touch: SMMU sid=%#x bypass refused (%s); trying stage-1 identity map\n",
+		    APPS_SMMU_TOUCH_SID, why);
+		if (k60_se_smmu_identity_map(0x9037a5000ull, &ibank)) {
+			printf("Pong touch: SMMU sid=%#x identity map ACTIVE bank=%u\n",
+			    APPS_SMMU_TOUCH_SID, ibank);
+			return true;
+		}
+		printf("Pong touch: SMMU sid=%#x identity map failed too\n", APPS_SMMU_TOUCH_SID);
+		return false;
+	}
+	printf("Pong touch: SMMU sid=%#x bypass active, SE DMA may use physical addresses\n",
+	    APPS_SMMU_TOUCH_SID);
+	return true;
+}
+
+/* The address the SE's DMA master is given. Linux hands it a dma_map_single() IOVA
+ * (qcom-geni-se.c:708/760); with the stream in bypass that IOVA is the physical address, so
+ * kvtophys() is correct. With bypass unproven the same physical address is still returned, so
+ * the existing failure diagnostics keep running and a translation fault surfaces as DMA_AHB_ERR,
+ * but it is reported once and the width is checked against the hardware's bypass range. */
+static uint64_t
+geni_dma_address(const void *buffer, uint32_t length)
+{
+	uint64_t pa = kvtophys((vm_offset_t)buffer);
+	unsigned bits;
+
+	if (!se_smmu_bypass) {
+		if (!se_smmu_warned) {
+			se_smmu_warned = true;
+			printf("Pong touch: SMMU sid=%#x not in bypass; SE DMA address %#llx is a raw PA\n",
+			    APPS_SMMU_TOUCH_SID, (unsigned long long)pa);
+		}
+		return pa;
+	}
+	bits = smmu_bypass_bits();
+	if (!bits || pa >= (1ULL << bits) || length > (1ULL << bits) - pa) {
+		if (!se_smmu_warned) {
+			se_smmu_warned = true;
+			printf("Pong touch: SMMU sid=%#x bypass covers %u bits, DMA %#llx len %u does not fit\n",
+			    APPS_SMMU_TOUCH_SID, bits, (unsigned long long)pa, length);
+		}
+	}
+	return pa;
+}
+
+/* ---- the Goodix chip ------------------------------------------------------------------------------- */
+
+#define GOODIX_FW_VERSION       0x10014         /* 28 bytes */
+#define GOODIX_IC_INFO          0x10070         /* a 16-bit length, then that many bytes */
+#define GOODIX_MAX_READ         1024
+#define GOODIX_MAX_TOUCHES      10
+#define GOODIX_STATUS_TOUCH     0x80
+#define GOODIX_STATUS_REQUEST   0x40
+#define GOODIX_REQUEST_RESET    3
+
+/* Page-aligned so each buffer is one physically contiguous page for the SE DMA master. */
+static uint8_t spi_tx[8 + GOODIX_MAX_READ] __attribute__((aligned(4096)));
+/* K60_SMMU_L1: one 4 KiB LPAE level-1 table for the SE's stage-1 identity map.
+ * 512 entries x 8 bytes = 4096. Only one entry is populated. */
+static uint8_t spi_rx[8 + GOODIX_MAX_READ] __attribute__((aligned(4096)));
+static uint32_t touch_address, touch_address_alt, command_address;
+/* packed misc value; the config download must target fw_buffer_addr */
+static uint32_t k60_fw_buffer_addr;
+static uint32_t k60_fw_buffer_max_len;
+
+/* One transfer with the chip selected throughout, moved by the SE's internal
+ * DMA master (the FIFO interface is disabled on this board). Sequence mirrors
+ * QcomGeniSpi transfer_dma() and Linux spi-geni-qcom.c setup_se_xfer() +
+ * geni_se_tx_init_dma()/geni_se_rx_init_dma(). */
+static bool
+geni_dma_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	static unsigned complaints, traces;
+	uint64_t deadline;
+	uint32_t cmd = 0;
+
+	if (length > 8 + GOODIX_MAX_READ) {
+		return false;
+	}
+	/* K60_CLEAR_STUCK_ACTIVE: a previous failed transfer can leave M_GENI_CMD_ACTIVE
+	 * asserted (observed as STATUS=0x41 in both the FIFO and the DMA path). While that
+	 * bit is set the sequencer ignores every new M_CMD0 write, so the transfer can
+	 * never start. Actively cancel/abort it first instead of only polling for it to
+	 * clear; geni-se.h.v6.6:366-396 documents the cancel-then-abort order. */
+	for (int i = 0; rd(GENI_STATUS) & 1; i++) {
+		if (i > 2000) {
+			geni_recover();
+			break;
+		}
+		sleep_us(100);
+	}
+	if (!geni_abort_active()) {
+		printf("Pong touch: DMA sequencer will not go idle (status=%#x), forcing abort path\n",
+		    rd(GENI_STATUS));
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	if (tx) {
+		FlushPoC_DcacheRegion((vm_offset_t)tx, length);
+		wr(SPI_TX_TRANS_LEN, length);
+		cmd |= 1u;       /* SPI_TX_ONLY */
+	}
+	if (rx) {
+		FlushPoC_DcacheRegion((vm_offset_t)rx, length);
+		wr(SPI_RX_TRANS_LEN, length);
+		cmd |= 2u;       /* SPI_RX_ONLY */
+	}
+	if (!cmd) {
+		return false;
+	}
+	{
+		uint64_t tpa = tx ? geni_dma_address(tx, length) : 0;
+		uint64_t rpa = rx ? geni_dma_address(rx, length) : 0;
+
+		/* K60_DMA_PREDUMP: read-only snapshot of every register the DMA path
+		 * depends on, taken immediately BEFORE M_CMD0. This is what separates the
+		 * three candidate blockers on the next boot without guessing:
+		 *  - if_en=0x0  -> the DMA interface gate (SE_DMA_IF_EN 0x2004) is shut and
+		 *    no descriptor can ever be fetched, whatever M_CMD0 says;
+		 *  - status bit0 set while irq=0 and stat_tx=0 -> stale M_GENI_CMD_ACTIVE;
+		 *  - dma_gen bit2 (DMA_AHB_SLV_CFG_ON) clear -> the AHB slave path for the
+		 *    descriptors is not clocked (qcom-geni-se.c:172-178, 228-231).
+		 * fifo_depth is printed because RX_WATERMARK/RFR are derived from it. */
+		printf("Pong touch: DMA pre len=%u txpa=%#llx rxpa=%#llx se=%#llx\n",
+		    length, (unsigned long long)tpa, (unsigned long long)rpa,
+		    (unsigned long long)se_phys);
+		printf("Pong touch: DMA pre se_if clk_ctrl=%#x if_en=%#x fifo_dis=%#x ro_fifo_dis=%#x\n",
+		    0u /* QUP config region not implemented; never read it */, 0u, 0u,
+		    rd(GENI_IF_DISABLE_RO));
+		printf("Pong touch: DMA pre mode=%#x irq_en=%#x irq_st=%#x gst=%#x dma_gen=%#x\n",
+		    rd(GENI_DMA_MODE_EN), rd(GENI_M_IRQ_EN), rd(GENI_M_IRQ_STATUS),
+		    rd(GENI_STATUS), rd(SE_DMA_GENERAL_CFG));
+		printf("Pong touch: DMA pre tx_st=%#x rx_st=%#x tx_fifo=%#x rx_fifo=%#x txin=%#x rxin=%#x\n",
+		    rd(SE_DMA_TX_IRQ_STAT), rd(SE_DMA_RX_IRQ_STAT),
+		    rd(GENI_TX_FIFO_STATUS), rd(GENI_RX_FIFO_STATUS),
+		    rd(SE_DMA_TX_LEN_IN), rd(SE_DMA_RX_LEN_IN));
+		printf("Pong touch: DMA pre ptr tx=%#x/%#x/%#x/%#x rx=%#x/%#x/%#x/%#x\n",
+		    rd(SE_DMA_TX_PTR_L), rd(SE_DMA_TX_PTR_H), rd(SE_DMA_TX_ATTR), rd(SE_DMA_TX_LEN),
+		    rd(SE_DMA_RX_PTR_L), rd(SE_DMA_RX_PTR_H), rd(SE_DMA_RX_ATTR), rd(SE_DMA_RX_LEN));
+		if (smmu && smmu_ctx_bank) {
+			/* Read-only fault observers for the context we installed. A DMA
+			 * transaction the SMMU rejects is recorded here and NOT as an
+			 * engine AHB_ERR, because the request dies before the interconnect.
+			 * arm-smmu.h: sGFSR 0x48, CB_FSR 0x58, CB_FAR 0x60, CB_FSYNR0 0x68. */
+			unsigned cbb = (smmu_ctx_pages + smmu_ctx_bank) * 4096;
+			uint32_t fsr = rd(smmu + cbb + SMMU_CB_FSR), gfsr = rd(smmu + SMMU_GFSR);
+			uint32_t fsynr = rd(smmu + cbb + SMMU_CB_FSYNR0);
+
+			printf("Pong touch: SMMU fault fsr=%#x%s%s%s%s gfsr=%#x far=%#llx WNR=%u\n",
+			    fsr,
+			    (fsr & SMMU_FSR_TF) ? " TF" : "",
+			    (fsr & SMMU_FSR_PF) ? " PF" : "",
+			    (fsr & SMMU_FSR_EF) ? " EF" : "",
+			    (fsr & SMMU_FSR_UUT) ? " UUT" : "",
+			    gfsr,
+			    (unsigned long long)((uint64_t)rd(smmu + cbb + SMMU_CB_FAR) |
+				((uint64_t)rd(smmu + cbb + SMMU_CB_FAR + 4) << 32)),
+			    (fsynr >> 4) & 1u);
+			if (fsr) {
+				wr(smmu + cbb + SMMU_CB_FSR, fsr);   /* W1C */
+			}
+			if (gfsr) {
+				wr(smmu + SMMU_GFSR, gfsr);
+			}
+		}
+		printf("Pong touch: DMA pre spi word_len=%#x cfg=%#x clk=%#x/%#x lens=%#x/%#x\n",
+		    rd(SPI_WORD_LEN), rd(SPI_TRANS_CFG), rd(GENI_CLK_SEL), rd(GENI_SER_M_CLK_CFG),
+		    rd(SPI_TX_TRANS_LEN), rd(SPI_RX_TRANS_LEN));
+	}
+	/* ORDER, verified against BOTH references:
+	 *  - QcomGeniSpi/GeniSpi.c:241 writes SE_GENI_M_CMD0 first, then
+	 *    SE_DMA_RX_* (243-249) and SE_DMA_TX_* (250-256); its own comment at
+	 *    :242 says "the LEN write starts each direction".
+	 *  - Linux spi-geni-qcom.c:898 geni_se_setup_m_cmd() first, then
+	 *    geni_se_rx_init_dma()/geni_se_tx_init_dma() at 900-906.
+	 * The previous revision had it backwards (descriptors, then M_CMD0), which
+	 * leaves M_GENI_CMD_ACTIVE asserted with no DMA request the engine will
+	 * act on: exactly status=0x41 with stat_tx=0 stat_rx=0 txin=0 rxin=0.
+	 * SPI_TX/RX_TRANS_LEN stay: the official DMA path writes them too
+	 * (GeniSpi.c:228 and :235), and Linux writes them unconditionally at
+	 * spi-geni-qcom.c:868/873 before the FIFO-vs-DMA choice at :891.
+	 * M_CMD0 = (cmd << M_OPCODE_SHFT) | params, M_OPCODE_SHFT=27, M_PARAMS_MSK=GENMASK(26,0)
+	 * (geni-se.h.v6.6:147-148, applied at :336). cmd = SPI_TX_ONLY(1) | SPI_RX_ONLY(2) = 3,
+	 * i.e. 3 << 27 = 0x18000000; params = FRAGMENTATION = BIT(2) -> 0x18000004.
+	 * Linux does the same with SPI_TX_ONLY=1/SPI_RX_ONLY=2 (spi-geni-qcom.c:60-61); its
+	 * SPI_TX_RX=7 (:62) is never used by this path. */
+	/* Chip select first (spi-geni-qcom.c:321), otherwise the sequencer drops
+	 * the transfer command with M_GENI_CMD_ACTIVE stuck and no error. */
+	wr(GENI_M_CMD0, (SPI_CS_ASSERT << 27) | M_PARAMS_FRAGMENTATION);
+	for (int i = 0; i < 2000 && (rd(GENI_STATUS) & 1); i++) {
+		sleep_us(50);
+	}
+	/* Official transfer_dma (GeniSpi.c:244) ORs FRAGMENTATION only when the
+	 * caller asks to keep CS across fragments; the working reference on this
+	 * SoC family (sheng TouchProbe.cpp:157) passes keep_cs = 0, so the command
+	 * carries no param bits. Default to that and allow it to be forced. */
+	wr(GENI_M_CMD0, (cmd << 27) | (k60_touch_keep_cs ? M_PARAMS_FRAGMENTATION : 0));
+	printf("Pong touch: DMA cmd written=%#x readback=%#x status=%#x\n",
+	    cmd << 27, rd(GENI_M_CMD0), rd(GENI_STATUS));
+	if (rx) {
+		uint64_t pa = geni_dma_address(rx, length);
+
+		wr(SE_DMA_RX_IRQ_EN_SET, DMA_DONE | DMA_EOT | DMA_AHB_ERR);
+		wr(SE_DMA_RX_PTR_L, (uint32_t)pa);
+		wr(SE_DMA_RX_PTR_H, (uint32_t)(pa >> 32));
+		wr(SE_DMA_RX_ATTR, 0);
+		wr(SE_DMA_RX_LEN, length);
+	}
+	if (tx) {
+		uint64_t pa = geni_dma_address(tx, length);
+
+		wr(SE_DMA_TX_IRQ_EN_SET, DMA_DONE | DMA_EOT | DMA_AHB_ERR);
+		wr(SE_DMA_TX_PTR_L, (uint32_t)pa);
+		wr(SE_DMA_TX_PTR_H, (uint32_t)(pa >> 32));
+		wr(SE_DMA_TX_ATTR, DMA_TX_ATTR_EOT_BUF);
+		wr(SE_DMA_TX_LEN, length);
+	}
+	{
+		bool tx_done = !tx, rx_done = !rx;
+
+		clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+		while (mach_absolute_time() < deadline) {
+			uint32_t ts = tx ? rd(SE_DMA_TX_IRQ_STAT) : 0;
+			uint32_t rs = rx ? rd(SE_DMA_RX_IRQ_STAT) : 0;
+			uint32_t ms = rd(GENI_M_IRQ_STATUS);
+
+			if (ts) {
+				wr(SE_DMA_TX_IRQ_CLR, ts);
+			}
+			if (rs) {
+				wr(SE_DMA_RX_IRQ_CLR, rs);
+			}
+			if (ms) {
+				wr(GENI_M_IRQ_CLEAR, ms);
+			}
+			if ((ts & DMA_AHB_ERR) || (rs & DMA_AHB_ERR) || (ms & M_ERRORS)) {
+				break;
+			}
+			if (ts & DMA_DONE) {
+				tx_done = true;
+			}
+			if (rs & DMA_DONE) {
+				rx_done = true;
+			}
+			if (tx_done && rx_done) {
+				if (rx) {
+					FlushPoC_DcacheRegion((vm_offset_t)rx, length);
+				}
+				if (traces < 4) {
+					printf("Pong touch: GENI DMA xfer len=%u ok\n", length);
+					traces++;
+				}
+				return true;
+			}
+		}
+	}
+	if (complaints++ < 8) {
+		printf("goodix: SPI DMA transfer of %u bytes failed: stat_tx=%#x stat_rx=%#x irq=%#x txin=%#x rxin=%#x\n",
+		    length, rd(SE_DMA_TX_IRQ_STAT), rd(SE_DMA_RX_IRQ_STAT),
+		    rd(GENI_M_IRQ_STATUS), rd(SE_DMA_TX_LEN_IN), rd(SE_DMA_RX_LEN_IN));
+	}
+	geni_recover();
+	wr(SE_DMA_TX_FSM_RST, 1);
+	wr(SE_DMA_RX_FSM_RST, 1);
+	return false;
+}
+
+static bool
+goodix_read(uint32_t address, uint8_t *data, uint32_t length)
+{
+	if (length > GOODIX_MAX_READ) {
+		return false;
+	}
+	spi_tx[0] = 0xf1;
+	spi_tx[1] = (uint8_t)(address >> 24);
+	spi_tx[2] = (uint8_t)(address >> 16);
+	spi_tx[3] = (uint8_t)(address >> 8);
+	spi_tx[4] = (uint8_t)address;
+	spi_tx[5] = spi_tx[6] = spi_tx[7] = 0xff;
+	memset(spi_tx + 8, 0, length);
+	if (!spi_transfer(spi_tx, spi_rx, 8 + length)) {
+		return false;
+	}
+	memcpy(data, spi_rx + 8, length);
+	return true;
+}
+
+static bool
+goodix_write(uint32_t address, const uint8_t *data, uint32_t length)
+{
+	if (length > GOODIX_MAX_READ) {
+		return false;
+	}
+	spi_tx[0] = 0xf0;
+	spi_tx[1] = (uint8_t)(address >> 24);
+	spi_tx[2] = (uint8_t)(address >> 16);
+	spi_tx[3] = (uint8_t)(address >> 8);
+	spi_tx[4] = (uint8_t)address;
+	memcpy(spi_tx + 5, data, length);
+	return spi_transfer(spi_tx, NULL, 5 + length);
+}
+
+/* The chip's blocks end in the 16-bit sum of their bytes; all zeros or all ones is no answer at all. */
+/* K60_P0_DEV_CONFIRM: Berlin-D needs a boot-option handshake before any
+ * register is readable. Write 8 x 0xAA to 0x10000, read the same 8 bytes back
+ * and require an exact match (3 tries). Reference: Goodix official
+ * goodix_brl_hw.c:75-109,243 and Linux goodix_berlin_core.c:217-247,276.
+ * The frame format in goodix_read/goodix_write is already correct; this only
+ * adds the missing step before them. */
+#define GOODIX_BOOTOPTION_ADDR  0x10000
+#define GOODIX_DEV_CONFIRM_VAL  0xAA
+
+static bool
+goodix_dev_confirm(void)
+{
+	uint8_t tx[8], rx[8];
+
+	if (!spi_transfer) {
+		printf("goodix: dev_confirm before spi_transfer is set\n");
+		return false;
+	}
+	memset(tx, GOODIX_DEV_CONFIRM_VAL, sizeof(tx));
+	for (int attempt = 0; attempt < 3; attempt++) {
+		memset(rx, 0, sizeof(rx));
+		if (!goodix_write(GOODIX_BOOTOPTION_ADDR, tx, sizeof(tx))) {
+			printf("goodix: dev_confirm write failed (attempt %d)\n", attempt);
+			return false;
+		}
+		if (!goodix_read(GOODIX_BOOTOPTION_ADDR, rx, sizeof(rx))) {
+			printf("goodix: dev_confirm read failed (attempt %d)\n", attempt);
+			return false;
+		}
+		if (memcmp(tx, rx, sizeof(tx)) == 0) {
+			printf("goodix: device confirm OK (0x10000 = 8 x 0xAA)\n");
+			return true;
+		}
+		printf("goodix: device confirm mismatch %02x %02x %02x %02x (attempt %d)\n",
+		    rx[0], rx[1], rx[2], rx[3], attempt);
+		sleep_ms(5);
+	}
+	printf("goodix: device confirm FAILED; check AVDD(GPIO71)/IOVDD/RESET/SPI\n");
+	return false;
+}
+
+/* K60_P0_POWER: IOVDD is pm8350c_l2 and is assumed already on from the Android
+ * warm boot (touching RPMh/RSC from XNU kills this machine, HR-01). AVDD is
+ * goodix,avdd-gpio = GPIO71. Vendor order: AVDD -> 15 ms -> RESET low 2 ms ->
+ * RESET high -> 4 ms -> dev_confirm -> 100 ms. */
+static void
+k60_touch_power_cycle(void)
+{
+	/*
+	 * K60_RESET_TIMING: reset is asserted *before* the rails come up, held for
+	 * 2 ms after they do, then given 100 ms to start scanning. Both
+	 * implementations that work on real GT9916 hardware go in this order:
+	 *
+	 *   hakios.goodix.c:1368 power_on (PHK110, same chip, real touch working)
+	 *       gpio_output(PIN_RESET, false, PULL_UP, 8);    reset first
+	 *       gpio_configure(PIN_INT, 0, PULL_UP, 8, false);
+	 *       io_supply_on();
+	 *       sleep_ms(3);
+	 *       gpio_output(PIN_AVDD, true, PULL_NONE, 2);
+	 *       sleep_ms(15);
+	 *
+	 *   goodix_brl_hw.c:310 brl_reset (vendor Linux driver)
+	 *       gpio_direction_output(reset_gpio, 0);
+	 *       usleep_range(2000, 2100);                     <- 2 ms, not 10
+	 *       gpio_direction_output(reset_gpio, 1);
+	 *       msleep(delay);
+	 *
+	 * We used to raise AVDD first and then hold reset low for 10 ms, which
+	 * matches neither: the chip saw power before reset, and the low pulse was
+	 * five times longer than either reference uses.
+	 */
+	gpio_output(PIN_RESET, false, PULL_UP, 6);
+	gpio_output(71u, true, PULL_NONE, 6);
+	sleep_ms(3);
+	sleep_ms(15);
+	gpio_output(PIN_RESET, true, PULL_UP, 6);
+	sleep_ms(2);
+	sleep_ms(100);
+}
+
+/* ==== K60_MISO_FLOAT_TEST: is anything driving the SPI data lines? =========
+ * TLMM pull encoding: 0 = none, 1 = pull-down, 3 = pull-up (see PULL_* above).
+ * Sample each candidate pin with a pull-up and with a pull-down. A pin that
+ * follows the pull is floating: nothing drives it (controller unpowered or in
+ * reset). A pin that ignores the pull is driven by the controller.
+ * Read-only: GPIO configuration + input sampling only, no PMIC access.
+ */
+static unsigned
+k60_sample_with_pull(unsigned pin, unsigned pull)
+{
+	gpio_configure(pin, 0, pull, 2, false);
+	for (volatile int i = 0; i < 2000; i++) { }
+	return gpio_get(pin) ? 1u : 0u;
+}
+
+static void
+k60_miso_float_test(void)
+{
+	static const unsigned cand[4] = {16u, 17u, 18u, 19u};
+	printf("K60FLOAT: pull-up(3) vs pull-down(1) on gpio16..19 (same value = driven)\n");
+	for (unsigned i = 0; i < 4; i++) {
+		unsigned up = k60_sample_with_pull(cand[i], PULL_UP);
+		unsigned dn = k60_sample_with_pull(cand[i], 1u);
+		printf("K60FLOAT: gpio%u up=%u down=%u -> %s\n",
+		    cand[i], up, dn, (up == dn) ? "DRIVEN" : "FLOATING");
+	}
+	printf("K60FLOAT: int(gpio21) pull-up=%u  reset(gpio20) pull-up=%u\n",
+	    k60_sample_with_pull(PIN_INT, PULL_UP), k60_sample_with_pull(PIN_RESET, PULL_UP));
+}
+/* ==== end K60_MISO_FLOAT_TEST ============================================= */
+
+/* ==== K60_RESET_POLARITY_SWEEP: which RESET level releases the controller? ===
+ * Read-only apart from the RESET GPIO itself. For each reset level, sample INT
+ * and test gpio16..19 as inputs with a pull-up and a pull-down.
+ */
+static void
+k60_reset_polarity_sweep(void)
+{
+	static const unsigned cand[4] = {16u, 17u, 18u, 19u};
+	for (unsigned level = 0; level < 2; level++) {
+		gpio_output(PIN_RESET, level ? true : false, PULL_NONE, 6);
+		sleep_ms(20);
+		printf("K60RST: reset=%u int=%u\n", level, gpio_get(PIN_INT));
+		for (unsigned i = 0; i < 4; i++) {
+			unsigned up = k60_sample_with_pull(cand[i], PULL_UP);
+			unsigned dn = k60_sample_with_pull(cand[i], 1u);
+			printf("K60RST: reset=%u gpio%u up=%u down=%u -> %s\n",
+			    level, cand[i], up, dn, (up == dn) ? "DRIVEN" : "FLOATING");
+		}
+	}
+}
+/* ==== end K60_RESET_POLARITY_SWEEP ======================================= */
