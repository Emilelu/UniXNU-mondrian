 /* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
 
+struct PanelRect {
+	int32_t left, top, right, bottom;
+};
+
+static inline bool
+rectEmpty(const PanelRect & rect)
+{
+	return rect.left >= rect.right || rect.top >= rect.bottom;
+}
+
+static PanelRect
+rectIntersection(const PanelRect & a, const PanelRect & b)
+{
+	return { a.left > b.left ? a.left : b.left, a.top > b.top ? a.top : b.top,
+	         a.right < b.right ? a.right : b.right, a.bottom < b.bottom ? a.bottom : b.bottom };
+}
+
+/* At most an old and a new footprint per hardware layer. Merge overlaps so
+ * translucent pixels are composed once, never blended twice onto old scanout. */
+static void
+addDamage(PanelRect * damage, unsigned * count, PanelRect rect)
+{
+	if (rectEmpty(rect)) {
+		return;
+	}
+	for (unsigned i = 0; i < *count;) {
+		const PanelRect & old = damage[i];
+		if (rect.right < old.left || old.right < rect.left ||
+		    rect.bottom < old.top || old.bottom < rect.top) {
+			i++;
+			continue;
+		}
+		rect = { rect.left < old.left ? rect.left : old.left, rect.top < old.top ? rect.top : old.top,
+		         rect.right > old.right ? rect.right : old.right, rect.bottom > old.bottom ? rect.bottom : old.bottom };
+		damage[i] = damage[--*count];
+		i = 0;
+	}
+	damage[(*count)++] = rect;
+}
+
+struct DisplayLayer {
+	MiniIOSurface * surface;                /* one holder until the layer is replaced or cleared */
+	int32_t src[4], dst[4];
+	int32_t px0, py0, px1, py1;             /* unclipped transform, so clipping does not rescale */
+	PanelRect bounds;                      /* visible footprint only */
+	bool rgba, unscaled;
+};
+
