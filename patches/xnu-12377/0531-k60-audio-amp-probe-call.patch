diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 97827e4..6b0aae0 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -795,2 +795,23 @@ bsd_init(void)
 	bsd_init_kprintf("calling vfsinit\n");
+#if 1
+	/*
+	 * K60 audio amplifier probe: the AW88261 answers a chip-id read over
+	 * AP-owned GENI I2C without the DSP. The switch is the boot argument
+	 * pong_audio_probe=1, read inside the probe; it is deliberately not
+	 * #if defined(XNU_PONG_AUDIO), because that macro reaches
+	 * PongAudioAmp.o only and would compile this call out. Ported from
+	 * the 16 line series, patches/audio/0001:3508-3522.
+	 *
+	 * The anchor is one line on purpose: offline-component-load-probes.patch
+	 * inserts a probe block after vfsinit() earlier in this series, so a
+	 * three-line context no longer matches by the time this patch applies.
+	 */
+	{
+		extern int pong_audio_amp_probe(void) __attribute__((weak));
+
+		if (pong_audio_amp_probe != NULL) {
+			(void)pong_audio_amp_probe();
+		}
+	}
+#endif
 	vfsinit();
