index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_adsp_table.h
@@ -0,0 +1,33 @@
+/* Generated by scripts/gen-adsp-table.py from the shipped adsp.mdt. Do not edit. */
+/* Rows use K60AdspSegment from K60AdspImage.h. */
+#define K60_ADSP_BASE 0x86300000UL
+#define K60_ADSP_WINDOW 0x03100000UL
+#define K60_ADSP_SEGMENTS 24
+
+static const K60AdspSegment k60_adsp_segments[K60_ADSP_SEGMENTS] = {
+    { 0x86300000UL,     6952,     1240, "adsp.b01" }, /* segment 1 */
+    { 0x86302000UL,  3216484,     2972, "adsp.b02" }, /* segment 2 */
+    { 0x86614000UL,    25720,     2952, "adsp.b03" }, /* segment 3 */
+    { 0x8661b000UL,    34632,     2232, "adsp.b04" }, /* segment 4 */
+    { 0x86624000UL,   710336,        0, "adsp.b05" }, /* segment 5 */
+    { 0x86700000UL,      220,     3876, "adsp.b06" }, /* segment 6 */
+    { 0x86701000UL,     4892,     3300, "adsp.b07" }, /* segment 7 */
+    { 0x86703000UL,  2306824,     3320, "adsp.b08" }, /* segment 8 */
+    { 0x86937000UL,   237576,  4825784, "adsp.b09" }, /* segment 9 */
+    { 0x86e0b2c0UL,      720,     2672, "adsp.b10" }, /* segment 10 */
+    { 0x86e0c000UL,     9960,     2328, "adsp.b11" }, /* segment 11 */
+    { 0x86e0f000UL,   131232,     3936, "adsp.b12" }, /* segment 12 */
+    { 0x86e30000UL,    83220,     2796, "adsp.b13" }, /* segment 13 */
+    { 0x86f00000UL,  3167652,     2652, "adsp.b14" }, /* segment 14 */
+    { 0x87206000UL,   108732,   767812, "adsp.b15" }, /* segment 15 */
+    { 0x872dc000UL,      280,     3816, "adsp.b16" }, /* segment 16 */
+    { 0x872dd000UL,   185008,     3408, "adsp.b17" }, /* segment 17 */
+    { 0x87400000UL, 11511192,     2664, "adsp.b18" }, /* segment 18 */
+    { 0x87efb000UL,   503816, 13033464, "adsp.b19" }, /* segment 19 */
+    { 0x88be4000UL,     1936,     2160, "adsp.b20" }, /* segment 20 */
+    { 0x88be5000UL,   201084,     3716, "adsp.b21" }, /* segment 21 */
+    { 0x88c17000UL,   103736,     2760, "adsp.b22" }, /* segment 22 */
+    { 0x88c31000UL,   942080,        0, "adsp.b23" }, /* segment 23 */
+    { 0x88d17000UL,        0,  7245824, ((const char *)0) }, /* segment 24 */
+};
+
