+/* ---- 0303: periodic self-report heartbeat (observation only) ---- */
+static _Atomic int k60_hb_started = 0;
+
+static void k60_heartbeat_thread(void *arg, wait_result_t wr);
+
+void
+k60_heartbeat_start_once(void)
+{
+	if (os_atomic_cmpxchg(&k60_hb_started, 0, 1, relaxed)) {
+		thread_t th;
+		if (kernel_thread_start((thread_continue_t)k60_heartbeat_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		} else {
+			k60_hb_started = 0;
+		}
+	}
+}
+
+static void
+k60_heartbeat_thread(void *arg, wait_result_t wr)
+{
+	static unsigned long long k60_hb_ticks = 0;
+	(void)arg; (void)wr;
+	k60_hb_ticks++;
+	{
+		extern unsigned int k60_abnormal_count;
+		extern unsigned int k60_storm_count(const char *);
+		extern unsigned int k60_kxp_prints;
+		unsigned int k60_xp = k60_storm_count("xpcproxy");
+		unsigned int k60_lag = k60_storm_count("launchd");
+		unsigned int k60_mse = k60_storm_count("MSEarlyBootTask");
+		if (k60_data_win_bytes != 0) {
+			printf("K60HB t=%llu abn=%u xp=%u lag=%u mse=%u kxq=%u kxp=%u dw=%llu dm=%d\n",
+			    k60_hb_ticks * 15, k60_abnormal_count, k60_xp, k60_lag, k60_mse,
+			    k60_execerr_prints, k60_kxp_prints,
+			    (unsigned long long)(k60_data_win_bytes >> 20), k60_data_mounted);
+		} else {
+			printf("K60HB t=%llu abn=%u xp=%u lag=%u mse=%u kxq=%u kxp=%u dw=-1 dm=%d\n",
+			    k60_hb_ticks * 15, k60_abnormal_count, k60_xp, k60_lag, k60_mse,
+			    k60_execerr_prints, k60_kxp_prints, k60_data_mounted);
+		}
+	}
+	assert_wait_timeout((event_t)&k60_hb_started, THREAD_UNINT, 15, NSEC_PER_SEC);
+	thread_block((thread_continue_t)k60_heartbeat_thread);
+	/* NOTREACHED */
+}
