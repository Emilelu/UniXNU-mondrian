+extern "C" IOReturn armcpu_spi_snapshot(uint32_t id,uint64_t *entries) {
+ if(!entries||id<32||id>=1020)return kIOReturnBadArgument;
+ const uint32_t used=__atomic_load_n(&gSpiUsed,__ATOMIC_ACQUIRE);
+ if(used>sizeof(gSpi)/sizeof(gSpi[0]))return kIOReturnNotReady;
+ for(uint32_t i=0;i<used;i++)if(gSpi[i].id==id){
+  *entries=__atomic_load_n(&gSpi[i].count,__ATOMIC_RELAXED);
+  return kIOReturnSuccess;
+ }
+ return kIOReturnNotFound;
+}
