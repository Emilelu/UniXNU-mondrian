+/*
+ * 0405: read-only USB status heartbeat (P0, docs/research/usb/RESEARCH.md §9).
+ *
+ * Every USB conclusion so far comes from one-shot prints taken during
+ * bring-up. Nothing observes plug/unplug, bus reset, suspend or a wedged
+ * event ring afterwards, so the next step (a composite descriptor, P1)
+ * could not tell "the descriptor is wrong" from "the controller fell off
+ * the bus". This thread samples the live controller every 2 s.
+ *
+ * Safety, each point tied to an existing code fact:
+ *  - ud.dwc is published exactly once by the worker; the local copy is
+ *    taken first and 0 is treated as "unmapped" instead of dereferenced.
+ *  - QSCRATCH is a worker-local mapping, so this thread maps its own
+ *    0x100 window once; no retry loop on failure.
+ *  - GCC is mapped as the single 4 KiB page that holds
+ *    GCC_USB30_PRIM_GDSCR (0x149000 + 0x004) rather than the worker's
+ *    1 MiB block; same register, smaller window. Precedent: the touch
+ *    line's 4 KiB GCC sub-maps (docs/research/touch/05-plan.md).
+ *  - Only usb_rd() is used. No write helper appears anywhere below, and
+ *    no field of ud is assigned, so existing behaviour cannot change.
+ */
+#define USBHB_GDSCR_PAGE_PA     (GCC_PA + 0x49000)   /* 0x00149000, page aligned */
+#define USBHB_GDSCR_PAGE_SIZE   0x1000
+#define USBHB_GDSCR_OFF         0x004                /* GCC_USB30_PRIM_GDSCR 0x49004 */
+
+static void
+usb_hb(void *a __unused, wait_result_t w __unused)
+{
+	vm_offset_t gcc = ml_io_map(USBHB_GDSCR_PAGE_PA, USBHB_GDSCR_PAGE_SIZE);
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+
+	if (gcc == 0) {
+		printf("K60 USBHB: gcc window map failed; GDSC field omitted\n");
+	}
+	if (qs == 0) {
+		printf("K60 USBHB: qscratch map failed; VBUS field omitted\n");
+	}
+	for (;;) {
+		vm_offset_t dwc = ud.dwc;        /* published once, before use */
+		if (dwc == 0) {
+			printf("K60 USBHB: controller unmapped\n");
+		} else {
+			uint32_t dsts = usb_rd(dwc, DSTS);
+			uint32_t dctl = usb_rd(dwc, DCTL);
+			printf("K60 USBHB: DSTS 0x%08x spd %u halt %u DCTL 0x%08x run %u csft %u DALEPENA 0x%08x GEVNTSIZ 0x%08x GEVNTCOUNT 0x%08x\n",
+			    dsts, dsts & 0x7u, (dsts & DSTS_DEVCTRLHLT) ? 1u : 0u,
+			    dctl, (dctl & DCTL_RUN_STOP) ? 1u : 0u,
+			    (dctl & DCTL_CSFTRST) ? 1u : 0u,
+			    usb_rd(dwc, DALEPENA), usb_rd(dwc, GEVNTSIZ),
+			    usb_rd(dwc, GEVNTCOUNT));
+		}
+		if (gcc != 0 && qs != 0) {
+			printf("K60 USBHB: GDSC 0x%08x QSCRATCH HS 0x%08x SS 0x%08x\n",
+			    usb_rd(gcc, USBHB_GDSCR_OFF),
+			    usb_rd(qs, QSCRATCH_HS_PHY_CTRL),
+			    usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
+		}
+		ud_sleep_ms(2000);
+	}
+}
