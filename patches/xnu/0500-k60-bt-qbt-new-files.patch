+/* Small local string helpers: the XNU kernel does not guarantee the full
+ * libc string API in every BSD compile unit. */
+static const char *k60_strchr(const char *s, char c) {
+    for (; s && *s; s++) if (*s == c) return s;
+    return NULL;
+}
+static const char *k60_strstr(const char *s, const char *needle) {
+    if (!s || !needle || !*needle) return s;
+    for (; *s; s++) {
+        const char *a = s, *b = needle;
+        while (*a && *b && *a == *b) { a++; b++; }
+        if (!*b) return s;
+    }
+    return NULL;
+}
+static const char *k60_strrchr(const char *s, char c) {
+    const char *last = NULL;
+    for (; s && *s; s++) if (*s == c) last = s;
+    return last;
+}
+
+/* Firmware names are validated strictly, like the sheng reader
+ * (BluetoothFirmware.c:13-24).  K60 additionally aliases the WCN6855
+ * "wcnhp*" names to the vendor "hp*" and "ht*" spellings, because the
+ * K60 Android tree's older btqca.c uses qca/htbtfw%02x.tlv. */
+static bool k60_firmware_name_ok(const char *name) {
+    static const char *prefix[] = {
+        "qca/wcnhpbtfw", "qca/hpbtfw", "qca/htbtfw",
+        "qca/wcnhpnv", "qca/hpnv", "qca/htnv",
+    };
+    if (!name) return false;
+    for (size_t p = 0; p < sizeof(prefix) / sizeof(prefix[0]); p++) {
+        size_t plen = strlen(prefix[p]);
+        if (strncmp(name, prefix[p], plen)) continue;
+        const char *s = name + plen;
+        if (k60_strchr(prefix[p], 'b') && k60_strstr(prefix[p], "btfw")) {
+            /* <2 hex>.tlv */
+            if (!s[0] || !s[1] || s[2] != '.' || s[3] != 't' || s[4] != 'l' ||
+                s[5] != 'v' || s[6] != '\0') return false;
+            for (int i = 0; i < 2; i++)
+                if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')))
+                    return false;
+            return true;
+        }
+        /* <2 hex>[g].bin or <2 hex>[g].b<2-4 hex> */
+        if (!s[0] || !s[1]) return false;
+        const char *tail = s + 2;
+        if (*tail == 'g') tail++;
+        if (!strncmp(tail, ".bin", 4) && tail[4] == '\0') return true;
+        if (tail[0] == '.' && tail[1] == 'b') {
+            size_t n = strlen(tail + 2);
+            if (n < 2 || n > 4) return false;
+            for (size_t i = 0; i < n; i++)
+                if (!((tail[2 + i] >= '0' && tail[2 + i] <= '9') ||
+                      (tail[2 + i] >= 'a' && tail[2 + i] <= 'f'))) return false;
+            return true;
+        }
+        return false;
+    }
+    return false;
+}
+
+#ifdef KERNEL
+/* VFS reader for the Data-addon firmware.  Modeled on the sheng board reader
+ * (BluetoothFirmware.c:25-51): vnode_open + vnode_getattr + vn_rdwr, with a
+ * 4 MiB bound and a short-read check.  The Data addon must be mounted; the
+ * worker waits for native_gpu_addon_stage >= 1 before entering power-on. */
+static int k60_bt_firmware_read(const char *name, uint8_t **data, size_t *size) {
+    if (!data || !size || !name) return EINVAL;
+    *data = NULL; *size = 0;
+    /* Runtime-first path is the verified Data-addon copy.  The Android paths
+     * are fallbacks for a development build that mounts the vendor/modem
+     * partition read-only; they are never required on a normal boot. */
+    static const char *const roots[] = {
+        K60_BT_FIRMWARE_ROOT,
+        "/vendor/firmware/qca",
+        "/vendor/firmware",
+        "/firmware/image",
+        "/modem/image/qca6490",
+    };
+    const char *base = strncmp(name, "qca/", 4) ? name : name + 4;
+    vfs_context_t ctx = vfs_context_kernel();
+    int error = ENOENT;
+    for (size_t r = 0; r < sizeof(roots) / sizeof(roots[0]); r++) {
+        char path[160];
+        vnode_t vp = NULL;
+        uint8_t *buffer = NULL;
+        size_t length = 0;
+        snprintf(path, sizeof(path), "%s/%s", roots[r], base);
+        error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+        if (!error) {
+            struct vnode_attr va;
+            VATTR_INIT(&va);
+            VATTR_WANTED(&va, va_data_size);
+            error = vnode_getattr(vp, &va, ctx);
+            if (!error && (vnode_vtype(vp) != VREG || !va.va_data_size ||
+                           va.va_data_size > 4u * 1024u * 1024u)) error = EINVAL;
+            if (!error) {
+                length = (size_t)va.va_data_size;
+                buffer = IOMallocData(length);
+                if (!buffer) error = ENOMEM;
+                else {
+                    int resid = 0;
+                    error = vn_rdwr(UIO_READ, vp, (caddr_t)buffer, (int)length, 0,
+                                    UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx),
+                                    &resid, vfs_context_proc(ctx));
+                    if (!error && resid) error = EIO;
+                }
+            }
+        }
+        if (vp) vnode_close(vp, FREAD, ctx);
+        if (!error) { *data = buffer; *size = length; return 0; }
+        if (buffer) IOFreeData(buffer, length);
+    }
+    return error;
+}
+#else
+static int k60_firmware_read_host(const char *name, const uint8_t **data, size_t *size) {
+    (void)name; (void)data; (void)size; return -ENOENT;
+}
+#endif
+
+/* Try the exact requested name first, then the two historical spellings.
+ * Example: qca/wcnhpbtfw21.tlv -> qca/hpbtfw21.tlv -> qca/htbtfw21.tlv. */
+static int k60_firmware_get(void *ctx, const char *name, const uint8_t **data, size_t *size) {
+    (void)ctx;
+    if (!data || !size) return -EINVAL;
+    *data = NULL; *size = 0;
+    if (!k60_firmware_name_ok(name)) return -ENOENT;
+    const char *slash = k60_strrchr(name, '/');
+    const char *base = slash ? slash + 1 : name;
+    const char *stems[3];
+    unsigned nstems = 0;
+    if (!strncmp(base, "wcnhpbtfw", 9)) { stems[nstems++] = "wcnhpbtfw"; stems[nstems++] = "hpbtfw"; stems[nstems++] = "htbtfw"; }
+    else if (!strncmp(base, "hpbtfw", 6)) { stems[nstems++] = "hpbtfw"; stems[nstems++] = "wcnhpbtfw"; stems[nstems++] = "htbtfw"; }
+    else if (!strncmp(base, "htbtfw", 6)) { stems[nstems++] = "htbtfw"; stems[nstems++] = "hpbtfw"; stems[nstems++] = "wcnhpbtfw"; }
+    else if (!strncmp(base, "wcnhpnv", 7)) { stems[nstems++] = "wcnhpnv"; stems[nstems++] = "hpnv"; stems[nstems++] = "htnv"; }
+    else if (!strncmp(base, "hpnv", 4)) { stems[nstems++] = "hpnv"; stems[nstems++] = "wcnhpnv"; stems[nstems++] = "htnv"; }
+    else if (!strncmp(base, "htnv", 4)) { stems[nstems++] = "htnv"; stems[nstems++] = "hpnv"; stems[nstems++] = "wcnhpnv"; }
+    else return -ENOENT;
+    const char *suffix = base + strlen(stems[0]); /* caller's stem may differ from stems[0] */
+    if (!strncmp(base, "hpbtfw", 6)) suffix = base + 6;
+    else if (!strncmp(base, "htbtfw", 6)) suffix = base + 6;
+    else if (!strncmp(base, "hpnv", 4)) suffix = base + 4;
+    else if (!strncmp(base, "htnv", 4)) suffix = base + 4;
+    else if (!strncmp(base, "wcnhpbtfw", 9)) suffix = base + 9;
+    else if (!strncmp(base, "wcnhpnv", 7)) suffix = base + 7;
+    int last = -ENOENT;
+    for (unsigned i = 0; i < nstems; i++) {
+        char candidate[96];
+        snprintf(candidate, sizeof(candidate), "qca/%s%s", stems[i], suffix);
+        if (!k60_firmware_name_ok(candidate)) continue;
+        uint8_t *bytes = NULL;
+        int e;
+#ifdef KERNEL
+        e = k60_bt_firmware_read(candidate, &bytes, size);
+#else
+        (void)bytes;
+        e = k60_firmware_read_host(candidate, data, size);
+#endif
+        if (!e) {
+#ifdef KERNEL
+            *data = bytes;
+#endif
+            if (strcmp(candidate, name)) k60_log(NULL, 6, candidate); /* trace alias */
+            return 0;
+        }
+        last = e;
+    }
+    return last;
+}
+static void k60_firmware_put(void *ctx, const uint8_t *data, size_t size) {
+    (void)ctx;
+    if (data) IOFreeData((void *)data, size);
+}
+static void k60_log(void *ctx, int level, const char *line) {
+    (void)ctx;
+#ifdef KERNEL
+    if (level <= 3) printf("[bluetooth] %s\n", line);
+#else
+    if (level <= 3) fprintf(stderr, "[bluetooth] %s\n", line);
+#endif
+}
+
+static const struct qbt_platform k60_platform = {
+    .context = NULL,
+    .allocate = k60_allocate,
+    .release = k60_release,
+    .now_ns = k60_now_ns,
+    .uart_write = k60_uart_write_cb,
+    .uart_drained = k60_uart_drained,
+    .uart_speed = k60_uart_speed,
+    .uart_flow = k60_uart_flow,
+    .clock = k60_clock,
+    .pump = k60_pump,
+    .wait_until = k60_wait_until,
+    .receive = k60_transport_receive,
+    .firmware_get = k60_firmware_get,
+    .firmware_put = k60_firmware_put,
+    .log = k60_log,
+};
+
+/* ------------------------------------------------------------------------- */
+/* Power sequencing (TLMM only; no RSC/regulator access)                      */
+/* ------------------------------------------------------------------------- */
+
+static void k60_xo_pulse(void) {
+    /* Vendor sequence btpower.c:423-456: drive XO high, wait 100-200 us,
+     * raise BT_EN, then hold XO 4-6 ms before releasing. */
+    k60_gpio_output(K60_BT_XO_GPIO, true, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
+    IODelay(K60_XO_PULSE_US);
+}
+static void k60_xo_release(void) {
+    IODelay(5000);
+    k60_gpio_output(K60_BT_XO_GPIO, false, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
+}
+
+static int k60_bt_power_on(void) {
+    if (k60.powered) return 0;
+    if (!k60.warm_boot) {
+        /* K60 hard rule: the PMIC rails are RPMh/RSC controlled and RSC must
+         * not be read.  Cold boot needs an external (UEFI/SPMI) voter. */
+        return -EOPNOTSUPP;
+    }
+    int e = k60_map(&k60.gcc, K60_GCC_BASE, K60_GCC_SIZE);
+    if (!e) e = k60_map(&k60.uart, K60_BT_UART_BASE, K60_BT_UART_SIZE);
+    if (!e) e = k60_map(&k60.qup, K60_BT_QUP_WRAPPER_BASE, K60_BT_QUP_WRAPPER_SIZE);
+    if (!e) e = k60_map(&k60.tlmm, K60_TLMM_BASE, K60_TLMM_SIZE);
+    if (!e) e = k60_map(&k60.gic, K60_GIC_DIST_BASE, K60_GIC_DIST_SIZE);
+    if (e) return e;
+    if (!k60.dma_base) {
+        k60.dma_bytes = K60_DMA_BYTES;
+        k60.dma_base = IOMallocData(k60.dma_bytes);
+        if (!k60.dma_base) return -ENOMEM;
+        /* TODO: replace with a physically contiguous allocation and map the
+         * QUPV3_2 SMMU stream (FDT iommus = <&apps_smmu 0x483 0>).
+         * The skeleton assumes a 1:1 PA here; if the SMMU is translating,
+         * this address is wrong and GENI DMA will fault. */
+        k60.dma_pa = (uint64_t)(uintptr_t)k60.dma_base;
+    }
+    /* Keep UART pins parked while the controller is held in reset. */
+    k60_uart_pins_idle();
+    /* Read WLAN_EN (GPIO80) without changing its mux/direction: the WLAN
+     * driver or the bootloader owns that pin. */
+    k60_gpio_output(K60_BT_EN_GPIO, false, K60_TLMM_PULL_DOWN, K60_TLMM_DRIVE_2MA);
+    IOSleep(K60_BT_EN_LOW_MS);
+    if (k60_pin_input(K60_WLAN_EN_GPIO)) {
+        k60_xo_pulse();
+        k60_gpio_output(K60_BT_EN_GPIO, true, K60_TLMM_PULL_DOWN, K60_TLMM_DRIVE_2MA);
+        k60_xo_release();
+    } else {
+        IOSleep(K60_WLAN_OFF_DISCHARGE_MS);
+        k60_xo_pulse();
+        k60_gpio_output(K60_BT_EN_GPIO, true, K60_TLMM_PULL_DOWN, K60_TLMM_DRIVE_2MA);
+        k60_xo_release();
+    }
+    IOSleep(K60_BT_EN_HIGH_MS);
+    k60.powered = true; /* mark early so any later failure runs power_off cleanup */
+    k60_gpio_input(K60_BT_SW_CTRL_GPIO, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
+    if (!k60.clocked) {
+        e = k60_serial_clock(true);
+        if (e) return e;
+    }
+    k60_uart_pins_active();
+    e = k60_stop_engine();
+    if (e) return e;
+    e = k60_prepare_engine();
+    if (e) return e;
+    if (!k60.serial_irq) {
+        e = armcpu_spi_attach(K60_BT_UART_GIC_SPI, false, k60_uart_irq, NULL, NULL, NULL);
+        if (e) return -EIO;
+        k60.serial_irq = true;
+        k60_irq_mask(NULL, true);
+    }
+    if (!k60.wake_irq) {
+        e = armcpu_spi_attach(K60_TLMM_GIC_SPI, false, k60_tlmm_irq, NULL, NULL, NULL);
+        if (e) return -EIO;
+        k60.wake_irq = true;
+    }
+    e = qbt_geni_start(&k60.geni);
+    if (e) return e;
+    k60.gated = false;
+    return 0;
+}
+
+static int k60_bt_power_off(void) {
+    if (!k60.powered) return 0;
+    qbt_set_service(k60.core, false);
+    k60.service = false;
+    int e = 0;
+    if (k60.geni.state != QBT_GENI_OFF) {
+        if (k60.gated) { int r = k60_clock(NULL, true); if (!e) e = r; }
+        if (k60.clocked && k60.core) { int r = qbt_shutdown(k60.core); if (!e) e = r; }
+    }
+    if (k60.clocked && k60.geni.state != QBT_GENI_OFF) { int r = k60_quiesce(); if (!e) e = r; }
+    k60_irq_mask(NULL, true);
+    k60_disarm_rx_wake();
+    k60_gpio_output(K60_BT_EN_GPIO, false, K60_TLMM_PULL_DOWN, K60_TLMM_DRIVE_2MA);
+    IOSleep(K60_BT_OFF_MS);
+    if (k60.clocked) (void)k60_stop_engine();
+    k60_serial_clock(false);
+    k60.powered = false;
+    k60.gated = false;
+    __atomic_store_n(&k60.rx_wake, 0u, __ATOMIC_RELEASE);
+    return e;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Interrupt handlers and transport glue                                      */
+/* ------------------------------------------------------------------------- */
+
+static void k60_uart_irq(void *ctx) {
+    (void)ctx;
+    qbt_geni_irq(&k60.geni);
+}
+static void k60_tlmm_irq(void *ctx) {
+    (void)ctx;
+    volatile uint32_t *r = k60.tlmm.va + K60_TLMM_GPIO_CFG(K60_BT_RX_WAKE_GPIO) / 4u;
+    if (!(r[3] & 1u)) return;
+    r[2] &= ~(1u << K60_TLMM_INTR_ENABLE_BIT);
+    r[3] = 0;
+    k60_barrier();
+    __atomic_store_n(&k60.rx_wake, 1u, __ATOMIC_RELEASE);
+    k60_wake(NULL);
+}
+
+static int k60_request_power(void *ctx, bool enabled) {
+    (void)ctx;
+    uint32_t expected = 0;
+    if (!__atomic_compare_exchange_n(&k60.power_request, &expected, enabled ? 1u : 2u,
+                                     false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+        return EBUSY;
+    k60_wake(NULL);
+    return 0;
+}
+
+static void k60_power_result(bool enabled, int error) {
+    struct qbt_info info;
+    qbt_get_info(k60.core, &info);
+#ifdef KERNEL
+    printf("[bluetooth] power=%u result=%d baud=%u firmware=%s\n",
+           enabled, error, info.baud, info.firmware);
+#endif
+    qbt_transport_power_result(enabled, error < 0 ? -error : error,
+                               info.firmware, info.baud);
+}
+
+static void k60_worker(void *arg, wait_result_t wait_result) {
+    (void)arg; (void)wait_result;
+#ifdef KERNEL
+    thread_set_thread_name(current_thread(), "k60-bluetooth");
+#endif
+    k60.core = qbt_create(&k60_platform);
+    if (!k60.core) return;
+    struct qbt_transport_ops transport = { .context = NULL, .wake = k60_wake, .power = k60_request_power };
+    if (qbt_transport_init(&transport)) return;
+#ifdef KERNEL
+    while (&native_gpu_addon_stage && native_gpu_addon_stage < 1)
+        k60_wait_until(NULL, k60_now_ns(NULL) + 10000000ULL);
+#endif
+    int e = k60_bt_power_on();
+    if (!e) {
+        /* The local address comes from the board identity hook (in the real
+         * board integration: /chosen/unique-chip-id hashed with a fixed
+         * domain, same approach as sheng BluetoothProbe.cpp:222-264).  If the
+         * hook is absent, qbt_boot rejects the all-zero address. */
+#ifdef KERNEL
+        e = k60_bt_local_address ? k60_bt_local_address(k60.address) : -ENOENT;
+#else
+        e = -ENOENT;
+#endif
+        if (!e) e = qbt_boot(k60.core, K60_BT_RUN_BAUD, k60.address);
+    }
+    if (e) (void)k60_bt_power_off();
+    k60_power_result(true, e);
+    uint64_t health = k60_now_ns(NULL) + 1000000000ULL;
+    uint64_t close_at = 0;
+    for (;;) {
+        uint32_t command = __atomic_exchange_n(&k60.power_request, 0u, __ATOMIC_ACQ_REL);
+        if (command) {
+            e = command == 1 ? k60_bt_power_on() : k60_bt_power_off();
+            if (e && command == 1) (void)k60_bt_power_off();
+            k60_power_result(command == 1, e);
+        }
+        if (k60.powered) {
+            k60_pump(NULL);
+            bool active = qbt_transport_active();
+            if (active != k60.service) {
+                qbt_set_service(k60.core, active);
+                k60.service = active;
+                close_at = active ? 0 : k60_now_ns(NULL) + 500000000ULL;
+            }
+            uint8_t tx[2048];
+            size_t room = qbt_transmit_capacity(k60.core);
+            if (room > sizeof(tx)) room = sizeof(tx);
+            if (room) {
+                uint32_t n = qbt_transport_tx_take(tx, (uint32_t)room);
+                if (n && qbt_transmit(k60.core, tx, n)) e = -EIO;
+            }
+            qbt_step(k60.core);
+            struct qbt_info info;
+            qbt_get_info(k60.core, &info);
+            if (info.state == 3 || k60.geni.state == QBT_GENI_FAILED ||
+                (close_at && k60_now_ns(NULL) >= close_at)) {
+                int error = info.state == 3 ? info.error : k60.geni.error;
+                (void)k60_bt_power_off();
+                k60_power_result(false, error);
+                close_at = 0;
+            }
+        }
+        uint64_t t = k60_now_ns(NULL);
+        if (t >= health) health = t + 1000000000ULL;
+        uint64_t deadline = k60.powered ? qbt_deadline(k60.core) : UINT64_MAX;
+        uint64_t geni = k60.powered && !k60.gated ? qbt_geni_deadline(&k60.geni) : UINT64_MAX;
+        if (geni < deadline) deadline = geni;
+        if (health < deadline) deadline = health;
+        if (close_at && close_at < deadline) deadline = close_at;
+        if (!deadline) { thread_yield_to_preemption(); continue; }
+        k60_wait_until(NULL, deadline);
+    }
+}
+
+/* Entry point called from bsd_init.c/bsd_autoconf when boot arg k60bt=1. */
+void qbt_k60_start(void) {
+    uint32_t expected = 0;
+    if (!__atomic_compare_exchange_n(&k60.started, &expected, 1u, false,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;
+    unsigned enabled = 0;
+    if (!PE_parse_boot_argn("k60bt", &enabled, sizeof(enabled)) || !enabled) {
+        k60.started = 0;
+        return;
+    }
+    k60.stage = 1;
+    (void)PE_parse_boot_argn("k60bt_stage", &k60.stage, sizeof(k60.stage));
+    if (!k60.stage) { k60.started = 0; return; }
+    unsigned warm = 0;
+    /* Default to refusing: K60 first bring-up must be from a warm Android boot
+     * so PM8350 S10/S11/S12, PM8350C S1 and PMR735A L7 are already on. */
+    k60.warm_boot = PE_parse_boot_argn("k60bt_warm", &warm, sizeof(warm)) && warm != 0;
+#ifdef KERNEL
+    thread_t thread = NULL;
+    if (kernel_thread_start(k60_worker, NULL, &thread) == KERN_SUCCESS)
+        thread_deallocate(thread);
+    else
+        k60.started = 0;
+#endif
+}
+
+#ifdef K60_BT_HOST_TEST
+/* Tiny host self-check for the clock arithmetic.  Not built into the kernel. */
+int main(void) {
+    uint32_t hz = 0;
+    if (k60_geni_source_hz(115200, 16, &hz) || hz != 7372800u) return 1;
+    if (k60_geni_source_hz(3000000, 16, &hz) || hz != 48000000u) return 1;
+    if (k60_geni_source_hz(3200000, 16, &hz) != -ERANGE) return 1;
+    if (k60_geni_source_hz(4000000, 16, &hz) || hz != 64000000u) return 1;
+    printf("qbt_k60 host checks passed\n");
+    return 0;
+}
+#endif
