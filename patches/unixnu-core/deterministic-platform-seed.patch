+def platform_seed(options):
+    """The 256 bytes of /chosen/random-seed, or fresh randomness.
+
+    The seed sets the physmap slide, so a random one makes a fixed share of
+    boots die in pmap_map_bd and read as memory corruption. A board that pins
+    `adt.random_seed` gets one slide for every build; the hexadecimal value is
+    repeated to fill the four 64-byte seeds xnu-12377 reads.
+    """
+    text = options.get('random_seed')
+    if text is None:
+        return os.urandom(256)
+    try:
+        raw = bytes.fromhex(str(text))
+    except ValueError:
+        raise Error('adt.random_seed must be hexadecimal')
+    if not raw:
+        raise Error('adt.random_seed must not be empty')
+    return (raw * (256 // len(raw) + 1))[:256]
+
+
