diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7678,4 +7678,224 @@
 }
 
+/*-
+ * K60 METAL PLUGIN DEPLOYMENT
+ *
+ * The Adreno Metal plugin bundle is 51 MB, far too large for a kernel blob
+ * (0340's libpong-ui is 111 KB and already costs a 614 KB patch). It travels
+ * inside the boot payload image, which the firmware leaves as a FAT volume at
+ * /dev/md0, and this copies it onto the writable Data volume before launchd
+ * starts.
+ *
+ * Why it has to happen at all: drivers/PongAdreno/PongAdrenoAccelerator.cpp:44
+ * publishes MetalPluginName=PongAdrenoMetal on the IOAcceleratorES service and
+ * the system then loads /System/Library/Extensions/<that name>.bundle. That
+ * bundle is not in the sealed root, so nothing loads and the compositor falls
+ * back to software -- the flat, blurred-free dock this port shows.
+ *
+ * PongMetalPlugin.mm:170-199 gates every client on two root-owned seeds next to
+ * the bundle:
+ *     PongAdrenoMetal.publish   the single byte '1'
+ *     PongAdrenoMetal.clients   one process name per line (backboardd, ...)
+ * with a strict test: a regular file, st_uid == 0, and no group/other write bit.
+ * Hence mode 0644 and owner 0:0 below.
+ *
+ * This lives in kern_exec.c rather than a new bsd/dev file because this file
+ * already includes <sys/mount_internal.h> (line 95) and uses struct mount_args;
+ * a file under bsd/dev gets a different header search order and cannot see them.
+ *
+ * The copy is chunked through a fixed-size kalloc_type zone: this kernel has no
+ * variable-sized kalloc(), only the type-aware kalloc_type() (see the
+ * kalloc_type(struct nameidata, ...) calls elsewhere in this file).
+ */
+#define K60_METAL_STAGE   "/private/var/pong/md0"
+#define K60_METAL_DEST    "/private/var/pong"
+#define K60_METAL_SRC     "/private/var/pong/PongAdrenoMetal.bundle"
+#define K60_METAL_TARGET  "/System/Library/Extensions/PongAdrenoMetal.bundle"
+
+struct k60_metal_chunk {
+	uint8_t bytes[16384];
+};
+static KALLOC_TYPE_DEFINE(k60_metal_chunk_zone, struct k60_metal_chunk, KT_DEFAULT);
+
+static const char * const k60_metal_files[] = {
+	"PongAdrenoMetal.bundle/Info.plist",
+	"PongAdrenoMetal.bundle/PongAdrenoMetal",
+	"PongAdrenoMetal.bundle/PongMetalBridge.dylib",
+	"PongAdrenoMetal.bundle/libvulkan_freedreno.dylib",
+	"PongAdrenoMetal.publish",
+	"PongAdrenoMetal.clients",
+};
+
+static void
+k60_metal_path(char *out, size_t cap, const char *dir, const char *name)
+{
+	(void)strlcpy(out, dir, cap);
+	(void)strlcat(out, "/", cap);
+	(void)strlcat(out, name, cap);
+}
+
+/* Copy size bytes from src to dst through one 64 KiB chunk. */
+static int
+k60_metal_stream(vnode_t src, vnode_t dst, off_t size)
+{
+	struct k60_metal_chunk *chunk;
+	vfs_context_t ctx = vfs_context_current();
+	off_t at = 0;
+	int error = 0;
+
+	chunk = kalloc_type(struct k60_metal_chunk, Z_WAITOK);
+	if (!chunk) {
+		return ENOMEM;
+	}
+	while (at < size) {
+		off_t left = size - at;
+		int want = left > (off_t)sizeof(chunk->bytes) ? (int)sizeof(chunk->bytes) : (int)left;
+		int rresid = 0, wresid = 0, done;
+
+		error = vn_rdwr(UIO_READ, src, (caddr_t)chunk->bytes, want, at,
+		    UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &rresid, NULL);
+		if (error) {
+			break;
+		}
+		done = want - rresid;
+		if (done <= 0) {
+			error = EIO;
+			break;
+		}
+		error = vn_rdwr(UIO_WRITE, dst, (caddr_t)chunk->bytes, done, at,
+		    UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), &wresid, current_proc());
+		if (error) {
+			break;
+		}
+		done -= wresid;
+		if (done <= 0) {
+			error = EIO;
+			break;
+		}
+		at += done;
+	}
+	kfree_type(struct k60_metal_chunk, chunk);
+	return error;
+}
+
+/* Read one file out of the staged FAT volume and write it onto Data. */
+static int
+k60_metal_copy(const char *name)
+{
+	char from[256], to[256];
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t svp = NULLVP, dvp = NULLVP;
+	struct vnode_attr va;
+	off_t size;
+	int error;
+
+	k60_metal_path(from, sizeof(from), K60_METAL_STAGE "/METAL", name);
+	k60_metal_path(to, sizeof(to), K60_METAL_DEST, name);
+
+	error = vnode_lookup(from, 0, &svp, ctx);
+	if (error) {
+		printf("K60METAL: lookup %s error=%d\n", name, error);
+		return error;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	error = vnode_getattr(svp, &va, ctx);
+	size = error ? 0 : (off_t)va.va_data_size;
+	if (size <= 0 || size > (off_t)(64u << 20)) {
+		vnode_put(svp);
+		return EINVAL;
+	}
+	error = vnode_open(to, O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &dvp, ctx);
+	if (error) {
+		printf("K60METAL: vnode_open %s error=%d\n", name, error);
+		vnode_put(svp);
+		return error;
+	}
+	error = k60_metal_stream(svp, dvp, size);
+	if (!error) {
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_mode);
+		VATTR_WANTED(&va, va_uid);
+		VATTR_WANTED(&va, va_gid);
+		va.va_mode = S_IFREG | 0644;
+		va.va_uid = 0;
+		va.va_gid = 0;
+		(void)vnode_setattr(dvp, &va, ctx);
+	}
+	vnode_close(dvp, 0, ctx);
+	vnode_put(svp);
+	printf("K60METAL: %s %lld bytes error=%d\n", name, (long long)size, error);
+	return error;
+}
+
+static void
+k60_metal_deploy(proc_t p, user_addr_t scratch)
+{
+	struct mount_args request = {
+	    .type = scratch + 0x200, .path = scratch + 0x240,
+	    .flags = MNT_RDONLY, .data = scratch + 0x320 };
+	struct mount_args stage_request = {
+	    .type = scratch + 0x400, .path = scratch + 0x440,
+	    .flags = MNT_RDONLY, .data = scratch + 0x520 };
+	int32_t result = 0;
+	vnode_t probe = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	int i, error, deployed = 0;
+	(void)request;
+	(void)result;
+
+	error = vnode_lookup(K60_METAL_SRC "/PongAdrenoMetal", 0, &probe, ctx);
+	if (error == 0) {
+		vnode_put(probe);
+		printf("K60METAL: bundle already present\n");
+	} else {
+		error = vnode_lookup(K60_METAL_STAGE, 0, &probe, ctx);
+		if (error) {
+			printf("K60METAL: no staging directory (%d)\n", error);
+			return;
+		}
+		vnode_put(probe);
+		if ((error = copyout("msdos", stage_request.type, 6)) ||
+		    (error = copyout(K60_METAL_STAGE, stage_request.path,
+		        sizeof(K60_METAL_STAGE))) ||
+		    (error = copyout("/dev/md0", stage_request.data, 10))) {
+			printf("K60METAL: copyout error=%d\n", error);
+			return;
+		}
+		error = mount(p, &stage_request, &result);
+		printf("K60METAL: mount md0 error=%d result=%d\n", error, result);
+		if (error) {
+			return;
+		}
+		for (i = 0; i < (int)(sizeof(k60_metal_files) / sizeof(k60_metal_files[0])); i++) {
+			if (k60_metal_copy(k60_metal_files[i]) == 0) {
+				deployed++;
+			}
+		}
+		printf("K60METAL: deployed %d/%d file(s)\n", deployed,
+		    (int)(sizeof(k60_metal_files) / sizeof(k60_metal_files[0])));
+		if (deployed == 0) {
+			return;
+		}
+	}
+
+	/*
+	 * No bindfs and no mkdir under /System/Library/Extensions.
+	 *
+	 * P-27 measured every variant: mounting bindfs on a directory of the sealed
+	 * OS volume returns EPERM (result=-1 errno=1) whatever the flags, and
+	 * mkdir there returns EROFS (30). That whole path is dead on this port.
+	 *
+	 * It is also unnecessary. PongMetalPlugin.mm:174 already searches two
+	 * directories for its seed files:
+	 *     for (const char *directory : {"/System/Library/Extensions",
+	 *                                    "/private/var/pong"}) { ... }
+	 * The bundle and its two seeds are now in /private/var/pong, so
+	 * selectedClient() succeeds from there. The plugin binary itself is loaded
+	 * by the Metal catalog from MetalPluginName, not from this path.
+	 */
+	printf("K60METAL: deployed under %s; no bindfs (sealed root refuses it)\n",
+	    K60_METAL_DEST);
+}
 static int
 native_owner_data_prepare(proc_t p, user_addr_t scratch)
@@ -7774,5 +8002,7 @@
 	k60_data_mounted = 1;
+	/* K60: place the Metal plugin bundle and bind it where the loader looks */
+	k60_metal_deploy(p, scratch);
 	/* 0340: place the UI compatibility library on the Data volume */
 	{
 		extern int k60_uilib_deploy(void);
 
