 	check_for_panic_log();
 
+	/*
+	 * Stage 0 has serial=3 but no serial hardware and no display driver, so
+	 * the panel is the only output. With -v in the boot arguments, force the
+	 * stock video console into text mode on the framebuffer the loader passed.
+	 * Bit 0 of v_baseAddr tells vc_attach that kernel_map already exists (this
+	 * runs after arm_vm_init) and that the framebuffer needs a kernel mapping.
+	 */
+	{
+		boolean_t verbose = FALSE;
+		if (PE_parse_boot_argn("-v", &verbose, sizeof(verbose)) && verbose &&
+		    PE_state.video.v_baseAddr && PE_state.video.v_width &&
+		    PE_state.video.v_height && PE_state.video.v_depth == 32) {
+			/*
+			 * The loader and the epilogue leave their own diagnostic fill on the
+			 * panel. Clear it before the console paints, otherwise every glyph is
+			 * drawn over magenta and the text is unreadable in photographs.
+			 */
+			{
+				volatile uint32_t *fb = (volatile uint32_t *)(PE_state.video.v_baseAddr & ~1UL);
+				uint64_t pixels = (uint64_t)PE_state.video.v_rowBytes * PE_state.video.v_height / 4;
+				for (uint64_t i = 0; i < pixels; i++) fb[i] = 0;
+			}
+			PE_state.video.v_baseAddr |= 1UL;
+			PE_state.video.v_display = 0;
+			PE_initialize_console(&PE_state.video, kPETextMode);
+			PE_initialize_console(NULL, kPEAcquireScreen);
+			return;
+		}
+	}
+
 	if (PE_state.video.v_display) {
 		PE_initialize_console(&PE_state.video, kPEGraphicsMode);
