+/*
+ * k60 0321 v2: the first run proved the loader's mapping of
+ * /System/Library/xpc/launchd.plist does NOT start with "bplist00" -- it starts
+ * with "chDa" (mid-"LaunchDaemons"). Store 64 bytes in globals so the next boot
+ * can identify what the loader is actually reading. No printf in this file.
+ */
+int k60_probe_ready;
+int k60_probe_seen;
+unsigned long long k60_probe_start;
+unsigned long long k60_probe_size;
+unsigned int k60_probe_copyin_kr = 0xffffffffu;
+unsigned int k60_probe_copytype;
+unsigned char k60_probe_head[64];
+
+static void
+k60_probe_dealloc_content(vm_map_t k60_map, mach_vm_offset_t k60_start,
+    mach_vm_size_t k60_size)
+{
+	vm_map_copy_t k60_copy = VM_MAP_COPY_NULL;
+	kern_return_t k60_kr;
+	int k60_i;
+
+	if (!k60_probe_ready || k60_probe_seen) {
+		return;
+	}
+	if (k60_size < 1048576ULL || k60_size > 2097152ULL) {
+		return;
+	}
+	k60_kr = vm_map_copyin(k60_map, (vm_map_address_t)k60_start,
+	    (vm_map_size_t)64, FALSE, &k60_copy);
+	k60_probe_start = (unsigned long long)k60_start;
+	k60_probe_size = (unsigned long long)k60_size;
+	k60_probe_copyin_kr = (unsigned int)k60_kr;
+	k60_probe_seen = 1;
+	if (k60_kr == KERN_SUCCESS && k60_copy != VM_MAP_COPY_NULL) {
+		k60_probe_copytype = (unsigned int)k60_copy->type;
+		if (k60_copy->type == VM_MAP_COPY_KERNEL_BUFFER) {
+			const unsigned char *k60_b =
+			    (const unsigned char *)k60_copy->cpy_kdata;
+
+			for (k60_i = 0; k60_i < 64; k60_i++) {
+				k60_probe_head[k60_i] = k60_b[k60_i];
+			}
+		}
+		vm_map_copy_discard(k60_copy);
+	}
+}
+
 kern_return_t
 mach_vm_deallocate(
 	vm_map_t                map,
 	mach_vm_offset_t        start,
 	mach_vm_size_t  size)
 {
+	k60_probe_dealloc_content(map, start, size);
+
 	if ((map == VM_MAP_NULL) || (start + size < start)) {
 		return KERN_INVALID_ARGUMENT;
 	}
