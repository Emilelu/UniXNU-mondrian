     struct qbt_transport_ops transport = { .context = NULL, .wake = k60_wake, .power = k60_request_power };
     if (qbt_transport_init(&transport)) return;
+    if (k60.stage == 1) k60_probe_mark("probe: transport ready");
 #ifdef KERNEL
     while (&native_gpu_addon_stage && native_gpu_addon_stage < 1)
         k60_wait_until(NULL, k60_now_ns(NULL) + 10000000ULL);
 #endif
+    if (k60.stage == 1) {
+        k60_probe_mark("probe: addon gate passed");
