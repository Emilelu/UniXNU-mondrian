 /*
+ * 0334b: default-on automatic reset for the *normal* (non-panic) path.
+ *
+ * k60_panic_reset only covers panic.  k60_usblog_reset (0308) only fires when
+ * a USB host has the console open (ud.ever_connected) and the console ring has
+ * gone quiet - but ud_hb prints a status line every 2 s, so the ring is never
+ * quiet while that thread lives.  A boot that simply sits in user space
+ * therefore never came back to fastboot and needed a human power cycle.
+ *
+ * The window below is independent of the USB host, so it also works with no
+ * console attached:
+ *   k60_autoreset=<s>       reset this many seconds after the kernel reaches
+ *                           the USB-log hook in bsd_init (default 300)
+ *   k60_autoreset_idle=<s>  also reset after this many seconds with no exec /
+ *                           exit / XPC-check-in progress, once boot is past
+ *                           K60_AUTORESET_ARM_DELAY (default 0 = never; a
+ *                           suggested value is 60)
+ * k60_autoreset=0 and k60_autoreset_idle=0 together disable the mechanism
+ * (that is the old behaviour: the phone stays in iOS).
+ */
+#define K60_AUTORESET_DEFAULT_SECS      300
+#define K60_AUTORESET_IDLE_DEFAULT_SECS 0       /* opt-in: k60_autoreset_idle=60 */
+#define K60_AUTORESET_ARM_DELAY         120
+
+static int k60_autoreset_secs = -1;     /* -1: boot-arg not parsed yet */
+static int k60_autoreset_idle = -1;     /* -1: boot-arg not parsed yet */
+
+static int
+k60_autoreset_arg(const char *name, int dflt)
+{
+	int v = -1;
+
+	if (PE_parse_boot_argn(name, &v, sizeof(v)) && v >= 0) {
+		return v;
+	}
+	return dflt;
+}
