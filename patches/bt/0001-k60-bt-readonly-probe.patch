+/* GENI SE register offsets (read-only probe): linux-geni-se-v6.6.h:78-86
+ * SE_GENI_STATUS=0x40, GENI_IF_DISABLE_RO=0x64, GENI_FW_REVISION_RO=0x68; the
+ * protocol field is FW_REV_PROTOCOL bits 15:8 (:132-134).  The wrapper HW
+ * version register is 0x4 (qcom-geni-se.c:114) and SW expects 0x20050000
+ * (QUP_SE_VERSION_2_5, linux-geni-se-v6.6.h:287). */
+#define K60_SE_GENI_STATUS       0x040u
+#define K60_GENI_IF_DISABLE_RO   0x064u
+#define K60_GENI_FW_REVISION_RO  0x068u
+#define K60_QUP_HW_VER_REG       0x004u
+
+/* Stage 1: prove that SE20 answers a register read before any pin muxing,
+ * BT_EN pulse, DMA setup or interrupt is installed.  On the K60 the touch
+ * (QUP0 SE4) and audio (I2C) lines both died with a zero-byte console at the
+ * first GENI register access, so this stage deliberately stops after four
+ * reads; see docs/research/GENI-ACCESS-PRECONDITIONS.md and
+ * docs/research/bt/S1-PROBE-SPEC.md. */
+static int k60_bt_probe(void) {
+    int e = k60_map(&k60.gcc, K60_GCC_BASE, K60_GCC_SIZE);
+    if (!e) e = k60_map(&k60.uart, K60_BT_UART_BASE, K60_BT_UART_SIZE);
+    if (!e) e = k60_map(&k60.qup, K60_BT_QUP_WRAPPER_BASE, K60_BT_QUP_WRAPPER_SIZE);
+    if (e) { k60_log(NULL, 1, "probe: map failed"); return e; }
+    char line[192];
+    snprintf(line, sizeof(line), "probe: mapped gcc=%p uart=%p qup=%p",
+             (void *)k60.gcc.va, (void *)k60.uart.va, (void *)k60.qup.va);
+    k60_log(NULL, 1, line);
+    e = k60_serial_clock(true);   /* GPLL0 + five votes + halt poll, already logged */
+    if (e) { k60_log(NULL, 1, "probe: serial clock failed"); return e; }
+    uint32_t status = k60_read32(&k60.uart, K60_SE_GENI_STATUS);
+    uint32_t ifdis  = k60_read32(&k60.uart, K60_GENI_IF_DISABLE_RO);
+    uint32_t fwrev  = k60_read32(&k60.uart, K60_GENI_FW_REVISION_RO);
+    uint32_t hwver  = k60_read32(&k60.qup, K60_QUP_HW_VER_REG);
+    snprintf(line, sizeof(line),
+             "probe: se20 status=%08x fwrev=%08x proto=%u fifo_if_disabled=%u qup_hw=%08x se_halt=%08x",
+             status, fwrev, (fwrev >> 8) & 0xffu, ifdis & 1u, hwver,
+             k60_read32(&k60.gcc, K60_GCC_WRAP2_SE20_HALT));
+    k60_log(NULL, 1, line);
+    return 0;
+}
