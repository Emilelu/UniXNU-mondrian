diff --git a/bsd/dev/qbt/qbt_internal.h b/bsd/dev/qbt/qbt_internal.h
index 4a2a708..e6868f3 100644
--- a/bsd/dev/qbt/qbt_internal.h
+++ b/bsd/dev/qbt/qbt_internal.h
@@ -13,6 +13,13 @@
 #define QBT_TX_CAPACITY 32768u
 #define QBT_CHUNK 2048u
 #define QBT_COMMAND_TIMEOUT 10000000000ULL
+/* 0514: qbt_boot() has no overall deadline.  A firmware download that
+ * keeps retrying one TLV segment can therefore run for hours: every
+ * segment carries its own 10 s QBT_COMMAND_TIMEOUT and the loop simply
+ * moves on to the next one.  This budget is checked by run() and aborts
+ * the startup path so the worker can still print its power= result line.
+ * It is zero outside qbt_boot(), so the service phase is unaffected. */
+#define QBT_BOOT_BUDGET 90000000000ULL
 #define QBT_WAKE_RETRY 100000000ULL
 #define QBT_TX_POLL 1000000ULL
 #define QBT_SPEED_REPLY_MS 100u
@@ -30,6 +37,7 @@ struct qbt {
     bool service, ibs, rx_awake, clock_on;
     unsigned tx_state, wake_attempts;
     uint64_t retry_at, idle_at;
+    uint64_t boot_deadline;
     uint8_t control[16]; unsigned control_length;
     uint8_t command[259]; unsigned command_length, command_offset;
     bool waiting, complete, speed_reply;
