-    if (((UNIXNU_LOADER_PROTOCOL *)Existing)->Revision != UNIXNU_LOADER_REVISION) { return EFI_UNSUPPORTED; }
+    if (((UNIXNU_LOADER_PROTOCOL *)Existing)->Revision > UNIXNU_LOADER_REVISION) { return EFI_UNSUPPORTED; }
