 static VkResult
+darwin_reclaim_for_allocation(struct tu_device *dev)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   uint32_t fence = 0;
+   pthread_mutex_lock(&retire->lock);
+   VkResult result = darwin_reap_locked(dev, retire);
+   if (result == VK_SUCCESS && retire->count) {
+      const unsigned last = (retire->head + retire->count - 1) % DARWIN_RETIRED_BOS;
+      fence = retire->entries[last].fence;
+      ++retire->pressure_waits;
+   }
+   pthread_mutex_unlock(&retire->lock);
+   if (result != VK_SUCCESS)
+      return result;
+   /* No driver/retirement/VMA lock is held across the wait. A timeout preserves
+    * every allocation and remains an allocation failure, never a fake fence. */
+   if (fence) {
+      result = dw_wait_fence_raw(dev, fence, os_time_get_nano() + 250000000ull);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   return darwin_collect_retired(dev);
+}
