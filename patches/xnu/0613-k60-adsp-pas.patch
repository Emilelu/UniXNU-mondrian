diff --git a/bsd/dev/pong_adsp_pas.h b/bsd/dev/pong_adsp_pas.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_adsp_pas.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* PAS (peripheral authentication service) calls for the K60 ADSP.
+ *
+ * The encoders are pure arithmetic and are covered by a host test; the SMC
+ * itself is the only part that needs the device, and it follows the shape the
+ * reference implementation uses: 64-bit standard call, SiP owner, service 2.
+ */
+#ifndef K60_ADSP_PAS_H
+#define K60_ADSP_PAS_H
+
+#include <stdint.h>
+
+#define K60_SCM_SVC_PIL 0x02u
+#define K60_SCM_PAS_INIT_IMAGE 0x01u
+#define K60_SCM_PAS_MEM_SETUP 0x02u
+#define K60_SCM_PAS_AUTH_AND_RESET 0x05u
+#define K60_SCM_PAS_SHUTDOWN 0x06u
+
+#define K60_SCM_VAL 0u
+#define K60_SCM_RW 2u
+
+#define K60_PAS_ADSP 1u
+/* Destination, not link address: adsp.mdt links at 0x86300000 (pong's
+ * carveout); this board reserves adsp_region@0x9fd00000 span 0x3100000. */
+#define K60_ADSP_LOAD_BASE 0x9fd00000ull
+#define K60_ADSP_LOAD_SPAN 0x3100000ull
+
+/* Function id: SMC64 | SiP owner | service | command. */
+static inline uint32_t
+k60_scm_fn(uint32_t svc, uint32_t cmd)
+{
+	return (1u << 30) | (2u << 24) | ((svc & 0xffu) << 8) | (cmd & 0xffu);
+}
+
+/* Argument-type word: count in bits 3:0, type i in bits 5+2i:4+2i. */
+static inline uint32_t
+k60_scm_args(unsigned count, unsigned t0, unsigned t1, unsigned t2)
+{
+	return (count & 0xfu) | ((t0 & 3u) << 4) | ((t1 & 3u) << 6) | ((t2 & 3u) << 8);
+}
+
+/* A call succeeded only when both result registers are zero: x0 alone reports
+ * the transport, x1 carries the payload verdict. */
+static inline int
+k60_scm_ok(uint64_t x0, uint64_t x1)
+{
+	return x0 == 0 && x1 == 0;
+}
+
+enum {
+	K60PasOk = 0,
+	K60PasDenied = -1,
+	K60PasBadArg = -2,
+};
+
+int k60_adsp_auth_and_reset(void);
+int k60_adsp_init_image(uint64_t phys);
+int k60_adsp_mem_setup(uint64_t base, uint64_t span);
+int k60_adsp_shutdown(void);
+
+/* True when the kernel glue reached the secure monitor at least once; the
+ * boot log uses it to separate "SCM refused" from "SCM never called". */
+int k60_adsp_scm_tried(void);
+
+#endif /* K60_ADSP_PAS_H */
diff --git a/bsd/dev/pong_adsp_pas.c b/bsd/dev/pong_adsp_pas.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_adsp_pas.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* PAS calls for the K60 ADSP: the SMC glue only. The encoders live in the
+ * header so a host test can prove them without the device. */
+
+#include "pong_adsp_pas.h"
+
+#ifndef K60_HOST_TEST
+
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+static int k60_scm_called;
+
+/* R8..x7 are the SMCCC argument registers; the secure monitor writes both the
+ * result (x0) and the payload status (x1) back through the same registers. */
+static int
+k60_scm_call(uint32_t fn, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c,
+    uint64_t *rx0, uint64_t *rx1)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = arginfo;
+	register uint64_t x2 __asm__("x2") = a;
+	register uint64_t x3 __asm__("x3") = b;
+	register uint64_t x4 __asm__("x4") = c;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	register uint64_t x7 __asm__("x7") = 0;
+
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    : "r"(x4), "r"(x5), "r"(x6), "r"(x7)
+	    : "memory");
+
+	k60_scm_called = 1;
+	*rx0 = x0;
+	*rx1 = x1;
+	return k60_scm_ok(x0, x1) ? K60PasOk : K60PasDenied;
+}
+
+static int
+k60_pas_call(uint32_t cmd, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c)
+{
+	uint64_t x0 = 0, x1 = 0;
+	int r = k60_scm_call(k60_scm_fn(K60_SCM_SVC_PIL, cmd), arginfo, a, b, c, &x0, &x1);
+
+	if (r != K60PasOk) {
+		printf("K60PAS cmd=%#x rc=%d x0=%#llx x1=%#llx\n", cmd, r,
+		    (unsigned long long)x0, (unsigned long long)x1);
+	}
+	return r;
+}
+
+int
+k60_adsp_auth_and_reset(void)
+{
+	printf("K60PAS auth_and_reset pas=%u\n", K60_PAS_ADSP);
+	return k60_pas_call(K60_SCM_PAS_AUTH_AND_RESET, k60_scm_args(1, 0, 0, 0),
+	    K60_PAS_ADSP, 0, 0);
+}
+
+int
+k60_adsp_init_image(uint64_t phys)
+{
+	return k60_pas_call(K60_SCM_PAS_INIT_IMAGE,
+	    k60_scm_args(2, K60_SCM_VAL, K60_SCM_RW, 0), K60_PAS_ADSP, phys, 0);
+}
+
+int
+k60_adsp_mem_setup(uint64_t base, uint64_t span)
+{
+	printf("K60PAS mem_setup base=%#llx span=%#llx\n",
+	    (unsigned long long)base, (unsigned long long)span);
+	return k60_pas_call(K60_SCM_PAS_MEM_SETUP, k60_scm_args(3, 0, 0, 0),
+	    K60_PAS_ADSP, base, span);
+}
+
+int
+k60_adsp_shutdown(void)
+{
+	return k60_pas_call(K60_SCM_PAS_SHUTDOWN, k60_scm_args(1, 0, 0, 0),
+	    K60_PAS_ADSP, 0, 0);
+}
+
+int
+k60_adsp_scm_tried(void)
+{
+	return k60_scm_called;
+}
+
+#endif /* !K60_HOST_TEST */
diff --git a/bsd/dev/pong_adsp_boot.c b/bsd/dev/pong_adsp_boot.c
new file mode 100644
--- /dev/null
@@ -0,0 +1,516 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* ADSP bring-up: place the image in the carveout the board reserved, prove the
+ * placement, then let the secure monitor authenticate it.
+ *
+ * The order below is the one the reference implementation uses on the same SoC:
+ *   metadata (adsp.mdt) -> INIT_IMAGE -> MEM_SETUP -> copy -> verify ->
+ *   AUTH_AND_RESET.
+ * The shipped 06xx order (AUTH first, one INIT_IMAGE per segment, MEM_SETUP
+ * last) was read command by command, never from a working caller; no boot has
+ * reached "auth ok", so that order has never been exercised on this board.
+ *
+ * Two ways in:
+ *   pong_adsp_carrier=1  the linked K60A blob (osfmk/arm64/k60_adsp_blob.s),
+ *                        admitted only when the manifest names a container whose
+ *                        sha256 verify-boot-image.py can recompute;
+ *   pong_adsp=1          the legacy ramdisk FAT path; verify-boot-image.py still
+ *                        refuses it, kept only so the older evidence stays
+ *                        reproducible.
+ */
+
+#include "pong_adsp_pas.h"
+#include "pong_adsp_image.h"
+#include "pong_fat.h"
+#include "K60AdspImageReader.h" /* device drivers/PongPower; -I added in build-xnu-4k-baseline.sh */
+#include "pong_pmic_rail.h" /* the rail gate, same directory */
+
+#ifndef K60_HOST_TEST
+
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <mach/vm_param.h>
+#include <mach/vm_statistics.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <sys/namei.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+
+/* osfmk/arm/machine_routines.h:703; declaring it here keeps the
+ * include path out of the leaky kernel header set. */
+extern vm_offset_t ml_io_map(vm_offset_t phys, vm_size_t size);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys, vm_size_t size, uint32_t flags);
+/* vm/pmap.h does not expose this one in the BSD compilation unit. */
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+/* Zero-copy view of one firmware part. Verification memcmp()s the carveout
+ * against this; a second 49 MB copy would only prove the copy to itself. */
+typedef int (*K60AdspBorrow)(const char *part, const uint8_t **data, size_t *bytes);
+
+/* The carveout is mapped cacheable (VM_WIMG_DEFAULT is 0x2 on this chip:
+ * coherent, cacheable DDR, not device memory), so the copy lands in the data
+ * cache and has to be cleaned to the point of coherency before the monitor
+ * reads DRAM with the MMU off. flush_dcache64 is the helper 0300 already uses
+ * for the same problem on this board; it takes a physical address and a 32-bit
+ * count, which is why the span is checked before the call. */
+static void
+k60_adsp_flush(uint64_t pa, size_t bytes)
+{
+	if (bytes == 0 || bytes > 0xffffffffull) {
+		printf("K60PAS flush refused bytes=%u\n", (unsigned)bytes);
+		return;
+	}
+	flush_dcache64((addr64_t)pa, (unsigned)bytes, TRUE);
+}
+
+/* PAS authenticates the metadata, not the segments: INIT_IMAGE takes the
+ * physical address of adsp.mdt (884-byte header plus the hash table), which the
+ * monitor reads with the MMU off. Hence one physically contiguous, cleaned
+ * copy, and only of that file. */
+static int
+k60_adsp_metadata(const uint8_t *mdt, size_t bytes, void **hold, uint64_t *pa)
+{
+	vm_offset_t va = 0;
+	vm_size_t need;
+	ppnum_t page;
+	kern_return_t kr;
+
+	if (mdt == NULL || bytes == 0 || bytes > 65536) {
+		return K60AdspBadArg;
+	}
+	need = round_page((vm_size_t)bytes);
+	kr = kmem_alloc_contig(kernel_map, &va, need, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf("K60PAS metadata alloc failed kr=%d bytes=%u\n", kr, (unsigned)need);
+		return K60AdspReadBounds;
+	}
+	memcpy((void *)va, mdt, bytes);
+	page = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (page == 0) {
+		printf("K60PAS metadata has no physical page\n");
+		kmem_free(kernel_map, va, need);
+		return K60AdspReadBounds;
+	}
+	*hold = (void *)va;
+	*pa = ptoa_64(page);
+	k60_adsp_flush(*pa, need);
+	return 0;
+}
+
+/* The carveout is a board fact, not an image fact: 0x9fd00000 is what the live
+ * FDT reserves (adsp_region, span 0x3100000); 0x86300000 is where the firmware
+ * was linked and where pong's SM8475 carveout sits. A loader that grows an
+ * override can publish reg-style cells under /chosen and win. */
+/* Device-tree cells are big-endian.  Two cells are a 32-bit base and span;
+ * four are a 64-bit base and a 64-bit span in the usual reg order. */
+static uint32_t
+k60_adsp_cell(const void *prop, unsigned index)
+{
+	const uint8_t *p = (const uint8_t *)prop + index * 4;
+
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	    ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static void
+k60_adsp_board_region(uint32_t *base, uint32_t *span)
+{
+	DTEntry chosen = NULL;
+	const void *prop = NULL;
+	unsigned int length = 0;
+
+	*base = K60_ADSP_BOARD_BASE;
+	*span = K60_ADSP_WINDOW;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "qcom,adsp-region", &prop, &length) != kSuccess ||
+	    prop == NULL || (length != 8 && length != 16)) {
+		return;
+	}
+	{
+		uint64_t want_base, want_span;
+
+		if (length == 8) {
+			want_base = k60_adsp_cell(prop, 0);
+			want_span = k60_adsp_cell(prop, 1);
+		} else {
+			want_base = ((uint64_t)k60_adsp_cell(prop, 0) << 32) |
+			    k60_adsp_cell(prop, 1);
+			want_span = ((uint64_t)k60_adsp_cell(prop, 2) << 32) |
+			    k60_adsp_cell(prop, 3);
+		}
+
+		if ((want_base & 0xfffull) || want_base > 0xffffffffull ||
+		    want_span < K60_ADSP_WINDOW || want_span > 0xffffffffull) {
+			printf("K60PAS ignoring region override base=%#llx span=%#llx\n",
+			    (unsigned long long)want_base, (unsigned long long)want_span);
+			return;
+		}
+		if ((uint32_t)want_base != *base || (uint32_t)want_span != *span) {
+			printf("K60PAS region from /chosen base=%#x span=%#x\n",
+			    (unsigned)want_base, (unsigned)want_span);
+		}
+		*base = (uint32_t)want_base;
+		*span = (uint32_t)want_span;
+	}
+}
+
+/* Read-back: every copied byte must equal the firmware file it came from and
+ * every bss tail must be zero. This is the only proof that the window PAS will
+ * authenticate is the image the table describes. */
+static int
+k60_adsp_verify(void *window, K60AdspBorrow borrow)
+{
+	uint32_t i;
+
+	for (i = 0; i < K60_ADSP_SEGMENTS; i++) {
+		const K60AdspSegment *s = &k60_adsp_segments[i];
+		uint8_t *at = (uint8_t *)window + (s->paddr - K60_ADSP_LINK_BASE);
+		uint32_t z;
+
+		if (s->bytes) {
+			const uint8_t *src = NULL;
+			size_t have = 0;
+
+			if (borrow(s->part, &src, &have) != 0) {
+				printf("K60PAS verify borrow %s failed\n", s->part);
+				return K60AdspPartMissing;
+			}
+			if (have != s->bytes) {
+				printf("K60PAS verify size %s have=%u want=%u\n",
+				    s->part, (unsigned)have, s->bytes);
+				return K60AdspReadBounds;
+			}
+			if (memcmp(at, src, s->bytes) != 0) {
+				printf("K60PAS verify mismatch %s at window+%#x\n",
+				    s->part, (unsigned)(s->paddr - K60_ADSP_LINK_BASE));
+				return K60AdspMismatch;
+			}
+		}
+		for (z = 0; z < s->bss; z++) {
+			if (at[s->bytes + z] != 0) {
+				printf("K60PAS verify bss not zero %s+%u\n",
+				    s->part ? s->part : "adsp.b24", (unsigned)z);
+				return K60AdspMismatch;
+			}
+		}
+	}
+	return 0;
+}
+
+/* The whole bring-up, in the order the reference implementation proved:
+ * metadata, INIT_IMAGE, MEM_SETUP, copy, verify, AUTH_AND_RESET. Stops at
+ * "auth ok": starting the DSP is a separate decision with its own evidence. */
+int
+k60_adsp_bring_up(const uint8_t *mdt, size_t mdt_bytes, K60AdspBorrow borrow,
+    K60AdspRead read, uint32_t board_base, uint32_t span)
+{
+	K60AdspPlan plan;
+	void *hold = NULL;
+	uint64_t meta_pa = 0;
+	vm_offset_t window;
+	int rc;
+
+	rc = k60_adsp_plan_at(&plan, board_base);
+	if (rc != 0) {
+		printf("K60PAS plan rc=%d base=%#x\n", rc, board_base);
+		return rc;
+	}
+	printf("K60PAS plan rows=%u copied=%u zeroed=%u link=%#x base=%#x window=%#x\n",
+	    plan.segments, plan.copied, plan.zeroed,
+	    (unsigned)K60_ADSP_LINK_BASE, plan.base, plan.window);
+	if (span != plan.window) {
+		printf("K60PAS span %#x does not match the table window %#x\n",
+		    span, plan.window);
+		return K60AdspBadArg;
+	}
+
+	window = ml_io_map_unmappable((vm_offset_t)board_base, (vm_size_t)span,
+	    0x2 /* VM_WIMG_DEFAULT: DDR, not device memory */);
+	if (window == 0) {
+		printf("K60PAS cannot map the carveout %#x span %#x\n", board_base, span);
+		return K60AdspBadArg;
+	}
+
+	rc = k60_adsp_metadata(mdt, mdt_bytes, &hold, &meta_pa);
+	if (rc != 0) {
+		return rc;
+	}
+	printf("K60PAS metadata phys=%#llx bytes=%u\n",
+	    (unsigned long long)meta_pa, (unsigned)mdt_bytes);
+
+	rc = k60_adsp_init_image(meta_pa);
+	if (rc != K60PasOk) {
+		printf("K60PAS init refused rc=%d\n", rc);
+		goto out;
+	}
+	printf("K60PAS init ok\n");
+
+	rc = k60_adsp_mem_setup((uint64_t)board_base, (uint64_t)span);
+	if (rc != K60PasOk) {
+		printf("K60PAS mem_setup refused rc=%d\n", rc);
+		goto out;
+	}
+	printf("K60PAS mem_setup ok\n");
+
+	rc = k60_adsp_copy((void *)window, (size_t)span, read);
+	if (rc != 0) {
+		printf("K60PAS copy rc=%d\n", rc);
+		goto out;
+	}
+	printf("K60PAS copy ok\n");
+
+	rc = k60_adsp_verify((void *)window, borrow);
+	if (rc != 0) {
+		goto out;
+	}
+	printf("K60PAS verify ok segments=%u copied=%u zeroed=%u\n",
+	    plan.segments, plan.copied, plan.zeroed);
+
+	/* The monitor reads the window with the MMU off: clean the copy out of the
+	 * cache first. Physically addressed, because the monitor is not. */
+	k60_adsp_flush((uint64_t)board_base, (size_t)span);
+
+	rc = k60_adsp_auth_and_reset();
+	if (rc != K60PasOk) {
+		printf("K60PAS auth refused rc=%d\n", rc);
+		goto out;
+	}
+	printf("K60PAS auth ok\n");
+	rc = K60PasOk;
+
+out:
+	if (hold != NULL) {
+		kmem_free(kernel_map, (vm_offset_t)hold, round_page(mdt_bytes));
+	}
+	return rc;
+}
+
+/* Linked carrier: the only admitted path. The blob is compiled into the kernel
+ * image, so there is no firmware I/O and no FAT here. */
+static K60AdspReader k60_carrier_reader;
+
+static int
+k60_carrier_borrow(const char *part, const uint8_t **data, size_t *bytes)
+{
+	return k60_adsp_reader_borrow(&k60_carrier_reader, part, data, bytes);
+}
+
+int
+k60_adsp_carrier_probe(void)
+{
+	const uint8_t *mdt = NULL;
+	size_t mdt_bytes = 0;
+	uint32_t base = 0, span = 0;
+	int enabled = 0;
+	int rc;
+
+	if (!PE_parse_boot_argn("pong_adsp_carrier", &enabled, sizeof(enabled)) ||
+	    enabled == 0) {
+		return 0;
+	}
+	printf("K60PAS carrier begin\n");
+	rc = k60_adsp_reader_linked(&k60_carrier_reader);
+	if (rc != 0) {
+		printf("K60PAS carrier absent rc=%d\n", rc);
+		return rc;
+	}
+	rc = k60_adsp_reader_borrow(&k60_carrier_reader, "adsp.mdt", &mdt, &mdt_bytes);
+	if (rc != 0) {
+		printf("K60PAS carrier metadata rc=%d\n", rc);
+		return rc;
+	}
+	k60_adsp_board_region(&base, &span);
+	printf("K60PAS carrier region base=%#x span=%#x\n", base, span);
+
+	rc = k60_adsp_bring_up(mdt, mdt_bytes, k60_carrier_borrow, k60_adsp_read,
+	    base, span);
+	if (rc == K60PasOk) {
+		printf("K60PAS carrier verdict PASS auth=ok base=%#x span=%#x\n",
+		    base, span);
+	} else {
+		printf("K60PAS carrier verdict FAIL rc=%d base=%#x span=%#x\n",
+		    rc, base, span);
+	}
+	return rc;
+}
+
+/* Legacy ramdisk FAT path. Kept for the older evidence, still refused by
+ * verify-boot-image.py; the carrier above is what ships. */
+/* This XNU has no msdos filesystem and 0404's mount never ran, so the old
+ * /private/var/pong/md0 path could never resolve. md0 is a contiguous block
+ * device whose base and size the firmware already wrote into the
+ * [pv]md0=<base>@<size> token that bsd/dev/memdev.c consumes, so we parse the
+ * same token and walk the FAT volume ourselves. */
+static K60FatVolume k60_fat_vol;
+static const void *k60_fat_base;
+static int k60_fat_ready;
+static size_t k60_fat_bytes;
+
+/* PE_boot_args() returns the kernel-embedded default string, not what the
+ * firmware hands over, so the md token is not visible here (measured: the
+ * printed string has no pong_adsp either, yet PE_parse_boot_argn finds it).
+ * The loader writes the ramdisk span into /chosen instead. */
+static int
+k60_dt_cell(const void *prop, uint32_t length, uint64_t *out)
+{
+	if (prop == NULL || out == NULL) {
+		return -1;
+	}
+	if (length == 8) {
+		const uint32_t *w = (const uint32_t *)prop;
+
+		*out = ((uint64_t)w[0] << 32) | (uint64_t)w[1];
+		return 0;
+	}
+	if (length == 4) {
+		*out = (uint64_t)*(const uint32_t *)prop;
+		return 0;
+	}
+	return -1;
+}
+
+/* memdev.c calls this the moment it registers md0: the only place where the
+ * ramdisk geometry is still live (P-175). */
+static uint64_t k60_md_base;
+static uint64_t k60_md_size;
+
+void
+k60_adsp_note_window(uint64_t base, uint64_t size)
+{
+	k60_md_base = base;
+	k60_md_size = size;
+	printf("K60PAS md0 window noted %#llx..%#llx\n",
+	    (unsigned long long)base, (unsigned long long)(base + size));
+}
+
+static int
+k60_adsp_md_window(uint64_t *base, uint64_t *size)
+{
+	if (k60_md_size != 0) {
+		/* mdevadd() takes PAGE NUMBERS, and for a vmd entry it keeps the value
+		 * the loader wrote verbatim: 0xfffffff0083b5, i.e. the kernel VA page
+		 * of the physical 0x83b5 page (memdev prints it as base << 12 =
+		 * FFFFFFF0083B5000). Undo the VA offset in PAGE units -- subtracting
+		 * the byte constant from a page number underflows, which is exactly how
+		 * the previous attempt produced phys 0x10000fff0083b5 and faulted at
+		 * far 0xfffffff8dd67b5b3. */
+		const uint64_t va_pages = 0xfffffff000000000ULL >> 12;
+
+		*base = (k60_md_base - va_pages) << 12;
+		*size = k60_md_size << 12;
+		return 0;
+	}
+	printf("K60PAS md0 was never registered\n");
+	return -1;
+}
+
+static int
+k60_adsp_ramdisk_borrow(const char *part, const uint8_t **data, size_t *bytes)
+{
+	uint32_t offset = 0, length = 0;
+
+	if (!k60_fat_ready) {
+		printf("K60PAS fat volume not opened\n");
+		return -1;
+	}
+	if (k60_fat_find(k60_fat_base, &k60_fat_vol, "ADSP", part, &offset,
+	    &length) != 0) {
+		printf("K60PAS fat find %s failed\n", part);
+		return -1;
+	}
+	*data = (const uint8_t *)k60_fat_base + offset;
+	*bytes = (size_t)length;
+	return 0;
+}
+
+static int
+k60_adsp_ramdisk_reader(const char *part, void *dst, uint32_t bytes)
+{
+	const uint8_t *src = NULL;
+	size_t have = 0;
+
+	if (k60_adsp_ramdisk_borrow(part, &src, &have) != 0) {
+		return -1;
+	}
+	if (have != bytes) {
+		printf("K60PAS fat size %s have=%u want=%u\n", part, (unsigned)have, bytes);
+		return -1;
+	}
+	memcpy(dst, src, (size_t)bytes);
+	return 0;
+}
+
+int
+k60_adsp_probe_from_handoff(void)
+{
+	uint64_t base = 0, size = 0;
+	const uint8_t *mdt = NULL;
+	size_t mdt_bytes = 0;
+	uint32_t region = 0, span = 0;
+	int enabled = 0;
+
+	if (!PE_parse_boot_argn("pong_adsp", &enabled, sizeof(enabled)) || enabled == 0) {
+		return 0;
+	}
+	printf("K60PAS probe begin\n");
+	if (k60_adsp_md_window(&base, &size) != 0) {
+		return -1;
+	}
+	/* memdev records md0 as a KERNEL VA (the firmware passes vmd0=... that
+	 * way), and that VA range is not mapped, so reading it faults at level 0
+	 * (esr 0x96000004). Map the physical window instead. */
+	{
+		/* ml_io_map() allocates from io_submap, which is 8 MiB kernel-wide
+		 * (osfmk/arm/io_map.c:65); a 32 MiB request panics with
+		 * kmem_alloc(...33554432...) failed 3. The unmappable variant
+		 * allocates from kernel_map instead (io_map.c:128). */
+		vm_offset_t ram = ml_io_map_unmappable((vm_offset_t)base,
+		    (vm_size_t)size, 0x2 /* VM_WIMG_DEFAULT: both windows are DDR, not device memory */);
+
+		if (ram == 0) {
+			printf("K60PAS cannot map the ramdisk phys %#llx\n",
+			    (unsigned long long)base);
+			return -1;
+		}
+		k60_fat_base = (const void *)(uintptr_t)ram;
+		printf("K60PAS ramdisk phys %#llx mapped at %#llx size %#llx\n",
+		    (unsigned long long)base, (unsigned long long)ram,
+		    (unsigned long long)size);
+	}
+	if (k60_fat_open(k60_fat_base, (size_t)size, &k60_fat_vol) != 0) {
+		printf("K60PAS fat open failed; not a readable volume\n");
+		return -1;
+	}
+	k60_fat_ready = 1;
+	k60_fat_bytes = (size_t)size;
+	printf("K60PAS fat open ok bps=%u spc=%u root=%u clusters=%u\n",
+	    k60_fat_vol.bytes_per_sector, k60_fat_vol.sectors_per_cluster,
+	    k60_fat_vol.root_cluster, k60_fat_vol.clusters);
+
+	if (k60_adsp_ramdisk_borrow("adsp.mdt", &mdt, &mdt_bytes) != 0) {
+		return -1;
+	}
+	k60_adsp_board_region(&region, &span);
+	return k60_adsp_bring_up(mdt, mdt_bytes, k60_adsp_ramdisk_borrow,
+	    k60_adsp_ramdisk_reader, region, span);
+}
+
+/* Blob-less fallback binding for the owner image reader: the linked carrier is
+ * authoritative; only when it is absent does the owner adapter call here and
+ * reuse the already-mapped ramdisk FAT window (the bt
+ * k60_bt_addon_load_blob() fallback shape). A present-but-malformed carrier
+ * never reaches this hook. */
+int
+k60_adsp_legacy_reader(K60AdspReader *r)
+{
+	if (!k60_fat_ready || k60_fat_base == NULL || k60_fat_bytes == 0) {
+		return K60AdspReaderMissing;
+	}
+	return k60_adsp_reader_fat(r, k60_fat_base, k60_fat_bytes);
+}
+
+#endif /* !K60_HOST_TEST */
diff --git a/bsd/dev/pong_fat.h b/bsd/dev/pong_fat.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_fat.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Read-only FAT32 lookup for the payload memory disk. XNU has no msdos
+ * filesystem, so the ADSP segments are reached by walking the volume the same
+ * way an installer would: BPB, FAT chain, 8.3 directory entries. */
+
+#ifndef K60_FAT_H
+#define K60_FAT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+	K60FatBadArg = -1,
+	K60FatNoBpb = -2,
+	K60FatNoEntry = -3,
+	K60FatBadChain = -4,
+};
+
+typedef struct {
+	uint32_t bytes_per_sector;
+	uint32_t sectors_per_cluster;
+	uint32_t reserved_sectors;
+	uint32_t fats;
+	uint32_t fat_sectors;
+	uint32_t root_cluster;
+	uint32_t total_sectors;
+	uint32_t data_start;      /* sector offset of cluster 2 */
+	uint32_t cluster_bytes;
+	uint32_t clusters;
+} K60FatVolume;
+
+/* Parses the BPB. `size` is the usable byte count of the image. */
+int k60_fat_open(const void *base, size_t size, K60FatVolume *vol);
+
+/* Finds `dir` (may be "" for the root) then `name`, 8.3 or long, into
+ * (offset, length) relative to `base`. Both are compared case-insensitively
+ * with the dot dropped, so "adsp.b01" matches the entry "ADSP    B01". */
+int k60_fat_find(const void *base, const K60FatVolume *vol,
+    const char *dir, const char *name, uint32_t *offset, uint32_t *length);
+
+/* Reads the "<key>=<base>.<size>" form memdev.c accepts (it writes '.'), so the same boot
+ * argument that creates md0 also tells us where its bytes live. Numbers may be
+ * decimal or 0x-prefixed hex. Returns 0 on success. */
+int k60_md_parse(const char *args, size_t args_len, const char *key,
+    uint64_t *base, uint64_t *size);
+
+#endif /* K60_FAT_H */
diff --git a/bsd/dev/pong_fat.c b/bsd/dev/pong_fat.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_fat.c
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+
+#include <string.h>
+
+#include "pong_fat.h"
+
+static uint32_t
+le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return le16(p) | (le16(p + 2) << 16);
+}
+
+static uint32_t
+fat_entry(const void *base, const K60FatVolume *vol, uint32_t cluster)
+{
+	const uint8_t *p = (const uint8_t *)base;
+	uint32_t fat_off = vol->reserved_sectors * vol->bytes_per_sector;
+
+	return le32(p + fat_off + cluster * 4u) & 0x0fffffffu;
+}
+
+static int
+name_matches(const uint8_t *entry, const char *want)
+{
+	char flat[13];
+	char needle[13];
+	int n = 0;
+	int m = 0;
+
+	for (int i = 0; i < 8; i++) {
+		char c = (char)entry[i];
+
+		if (c != ' ') {
+			flat[n++] = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c;
+		}
+	}
+	if (entry[8] != ' ') {
+		for (int i = 8; i < 11; i++) {
+			char c = (char)entry[i];
+
+			if (c != ' ') {
+				flat[n++] = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c;
+			}
+		}
+	}
+	flat[n] = '\0';
+
+	/* the dot is a display convention, never a stored byte */
+	for (int i = 0; want[i] != '\0' && m < 12; i++) {
+		char c = want[i];
+
+		if (c == '.') {
+			continue;
+		}
+		needle[m++] = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c;
+	}
+	needle[m] = '\0';
+
+	if (n != m) {
+		return 0;
+	}
+	for (int i = 0; i < n; i++) {
+		if (flat[i] != needle[i]) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* Walks the directory whose first cluster is `start`, returning the entry. */
+static int
+walk_dir(const void *base, const K60FatVolume *vol, uint32_t start,
+    const char *name, uint32_t *first_cluster, uint32_t *length, int *is_dir)
+{
+	const uint8_t *p = (const uint8_t *)base;
+	uint32_t cluster = start;
+	uint32_t guard = 0;
+
+	while (cluster >= 2 && cluster < vol->clusters + 2) {
+		uint32_t base_off = (vol->data_start +
+		    (cluster - 2) * vol->sectors_per_cluster) * vol->bytes_per_sector;
+
+		for (uint32_t off = 0; off + 32 <= vol->cluster_bytes; off += 32) {
+			const uint8_t *e = p + base_off + off;
+
+			if (e[0] == 0x00) {
+				return K60FatNoEntry;
+			}
+			/* deleted, long-name fragment, or volume label */
+			if (e[0] == 0xe5 || (e[11] & 0x0f) == 0x0f || (e[11] & 0x08)) {
+				continue;
+			}
+			if (name_matches(e, name)) {
+				*first_cluster = (le16(e + 20) << 16) | le16(e + 26);
+				*length = le32(e + 28);
+				*is_dir = (e[11] & 0x10) != 0;
+				return 0;
+			}
+		}
+		cluster = fat_entry(base, vol, cluster);
+		if (++guard > 65536u) {
+			return K60FatBadChain;
+		}
+	}
+	return K60FatNoEntry;
+}
+
+int
+k60_fat_open(const void *base, size_t size, K60FatVolume *vol)
+{
+	const uint8_t *p = (const uint8_t *)base;
+
+	if (base == NULL || vol == NULL || size < 1024) {
+		return K60FatBadArg;
+	}
+	if (p[510] != 0x55 || p[511] != 0xaa) {
+		return K60FatNoBpb;
+	}
+	vol->bytes_per_sector = le16(p + 11);
+	vol->sectors_per_cluster = p[13];
+	vol->reserved_sectors = le16(p + 14);
+	vol->fats = p[16];
+	vol->fat_sectors = le32(p + 36);
+	vol->root_cluster = le32(p + 44);
+	vol->total_sectors = le32(p + 32);
+	if (!vol->bytes_per_sector || !vol->sectors_per_cluster || !vol->fats ||
+	    !vol->fat_sectors) {
+		return K60FatNoBpb;
+	}
+	vol->cluster_bytes = vol->bytes_per_sector * vol->sectors_per_cluster;
+	vol->data_start = vol->reserved_sectors + vol->fats * vol->fat_sectors;
+	vol->clusters = (vol->total_sectors - vol->data_start) /
+	    vol->sectors_per_cluster;
+	if (vol->clusters == 0) {
+		return K60FatNoBpb;
+	}
+	return 0;
+}
+
+int
+k60_fat_find(const void *base, const K60FatVolume *vol,
+    const char *dir, const char *name, uint32_t *offset, uint32_t *length)
+{
+	uint32_t cluster = vol->root_cluster;
+	uint32_t len = 0;
+	int is_dir = 0;
+	int rc;
+
+	if (dir != NULL && dir[0] != '\0') {
+		rc = walk_dir(base, vol, cluster, dir, &cluster, &len, &is_dir);
+		if (rc != 0) {
+			return rc;
+		}
+		if (!is_dir) {
+			return K60FatNoEntry;
+		}
+	}
+	rc = walk_dir(base, vol, cluster, name, &cluster, &len, &is_dir);
+	if (rc != 0) {
+		return rc;
+	}
+	if (is_dir) {
+		return K60FatNoEntry;
+	}
+	*length = len;
+	*offset = (vol->data_start + (cluster - 2) * vol->sectors_per_cluster) *
+	    vol->bytes_per_sector;
+	return 0;
+}
+
+static int
+parse_number(const char **pp, const char *end, uint64_t *out)
+{
+	const char *p = *pp;
+	uint64_t v = 0;
+	int digits = 0;
+
+	if (p + 1 < end && p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+		p += 2;
+		while (p < end) {
+			unsigned d;
+			if (*p >= '0' && *p <= '9') {
+				d = (unsigned)(*p - '0');
+			} else if (*p >= 'a' && *p <= 'f') {
+				d = (unsigned)(*p - 'a') + 10u;
+			} else if (*p >= 'A' && *p <= 'F') {
+				d = (unsigned)(*p - 'A') + 10u;
+			} else {
+				break;
+			}
+			v = (v << 4) | d;
+			digits++;
+			p++;
+		}
+	} else {
+		while (p < end && *p >= '0' && *p <= '9') {
+			v = v * 10u + (uint64_t)(*p - '0');
+			digits++;
+			p++;
+		}
+	}
+	if (digits == 0) {
+		return K60FatNoEntry;
+	}
+	*out = v;
+	*pp = p;
+	return 0;
+}
+
+int
+k60_md_parse(const char *args, size_t args_len, const char *key,
+    uint64_t *base, uint64_t *size)
+{
+	const char *p = args;
+	const char *end = args + args_len;
+	size_t key_len;
+
+	if (args == NULL || key == NULL || base == NULL || size == NULL) {
+		return K60FatBadArg;
+	}
+	key_len = 0;
+	while (key[key_len] != '\0') {
+		key_len++;
+	}
+
+	while (p < end) {
+		const char *tok = p;
+		const char *tok_end;
+
+		while (p < end && *p != ' ') {
+			p++;
+		}
+		tok_end = p;
+		while (p < end && *p == ' ') {
+			p++;
+		}
+
+		if ((size_t)(tok_end - tok) <= key_len + 1) {
+			continue;
+		}
+		if (strncmp(tok, key, key_len) != 0 || tok[key_len] != '=') {
+			continue;
+		}
+		tok += key_len + 1;
+		if (parse_number(&tok, tok_end, base) != 0) {
+			continue;
+		}
+		/* memdev.c spells the separator '.', not '@': accepting both keeps
+		 * the parser usable for a hand-written argument too. */
+		if (tok >= tok_end || (*tok != '.' && *tok != '@')) {
+			continue;
+		}
+		tok++;
+		if (parse_number(&tok, tok_end, size) != 0) {
+			continue;
+		}
+		if (tok != tok_end) {
+			continue;
+		}
+		return 0;
+	}
+	return K60FatNoEntry;
+}
diff --git a/bsd/dev/pong_pmic_rail.h b/bsd/dev/pong_pmic_rail.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_pmic_rail.h
@@ -0,0 +1,120 @@
+/*
+ * Read the applications RSC's command database and say what the pm8350c_l2
+ * rail's RPMh address and level table look like, before anyone votes.
+ *
+ * Every constant here has a source that can be re-read:
+ *   - cmd-db at 0x80860000, 0x20000 bytes  -> /reserved-memory/aop_cmd_db_region@80860000
+ *     in Platforms/Xiaomi/mondrianPkg/FdtBlob/sm8475-xiaomi-mondrian.dtb
+ *   - cmd-db layout (magic 0x0c0330db, 8 slave records, 24-byte entries)
+ *     -> UniXNU-sheng/package/QcomRpmh.c qcom_cmd_db_find(), which the
+ *     sheng host test pins with a synthetic database.
+ *   - apps RSC at 0x17a00000..0x17a30000, tcs-offset 0xd00, drv-id 2
+ *     -> /soc/rsc@17a00000 in the same device tree, plus the same reference's
+ *     qcom_rsc_layout()/qcom_rpmh_active_request().
+ *   - pm8350c_l2 resource name "ldoc2" -> /soc/rsc@17a00000/rpmh-regulator-ldoc2
+ *     (qcom,resource-name = "ldoc2"; regulator-min-microvolt 1800000).
+ * The pass is single-shot per boot: k60_rail_inherit() (first step of
+ * k60_adsp_bring_up(), which only runs after Data mount) measures when no pass
+ * has run yet, and k60_rail_probe() only prints a ledger that already exists.
+ * No path writes a register and no path polls.
+ */
+#ifndef K60_PMIC_RAIL_H
+#define K60_PMIC_RAIL_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define K60_CMD_DB_PHYS     0x80860000ULL
+#define K60_CMD_DB_BYTES    0x20000u
+#define K60_RSC_DRV2_PHYS   0x17a20000ULL
+#define K60_RSC_BYTES       0x10000u
+#define K60_RSC_TCS_OFFSET  0xd00u
+#define K60_CMD_DB_MAGIC    0x0c0330dbu
+#define K60_RPMH_MAX_LEVELS 16u
+#define K60_RAIL_LDOC2      0x1c6u   /* rpmh-regulator-ldoc2 consumer tag */
+/* DRV-2 TCS slots the inheritance scan looks at: 0xd00 + n * tcs_stride. The
+ * slot number is never assumed, it is whichever slot carries the rail's
+ * cmd-db address (docs/research/audio/ADSP-RAIL-INHERITANCE.md). */
+#define K60_RAIL_SLOTS      5u
+#define K60_RAIL_LEDGER_MAGIC 0x524c3630u /* 'RL60' */
+#define K60_RAIL_GATE_PROBE 1u      /* recorded by k60_rail_probe() */
+
+typedef struct {
+	uint32_t address;
+	uint16_t levels[K60_RPMH_MAX_LEVELS];
+	unsigned level_count;
+} K60RpmhResource;
+
+typedef struct {
+	uint32_t tcs_stride, cmd_stride, irq_status, irq_clear, wait_for_cmpl;
+	uint32_t control, status, cmd_enable, cmd_msgid, cmd_addr, cmd_data;
+} K60RscLayout;
+
+/* One rail's inheritance evidence. The four-tuple is all-or-nothing: if any
+ * field could not be measured, `complete` stays 0 and `missing` names the field
+ * that stopped the read, so a partial measurement can never be read as an
+ * inherited rail later. `valid` then says whether the complete measurement is
+ * self-consistent: a matched slot can still hold a retired command, so a zero
+ * ARC level or a busy slot is measured-but-invalid, not missing. */
+typedef struct {
+	uint32_t resource_id;   /* cmd-db address of the rail, 0 when not found */
+	uint32_t address;       /* cmd_addr read back from the matched slot */
+	uint32_t level;         /* cmd_data read back: ARC level index, not mV */
+	unsigned tcs_slot;      /* DRV-2 TCS slot whose cmd_addr matched */
+	unsigned complete;      /* all four fields measured */
+	unsigned valid;         /* complete, nonzero level, slot idle */
+	const char *missing;    /* static name of the field that stopped the read */
+	const char *why;        /* static reason a complete record is invalid */
+} K60RailRecord;
+
+/* What the gated read-only pass leaves for a consumer that runs later: who
+ * measured it, what state the RSC was in, and whether each rail completed.
+ * A consumer that finds no ledger must say "never measured"; one that finds an
+ * incomplete rail must name the field. Those are different failures. */
+typedef struct {
+	uint32_t magic;
+	uint32_t drv_id;        /* DRV-2 id word seen when the pass ran */
+	unsigned recorded;      /* 1 once a pass stored this ledger */
+	unsigned gate;          /* K60_RAIL_GATE_PROBE */
+	K60RailRecord lcx;
+	K60RailRecord lmx;
+} K60RailLedger;
+
+/* Three-state verdict over a ledger. Pure, so the host test can exercise every
+ * branch without hardware. resources() must not call this: it runs before the
+ * registers may be read, so its only honest answer is a declaration. */
+enum {
+	K60RailVerdictInherited = 0,
+	K60RailVerdictNotRecorded = 1,
+	K60RailVerdictIncomplete = 2,
+	K60RailVerdictInvalid = 3,
+};
+
+/* Same value as K60BoardUnsupported: the PAS layer only sees an int. */
+#define K60_RAIL_REFUSED (-63)
+
+enum {
+	K60RpmhOk = 0,
+	K60RpmhNoDb = -1,
+	K60RpmhMissing = -2,
+	K60RpmhCorrupt = -3,
+	K60RpmhNoLevel = -4,
+	K60RpmhArgument = -5,
+};
+
+int k60_cmd_db_find(const uint8_t *db, size_t bytes, const char *name,
+    K60RpmhResource *out);
+int k60_rpmh_level_index(const K60RpmhResource *r, uint32_t level,
+    uint32_t *index);
+K60RscLayout k60_rsc_layout(uint32_t drv_id);
+int k60_rail_measure(const volatile uint32_t *words, size_t words_bytes,
+    const K60RscLayout *layout, uint32_t resource_id, K60RailRecord *out);
+void k60_rail_ledger_store(uint32_t drv_id, const K60RailRecord *lcx,
+    const K60RailRecord *lmx);
+const K60RailLedger *k60_rail_ledger(void);
+int k60_rail_verdict(const K60RailLedger *ledger, const char **rail,
+    const char **field);
+int k60_rail_inherit(void);
+int k60_rail_probe(void);
+
+#endif /* K60_PMIC_RAIL_H */
diff --git a/bsd/dev/pong_pmic_rail.c b/bsd/dev/pong_pmic_rail.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_pmic_rail.c
@@ -0,0 +1,540 @@
+/*
+ * The pm8350c_l2 rail lives behind the applications RSC: the AP has no SPMI
+ * channel for PPID 0x241 (the kernel's SPMI probe answered apid=-1), so a
+ * voltage vote can only go through RPMh. This file only reads: it parses the
+ * command database and reports the resource's RPMh address and level table so
+ * that the vote (if any) is written against measured numbers.
+ *
+ * The layout follows UniXNU-sheng/package/QcomRpmh.{c,h}; that reference is
+ * the only working RPMh implementation in the tree and its parser is pinned by
+ * a host test with a synthetic database.
+ */
+#include "pong_pmic_rail.h"
+
+#ifdef KERNEL
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+/* printf() lives here, not in pexpert.h: without it the kernel build stops at
+ * "call to undeclared function 'printf'" (the host test never sees this file's
+ * KERNEL branch, so only a real build catches it). */
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys, vm_size_t size,
+    unsigned int flags);
+#endif /* KERNEL */
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (uint16_t)p[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;
+}
+
+static int
+fits(size_t at, size_t length, size_t size)
+{
+	return at <= size && length <= size - at;
+}
+
+/*
+ * Header: u32 version, u32 magic, eight 16-byte slave records
+ * (u16 id, header offset, data offset, entry count, version, reserved[3]),
+ * u32 checksum, u32 reserved, then the region the offsets count from.
+ * Entries are 24 bytes: an 8-byte id, two u32 priorities, u32 address,
+ * u16 aux length, u16 aux offset.
+ */
+int
+k60_cmd_db_find(const uint8_t *db, size_t bytes, const char *name,
+    K60RpmhResource *out)
+{
+	char id[8] = { 0 };
+	size_t n;
+
+	if (db == NULL || name == NULL || out == NULL) {
+		return K60RpmhArgument;
+	}
+	if (bytes < 144 || le32(db + 4) != K60_CMD_DB_MAGIC) {
+		return K60RpmhNoDb;
+	}
+	for (n = 0; n < sizeof(id) && name[n] != '\0'; n++) {
+		id[n] = name[n];
+	}
+	for (unsigned s = 0; s < 8; s++) {
+		const uint8_t *slave = db + 8 + 16 * s;
+		size_t heads, data, count;
+
+		if (le16(slave) == 0) {
+			break;
+		}
+		heads = 144u + le16(slave + 2);
+		data = 144u + le16(slave + 4);
+		count = le16(slave + 6);
+		if (!fits(heads, count * 24, bytes)) {
+			return K60RpmhCorrupt;
+		}
+		for (size_t e = 0; e < count; e++) {
+			const uint8_t *entry = db + heads + 24 * e;
+			int same = 1;
+
+			for (unsigned i = 0; i < sizeof(id) && same; i++) {
+				same = entry[i] == (uint8_t)id[i];
+			}
+			if (!same) {
+				continue;
+			}
+			{
+				K60RpmhResource r;
+				size_t length, at;
+
+				r.address = le32(entry + 16);
+				r.level_count = 0;
+				length = le16(entry + 20);
+				at = data + le16(entry + 22);
+				if (r.address == 0 || !fits(at, length, bytes)) {
+					return K60RpmhCorrupt;
+				}
+				for (size_t l = 0;
+				    l + 1 < length && r.level_count < K60_RPMH_MAX_LEVELS;
+				    l += 2) {
+					uint16_t level = le16(db + at + l);
+
+					if (r.level_count != 0 && level == 0) {
+						break;  /* zero padded */
+					}
+					r.levels[r.level_count++] = level;
+				}
+				*out = r;
+				return K60RpmhOk;
+			}
+		}
+	}
+	return K60RpmhMissing;
+}
+
+int
+k60_rpmh_level_index(const K60RpmhResource *r, uint32_t level, uint32_t *index)
+{
+	if (r == NULL || index == NULL || r->level_count == 0) {
+		return K60RpmhNoLevel;
+	}
+	if (level == 0) {
+		*index = 0;
+		return K60RpmhOk;
+	}
+	for (unsigned i = 0; i < r->level_count; i++) {
+		if (r->levels[i] >= level) {
+			*index = i;
+			return K60RpmhOk;
+		}
+	}
+	/* Reporting the highest corner as a success would let a caller vote a
+	 * voltage it never asked for while believing the request was honoured.
+	 * If the table cannot express the level, say so. */
+	*index = r->level_count - 1;
+	return K60RpmhNoLevel;
+}
+
+K60RscLayout
+k60_rsc_layout(uint32_t drv_id)
+{
+	K60RscLayout v3 = { 672, 24, 0x04, 0x08, 0x20, 0x24, 0x28, 0x2c, 0x34,
+			    0x38, 0x3c };
+	K60RscLayout v2 = { 672, 20, 0x04, 0x08, 0x10, 0x14, 0x18, 0x1c, 0x30,
+			    0x34, 0x38 };
+
+	return ((drv_id >> 16) & 0xff) >= 3 ? v3 : v2;
+}
+
+/* Clear a record so that a failed measurement still names what was missing. */
+static void
+rail_record_clear(K60RailRecord *r, const char *not_read)
+{
+	r->resource_id = 0;
+	r->address = 0;
+	r->level = 0;
+	r->tcs_slot = 0;
+	r->complete = 0;
+	r->valid = 0;
+	r->missing = not_read;
+	r->why = 0;
+}
+
+/*
+ * Scan the DRV-2 TCS slots for the one whose cmd_addr carries this rail's
+ * cmd-db address, then read that slot's cmd_data. Read-only: every access is a
+ * load from the already-mapped window. The slot number is discovered, never
+ * assumed, because this board votes touch through TCS3 while the reference
+ * implementation writes slot 4 (POWER-RPMH-LDOC2.md:30-33, :142-144).
+ */
+int
+k60_rail_measure(const volatile uint32_t *words, size_t words_bytes,
+    const K60RscLayout *layout, uint32_t resource_id, K60RailRecord *out)
+{
+	unsigned slot;
+
+	if (out == NULL || layout == NULL || words == NULL) {
+		return K60RpmhArgument;
+	}
+	rail_record_clear(out, "resource id");
+	if (resource_id == 0) {
+		return K60RpmhMissing;
+	}
+	out->resource_id = resource_id;
+	out->missing = "tcs slot";
+	for (slot = 0; slot < K60_RAIL_SLOTS; slot++) {
+		const size_t base = (size_t)K60_RSC_TCS_OFFSET +
+		    (size_t)slot * layout->tcs_stride;
+		size_t at_addr, at_data, at_status;
+		uint32_t addr;
+
+		if (base + layout->cmd_data + sizeof(uint32_t) > words_bytes ||
+		    base + layout->status + sizeof(uint32_t) > words_bytes) {
+			break;
+		}
+		at_addr = base + layout->cmd_addr;
+		at_data = base + layout->cmd_data;
+		at_status = base + layout->status;
+		addr = words[at_addr / sizeof(uint32_t)];
+		if (addr != resource_id) {
+			continue;
+		}
+		out->tcs_slot = slot;
+		out->address = addr;
+		out->level = words[at_data / sizeof(uint32_t)];
+		out->complete = 1;
+		out->missing = 0;
+		if (out->level == 0) {
+			out->why = "level read back as 0";
+		} else if ((words[at_status / sizeof(uint32_t)] & 1u) == 0) {
+			out->why = "tcs slot not idle";
+		} else {
+			out->valid = 1;
+		}
+		return K60RpmhOk;
+	}
+	return K60RpmhMissing;
+}
+
+static K60RailLedger rail_ledger;
+
+void
+k60_rail_ledger_store(uint32_t drv_id, const K60RailRecord *lcx,
+    const K60RailRecord *lmx)
+{
+	K60RailLedger next;
+
+	next.magic = K60_RAIL_LEDGER_MAGIC;
+	next.drv_id = drv_id;
+	next.recorded = 1;
+	next.gate = K60_RAIL_GATE_PROBE;
+	if (lcx != NULL) {
+		next.lcx = *lcx;
+	} else {
+		rail_record_clear(&next.lcx, "not read");
+	}
+	if (lmx != NULL) {
+		next.lmx = *lmx;
+	} else {
+		rail_record_clear(&next.lmx, "not read");
+	}
+	rail_ledger = next;
+}
+
+const K60RailLedger *
+k60_rail_ledger(void)
+{
+	return rail_ledger.recorded ? &rail_ledger : 0;
+}
+
+/*
+ * The three answers a consumer must be able to tell apart. "Not recorded" is
+ * not "the rail is absent"; "incomplete" is not "invalid"; and only the last
+ * one says something about the rail itself rather than about the read.
+ */
+int
+k60_rail_verdict(const K60RailLedger *ledger, const char **rail,
+    const char **field)
+{
+	const K60RailRecord *r;
+
+	if (rail != 0) {
+		*rail = 0;
+	}
+	if (field != 0) {
+		*field = 0;
+	}
+	if (ledger == 0 || ledger->magic != K60_RAIL_LEDGER_MAGIC ||
+	    !ledger->recorded) {
+		return K60RailVerdictNotRecorded;
+	}
+	r = &ledger->lcx;
+	if (!r->complete) {
+		if (rail != 0) {
+			*rail = "lcx";
+		}
+		if (field != 0) {
+			*field = r->missing ? r->missing : "field";
+		}
+		return K60RailVerdictIncomplete;
+	}
+	if (!r->valid) {
+		if (rail != 0) {
+			*rail = "lcx";
+		}
+		if (field != 0) {
+			*field = r->why ? r->why : "inconsistent";
+		}
+		return K60RailVerdictInvalid;
+	}
+	r = &ledger->lmx;
+	if (!r->complete) {
+		if (rail != 0) {
+			*rail = "lmx";
+		}
+		if (field != 0) {
+			*field = r->missing ? r->missing : "field";
+		}
+		return K60RailVerdictIncomplete;
+	}
+	if (!r->valid) {
+		if (rail != 0) {
+			*rail = "lmx";
+		}
+		if (field != 0) {
+			*field = r->why ? r->why : "inconsistent";
+		}
+		return K60RailVerdictInvalid;
+	}
+	return K60RailVerdictInherited;
+}
+
+#ifdef KERNEL
+static void
+rail_print(const char *name, const K60RailRecord *r)
+{
+	printf("K60RAIL %s id=%#x tcs=%u addr=%#x level=%u (arc index, not mV)"
+	    " complete=%u valid=%u", name, r->resource_id, r->tcs_slot,
+	    r->address, r->level, r->complete, r->valid);
+	if (r->missing != 0) {
+		printf(" missing=%s", r->missing);
+	}
+	if (r->why != 0) {
+		printf(" why=%s", r->why);
+	}
+	printf("\n");
+}
+
+/* One read-only pass over the two windows: find each rail's cmd-db address and
+ * read the TCS slot that address names. Nothing here writes. */
+static void
+rail_record_pass(const uint8_t *db, volatile uint32_t *words, uint32_t drv_id)
+{
+	K60RailRecord lcx, lmx;
+	K60RscLayout layout = k60_rsc_layout(drv_id);
+	K60RpmhResource rail;
+	uint32_t lcx_id = 0, lmx_id = 0;
+
+	if (k60_cmd_db_find(db, K60_CMD_DB_BYTES, "lcx.lvl", &rail) == K60RpmhOk) {
+		lcx_id = rail.address;
+	}
+	if (k60_cmd_db_find(db, K60_CMD_DB_BYTES, "lmx.lvl", &rail) == K60RpmhOk) {
+		lmx_id = rail.address;
+	}
+	(void)k60_rail_measure(words, K60_RSC_BYTES, &layout, lcx_id, &lcx);
+	(void)k60_rail_measure(words, K60_RSC_BYTES, &layout, lmx_id, &lmx);
+	k60_rail_ledger_store(drv_id, &lcx, &lmx);
+	rail_print("lcx", &lcx);
+	rail_print("lmx", &lmx);
+}
+
+/* Map both windows once, record, leave. 0 means the ledger now exists. */
+static int
+rail_pass(void)
+{
+	vm_offset_t db, rsc;
+
+	db = ml_io_map_unmappable((vm_offset_t)K60_CMD_DB_PHYS,
+	    (vm_size_t)K60_CMD_DB_BYTES, 0x7);
+	if (db == 0) {
+		printf("K60RAIL cmd-db map failed phys=%#llx\n",
+		    (unsigned long long)K60_CMD_DB_PHYS);
+		return -1;
+	}
+	rsc = ml_io_map_unmappable((vm_offset_t)K60_RSC_DRV2_PHYS,
+	    (vm_size_t)K60_RSC_BYTES, 0x7);
+	if (rsc == 0) {
+		printf("K60RAIL rsc map failed phys=%#llx\n",
+		    (unsigned long long)K60_RSC_DRV2_PHYS);
+		return -1;
+	}
+	rail_record_pass((const uint8_t *)db, (volatile uint32_t *)rsc,
+	    ((volatile uint32_t *)rsc)[0]);
+	return 0;
+}
+
+/*
+ * The rail gate, and the reason it is not in resources(): the earliest call
+ * site in the kernel cannot legally read these registers at all (HR-01 timing),
+ * so a verdict there would be an always-false condition wearing a gate's
+ * clothes (P-223). This runs as the first step of k60_adsp_bring_up(), which
+ * only exists after Data mount and which reaches AUTH_AND_RESET itself; the
+ * refusal therefore sits before the irreversible step it is protecting.
+ */
+int
+k60_rail_inherit(void)
+{
+	const K60RailLedger *led;
+	const char *rail = 0, *field = 0;
+	int verdict, gate = 0;
+
+	led = k60_rail_ledger();
+	if (led == 0 || led->magic != K60_RAIL_LEDGER_MAGIC || !led->recorded) {
+		/* HR-01 condition 2: this second restricted read site stays behind
+		 * the same explicit boot argument as the first one. */
+		if (!PE_parse_boot_argn("pong_rail_probe", &gate, sizeof(gate)) ||
+		    gate == 0) {
+			printf("K60ADSP: rails not measured: pong_rail_probe is "
+			    "off, so inheritance cannot be proven; refusing "
+			    "AUTH_AND_RESET\n");
+			return K60_RAIL_REFUSED;
+		}
+		if (rail_pass() != 0) {
+			printf("K60ADSP: rails not measured: cmd-db=%#llx or "
+			    "rsc=%#llx could not be mapped; refusing "
+			    "AUTH_AND_RESET\n",
+			    (unsigned long long)K60_CMD_DB_PHYS,
+			    (unsigned long long)K60_RSC_DRV2_PHYS);
+			return K60_RAIL_REFUSED;
+		}
+		led = k60_rail_ledger();
+	}
+	verdict = k60_rail_verdict(led, &rail, &field);
+	if (verdict == K60RailVerdictInherited) {
+		printf("K60ADSP: rails inherited lcx=%#x@%u level=%u "
+		    "lmx=%#x@%u level=%u (arc index, not mV)\n",
+		    led->lcx.resource_id, led->lcx.tcs_slot, led->lcx.level,
+		    led->lmx.resource_id, led->lmx.tcs_slot, led->lmx.level);
+		return 0;
+	}
+	if (verdict == K60RailVerdictInvalid) {
+		/* Wording differs from the missing case on purpose: a measured
+		 * but self-inconsistent rail is not a failed read. */
+		printf("K60ADSP: rail measured but invalid %s (%s); refusing "
+		    "AUTH_AND_RESET\n", rail ? rail : "?", field ? field : "?");
+		return K60_RAIL_REFUSED;
+	}
+	printf("K60ADSP: rail not inherited %s: %s missing; refusing "
+	    "AUTH_AND_RESET\n", rail ? rail : "lcx", field ? field : "record");
+	return K60_RAIL_REFUSED;
+}
+
+int
+k60_rail_probe(void)
+{
+	vm_offset_t db = 0, rsc = 0;
+	const uint8_t *bytes;
+	K60RpmhResource res;
+	int rc;
+
+	db = ml_io_map_unmappable((vm_offset_t)K60_CMD_DB_PHYS,
+	    (vm_size_t)K60_CMD_DB_BYTES, 0x7);
+	if (db == 0) {
+		printf("K60RAIL cmd-db map failed phys=%#llx\n",
+		    (unsigned long long)K60_CMD_DB_PHYS);
+		return -1;
+	}
+	bytes = (const uint8_t *)db;
+	printf("K60RAIL cmd-db magic=%#x version=%u\n", le32(bytes + 4),
+	    le32(bytes));
+	rc = k60_cmd_db_find(bytes, K60_CMD_DB_BYTES, "ldoc2", &res);
+	if (rc != K60RpmhOk) {
+		printf("K60RAIL ldoc2 not found rc=%d\n", rc);
+	} else {
+		uint32_t index = 0;
+		int li = k60_rpmh_level_index(&res, 1800, &index);
+
+		/* The level table did not look like millivolts, so dump the bytes
+		 * that produced it instead of guessing a different field layout.
+		 * ldoc2 lives in a different slave than the clock resources, so walk
+		 * every slave the header declares. */
+		{
+			uint32_t s;
+
+			for (s = 0; s < 8; s++) {
+				const uint8_t *slave = bytes + 8 + 16 * s;
+				uint32_t id = le16(slave);
+				uint32_t heads, data, count, e;
+
+				if (id == 0) {
+					break;
+				}
+				heads = 144u + le16(slave + 2);
+				data = 144u + le16(slave + 4);
+				count = le16(slave + 6);
+				printf("K60RAIL slave%u id=%u heads=%u data=%u count=%u\n",
+				    s, id, heads, data, count);
+				for (e = 0; e < count && e < 40; e++) {
+					const uint8_t *en = bytes + heads + 24 * e;
+					uint32_t at, n, i;
+
+					printf("K60RAIL s%u e%u id=%c%c%c%c%c%c%c%c "
+					    "addr=%#x len=%u off=%u\n", s, e,
+					    en[0], en[1], en[2], en[3], en[4], en[5], en[6], en[7],
+					    le32(en + 16), le16(en + 20), le16(en + 22));
+					if (en[0] != 'l' || en[1] != 'd' || en[2] != 'o' ||
+					    en[3] != 'c' || en[4] != '2') {
+						continue;
+					}
+					at = data + le16(en + 22);
+					n = le16(en + 20);
+					printf("K60RAIL ldoc2 aux at=%u len=%u:", at, n);
+					for (i = 0; i < n && i < 32; i++) {
+						printf(" %02x", bytes[at + i]);
+					}
+					printf("\n");
+				}
+			}
+		}
+		printf("K60RAIL ldoc2 address=%#x levels=%u idx1800=%d->%u",
+		    res.address, res.level_count, li, index);
+		for (unsigned i = 0; i < res.level_count && i < 8; i++) {
+			printf(" l%u=%u", i, res.levels[i]);
+		}
+		printf("\n");
+	}
+	rsc = ml_io_map_unmappable((vm_offset_t)K60_RSC_DRV2_PHYS,
+	    (vm_size_t)K60_RSC_BYTES, 0x7);
+	if (rsc == 0) {
+		printf("K60RAIL rsc map failed phys=%#llx\n",
+		    (unsigned long long)K60_RSC_DRV2_PHYS);
+		return -1;
+	}
+	{
+		volatile uint32_t *w = (volatile uint32_t *)rsc;
+		K60RscLayout l = k60_rsc_layout(w[0]);
+
+		printf("K60RAIL rsc drv_id=%#x version=%u stride=%u cmd=%u "
+		    "ctrl=%#x enable=%#x msgid=%#x addr=%#x data=%#x\n", w[0],
+		    (unsigned)((w[0] >> 16) & 0xff), l.tcs_stride, l.cmd_stride,
+		    l.control, l.cmd_enable, l.cmd_msgid, l.cmd_addr, l.cmd_data);
+
+		/* Same pass, same gate, single shot: if k60_adsp_bring_up()
+		 * already measured this boot, print that ledger instead of
+		 * mapping a second time (P-223). */
+		if (k60_rail_ledger() == 0) {
+			rail_record_pass(bytes, w, w[0]);
+		} else {
+			const K60RailLedger *led = k60_rail_ledger();
+
+			rail_print("lcx", &led->lcx);
+			rail_print("lmx", &led->lmx);
+		}
+	}
+	return 0;
+}
+#endif /* KERNEL */
