+} Aw882xxRegValue;
+
+/* Placeholder row kept compilable but disabled: a guessed init sequence would
+ * be worse than no write. Fill from vendor `aw882xx.c` defaults when present. */
+static const Aw882xxRegValue g_aw882xx_todo_init[] = {
+	{ 0x00u, 0x0000u, 0xffffu },   /* TODO(aw882xx): vendor register 0 */
+};
+static bool g_aw882xx_apply_todo_init;
+
+static bool
+aw882xx_reg_update(uint8_t address, uint8_t reg, uint16_t mask, uint16_t value)
+{
+	uint16_t old = 0;
+	if (!aw882xx_reg_read(address, reg, &old)) {
+		return false;
+	}
+	return aw882xx_reg_write(address, reg, (uint16_t)((old & ~mask) |
+	    (value & mask)));
+}
+
+/* ------------------------------------------------------------------------- */
+/* AW882xx device state                                                      */
+/* ------------------------------------------------------------------------- */
+
+typedef struct {
+	uint8_t address;
+	unsigned reset_gpio;
+	unsigned irq_gpio;
+	unsigned spksw_gpio;
+	unsigned sound_channel;
+	uint16_t chip_id;
+	uint16_t revision;
+	bool present;
+	bool initialized;
+} Aw882xxAmp;
+
+static Aw882xxAmp g_aw882xx_top = {
+	.address = AW882XX_ADDR_TOP,
+	.reset_gpio = AW882XX_RESET_GPIO_TOP,
+	.irq_gpio = AW882XX_IRQ_GPIO_TOP,
+	.spksw_gpio = AW882XX_SPKSW_GPIO,
+	.sound_channel = AW882XX_SOUND_CHANNEL_TOP,
+};
+
+static Aw882xxAmp g_aw882xx_bot = {
+	.address = AW882XX_ADDR_BOT,
+	.reset_gpio = AW882XX_RESET_GPIO_BOT,
+	.irq_gpio = AW882XX_IRQ_GPIO_BOT,
+	.spksw_gpio = 0,
+	.sound_channel = AW882XX_SOUND_CHANNEL_BOT,
+};
+
+static void
+aw882xx_reset(Aw882xxAmp *amp)
+{
+	/* TODO(aw882xx): use datasheet assert/release times. K60 reset-gpio
+	 * flag 0 is active-high by DT convention [推断], not measured. */
+	aw882xx_pin_config(amp->reset_gpio, AW882XX_TLMM_CFG_GPIO, 1);
+	delay(1000);
+	aw882xx_pin_config(amp->reset_gpio, AW882XX_TLMM_CFG_GPIO, 0);
+	delay(1000);
+}
+
+static bool
+aw882xx_probe_one(Aw882xxAmp *amp)
+{
+	uint16_t chip = 0;
+	uint16_t rev = 0;
+	if (!aw882xx_reg_read(amp->address, (uint8_t)AW882XX_TODO_CHIP_ID_REG,
+	    &chip) ||
+	    !aw882xx_reg_read(amp->address, (uint8_t)AW882XX_TODO_REVISION_REG,
+	    &rev)) {
+		printf("AW882xx: addr=0x%02x no ACK (read-only probe)\n",
+		    amp->address);
+		return false;
+	}
+	amp->chip_id = chip;
+	amp->revision = rev;
+	amp->present = true;
+	printf("AW882xx: addr=0x%02x chip=0x%04x rev=0x%04x "
+	    "(TODO: verify against vendor IDs)\n", amp->address, chip, rev);
+	return true;
+}
+
+static bool
+aw882xx_init_one(Aw882xxAmp *amp)
+{
+	if (!amp->present) {
+		return false;
+	}
+	aw882xx_reset(amp);
+	if (!aw882xx_probe_one(amp)) {
+		return false;
+	}
+	if (g_aw882xx_apply_todo_init) {
+		for (unsigned i = 0; i < sizeof(g_aw882xx_todo_init) /
+		    sizeof(g_aw882xx_todo_init[0]); ++i) {
+			const Aw882xxRegValue *v = &g_aw882xx_todo_init[i];
+			if (v->mask == 0xffffu) {
+				if (!aw882xx_reg_write(amp->address, v->reg, v->value)) {
+					return false;
+				}
+			} else if (!aw882xx_reg_update(amp->address, v->reg, v->mask,
+			    v->value)) {
+				return false;
+			}
+		}
+	}
+	if (amp->spksw_gpio != 0) {
+		/* TODO(aw882xx): GPIO52 polarity is not documented in the K60
+		 * FDT; keep the switch deasserted until the board schematic is
+		 * checked. */
+		aw882xx_pin_config(amp->spksw_gpio, AW882XX_TLMM_CFG_GPIO, 0);
+	}
+	amp->initialized = true;
+	printf("AW882xx: addr=0x%02x initialized (EXPERIMENTAL)\n",
+	    amp->address);
+	return true;
+}
+
+static void
+aw882xx_irq_pin_prepare(Aw882xxAmp *amp)
+{
+	/* TODO(aw882xx): the TLMM GPIO interrupt controller binding is not
+	 * implemented here. Configure the pad as GPIO input for now; the GIC
+	 * interrupt registration remains a follow-up item. */
+	aw882xx_pin_config(amp->irq_gpio, AW882XX_TLMM_CFG_GPIO, -1);
+	printf("AW882xx: irq gpio%u prepared (flags=0x%x, handler TODO)\n",
+	    amp->irq_gpio, AW882XX_IRQ_FLAGS);
+}
+
+static bool
+aw882xx_bus_init(void)
+{
+	if (!aw882xx_bus_map()) {
+		printf("AW882xx: cannot map GCC/TLMM/I2C windows\n");
+		return false;
+	}
+	/* GCC QUPV3_2 votes: same sequence as PongAudio.cpp:127-139, with
+	 * K60's TLMM base above. TODO(aw882xx): verify the GCC offsets on the
+	 * final K60 tree; they are SM8475-family values, not AW882xx values. */
+	aw882xx_gcc_write(0x62008, aw882xx_gcc_read(0x62008) |
+	    (15u << 18) | (1u << 27));
+	const uint32_t gates[] = { 0x3314cu, 0x33140u, 0x28004u, 0x28008u,
+		0x28610u };
+	for (unsigned i = 0; i < sizeof(gates) / sizeof(gates[0]); ++i) {
+		if (!aw882xx_wait_cbcrc(gates[i], 100)) {
+			printf("AW882xx: GCC gate 0x%x not ready\n", gates[i]);
+			return false;
+		}
+	}
+	aw882xx_pin_config(AW882XX_I2C_GPIO_SCL, AW882XX_TLMM_CFG_I2C, -1);
+	aw882xx_pin_config(AW882XX_I2C_GPIO_SDA, AW882XX_TLMM_CFG_I2C, -1);
+	unsigned level = 0xff;
+	for (unsigned i = 0; i < 8; ++i) {
+		const uint32_t cfg = aw882xx_gcc_read(0x28618u + 0x1cu + 4u * i);
+		if (((cfg >> 8) & 7u) == 0 && ((cfg >> 12) & 3u) == 0 &&
+		    (cfg & 31u) <= 1u) {
+			level = i;
+			break;
+		}
+	}
+	if (level == 0xff) {
+		printf("AW882xx: no QUPV3_2 SE15 clock level\n");
+		return false;
+	}
+	aw882xx_i2c_write_reg(NULL, 0x28, aw882xx_i2c_read_reg(NULL, 0x28) |
+	    0x7fu);
+	aw882xx_i2c_write_reg(NULL, 0xe30, aw882xx_i2c_read_reg(NULL, 0xe30) |
+	    15u);
+	aw882xx_i2c_write_reg(NULL, 0x24, 0x7fu);
+	aw882xx_i2c_write_reg(NULL, 0x20, 1u);
+	aw882xx_i2c_write_reg(NULL, 0xe18, 0);
+	aw882xx_i2c_write_reg(NULL, 0x7c, level);
+	aw882xx_i2c_write_reg(NULL, GENI_CLK_CFG, 0x21u);
+	aw882xx_i2c_write_reg(NULL, GENI_SCL_COUNTERS,
+	    (5u << 20) | (11u << 10) | 22u);
+	Aw882xxGeniIo io = { aw882xx_i2c_read_reg, aw882xx_i2c_write_reg, NULL };
+	if (aw882xx_geni_prepare(&g_aw882xx_bus.geni, &io, AW882XX_ADDR_TOP,
+	    &g_aw882xx_bus.i2c_config) != 0) {
+		printf("AW882xx: GENI SE15 is not I2C firmware\n");
+		return false;
+	}
+	g_aw882xx_bus.geni_ready = true;
+	printf("AW882xx: GENI I2C ready (config=0x%x)\n",
+	    g_aw882xx_bus.i2c_config);
+	return true;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Public entry points                                                       */
+/* ------------------------------------------------------------------------- */
+
+int aw882xx_bootstrap(void);
+int aw882xx_probe(void);
+int aw882xx_start(void);
+
+int
+aw882xx_probe(void)
+{
+	int value = 0;
+	if (!PE_parse_boot_argn("pong_aw882xx", &value, sizeof(value)) ||
+	    value == 0) {
+		return 0;
+	}
+	if (!aw882xx_bus_init()) {
+		return -1;
+	}
+	/* A released reset is required before the I2C ID registers answer.
+	 * This is still a read-only identity probe: only GPIO reset is driven. */
+	aw882xx_reset(&g_aw882xx_top);
+	aw882xx_reset(&g_aw882xx_bot);
+	aw882xx_irq_pin_prepare(&g_aw882xx_top);
+	aw882xx_irq_pin_prepare(&g_aw882xx_bot);
+	bool top = aw882xx_probe_one(&g_aw882xx_top);
+	bool bot = aw882xx_probe_one(&g_aw882xx_bot);
+	printf("AW882xx: probe top=%d bot=%d\n", top, bot);
+	return top && bot ? 0 : -1;
+}
+
+int
+aw882xx_start(void)
+{
+	int value = 0;
+	if (!PE_parse_boot_argn("pong_aw882xx", &value, sizeof(value)) ||
+	    value < 2) {
+		return 0;
+	}
+	if (!g_aw882xx_bus.geni_ready && !aw882xx_bus_init()) {
+		return -1;
+	}
+	bool top = aw882xx_init_one(&g_aw882xx_top);
+	bool bot = aw882xx_init_one(&g_aw882xx_bot);
+	printf("AW882xx: init top=%d bot=%d (EXPERIMENTAL)\n", top, bot);
+	return top && bot ? 0 : -1;
+}
+
+static void
+aw882xx_worker(void *arg __unused, wait_result_t wait __unused)
+{
+	int value = 0;
+	if (PE_parse_boot_argn("pong_aw882xx", &value, sizeof(value))) {
+		if (value == 1) {
+			(void)aw882xx_probe();
+		} else if (value >= 2) {
+			(void)aw882xx_start();
+		}
+	}
+	thread_terminate_self();
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+int
+aw882xx_bootstrap(void)
+{
+	int value = 0;
+	if (!PE_parse_boot_argn("pong_aw882xx", &value, sizeof(value)) ||
+	    value == 0) {
+		return 0;
+	}
+	thread_t thread = NULL;
+	if (kernel_thread_start(aw882xx_worker, NULL, &thread) != KERN_SUCCESS) {
+		printf("AW882xx: worker thread creation failed\n");
+		return -1;
+	}
+	thread_deallocate(thread);
+	return 0;
+}
