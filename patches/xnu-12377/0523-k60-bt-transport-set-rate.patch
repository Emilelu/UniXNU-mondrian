diff --git a/bsd/dev/qbt/qbt_transport.h b/bsd/dev/qbt/qbt_transport.h
--- a/bsd/dev/qbt/qbt_transport.h
+++ b/bsd/dev/qbt/qbt_transport.h
@@ -11,6 +11,9 @@
     void (*wake)(void *);
     /* Queue power transition on the UART worker; never call back inline. */
     int (*power)(void *, bool);
+    /* Reclock the physical line for a client TIOCSETA.  Called without the
+     * transport lock; may sleep.  NULL keeps the bring-up speed. */
+    int (*set_rate)(void *, uint32_t baud);
 };
 extern volatile uint32_t qbt_transport_activity[4];
 int qbt_transport_init(const struct qbt_transport_ops *);
diff --git a/bsd/dev/qbt/qbt_transport.c b/bsd/dev/qbt/qbt_transport.c
--- a/bsd/dev/qbt/qbt_transport.c
+++ b/bsd/dev/qbt/qbt_transport.c
@@ -463,11 +463,26 @@
     if((uint32_t)opt==0x80487414u) {             /* TIOCSETA */
         if(len!=sizeof(struct bt_termios64)) return EINVAL;
         const struct bt_termios64 *t=data;
-        /* The line is fixed at 8N1 RTS/CTS and the operating speed set in the bring-up. */
-        bool ok=(t->cflag&(0x300|0x400|0x1000))==0x300 && (t->cflag&0x30000)==0x30000 &&
-            t->ispeed==bt_sk_speed && t->ospeed==bt_sk_speed;
-        printf("[bluetooth sk] TIOCSETA cflag=%#llx speed=%llu/%llu %s\n",t->cflag,t->ispeed,t->ospeed,ok?"accepted":"unsupported");
-        if(!ok) return EINVAL;
+        /* The line is fixed at 8N1 RTS/CTS. 0523: when a client asks for a
+         * different speed the board reclockes the GENI engine through the
+         * set_rate hook instead of only remembering the request, so the
+         * controller is really reached at the rate the client believes it
+         * negotiated.  The hook may sleep; no transport lock is held here. */
+        bool framing=(t->cflag&(0x300|0x400|0x1000))==0x300 && (t->cflag&0x30000)==0x30000;
+        uint32_t speed=(uint32_t)t->ispeed;
+        errno_t e=0;
+        if(!framing || t->ispeed!=t->ospeed || !speed) e=EINVAL;
+        else if(speed!=bt_sk_speed) {
+            e=bt_ops.set_rate?bt_ops.set_rate(bt_ops.context,speed):EINVAL;
+            if(!e) {
+                lck_mtx_lock(&bt_sk_lock);
+                bt_sk_speed=speed;
+                bt_sk_termios_default();
+                lck_mtx_unlock(&bt_sk_lock);
+            }
+        }
+        printf("[bluetooth sk] TIOCSETA cflag=%#llx speed=%llu/%llu %s error=%d\n",t->cflag,t->ispeed,t->ospeed,e?"unsupported":"accepted",e);
+        if(e) return e;
         lck_mtx_lock(&bt_sk_lock);bt_sk.termios=*t;lck_mtx_unlock(&bt_sk_lock);
         return 0;
     }
