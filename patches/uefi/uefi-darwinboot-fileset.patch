+    return EFI_UNSUPPORTED;
+  }
+
+  /* cpusubtype carries capability bits in [31:24]; 2 is ARM64E. */
+  SubType  = U32 (Data + 8) & 0x00ffffff;
+  FileType = U32 (Data + 12);
+  if ((SubType != 0) && (SubType != 2)) { return EFI_UNSUPPORTED; }
+
+  Fileset = (BOOLEAN)(FileType == 0xc);
+  Header = Data;
+  HeaderOffset = 0;
+  if (FileType == 0xc) {
+    /*
+     * A kernel collection: the top level has no segments, only
+     * LC_FILESET_ENTRY commands. The kernel is the entry named
+     * com.apple.kernel, and its segments keep file offsets into this same
+     * file, so only the header and the command stream move.
+     */
+    if (U32 (Data + 20) > Size - 32) { return EFI_LOAD_ERROR; }
+    OuterEnd = 32 + U32 (Data + 20);
+    OuterOffset = 32;
+    Header = NULL;
+    for (Index = 0; Index < U32 (Data + 16); Index++) {
+      if (OuterEnd - OuterOffset < 8) { return EFI_LOAD_ERROR; }
+      Command = U32 (Data + OuterOffset);
+      Length  = U32 (Data + OuterOffset + 4);
