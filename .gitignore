*.ramdisk
*.lzfse
*.partial
*.dSYM/
*.o
*.a
*.dylib
*.metallib
*.air
*.kc
*.kernelcache
*.log
!scripts/tests/fixtures/*.log
.DS_Store
__pycache__/
*.py[cod]
/local.toml
mac-build/*/cache/
*.fat
mac-build/*/build-report.json
build/
/.cache/
