+static void
+pong_hw_ep_mf(PongWriter *w, uint32_t iid, const PongArFormat *f)
+{
+	const uint32_t at = pong_param_begin(w, iid, PARAM_HW_EP_MF);
+	pong_put32(w, f->rate);
