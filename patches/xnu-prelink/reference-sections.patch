+def section_kind(section):
+    """The section name of a `section_of` result, or None when the address is outside every section.
+
+    A reference kernel built here carries symbols that sit in no section
+    (absolute and linker-synthesised ones), so `section_of` answers '?' for
+    them; reading only the name after the separator keeps the check meaningful
+    instead of indexing past a separator that is not there.
+    """
+    return section.split(',', 1)[1] if ',' in section else None
+
