+/* E-GENI-04/E-GENI-05: QUP wrapper HW version decides 32x vs 16x sampling. */
+#define K60_QUP_HW_VER_REG          0x00000004u
+#define K60_QUP_VERSION_2_5         0x20050000u
+
+/* Default baud.  See EVIDENCE.md E-GCC-07: qbt_geni_set_rate(3200000,
+ * 100000000, 16) is asserted to fail with -ERANGE in the upstream unit test;
+ * 3,000,000 x 16 = 48 MHz and 4,000,000 x 16 = 64 MHz are exact table entries.
+ * Keep 3,000,000 as the first bring-up value; 3.2 Mbaud is not reachable on
+ * SM8450's SE clock table under qbt_geni's 1% rule without a different parent
+ * clock (TODO: verify on hardware whether the controller accepts 3 Mbaud). */
