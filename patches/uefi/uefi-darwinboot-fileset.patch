+      if ((Command == 0x80000035) && (Length >= 32)) {
+        FileOffset64 = U64 (Data + OuterOffset + 16);
+        NameOffset   = U32 (Data + OuterOffset + 24);
+        FileOffset   = (UINTN)FileOffset64;
+        if ((FileOffset64 == FileOffset) && (NameOffset < Length) && (FileOffset < Size)) {
+          if (AsciiStrCmp ((CONST CHAR8 *)(Data + OuterOffset + NameOffset), "com.apple.kernel") == 0) {
+            Header = Data + FileOffset;
+            HeaderOffset = FileOffset;
+            break;
+          }
+        }
+      }
+      OuterOffset += Length;
+    }
+    if (Header == NULL) { return EFI_UNSUPPORTED; }
