diff --git a/iokit/Kernel/MiniBluetooth.cpp b/iokit/Kernel/MiniBluetooth.cpp
new file mode 100644
index 0000000..86b7b94
--- /dev/null
+++ b/iokit/Kernel/MiniBluetooth.cpp
@@ -0,0 +1,198 @@
+/*
+ * Bluetooth publication for the K60 port on xnu-12377 (iOS 27 line).
+ *
+ * bluetoothd on the iOS 16 build looks for a device-tree child of /arm-io
+ * whose device_type is "bluetooth" and for an IOService carrying the same
+ * name; on iOS 27 the same contract is expected.  When neither exists the
+ * daemon prints "No bluetooth on this device" and gives up, which is exactly
+ * what the K60 console shows today.  This file publishes both and stamps the
+ * stable local address that bsd/dev/qbt_k60.c derives from
+ * /chosen/unique-chip-id.
+ *
+ * The 16.6.1 tree called this from MiniIOSurface.cpp's UI-services start,
+ * behind the PONG machine config.  The 12377 line has neither the Mini*
+ * files nor that machine config, so the entry point is a standalone
+ * extern "C" symbol called from bsd_init.c once IOKit is up; the service
+ * root is obtained from IOKit itself.
+ *
+ * Everything is gated on the k60bt boot argument, so booting the same image
+ * without it leaves the registry exactly as it is today.
+ */
+#include <IOKit/IOService.h>
+
+#if !defined(XNU_K60_BT_PUBLISH)
+#define XNU_K60_BT_PUBLISH 1
+#endif
+
+#if XNU_K60_BT_PUBLISH && !SECURE_KERNEL
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOKitKeys.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <string.h>
+
+extern "C" int k60_bt_local_address(uint8_t address[6]);
+
+#define K60_BT_TRANSPORT_ENCODING 1u
+#define K60_BT_TRANSPORT_SPEED    3200000u
+
+class K60BluetoothRadio : public IOService
+{
+	OSDeclareDefaultStructors(K60BluetoothRadio);
+
+public:
+	bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(K60BluetoothRadio, IOService);
+
+bool
+K60BluetoothRadio::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	return true;
+}
+
+/* Device-tree integers are raw little-endian bytes; publish them the same way. */
+static void
+k60_bt_number_property(IORegistryEntry * entry, const char * key, uint32_t value)
+{
+	entry->setProperty(key, &value, sizeof(value));
+}
+/* Publish a C string as OSData bytes (NUL included): Apple-side readers
+ * call getBytes: on these properties, and an OSString makes them crash
+ * (backboardd -[NSTaggedPointerString getBytes:range:], bt-s4c-20261115c
+ * console.log:1303). */
+static void
+k60_bt_string_property(IORegistryEntry * entry, const char * key, const char * value)
+{
+	OSData * data = OSData::withBytes(value, strlen(value) + 1);
+	if (data == NULL) {
+		return;
+	}
+	entry->setProperty(key, data);
+	data->release();
+}
+
+/* /arm-io/bluetooth, created when the device tree does not carry it yet. */
+static IORegistryEntry *
+k60_bt_node(IORegistryEntry * armio)
+{
+	IORegistryEntry * node = IORegistryEntry::fromPath("/arm-io/bluetooth", gIODTPlane);
+
+	if (node != NULL) {
+		return node;
+	}
+	node = OSTypeAlloc(IORegistryEntry);
+	if (node == NULL) {
+		return NULL;
+	}
+	if (!node->init()) {
+		node->release();
+		return NULL;
+	}
+	node->setName("bluetooth");
+	k60_bt_string_property(node, "device_type", "bluetooth");
+	k60_bt_string_property(node, "compatible", "qcom,wcn7850-bt");
+	k60_bt_string_property(node, "unixnu,adt-name", "bluetooth");
+	k60_bt_number_property(node, "transport-encoding", K60_BT_TRANSPORT_ENCODING);
+	k60_bt_number_property(node, "transport-speed", K60_BT_TRANSPORT_SPEED);
+	if (!node->attachToParent(armio, gIODTPlane)) {
+		node->release();
+		return NULL;
+	}
+	return node;
+}
+
+static void
+k60_bt_publish(IOService * provider)
+{
+	static bool published;
+	uint32_t enabled = 0;
+	uint8_t address[6];
+	IORegistryEntry * armio;
+	IORegistryEntry * node;
+	IORegistryEntry * chosen;
+	K60BluetoothRadio * radio;
+	int error;
+
+	if (published) {
+		return;
+	}
+	if (!PE_parse_boot_argn("k60bt", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	error = k60_bt_local_address(address);
+	if (error != 0) {
+		IOLog("K60 BT: no platform identity (%d); bluetooth not published\n", error);
+		return;
+	}
+	armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	if (armio == NULL) {
+		IOLog("K60 BT: no /arm-io node; bluetooth not published\n");
+		return;
+	}
+	node = k60_bt_node(armio);
+	if (node == NULL) {
+		IOLog("K60 BT: could not create /arm-io/bluetooth\n");
+		armio->release();
+		return;
+	}
+	node->setProperty("local-mac-address", address, sizeof(address));
+	chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (chosen != NULL) {
+		chosen->setProperty("mac-address-bluetooth0", address, sizeof(address));
+		chosen->release();
+	}
+	radio = OSTypeAlloc(K60BluetoothRadio);
+	if (radio != NULL && radio->init()) {
+		radio->setName("bluetooth");
+		k60_bt_string_property(radio, "device_type", "bluetooth");
+		k60_bt_number_property(radio, "transport-encoding", K60_BT_TRANSPORT_ENCODING);
+		k60_bt_number_property(radio, "transport-speed", K60_BT_TRANSPORT_SPEED);
+		radio->setProperty("local-mac-address", address, sizeof(address));
+		if (radio->attach(provider) && radio->start(provider)) {
+			published = true;
+		} else {
+			radio->release();
+		}
+	} else if (radio != NULL) {
+		radio->release();
+	}
+	node->release();
+	armio->release();
+	IOLog("K60 BT: %s local address %02x:%02x:%02x:%02x:%02x:%02x\n",
+	    published ? "published" : "failed to publish",
+	    address[0], address[1], address[2], address[3], address[4], address[5]);
+}
+
+/* Entry point for bsd_init.c (C).  The 16.6.1 tree handed in the UI-services
+ * provider; on 12377 the publish happens once IOKit is up, so the service
+ * root is the parent. */
+extern "C" void
+K60BluetoothPublish(void)
+{
+	IOService * provider = IOService::getResourceService();
+
+	if (provider == NULL) {
+		IOLog("K60 BT: no IOKit resource service; bluetooth not published\n");
+		return;
+	}
+	k60_bt_publish(provider);
+}
+
+#else /* !(XNU_K60_BT_PUBLISH && !SECURE_KERNEL) */
+
+extern "C" void
+K60BluetoothPublish(void)
+{
+}
+
+#endif /* XNU_K60_BT_PUBLISH && !SECURE_KERNEL */
