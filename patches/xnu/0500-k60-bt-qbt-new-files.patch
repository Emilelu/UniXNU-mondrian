+/* TLMM register layout, from pinctrl-sm8450.c PINGROUP macro (E-PINCTRL-01):
+ * ctl_reg = id*0x1000, io_reg = +0x4, intr_cfg_reg = +0x8,
+ * intr_status_reg = +0xc; mux_bit=2, pull_bit=0, drv_bit=6, oe_bit=9,
+ * in_bit=0, out_bit=1, intr_enable_bit=0, intr_polarity_bit=1,
+ * intr_detection_bit=2 (width 2), intr_raw_status_bit=4. */
+#define K60_TLMM_GPIO_CFG(g)        ((g) * 0x1000u + 0x0u)
+#define K60_TLMM_GPIO_IO(g)         ((g) * 0x1000u + 0x4u)
+#define K60_TLMM_GPIO_INTR_CFG(g)   ((g) * 0x1000u + 0x8u)
+#define K60_TLMM_GPIO_INTR_STATUS(g)((g) * 0x1000u + 0xCu)
+#define K60_TLMM_MUX_BIT            2u
+#define K60_TLMM_PULL_DOWN          1u
+#define K60_TLMM_PULL_UP            3u
+#define K60_TLMM_PULL_NONE          0u
+#define K60_TLMM_DRIVE_2MA          0u   /* (2 mA / 2) - 1 */
+#define K60_TLMM_OE_BIT             9u
+#define K60_TLMM_OUT_BIT            1u
+#define K60_TLMM_IN_BIT             0u
+#define K60_TLMM_INTR_ENABLE_BIT    0u
+#define K60_TLMM_INTR_POLARITY_BIT  1u
+#define K60_TLMM_INTR_DETECTION_BIT 2u
+#define K60_TLMM_INTR_RAW_STATUS_BIT 4u
+#define K60_TLMM_INTR_TARGET_BIT    5u
+#define K60_TLMM_INTR_TARGET_KPSS   3u
+#define K60_PIN_FUNC_GPIO           0u
+/* E-PINCTRL-02: PINGROUP(76, qup20, ...) puts qup20 at funcs[1]; mux value
+ * written to the register is the index in funcs[], i.e. 1 << mux_bit = 0x4. */
+#define K60_PIN_FUNC_QUP20          (1u << K60_TLMM_MUX_BIT)
+#define K60_PIN_CFG(pull, drive)    (((drive) << 6) | (pull))
+
+#define K60_XO_PULSE_US             150u    /* vendor: 100..200 us before BT_EN high */
+#define K60_BT_EN_LOW_MS            50u
+#define K60_BT_EN_HIGH_MS           50u
+#define K60_BT_OFF_MS               100u
+#define K60_WLAN_OFF_DISCHARGE_MS   100u
