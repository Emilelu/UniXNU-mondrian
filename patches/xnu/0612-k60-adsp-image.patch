diff --git a/bsd/dev/pong_adsp_image.c b/bsd/dev/pong_adsp_image.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_adsp_image.c
@@ -0,0 +1,74 @@
+/* ADSP PAS image loader: table driven, no ELF parsing at boot.
+ *
+ * The table is generated by scripts/gen-adsp-table.py from the shipped adsp.mdt;
+ * scripts/tests/test-k60-adsp-image.py proves it matches adsp.b00..b25.
+ */
+
+#include "pong_adsp_image.h"
+
+static bool in_window(uint32_t paddr, uint32_t bytes)
+{
+    return paddr >= K60_ADSP_BASE &&
+           (uint64_t)paddr + bytes <= (uint64_t)K60_ADSP_BASE + K60_ADSP_WINDOW;
+}
+
+int k60_adsp_plan(K60AdspPlan *plan)
+{
+    if (!plan) {
+        return K60AdspBadArg;
+    }
+    uint32_t copied = 0, zeroed = 0;
+    uint32_t prev_end = 0;
+
+    for (uint32_t i = 0; i < K60_ADSP_SEGMENTS; i++) {
+        const K60AdspSegment *s = &k60_adsp_segments[i];
+
+        if (!s->bytes && !s->bss) {
+            return K60AdspBadSegment;      /* an all-empty row hides a table bug */
+        }
+        if (s->bytes && !s->part) {
+            return K60AdspBadSegment;      /* bytes but nothing to read them from */
+        }
+        if (!in_window(s->paddr, s->bytes + s->bss)) {
+            return K60AdspOutsideWindow;
+        }
+        if (i && s->paddr < prev_end) {
+            return K60AdspOverlap;
+        }
+        prev_end = s->paddr + s->bytes + s->bss;
+        copied += s->bytes;
+        zeroed += s->bss;
+    }
+
+    plan->base = K60_ADSP_BASE;
+    plan->window = K60_ADSP_WINDOW;
+    plan->segments = K60_ADSP_SEGMENTS;
+    plan->copied = copied;
+    plan->zeroed = zeroed;
+    return 0;
+}
+
+int k60_adsp_copy(void *window, size_t window_bytes, K60AdspRead read)
+{
+    if (!window || !read || window_bytes < K60_ADSP_WINDOW) {
+        return K60AdspBadArg;
+    }
+    uint8_t *dst = window;
+
+    for (uint32_t i = 0; i < K60_ADSP_SEGMENTS; i++) {
+        const K60AdspSegment *s = &k60_adsp_segments[i];
+        uint8_t *at = dst + (s->paddr - K60_ADSP_BASE);
+
+        /* Byte copy, never page copy: adsp.b10 loads at 0x86e0b2c0. */
+        if (s->bytes) {
+            int rc = read(s->part, at, s->bytes);
+            if (rc != 0) {
+                return K60AdspReadFailed;
+            }
+        }
+        for (uint32_t z = 0; z < s->bss; z++) {
+            at[s->bytes + z] = 0;
+        }
+    }
+    return 0;
+}
diff --git a/bsd/dev/pong_adsp_image.h b/bsd/dev/pong_adsp_image.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_adsp_image.h
@@ -0,0 +1,44 @@
+/* Contract for the ADSP PAS image loader (see K60AdspImage.c). */
+
+#ifndef K60_ADSP_IMAGE_H
+#define K60_ADSP_IMAGE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    K60AdspBadArg = -1,
+    K60AdspBadSegment = -2,
+    K60AdspOutsideWindow = -3,
+    K60AdspOverlap = -4,
+    K60AdspReadFailed = -5,
+};
+
+typedef struct {
+    uint32_t paddr;
+    uint32_t bytes;
+    uint32_t bss;
+    const char *part;
+} K60AdspSegment;
+
+#include "pong_adsp_table.h" /* needs K60AdspSegment, declared above */
+
+typedef struct {
+    uint32_t base;
+    uint32_t window;
+    uint32_t segments;
+    uint32_t copied;
+    uint32_t zeroed;
+} K60AdspPlan;
+
+/* read(part, dst, bytes) fills dst from the named firmware file; 0 on success. */
+typedef int (*K60AdspRead)(const char *part, void *dst, uint32_t bytes);
+
+/* Validates the table only; no allocation, no device access. */
+int k60_adsp_plan(K60AdspPlan *plan);
+
+/* Copies every segment and zeroes every bss tail. window is the PAS carveout. */
+int k60_adsp_copy(void *window, size_t window_bytes, K60AdspRead read);
+
+#endif /* K60_ADSP_IMAGE_H */
diff --git a/bsd/dev/pong_adsp_table.h b/bsd/dev/pong_adsp_table.h
