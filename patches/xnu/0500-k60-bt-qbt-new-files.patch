+/* ------------------------------------------------------------------------- */
+/* TLMM / GPIO helpers                                                        */
+/* ------------------------------------------------------------------------- */
+
+static void k60_pin_cfg(uint32_t gpio, uint32_t cfg) {
+    k60_write32(&k60.tlmm, K60_TLMM_GPIO_CFG(gpio), cfg);
+}
+static void k60_pin_io(uint32_t gpio, uint32_t value) {
+    k60_write32(&k60.tlmm, K60_TLMM_GPIO_IO(gpio), value);
+}
+static int k60_pin_input(uint32_t gpio) {
+    return (k60_read32(&k60.tlmm, K60_TLMM_GPIO_IO(gpio)) & (1u << K60_TLMM_IN_BIT)) != 0;
+}
+static void k60_gpio_output(uint32_t gpio, bool high, uint32_t pull, uint32_t drive) {
+    uint32_t cfg = K60_PIN_CFG(pull, drive) | (1u << K60_TLMM_OE_BIT);
+    k60_pin_io(gpio, high ? (1u << K60_TLMM_OUT_BIT) : 0u);
+    k60_pin_cfg(gpio, cfg);
+}
+static void k60_gpio_input(uint32_t gpio, uint32_t pull, uint32_t drive) {
+    uint32_t cfg = k60_read32(&k60.tlmm, K60_TLMM_GPIO_CFG(gpio));
+    cfg &= ~(1u << K60_TLMM_OE_BIT);          /* input: clear output enable */
+    cfg &= ~(0xfu << K60_TLMM_MUX_BIT);       /* function GPIO = 0 */
+    cfg &= ~((3u << 0) | (7u << 6));           /* clear pull and drive */
+    cfg |= K60_PIN_CFG(pull, drive);
+    k60_pin_cfg(gpio, cfg);
+}
+
+/* Configure GPIO79 as a falling-edge TLMM interrupt (vendor pattern:
+ * pinctrl-msm.c:1109-1124; sheng BluetoothProbe.cpp:110-116 uses the same
+ * raw register sequence). */
+static void k60_arm_rx_wake(void) {
+    volatile uint32_t *r = k60.tlmm.va + K60_TLMM_GPIO_CFG(K60_BT_RX_WAKE_GPIO) / 4u;
+    /* Function GPIO, no pull, 2 mA, input. */
+    k60_gpio_input(K60_BT_RX_WAKE_GPIO, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
+    r[2] = 0;                          /* INTR_CFG = 0 */
+    r[3] = 0;                          /* INTR_STATUS ack */
+    r[2] = (K60_TLMM_INTR_TARGET_KPSS << K60_TLMM_INTR_TARGET_BIT) |
+           (2u << K60_TLMM_INTR_DETECTION_BIT) |       /* EDGE_FALLING */
+           (1u << K60_TLMM_INTR_POLARITY_BIT) |
+           (1u << K60_TLMM_INTR_RAW_STATUS_BIT) | (1u << K60_TLMM_INTR_ENABLE_BIT);
+    k60_barrier();
+}
+static void k60_disarm_rx_wake(void) {
+    volatile uint32_t *r = k60.tlmm.va + K60_TLMM_GPIO_CFG(K60_BT_RX_WAKE_GPIO) / 4u;
+    r[2] &= ~(1u << K60_TLMM_INTR_ENABLE_BIT);
+    r[3] = 0;
+    k60_gpio_input(K60_BT_RX_WAKE_GPIO, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
+}
+static bool k60_rx_wake_pending(void) {
+    return (k60_read32(&k60.tlmm, K60_TLMM_GPIO_INTR_STATUS(K60_BT_RX_WAKE_GPIO)) & 1u) != 0;
+}
+
+/* UART active pin mux.  FDT pinctrl-1 = qupv3_se20_cts/rts/tx/rx_active:
+ * GPIO76..79, function qup20, 2 mA; bias per FDT (E-FDT-04). */
+static void k60_uart_pins_active(void) {
+    k60_pin_cfg(K60_BT_CTS_GPIO, K60_PIN_FUNC_QUP20 | K60_PIN_CFG(K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA));
+    k60_pin_cfg(K60_BT_RTS_GPIO, K60_PIN_FUNC_QUP20 | K60_PIN_CFG(K60_TLMM_PULL_DOWN, K60_TLMM_DRIVE_2MA));
+    k60_pin_cfg(K60_BT_TX_GPIO,  K60_PIN_FUNC_QUP20 | K60_PIN_CFG(K60_TLMM_PULL_UP,   K60_TLMM_DRIVE_2MA));
+    k60_pin_cfg(K60_BT_RX_WAKE_GPIO, K60_PIN_FUNC_QUP20 | K60_PIN_CFG(K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA));
+    k60_barrier();
+}
+static void k60_uart_pins_idle(void) {
+    /* FDT pinctrl-0 = default_cts / default_rtsrx / default_tx: all GPIO
+     * function, bias per board default; park them as inputs so nothing drives
+     * against the controller while BT_EN is low. */
+    k60_gpio_input(K60_BT_CTS_GPIO, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
+    k60_gpio_input(K60_BT_RTS_GPIO, K60_TLMM_PULL_DOWN, K60_TLMM_DRIVE_2MA);
+    k60_gpio_input(K60_BT_TX_GPIO, K60_TLMM_PULL_UP, K60_TLMM_DRIVE_2MA);
+    k60_gpio_input(K60_BT_RX_WAKE_GPIO, K60_TLMM_PULL_DOWN, K60_TLMM_DRIVE_2MA);
+}
