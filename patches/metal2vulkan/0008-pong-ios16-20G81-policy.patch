     pub fn pixel_format_info(self, raw: u64) -> PixelFormatInfo {
+        if self == MetalLevel::IOS16_6_1 { return ios16_format_info(raw); }
         let Ok(index) = DESCRIBED.binary_search_by_key(&raw, |row| u64::from(row.format.as_raw()))
