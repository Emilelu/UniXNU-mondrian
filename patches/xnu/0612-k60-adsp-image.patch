diff --git a/bsd/dev/pong_adsp_image.c b/bsd/dev/pong_adsp_image.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_adsp_image.c
@@ -0,0 +1,101 @@
+/* ADSP PAS image loader: table driven, no ELF parsing at boot.
+ *
+ * The table is generated by scripts/gen-adsp-table.py from the shipped adsp.mdt;
+ * scripts/tests/test-k60-adsp-image.py proves it matches adsp.b00..b25.
+ *
+ * Two addresses, deliberately kept apart:
+ *   K60_ADSP_LINK_BASE  where the firmware was linked (adsp.mdt p_paddr, low
+ *                       water 0x86300000) - only ever used to compute offsets;
+ *   K60_ADSP_BOARD_BASE the board carveout those bytes must land in
+ *                       (adsp_region@0x9fd00000, span 0x3100000, measured from
+ *                       the live FDT; see docs/research/battery/EXPERIMENT-20261117.md).
+ * 0x86300000 is the pong SM8475 carveout. Copying there on K60 writes into
+ * another subsystem's reserved memory and hand the DSP the wrong image.
+ */
+
+#include "pong_adsp_image.h"
+
+/* Distance of a link address from the start of the image. */
+static uint64_t
+offset_of(uint32_t paddr)
+{
+    return (uint64_t)paddr - (uint64_t)K60_ADSP_LINK_BASE;
+}
+
+static bool
+in_window(uint32_t paddr, uint32_t bytes)
+{
+    if ((uint64_t)paddr < (uint64_t)K60_ADSP_LINK_BASE) {
+        return false;
+    }
+    return offset_of(paddr) + bytes <= (uint64_t)K60_ADSP_WINDOW;
+}
+
+int
+k60_adsp_plan_at(K60AdspPlan *plan, uint32_t board_base)
+{
+    if (!plan || (board_base & 0xfffu) != 0) {
+        return K60AdspBadArg;
+    }
+    uint32_t copied = 0, zeroed = 0;
+    uint32_t prev_end = 0;
+
+    for (uint32_t i = 0; i < K60_ADSP_SEGMENTS; i++) {
+        const K60AdspSegment *s = &k60_adsp_segments[i];
+
+        if (!s->bytes && !s->bss) {
+            return K60AdspBadSegment;      /* an all-empty row hides a table bug */
+        }
+        if (s->bytes && !s->part) {
+            return K60AdspBadSegment;      /* bytes but nothing to read them from */
+        }
+        if (!in_window(s->paddr, s->bytes + s->bss)) {
+            return K60AdspOutsideWindow;
+        }
+        if (i && s->paddr < prev_end) {
+            return K60AdspOverlap;
+        }
+        prev_end = s->paddr + s->bytes + s->bss;
+        copied += s->bytes;
+        zeroed += s->bss;
+    }
+
+    plan->base = board_base;
+    plan->window = K60_ADSP_WINDOW;
+    plan->segments = K60_ADSP_SEGMENTS;
+    plan->copied = copied;
+    plan->zeroed = zeroed;
+    return 0;
+}
+
+int
+k60_adsp_plan(K60AdspPlan *plan)
+{
+    return k60_adsp_plan_at(plan, K60_ADSP_BOARD_BASE);
+}
+
+int
+k60_adsp_copy(void *window, size_t window_bytes, K60AdspRead read)
+{
+    if (!window || !read || window_bytes < K60_ADSP_WINDOW) {
+        return K60AdspBadArg;
+    }
+    uint8_t *dst = window;
+
+    for (uint32_t i = 0; i < K60_ADSP_SEGMENTS; i++) {
+        const K60AdspSegment *s = &k60_adsp_segments[i];
+        uint8_t *at = dst + offset_of(s->paddr);
+
+        /* Byte copy, never page copy: adsp.b10 loads at 0x86e0b2c0. */
+        if (s->bytes) {
+            int rc = read(s->part, at, s->bytes);
+            if (rc != 0) {
+                return K60AdspReadFailed;
+            }
+        }
+        for (uint32_t z = 0; z < s->bss; z++) {
+            at[s->bytes + z] = 0;
+        }
+    }
+    return 0;
+}
diff --git a/bsd/dev/pong_adsp_image.h b/bsd/dev/pong_adsp_image.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_adsp_image.h
@@ -0,0 +1,55 @@
+/* Contract for the ADSP PAS image loader (see K60AdspImage.c). */
+
+#ifndef K60_ADSP_IMAGE_H
+#define K60_ADSP_IMAGE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    K60AdspBadArg = -1,
+    K60AdspBadSegment = -2,
+    K60AdspOutsideWindow = -3,
+    K60AdspOverlap = -4,
+    K60AdspReadFailed = -5, /* partial/exact-size failure */
+    K60AdspPartMissing = -6, /* reader source/name absent */
+    K60AdspReadBounds = -7, /* reader container/range invalid */
+    K60AdspMismatch = -9, /* read-back differs from the firmware file */
+};
+
+typedef struct {
+    uint32_t paddr; /* firmware LINK address (adsp.mdt p_paddr) */
+    uint32_t bytes;
+    uint32_t bss;
+    const char *part;
+} K60AdspSegment;
+
+#include "pong_adsp_table.h" /* needs K60AdspSegment, declared above */
+
+typedef struct {
+    uint32_t base; /* BOARD carveout the bytes are copied to */
+    uint32_t window;
+    uint32_t segments;
+    uint32_t copied;
+    uint32_t zeroed;
+} K60AdspPlan;
+
+/* read(part, dst, bytes) fills dst from the named firmware file; 0 on success. */
+#ifndef K60_ADSP_READ_TYPE_DEFINED
+#define K60_ADSP_READ_TYPE_DEFINED
+typedef int (*K60AdspRead)(const char *part, void *dst, uint32_t bytes);
+#endif
+
+/* Validates the table only; no allocation, no device access. */
+int k60_adsp_plan(K60AdspPlan *plan);
+
+/* Same, for an explicit destination: board_base must be 4 KiB aligned.
+ * K60_ADSP_LINK_BASE is where the firmware was linked, never where it runs;
+ * segment paddr keeps its link value and is relocated on copy. */
+int k60_adsp_plan_at(K60AdspPlan *plan, uint32_t board_base);
+
+/* Copies every segment and zeroes every bss tail. window is the PAS carveout. */
+int k60_adsp_copy(void *window, size_t window_bytes, K60AdspRead read);
+
+#endif /* K60_ADSP_IMAGE_H */
diff --git a/bsd/dev/pong_adsp_table.h b/bsd/dev/pong_adsp_table.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_adsp_table.h
@@ -0,0 +1,38 @@
+/* Generated by scripts/gen-adsp-table.py from the shipped adsp.mdt. Do not edit. */
+/* Rows use K60AdspSegment from K60AdspImage.h. */
+/* The table carries the firmware's LINK addresses (adsp.mdt p_paddr); the
+ * loader copies segment i to BOARD_BASE + (paddr - LINK_BASE). 0x86300000 is
+ * the pong SM8475 carveout, never K60's: the live FDT reserves
+ * adsp_region@0x9fd00000 with span 0x3100000. */
+#define K60_ADSP_LINK_BASE 0x86300000UL
+#define K60_ADSP_BOARD_BASE 0x9fd00000UL
+#define K60_ADSP_WINDOW 0x03100000UL
+#define K60_ADSP_SEGMENTS 24
+
+static const K60AdspSegment k60_adsp_segments[K60_ADSP_SEGMENTS] = {
+    { 0x86300000UL,     6952,     1240, "adsp.b01" }, /* segment 1 */
+    { 0x86302000UL,  3216484,     2972, "adsp.b02" }, /* segment 2 */
