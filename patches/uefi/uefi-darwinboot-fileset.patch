-        Segment->Size = U64 (Data + Offset + 32);
-        Segment->FileOffset = U64 (Data + Offset + 40);
-        Segment->FileSize = U64 (Data + Offset + 48);
-        Segment->Protection = U32 (Data + Offset + 60);
+        Segment->Address = U64 (Header + Offset + 24);
+        Segment->Size = U64 (Header + Offset + 32);
+        Segment->FileOffset = U64 (Header + Offset + 40);
+        Segment->FileSize = U64 (Header + Offset + 48);
+        Segment->Protection = U32 (Header + Offset + 60);
         if ((Segment->Size > WINDOW_SIZE) || (Segment->Address > MAX_UINT64 - Segment->Size) ||
             (Segment->FileSize > Segment->Size) || (Segment->FileOffset > Size) ||
             (Segment->FileSize > Size - Segment->FileOffset)) { return EFI_LOAD_ERROR; }
       }
     } else if (Command == 5) {
-      if (HasEntry || (Length != 288) || (U32 (Data + Offset + 8) != 6) ||
-          (U32 (Data + Offset + 12) != 68)) { return EFI_LOAD_ERROR; }
-      Kernel->Entry = U64 (Data + Offset + 272);
+      if (HasEntry || (Length != 288) || (U32 (Header + Offset + 8) != 6) ||
+          (U32 (Header + Offset + 12) != 68)) { return EFI_LOAD_ERROR; }
+      Kernel->Entry = U64 (Header + Offset + 272);
       HasEntry = TRUE;
     }
     Offset += Length;
@@ -191,6 +249,15 @@ ParseKernel (CONST UINT8 *Data, UINTN Size, KERNEL *Kernel)
           (Kernel->Segments[Other].Address < Segment->Address + Segment->Size)) { return EFI_LOAD_ERROR; }
     }
   }
+  if (Fileset) {
+    /*
+     * XNU reads the outer MH_FILESET header at VM_KERNEL_LINK_ADDRESS (the
+     * kernel's hardcoded link address) when the inner header carries
+     * MH_DYLIB_IN_CACHE. The window therefore starts at the link address and
