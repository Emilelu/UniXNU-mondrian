diff --git a/iokit/Kernel/MiniBluetooth.cpp b/iokit/Kernel/MiniBluetooth.cpp
new file mode 100644
index 0000000..9c10292
--- /dev/null
+++ b/iokit/Kernel/MiniBluetooth.cpp
@@ -0,0 +1,164 @@
+/*
+ * Bluetooth publication for the Pong port.
+ *
+ * bluetoothd on this build looks for a device-tree child of /arm-io whose
+ * device_type is "bluetooth", and for an IOService carrying the same name.
+ * When neither exists it prints "No bluetooth on this device" and gives up,
+ * which is exactly what the K60 console shows today.  This file publishes
+ * both and stamps the stable local address that bsd/dev/qbt_k60.c derives
+ * from /chosen/unique-chip-id.
+ *
+ * Everything is gated on the k60bt boot argument, so booting the same image
+ * without it leaves the registry exactly as it is today.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#include <IOKit/IOService.h>
+
+#if !defined(XNU_K60_BT_PUBLISH)
+#define XNU_K60_BT_PUBLISH 1
+#endif
+
+#if defined(PONG) && (DEVELOPMENT || DEBUG) && !SECURE_KERNEL && XNU_K60_BT_PUBLISH
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOKitKeys.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+extern "C" int k60_bt_local_address(uint8_t address[6]);
+
+#define K60_BT_TRANSPORT_ENCODING 1u
+#define K60_BT_TRANSPORT_SPEED    3200000u
+
+class K60BluetoothRadio : public IOService
+{
+	OSDeclareDefaultStructors(K60BluetoothRadio);
+
+public:
+	bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(K60BluetoothRadio, IOService);
+
+bool
+K60BluetoothRadio::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	return true;
+}
+
+/* Device-tree integers are raw little-endian bytes; publish them the same way. */
+static void
+k60_bt_number_property(IORegistryEntry * entry, const char * key, uint32_t value)
+{
+	entry->setProperty(key, &value, sizeof(value));
+}
+
+/* /arm-io/bluetooth, created when the device tree does not carry it yet. */
+static IORegistryEntry *
+k60_bt_node(IORegistryEntry * armio)
+{
+	IORegistryEntry * node = IORegistryEntry::fromPath("/arm-io/bluetooth", gIODTPlane);
+
+	if (node != NULL) {
+		return node;
+	}
+	node = OSTypeAlloc(IORegistryEntry);
+	if (node == NULL) {
+		return NULL;
+	}
+	if (!node->init()) {
+		node->release();
+		return NULL;
+	}
+	node->setName("bluetooth");
+	node->setProperty("device_type", "bluetooth");
+	node->setProperty("compatible", "qcom,wcn7850-bt");
+	node->setProperty("unixnu,adt-name", "bluetooth");
+	k60_bt_number_property(node, "transport-encoding", K60_BT_TRANSPORT_ENCODING);
+	k60_bt_number_property(node, "transport-speed", K60_BT_TRANSPORT_SPEED);
+	if (!node->attachToParent(armio, gIODTPlane)) {
+		node->release();
+		return NULL;
+	}
+	return node;
+}
+
+void
+MiniBluetoothPublishStub(IOService * provider)
+{
+	static bool published;
+	uint32_t enabled = 0;
+	uint8_t address[6];
+	IORegistryEntry * armio;
+	IORegistryEntry * node;
+	IORegistryEntry * chosen;
+	K60BluetoothRadio * radio;
+	int error;
+
+	if (published) {
+		return;
+	}
+	if (!PE_parse_boot_argn("k60bt", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	error = k60_bt_local_address(address);
+	if (error != 0) {
+		IOLog("K60 BT: no platform identity (%d); bluetooth not published\n", error);
+		return;
+	}
+	armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	if (armio == NULL) {
+		IOLog("K60 BT: no /arm-io node; bluetooth not published\n");
+		return;
+	}
+	node = k60_bt_node(armio);
+	if (node == NULL) {
+		IOLog("K60 BT: could not create /arm-io/bluetooth\n");
+		armio->release();
+		return;
+	}
+	node->setProperty("local-mac-address", address, sizeof(address));
+	chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (chosen != NULL) {
+		chosen->setProperty("mac-address-bluetooth0", address, sizeof(address));
+		chosen->release();
+	}
+	radio = OSTypeAlloc(K60BluetoothRadio);
+	if (radio != NULL && radio->init()) {
+		radio->setName("bluetooth");
+		radio->setProperty("device_type", "bluetooth");
+		k60_bt_number_property(radio, "transport-encoding", K60_BT_TRANSPORT_ENCODING);
+		k60_bt_number_property(radio, "transport-speed", K60_BT_TRANSPORT_SPEED);
+		radio->setProperty("local-mac-address", address, sizeof(address));
+		if (radio->attach(provider) && radio->start(provider)) {
+			published = true;
+		} else {
+			radio->release();
+		}
+	} else if (radio != NULL) {
+		radio->release();
+	}
+	node->release();
+	armio->release();
+	IOLog("K60 BT: %s local address %02x:%02x:%02x:%02x:%02x:%02x\n",
+	    published ? "published" : "failed to publish",
+	    address[0], address[1], address[2], address[3], address[4], address[5]);
+}
+
+#else /* !(PONG && development && XNU_K60_BT_PUBLISH) */
+
+void
+MiniBluetoothPublishStub(IOService * provider)
+{
+	(void)provider;
+}
+
+#endif /* PONG && development && XNU_K60_BT_PUBLISH */
