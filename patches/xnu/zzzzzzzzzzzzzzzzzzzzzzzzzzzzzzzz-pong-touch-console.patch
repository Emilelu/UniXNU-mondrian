+								}   /* end of !minimal COORD-MODE */
+							}
+							/* Give the scan engine time to calibrate the new config. */
+							sleep_ms(300);
+						}   /* closes if (off == CFG_LEN && bad == 0); CFG-RESET ran inside */
+					}       /* closes else (!k60_touch_minimal): the whole config path */
+					}
+				}
+				}   /* close the CFG-START block */
+			}
+		}
+	}
+    /* Pong vendor misc ABI: +48 header, +50 point size, +52/+54 real axes. */
+    if (offset+56+2 > length || le16(info+offset+48)!=8 || le16(info+offset+50)!=8) return false;
+    uint16_t x=le16(info+offset+52), y=le16(info+offset+54);
+    if (x && y) { max_x=x;max_y=y; }
+	printf("goodix: touch report at %#x, coordinates up to %u x %u\n", touch_address, max_x, max_y);
+	/*
+	 * K60_MISC_DUMP: show the raw misc block so the 0x10308 derivation can be
+	 * checked byte by byte. The frame area reads back as static non-zero data
+	 * (00 94 b7 56 4b b4 ce ba, six identical samples), which cannot be a live
+	 * frame: an idle frame is all zeros. Either the address is derived wrong or
+	 * the frame lives somewhere else.
+	 */
+	{
+		printf("goodix: IC_INFO length=%u lists-end offset=%u\n", length, offset);
+		for (uint32_t i = 0; i + 16 <= 64 && offset + i + 16 <= length; i += 16) {
+			printf("goodix: misc+%02u..%02u %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    i, i + 15,
+			    info[offset + i + 0], info[offset + i + 1], info[offset + i + 2], info[offset + i + 3],
+			    info[offset + i + 4], info[offset + i + 5], info[offset + i + 6], info[offset + i + 7],
+			    info[offset + i + 8], info[offset + i + 9], info[offset + i + 10], info[offset + i + 11],
+			    info[offset + i + 12], info[offset + i + 13], info[offset + i + 14], info[offset + i + 15]);
+		}
+	}
+	/* K60_FRAME_HUNT: baseline snapshot right after the controller is known good. */
+	hunt_compare(false);
+	return touch_address != 0;
+}
+
+/* What has been seen so far: said once a minute, so that the end of the log always tells. */
+static struct {
+	uint32_t polls, reports, touches, bad, last_x, last_y;
+} seen;
+
+/* Which fingers were down in the last report, and where. */
+static struct {
+	bool down, seen;
+	uint32_t x, y;
+} contact[GOODIX_MAX_TOUCHES];
+static uint32_t flip;           /* boot-arg touch_flip: 1 = mirror left-right, 2 = mirror top-bottom */
+
+static void
+goodix_report(const uint8_t *touches, uint32_t count)
+{
+	static unsigned shown;
+
+	for (int i = 0; i < GOODIX_MAX_TOUCHES; i++) {
+		contact[i].seen = false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		const uint8_t *t = touches + 8 * i;
+		uint32_t id = t[0] >> 4, kind = t[0] & 0xf;
+		uint32_t x = le16(t + 2), y = le16(t + 4);
+
+		if (id >= GOODIX_MAX_TOUCHES || kind == 1 || kind == 3) {       /* 1 and 3: a stylus */
+			continue;
+		}
+		if (shown < 4) {
+			shown++;
+			printf("goodix: finger %u at %u, %u (of %u x %u)\n", id, x, y, max_x, max_y);
+		}
+		seen.touches++;
+		seen.last_x = x;
+		seen.last_y = y;
+		x = x >= max_x ? 65535 : x * 65535 / max_x;
+		y = y >= max_y ? 65535 : y * 65535 / max_y;
+		if (flip & 1) {
+			x = 65535 - x;
+		}
+		if (flip & 2) {
+			y = 65535 - y;
+		}
+		contact[id].seen = true;
+		if (!contact[id].down) {
+			pong_touch_post(PONG_TOUCH_DOWN, id, x, y);
+		} else if (contact[id].x != x || contact[id].y != y) {
+			pong_touch_post(PONG_TOUCH_MOVE, id, x, y);
+		}
+		contact[id].down = true;
+		contact[id].x = x;
+		contact[id].y = y;
+	}
+	/* a finger that is no longer in the report has lifted */
+	for (uint32_t id = 0; id < GOODIX_MAX_TOUCHES; id++) {
+		if (contact[id].down && !contact[id].seen) {
+			contact[id].down = false;
+			pong_touch_post(PONG_TOUCH_UP, id, contact[id].x, contact[id].y);
+		}
+	}
+}
+
+/* Read the report if there is one, and tell the chip it has been read. */
+static void
+goodix_poll(unsigned int_at_entry)
+{
+	static uint8_t report[8 + 8 * GOODIX_MAX_TOUCHES + 2];
+	/*
+	 * K60_ALT_FRAME: 0x10400 is the only block that carries 0x80 in byte 0 and
+	 * advances monotonically (0x0b -> ... -> 0xe7 -> 0x10 0x01 -> ...), so it is
+	 * the live working area; 0x10308 returns a static 00 94 b7 ... and never
+	 * moves. Dump the first 16 bytes of 0x10400 while a touch is sensed so the
+	 * coordinate fields can be identified instead of guessed.
+	 */
+	{
+		uint8_t alt[8];
+
+		if (k60_touch_diag >= 2 && !gpio_get(PIN_INT) &&
+		    goodix_read(0x10400u, alt, sizeof(alt))) {
+			printf("goodix: ALT10400 int=0 %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    alt[0], alt[1], alt[2], alt[3], alt[4], alt[5], alt[6], alt[7]);
+		}
+	}
+	static unsigned bad;
+	const uint8_t zero = 0;
+	const uint32_t first = 8 + 8 * 2 + 2;           /* the header and two fingers: all there is, most of the time */
+	uint32_t count;
+
+	seen.polls++;
+	/*
+	 * K60_POLL_DIAG: separate the two silent failure modes and dump the raw
+	 * header while INT is low, so a read that returns all zeros can be told
+	 * apart from a read that fails outright.
+	 */
+	/*
+	 * K60_FRAME_DIAG: the frame area reads back as static non-zero data
+	 * (00 94 b7 56 4b b4 ce ba, identical on six consecutive samples). An idle
+	 * frame is all zeros, so that content cannot be a frame at all -- either the
+	 * address is wrong or the bytes are misaligned on the wire.
+	 *
+	 * While INT is low (the chip says it has something) dump:
+	 *   - the whole 34-byte wire image, so a byte shift is visible
+	 *   - 0x10300 for 32 bytes, in case the frame sits at a nearby offset
+	 *   - whether consecutive samples differ at all
+	 */
+	{
+		static unsigned read_fail, header_zero, dumped;
+		static uint8_t prev[8];
+		static bool have_prev;
+		bool ok = goodix_read(touch_address, report, first);
+		/*
+		 * Use the level the caller saw when it decided to read: the pulse is
+		 * long gone by the time the transfer finishes, so re-reading here made
+		 * every "INT was low" branch dead code.
+		 */
+		bool int_low = int_at_entry == 0;
+
+		if (!ok) {
+			if (read_fail++ < 6) {
+				printf("goodix: READ FAIL addr=%#x len=%u int=%u\n",
+				    touch_address, first, gpio_get(PIN_INT));
+			}
+			return;
+		}
+		if (int_low && dumped < 8) {
+			dumped++;
+			printf("goodix: WIRE[34] ");
+			for (unsigned w = 0; w < 34 && w < 8 + first; w++) {
+				printf("%02x ", spi_rx[w]);
+			}
+			printf("\n");
+			printf("goodix: DATA     ");
+			for (unsigned d = 0; d < 8; d++) {
+				printf("%02x ", report[d]);
+			}
+			printf("  event=%02x touch_num=%u sum=%04x stored=%04x\n",
+			    report[0], report[2] & 0x0fu,
+			    (unsigned)((report[0] + report[1] + report[2] + report[3] +
+			        report[4] + report[5]) & 0xffffu),
+			    (unsigned)(report[6] | (report[7] << 8)));
+			if (have_prev) {
+				printf("goodix: CHANGED  %s\n",
+				    memcmp(prev, report, 8) ? "yes" : "NO (static)");
+			}
+			memcpy(prev, report, 8);
+			have_prev = true;
+			/* Nearby window: is the live frame at a different offset? */
+			{
+				static uint8_t near[32];
+				if (goodix_read(0x10300u, near, 32)) {
+					printf("goodix: @10300  ");
+					for (unsigned n = 0; n < 32; n++) {
+						printf("%02x ", near[n]);
+					}
+					printf("\n");
+				}
+			}
+		}
+		if (report[0] == 0) {
+			/*
+			 * K60_INT_LOW_DUMP: the one measurement never taken.
+			 *
+			 * Every dump so far printed int=1 because this branch was rate
+			 * limited to the first two occurrences, and those happened while
+			 * nothing was touching the panel. So there is no record anywhere
+			 * of what 0x10308 returns at the moment INT actually goes low --
+			 * which is the only moment a report can exist.
+			 *
+			 * Capture exactly that: when INT is low, read 64 bytes from
+			 * touch_address and print them all, up to 16 times. If the first
+			 * byte is still zero at INT-low, then 0x10308 is not the report
+			 * area no matter what the struct offset said, and the 64 bytes
+			 * will show where the live data actually starts.
+			 */
+			const unsigned int_low = (unsigned)gpio_get(PIN_INT) == 0;
+			static unsigned int_low_dumps;
+			if (int_low && int_low_dumps < 8) {
+				/*
+				 * K60_ROTATE_WINDOW: one 2 KiB window was not enough.
+				 *
+				 * With the full config applied the chip interrupted 196 times
+				 * and 564 bytes moved, but they all sat in the frame-data area
+				 * (0x10400+) and around fw_state (0x10218). 0x10308 stayed
+				 * 0x00. So the report is either not at touch_data_addr or it
+				 * lives further out -- 0x10cf4 and 0x13c40 both decode as
+				 * plausible addresses from the same ic_info block.
+				 *
+				 * Cover 0x10000..0x13FFF: eight 2 KiB chunks, one chunk per
+				 * INT-low sample, cycling. Each chunk keeps its own baseline,
+				 * so the second visit to a chunk is a real diff. 196 samples
+				 * give every chunk ~24 comparisons.
+				 */
+				static uint8_t ring[8 * 2048];
+				static uint8_t tmp[2048];
+				static uint8_t have[8];
+				unsigned chunk, got = 0, changed = 0;
+				unsigned n;
+				int_low_dumps++;
+				chunk = int_low_dumps & 7u;
+				while (got < sizeof(tmp)) {
+					unsigned len = sizeof(tmp) - got;
+					if (len > GOODIX_MAX_READ) {
+						len = GOODIX_MAX_READ;
+					}
+					if (!goodix_read(0x10000u + chunk * 2048u + got,
+					    tmp + got, len)) {
+						break;
+					}
+					got += len;
+				}
+				/*
+				 * K60_BERLIN_D_FRAME: Berlin-D publishes events in the FRAME
+				 * area, not in touch_data.
+				 *
+				 * The official reader for this chip family is
+				 * goodix_brl_hw.c:1238 brld_get_framedata() -- the "brld"
+				 * prefix is Berlin-D -- and it works from
+				 * misc->frame_data_addr, with misc->frame_data_head_len as the
+				 * header size. On this chip the packed misc block decodes to
+				 * frame_data_addr = 0x10400 / head_len = 16, while
+				 * touch_data_addr = 0x10308 / head_len = 8.
+				 *
+				 * Everything measured agrees with the frame path and not the
+				 * touch path: 0x10308 holds the same eight bytes on every read
+				 * (a counter that changes only between boots), while the
+				 * 0x10400 region showed 551..1315 bytes moving per sample. So
+				 * dump the first 32 frame bytes on every INT-low and look for
+				 * GOODIX_TOUCH_EVENT (0x80) in byte 0.
+				 */
+				if (int_low_dumps <= 8) {
+					uint8_t fr[32];
+					uint8_t tt[32];
+					/* The measurement never taken: what does the touch area
+					 * itself return at the exact moment INT is low, while the
+					 * config is applied and the scan engine is running? */
+					if (goodix_read(touch_address, tt, sizeof(tt))) {
+						unsigned q;
+						printf("goodix: TOUCH@INTLOW");
+						for (q = 0; q < sizeof(tt); q++) {
+							printf(" %02x", tt[q]);
+						}
+						printf("\n");
+					}
+					if (goodix_read(0x10400u, fr, sizeof(fr))) {
+						unsigned q;
+						printf("goodix: FRAME%s int=%u",
+						    (fr[0] & 0x80) ? "-EVENT" : "",
+						    (unsigned)gpio_get(PIN_INT));
+						for (q = 0; q < sizeof(fr); q++) {
+							printf(" %02x", fr[q]);
+						}
+						printf("\n");
+					} else {
+						printf("goodix: FRAME read failed\n");
+					}
+				}
+				if (got == sizeof(tmp)) {
+					uint8_t *base_win = ring + chunk * 2048u;
+					if (have[chunk]) {
+						unsigned page[32] = { 0 };
+						for (n = 0; n < sizeof(tmp); n++) {
+							if (tmp[n] != base_win[n]) {
+								page[n >> 6]++;
+								if (changed < 4) {
+									printf("goodix: WDIFF %#x %02x->%02x\n",
+									    0x10000u + chunk * 2048u + n,
+									    base_win[n], tmp[n]);
+								}
+								changed++;
+							}
+						}
+						printf("goodix: WDIFF#%u chunk=%u %#x changed=%u pages:",
+						    int_low_dumps, chunk,
+						    0x10000u + chunk * 2048u, changed);
+						for (n = 0; n < 32; n++) {
+							if (page[n]) {
+								printf(" +%#x/%u",
+								    (n << 6), page[n]);
+							}
+						}
+						printf("\n");
+					} else {
+						printf("goodix: WDIFF#%u chunk=%u baseline @%#x=%02x\n",
+						    int_low_dumps, chunk,
+						    0x10000u + chunk * 2048u + 0x308u,
+						    tmp[0x308]);
+					}
+					memcpy(base_win, tmp, sizeof(tmp));
+					have[chunk] = 1;
+				}
+			} else if (header_zero++ < 2) {
+				printf("goodix: HEADER ZERO addr=%#x int=%u bytes=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    touch_address, gpio_get(PIN_INT),
+				    report[0], report[1], report[2], report[3],
+				    report[4], report[5], report[6], report[7]);
+			}
+			return;
+		}
+	}
+	seen.reports++;
+	count = report[2] & 0xf;
+	if ((report[0] & GOODIX_STATUS_TOUCH) && count > 2 && count <= GOODIX_MAX_TOUCHES &&
+	    !goodix_read(touch_address + 8, report + 8, 8 * count + 2)) {
+		return;
+	}
+	goodix_write(touch_address, &zero, 1);
+	if (!goodix_checksum_ok(report, 8)) {
+		seen.bad++;
+		if (bad++ < 3 && k60_touch_diag >= 2) {
+			printf("goodix: bad report header: %02x %02x %02x %02x %02x %02x %02x %02x\n", report[0], report[1],
+			    report[2], report[3], report[4], report[5], report[6], report[7]);
+		}
+		return;
+	}
+	if (report[0] & GOODIX_STATUS_REQUEST) {
+		if ((report[2] & 0xf) == GOODIX_REQUEST_RESET || report[2] == GOODIX_REQUEST_RESET) {
+			printf("goodix: the chip asks to be reset\n");
+			touch_reset();
+		}
+		return;
+	}
+	if (!(report[0] & GOODIX_STATUS_TOUCH)) {
+		return;
+	}
+	if (count > GOODIX_MAX_TOUCHES || (count && !goodix_checksum_ok(report + 8, count * 8 + 2))) {
+		seen.bad++;
+		if (bad++ < 8) {
+			printf("goodix: bad report (%u touches)\n", count);
+		}
+		return;
+	}
+	goodix_report(report + 8, count);
+}
+
+
+/* No firmware upload, FocalTech strap scan, GPU or other Redwood subsystem. */
+static bool
+bring_up(void)
+{
+    printf("Pong touch: DIAG bring_up entry stage=%u\n", touch_stage);
+    if (touch_stage == 8) { k60_spmi_probe(); return false; }
+    if (touch_stage == 9) { k60_miso_float_test(); return false; }
+    if (touch_stage == 20) { k60_stage20_elec(); return false; }
+    if (touch_stage == 21) { k60_stage21_pmic(); return false; }
+    if (touch_stage == 22) { k60_stage22_ldo(); return false; }
+    if (touch_stage == 23) { k60_stage23_ldoscan(); return false; }
+    if (touch_stage == 19) {
+        printf("Pong touch: stage19 GENI + power\n");
+        /* K60_STAGE19_READY: fall through into the polling loop when the
+         * controller answered; otherwise the thread terminates and no event is
+         * ever read even though dev_confirm and probe both printed OK. */
+        return k60_stage19_geni_power();
+    }
+    if (touch_stage == 18) {
+        printf("Pong touch: stage18 switch + permutation\n");
+        k60_stage18_permute();
+        return false;
+    }
+    if (touch_stage == 17) {
+        printf("Pong touch: stage17 SPI mode switch\n");
+        k60_stage17_spi_switch();
+        return false;
+    }
+    if (touch_stage == 16) {
+        printf("Pong touch: stage16 GTP version read\n");
+        k60_stage16_gtp_version();
+        return false;
+    }
+    if (touch_stage == 15) {
+        printf("Pong touch: stage15 per-rail voltage test\n");
+        k60_stage15_rail_volt();
+        return false;
+    }
+    if (touch_stage == 14) {
+        printf("Pong touch: stage14 rail-set sweep\n");
+        k60_stage14_rail_sets();
+        return false;
+    }
+    if (touch_stage == 13) {
+        printf("Pong touch: stage13 power on + powered permutation sweep\n");
+        if (!io_supply_on()) { printf("Pong touch: stage13 supply FAILED\n"); return false; }
+        /* ruby section 3.3: reset low 10 ms -> high 100 ms. */
+        gpio_output(PIN_RESET, false, PULL_NONE, 6);
+        sleep_ms(10);
+        gpio_output(PIN_RESET, true, PULL_UP, 6);
+        sleep_ms(100);
+        printf("Pong touch: stage13 reset done int=%u\n", gpio_get(PIN_INT));
+        k60_stage13_permute();
+        return false;
+    }
+    if (touch_stage == 12) {
+        printf("Pong touch: stage12 pad/int/volt checks\n");
+        k60_stage12_checks();
+        return false;
+    }
+    if (touch_stage == 11) {
+        printf("Pong touch: stage11 supply + reset polarity sweep\n");
+        if (!io_supply_on()) { printf("Pong touch: stage11 supply FAILED\n"); return false; }
+        sleep_ms(5);
+        k60_reset_polarity_sweep();
+        return false;
+    }
+    if (touch_stage == 10) {
+        printf("Pong touch: stage10 rsc=%#lx cmd_db=%#lx\n",
+            (unsigned long)rsc, (unsigned long)cmd_db);
+        if (!io_supply_on()) { printf("Pong touch: stage10 supply FAILED\n"); return false; }
+        printf("Pong touch: stage10 supply OK; re-reading PMIC through SPMI\n");
+        k60_spmi_probe();
+        printf("Pong touch: stage10 PMIC re-read done\n");
+        /* The controller needs a real reset pulse after the rails come up:
+         * AVDD settled, RESET low 2 ms, RESET high, 4 ms before dev_confirm. */
+        printf("Pong touch: stage10 reset pulse\n");
+        /* ruby section 3.3: reset low 10 ms -> high 100 ms. */
+        gpio_output(PIN_RESET, false, PULL_NONE, 6);
+        sleep_ms(10);
+        gpio_output(PIN_RESET, true, PULL_UP, 6);
+        sleep_ms(100);
+        printf("Pong touch: stage10 reset done int=%u\n", gpio_get(PIN_INT));
+        /* Powered + out of reset: is anything actually driving the data lines? */
+        k60_miso_float_test();
+        spi_transfer = bitbang_transfer;
+        bitbang_in = 16u; bitbang_out = 17u; bitbang_init();
+        if (goodix_dev_confirm()) {
+            printf("Pong touch: stage10 DEV_CONFIRM OK -> touch rail is alive\n");
+            sleep_ms(100);
+            goodix_probe(true);
+        }
+        return false;
+    }
+    /* K60_S7_SKIP_GENI: stage 7 exists to exercise the bitbang fallback only.
+     * Skip the whole GENI block (clocks_on, engine init, 200 ms failing
+     * transfer) so the pins go straight to GPIO mode and no engine register is
+     * ever touched. */
+    if (touch_stage >= 7) {
+        printf("Pong touch: DIAG stage7 skips GENI, straight to bitbang\n");
+        goto bitbang_only;
+    }
+    gpio_output(PIN_RESET,true,PULL_UP,6);
+    gpio_configure(PIN_INT,0,PULL_UP,6,false);
+    printf("Pong touch: DIAG reset/irq pins done\n");
+    if (touch_stage < 3) {
+        printf("Pong touch: DIAG stop after GPIO (stage 2)\n");
+        return false;
+    }
+    if (clocks_on()) {
+        /* K60_PINORDER: sheng (TouchProbe.cpp:422-425) configures the four SPI
+         * pins BEFORE touching the engine. Doing it after geni_spi_init leaves
+         * the QUP mux pointing at the wrong function during engine setup. */
+        gpio_configure(PIN_MISO,1,PULL_NONE,6,false);
+        gpio_configure(PIN_MOSI,1,PULL_NONE,6,false);
+        gpio_configure(PIN_CLK,1,PULL_NONE,6,false);
+        gpio_configure(PIN_CS,1,PULL_NONE,6,false);
+        printf("Pong touch: DIAG spi pins muxed to qup4\n");
+        if (touch_stage < 5) {
+            printf("Pong touch: DIAG stop before the engine window (0x%llx)\n", se_phys);
+            return false;
+        }
+        printf("Pong touch: touching serial engine %#llx now\n",se_phys);
+        const char *problem=geni_spi_init(4000000);
+        if (!problem) {
+            if (goodix_probe(false)) return true;
+            if (touch_stage < 6) {
+                printf("Pong touch: DIAG stop before RPMh (stage 5)\n");
+                return false;
+            }
+            /* K60_STAGE7_ONLY: only stage 6 exercises the RPMh path. Stage 7
+             * is bitbang-only and must never call io_supply_on(): it writes
+             * TCS(rsc+0xd00+...) and rsc is 0 by HR-01 -> data abort. */
+            /* K60_P0: never call io_supply_on() on K60 (ldoc3/ldoc12 are the
+             * wrong rails and any RSC/TCS access kills the machine, HR-01). */
+            k60_touch_power_cycle();
+            if (!goodix_dev_confirm()) return false;
+            sleep_ms(100);
+            if (goodix_probe(true)) return true;
+        } else printf("Pong touch: GENI unavailable: %s; use GPIO SPI\n",problem);
+    }
+    if (touch_stage < 7) {
+        printf("Pong touch: DIAG stop before bitbang (stage %u)\n", touch_stage);
+        return false;
+    }
+    /* K60_BITBANG_ONLY: stage 7 skips GENI completely. io_supply_on() is NOT
+     * called here on purpose: it writes TCS(rsc+0xd00+...) and rsc is 0 by
+     * HR-01, so any call would take a data abort. The chip may already be
+     * powered by ABL; if not, the probe simply reads zeroes and fails safely. */
+bitbang_only:
+    printf("Pong touch: DIAG bitbang-only path (stage %u)\n", touch_stage);
+    gpio_output(PIN_RESET,true,PULL_UP,6);
+    gpio_configure(PIN_INT,0,PULL_UP,6,false);
+    /* K60_PIN_PERMUTE_BLOCK: the FDT fixes the pin SET (gpio16..19, function
+     * qup4) but not which is MISO/MOSI/CLK/CS. Try all 24 assignments and print
+     * the first four bytes each returns; the live chip answers on exactly one. */
+    /* K60_MISO17: the 24-way sweep showed MISO is GPIO 17 (only assignments
+     * with miso=17 returned 0xff instead of 0x00). Pulse RESET, then probe the
+     * six remaining MOSI/CLK/CS assignments over {16,18,19}. */
+    printf("Pong touch: P0 power cycle (AVDD gpio71, RESET pulse)\n");
+    k60_touch_power_cycle();
+    printf("Pong touch: P0 power done int_pin=%u\n", gpio_get(PIN_INT));
+    {
+        static const unsigned rest[3] = {16u, 18u, 19u};
+        static const uint8_t zero[4] = {0, 0, 0, 0};
+        unsigned n = 0;
+        for (unsigned b = 0; b < 3; b++)
+        for (unsigned c = 0; c < 3; c++) {
+            if (c == b) continue;
+            for (unsigned d = 0; d < 3; d++) {
+                uint8_t probe[4] = {0, 0, 0, 0};
+                if (d == b || d == c) continue;
+                bitbang_in = 17u;
+                bitbang_out = rest[b];
+                bitbang_clk = rest[c];
+                bitbang_cs = rest[d];
+                bitbang_init();
+                bitbang_transfer(zero, probe, 4);
+                printf("Pong touch: M17[%u] miso=17 mosi=%u clk=%u cs=%u b=%02x %02x %02x %02x\n",
+                    n, rest[b], rest[c], rest[d], probe[0], probe[1], probe[2], probe[3]);
+                n++;
+            }
+        }
+        bitbang_clk = PIN_CLK;
+        bitbang_cs = PIN_CS;
+    }
+    /* Only the two known data pins can exchange direction; no arbitrary scan. */
+    spi_transfer=bitbang_transfer;
+    /* K60_P0_DEV_CONFIRM: mandatory Berlin-D handshake before any real read. */
+    if (!goodix_dev_confirm()) return false;
+    sleep_ms(100);
+    /* K60_BB_DIAG: PIN_INT is a pull-up input. A powered controller drives it
+     * low after reset; a floating (unpowered) chip leaves it high. This is the
+     * cheapest way to tell "no reply because unpowered" from "wrong SPI mode". */
+    printf("Pong touch: BBDIAG int_pin=%u reset_pin=%u pins=%u,%u,%u,%u\n",
+        gpio_get(PIN_INT), 1u, pins[0], pins[1], pins[2], pins[3]);
+    for (unsigned attempt=0;attempt<2;attempt++) {
+        bitbang_in=pins[attempt];bitbang_out=pins[1-attempt];bitbang_init();
+        printf("Pong touch: BBDIAG attempt=%u in=%u out=%u\n", attempt, bitbang_in, bitbang_out);
+        if (goodix_probe(true)) return true;
+        if (attempt==0 && touch_stage == 6 && io_supply_on()) {touch_reset();if (goodix_probe(true)) return true;}
+    }
+    return false;
+}
+
+static void
+touch_thread(__unused void *parameter, __unused wait_result_t result)
+{
+    printf("Pong touch: DIAG thread entered stage=%u\n", touch_stage);
+    {
+        int delay_ms = 0;
+        if (PE_parse_boot_argn("k60_touch_delay", &delay_ms, sizeof(delay_ms)) && delay_ms > 0) {
+            if (delay_ms > 60000) delay_ms = 60000;
+            printf("Pong touch: delaying %d ms so the console is up\n", delay_ms);
+            sleep_ms((unsigned)delay_ms);
+            printf("Pong touch: delay done\n");
+        }
+    }
+    /* K60_STAGE0: with stage 0 there is nothing to do at all. Returning here
+     * separates "the thread itself is the problem" from "any map or GPIO is". */
+    if (touch_stage == 0) {
+        printf("Pong touch: DIAG stage0 thread alive, returning\n");
+        thread_terminate(current_thread());
+        return;
+    }
+    /* base the tiny TLMM window on gpio_offset (0x100000), not on TLMM_PHYS */
+    tlmm=ml_io_map(TLMM_PHYS+gpio_offset,TLMM_SIZE)-gpio_offset;
+    gcc=ml_io_map(GCC_PHYS,GCC_SIZE);
+    printf("Pong touch: DIAG mapped tlmm=%#llx gcc=%#llx\n",
+        (unsigned long long)tlmm, (unsigned long long)gcc);
+    /* K60_NO_RSC: 0x17a20000 is the RSC "DRV 2" window. The project's own
+     * research (docs/research/touch/05-plan.md:9, findings 0246/0248) records
+     * that the FIRST read of its TCS kills the whole device. Do not map it.
+     * cmd_db is plain memory and stays mapped; rsc stays NULL on purpose. */
+    rsc = 0;
+    se=ml_io_map(SE_PHYS,SE_SIZE);
+    /* K60_QUP_NO_CONFIG_REGION: the QUP config region at +0x2000
+     * (SE_GENI_CLK_CTRL / SE_DMA_IF_EN / SE_FIFO_IF_DISABLE) is NOT implemented
+     * on this SoC's QUP. Both candidate bases take a kernel data abort:
+     *   se_phys + 0x2004      -> far = se + 0x2004
+     *   wrapper  + 0x2004     -> far = wrapper + 0x2004
+     * A data abort (rather than reading 0) means the address is unbacked, so
+     * these registers exist only on newer QUP revisions. Do not map or touch
+     * them here. */
+    /* Only the hardware-version register at +0x4 is read from the wrapper. The
+     * aborting address earlier was wrapper + 0x2004 (config-region page 2, not
+     * implemented); +0x4 lives in the first page that every QUP implements. */
+    wrapper_phys = QUPV3_0_WRAPPER_PHYS;
+    wrapper = ml_io_map(QUPV3_0_WRAPPER_PHYS, 0x1000);
+    /* K60_P0_RSC_MAP: rsc was declared but never mapped, so it stayed 0 and
+     * every TCS(rsc + 0xd00 + ...) access wrote to physical 0xd00, which is the
+     * data abort previously mis-read as "RSC is forbidden" (HR-01). */
+    rsc=ml_io_map(RSC_PHYS,RSC_SIZE);
+    if (!rsc) printf("Pong touch: RSC map failed (phys %#llx size %#lx)\n",
+        (unsigned long long)RSC_PHYS, (unsigned long)RSC_SIZE);
+    cmd_db=ml_io_map_wcomb(CMD_DB_PHYS,CMD_DB_SIZE);
+    printf("Pong touch: DIAG mapped se=%#llx rsc=%#llx cmd_db=%#llx\n",
+        (unsigned long long)se, (unsigned long long)rsc, (unsigned long long)cmd_db);
+    /* K60_SE_SMMU: the SE DMA master is an SMMU client. The touch SE hangs off the QUPV3_0
+     * wrapper, whose FDT stream is <&apps_smmu 0x5a3 0>, and Linux gives the engine a
+     * dma_map_single() IOVA (qcom-geni-se.c:708/760). Putting that stream into bypass makes
+     * the IOVA equal the physical address kvtophys() returns, so SE_DMA_*_PTR_L/H may carry
+     * it. This runs before bring_up() so the very first GENI transfer has a usable address. */
+    smmu=ml_io_map(APPS_SMMU_PHYS,APPS_SMMU_SIZE);
+    if (!smmu) {
+        printf("Pong touch: apps_smmu map failed (phys %#lx size %#lx)\n",
+            (unsigned long)APPS_SMMU_PHYS, (unsigned long)APPS_SMMU_SIZE);
+    } else {
+        /* Read-only first: the SMMU state before anything is written. Both the SID the FDT
+         * actually routes to the touch wrapper and the one earlier notes named are reported,
+         * so the log settles the attribution on hardware. */
+        smmu_report_sid("pre-touch", APPS_SMMU_TOUCH_SID);
+        smmu_report_sid("pre-bt", APPS_SMMU_BT_SID);
+        se_smmu_bypass = k60_se_smmu_bypass();
+        /* Read back: the SMR/S2CR/context the stream now has is the evidence it took. */
+        smmu_report_sid("post-touch", APPS_SMMU_TOUCH_SID);
+        smmu_report_sid("post-bt", APPS_SMMU_BT_SID);
+        printf("Pong touch: SMMU verdict sid=%#x bypass=%u\n", APPS_SMMU_TOUCH_SID,
+            se_smmu_bypass ? 1u : 0u);
+    }
+    if (touch_stage == 1) {
+        printf("Pong touch: DIAG stage1 maps ok, NOT calling bring_up\n");
+        thread_terminate(current_thread());
+        return;
+    }
+    if (!tlmm || !gcc || !se || !cmd_db || !bring_up()) {
+        printf("Pong touch: Goodix initialization failed; normal UI boot continues\n");
+        thread_terminate(current_thread());return;
+    }
+    if (!pong_touch_device_ready()) {thread_terminate(current_thread());return;}
+    /*
+     * K60_GOODIX_RESUME (from patches/xnu/zzzz...-pong-goodix-resume.patch,
+     * which exists in this repository but was never added to the series):
+     * Android or recovery can leave the controller in sleep or gesture mode,
+     * and every boot on this unit starts from Android. Reset the already
+     * identified Berlin controller and clear the report byte before polling.
+     */
+    {
+        const uint8_t clear = 0;
+        touch_reset();
+        if (!goodix_probe(true)) {
+            printf("Pong touch: resume probe failed; continuing\n");
+        } else if (!goodix_write(touch_address, &clear, 1)) {
+            printf("Pong touch: cannot acknowledge resumed report\n");
+        } else {
+            printf("Pong touch: resume sequence done (reset+probe+clear) addr=%#x\n",
+                touch_address);
+        }
+    }
+    /*
+     * K60_GTP_PROBE: the K60 touch controller answers the GTP register set,
+     * not the Berlin-D (BRL) one.
+     *
+     * Established 2026-11-10 02:55 from the live Android unit and recorded in
+     * docs/ANDROID-HW-TRUTH.md:10-16:
+     *     /sys/class/input/event7 -> goodix_ts        (the GTP driver)
+     *     DT compatible          -> xiaomi,m11a-spi
+     *     GTP registers: version 0x8140 (8 B), config checksum 0x8047,
+     *                    status 0x804E, buffer status 0x814E
+     * docs/BACKLOG.md:229 states it as P0-19: "touch protocol wrong:
+     * xiaomi,m11a-spi is GTP (goodix_ts), not Berlin-D (BRL); stages 8-15 all
+     * wrong". docs/HANDOFF.md:2097 repeats it.
+     *
+     * A whole day was spent on BRL because that note was never read before
+     * writing code. This probe makes the answer impossible to miss: it reads
+     * the four GTP registers on the already-working SPI and prints them, so
+     * one boot says whether the GTP entry point answers.
+     *
+     * GTP buffer status (0x814E): bit7 = data ready, low nibble = touch count.
+     * The point records start at 0x8150, eight bytes each. That is the classic
+     * Goodix GTP layout this driver should be speaking.
+     */
+    {
+        uint8_t g[8];
+        uint8_t one;
+        unsigned q;
+
+        if (goodix_read(0x8140u, g, sizeof(g))) {
+            printf("Pong touch: GTP 0x8140 id=");
+            for (q = 0; q < 4; q++) {
+                printf("%c", (g[q] >= 0x20 && g[q] < 0x7f) ? g[q] : '.');
+            }
+            printf(" fw=%02x%02x\\n", g[5], g[4]);
+        } else {
+            printf("Pong touch: GTP 0x8140 read failed\\n");
+        }
+        if (goodix_read(0x8047u, &one, 1)) {
+            printf("Pong touch: GTP 0x8047 config_version=%u\n", one);
+        }
+        if (goodix_read(0x804Eu, &one, 1)) {
+            printf("Pong touch: GTP 0x804E status=%u\n", one);
+        }
+        if (goodix_read(0x814Eu, &one, 1)) {
+            printf("Pong touch: GTP 0x814E buffer_status=%#x ready=%u points=%u\n",
+                one, (one & 0x80) ? 1u : 0u, one & 0x0f);
+        }
+    }
+    printf("Pong touch: Berlin-D ready, SPI 0x%llx GPIO reset=%u irq=%u, axes %ux%u\n",
+        se_phys,PIN_RESET,PIN_INT,max_x,max_y);
+    printf("Pong touch: POLL start int=%u addr=%#x\n", gpio_get(PIN_INT), touch_address);
+    unsigned idle=0, tick=0, hb_polls=0, hb_reports=0, hb_touches=0;
+    for (;;) {
+        /*
+         * K60_POLL_CADENCE: read the controller on a ~20 ms cadence, not every
+         * 2 ms.
+         *
+         * The previous code had "if (!int_now || ++idle >= 1)" with idle = 0,
+         * and ++idle is 1 on the first pass, so the condition was always true:
+         * the chip was read every 2 ms whether or not INT was low. That is the
+         * exact failure a sibling SM8475 port documented on real hardware
+         * (Seanding1998/hakios-xnu-kernel, docs/phk110/waves/wave12c-electrical.md):
+         * the controller emits one response block per CS frame and re-arms it
+         * on a ~20 ms cadence, so a read issued microseconds after the previous
+         * transaction lands inside the un-armed window and returns stale or
+         * shifted padding. Their log showed the identical shape -- a block that
+         * never changed across dozens of reads -- and the 20 ms cadence is what
+         * turned the probe green on the third boot.
+         *
+         * Keep an immediate read when INT is already low (a report is waiting),
+         * but when INT is high wait the full cadence before asking again.
+         */
+        unsigned int_now = gpio_get(PIN_INT);
+        if (!int_now) {
+            idle = 0;
+            goodix_poll(int_now);
+            sleep_ms(2);
+        } else {
+            sleep_ms(20);
+            idle = 0;
+            goodix_poll(int_now);
+        }
+        /*
+         * K60_TOUCH_HB: the poll path returns silently when the chip has nothing
+         * to say, so without a heartbeat there is no way to tell "the loop is
+         * not running", "the loop runs but INT never falls" and "the loop reads
+         * the chip but the header is rejected" apart. Print the counters and
+         * the INT level every ~5 s.
+         */
+        /*
+         * K60_FRAME_HUNT: while INT is low the panel has something to report, so
+         * compare the whole 0x10000..0x11000 window against the snapshot and
+         * print the blocks that moved. This finds the frame address instead of
+         * guessing it. The periodic pass keeps a baseline when nothing is
+         * touched.
+         */
+        if (k60_touch_diag >= 2 && tick % 16 == 0) {
+            k60_hm_peak_sample();
+        }
+        if (k60_touch_diag >= 1) {
+            if (!gpio_get(PIN_INT)) {
+                hunt_compare(true);
+            } else if (tick % 1000 == 999) {
+                hunt_compare(false);
+            }
+        }
+        if (++tick >= 625) {
+            tick = 0;
+            printf("Pong touch: POLL hb int=%u polls=%u(+%u) reports=%u(+%u) touches=%u(+%u) bad=%u\n",
+                gpio_get(PIN_INT),
+                seen.polls, seen.polls - hb_polls,
+                seen.reports, seen.reports - hb_reports,
+                seen.touches, seen.touches - hb_touches,
+                seen.bad);
+            hb_polls = seen.polls;
+            hb_reports = seen.reports;
+            hb_touches = seen.touches;
+        }
+    }
+}
+
+void
+pong_goodix_init(void)
+{
+    uint32_t enabled=1; /* K60: default ON so the driver actually runs */thread_t thread;
+    /* K60_GATE: PE_parse_boot_argn returns FALSE when the boot-arg is absent,
+     * so the || below would always return. Ignore the return value and
+     * let the compiled-in default (enabled=1) decide. */
+    (void)PE_parse_boot_argn("pong_touch",&enabled,sizeof(enabled));
+    if (!enabled) return;
+    if (!configuration()) {printf("Pong touch: missing/incompatible Pong DT; SKIP\n");return;}
+    printf("Pong touch: DT ok (se=%#llx pins=%u,%u,%u,%u,%u,%u axes %ux%u)\n",
+        se_phys, pins[0],pins[1],pins[2],pins[3],pins[4],pins[5], max_x, max_y);
+    /* K60_SE_GATE: the QUP0 SE4 branch is not proven to be clocked yet. Touching
+     * a gated SE hangs the interconnect and the whole boot dies with no console
+     * output (observed 2026-11-09). Keep the SE path OFF by default; enable it
+     * only on an explicit experimental boot with k60_touch_se=1. */
+    printf("Pong touch: DIAG init entered\n");
+    uint32_t se_enabled=0;
+    (void)PE_parse_boot_argn("k60_touch_se",&se_enabled,sizeof(se_enabled));
+    touch_stage = se_enabled;
+    {
+        int fifo = 0;
+        (void)PE_parse_boot_argn("k60_touch_fifo", &fifo, sizeof(fifo));
+        k60_touch_allow_fifo_disabled = fifo;
+        {
+            int dma = 0, keep_cs = 0, bb_us = 0, diag = 0, minimal = 0;
+            if (PE_parse_boot_argn("k60_touch_keep_cs", &keep_cs, sizeof(keep_cs))) {
+                k60_touch_keep_cs = keep_cs;
+            }
+            if (PE_parse_boot_argn("k60_touch_bb_us", &bb_us, sizeof(bb_us))) {
+                k60_touch_bb_us = bb_us;
+            }
+            if (PE_parse_boot_argn("k60_touch_diag", &diag, sizeof(diag))) {
+                k60_touch_diag = diag;
+            }
+            if (PE_parse_boot_argn("k60_touch_minimal", &minimal, sizeof(minimal)) && minimal) {
+                k60_touch_minimal = 1;
+                printf("Pong touch: MINIMAL path (reset+probe+poll only, like hakios.goodix.c)\n");
+            }
+            if (PE_parse_boot_argn("k60_touch_dma", &dma, sizeof(dma)) && dma) {
+                k60_touch_dma_enable = dma;
+                printf("Pong touch: DMA path requested (k60_touch_dma=%d)\n", dma);
+            }
+        }
+        if (fifo) printf("Pong touch: FIFO escape armed (k60_touch_fifo=1)\n");
+    }
+    {
+        int rcg = 0;
+        (void)PE_parse_boot_argn("k60_touch_rcg", &rcg, sizeof(rcg));
+        k60_touch_force_rcg = rcg;
+        if (rcg) printf("Pong touch: forcing RCG path (k60_touch_rcg=1)\n");
+    }
+    if (!se_enabled) {
+        printf("Pong touch: SE path disabled (k60_touch_se not set); DT verified only\n");
+        return;
+    }
+    printf("Pong touch: DIAG gate open, stage=%u; starting thread\n", touch_stage);
+    if (kernel_thread_start(touch_thread,NULL,&thread)==KERN_SUCCESS) thread_deallocate(thread);
+}
+#endif /* PONG */
+
diff --git a/bsd/dev/pong_input.c b/bsd/dev/pong_input.c
new file mode 100644
index 0000000..57e74e5
--- /dev/null
+++ b/bsd/dev/pong_input.c
@@ -0,0 +1,88 @@
+/* Blocking touch queue, adapted from HackiOS redwood_input.c (APSL 2.0).
+ * Only the real Goodix driver publishes samples. No GPU/loader dependency. */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/pong_input.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+
+#define QUEUE_SIZE 512
+static LCK_GRP_DECLARE(touch_group,"pong-touch");
+static LCK_MTX_DECLARE(touch_lock,&touch_group);
+static struct pong_touch samples[QUEUE_SIZE];
+static uint32_t head,tail;
+static bool opened;
+
+void
+pong_touch_post(uint32_t type,uint32_t finger,uint32_t x,uint32_t y)
+{
+    if (type<PONG_TOUCH_DOWN || type>PONG_TOUCH_UP || finger>=10) return;
+    lck_mtx_lock(&touch_lock);
+    if (tail-head==QUEUE_SIZE) head++;
+    samples[tail++%QUEUE_SIZE]=(struct pong_touch){mach_absolute_time(),type,finger,
+        x>65535?65535:x,y>65535?65535:y};
+    lck_mtx_unlock(&touch_lock);
+    wakeup(samples);
+}
+
+static int
+touch_open(__unused dev_t dev,int flags,__unused int kind,__unused struct proc *p)
+{
+    if (flags&FWRITE) return EACCES;
+    lck_mtx_lock(&touch_lock);
+    int error=opened?EBUSY:0;
+    if (!error) {opened=true;head=tail;}
+    lck_mtx_unlock(&touch_lock);
+    return error;
+}
+
+static int
+touch_close(__unused dev_t dev,__unused int flags,__unused int kind,__unused struct proc *p)
+{
+    lck_mtx_lock(&touch_lock);opened=false;lck_mtx_unlock(&touch_lock);return 0;
+}
+
+static int
+touch_read(__unused dev_t dev,struct uio *uio,int flags)
+{
+    if (uio_resid(uio)<(user_ssize_t)sizeof(struct pong_touch)) return EINVAL;
+    int error=0;
+    lck_mtx_lock(&touch_lock);
+    while (head==tail) {
+        if (flags&IO_NDELAY) {error=EWOULDBLOCK;break;}
+        error=msleep(samples,&touch_lock,PZERO|PCATCH,"pong-touch",NULL);
+        if (error) break;
+    }
+    if (!error) {
+        struct pong_touch sample=samples[head++%QUEUE_SIZE];
+        lck_mtx_unlock(&touch_lock);
+        return uiomove((caddr_t)&sample,sizeof(sample),uio);
+    }
+    lck_mtx_unlock(&touch_lock);return error;
+}
+
+static const struct cdevsw touch_cdevsw={
+    .d_open=touch_open,.d_close=touch_close,.d_read=touch_read,.d_write=eno_rdwrt,
+    .d_ioctl=eno_ioctl,.d_stop=eno_stop,.d_reset=eno_reset,.d_select=eno_select,
+    .d_mmap=eno_mmap,.d_strategy=eno_strat,.d_type=0,
+};
+
+bool
+pong_touch_device_ready(void)
+{
+    int major=cdevsw_add(-1,&touch_cdevsw);
+    if (major<0) return false;
+    if (!devfs_make_node(makedev(major,0),DEVFS_CHAR,UID_ROOT,GID_WHEEL,0444,"pong-touch")) {
+        cdevsw_remove(major,&touch_cdevsw);return false;
+    }
+    return true;
+}
+#endif
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 2be0f40..fa638ce 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1147,6 +1147,16 @@
 		bsd_init_kprintf("calling devfs_kernel_mount\n");
 		devfs_kernel_mount(mounthere);
 	}
+/* K60_PONG_LOCAL: bsd_init.c never includes board_config.h, so PONG
+ * was undefined here and this block was compiled out. Define it.
+ * Do not use #if 1: the keys patch relies on the same guard. */
+#if !defined(PONG)
+#define PONG 1
+#endif
+#if defined(PONG)
+	extern void pong_goodix_init(void);
+	pong_goodix_init();
+#endif
 #endif /* DEVFS */
 
 #if CONFIG_BASESYSTEMROOT
diff --git a/bsd/sys/pong_input.h b/bsd/sys/pong_input.h
new file mode 100644
index 0000000..199de9b
--- /dev/null
+++ b/bsd/sys/pong_input.h
@@ -0,0 +1,17 @@
+/* Pong touch records. HackiOS input ABI adapted to the real Pong producer. */
+#ifndef _SYS_PONG_INPUT_H_
+#define _SYS_PONG_INPUT_H_
+#include <stdint.h>
+#define PONG_TOUCH_DOWN 1
+#define PONG_TOUCH_MOVE 2
+#define PONG_TOUCH_UP 3
+struct pong_touch {
+    uint64_t time;
+    uint32_t type, finger, x, y;
+};
