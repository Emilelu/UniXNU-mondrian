 config = "mondrian"
 dsc = "Platforms/Xiaomi/mondrianPkg/mondrian.dsc"
 fd = "Build/mondrianPkg/{target}_CLANGPDB/FV/SILICIUM_UEFI.fd"
+preflight = ["scripts/check-ios27-board-inputs.py"]
 patches = [
   # Five K60 fixes the pinned Mu_Basecore (6f805f2, release/202608) does not carry.
