diff --git a/bsd/sys/pong_input.h b/bsd/sys/pong_input.h
new file mode 100644
index 0000000..199de9b
--- /dev/null
+++ b/bsd/sys/pong_input.h
@@ -0,0 +1,17 @@
+/* Pong touch records. HackiOS input ABI adapted to the real Pong producer. */
+#ifndef _SYS_PONG_INPUT_H_
+#define _SYS_PONG_INPUT_H_
+#include <stdint.h>
+#define PONG_TOUCH_DOWN 1
+#define PONG_TOUCH_MOVE 2
+#define PONG_TOUCH_UP 3
+struct pong_touch {
+    uint64_t time;
+    uint32_t type, finger, x, y;
+};
+#ifdef KERNEL
+void pong_touch_post(uint32_t, uint32_t, uint32_t, uint32_t);
+bool pong_touch_device_ready(void);
