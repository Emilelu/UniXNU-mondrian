     pub fn knows(self, pf: PixelFormat) -> bool {
+        if self == MetalLevel::IOS16_6_1 {
+            return pf == PixelFormat::Invalid || self.describes(pf);
+        }
         !self.row().unknown.contains(&pf)
     }
 
