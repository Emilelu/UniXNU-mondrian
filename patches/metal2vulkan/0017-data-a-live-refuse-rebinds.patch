From 4e1c791b922e2df810411b467daa8dc38df1ef01 Mon Sep 17 00:00:00 2001
From: root <root@MSI.localdomain>
Date: Sun, 25 Oct 2026 19:56:20 +0800
Subject: [PATCH] runtime: DeviceOptions::refuse_rebinds, under which encoders
 log no calls

While a device has a buffer over host pages, each compute, blit and render
encoder it opens logs every call, its arguments owned (replay.rs), so that a
rebind_bytes_no_copy of such a buffer can encode the encoder again before
its command buffer's first submission (command_buffer/reencode.rs). The
logs have no other reader. A consumer that never rebinds (the iOS frontend
says so of itself: "This frontend does not rebind/remap live backing
ranges") paid for every log and its drop; on the phone's render server the
logs and their drops came to about 1% of its samples (r2n).

DeviceOptions::refuse_rebinds (off by default, as before) refuses every
rebind_bytes_no_copy, of a buffer or a heap (Invalid,
RebindProblem::Refused, the deallocator dropped unrun as for every refused
rebind), and the device's encoders then log nothing
(DeviceShared::logs_calls). detach_backing, the holds an encoder takes on
the buffers it names and every first-submission rule stay as they are.

tests/refuse_rebinds.rs: a device without the option logs while a no-copy
buffer lives; one with it logs none and refuses the rebind, its buffer still
over its own memory, freed when it goes.

diff --git a/crates/metal2vulkan-runtime/src/blit.rs b/crates/metal2vulkan-runtime/src/blit.rs
index 2af641b..9db0e67 100644
--- a/crates/metal2vulkan-runtime/src/blit.rs
+++ b/crates/metal2vulkan-runtime/src/blit.rs
@@ -160,7 +160,7 @@ impl CommandBuffer {
             core: EncoderCore::open(self, "blit_command_encoder", true)?,
             pattern: None,
             shadows: Vec::new(),
-            log: self.device().shared().rebinds.any().then(CallLog::new),
+            log: self.device().shared().logs_calls().then(CallLog::new),
         })
     }
 }
diff --git a/crates/metal2vulkan-runtime/src/buffer_descriptor.rs b/crates/metal2vulkan-runtime/src/buffer_descriptor.rs
index 902a821..5d07264 100644
--- a/crates/metal2vulkan-runtime/src/buffer_descriptor.rs
+++ b/crates/metal2vulkan-runtime/src/buffer_descriptor.rs
@@ -539,6 +539,10 @@ impl Device {
         if self.is_lost() {
             return Err(Error::DeviceLost);
         }
+        // Its encoders logged nothing to encode again (`DeviceOptions::refuse_rebinds`).
+        if self.shared().refuse_rebinds {
+            return Err(invalid(call, Problem::Rebind(RebindProblem::Refused)));
+        }
         let key = buffer.identity().key;
         let encoded = || invalid(call, Problem::Rebind(RebindProblem::EncodedUses));
         if self.rebind_pending(key) {
diff --git a/crates/metal2vulkan-runtime/src/compute.rs b/crates/metal2vulkan-runtime/src/compute.rs
index 0863fd5..92894bd 100644
--- a/crates/metal2vulkan-runtime/src/compute.rs
+++ b/crates/metal2vulkan-runtime/src/compute.rs
@@ -226,7 +226,7 @@ impl CommandBuffer {
             indirect_stage_in: None,
             residency: self.inherited_residency(false),
             captures: Captures::default(),
-            log: self.device().shared().rebinds.any().then(CallLog::new),
+            log: self.device().shared().logs_calls().then(CallLog::new),
             dispatches: 0,
         })
     }
diff --git a/crates/metal2vulkan-runtime/src/device/adopt.rs b/crates/metal2vulkan-runtime/src/device/adopt.rs
index 73f84ba..4262d65 100644
--- a/crates/metal2vulkan-runtime/src/device/adopt.rs
+++ b/crates/metal2vulkan-runtime/src/device/adopt.rs
@@ -266,6 +266,8 @@ impl Device {
             gpu_times_from_host: raw.gpu_times_from_host,
             // An adopted device keeps no execution record: validation makes its own devices.
             record_executions: false,
+            // An adopted device's rebinds go as a made device's do by default.
+            refuse_rebinds: false,
             announce_each: raw.announce_each,
             view_reinterpretation,
             generated_commands: false,
diff --git a/crates/metal2vulkan-runtime/src/device/create.rs b/crates/metal2vulkan-runtime/src/device/create.rs
index 76a0d07..77ac8af 100644
--- a/crates/metal2vulkan-runtime/src/device/create.rs
+++ b/crates/metal2vulkan-runtime/src/device/create.rs
@@ -169,6 +169,14 @@ pub struct DeviceOptions {
     /// No Metal counterpart.
     #[doc(hidden)]
     pub record_executions: bool,
+    /// Refuse every `rebind_bytes_no_copy`, of a buffer and of a heap (`Invalid`,
+    /// [`RebindProblem::Refused`](crate::RebindProblem::Refused)), for a consumer that never moves
+    /// the host pages of what it made with `new_buffer_with_bytes_no_copy` or
+    /// `new_heap_with_bytes_no_copy`. Off by default. The device's compute, blit and render
+    /// encoders then log no calls (`replay.rs`): a log is read only to encode its encoder again at
+    /// a rebind, so a draw pays nothing for a log no one reads. `detach_backing` is unchanged. No
+    /// Metal counterpart.
+    pub refuse_rebinds: bool,
 }
 
 /// One setting of an instance layer (`VkLayerSettingEXT`).
@@ -1248,6 +1256,7 @@ fn create_on(
         gpu_times_from_host: options.gpu_times_from_host,
         announce_each: options.announce_each.clone(),
         record_executions: options.record_executions,
+        refuse_rebinds: options.refuse_rebinds,
         view_reinterpretation,
         generated_commands,
         host_image_copy,
@@ -1356,6 +1365,7 @@ fn same_options(a: &DeviceOptions, b: &DeviceOptions) -> bool {
         announce_each,
         metal_level,
         record_executions,
+        refuse_rebinds,
     } = a;
     *policy == b.policy
         && *layers == b.layers
@@ -1374,6 +1384,7 @@ fn same_options(a: &DeviceOptions, b: &DeviceOptions) -> bool {
         && *announce_each == b.announce_each
         && *metal_level == b.metal_level
         && *record_executions == b.record_executions
+        && *refuse_rebinds == b.refuse_rebinds
 }
 
 /// The group of `made` for `options`: the live one, or a new one on a new instance. Its index.
diff --git a/crates/metal2vulkan-runtime/src/device/mod.rs b/crates/metal2vulkan-runtime/src/device/mod.rs
index 8842010..81304a0 100644
--- a/crates/metal2vulkan-runtime/src/device/mod.rs
+++ b/crates/metal2vulkan-runtime/src/device/mod.rs
@@ -366,6 +366,9 @@ pub(super) struct DeviceShared {
     /// Its command buffers keep execution records (`DeviceOptions::record_executions`): where
     /// not, its encoders build none (`EncoderCore::executed`).
     pub(crate) record_executions: bool,
+    /// It refuses every rebind (`DeviceOptions::refuse_rebinds`): its encoders log no calls
+    /// ([`DeviceShared::logs_calls`]).
+    pub(crate) refuse_rebinds: bool,
     /// Counts the times an image of the device let its views go, under its views lock (a
     /// rebind's or a storage form's new `VkImage`, a detach's stand-in, a reattach): a view kept
     /// by what it was made of (`binding::BindMemo`) is current while this holds.
@@ -373,6 +376,13 @@ pub(super) struct DeviceShared {
 }
 
 impl DeviceShared {
+    /// Whether an encoder opened now logs its calls (`replay.rs`): where the device has a buffer
+    /// over host pages, unless it refuses every rebind, the only reader of a log
+    /// (`DeviceOptions::refuse_rebinds`).
+    pub(crate) fn logs_calls(&self) -> bool {
+        !self.refuse_rebinds && self.rebinds.any()
+    }
+
     /// What `create` makes with the `VkPipelineCache` it is handed, its `vkCreate*Pipelines` call:
     /// a cache of the making's own, seeded from the record `making` names
     /// (`ShaderCache::make_pipelines`, `shader_cache/driver.rs`). On a pool's thread the exit waits
@@ -754,6 +764,8 @@ pub(super) struct Parts {
     pub(super) announce_each: BTreeSet<Degradation>,
     /// Its command buffers keep execution records (`DeviceOptions::record_executions`).
     pub(super) record_executions: bool,
+    /// It refuses every rebind (`DeviceOptions::refuse_rebinds`).
+    pub(super) refuse_rebinds: bool,
     /// Its views may reinterpret an image's components ([`DeviceShared`]'s field), outside
     /// `enabled`'s vocabulary.
     pub(super) view_reinterpretation: bool,
@@ -821,6 +833,7 @@ impl Device {
             gpu_times_from_host,
             announce_each,
             record_executions,
+            refuse_rebinds,
             view_reinterpretation,
             generated_commands,
             host_image_copy,
@@ -1219,6 +1232,7 @@ impl Device {
             properties,
             announced: Announced::new(&announce_each),
             record_executions,
+            refuse_rebinds,
             views_epoch: AtomicU64::new(0),
             device_address,
             upload_alignment,
diff --git a/crates/metal2vulkan-runtime/src/rebind.rs b/crates/metal2vulkan-runtime/src/rebind.rs
index 2bce8e6..e8a8d2c 100644
--- a/crates/metal2vulkan-runtime/src/rebind.rs
+++ b/crates/metal2vulkan-runtime/src/rebind.rs
@@ -77,6 +77,9 @@ pub enum RebindProblem {
     /// a resource placed in it, or has an encoder open that used one (or one committed whose
     /// commands the runtime records only once earlier work completed): commit or drop it first.
     EncodedUses,
+    /// The device refuses every rebind (`DeviceOptions::refuse_rebinds`): its encoders log no
+    /// calls to encode again.
+    Refused,
 }
 
 /// The device's buffers over host pages, by their hazard-tracking key, with the command buffers
@@ -721,7 +724,8 @@ impl Buffer {
     /// (`NotImplemented(RebindTextures)`: the texture's copies, views and aliasing image are
     /// planned at that offset), or where the device cannot make a texture's aliasing image again
     /// over the new memory (`NotImplemented(RebindTextures)`, which says when); memory the device
-    /// cannot import exactly, as `new_buffer_with_bytes_no_copy` refuses it; a lost device.
+    /// cannot import exactly, as `new_buffer_with_bytes_no_copy` refuses it; a lost device; a
+    /// device made with `DeviceOptions::refuse_rebinds` (`Invalid`, [`RebindProblem::Refused`]).
     ///
     /// # Safety
     ///
@@ -777,7 +781,8 @@ impl Heap {
     /// [`RebindProblem::EncodedUses`]); memory whose first byte is off the import's unit
     /// (`Invalid`, `HeapProblem::HostMemoryAlignment`); memory the device cannot import exactly;
     /// an image the device cannot make again there (as `new_texture_at_offset` refuses it); a
-    /// lost device.
+    /// lost device; a device made with `DeviceOptions::refuse_rebinds` (`Invalid`,
+    /// [`RebindProblem::Refused`]).
     ///
     /// # Safety
     ///
diff --git a/crates/metal2vulkan-runtime/src/render.rs b/crates/metal2vulkan-runtime/src/render.rs
index 110c428..5cd377c 100644
--- a/crates/metal2vulkan-runtime/src/render.rs
+++ b/crates/metal2vulkan-runtime/src/render.rs
@@ -1273,8 +1273,7 @@ impl CommandBuffer {
         let log = match again {
             None => device
                 .shared()
-                .rebinds
-                .any()
+                .logs_calls()
                 .then(|| RenderLog::new(descriptor)),
             Some(_) => None,
         };
diff --git a/crates/metal2vulkan-runtime/src/replay.rs b/crates/metal2vulkan-runtime/src/replay.rs
index f514934..d39f82d 100644
--- a/crates/metal2vulkan-runtime/src/replay.rs
+++ b/crates/metal2vulkan-runtime/src/replay.rs
@@ -13,7 +13,8 @@
 //!   over where their buffers lie now. A call refused at its first encoding is refused again,
 //!   which leaves the encoder as it was encoded first ([`Replay::run`] fails, and the encoder is
 //!   not encoded again). The log starts at the encoder's open where the device has a buffer over
-//!   host pages (`Rebinds::any`); else nothing is logged. It costs one push per
+//!   host pages (`Rebinds::any`) and does not refuse every rebind (`DeviceOptions::refuse_rebinds`,
+//!   `DeviceShared::logs_calls`); else nothing is logged. It costs one push per
 //!   call; a slice of buffers, offsets, textures or bytes goes into one of the log's arenas, so
 //!   the common calls allocate nothing of their own.
 //! - **What is kept.** The command buffer keeps an ended encoder's log only where a command of
