+#define AR_SG_SPEAKER               0x4005u
+#define AR_IID_PLAY_SHMEM           0x6001u
+#define AR_IID_PLAY_DEC             0x6002u
+#define AR_IID_PLAY_CNV             0x6003u
+#define AR_IID_SPEAKER_I2S          0x6051u
+
+#define AR_PRM_IID                  2u
+#define AR_OP_PRM_REQUEST           0x0100100Fu
+#define AR_OP_PRM_RELEASE           0x01001010u
+#define AR_OP_PRM_REQUEST_DONE      0x02001002u
+#define AR_OP_PRM_RELEASE_DONE      0x02001003u
+
+#define PARAM_SG_CONFIG             0x08001001u
+#define PARAM_CONTAINER_CONFIG      0x08001000u
+#define PARAM_MODULE_LIST           0x08001002u
+#define PARAM_MODULE_PROP           0x08001003u
+#define PARAM_MODULE_CONN           0x08001004u
+#define PARAM_SG_LIST               0x08001005u
+#define PARAM_I2S_INTF              0x08001019u
+#define PARAM_HW_EP_MF              0x08001017u
+#define PARAM_FRAME_SIZE_FACTOR     0x08001018u
+#define PARAM_PCM_OUTPUT            0x08001008u
+#define PARAM_MEDIA_FORMAT          0x0800100Cu
+#define PARAM_HEADER                16u
+#define CMD_HEADER                  16u
+#define PERF_LOW_LATENCY            2u
+#define DIR_TX                      1u
+#define DIR_RX                      2u
+#define SCENARIO_PLAYBACK           1u
+#define POS_STREAM                  1u
+#define POS_GLOBAL_DEV              4u
+#define DOMAIN_ADSP                 2u
+#define STACK_SIZE                  8192u
+#define OUT_PORT                    1u
+#define IN_PORT                     2u
+#define LPAIF_TYPE                  0u
+#define I2S_TERTIARY                2u
+#define I2S_SPEAKER_SD              3u /* K60: SD0|SD1, live-fdt.dts:20063 */
+#define WS_INTERNAL                 1u
+#define INTERLEAVED                 1u
+#define DEINTERLEAVED_UNPACKED      3u
+
+typedef struct {
+	uint8_t *p;
+	uint32_t n;
+	uint32_t cap;
+	int bad;
+} PongWriter;
+
+typedef struct {
+	uint32_t rate;
+	uint16_t bits;
+	uint16_t channels;
+} PongArFormat;
+
+static void
+pong_put8(PongWriter *w, uint32_t v)
+{
+	if (w->n + 1 > w->cap) {
+		w->bad = 1;
+		return;
+	}
+	w->p[w->n++] = (uint8_t)v;
+}
+
+static void
+pong_put16(PongWriter *w, uint32_t v)
+{
+	pong_put8(w, v);
+	pong_put8(w, v >> 8);
+}
+
+static void
+pong_put32(PongWriter *w, uint32_t v)
+{
+	pong_put16(w, v);
+	pong_put16(w, v >> 16);
+}
+
+static void
+pong_pad_to(PongWriter *w, uint32_t end)
+{
+	while (!w->bad && w->n < end) {
+		pong_put8(w, 0);
+	}
+}
+
+static uint32_t
+pong_align8(uint32_t v)
+{
+	return (v + 7u) & ~7u;
+}
+
+static void
+pong_set32(PongWriter *w, uint32_t at, uint32_t v)
+{
+	if (at + 4 <= w->n) {
+		w->p[at] = (uint8_t)v;
+		w->p[at + 1] = (uint8_t)(v >> 8);
+		w->p[at + 2] = (uint8_t)(v >> 16);
+		w->p[at + 3] = (uint8_t)(v >> 24);
+	}
+}
+
+static void
+pong_begin(PongWriter *w, uint8_t *out, uint32_t capacity, uint32_t port,
+    uint32_t dst, uint32_t token, uint32_t opcode)
+{
+	w->p = out;
+	w->n = 0;
+	w->cap = capacity < GPR_MAX_PACKET ? capacity : GPR_MAX_PACKET;
+	w->bad = 0;
+	pong_put32(w, 0);
+	pong_put32(w, GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8);
+	pong_put32(w, port);
+	pong_put32(w, dst);
+	pong_put32(w, token);
+	pong_put32(w, opcode);
+}
+
+static uint32_t
+pong_finish(PongWriter *w)
+{
+	if (w->bad) {
+		return 0;
+	}
+	pong_set32(w, 0, (GPR_VERSION & 0xfu) | (GPR_HEADER_BYTES / 4u) << 4 |
+	    w->n << 8);
+	return w->n;
+}
+
+static void
+pong_cmd_header(PongWriter *w, uint32_t payload)
+{
+	pong_put32(w, 0);
+	pong_put32(w, 0);
+	pong_put32(w, 0);
+	pong_put32(w, payload);
+}
+
+static uint32_t
+pong_cmd_payload_start(PongWriter *w)
+{
+	const uint32_t at = w->n;
+	pong_cmd_header(w, 0);
+	return at;
+}
+
+static void
+pong_cmd_payload_end(PongWriter *w, uint32_t at)
+{
+	pong_set32(w, at + 12, w->n - at - CMD_HEADER);
+}
+
+static uint32_t
+pong_param_begin(PongWriter *w, uint32_t iid, uint32_t id)
+{
+	const uint32_t at = w->n;
+	pong_put32(w, iid);
+	pong_put32(w, id);
+	pong_put32(w, 0);
+	pong_put32(w, 0);
+	return at;
+}
+
+static void
+pong_param_end(PongWriter *w, uint32_t at)
+{
+	pong_pad_to(w, at + pong_align8(w->n - at));
+	pong_set32(w, at + 8, w->n - at - PARAM_HEADER);
+}
+
+typedef struct {
+	uint32_t id;
+	uint32_t perf;
+	uint32_t direction;
+	uint32_t scenario;
+} PongSg;
+
+typedef struct {
+	uint32_t id;
+	uint32_t position;
+} PongContainer;
+
+typedef struct {
+	uint32_t module;
+	uint32_t iid;
+	uint32_t inputs;
+	uint32_t outputs;
+} PongModule;
+
+typedef struct {
+	uint32_t from;
+	uint32_t to;
+} PongLink;
+
+static uint32_t
+pong_graph_open(uint8_t *out, uint32_t capacity, uint32_t port,
+    uint32_t token, const PongSg *sg, const PongContainer *c,
+    const PongModule *m, unsigned modules, const PongLink *l, unsigned links)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_APM_IID, token, AR_OP_GRAPH_OPEN);
+	const uint32_t cmd = pong_cmd_payload_start(&w);
+	uint32_t at = pong_param_begin(&w, AR_APM_IID, PARAM_SG_CONFIG);
+	pong_put32(&w, 1);
+	pong_put32(&w, sg->id);
+	pong_put32(&w, 3);
+	pong_put32(&w, 0x0800100Eu);
+	pong_put32(&w, 4);
+	pong_put32(&w, sg->perf);
+	pong_put32(&w, 0x0800100Fu);
+	pong_put32(&w, 4);
+	pong_put32(&w, sg->direction);
+	pong_put32(&w, 0x08001010u);
+	pong_put32(&w, 4);
+	pong_put32(&w, sg->scenario);
+	pong_param_end(&w, at);
+	at = pong_param_begin(&w, AR_APM_IID, PARAM_CONTAINER_CONFIG);
+	pong_put32(&w, 1);
+	pong_put32(&w, c->id);
+	pong_put32(&w, 4);
+	pong_put32(&w, 0x08001011u);
+	pong_put32(&w, 8);
+	pong_put32(&w, 1);
+	pong_put32(&w, 0x0B001001u);
+	pong_put32(&w, 0x08001012u);
+	pong_put32(&w, 4);
+	pong_put32(&w, c->position);
+	pong_put32(&w, 0x08001013u);
+	pong_put32(&w, 4);
+	pong_put32(&w, STACK_SIZE);
+	pong_put32(&w, 0x08001014u);
+	pong_put32(&w, 4);
+	pong_put32(&w, DOMAIN_ADSP);
+	pong_param_end(&w, at);
+	at = pong_param_begin(&w, AR_APM_IID, PARAM_MODULE_LIST);
+	pong_put32(&w, 1);
+	pong_put32(&w, sg->id);
+	pong_put32(&w, c->id);
+	pong_put32(&w, modules);
+	for (unsigned i = 0; i < modules; ++i) {
+		pong_put32(&w, m[i].module);
+		pong_put32(&w, m[i].iid);
+	}
+	pong_param_end(&w, at);
+	at = pong_param_begin(&w, AR_APM_IID, PARAM_MODULE_PROP);
+	pong_put32(&w, modules);
+	for (unsigned i = 0; i < modules; ++i) {
+		pong_put32(&w, m[i].iid);
+		pong_put32(&w, 1);
+		pong_put32(&w, 0x08001015u);
+		pong_put32(&w, 8);
+		pong_put32(&w, m[i].inputs);
+		pong_put32(&w, m[i].outputs);
+	}
+	pong_param_end(&w, at);
+	at = pong_param_begin(&w, AR_APM_IID, PARAM_MODULE_CONN);
+	pong_put32(&w, links);
+	for (unsigned i = 0; i < links; ++i) {
+		pong_put32(&w, l[i].from);
+		pong_put32(&w, OUT_PORT);
+		pong_put32(&w, l[i].to);
+		pong_put32(&w, IN_PORT);
+	}
+	pong_param_end(&w, at);
+	pong_cmd_payload_end(&w, cmd);
+	return pong_finish(&w);
+}
