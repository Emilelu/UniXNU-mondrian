 };
 
 static struct k60_bt_state k60;
+#ifdef KERNEL
+/* 0523: serialises the worker's engine turn against a client TIOCSETA that
+ * reclocks the link. */
+static LCK_GRP_DECLARE(k60_rate_grp, "unixnu.bt.k60.rate");
+static LCK_MTX_DECLARE(k60_rate_lock, &k60_rate_grp);
+#endif
 
 /* Forward declarations for functions used before their definitions. */
 static void k60_wait_until(void *ctx, uint64_t deadline);
@@ -1163,6 +1174,42 @@
     if (!e) k60.baud = baud;
     return e;
 }
+
+/* 0523: TIOCSETA from a client may ask for a speed other than the bring-up
+ * one.  The request is executed by the worker, which owns the engine during
+ * its service turns; the client blocks until the worker reports the result or
+ * two seconds pass.  Calling k60_uart_speed from the client thread instead
+ * would race the worker's pump. */
+#ifdef KERNEL
+static int k60_transport_set_rate(void *ctx, uint32_t baud) {
+    (void)ctx;
+    if (!k60.powered || !k60.ready) return ENODEV;
+    if (!baud) return EINVAL;
+    if (baud == k60.baud) return 0;
+    lck_mtx_lock(&k60_rate_lock);
+    if (!k60.powered || !k60.ready) { lck_mtx_unlock(&k60_rate_lock); return ENODEV; }
+    k60.rate_request = baud;
+    k60.rate_done = 0;
+    k60.rate_error = 0;
+    k60_wake(NULL);
+    int e = 0;
+    struct timespec timeout = { 2, 0 };
+    while (!k60.rate_done && !e)
+        e = msleep(&k60.rate_done, &k60_rate_lock, PZERO, "k60bt-rate", &timeout);
+    int result = e ? -e : k60.rate_error;
+    k60.rate_request = 0;
+    lck_mtx_unlock(&k60_rate_lock);
+    char line[96];
+    snprintf(line, sizeof(line), "transport: set_rate %u error=%d", baud, result);
+    k60_log(NULL, 1, line);
+    return result < 0 ? -result : result;
+}
+#else
+static int k60_transport_set_rate(void *ctx, uint32_t baud) {
+    (void)ctx;
+    return baud ? ENOTSUP : EINVAL;
+}
+#endif
 
