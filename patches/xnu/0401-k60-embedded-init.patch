+/*
+ * K60: write the embedded init helper onto the already-mounted Data volume
+ * before load_init_program_at_path() execs it. Same write discipline as
+ * 0340/0394: IO_SYNC, the context's ucred, a resid out-parameter, and
+ * vnode_close(vp, 0, ctx).
+ *
+ * Gated on k60_init_blob=1: on this board the helper can already be present
+ * from an earlier boot, and rewriting it unconditionally would replace a
+ * binary that is currently executing as PID 1.
+ */
 static int
+k60_install_embedded_init(int *resid_out)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	int error;
+	int resid = 0;
+
+	error = vnode_open("/private/var/pong/init",
+	    O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("K60INIT vnode_open error=%d\n", error);
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)k60_init_blob,
+	    (ssize_t)K60_INIT_BLOB_LEN, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	if (resid_out) {
+		*resid_out = resid;
+	}
+	if (error) {
+		return error;
+	}
+
+	/* Same write for the curated job archive. The helper expands it before it
+	 * binds /System/Library/LaunchDaemons, because the kernel cannot create
+	 * several hundred files safely before PID 1 exists. */
+	error = vnode_open("/private/var/pong/boot-jobs.pack",
+	    O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("K60INIT pack vnode_open error=%d\n", error);
+		return error;
+	}
+	resid = 0;
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)k60_bootjobs_blob,
+	    (ssize_t)K60_BOOTJOBS_LEN, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	printf("K60INIT pack bytes=%d resid=%d error=%d\n",
+	    (int)K60_BOOTJOBS_LEN, resid, error);
+
+	/* 0406: the skeleton apply() would have put on the OS window. The helper
+	 * expands it into /pong, then reads /pong/etc/var.skel to build the Data
+	 * directory tree; without it every runtime directory is skipped. */
+	error = vnode_open("/private/var/pong/var.pack",
+	    O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("K60INIT varpack vnode_open error=%d\n", error);
+		return error;
+	}
+	resid = 0;
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)k60_varpack_blob,
+	    (ssize_t)K60_VARPACK_LEN, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	printf("K60INIT varpack bytes=%d resid=%d error=%d\n",
+	    (int)K60_VARPACK_LEN, resid, error);
+	return error;
+}
