 static void
+pong_audio_afe_selftest(void)
+{
+	uint8_t pkt[PONG_AFE_PRM_CLOCK_BYTES];
+	size_t n = pong_afe_prm_clock_request(pkt, sizeof(pkt),
+	    PONG_AFE_CLOCK_TERT_TDM_IBIT, PONG_AFE_TDM_CLK_HZ,
+	    PONG_AFE_CLOCK_ATTRIBUTE_NOCOUPLE, 1u);
+	printf("PongAudio: AFE encoder selftest bytes=%u\n", (unsigned)n);
+}
+
+static void
+pong_audio_glink_state(void *context, bool up)
+{
+	PongAudioState *state = (PongAudioState *)context;
+	state->glink_up = up;
+	printf("PongAudio: glink adsp_apps %s\n", up ? "up" : "down");
+	if (!up) {
+		state->gpr_token = 0;
+		return;
+	}
+	if (state->gpr_token != 0) {
+		return;
+	}
+	uint8_t packet[GPR_MAX_PACKET];
+	PongGprPacket request;
+	memset(&request, 0, sizeof(request));
+	request.version = GPR_VERSION;
+	request.header_bytes = GPR_HEADER_BYTES;
+	request.size = GPR_HEADER_BYTES;
+	request.dst_domain = GPR_DOMAIN_ADSP;
+	request.src_domain = GPR_DOMAIN_APPS;
+	request.src_port = 0;
+	request.dst_port = GPR_PORT_APM;
+	request.token = 0x00010001u;
+	request.opcode = GPR_OP_APM_GET_SPF_STATE;
+	const uint32_t n = pong_gpr_encode(packet, sizeof(packet), &request, NULL, 0);
+	if (n == 0) {
+		printf("PongAudio: GPR GET_SPF_STATE encode failed\n");
+		return;
+	}
+	const int rc = k60_pmic_glink_send_audio(packet, (unsigned)n);
+	printf("PongAudio: GPR GET_SPF_STATE send bytes=%u rc=%d\n", (unsigned)n, rc);
+	if (rc == K60_PMIC_GLINK_AUDIO_OK) {
+		state->gpr_token = request.token;
+	}
+}
+
+static void
+pong_audio_glink_receive(void *context, const uint8_t *data, unsigned bytes)
+{
+	(void)context;
+	PongGprPacket packet;
+	const int rc = pong_gpr_decode(data, bytes, &packet);
+	if (rc == PongGprOk) {
+		printf("PongAudio: glink adsp_apps rx bytes=%u opcode=0x%08x token=0x%08x\n",
+		    bytes, packet.opcode, packet.token);
+	} else {
+		printf("PongAudio: glink adsp_apps rx bytes=%u (gpr rc=%d)\n", bytes, rc);
+	}
+}
+
