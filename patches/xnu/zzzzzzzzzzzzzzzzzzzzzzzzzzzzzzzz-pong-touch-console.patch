+/* Goodix Berlin-D / Pong SM8475. Adapted from HackiOS redwood_goodix.c
+ * (APSL 2.0). Hardware resources are the Pong live DT, checked against the
+ * NothingOSS cape pinctrl and waipio GCC source. No Redwood peripherals. */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/pong_input.h>
+#include <kern/sched_prim.h>
+#include <pexpert/device_tree.h>
+#include <sys/systm.h>
