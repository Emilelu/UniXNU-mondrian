+extern void IOSleep(unsigned int);
+
+/*
+ * MKB is userland, so it runs after the Data mount, yet still reports ENOENT on
+ * /private/var/keybags. Report the directory every two seconds: the screen then
+ * shows whether it disappears before MKB looks, and the ordering is visible even
+ * when the log scrolls.
+ */
+static void
+k60_var_watch(void *arg, wait_result_t wr)
+{
+	for (int i = 0; i < 90; i++) {
+		vnode_t vp = NULLVP;
+		IOSleep(2000);
+		int e = vnode_lookup("/private/var/keybags", 0, &vp, vfs_context_current());
+		printf("K60WATCH t=%d keybags err=%d\n", i, e);
+		if (vp) {
+			vnode_put(vp);
+		}
+	}
+	(void)arg;
+	(void)wr;
+	thread_terminate(current_thread());
+}
