+static int k60_map(struct k60_region *r, uint64_t phys, size_t bytes) {
+    if (r->va) return 0;
+    r->phys = phys;
+    r->bytes = bytes;
+#ifdef KERNEL
+    r->va = (volatile uint32_t *)ml_io_map((vm_offset_t)phys, (vm_size_t)bytes);
+#else
+    r->va = (volatile uint32_t *)ml_io_map(phys, bytes);
+#endif
+    return r->va ? 0 : -ENOMEM;
+}
