+/*
+ * 0308: has the log ended at something fatal?
+ *
+ * Reads the tail of the console ring through the same snapshot accessor and
+ * looks for the markers this kernel and launchd emit exactly once, at the end:
+ *   "panic("                            - kernel panic banner
+ *   "exited -- exit reason namespace"    - a critical process exit, which
+ *                                          proc_handle_critical_exit turns
+ *                                          into a panic right after printing
+ *   "K60XT"                              - init (PID 1) terminated
+ * Only the last few KiB are searched: these markers appear at the very end of
+ * a dead boot, and a stale occurrence from an earlier epoch must not trigger
+ * a reset on a healthy one.
+ */
+static bool
+ud_console_fatal(void)
+{
+	vm_offset_t ring = pong_ramoops_debug_base();
+	static const char *const markers[] = {
+		"panic(",
+		"exited -- exit reason namespace",
+		"K60XT",
+	};
+	uint8_t tail[1024];
+	uint32_t start = 0, size = 0, bytes = 0;
+	uint64_t total = 0, dropped = 0;
+
+	if (!ring) {
+		return false;
+	}
+	/*
+	 * cursor > total is clamped to total by the accessor, so this asks for
+	 * the newest bytes. bytes is the amount actually returned, which may be
+	 * less than sizeof(tail) early in a boot.
+	 */
+	if (pong_ramoops_snapshot(UINT64_MAX, tail, sizeof(tail), &bytes, &start,
+	    &size, &total, &dropped) != 1 || bytes == 0) {
+		return false;
+	}
+	for (unsigned m = 0; m < sizeof(markers) / sizeof(markers[0]); m++) {
+		const char *needle = markers[m];
+		unsigned n = (unsigned)strlen(needle);
+		for (unsigned k = 0; k + n <= bytes; k++) {
+			if (!memcmp(tail + k, needle, n)) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+/*
+ * 0319: CDC-ACM command channel (pong PongUsbDevice.h:88-97).
+ *
+ * The host writes a plain text line to the bulk OUT endpoint:
+ *     reboot fastboot   -> set the bootloader restart reason and reboot
+ *     reboot rec        -> same for recovery
+ *     help              -> print the accepted commands
+ * This is what makes "read the log, then put the phone back into fastboot"
+ * an explicit action instead of a timer guess. A manual command never starts
+ * a timed capture, and it runs on the worker thread with USB still live so
+ * the ACK can be delivered.
+ */
+static char     ud_cmdline[64];
+static unsigned ud_cmdlen;
+static bool     ud_cmddiscard;
+
+static void
+ud_command(const char *buf, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		char c = buf[i];
+
+		if (c == '\n' || c == '\r') {
+			if (ud_cmdlen && !ud_cmddiscard) {
+				ud_cmdline[ud_cmdlen] = 0;
+				if (!strcmp(ud_cmdline, "reboot fastboot")) {
+					printf("K60 USBLOG: command reboot fastboot; priming restart reason\n");
+					k60_usblog_reset_to_fastboot();
+				} else if (!strcmp(ud_cmdline, "reboot rec") ||
+				    !strcmp(ud_cmdline, "reboot recovery")) {
+					printf("K60 USBLOG: command reboot rec\n");
+					(void)k60_prime_restart(1);
+					reboot_kernel(0x400, NULL);
+				} else {
+					printf("K60 USBLOG: commands: reboot rec | reboot fastboot | help\n");
+				}
+			}
+			ud_cmdlen = 0;
+			ud_cmddiscard = false;
+		} else if (c < 32 || c > 126 || ud_cmdlen >= sizeof(ud_cmdline) - 1) {
+			ud_cmddiscard = true;
+		} else if (!ud_cmddiscard) {
+			ud_cmdline[ud_cmdlen++] = c;
+		}
+	}
+}
