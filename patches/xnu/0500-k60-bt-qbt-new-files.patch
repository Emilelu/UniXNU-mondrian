+/* ------------------------------------------------------------------------- */
+/* GENI engine helpers                                                        */
+/* ------------------------------------------------------------------------- */
+
+static uint32_t k60_uart_read(void *ctx, uint32_t reg) {
+    (void)ctx;
+    return k60_read32(&k60.uart, reg);
+}
+static void k60_uart_write(void *ctx, uint32_t reg, uint32_t value) {
+    (void)ctx;
+    k60_write32(&k60.uart, reg, value);
+}
+static void k60_dma_barrier(void *ctx) { (void)ctx; k60_barrier(); }
+static void k60_dma_sync(void *ctx, const struct qbt_dma_buffer *buffer,
+                         size_t bytes, bool device, bool tx) {
+    (void)ctx;
+    /* Cache maintenance matches the sheng board backend (BluetoothProbe.cpp:85-99):
+     * TX clean to PoC; RX invalidate after device writes. */
+    if (bytes && (device || !tx)) {
+#ifdef __aarch64__
+        uint64_t ctr;
+        __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+        size_t line = 4u << ((ctr >> 16) & 15u);
+        uintptr_t at = (uintptr_t)buffer->bytes & ~(line - 1u);
+        uintptr_t end = (uintptr_t)buffer->bytes + bytes;
+        for (; at < end; at += line) {
+            if (tx) __asm__ volatile("dc cvac, %0" ::"r"(at) : "memory");
+            else if (device) __asm__ volatile("dc civac, %0" ::"r"(at) : "memory");
+            else __asm__ volatile("dc ivac, %0" ::"r"(at) : "memory");
+        }
+#endif
+    }
+    k60_barrier();
+}
+static void k60_irq_mask(void *ctx, bool masked) {
+    (void)ctx;
+    if (k60.serial_irq) {
+        k60_gic_mask(K60_BT_UART_GIC_SPI, masked);
+        if (armcpu_spi_mask) (void)armcpu_spi_mask(K60_BT_UART_GIC_SPI, masked);
+    }
+}
+static void k60_wake(void *ctx) {
+    (void)ctx;
+    __atomic_store_n(&k60.pending, 1u, __ATOMIC_RELEASE);
+#ifdef KERNEL
+    thread_wakeup((event_t)&k60.pending);
+#endif
+}
+static uint64_t k60_now_ns(void *ctx) {
+    (void)ctx;
+#ifdef KERNEL
+    uint64_t ns = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    return ns;
+#else
+    return 0;
+#endif
+}
+static size_t k60_geni_receive(void *ctx, const uint8_t *bytes, size_t n) {
+    (void)ctx;
+    if (!k60.core) return n;
+    if (k60.initializing) {
+        /* Optional boot-time trace hook; keep hooks out of the data path. */
+    }
+    k60.rx_sequence += n;
+    return qbt_receive(k60.core, bytes, n);
+}
+static size_t k60_transport_receive(void *ctx, const uint8_t *bytes, size_t n) {
+    (void)ctx;
+    return qbt_transport_receive(bytes, (uint32_t)n);
+}
+static size_t k60_uart_write_cb(void *ctx, const uint8_t *bytes, size_t n) {
+    (void)ctx;
+    return qbt_geni_write(&k60.geni, bytes, n);
+}
+static bool k60_uart_drained(void *ctx) {
+    (void)ctx;
+    return k60.gated || qbt_geni_drained(&k60.geni);
+}
+static int k60_uart_flow(void *ctx, bool enabled) {
+    (void)ctx;
+    qbt_geni_set_flow(&k60.geni, enabled);
+    return 0;
+}
+
+/* Return the SE clock frequency whose divider gives <=1% error for
+ * baud*sampling.  Mirrors qbt_geni_set_rate's arithmetic (qbt_geni.c:65-73). */
+static int k60_geni_source_hz(uint32_t baud, unsigned sampling, uint32_t *hz) {
+    uint64_t target = (uint64_t)baud * sampling;
+    uint64_t best_err = UINT64_MAX;
+    uint32_t best = 0;
+    if (!target) return -EINVAL;
+    for (size_t i = 0; i < sizeof(k60_qup_se_freq) / sizeof(k60_qup_se_freq[0]); i++) {
+        uint32_t freq = k60_qup_se_freq[i];
+        uint64_t div = (freq + target / 2u) / target;
+        if (!div) continue;
+        uint64_t actual = freq / div;
+        uint64_t err = actual > target ? actual - target : target - actual;
+        if (err < best_err) { best_err = err; best = freq; }
+    }
+    if (!best || best_err * 100u > target) return -ERANGE;
+    *hz = best;
+    return 0;
+}
+static unsigned k60_qup_sampling(void) {
+    /* QUP_HW_VER_REG is at wrapper base + 0x4 (qcom-geni-se.c:114). */
+    uint32_t ver = k60_read32(&k60.qup, K60_QUP_HW_VER_REG);
+    return ver >= K60_QUP_VERSION_2_5 ? 16u : 32u;
+}
+
+static int k60_stop_engine(void) {
+    k60_irq_mask(NULL, true);
+    k60_uart_write(NULL, 0xe1c, 0); /* G_IRQ_EN */
+    if ((k60_uart_read(NULL, 0x40) & 0x1001u) || (k60_uart_read(NULL, 0xe40) & 3u)) {
+        k60_uart_write(NULL, 0x604, 2); /* G_M_CTRL abort */
+        k60_uart_write(NULL, 0x634, 2); /* G_S_CTRL abort */
+        unsigned i = 0;
+        for (; i < 1000 && (k60_uart_read(NULL, 0x40) & 0x1001u); i++) IODelay(1);
+        if (i == 1000) return -ETIMEDOUT;
+        k60_uart_write(NULL, 0xc58, 1); /* G_TX_RESET */
+        k60_uart_write(NULL, 0xd58, 1); /* G_RX_RESET */
+        for (i = 0; i < 1000 && (k60_uart_read(NULL, 0xe40) & 3u); i++) IODelay(1);
+        if (i == 1000) return -ETIMEDOUT;
+    }
+    k60_uart_write(NULL, 0x618, UINT32_MAX);
+    k60_uart_write(NULL, 0x648, UINT32_MAX);
+    k60_uart_write(NULL, 0xc44, UINT32_MAX);
+    k60_uart_write(NULL, 0xd44, UINT32_MAX);
+    k60.geni.state = QBT_GENI_OFF;
+    k60.geni.rx_busy = k60.geni.tx_busy = false;
+    return 0;
+}
+
+static int k60_prepare_engine(void) {
+    uint8_t *base = (uint8_t *)k60.dma_base;
+    struct qbt_dma_buffer tx = { base + K60_TX_OFFSET, k60.dma_pa + K60_TX_OFFSET, QBT_GENI_TX_SIZE };
+    struct qbt_dma_buffer rx[QBT_GENI_RX_COUNT];
+    for (unsigned i = 0; i < QBT_GENI_RX_COUNT; i++)
+        rx[i] = (struct qbt_dma_buffer){ base + K60_RX_OFFSET + i * QBT_GENI_RX_SIZE,
+                                         k60.dma_pa + K60_RX_OFFSET + i * QBT_GENI_RX_SIZE,
+                                         QBT_GENI_RX_SIZE };
+    struct qbt_geni_ops ops = {
+        .context = NULL, .read = k60_uart_read, .write = k60_uart_write,
+        .barrier = k60_dma_barrier, .sync = k60_dma_sync, .now_ns = k60_now_ns,
+        .irq_mask = k60_irq_mask, .wake_worker = k60_wake, .receive = k60_geni_receive,
+    };
+    int e = qbt_geni_prepare(&k60.geni, &ops, &tx, rx);
+    if (e) return e;
+    uint32_t hz = 0;
+    e = k60_geni_source_hz(K60_BT_INIT_BAUD, k60_qup_sampling(), &hz);
+    if (!e) e = k60_gcc_set_se_rate(hz);
+    if (e) return e;
+    e = qbt_geni_set_rate(&k60.geni, K60_BT_INIT_BAUD, hz, k60_qup_sampling());
+    if (e) return e;
+    k60.baud = K60_BT_INIT_BAUD;
+    return 0;
+}
+
+static int k60_quiesce(void) {
+    uint64_t end = k60_now_ns(NULL) + 40000000ULL;
+    for (;;) {
+        int e = qbt_geni_quiesce(&k60.geni);
+        if (!e) return 0;
+        if (e != -EINPROGRESS && e != -EBUSY) return e;
+        if (!k60.gated) {
+            (void)qbt_geni_service(&k60.geni);
+            if (k60.geni.state == QBT_GENI_FAILED) qbt_fail(k60.core, k60.geni.error);
+        }
+        if (k60.geni.state == QBT_GENI_STOPPED) return 0;
+        if (k60_now_ns(NULL) >= end) return -ETIMEDOUT;
+        uint64_t next = qbt_geni_deadline(&k60.geni);
+        if (next > end) next = end;
+        k60_wait_until(NULL, next);
+    }
+}
