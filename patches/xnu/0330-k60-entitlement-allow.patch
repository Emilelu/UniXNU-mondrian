--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -1510,9 +1510,60 @@
 	return IOTaskHasEntitlement(NULL, entitlement);
 }
 
+/*
+ * 0330: the questions that have actually refused a boot-time operation on
+ * this board. runningboardd and UserEventAgent abort when
+ * setiopolicy_np(IOPOL_TYPE_VFS_ALLOW_LOW_SPACE_WRITES) returns EPERM, and
+ * usermanagerd cannot create its personas without persona_alloc. The Pong
+ * helper needs bindfs to overlay the curated job set. All are refused only
+ * because the AMFI table is NULL, so answer yes for these names and nothing
+ * else, behind a boot-arg, so the widening stays a deliberate act.
+ */
+static bool
+k60_entitlement_allow_enabled(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		uint32_t value = 0;
+
+		enabled = (PE_parse_boot_argn("k60_entitlement_allow", &value,
+		    sizeof(value)) && value != 0) ? 1 : 0;
+		if (enabled) {
+			IOLog("K60ENT allow-list active (amfi %s)\n",
+			    amfi == NULL ? "NULL" : "present");
+		}
+	}
+	return enabled == 1;
+}
+
+static bool
+k60_entitlement_is_allowed(const char *name)
+{
+	static const char * const allowed[] = {
+		"com.apple.private.vfs.allow-low-space-writes",
+		"com.apple.private.persona-mgmt",
+		/* The helper binds the curated job set over LaunchDaemons at boot.
+		 * Without this entry bindfs_mount() refuses with EPERM and launchd
+		 * keeps reading the stock job set. */
+		"com.apple.private.bindfs-allow",
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(allowed) / sizeof(allowed[0]); i++) {
+		if (strcmp(name, allowed[i]) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
 extern "C" boolean_t
 IOTaskHasEntitlement(task_t task, const char *entitlement)
 {
+	if (k60_entitlement_allow_enabled() && k60_entitlement_is_allowed(entitlement)) {
+		return true;
+	}
 	if (task == NULL) {
 		task = current_task();
 	}
