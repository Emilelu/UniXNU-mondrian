+
+/* A component whose classes are already part of __kernel__ (the mini drivers)
+ * must not even run its constructors: OSRuntimeInitializeCPP() registers those
+ * classes and the duplicate makes the whole kext fail to start, so the service
+ * it would have published never appears.  Keep its code for dependent symbol
+ * bindings, skip the load, and let the mini driver own the class.
+ */
+static bool
+k60_skip_prelinked_load(const char *identifier)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		enabled = 0;
+		PE_parse_boot_argn("k60_skip_iosurface", &enabled, sizeof(enabled));
+	}
+	if (!enabled) {
+		return false;
+	}
+	return strcmp(identifier, "com.apple.iokit.IOSurface") == 0;
+}
 #include <libkern/c++/OSLib.h>
 
 #include <IOKit/IOLib.h>
