+/* ==== K60_STAGE18_SWITCH_PERMUTE: SPI switch + 24 pin orders =============== */
+static bool
+k60_stage18_switch_once(void)
+{
+	uint8_t one = 1, v = 0;
+	for (unsigned i = 0; i < 5; i++) {
+		goodix_write(0xC900u, &one, 1);
+		memset(&v, 0, sizeof(v));
+		goodix_read(0xC900u, &v, 1);
+		if (v == 1) return true;
+		sleep_ms(2);
+	}
+	return false;
+}
+
+static void
+k60_stage18_permute(void)
+{
+	static const unsigned base[4] = {16u, 17u, 18u, 19u};
+	printf("K60S18: SPI switch + 24 pin permutations\n");
+	if (!io_supply_on()) { printf("K60S18: supply FAILED\n"); return; }
+	/*
+	 * K60_RESET_TIMING: match the documented Berlin-D power-on sequence
+	 * (references/ruby-bringup/docs/touch-goodix-9916r.md section 3.3):
+	 *     reset low 10 ms -> high 100 ms
+	 * The old 2 ms / 4 ms pair was short enough that the ROM answered
+	 * (dev_confirm and the version block are valid almost immediately) while the
+	 * touch-scan engine had not started yet, so the frame area kept returning
+	 * stale power-on data instead of live frames.
+	 */
+	gpio_output(PIN_RESET, false, PULL_NONE, 6);
+	sleep_ms(10);
+	gpio_output(PIN_RESET, true, PULL_UP, 6);
+	sleep_ms(100);
+	spi_transfer = bitbang_transfer;
+	unsigned n = 0;
+	for (unsigned a = 0; a < 4; a++)
+	for (unsigned b = 0; b < 4; b++) {
+		if (b == a) continue;
+		for (unsigned c = 0; c < 4; c++) {
+			if (c == a || c == b) continue;
+			for (unsigned d = 0; d < 4; d++) {
+				uint8_t v8[8];
+				if (d == a || d == b || d == c) continue;
+				bitbang_in = base[a];
+				bitbang_out = base[b];
+				bitbang_clk = base[c];
+				bitbang_cs = base[d];
+				bitbang_init();
+				bool sw = k60_stage18_switch_once();
+				memset(v8, 0, sizeof(v8));
+				bool ok = goodix_read(0x8140u, v8, sizeof(v8));
+				printf("K60S18: P%u miso=%u mosi=%u clk=%u cs=%u switch=%s ver=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    n, base[a], base[b], base[c], base[d], sw ? "OK" : "fail",
+				    v8[0], v8[1], v8[2], v8[3], v8[4], v8[5], v8[6], v8[7]);
+				n++;
+			}
+		}
+	}
+	bitbang_clk = PIN_CLK;
+	bitbang_cs = PIN_CS;
+}
+/* ==== end K60_STAGE18_SWITCH_PERMUTE ====================================== */
+
+/* ==== K60_STAGE17_SPI_SWITCH: Goodix defaults to I2C; 0xC900=1 -> SPI ====== */
+static void
+k60_stage17_spi_switch(void)
+{
+	printf("K60S17: SPI mode switch (0xC900=0x01, retry 5)\n");
+	if (!io_supply_on()) { printf("K60S17: supply FAILED\n"); return; }
+	/*
+	 * K60_RESET_TIMING: match the documented Berlin-D power-on sequence
+	 * (references/ruby-bringup/docs/touch-goodix-9916r.md section 3.3):
+	 *     reset low 10 ms -> high 100 ms
+	 * The old 2 ms / 4 ms pair was short enough that the ROM answered
+	 * (dev_confirm and the version block are valid almost immediately) while the
+	 * touch-scan engine had not started yet, so the frame area kept returning
+	 * stale power-on data instead of live frames.
+	 */
+	gpio_output(PIN_RESET, false, PULL_NONE, 6);
+	sleep_ms(10);
+	gpio_output(PIN_RESET, true, PULL_UP, 6);
+	sleep_ms(100);
+	printf("K60S17: reset done int=%u\n", gpio_get(PIN_INT));
+	spi_transfer = bitbang_transfer;
+	bitbang_in = 17u; bitbang_out = 16u; bitbang_clk = 18u; bitbang_cs = 19u;
+	bitbang_init();
+	uint8_t one = 1, v = 0;
+	bool sw = false;
+	for (unsigned i = 0; i < 5; i++) {
+		goodix_write(0xC900u, &one, 1);
+		memset(&v, 0, sizeof(v));
+		goodix_read(0xC900u, &v, 1);
+		printf("K60S17: switch try %u -> %02x\n", i, v);
+		if (v == 1) { sw = true; break; }
+		sleep_ms(2);
+	}
+	printf("K60S17: spi switch %s\n", sw ? "OK" : "FAILED");
+	uint8_t v8[8] = {0};
+	bool ok = goodix_read(0x8140u, v8, sizeof(v8));
+	printf("K60S17: gtp 0x8140 -> %s: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    ok ? "ok" : "fail", v8[0], v8[1], v8[2], v8[3], v8[4], v8[5], v8[6], v8[7]);
+	uint8_t b28[28] = {0};
+	bool ok2 = goodix_read(0x10014u, b28, sizeof(b28));
+	printf("K60S17: brl 0x10014 -> %s: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    ok2 ? "ok" : "fail", b28[0], b28[1], b28[2], b28[3], b28[4], b28[5], b28[6], b28[7]);
+}
+/* ==== end K60_STAGE17_SPI_SWITCH ========================================= */
+
+/* ==== K60_STAGE16_GTP_VERSION: M11A is GTP, read 0x8140 not 0x10000 ====== */
+static void
+k60_stage16_gtp_version(void)
+{
+	printf("K60S16: GTP version read (0x8140, 8 bytes)\n");
+	if (!io_supply_on()) { printf("K60S16: supply FAILED\n"); return; }
+	/*
+	 * K60_RESET_TIMING: match the documented Berlin-D power-on sequence
+	 * (references/ruby-bringup/docs/touch-goodix-9916r.md section 3.3):
+	 *     reset low 10 ms -> high 100 ms
+	 * The old 2 ms / 4 ms pair was short enough that the ROM answered
+	 * (dev_confirm and the version block are valid almost immediately) while the
+	 * touch-scan engine had not started yet, so the frame area kept returning
+	 * stale power-on data instead of live frames.
+	 */
+	gpio_output(PIN_RESET, false, PULL_NONE, 6);
+	sleep_ms(10);
+	gpio_output(PIN_RESET, true, PULL_UP, 6);
+	sleep_ms(100);
+	printf("K60S16: reset done int=%u\n", gpio_get(PIN_INT));
+	spi_transfer = bitbang_transfer;
+	bitbang_in = 17u; bitbang_out = 16u; bitbang_clk = 18u; bitbang_cs = 19u;
+	bitbang_init();
+	uint8_t v[8] = {0};
+	bool ok = goodix_read(0x8140u, v, sizeof(v));
+	printf("K60S16: gtp version -> %s: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    ok ? "ok" : "fail", v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+	uint8_t cfg[1] = {0};
+	bool ok2 = goodix_read(0x8047u, cfg, sizeof(cfg));
+	printf("K60S16: cfg checksum -> %s: %02x\n", ok2 ? "ok" : "fail", cfg[0]);
+}
+/* ==== end K60_STAGE16_GTP_VERSION ======================================== */
+
+/* ==== K60_STAGE15_RAIL_VOLT: enable each rail at its own voltage ========== */
+static bool
+k60_enable_rail_uv(const char *name, uint32_t uV)
+{
+	uint32_t addr = rpmh_address(name);
+	if (!addr) { printf("K60S15: no %s\n", name); return false; }
+	if (((addr >> 16) & 15) != 4) { printf("K60S15: %s not VRM\n", name); return false; }
+	uint32_t a[3] = {addr, addr + 4, addr + 8};
+	uint32_t d[3] = {uV, 1, 4};
+	bool ok = rpmh_write(a, d, 3);
+	printf("K60S15: %s @%u mV -> %s\n", name, uV, ok ? "ok" : "FAILED");
+	return ok;
+}
+
+static void
+k60_stage15_rail_volt(void)
+{
+	printf("K60S15: IOVDD ldoc2 @1800, AVDD ldoc3 @2700, ldoc12 @1800\n");
+	k60_enable_rail_uv("ldoc2", 1800);   /* touch IOVDD */
+	k60_enable_rail_uv("ldoc3", 2700);   /* touch AVDD 2.7 V */
+	k60_enable_rail_uv("ldoc12", 1800);
+	sleep_ms(30);
+	/* AVDD load-switch enable as well (FDT goodix,avdd-gpio = GPIO71). */
+	gpio_output(71u, true, PULL_NONE, 6);
+	sleep_ms(15);
+	/*
+	 * K60_RESET_TIMING: match the documented Berlin-D power-on sequence
+	 * (references/ruby-bringup/docs/touch-goodix-9916r.md section 3.3):
+	 *     reset low 10 ms -> high 100 ms
+	 * The old 2 ms / 4 ms pair was short enough that the ROM answered
+	 * (dev_confirm and the version block are valid almost immediately) while the
+	 * touch-scan engine had not started yet, so the frame area kept returning
+	 * stale power-on data instead of live frames.
+	 */
+	gpio_output(PIN_RESET, false, PULL_NONE, 6);
+	sleep_ms(10);
+	gpio_output(PIN_RESET, true, PULL_UP, 6);
+	sleep_ms(100);
+	printf("K60S15: reset done int=%u\n", gpio_get(PIN_INT));
+	spi_transfer = bitbang_transfer;
+	bitbang_in = 17u; bitbang_out = 16u; bitbang_clk = 18u; bitbang_cs = 19u;
+	bitbang_init();
+	printf("K60S15: dev_confirm -> %s\n", goodix_dev_confirm() ? "OK" : "fail");
+	if (!goodix_dev_confirm()) {
+		/* also try the other MISO candidate ordering */
+		bitbang_in = 16u; bitbang_out = 17u;
+		bitbang_init();
+		printf("K60S15: dev_confirm (miso=16) -> %s\n", goodix_dev_confirm() ? "OK" : "fail");
+	}
+}
+/* ==== end K60_STAGE15_RAIL_VOLT ========================================= */
+
+/* ==== K60_STAGE14_RAIL_SETS: which regulator set powers the controller? ==== */
+static bool
+k60_enable_rail(const char *name)
+{
+	uint32_t addr = rpmh_address(name);
+	if (!addr) { printf("K60S14: cmd_db has no %s\n", name); return false; }
+	if (((addr >> 16) & 15) != 4) { printf("K60S14: %s %#x is not VRM\n", name, addr); return false; }
+	uint32_t a[3] = {addr, addr + 4, addr + 8};
+	uint32_t d[3] = {1800, 1, 4};
+	bool ok = rpmh_write(a, d, 3);
+	printf("K60S14: enable %s addr=%#x -> %s\n", name, addr, ok ? "ok" : "FAILED");
+	return ok;
+}
+
+static void
+k60_stage14_rail_sets(void)
+{
+	static const char *sets[4][3] = {
+		{"ldoc2", NULL, NULL},
+		{"ldoc3", "ldoc12", NULL},
+		{"ldoc2", "ldoc12", NULL},
+		{"ldoc2", "ldoc3", "ldoc12"},
+	};
+	for (unsigned s = 0; s < 4; s++) {
+		printf("K60S14: === set %u ===\n", s);
+		for (unsigned i = 0; i < 3; i++)
+			if (sets[s][i]) k60_enable_rail(sets[s][i]);
+		sleep_ms(20);
+		gpio_output(71u, true, PULL_NONE, 6);
+		sleep_ms(15);
+		gpio_output(PIN_RESET, false, PULL_NONE, 6);
+		sleep_ms(10);
+		gpio_output(PIN_RESET, true, PULL_UP, 6);
+		sleep_ms(100);
+		spi_transfer = bitbang_transfer;
+		bitbang_in = 17u; bitbang_out = 16u; bitbang_clk = 18u; bitbang_cs = 19u;
+		bitbang_init();
+		printf("K60S14: set %u dev_confirm -> %s\n", s, goodix_dev_confirm() ? "OK" : "fail");
+	}
+}
+/* ==== end K60_STAGE14_RAIL_SETS ========================================= */
+
+/* ==== K60_STAGE13_POWERED_PERMUTE: 24 pin orders with the rails on ======== */
+static void
+k60_stage13_permute(void)
+{
+	static const unsigned base[4] = {16u, 17u, 18u, 19u};
+	unsigned n = 0;
+	printf("K60S13: powered permutation sweep (write 8xAA to 0x10000, read 8)\n");
+	for (unsigned a = 0; a < 4; a++)
+	for (unsigned b = 0; b < 4; b++) {
+		if (b == a) continue;
+		for (unsigned c = 0; c < 4; c++) {
+			if (c == a || c == b) continue;
+			for (unsigned d = 0; d < 4; d++) {
+				uint8_t tx[8], rx[8];
+				if (d == a || d == b || d == c) continue;
+				bitbang_in = base[a];
+				bitbang_out = base[b];
+				bitbang_clk = base[c];
+				bitbang_cs  = base[d];
+				bitbang_init();
+				memset(tx, 0xAA, sizeof(tx));
+				memset(rx, 0, sizeof(rx));
+				spi_transfer = bitbang_transfer;
+				goodix_write(0x10000u, tx, sizeof(tx));
+				goodix_read(0x10000u, rx, sizeof(rx));
+				printf("K60S13: P%u miso=%u mosi=%u clk=%u cs=%u b=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    n, base[a], base[b], base[c], base[d],
+				    rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7]);
+				n++;
+			}
+		}
+	}
+	bitbang_clk = PIN_CLK;
+	bitbang_cs = PIN_CS;
+}
+/* ==== end K60_STAGE13_POWERED_PERMUTE =================================== */
+
+/* ==== K60_STAGE12_PAD_INT_VOLT: pad mux + INT source + LDO voltage ======== */
+/* Forward declarations: the SPMI helpers are defined in the probe block below. */
+static int k60_spmi_init(void);
+static int k60_spmi_find(uint16_t ppid, uint16_t *out_apid);
+static bool k60_spmi_read(uint16_t apid, uint8_t reg, uint8_t *buf, uint32_t len);
+
+static void
+k60_stage12_checks(void)
+{
+	static const unsigned pads[6] = {16u, 17u, 18u, 19u, 20u, 21u};
+	/* Default state first (reset defaults), then configure to qup4 and re-read. */
+	printf("K60S12: TLMM defaults (before any configuration)\n");
+	for (unsigned i = 0; i < 6; i++) {
+		uint32_t cfg = rd(GPIO_CFG(pads[i]));
+		printf("K60S12: default gpio%u cfg=%#x function=%u pull=%u oe=%u\n",
+		    pads[i], cfg, (cfg >> 2) & 0xfu, cfg & 3u, (cfg >> 9) & 1u);
+	}
+	/* Now mux the four SPI pads to qup4 (function 1) and prove the write took. */
+	for (unsigned i = 0; i < 4; i++)
+		gpio_configure(pads[i], 1u, PULL_NONE, 6, false);
+	printf("K60S12: after gpio_configure(function=1)\n");
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t cfg = rd(GPIO_CFG(pads[i]));
+		printf("K60S12: muxed gpio%u cfg=%#x function=%u pull=%u oe=%u %s\n",
+		    pads[i], cfg, (cfg >> 2) & 0xfu, cfg & 3u, (cfg >> 9) & 1u,
+		    (((cfg >> 2) & 0xfu) == 1u) ? "QUP4_OK" : "MUX_FAILED");
+	}
+	/* H6: is INT low because the controller drives it, or a board pull-down? */
+	gpio_output(71u, false, PULL_NONE, 6);
+	sleep_ms(10);
+	printf("K60S12: AVDD(gpio71)=0 int=%u\n", gpio_get(PIN_INT));
+	gpio_output(71u, true, PULL_NONE, 6);
+	sleep_ms(10);
+	printf("K60S12: AVDD(gpio71)=1 int=%u\n", gpio_get(PIN_INT));
+	/* H3: raw dump of the PM8350C regulator block so the encoding is visible. */
+	if (k60_spmi_init() != 0) {
+		printf("K60S12: SPMI init failed; cannot dump regulators\n");
+		return;
+	}
+	for (uint16_t ppid = 0x2c1u; ppid <= 0x2cdu; ppid++) {
+		uint16_t apid = 0;
+		int owner = k60_spmi_find(ppid, &apid);
+		if (owner < 0) continue;
+		uint8_t r40 = 0, r41 = 0, r45 = 0, r46 = 0, t[2] = {0,0};
+		k60_spmi_read(apid, 4, t, 2);
+		k60_spmi_read(apid, 0x40, &r40, 1);
+		k60_spmi_read(apid, 0x41, &r41, 1);
+		k60_spmi_read(apid, 0x45, &r45, 1);
+		k60_spmi_read(apid, 0x46, &r46, 1);
+		printf("K60S12: ppid=%#x apid=%u owner=%d type=%u sub=%u r40=%#x r41=%#x r45=%#x r46=%#x\n",
+		    ppid, apid, owner, t[0], t[1], r40, r41, r45, r46);
+	}
+}
+/* ==== end K60_STAGE12_PAD_INT_VOLT ====================================== */
+
+/* ==== K60_SPMI_LDO2_PROBE: read-only PMIC arbiter v7 probe ================
+ * Read-only: the only MMIO store is the observer command word (one SPMI read).
+ * No PMIC register is written and RSC is never touched (HR-01).
+ * References: live-fdt.dts:9820-9834 (windows), :10370-10374 (SID=2),
+ * spmi-pmic-arb.c:1396-1424,1555-1558 (v7 offsets), cmd-db.c:24-25.
+ */
+#define K60_SPMI_CORE_PA   0x0c400000UL
+#define K60_SPMI_CNFG_PA   0x0c42d000UL
+#define K60_SPMI_OBS_PA    0x0c440000UL
+#define K60_CMD_DB_PA      0x80860000UL
+
+struct k60_cmd_db_rsc {uint16_t slv,hoff,doff,count,ver,rsv[3];};
+struct k60_cmd_db_hdr {uint32_t version;uint8_t magic[4];struct k60_cmd_db_rsc rsc[8];
+    uint32_t checksum,reserved;uint8_t data[];};
+struct k60_cmd_db_entry {uint8_t id[8];uint32_t prio[2],addr;uint16_t len,off;};
+
+static vm_offset_t k60_spmi_core, k60_spmi_cnfg, k60_spmi_obs;
+static uint32_t k60_spmi_apids; static bool k60_spmi_v7;
+
+static int
+k60_spmi_find(uint16_t ppid, uint16_t *out_apid)
+{
+	uint16_t found = 0xffffu; unsigned owner_best = 7;
+	for (uint32_t i = 0; i < k60_spmi_apids; i++) {
+		uint32_t map = rd(k60_spmi_core + (k60_spmi_v7 ? 0x2000u : 0x900u) + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) continue;
+		unsigned owner = rd(k60_spmi_cnfg + (k60_spmi_v7 ? 0u : 0x700u) + 4u * i) & 7u;
+		if (found == 0xffffu || owner < owner_best) { found = (uint16_t)i; owner_best = owner; }
+	}
+	if (found == 0xffffu) return -1;
+	*out_apid = found; return (int)owner_best;
+}
+
+static bool
+k60_spmi_read(uint16_t apid, uint8_t reg, uint8_t *buf, uint32_t len)
+{
+	vm_offset_t ch = k60_spmi_obs + (k60_spmi_v7 ? 0x20UL : 0x80UL) * apid;
+	uint64_t limit; uint32_t status = 0;
+	clock_interval_to_deadline(2, NSEC_PER_MSEC, &limit);
+	wr(ch, (1u << 27) | ((uint32_t)reg << 4) | ((len - 1u) & 7u));
+	do { status = rd(ch + 8); } while (!(status & 1u) && mach_absolute_time() < limit);
+	if ((status & 0xfu) != 1u) return false;
+	uint32_t d0 = rd(ch + 0x18), d1 = (len > 4u) ? rd(ch + 0x1c) : 0;
+	for (uint32_t i = 0; i < len; i++) buf[i] = (uint8_t)(((i < 4u) ? d0 : d1) >> (8u * (i & 3u)));
+	return true;
+}
+
+static int
+k60_spmi_init(void)
+{
+	k60_spmi_core = ml_io_map(K60_SPMI_CORE_PA, 0x3000);
+	k60_spmi_cnfg = ml_io_map(K60_SPMI_CNFG_PA, 0x4000);
+	k60_spmi_obs  = ml_io_map(K60_SPMI_OBS_PA,  0x8000);
+	if (!k60_spmi_core || !k60_spmi_cnfg || !k60_spmi_obs) {
+		printf("K60SPMI: map failed core=%#lx cnfg=%#lx obs=%#lx\n",
+		    (unsigned long)k60_spmi_core, (unsigned long)k60_spmi_cnfg, (unsigned long)k60_spmi_obs);
+		return -1;
+	}
+	uint32_t ver = rd(k60_spmi_core);
+	k60_spmi_v7 = (ver >= 0x70000000u && ver < 0x80000000u);
+	k60_spmi_apids = rd(k60_spmi_core + 4) & 0x7ffu;
+	printf("K60SPMI: arbiter ver=%#x apids=%u layout=%s\n", ver, k60_spmi_apids,
+	    k60_spmi_v7 ? "v7" : "v5");
+	if (!k60_spmi_apids || k60_spmi_apids > 1024) { printf("K60SPMI: bad apid count\n"); return -1; }
+	return 0;
+}
+
+static void
+k60_spmi_probe(void)
+{
+	if (k60_spmi_init() != 0) return;
+
+	/* Self-check: PON PPID 0x013 must resolve (K60 measured APID 407). */
+	uint16_t pon = 0;
+	int pon_owner = k60_spmi_find(0x013u, &pon);
+	if (pon_owner >= 0) {
+		uint8_t id[2] = {0,0};
+		bool ok = k60_spmi_read(pon, 4, id, 2);
+		printf("K60SPMI: PON apid=%u owner=%d type=%u sub=%u %s\n",
+		    pon, pon_owner, id[0], id[1], ok ? "" : "(read failed)");
+	} else printf("K60SPMI: PON PPID 0x013 NOT FOUND -> arbiter layout wrong\n");
+
+	/* cmd_db: read the "ldoc2" entry if present. */
+	vm_offset_t db = ml_io_map(K60_CMD_DB_PA, 0x10000);
+	if (db) {
+		const struct k60_cmd_db_hdr *h = (const struct k60_cmd_db_hdr *)db;
+		printf("K60SPMI: cmd_db magic=%02x %02x %02x %02x\n",
+		    h->magic[0], h->magic[1], h->magic[2], h->magic[3]);
+		if (h->magic[0] == 0xdb && h->magic[1] == 0x30) {
+			for (unsigned s = 0; s < 8; s++) {
+				const struct k60_cmd_db_rsc *r = &h->rsc[s];
+				if (!r->slv || !r->count || r->count > 512u) continue;
+				const struct k60_cmd_db_entry *e =
+				    (const struct k60_cmd_db_entry *)(h->data + r->hoff);
+				for (unsigned i = 0; i < r->count; i++) {
+					if (e[i].id[0] != 'l' || e[i].id[1] != 'd' || e[i].id[2] != 'o')
+						continue;
+					printf("K60SPMI: cmd_db %.8s addr=%#x hw=%u sid=%u ppid=%#x\n",
+					    e[i].id, e[i].addr, (e[i].addr >> 16) & 0xfu,
+					    (e[i].addr >> 12) & 0xfu, (e[i].addr >> 4) & 0xffu);
+				}
+			}
+		}
+	}
+
+	/* Scan PPID 0x240..0x24F for the PMIC5 LDO block and dump its state. */
+	for (uint16_t ppid = 0x200u; ppid <= 0x2ffu; ppid++) {
+		uint16_t apid = 0;
+		int owner = k60_spmi_find(ppid, &apid);
+		if (owner < 0) continue;
+		uint8_t t[2] = {0,0}, rg = 0xff, vs = 0xff, en = 0xff;
+		k60_spmi_read(apid, 4, t, 2);
+		k60_spmi_read(apid, 0x40, &rg, 1);
+		k60_spmi_read(apid, 0x41, &vs, 1);
+		k60_spmi_read(apid, 0x46, &en, 1);
+		printf("K60SPMI: ppid=%#x apid=%u owner=%d type=%u sub=%u range=%#x vset=%#x enable=%#x %s\n",
+		    ppid, apid, owner, t[0], t[1], rg, vs, en,
+		    (en & 0x80u) ? "LDO_ENABLED" : "LDO_OFF");
+	}
+	printf("K60SPMI: probe done\n");
+}
+/* ==== end K60_SPMI_LDO2_PROBE ========================================== */
+
+static bool
+goodix_checksum_ok(const uint8_t *data, uint32_t length)
+{
+	uint32_t sum = 0;
+	bool blank = true;
+
+	if (length < 2) {
+		return false;
+	}
+	for (uint32_t i = 0; i < length - 2; i++) {
+		sum += data[i];
+		blank &= data[i] == 0 || data[i] == 0xff;
+	}
+	return !blank && (uint16_t)sum == (uint16_t)(data[length - 2] | data[length - 1] << 8);
+}
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void
+touch_reset(void)
+{
+	/*
+	 * Two working implementations both keep the line low for 2 ms, not 10:
+	 *   goodix_brl_hw.c:310 brl_reset
+	 *       gpio_direction_output(reset_gpio, 0);
+	 *       usleep_range(2000, 2100);
+	 *       gpio_direction_output(reset_gpio, 1);
+	 *   hakios.goodix.c:683 touch_reset (PHK110, real GT9916 touch working)
+	 *       gpio_set(PIN_RESET, false);
+	 *       sleep_ms(2);
+	 *       gpio_set(PIN_RESET, true);
+	 * The 10 ms we used came from ruby's section 3.3 prose and matches neither.
+	 * A longer low pulse can land the chip in a different boot path.
+	 */
+	gpio_set(PIN_RESET, false);
+	sleep_ms(2);
+	gpio_set(PIN_RESET, true);
+	sleep_ms(100);
+}
+
+/*
+ * K60_FRAME_HUNT: find the address that actually changes when the panel is
+ * touched instead of assuming where the frame lives.
+ *
+ * Everything about the documented location checks out: the vendor misc block at
+ * IC_INFO+44 reads 08 03 01 00 (= 0x10308), misc+48/50 are both 8, and misc+52/54
+ * are 1440/3200. Reads of 0x10000 and 0x10014 return correct, checksum-valid
+ * data. Only 0x10308 comes back as 00 94 b7 56 4b b4 ce ba -- six identical
+ * samples, head checksum 0x02a0 against a stored 0xbace, which cannot be a live
+ * frame because an idle frame is all zeros.
+ *
+ * So instead of trying other offsets by hand, snapshot 0x10000..0x11000 and
+ * report every 32-byte block that differs from the snapshot. The block that
+ * moves with the finger is the frame, whatever the vendor ABI says.
+ */
+#define HUNT_BASE   0x10000u
+#define HUNT_SIZE   0x1000u
+#define HUNT_BLOCK  32u
+#define HUNT_BLOCKS (HUNT_SIZE / HUNT_BLOCK)
+
+static uint8_t hunt_snap[HUNT_BLOCKS][HUNT_BLOCK];
+static uint8_t hunt_cur[HUNT_BLOCKS][HUNT_BLOCK];
+static bool hunt_have;
+
+static unsigned
+hunt_nonzero(const uint8_t *p, unsigned n)
+{
+	unsigned c = 0;
+	for (unsigned i = 0; i < n; i++) {
+		if (p[i]) {
+			c++;
+		}
+	}
+	return c;
+}
+
+static bool
+hunt_scan(uint8_t out[HUNT_BLOCKS][HUNT_BLOCK])
+{
+	for (unsigned b = 0; b < HUNT_BLOCKS; b++) {
+		if (!goodix_read(HUNT_BASE + b * HUNT_BLOCK, out[b], HUNT_BLOCK)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Print the blocks whose content moved. diff_only=false also prints the map. */
+static void
+hunt_compare(bool diff_only)
+{
+	unsigned changed = 0;
+
+	if (!hunt_scan(hunt_cur)) {
+		printf("K60HUNT: scan failed\n");
+		return;
+	}
+	for (unsigned b = 0; b < HUNT_BLOCKS; b++) {
+		unsigned nz = hunt_nonzero(hunt_cur[b], HUNT_BLOCK);
+		bool diff = hunt_have && memcmp(hunt_snap[b], hunt_cur[b], HUNT_BLOCK) != 0;
+
+		if (diff) {
+			changed++;
+		}
+		if ((diff || !diff_only) && k60_touch_diag >= 1) {
+			printf("K60HUNT: %#06x nz=%02u %s ", HUNT_BASE + b * HUNT_BLOCK, nz,
+			    diff ? "CHANGED" : "       ");
+			for (unsigned i = 0; i < 16; i++) {
+				printf("%02x ", hunt_cur[b][i]);
+			}
+			printf(" ");
+			for (unsigned i = 16; i < HUNT_BLOCK; i++) {
+				printf("%02x ", hunt_cur[b][i]);
+			}
+			printf("\n");
+		}
+	}
+	if (hunt_have) {
+		printf("K60HUNT: %u of %u blocks changed\n", changed, HUNT_BLOCKS);
+	}
+	memcpy(hunt_snap, hunt_cur, sizeof(hunt_snap));
+	hunt_have = true;
+}
+/* ==== end K60_FRAME_HUNT ================================================== */
+
+/*
+ * K60_FRAME_SCAN: locate a checksum-valid GTP frame head anywhere in
+ * 0x10000..0x11000 instead of trusting the misc-derived address.
+ *
+ * Facts that motivated this: 0x10400..0x10fe0 changes on every sweep (the sensor
+ * is sampling), 0x10308 never changes, a write to 0x10308 is silently dropped,
+ * and 0x10320..0x103e0 is a solid block of random-looking bytes. A 26-byte frame
+ * starting at 0x10308 would overlap that block, which cannot be right.
+ *
+ * A real GTP head is unforgeable: sum(data[0..5]) & 0xffff == data[6] | data[7]<<8
+ * (documents section 5.3, and the vendor appends the same 16-bit sum). Slide a
+ * 8-byte window over the whole 4 KiB and report every match.
+ */
+#define SCAN_CHUNK  256u
+
+static void
+k60_frame_scan(void)
+{
+	static uint8_t win[HUNT_SIZE];
+	unsigned hits = 0;
+
+	printf("K60SCAN: reading %#x..%#x for checksum-valid frame heads\n",
+	    HUNT_BASE, HUNT_BASE + HUNT_SIZE);
+	/* Read in 256-byte chunks: a single 4 KiB transfer exceeds what the frame
+	 * reader accepts, and the 32-byte sweeps already prove chunked reads work. */
+	for (unsigned off = 0; off < HUNT_SIZE; off += SCAN_CHUNK) {
+		if (!goodix_read(HUNT_BASE + off, win + off, SCAN_CHUNK)) {
+			printf("K60SCAN: chunk read failed at %#x\n", HUNT_BASE + off);
+			return;
+		}
+	}
+	unsigned zero_heads = 0, touch_heads = 0;
+
+	for (unsigned i = 0; i + 8 <= HUNT_SIZE; i++) {
+		unsigned sum = (unsigned)(win[i + 0] + win[i + 1] + win[i + 2] +
+		    win[i + 3] + win[i + 4] + win[i + 5]) & 0xffffu;
+		unsigned stored = (unsigned)win[i + 6] | ((unsigned)win[i + 7] << 8);
+
+		if (sum != stored) {
+			continue;
+		}
+		/*
+		 * A run of zero bytes trivially satisfies sum==stored (0 == 0), so the
+		 * first sweep reported 394 "heads" that were all padding. Count those
+		 * separately and only report heads that carry a real event byte.
+		 */
+		if (sum == 0 && stored == 0) {
+			zero_heads++;
+			continue;
+		}
+		if (win[i + 0] & GOODIX_STATUS_TOUCH) {
+			touch_heads++;
+		}
+		if (hits < 24) {
+			printf("K60SCAN: head @%#06x %02x %02x %02x %02x %02x %02x %02x %02x  event=%02x n=%u sum=%04x%s\n",
+			    HUNT_BASE + i,
+			    win[i + 0], win[i + 1], win[i + 2], win[i + 3],
+			    win[i + 4], win[i + 5], win[i + 6], win[i + 7],
+			    win[i + 0], win[i + 2] & 0x0fu, sum,
+			    (win[i + 0] & GOODIX_STATUS_TOUCH) ? " TOUCH" : "");
+		}
+		hits++;
+	}
+	printf("K60SCAN: %u nonzero heads (%u with TOUCH bit) in %u bytes; %u all-zero runs skipped\n",
+	    hits, touch_heads, HUNT_SIZE, zero_heads);
+	/* Raw window around the vendor-derived frame address, so the bytes that the
+	 * misc block points at can be read directly instead of through a filter. */
+	for (unsigned w = 0x102e0u; w < 0x10340u; w += 16) {
+		unsigned off = w - HUNT_BASE;
+		printf("K60SCAN: raw %#06x %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    w,
+		    win[off + 0], win[off + 1], win[off + 2], win[off + 3],
+		    win[off + 4], win[off + 5], win[off + 6], win[off + 7],
+		    win[off + 8], win[off + 9], win[off + 10], win[off + 11],
+		    win[off + 12], win[off + 13], win[off + 14], win[off + 15]);
+	}
+}
+/* ==== end K60_FRAME_SCAN ================================================== */
+
+/*
+ * K60_STAGE21_PMIC: checklist items 1-3 from the reference debugging list.
+ *
+ * references/ruby-bringup/docs/touch-goodix-9916r.md section 8:
+ *   1. I2C5 idle SCL/SDA both 1; otherwise check pinmux/input enable first.
+ *   2. Read LDO3/LDO2 EN/VOUT; the old values are usually 0x80/0xB0, 0x80/0x40.
+ *   3. After writing VOUT the read-back must be 0x3A/0xD0; after enabling EN 0xC4.
+ *
+ * Section 3.2 records the failure this catches: writing only the enable bit
+ * leaves the analog rail undervolted and the controller never starts, which is
+ * exactly the "dev_confirm and the version block are fine but no frame ever
+ * appears" signature this board shows.
+ *
+ * The RPMh helper in this file can only write, so the read-back has to come from
+ * SPMI, which reports the PMIC's real registers. An earlier attempt looked for a
+ * single hard-coded PPID and concluded "not found"; sweeping the whole range and
+ * printing what actually answers is the documented first step instead of a guess.
+ */
+static void
+k60_stage21_pmic(void)
+{
+	unsigned found = 0;
+
+	printf("K60S21: checklist 1-3, SPMI sweep for the PMIC\n");
+	if (k60_spmi_init() != 0) {
+		printf("K60S21: SPMI init failed, cannot read any rail\n");
+		return;
+	}
+	/* Item 1: the arbiter itself must answer before anything else is meaningful. */
+	printf("K60S21: SPMI arbiter APIDs=%u\n", (unsigned)k60_spmi_apids);
+	for (uint16_t ppid = 0x000u; ppid <= 0x3ffu; ppid++) {
+		uint16_t apid = 0;
+
+		if (k60_spmi_find(ppid, &apid) < 0) {
+			continue;
+		}
+		found++;
+		{
+			uint8_t r[16];
+			bool ok = k60_spmi_read(apid, 0x00u, r, sizeof(r));
+
+			printf("K60S21: ppid=%#05x apid=%u %s %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    ppid, apid, ok ? "ok " : "ERR",
+			    r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7],
+			    r[8], r[9], r[10], r[11], r[12], r[13], r[14], r[15]);
+		}
+	}
+	printf("K60S21: %u PPIDs answered\n", found);
+	/*
+	 * Checklist item 2: dump the PMIC5 LDO block.
+	 *
+	 * The first sweep capped its output at 24 entries and the LDO range never
+	 * appeared; sweeping 0x4000..0x4fff and printing registers 0x40..0x7f shows
+	 * the enable and voltage set points. Reference expectation from
+	 * references/ruby-bringup/docs/touch-goodix-9916r.md section 8 item 2:
+	 *   "Read LDO3/LDO2 EN/VOUT; the old values are usually 0x80/0xB0, 0x80/0x40."
+	 * Item 3: "After writing VOUT the read-back must be 0x3A/0xD0; after enabling
+	 * EN 0xC4."
+	 */
+	/*
+	 * K60S21_LDO_RANGE: PPIDs are 12 bits wide.
+	 *
+	 * k60_spmi_find compares ((map >> 8) & 0xfff) against the requested PPID, so
+	 * anything at or above 0x1000 can never match; the previous sweep of
+	 * 0x4000..0x4fff therefore printed nothing at all. The PMIC peripherals live
+	 * in the SID-tagged range: SID 3 (pm8350c) answered with 52 entries between
+	 * 0x301 and 0x3fe, and pm8350c_l2 -- the touch IOVDD rail Android reports as
+	 * enabled 1.8 V -- is one of them.
+	 */
+	printf("K60S21: SID2/SID3 PMIC peripherals, registers 0x30..0x5f\n");
+	for (uint16_t ppid = 0x200u; ppid <= 0x3ffu; ppid++) {
+		uint16_t apid = 0;
+		uint8_t r[64];
+
+		if (k60_spmi_find(ppid, &apid) < 0) {
+			continue;
+		}
+		/*
+		 * K60S21_SMALL_READS: the SPMI read helper carries the length in a 3-bit
+		 * field and unpacks with (i & 3), so a single call can only deliver 8 real
+		 * bytes; asking for 48 returned the same 4 bytes twelve times (the last
+		 * sweep printed "03 00 40 30" over and over). Read one register at a time
+		 * instead, which is what makes the values meaningful.
+		 */
+		{
+			uint8_t en = 0, vlo = 0, vhi = 0, t1 = 0, t2 = 0, t3 = 0;
+
+			if (!k60_spmi_read(apid, 0x46u, &en, 1) ||
+			    !k60_spmi_read(apid, 0x40u, &vlo, 1) ||
+			    !k60_spmi_read(apid, 0x41u, &vhi, 1) ||
+			    !k60_spmi_read(apid, 0x45u, &t1, 1) ||
+			    !k60_spmi_read(apid, 0x47u, &t2, 1) ||
+			    !k60_spmi_read(apid, 0x48u, &t3, 1)) {
+				continue;
+			}
+			/*
+			 * Report only peripherals that look like an LDO: enable control
+			 * carrying bit 6, as the reference debugging list describes
+			 * ("EN/VOUT; the old values are usually 0x80/0xB0, 0x80/0x40").
+			 */
+			if (!(en & 0x40u)) {
+				continue;
+			}
+			printf("K60S21: LDO PPID=%#05x apid=%u en=%02x vout=%02x%02x st45=%02x st47=%02x st48=%02x\n",
+			    ppid, apid, en, vhi, vlo, t1, t2, t3);
+		}
+	}
+}
+/* ==== end K60_STAGE21_PMIC ================================================ */
+
+/*
+ * K60_MULTI_ADDR: compare every address the vendor misc block exposes against
+ * the documented frame layout (references/ruby-bringup/docs/touch-goodix-9916r.md
+ * section 5.3), so the choice is made from evidence instead of from a hunch.
+ *
+ * Documented head layout:
+ *   [0] event, 0x80 = GOODIX_TOUCH_EVENT
+ *   [2] touch_num = value & 0x0f
+ *   [6..7] head checksum = sum(data[0..5]) & 0xffff
+ * A real frame therefore has to satisfy the checksum and, when a finger is down,
+ * carry 0x80 at [0]. Printing all four candidates with that verdict next to each
+ * makes the right one unambiguous.
+ */
+static void
+k60_multi_addr_probe(void)
+{
+	static const struct {
+		uint32_t addr;
+		const char *name;
+	} cand[] = {
+		{ 0x10174u, "misc+0 " },
+		{ 0x10218u, "misc+12" },
+		{ 0x10308u, "misc+44" },
+		{ 0x10400u, "misc+24" },
+	};
+
+	printf("K60MULTI: comparing %u documented-layout candidates\n",
+	    (unsigned)(sizeof(cand) / sizeof(cand[0])));
+	for (unsigned i = 0; i < sizeof(cand) / sizeof(cand[0]); i++) {
+		uint8_t b[8];
+		unsigned sum, stored;
+
+		if (!goodix_read(cand[i].addr, b, sizeof(b))) {
+			printf("K60MULTI: %s %#07x read FAILED\n", cand[i].name, cand[i].addr);
+			continue;
+		}
+		sum = (unsigned)(b[0] + b[1] + b[2] + b[3] + b[4] + b[5]) & 0xffffu;
+		stored = (unsigned)b[6] | ((unsigned)b[7] << 8);
+		printf("K60MULTI: %s %#07x %02x %02x %02x %02x %02x %02x %02x %02x  event=%u csum=%s n=%u\n",
+		    cand[i].name, cand[i].addr,
+		    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+		    (b[0] & 0x80u) ? 1u : 0u,
+		    (sum == stored) ? "ok " : "BAD",
+		    (unsigned)(b[2] & 0x0fu));
+	}
+}
+/* ==== end K60_MULTI_ADDR ================================================== */
+
+/*
+ * K60_STAGE22_LDO: read the pm8350c LDO rails that cmd_db names.
+ *
+ * The addresses are already recorded for this board (docs/HANDOFF.md:1626,1632):
+ *   ldoc1  = 0x42b00 (sid2)   ldoc2  = 0x42c00 (sid2, ppid 0xc0)   <- touch IOVDD
+ *   ldoc3  = 0x40f00 (sid0)   ldoc8  = 0x42d00 (sid2)
+ *   ldoc10 = 0x42200 (sid2)   ldoc11 = 0x43300 (sid3)
+ *   ldoc12 = 0x42e00 (sid2)
+ *
+ * The pass criteria are recorded too:
+ *   docs/BACKLOG.md:208  PMIC5 PLDO 1.8 V encodes as range=0, vset=0x25
+ *                        (a historical measurement of range=0x8 vset=0x7 was wrong)
+ *   reference section 8  EN reads 0x80 before enabling and 0xC4 after; VOUT reads
+ *                        0x3A/0xD0 once written
+ *
+ * Reading one register at a time is required: the SPMI helper carries the length
+ * in a three-bit field and unpacks with (i & 3), so a wide read only repeats the
+ * first four bytes.
+ */
+static void
+k60_stage22_ldo(void)
+{
+	static const struct {
+		const char *name;
+		uint16_t ppid;
+	} rail[] = {
+		{ "ldoc1 ", 0x0b0u }, { "ldoc2 ", 0x0c0u }, { "ldoc8 ", 0x0d0u },
+		{ "ldoc10", 0x220u }, { "ldoc12", 0x2e0u }, { "ldoc11", 0x300u },
+	};
+
+	printf("K60S22: pm8350c LDO rails by cmd_db ppid\n");
+	if (k60_spmi_init() != 0) {
+		printf("K60S22: SPMI init failed\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(rail) / sizeof(rail[0]); i++) {
+		uint16_t apid = 0;
+		uint8_t en = 0, vrange = 0, vset = 0;
+
+		if (k60_spmi_find(rail[i].ppid, &apid) < 0) {
+			printf("K60S22: %s ppid=%#05x NOT FOUND\n", rail[i].name, rail[i].ppid);
+			continue;
+		}
+		if (!k60_spmi_read(apid, 0x46u, &en, 1) ||
+		    !k60_spmi_read(apid, 0x40u, &vrange, 1) ||
+		    !k60_spmi_read(apid, 0x41u, &vset, 1)) {
+			printf("K60S22: %s apid=%u read FAILED\n", rail[i].name, apid);
+			continue;
+		}
+		/*
+		 * Verdict against the recorded encoding: 1.8 V is range 0 / vset 0x25,
+		 * EN bit6 is the enable and bit7 is the regulator-OK flag.
+		 */
+		printf("K60S22: %s ppid=%#05x apid=%u en=%02x(ok=%u en=%u) range=%02x vset=%02x -> %s\n",
+		    rail[i].name, rail[i].ppid, apid, en,
+		    (en >> 7) & 1u, (en >> 6) & 1u, vrange, vset,
+		    (vrange == 0 && vset == 0x25) ? "1.8V OK" : "NOT 1.8V");
+	}
+}
+/* ==== end K60_STAGE22_LDO ================================================= */
+
+/*
+ * K60_STAGE23_LDOSCAN: find the touch rails by their voltage encoding instead of
+ * by the cmd_db ppid.
+ *
+ * Why this approach: cmd_db says ldoc1 is ppid 0xb0 and ldoc2 is ppid 0xc0, but a
+ * direct lookup found apid 72 for 0xb0 while 0xc0 did not answer at all (see
+ * stage22). So the ppid derivation is not reliable for every rail, and guessing
+ * again would just repeat that mistake.
+ *
+ * The pass criteria are recorded locally:
+ *   docs/BACKLOG.md:208  PMIC5 PLDO 1.8 V is range=0 / vset=0x25
+ *   reference section 8  EN reads 0x80 before enabling, 0xC4 after
+ *
+ * This sweep prints every peripheral whose voltage set point differs from the
+ * all-ones idle value, with the decoded verdict, so the 1.8 V rail identifies
+ * itself.
+ */
+static void
+k60_stage23_ldoscan(void)
+{
+	unsigned found = 0, shown = 0;
+
+	printf("K60S23: sweep every PPID for a configured LDO\n");
+	if (k60_spmi_init() != 0) {
+		printf("K60S23: SPMI init failed\n");
+		return;
+	}
+	for (uint16_t ppid = 0x000u; ppid <= 0xfffu; ppid++) {
+		uint16_t apid = 0;
+		uint8_t en = 0, vrange = 0, vset = 0;
+
+		if (k60_spmi_find(ppid, &apid) < 0) {
+			continue;
+		}
+		found++;
+		if (!k60_spmi_read(apid, 0x46u, &en, 1) ||
+		    !k60_spmi_read(apid, 0x40u, &vrange, 1) ||
+		    !k60_spmi_read(apid, 0x41u, &vset, 1)) {
+			continue;
+		}
+		/*
+		 * 0xff / 0xff is the unpopulated pattern seen on almost every
+		 * peripheral; anything else has a real set point.
+		 */
+		if (vrange == 0xffu && vset == 0xffu) {
+			continue;
+		}
+		if (vrange == 0x00u && vset == 0x00u && en == 0x00u) {
+			continue;
+		}
+		shown++;
+		printf("K60S23: ppid=%#05x apid=%u en=%02x(ok=%u en=%u) range=%02x vset=%02x%s\n",
+		    ppid, apid, en, (en >> 7) & 1u, (en >> 6) & 1u, vrange, vset,
+		    (vrange == 0x00u && vset == 0x25u) ? "  <== 1.8V MATCH" : "");
+	}
+	printf("K60S23: %u peripherals answered, %u carry a set point\n", found, shown);
+}
+/* ==== end K60_STAGE23_LDOSCAN ============================================= */
+
+/*
+ * K60_HM_PEAK: track the peak of the 0x10400 capacitance field.
+ *
+ * The sweep at 0x104a0 shows a stream of 16-bit LE values (0x2848 0x2870 ...)
+ * that change on every sample; the whole 0x10420..0x10760 block does. That is
+ * the AFE's per-node reading. A real finger press makes one node spike well
+ * above its neighbours and the peak index tracks the finger; a purely floating
+ * field only drifts slowly. This distinguishes "the chip is not sensing a touch"
+ * from "the chip senses it but never writes a formatted report", which decides
+ * the next step instead of guessing it.
+ */
+#define HM_BASE   0x10400u
+#define HM_NODES  256u   /* 512 bytes, 256 x 16-bit nodes */
+
+static void
+k60_hm_peak_sample(void)
+{
+	uint8_t buf[512];
+	unsigned peak_i = 0;
+	uint16_t peak_v = 0;
+	unsigned sum = 0;
+
+	if (!goodix_read(HM_BASE, buf, sizeof(buf))) {
+		return;
+	}
+	for (unsigned i = 0; i < HM_NODES; i++) {
+		uint16_t v = (uint16_t)buf[2 * i] | ((uint16_t)buf[2 * i + 1] << 8);
+
+		sum += v;
+		if (v > peak_v) {
+			peak_v = v;
+			peak_i = i;
+		}
+	}
+	if (k60_touch_diag >= 2) {
+		printf("goodix: HMPEAK node=%u val=%u avg=%u int=%u\n",
+		    peak_i, peak_v, sum / HM_NODES, gpio_get(PIN_INT) ? 1u : 0u);
+	}
+}
