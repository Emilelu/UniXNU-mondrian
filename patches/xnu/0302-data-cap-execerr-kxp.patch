+/* ---- 0302: exec diagnostics (pid->path map + bounded exec-error printer) ---- */
+#define K60_PIDPATH_SLOTS 128
+static int k60_pidpath_pid[K60_PIDPATH_SLOTS];
+static char k60_pidpath_path[K60_PIDPATH_SLOTS][64];
+static _Atomic unsigned int k60_pidpath_seq = 0;
+
+const char *
+k60_exec_path_for_pid(int pid)
+{
+	int k60_i;
+	for (k60_i = 0; k60_i < K60_PIDPATH_SLOTS; k60_i++) {
+		if (k60_pidpath_pid[k60_i] == pid && k60_pidpath_path[k60_i][0] != '\0') {
+			return k60_pidpath_path[k60_i];
+		}
