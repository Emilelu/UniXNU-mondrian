/*
 * Route A-18 (xnu-11417 / darwin24): early-boot breadcrumbs for the K60.
 *
 * A fault before arm_vm_init() is silent: the ramoops ring is not mapped until
 * pmap exists and the loader has already left boot services.
 *
 * v1 wrote eight u64 slots into the last page of the ramoops carveout
 * (PA 0xA73FF000). Flashed 2026-11-01 02:14: the board parked after the loader
 * green bar with no USB and no reset, and a hang gives no way to read DRAM back.
 * v2 paints 32x32 ARGB squares straight into the frame buffer, which Entry.S
 * already proves writable from EL1 and which is visible without Android.
 *
 * Stages: 0 start_first_cpu (x0 = boot_args on entry), 1 bootstrap tables,
 * 2 before SCTLR_EL1, 3 MMU on, 4 arm_init(), 5 PE_init_platform,
 * 6 before arm_vm_init(). Stage 7 is the ramoops console line, because the V=P
 * mapping the squares rely on is dropped inside arm_vm_init().
 *
 * The 6 MiB of frame buffer the squares touch is added to the V=P L1 table as
 * Device-nGnRnE blocks (0xB8000000, 3 x 2 MiB). x20 (boot_args PA) and x21
 * (must stay zero) are never written; x27/x28 carry Video base/stride.
 */
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -564,6 +564,91 @@
 .endmacro
 
 /*
+ * K60 bring-up breadcrumbs: one 32x32 square per stage, drawn straight into the
+ * UEFI frame buffer.
+ *
+ * Why the frame buffer and not a physical scratch page: on 2026-11-01 the
+ * variant that wrote markers to the last page of the ramoops carveout
+ * (PA 0xA73FF000) was flashed and the board parked after the loader's green bar
+ * with no USB and no reset.  A hang leaves no way to read DRAM back, and the
+ * first store to that page is the prime suspect.  The frame buffer is the one
+ * channel already proven writable from EL1 - Entry.S paints its green bar there
+ * - and it is visible without Android ever coming back.
+ *
+ * Geometry matches Entry.S: ARGB words, stride from boot_args.
+ *   x27 = Video.v_baseAddr, x28 = Video.v_rowBytes  (loaded at entry from x0)
+ * Square id sits at (64, 240 + 80*id).  From stage 3 on the MMU is enabled, so
+ * create_device_blocks() also maps the 6 MiB of frame buffer the squares touch;
+ * that mapping only lives in the V=P tables, so stage 7 has to go to the
+ * ramoops console instead.
+ *
+ * Both registers are untouched by the rest of start.s, and x20 (boot_args PA)
+ * and x21 (must stay zero) are never written.
+ */
+#define K60_FB_X        64
+#define K60_FB_Y0       240
+#define K60_FB_STEP     80
+#define K60_FB_SIZE     32
+#define K60_FB_BLOCK    0xB8000000
+#define K60_FB_BLOCKS   3
+
+.macro K60_FB_STAGE
+	cbz	x27, 9f
+	mov	w16, #(K60_FB_Y0 + (K60_FB_STEP * ($0)))
+	mul	x16, x28, x16
+	add	x16, x16, x27
+	add	x16, x16, #(K60_FB_X * 4)
+	mov	w17, #(($1) & 0xffff)
+	movk	w17, #((($1) >> 16) & 0xffff), lsl #16
+	mov	x18, #(K60_FB_SIZE)
+1:	mov	x19, #(K60_FB_SIZE / 2)
+2:	stp	w17, w17, [x16], #8
+	subs	x19, x19, #1
+	b.ne	2b
+	sub	x16, x16, #(K60_FB_SIZE * 4)
+	add	x16, x16, x28
+	subs	x18, x18, #1
+	b.ne	1b
+	dsb	sy
+9:
+.endmacro
+
+/*
+ * create_device_blocks
+ *
+ * Maps $2 consecutive 2 MiB blocks Device-nGnRnE for a V=P range that
+ * create_bootstrap_mapping() does not cover.
+ *   arg0 - virtual/physical base (2 MiB aligned)
+ *   arg1 - L1 table address
+ *   arg2 - number of 2 MiB blocks (register, it is decremented)
+ *   arg3 - free page pointer (advanced past the L2 page it uses)
+ *   arg4..arg7 - scratch
+ */
+.macro create_device_blocks
+	add	$3, $3, PGBYTES
+	add	$4, x25, #(BOOTSTRAP_TABLE_BYTES >> 12), lsl #12
+	cmp	$3, $4
+	b.hs	Lbootstrap_tables_exhausted
+	create_l1_table_entry	$0, $1, $3, $4, $5, $6
+	and	$4, $0, #(ARM_TT_L2_INDEX_MASK)
+	lsr	$4, $4, #(ARM_TT_L2_SHIFT)
+	lsl	$4, $4, #(TTE_SHIFT)
+	add	$4, $3, $4
+	mov	$5, #(ARM_TTE_VALID)
+	orr	$5, $5, #(ARM_TTE_BLOCK_AF)
+	orr	$5, $5, #(ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE))
+	MOV64	$6, ARM_TTE_BLOCK_NX
+	orr	$5, $5, $6
+	and	$6, $0, #(ARM_TTE_BLOCK_L2_MASK)
+	orr	$5, $5, $6
+	mov	$7, #(ARM_TT_L2_SIZE)
+10:	str	$5, [$4], #(1 << TTE_SHIFT)
+	add	$5, $5, $7
+	subs	$2, $2, #1
+	b.ne	10b
+.endmacro
+
+/*
  * _start_first_cpu
  * Cold boot init routine.  Called from __start
  *   x0 - Boot args
@@ -572,6 +657,15 @@
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+	/*
+	 * K60 breadcrumb stage 0 (blue).  x0 is the boot_args physical address
+	 * on entry; Video is at +0x28 and v_rowBytes at +0x38 (boot.h).  Keeping
+	 * the two values in x27/x28 avoids re-reading boot_args under the MMU.
+	 */
