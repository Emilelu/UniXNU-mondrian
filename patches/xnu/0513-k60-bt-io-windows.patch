+/* 0513: ml_io_map() allocates from io_submap, which is 8 MiB for the whole
+ * kernel (osfmk/arm/io_map.c:65), and every consumer on this board shares it.
+ * The BT ladder asks for 2 MiB (GCC), 1 MiB (TLMM) and 1 MiB (apps SMMU); by
+ * the time the ladder runs the submap is already nearly full, so a TLMM
+ * request returned KERN_NO_SPACE and __kmem_failed_panic() took the kernel
+ * down: kmem_alloc(..., 1048576, 0x100021): failed with 3 (2026-11-16, d4).
+ * The unmappable variant charges kernel_map instead and is the same escape
+ * patches/xnu/0613 already uses for the 32 MiB ADSP windows.
+ * Note: main's 0621 (k60-io-submap-budget) answers the same panic from the
+ * other side - it raises IO_MAP_SIZE from 8 MiB to 32 MiB. The two are not
+ * two halves of one fix: each stands alone, and only one may ride an image. */
+#define K60_WIMG_IO 0x7u /* VM_WIMG_IO: coherent | not-cacheable | guarded */
+
+static int k60_map_big(struct k60_region *r, uint64_t phys, size_t bytes) {
+    if (r->va) return 0;
+    r->phys = phys;
+    r->bytes = bytes;
+#ifdef KERNEL
+    r->va = (volatile uint32_t *)ml_io_map_unmappable((vm_offset_t)phys,
+                                                      (vm_size_t)bytes,
+                                                      K60_WIMG_IO);
+#else
+    r->va = (volatile uint32_t *)ml_io_map(phys, bytes);
+#endif
+    return r->va ? 0 : -ENOMEM;
+}
