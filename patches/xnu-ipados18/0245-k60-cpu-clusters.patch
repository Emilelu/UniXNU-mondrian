/*
 * Route A-18 (xnu-11417 / darwin24): size the PONG cluster arrays for SM8475.
 *
 * The SM8475 hardware MPIDRs are flat: 0x000..0x700, Aff1 = core index. The
 * Android tree carries exactly these reg values and boots all eight cores
 * through PSCI, and this firmware refuses every CPU_ON target outside the
 * table (bc9). ml_parse_cpu_topology() derives the cluster from
 * MPIDR_CLUSTER_ID(reg) = Aff1, so eight distinct Aff1 values mean eight
 * topology groups here - the familiar 4/3/1 A510/A710/X2 grouping comes from
 * L2/L3 cache sharing (Android's sysfs cluster_id), not from the MPIDR.
 *
 * An earlier revision of this patch set 3, paired with packed reg values
 * (0x000-0x003 / 0x100-0x102 / 0x200). bc11 disproved that reading: cores
 * woken by the firmware matched cpu data only when their real MPIDR appeared
 * in the ADT, and the flat table is what the firmware itself enforces.
 *
 * pong's board config declared MAX_CPU_CLUSTERS 1, which was never exercised
 * because pong has no device evidence for darwin24. ml_parse_cpu_topology()
 * asserts both phys_cluster_id <= MAX_CPU_CLUSTER_PHY_ID (= clusters - 1) and
 * num_clusters < MAX_CPU_CLUSTERS, so the third CPU panicked before any
 * console existed - indistinguishable from a silent reset.
 *
 * The device tree carries the matching MPIDR values; that half lives in
 * dts/mondrian.dts, not here.
 */
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -274,7 +274,15 @@
 #include <pexpert/arm64/PONG.h>
 #define MAX_L2_CLINE                   6
 #define MAX_CPUS                       8
-#define MAX_CPU_CLUSTERS               1
+/*
+ * The SM8475 MPIDRs are flat (0x000..0x700, Aff1 = core index), so
+ * MPIDR_CLUSTER_ID() yields eight values and the topology parser needs room
+ * for all of them. The 4/3/1 A510/A710/X2 grouping is cache topology, not
+ * MPIDR affinity; it can be described later through the scheduler's own
+ * channels. With 1 here ml_parse_cpu_topology() panicked on the third CPU,
+ * before any console existed, which looked exactly like a silent reset.
+ */
+#define MAX_CPU_CLUSTERS               8
 #define CORE_NCTRS                     8 /* Unused placeholder: KPC disabled */
 #endif /* ARM64_BOARD_CONFIG_PONG */
