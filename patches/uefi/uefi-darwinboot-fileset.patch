+  UINTN        Offset;
+  UINTN        End;
+  UINTN        Index;
+  UINTN        Other;
+  UINTN        OuterOffset;
+  UINTN        OuterEnd;
+  UINTN        FileOffset;
+  UINT64       FileOffset64;
+  UINT32       NameOffset;
+  UINT32       Count;
+  UINT32       Command;
+  UINT32       Length;
+  UINT32       FileType;
+  UINT32       SubType;
