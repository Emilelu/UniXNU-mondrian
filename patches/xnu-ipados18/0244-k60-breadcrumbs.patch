+/*
+ * K60 bring-up breadcrumbs, second half (start.s draws stages 0..3).
+ *
+ * Same geometry as the assembly: a 32x32 ARGB square, first column at x=64 for
+ * stages 0..6, second column at x=160 for the stages inside arm_vm_init().
+ * start.s maps 6 MiB of frame buffer into the V=P bootstrap tables, so marks
+ * work until arm_vm_init() switches TTBR0 away from them
+ * (set_mmu_ttb_alternate); nothing later can be painted.
+ */
+#define K60_FB_STAGE_X   64
+#define K60_FB_STAGE_Y   240
+#define K60_FB_STAGE_DY  80
+#define K60_FB_SIZE      32
+
+void
+k60_fb_mark(boot_args *args, unsigned int x0, unsigned int y0, uint32_t colour)
+{
+	uint32_t *fb = (uint32_t *)(uintptr_t)args->Video.v_baseAddr;
+	const uint32_t stride = args->Video.v_rowBytes / sizeof(uint32_t);
+	uint32_t y, x;
+
+	if (fb == NULL || stride == 0 || args->Video.v_depth != 32) {
+		return;
+	}
+	for (y = 0; y < K60_FB_SIZE; y++) {
+		for (x = x0; x < x0 + K60_FB_SIZE; x++) {
+			fb[((y0 + y) * stride) + x] = colour;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+#define K60_FB_STAGE(args, id, colour) \
+	k60_fb_mark((args), K60_FB_STAGE_X, \
+	    K60_FB_STAGE_Y + (K60_FB_STAGE_DY * (id)), (colour))
+#endif /* PONG */
