+/* E-FDT-02: bt_qca6490 supply properties and rpmh-regulator-smpb10 /
+ * regulator-pm8350-s10 (1.8 V fixed) under /soc/rsc@17a00000.  This file does
+ * not touch any regulator or RSC register. */
+#define K60_BT_VDD_IO_UV            1800000u
+/* Android source of these blobs is /vendor/firmware (preferred) or
+ * modem_a/modem_b image/qca6490/.  At runtime the iOS Data addon path below
+ * holds the verified copies; see EVIDENCE.md §4.4. */
+#define K60_BT_FIRMWARE_ROOT        "/private/var/ngpu/firmware/qca"
