+/* ------------------------------------------------------------------------- */
+/* The 14 qbt_platform callbacks                                              */
+/* ------------------------------------------------------------------------- */
+
+static void *k60_allocate(void *ctx, size_t n) { (void)ctx; return IOMallocData(n); }
+static void k60_release(void *ctx, void *p, size_t n) { (void)ctx; IOFreeData(p, n); }
+
+static void k60_pump(void *ctx) {
+    (void)ctx;
+    if (__atomic_exchange_n(&k60.rx_wake, 0u, __ATOMIC_ACQ_REL) && k60.powered) {
+        qbt_rx_wake(k60.core);
+        /* GPIO consumed the first wake byte 0xFD while the UART was gated. */
+        const uint8_t wake = 0xfd;
+        (void)qbt_receive(k60.core, &wake, 1);
+    }
+    if (!k60.gated && k60.geni.state != QBT_GENI_OFF) {
+        if (qbt_geni_service(&k60.geni)) k60_wake(NULL);
+        if (k60.geni.state == QBT_GENI_FAILED) qbt_fail(k60.core, k60.geni.error);
+    }
+    if (k60.gated && k60_rx_wake_pending()) {
+        /* Fallback for a missed TLMM interrupt. */
+        volatile uint32_t *r = k60.tlmm.va + K60_TLMM_GPIO_CFG(K60_BT_RX_WAKE_GPIO) / 4u;
+        r[3] = 0;
+        __atomic_store_n(&k60.rx_wake, 1u, __ATOMIC_RELEASE);
+    }
+}
+
+static void k60_wait_until(void *ctx, uint64_t deadline) {
+    (void)ctx;
+#ifdef KERNEL
+    if (__atomic_exchange_n(&k60.pending, 0u, __ATOMIC_ACQ_REL)) return;
+    if (deadline == UINT64_MAX) assert_wait((event_t)&k60.pending, THREAD_UNINT);
+    else {
+        uint64_t absolute;
+        nanoseconds_to_absolutetime(deadline, &absolute);
+        assert_wait_deadline((event_t)&k60.pending, THREAD_UNINT, absolute);
+    }
+    if (__atomic_exchange_n(&k60.pending, 0u, __ATOMIC_ACQ_REL))
+        clear_wait(current_thread(), THREAD_AWAKENED);
+    else thread_block(THREAD_CONTINUE_NULL);
+#else
+    (void)deadline;
+#endif
+}
+
+/* clock(false) must only succeed with a real RX wake source armed. */
+static int k60_clock(void *ctx, bool enabled) {
+    (void)ctx;
+    if (enabled) {
+        if (!k60.gated) return 0;
+        if (k60_serial_clock(true)) return -EIO;
+        k60_disarm_rx_wake();
+        k60_uart_pins_active(); /* GPIO79 must return to qup20 before resume */
+        IODelay(10);
+        k60.gated = false;
+        return qbt_geni_resume(&k60.geni);
+    }
+    if (k60.gated) return 0;
+    uint64_t sequence = k60.rx_sequence;
+    int e = k60_quiesce();
+    if (e) return e;
+    if (sequence != k60.rx_sequence || qbt_transport_tx_pending()) {
+        (void)qbt_geni_resume(&k60.geni);
+        return -EBUSY;
+    }
+    k60_arm_rx_wake();
+    if (k60_rx_wake_pending()) {
+        k60_disarm_rx_wake();
+        (void)qbt_geni_resume(&k60.geni);
+        return -EBUSY;
+    }
+    /* Leave RTS ready so the controller's 0xFD wake indication reaches GPIO79. */
+    k60_uart_write(NULL, 0x2ac, 0x80000001u);
+    k60.gated = true;
+    if (k60_serial_clock(false)) {
+        k60.gated = false;
+        k60_disarm_rx_wake();
+        (void)qbt_geni_resume(&k60.geni);
+        return -EIO;
+    }
+    return 0;
+}
+
+static int k60_uart_speed(void *ctx, uint32_t baud) {
+    (void)ctx;
+    int e = k60_quiesce();
+    if (e) return e;
+    uint32_t hz = 0;
+    e = k60_geni_source_hz(baud, k60_qup_sampling(), &hz);
+    if (!e) e = k60_gcc_set_se_rate(hz);
+    if (!e) e = qbt_geni_set_rate(&k60.geni, baud, hz, k60_qup_sampling());
+    if (!e) e = qbt_geni_resume(&k60.geni);
+    if (!e) k60.baud = baud;
+    return e;
+}
