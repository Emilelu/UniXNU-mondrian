 	if (error) goto done;
 	k60_data_mounted = 1;
+	/* 0340: place the UI compatibility library on the Data volume */
+	{
+		extern int k60_uilib_deploy(void);
+
+		(void)k60_uilib_deploy();
+	}
 	native_owner_data_stage = 3;
 	error = vnode_lookup("/private/var", 0, &data_root, vfs_context_current());
 	printf("K60DATA root lookup error=%d vnode=%p\n", error, data_root);
