--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1589,9 +1589,23 @@
 
 		k60_exit_count++;
 		if (k60_status != 0 || k60_sig != 0) {
-			if (k60_abnormal_count < 300) {
