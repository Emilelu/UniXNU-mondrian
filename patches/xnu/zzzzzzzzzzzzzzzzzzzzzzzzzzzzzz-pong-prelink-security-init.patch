--- a/libkern/c++/OSKext.cpp
+++ b/libkern/c++/OSKext.cpp
@@ -73,6 +73,22 @@
 
 #include <libkern/OSKextLibPrivate.h>
 #include <libkern/c++/OSKext.h>
