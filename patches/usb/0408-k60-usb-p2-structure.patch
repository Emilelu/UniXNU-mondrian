+/*
+ * P2: finish live transfers before the endpoints are torn down
+ * (PongUsbDevice.h:132-140). HIPRI_FORCERM plus the resource id that
+ * STARTTRANSFER returned; a completed resource may already be gone, so a
+ * failure is reported by ud_epcmd_full and otherwise ignored.
+ */
+static void
+ud_end_transfers(void)
+{
+	for (unsigned ep = 0; ep < 8; ep++) {
+		uint8_t res = ud.transferResource[ep];
+		if (!res) {
+			continue;
+		}
+		(void)ud_epcmd_full(ep, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | DEPCMD_PARAM(res), 0, 0, 0);
+		ud.transferResource[ep] = 0;
+	}
+}
