+/*
+ * Bounded exec-error printer: first occurrence of each (comm,where,error)
+ * prints one line with the resolved exec path; repeats only count.
+ */
+static void
+k60_print_exec_error(proc_t p, int error, const char *where)
+{
+	static struct {
+		char comm[24];
+		char where[8];
+		unsigned int err;
+		unsigned int count;
+	} k60_xerr[8];
+	unsigned int k60_i, k60_free = 8, k60_hit = 8;
+
+	for (k60_i = 0; k60_i < 8; k60_i++) {
+		if (k60_xerr[k60_i].count == 0) {
+			if (k60_free == 8) {
+				k60_free = k60_i;
+			}
+			continue;
+		}
+		if (k60_xerr[k60_i].err == (unsigned int)error &&
+		    strncmp(k60_xerr[k60_i].comm, p->p_comm, 24) == 0 &&
+		    strncmp(k60_xerr[k60_i].where, where, 8) == 0) {
+			k60_hit = k60_i;
+			break;
+		}
+	}
+	if (k60_hit == 8 && k60_free != 8) {
+		k60_hit = k60_free;
+		strlcpy(k60_xerr[k60_hit].comm, p->p_comm, sizeof(k60_xerr[k60_hit].comm));
+		strlcpy(k60_xerr[k60_hit].where, where, sizeof(k60_xerr[k60_hit].where));
+		k60_xerr[k60_hit].err = (unsigned int)error;
+	}
+	if (k60_hit != 8 && ++k60_xerr[k60_hit].count == 1) {
+		const char *k60_xp = k60_exec_path_for_pid(proc_getpid(p));
+		printf("KX? %d %s execerr=%d where=%s path=%s\n",
+		    proc_getpid(p), p->p_comm, error, where,
+		    k60_xp != NULL ? k60_xp : "?");
+	}
+}
