+
+/* Components whose start function validates Apple-only platform state and
+ * panics without it.  They are linked into this prelink because other
+ * components reference them, so leave them unstarted instead.
+ */
+static bool
+k60_skip_prelinked_start(const char *identifier)
+{
+	return strcmp(identifier, "com.apple.security.AppleImage4") == 0 ||
+	    strcmp(identifier, "com.apple.driver.AppleARMPlatform") == 0;
+}
 #include <libkern/c++/OSLib.h>
 
 #include <IOKit/IOLib.h>
