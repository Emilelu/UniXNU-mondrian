+// Worker-only readout; does not acknowledge or mask the SPI.
+extern "C" IOReturn armcpu_spi_snapshot(uint32_t id,uint64_t *entries,
+ uint32_t *enabled,uint32_t *pending,uint32_t *active,uint64_t *route) {
+ if(!gDist||!armcpu_gic_ready)return kIOReturnNotReady;
+ const unsigned count=((read32(gDist,4)&31)+1)*32;
+ if(id<32||id>=1020||id>=count)return kIOReturnBadArgument;
+ const uint32_t used=__atomic_load_n(&gSpiUsed,__ATOMIC_ACQUIRE);
+ SpiOwner *owner=nullptr;
+ for(uint32_t i=0;i<used;i++)if(gSpi[i].id==id){owner=&gSpi[i];break;}
+ if(!owner)return kIOReturnNotFound;
+ const uint32_t word=(id/32)*4,bit=1u<<(id%32);
+ *entries=__atomic_load_n(&owner->count,__ATOMIC_RELAXED);
+ *enabled=!!(read32(gDist,0x100+word)&bit);
+ *pending=!!(read32(gDist,0x200+word)&bit);
+ *active=!!(read32(gDist,0x300+word)&bit);
+ *route=*reinterpret_cast<volatile uint64_t *>(gDist+0x6000+8*id);
+ return kIOReturnSuccess;
+}
