+	    receiver != NULL ? "registered" : "cleared");
+}
+
+
+/* The four EFS images the modem opens by name are numbered exactly as the
+ * reference numbers them (PongModemRmtfs.h), and that table lives with the
+ * storage data plane in K60ModemEfs so the name comparison exists once. A name
+ * we do not know is not an error in the protocol: the answer is result 1, the
+ * modem retries or moves on, and the log names the path it asked for. */
+static uint32_t
+k60_qrtr_rmtfs_storage(const char *path, size_t length)
+{
+	return k60_efs_storage_for_path(path, length);
+}
+
+/* The modem's storage service wants one contiguous region it can map into
+ * its own address space. Two facts decide the placement: the address it gets
+ * back is a 32-bit value, so the memory must live below 4 GiB; and the MSS
+ * reaches it through the IOMMU, so SCM 0x0c/0x16 has to move the ownership of
+ * those pages from HLOS to HLOS|MSS before the modem touches them. The
+ * allocation is retried, because the first contiguous block the kernel hands
+ * out can sit above the 4 GiB line; every refusal is logged with its
+ * physical address instead of being hidden. */
+static vm_offset_t k60_qrtr_memshare_buffer;
+static uint64_t k60_qrtr_memshare_physical;
+static uint32_t k60_qrtr_memshare_bytes;
+static uint32_t k60_qrtr_memshare_node;
+static uint32_t k60_qrtr_memshare_port;
+static unsigned k60_qrtr_memshare_requests;
+static unsigned k60_qrtr_memshare_allocations;
+static unsigned k60_qrtr_memshare_releases;
+
+static vm_offset_t k60_qrtr_rmtfs_buffer;
+static uint64_t k60_qrtr_rmtfs_physical;
+static uint64_t k60_qrtr_rmtfs_bytes;
+static vm_offset_t k60_qrtr_rmtfs_scratch;
+static uint64_t k60_qrtr_rmtfs_scratch_physical;
+static unsigned k60_qrtr_rmtfs_allocations;
+
+static int
+k60_qrtr_rmtfs_low_alloc(vm_size_t bytes, vm_offset_t *va, uint64_t *physical)
+{
+	unsigned tries;
+
+	for (tries = 0; tries < 8; tries++) {
+		vm_offset_t address = 0;
+		ppnum_t page;
+
+		const ppnum_t ceiling = (ppnum_t)(((1ull << 32) - bytes) >> 12);
+
+		if (kmem_alloc_contig(kernel_map, &address, bytes, 0, ceiling,
+		    0, KMA_DATA | KMA_ZERO,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("K60MODEM qrtr: rmtfs cannot allocate %llu bytes\n",
+			    (unsigned long long)bytes);
+			return -1;
+		}
+		page = pmap_find_phys(kernel_pmap, (addr64_t)address);
+		if (page != 0 && ptoa_64(page) + bytes <= (1ull << 32)) {
+			*va = address;
+			*physical = ptoa_64(page);
+			return 0;
+		}
+		printf("K60MODEM qrtr: rmtfs attempt %u above 4 GiB (phys=%#llx)\n",
+		    tries, page == 0 ? 0ull : (unsigned long long)ptoa_64(page));
+		kmem_free(kernel_map, address, bytes);
+	}
+	return -1;
+}
+
+static void
+k60_qrtr_rmtfs_clean(const void *at, uint32_t bytes)
+{
+	const uintptr_t start = (uintptr_t)at & ~(uintptr_t)63u;
+	const uintptr_t end = ((uintptr_t)at + bytes + 63u) & ~(uintptr_t)63u;
+	uintptr_t line;
+
+	for (line = start; line < end; line += 64u) {
+		__asm__ volatile("dc cvac, %0" : : "r"(line) : "memory");
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+}
+
+static void
+k60_qrtr_rmtfs_invalidate(const void *at, uint32_t bytes)
+{
+	const uintptr_t start = (uintptr_t)at & ~(uintptr_t)63u;
+	const uintptr_t end = ((uintptr_t)at + bytes + 63u) & ~(uintptr_t)63u;
+	uintptr_t line;
+
+	for (line = start; line < end; line += 64u) {
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+}
+
+/* Both services hand pages across the same SCM primitive (0x0c/0x16) and the
+ * same 64 KiB metadata scratch: RMTFS lends its window to the modem for file
+ * reads, the memory share service lends it as a heap. */
+static int
+k60_qrtr_assign_pages(uint64_t physical, uint32_t bytes, unsigned from,
+    unsigned to)
+{
+	uint8_t *record;
+	uint32_t sources = 0;
+	uint32_t destinations = 0;
+	int rc;
+
+	if (k60_qrtr_rmtfs_scratch == 0 &&
+	    k60_qrtr_rmtfs_low_alloc(65536, &k60_qrtr_rmtfs_scratch,
+	    &k60_qrtr_rmtfs_scratch_physical) != 0) {
+		printf("K60MODEM qrtr: no assignment scratch for %#llx\n",
+		    (unsigned long long)physical);
+		return -1;
+	}
+	record = (uint8_t *)k60_qrtr_rmtfs_scratch;
+	if (k60_modem_assign_record(record, 4096, physical, bytes, from, to,
+	    k60_qrtr_rmtfs_scratch_physical, &sources, &destinations) != 0) {
+		printf("K60MODEM qrtr: assign record refused physical=%#llx bytes=%u\n",
+		    (unsigned long long)physical, bytes);
+		return -1;
+	}
+	k60_qrtr_rmtfs_clean(record, 4096);
+	rc = k60_modem_assign_call(k60_qrtr_rmtfs_scratch_physical);
+	printf("K60MODEM qrtr: assign physical=%#llx bytes=%u from=%u to=%u rc=%d sources=%u destinations=%u\n",
+	    (unsigned long long)physical, bytes, from, to, rc, sources,
+	    destinations);
+	return rc == 0 ? 0 : -1;
+}
+
+static uint64_t
+k60_qrtr_rmtfs_prepare(uint32_t bytes)
+{
+	if (k60_qrtr_rmtfs_physical != 0) {
+		return k60_qrtr_rmtfs_physical;
+	}
+	if (bytes == 0 || bytes > (8u << 20)) {
+		printf("K60MODEM qrtr: rmtfs alloc %u bytes out of range\n", bytes);
+		return 0;
+	}
+	if (k60_qrtr_rmtfs_low_alloc((vm_size_t)round_page(bytes),
+	    &k60_qrtr_rmtfs_buffer, &k60_qrtr_rmtfs_physical) != 0) {
+		return 0;
+	}
+	k60_qrtr_rmtfs_bytes = bytes;
+	printf("K60MODEM qrtr: rmtfs buffer va=%#llx physical=%#llx bytes=%u\n",
+	    (unsigned long long)k60_qrtr_rmtfs_buffer,
+	    (unsigned long long)k60_qrtr_rmtfs_physical, bytes);
+	if (k60_qrtr_assign_pages(k60_qrtr_rmtfs_physical, bytes,
+	    K60M_OWNER_HLOS, K60M_OWNER_HLOS | K60M_OWNER_MSS) != 0) {
+		printf("K60MODEM qrtr: rmtfs assignment failed; answering anyway\n");
+	}
+	return k60_qrtr_rmtfs_physical;
+}
+
+/* A read is served from the EFS image the open named: the bytes come straight
+ * out of the GPT partition through the read-only entry NativeUfs exports,
+ * one vector at a time, so the shared window never has to hold the whole
+ * image. A write stays in the boot-session shadow, which is what the
+ * reference does: the buffer is the shadow and only the cache has to be
+ * invalidated. Every vector is validated before a single byte moves. */
+static int
+k60_qrtr_rmtfs_read(const K60RmtfsRequest *request)
+{
+	const char *name = k60_efs_partition(request->storage);
+	size_t i;
+
+	if (name == NULL) {
+		return -1;
+	}
+	for (i = 0; i < request->vectors; i++) {
+		const uint64_t offset =
+		    (uint64_t)request->table[i].block_offset * 512u;
+		const uint64_t length =
+		    (uint64_t)request->table[i].block_length * 512u;
+		uint8_t *shared = (uint8_t *)(k60_qrtr_rmtfs_buffer +
+		    (request->table[i].physical - k60_qrtr_rmtfs_physical));
+
+		if (length == 0 ||
+		    native_pong_ufs_read_named_volume(name, offset, shared,
+		    (size_t)length) == 0) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int
+k60_qrtr_rmtfs_rw(const K60RmtfsRequest *request)
+{
+	size_t i;
+
+	if (k60_qrtr_rmtfs_physical == 0) {
+		return -1;
+	}
+	for (i = 0; i < request->vectors; i++) {
+		const uint64_t offset = (uint64_t)request->table[i].block_offset * 512u;
+		const uint64_t physical = request->table[i].physical;
+		const uint64_t length = (uint64_t)request->table[i].block_length * 512u;
+
+		if (physical < k60_qrtr_rmtfs_physical ||
+		    physical - k60_qrtr_rmtfs_physical > k60_qrtr_rmtfs_bytes ||
+		    length > k60_qrtr_rmtfs_bytes - (physical - k60_qrtr_rmtfs_physical) ||
+		    offset > k60_qrtr_rmtfs_bytes ||
+		    length > k60_qrtr_rmtfs_bytes - offset) {
+			return -1;
+		}
+	}
+	if (request->storage == 0 || request->storage > K60_EFS_IMAGE_COUNT) {
+		return -1;
+	}
+	if (request->direction == 0) {
+		if (k60_qrtr_rmtfs_read(request) != 0) {
+			return -1;
+		}
+		for (i = 0; i < request->vectors; i++) {
+			uint8_t *shared = (uint8_t *)(k60_qrtr_rmtfs_buffer +
+			    (request->table[i].physical - k60_qrtr_rmtfs_physical));
+			k60_qrtr_rmtfs_clean(shared,
+			    (uint32_t)request->table[i].block_length * 512u);
+		}
+		return 0;
+	}
+	for (i = 0; i < request->vectors; i++) {
+		uint8_t *shared = (uint8_t *)(k60_qrtr_rmtfs_buffer +
+		    (request->table[i].physical - k60_qrtr_rmtfs_physical));
+
+		k60_qrtr_rmtfs_invalidate(shared,
+		    (uint32_t)request->table[i].block_length * 512u);
+	}
+	return 0;
+}
+
+/* The memory share service keeps one region for the modem: the reference
+ * reuses it only when the size, node and port all match, and refuses a second
+ * client rather than handing out a second window. */
+static uint64_t
+k60_qrtr_memshare_allocate(uint32_t bytes, uint32_t node, uint32_t port)
+{
+	vm_offset_t address = 0;
+	uint64_t physical = 0;
+
+	if (k60_qrtr_memshare_physical != 0) {
+		if (bytes == k60_qrtr_memshare_bytes && node == k60_qrtr_memshare_node &&
+		    port == k60_qrtr_memshare_port) {
+			return k60_qrtr_memshare_physical;
+		}
+		printf("K60MODEM qrtr: memshare busy bytes=%u node=%u port=%#x\n",
+		    k60_qrtr_memshare_bytes, k60_qrtr_memshare_node,
+		    k60_qrtr_memshare_port);
+		return 0;
+	}
+	if (bytes == 0 || bytes > K60_MEMSHARE_MAXIMUM) {
+		printf("K60MODEM qrtr: memshare %u bytes out of range\n", bytes);
+		return 0;
+	}
+	if (k60_qrtr_rmtfs_low_alloc((vm_size_t)round_page(bytes), &address,
+	    &physical) != 0) {
+		return 0;
+	}
+	if (k60_memshare_region_ok(physical, bytes, 1ull << 32) != 0) {
+		printf("K60MODEM qrtr: memshare region %#llx bytes=%u refused\n",
+		    (unsigned long long)physical, bytes);
+		kmem_free(kernel_map, address, round_page(bytes));
+		return 0;
+	}
+	k60_qrtr_memshare_buffer = address;
+	k60_qrtr_memshare_physical = physical;
+	k60_qrtr_memshare_bytes = bytes;
+	k60_qrtr_memshare_node = node;
+	k60_qrtr_memshare_port = port;
+	printf("K60MODEM qrtr: memshare buffer va=%#llx physical=%#llx bytes=%u node=%u port=%#x\n",
+	    (unsigned long long)address, (unsigned long long)physical, bytes, node,
+	    port);
+	if (k60_qrtr_assign_pages(physical, bytes, K60M_OWNER_HLOS,
+	    K60M_OWNER_HLOS | K60M_OWNER_MSS) != 0) {
+		printf("K60MODEM qrtr: memshare assignment failed; answering anyway\n");
+	}
+	return physical;
+}
+
+/* Handing the extent back costs the ownership reversal first, then the pages:
+ * the reference frees the buffer only after the modem's half is revoked. */
+static int
+k60_qrtr_memshare_release(uint64_t physical, uint32_t bytes, uint32_t node,
+    uint32_t port)
+{
+	if (k60_qrtr_memshare_physical == 0) {
+		return -1;
+	}
+	if (physical != k60_qrtr_memshare_physical ||
+	    bytes != k60_qrtr_memshare_bytes || node != k60_qrtr_memshare_node ||
+	    port != k60_qrtr_memshare_port) {
+		printf("K60MODEM qrtr: memshare release mismatch physical=%#llx bytes=%u node=%u port=%#x\n",
+		    (unsigned long long)physical, bytes, node, port);
+		return -1;
+	}
+	if (k60_qrtr_assign_pages(physical, bytes, K60M_OWNER_MSS,
+	    K60M_OWNER_HLOS) != 0) {
+		return -1;
+	}
+	kmem_free(kernel_map, k60_qrtr_memshare_buffer,
+	    round_page(k60_qrtr_memshare_bytes));
+	k60_qrtr_memshare_buffer = 0;
+	k60_qrtr_memshare_physical = 0;
+	k60_qrtr_memshare_bytes = 0;
+	k60_qrtr_memshare_node = 0;
+	k60_qrtr_memshare_port = 0;
+	return 0;
+}
+
+static void
+k60_qrtr_receive_cb(void *context, QcomGlinkChannel *channel, const uint8_t *data, uint32_t length)
+{
+	K60QrtrHeader header;
+	const uint8_t *payload = NULL;
+
+	(void)context;
+	(void)channel;
+	if (k60_qrtr_parse(data, length, &header, &payload) != K60QrtrOk) {
+		return;
+	}
+	if (header.type < 8u) {
+		++k60_qrtr_rx_cmds[header.type];
+	}
+	/* A name server answers a lookup with NEW_LOOKUP records of its own: one
+	 * service, instance, node and port per record. k37 never saw one because
+	 * every query went to the control port; the name server listens on
+	 * K60_QRTR_NS_PORT. Treat the answer exactly like a registration. */
+	if (header.type == K60QrtrNewLookup && header.size == K60_QRTR_CONTROL_BYTES) {
+		const uint32_t service = (uint32_t)payload[4] | (uint32_t)payload[5] << 8 |
+		    (uint32_t)payload[6] << 16 | (uint32_t)payload[7] << 24;
+		const uint32_t instance = (uint32_t)payload[8] | (uint32_t)payload[9] << 8 |
+		    (uint32_t)payload[10] << 16 | (uint32_t)payload[11] << 24;
+		const uint32_t node = (uint32_t)payload[12] | (uint32_t)payload[13] << 8 |
+		    (uint32_t)payload[14] << 16 | (uint32_t)payload[15] << 24;
+		const uint32_t port = (uint32_t)payload[16] | (uint32_t)payload[17] << 8 |
+		    (uint32_t)payload[18] << 16 | (uint32_t)payload[19] << 24;
+
+		++k60_qrtr_lookup_replies;
+		printf("K60MODEM qrtr: lookup reply service %u instance %u node %u port %u\n",
+		    service, instance, node, port);
+		coachz_baseband_new_server(service, instance, node, port);
+		if (service == K60_QRTR_DMS_SERVICE && port != 0) {
+			k60_qrtr_state.dms_node = node;
+			k60_qrtr_state.dms_port = port;
+			k60_qrtr_state.dms_found = 1;
+		}
+	}
+	if (header.type == K60QrtrData) {
+		if (header.to_port == K60_QRTR_RMTFS_PORT) {
+			K60RmtfsRequest request;
+			uint8_t answer[64];
+			uint32_t id = 0;
+			uint32_t used;
+			uint16_t result = 0;
+			const void *value = NULL;
+			size_t value_bytes = 0;
+			int parsed;
+
+			++k60_qrtr_rmtfs_requests;
+			parsed = k60_rmtfs_parse(payload, header.size, &request);
+			if (parsed != 0) {
+				printf("K60MODEM qrtr: rmtfs request %u bytes unreadable\n",
+				    header.size);
+				result = 2;
+			} else if (request.message == K60_RMTFS_OPEN) {
+				char shown[K60_RMTFS_MAX_PATH + 1];
+				size_t at;
+
+				id = k60_qrtr_rmtfs_storage(request.path, request.path_length);
+				for (at = 0; at < request.path_length; at++) {
+					shown[at] = request.path[at];
+				}
+				shown[at] = '\0';
+				printf("K60MODEM qrtr: rmtfs open path=%s storage=%u\n",
+				    shown, id);
+				if (id != 0) {
+					value = &id;
+					value_bytes = 4;
+				} else {
+					result = 1;
+				}
+			} else if (request.message == K60_RMTFS_CLOSE) {
+				printf("K60MODEM qrtr: rmtfs close storage=%u\n", request.storage);
+				value = &id;
+				value_bytes = 1;
+			} else if (request.message == K60_RMTFS_SYNC) {
+				printf("K60MODEM qrtr: rmtfs sync storage=%u\n", request.storage);
+				value = &id;
+				value_bytes = 1;
+			} else if (request.message == K60_RMTFS_ALLOC) {
+				uint64_t physical = k60_qrtr_rmtfs_prepare(
+				    request.alloc_bytes);
+
+				++k60_qrtr_rmtfs_allocations;
+				printf("K60MODEM qrtr: rmtfs alloc storage=%u bytes=%u physical=%#llx\n",
+				    request.storage, request.alloc_bytes,
+				    (unsigned long long)physical);
+				if (physical != 0) {
+					value = &physical;
+					value_bytes = 8;
+				} else {
+					result = 1;
+				}
+			} else if (request.message == K60_RMTFS_RW) {
+				const int served = k60_qrtr_rmtfs_rw(&request);
+
+				printf("K60MODEM qrtr: rmtfs rw storage=%u direction=%u vectors=%u %s\n",
+				    request.storage, request.direction,
+				    (unsigned)request.vectors,
+				    served == 0 ? "served" : "refused");
+				if (served != 0) {
+					result = 1;
+				}
+			} else {
+				printf("K60MODEM qrtr: rmtfs rw storage=%u direction=%u vectors=%u not-served\n",
+				    request.storage, request.direction, (unsigned)request.vectors);
+				result = 1;
+			}
+			if (parsed == 0) {
+				used = k60_rmtfs_build_reply(answer, sizeof(answer),
+				    request.message, request.transaction, result, value,
+				    value_bytes);
+				if (used == 0 || k60_qrtr_queue_reply(K60_QRTR_RMTFS_PORT,
+				    header.from_node, header.from_port, answer, used) != 0) {
+					printf("K60MODEM qrtr: rmtfs reply dropped (%u bytes)\n",
+					    used);
+				}
+			}
+		} else if (header.to_port == K60_MEMSHARE_PORT) {
+			K60MemshareRequest request;
+			uint8_t answer[64];
+			uint32_t used;
+			uint32_t error = K60_MEMSHARE_ERROR_NONE;
+			uint64_t physical = 0;
+			uint32_t extent = 0;
+			int parsed;
+
+			++k60_qrtr_memshare_requests;
+			parsed = k60_memshare_parse(payload, header.size, &request);
+			if (parsed != 0) {
+				printf("K60MODEM qrtr: memshare request %u bytes unreadable\n",
+				    header.size);
+				return;
+			}
+			error = request.error;
+			if (error == K60_MEMSHARE_ERROR_NONE &&
+			    request.message == K60_MEMSHARE_ALLOCATE) {
+				physical = k60_qrtr_memshare_allocate(request.bytes,
+				    header.from_node, header.from_port);
+				++k60_qrtr_memshare_allocations;
+				if (physical != 0) {
+					extent = request.bytes;
+				} else {
+					error = K60_MEMSHARE_ERROR_NO_MEMORY;
+				}
+			} else if (error == K60_MEMSHARE_ERROR_NONE &&
+			    request.message == K60_MEMSHARE_FREE) {
+				if (k60_qrtr_memshare_release(request.physical,
+				    request.extent_bytes, header.from_node,
+				    header.from_port) == 0) {
+					++k60_qrtr_memshare_releases;
+				} else {
+					error = K60_MEMSHARE_ERROR_TRANSFER;
+				}
+			}
+			printf("K60MODEM qrtr: memshare request=%#x client=%u bytes=%u result=%u\n",
+			    request.message, request.client, request.bytes, error);
+			used = k60_memshare_build_reply(answer, sizeof(answer),
+			    request.transaction, request.message, error,
+			    K60_MEMSHARE_MAXIMUM, &request.sequence, physical,
+			    extent);
+			if (used == 0 || k60_qrtr_queue_reply(K60_MEMSHARE_PORT,
+			    header.from_node, header.from_port, answer, used) != 0) {
+				printf("K60MODEM qrtr: memshare reply dropped (%u bytes)\n",
+				    used);
+			}
+		} else if (header.to_port == K60_QRTR_LOCATOR_PORT) {
+			uint8_t answer[K60_QRTR_MAX_PACKET];
+			uint32_t bytes;
+
+			++k60_qrtr_state.locator_requests;
+			bytes = k60_qrtr_servloc_answer(payload, header.size, answer,
+			    sizeof(answer));
+			if (bytes == 0 ||
+			    k60_qrtr_queue_reply(K60_QRTR_LOCATOR_PORT, header.from_node,
+			    header.from_port, answer, bytes) != 0) {
+				printf("K60MODEM qrtr: locator answer dropped (%u bytes)\n", bytes);
+			}
+		} else if (header.to_port == K60_QRTR_DMS_PORT &&
+		    header.from_node == k60_qrtr_state.dms_node &&
+		    header.from_port == k60_qrtr_state.dms_port) {
+			char revision[sizeof(k60_qrtr_state.revision)];
+			const int bytes = k60_qmi_dms_revision(payload, header.size,
+			    k60_qrtr_state.dms_transaction, revision, sizeof(revision));
+
+			if (bytes > 0) {
+				for (int i = 0; i <= bytes; ++i) {
+					k60_qrtr_state.revision[i] = revision[i];
+				}
+				k60_qrtr_state.revision_bytes = (uint32_t)bytes;
+				k60_qrtr_state.dms_answered = 1;
+				printf("K60MODEM qrtr: dms revision %s\n", revision);
+			} else {
+				++k60_qrtr_state.dms_errors;
+			}
+		} else if (header.to_port == K60_QRTR_DMS_PORT) {
+			++k60_qrtr_state.dms_errors;
+		} else {
+			/* Ports owned by the QcomBaseband control bridge (CBQ_PORT_BASE
+			 * and above). The bridge copies what it needs; unknown ports
+			 * simply return zero. */
+			(void)coachz_baseband_qrtr(header.to_port, header.from_node,
+			    header.from_port, payload, header.size);
+		}
+	}
+	if (header.type == K60QrtrNewServer && header.size == K60_QRTR_CONTROL_BYTES) {
+		const uint32_t service = (uint32_t)payload[4] | (uint32_t)payload[5] << 8 |
+		    (uint32_t)payload[6] << 16 | (uint32_t)payload[7] << 24;
+		const uint32_t instance = (uint32_t)payload[8] | (uint32_t)payload[9] << 8 |
+		    (uint32_t)payload[10] << 16 | (uint32_t)payload[11] << 24;
+		const uint32_t node = (uint32_t)payload[12] | (uint32_t)payload[13] << 8 |
+		    (uint32_t)payload[14] << 16 | (uint32_t)payload[15] << 24;
+		const uint32_t port = (uint32_t)payload[16] | (uint32_t)payload[17] << 8 |
+		    (uint32_t)payload[18] << 16 | (uint32_t)payload[19] << 24;
+
+		printf("K60MODEM qrtr: service %u (%#x) instance %u node %u port %u cmd=%#x to=%u\n",
+		    service, service, instance, node, port,
+		    (unsigned)payload[0] | (unsigned)payload[1] << 8 |
+		    (unsigned)payload[2] << 16 | (unsigned)payload[3] << 24,
+		    header.to_node);
+		coachz_baseband_new_server(service, instance, node, port);
+	}
+	if (header.type == K60QrtrDelServer && header.size == K60_QRTR_CONTROL_BYTES) {
+		const uint32_t service = (uint32_t)payload[4] | (uint32_t)payload[5] << 8 |
+		    (uint32_t)payload[6] << 16 | (uint32_t)payload[7] << 24;
+		const uint32_t node = (uint32_t)payload[12] | (uint32_t)payload[13] << 8 |
+		    (uint32_t)payload[14] << 16 | (uint32_t)payload[15] << 24;
+		const uint32_t port = (uint32_t)payload[16] | (uint32_t)payload[17] << 8 |
+		    (uint32_t)payload[18] << 16 | (uint32_t)payload[19] << 24;
+
+		printf("K60MODEM qrtr: service %u (%#x) removed node %u port %u\n",
+		    service, service, node, port);
+		coachz_baseband_del_server(service, node, port);
+	}
+	(void)k60_qrtr_note(&k60_qrtr_state, data, length);
+}
+
+/* SMP2P outbound item: the modem's boot firmware expects the AP's
+ * "master-kernel" entry before PAS_AUTH_AND_RESET. Pong allocates item 428
+ * (340 bytes), item 478 (32-byte GLINK descriptor) and item 479 (16 KiB TX
+ * FIFO) after INIT_IMAGE and before MEM_SETUP; we do the same so a cold boot
+ * starts from an AP-owned, fresh transport instead of whatever an Android
+ * epoch left behind. */
+static void
+k60_smp2p_barrier(void)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+static void
+k60_smp2p_init_out(volatile uint32_t *out)
+{
+	unsigned i;
+
+	for (i = 0; i < K60_MODEM_SMP2P_ITEM_WORDS; i++) {
+		out[i] = 0;
+	}
+	k60_smp2p_barrier();
+	out[0] = K60_MODEM_SMP2P_MAGIC;
+	out[2] = 0u | (uint32_t)1u << 16;  /* local pid 0, remote pid 1 */
+	out[3] = 16u;                      /* total entries, valid entries 0 */
+	k60_smp2p_barrier();
+	out[1] = 1u | (1u << 8);           /* version 1, SSR ack feature */
+	k60_smp2p_barrier();
+}
+
+static int
+k60_smp2p_add_entry(volatile uint32_t *out, const char *name)
+{
+	const uint32_t valid = out[3] >> 16;
+	volatile uint32_t *entry;
+	unsigned i;
+
+	if (valid >= 16u) {
+		return -1;
+	}
+	entry = out + 5u + 5u * valid;
+	for (i = 0; i < 4; i++) {
+		entry[i] = 0;
+	}
+	for (i = 0; i < 16u && name[i] != '\0'; i++) {
+		entry[i / 4u] |= (uint32_t)(uint8_t)name[i] << (8u * (i % 4u));
+	}
+	entry[4] = 0;
+	k60_smp2p_barrier();
+	out[3] = 16u | (valid + 1u) << 16;
+	k60_smp2p_barrier();
+	return (int)valid;
+}
+
+/* Pong never leaves the AP-owned stop bit set across a start: the Q6V5 reads
+ * bit 0 of master-kernel as stop, so releasing it is part of handing over a
+ * fresh session, not part of shutting one down. A stale bit left by an Android
+ * epoch is otherwise republished as if we meant it. */
+static void
+k60_smp2p_release_stop(volatile uint32_t *item)
+{
+	const uint32_t was = k60_smp2p_entry_word(item, k60_qrtr_smp2p_stop_entry);
+
+	if (k60_qrtr_smp2p_stop_entry < 0) {
+		return;
+	}
+	if (!k60_smp2p_update(item, k60_qrtr_smp2p_stop_entry, 1u, 0u)) {
+		return;
+	}
+	k60_smp2p_barrier();
+	printf("K60MODEM transport: smp2p stop released was=%#x now=%#x ipa=%#x\n",
+	    was, k60_smp2p_entry_word(item, k60_qrtr_smp2p_stop_entry),
+	    k60_smp2p_entry_word(item, k60_qrtr_smp2p_ipa_entry));
+}
+
+static int
+k60_transport_item(K60Smem *smem, K60SmemPartition *partition, uint16_t id,
+    uint32_t bytes, uint32_t *offset, uint32_t *size)
+{
+	int rc = k60_smem_alloc(smem, partition, id, bytes, offset, size);
+
+	if (rc == K60SmemExists) {
+		rc = k60_smem_find(smem, partition, id, offset, size);
+	}
+	if (rc != K60SmemOk) {
+		return rc;
+	}
+	if (*size < bytes) {
+		return K60SmemBadPartition;
+	}
+	return K60SmemOk;
+}
+
+/* ---- modem power: AOP QMP load_state and cx/mss/xo RPMh votes ---------- */
+
+#define K60_MODEM_AOSS_BASE       0x0c300000u
+#define K60_MODEM_AOSS_BYTES      0x00001000u
+#define K60_MODEM_QMP_RAM_BYTES   0x00000400u
+#define K60_MODEM_AOP_SEND        0x0cu
+
+#define K60_MODEM_QMP_DESC_MAGIC          0x0u
+#define K60_MODEM_QMP_DESC_VERSION        0x4u
+#define K60_MODEM_QMP_DESC_UCORE_LINK     0x0cu
+#define K60_MODEM_QMP_DESC_UCORE_LINK_ACK 0x10u
+#define K60_MODEM_QMP_DESC_UCORE_CH       0x14u
+#define K60_MODEM_QMP_DESC_UCORE_CH_ACK   0x18u
+#define K60_MODEM_QMP_DESC_MCORE_LINK     0x24u
+#define K60_MODEM_QMP_DESC_MCORE_LINK_ACK 0x28u
+#define K60_MODEM_QMP_DESC_MCORE_CH       0x2cu
+#define K60_MODEM_QMP_DESC_MCORE_CH_ACK   0x30u
+#define K60_MODEM_QMP_DESC_MBOX_SIZE      0x34u
+#define K60_MODEM_QMP_DESC_MBOX_OFFSET    0x38u
+#define K60_MODEM_QMP_MAGIC               0x4d41494cu /* "MAIL" */
+#define K60_MODEM_QMP_VERSION             1u
+#define K60_MODEM_QMP_STATE_UP            0xffffu
+#define K60_MODEM_QMP_MSG_BYTES           100u
+#define K60_MODEM_QMP_WORDS               (K60_MODEM_QMP_MSG_BYTES / 4u)
+
+#define K60_MODEM_RSC_DRV_CONTROL  0x00u
+#define K60_MODEM_RSC_IRQ_STATUS   0x04u
+#define K60_MODEM_RSC_IRQ_CLEAR    0x08u
+#define K60_MODEM_RSC_CAPS         0x0cu
+#define K60_MODEM_TCS_BASE         0xd00u
+#define K60_MODEM_TCS_STRIDE       672u
+#define K60_MODEM_TCS4             (K60_MODEM_TCS_BASE + 4u * K60_MODEM_TCS_STRIDE)
+#define K60_MODEM_TCS3             (K60_MODEM_TCS_BASE + 3u * K60_MODEM_TCS_STRIDE)
+#define K60_MODEM_RSC_MSGID        0x10108u
+#define K60_MODEM_RSC_IRQ_DONE     (1u << 4)
+#define K60_MODEM_RSC_CMD_DONE     0x10100u
+#define K60_MODEM_RSC_CTRL_TCS     (1u << 4)
+
+static uint32_t
+k60_modem_rd32(const volatile uint8_t *base, size_t at)
+{
+	return *(volatile uint32_t *)(base + at);
+}
+
+static void
+k60_modem_wr32(volatile uint8_t *base, size_t at, uint32_t value)
+{
+	*(volatile uint32_t *)(base + at) = value;
+	/* Match PongPlatformResources::wr: do not let a posted MMIO write
+	 * race the immediate control/IRQ readbacks below. */
+	__asm__ volatile("dsb oshst" ::: "memory");
+}
+
+static void
+k60_modem_fence(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+k60_modem_spin(void)
+{
+	__asm__ volatile("yield" ::: "memory");
+}
+
+static int
+k60_modem_wait_word(const volatile uint8_t *base, size_t at, uint32_t mask,
+    uint32_t value, unsigned tries)
+{
+	unsigned i;
+
+	for (i = 0; i < tries; i++) {
+		if ((k60_modem_rd32(base, at) & mask) == value) {
+			return 0;
+		}
+		delay(10);
+	}
+	return -1;
+}
+
+static void
+k60_modem_aop_kick(volatile uint8_t *ipcc)
+{
+	/* QCOM_IPCC_CLIENT_AOP 0 / QCOM_IPCC_SIGNAL_GLINK_QMP 0. */
+	k60_modem_fence();
+	*(volatile uint32_t *)(ipcc + K60_MODEM_AOP_SEND) = 0;
+	k60_modem_fence();
+}
+
+static volatile uint8_t *
+k60_modem_map(uint64_t physical, size_t bytes)
+{
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)physical,
+	    (vm_size_t)bytes, 0x7);
+
+	return (volatile uint8_t *)(uintptr_t)va;
+}
+
+/* The QMP descriptor lives in the first 0x400 bytes of AOSS. Its message box
+ * is a word offset plus a byte length; both are read back and bounds-checked
+ * before any word is written. */
+static int
+k60_modem_qmp_open(volatile uint8_t *aoss, volatile uint8_t *ipcc, uint32_t *box_out)
+{
+	volatile uint8_t *d = aoss;
+	const uint32_t box = k60_modem_rd32(d, K60_MODEM_QMP_DESC_MBOX_OFFSET);
+	const uint32_t bytes = k60_modem_rd32(d, K60_MODEM_QMP_DESC_MBOX_SIZE);
+	unsigned phase;
+
+	if (k60_modem_rd32(d, K60_MODEM_QMP_DESC_MAGIC) != K60_MODEM_QMP_MAGIC ||
+	    k60_modem_rd32(d, K60_MODEM_QMP_DESC_VERSION) != K60_MODEM_QMP_VERSION) {
+		return -1;
+	}
+	if ((box & 3u) != 0 || box < 0x3cu ||
+	    bytes < K60_MODEM_QMP_MSG_BYTES + 4u ||
+	    bytes > K60_MODEM_QMP_RAM_BYTES || box > bytes ||
+	    bytes - box < K60_MODEM_QMP_MSG_BYTES + 4u) {
+		return -1;
+	}
+	*box_out = box;
+	if (k60_modem_rd32(d, K60_MODEM_QMP_DESC_MCORE_LINK) == K60_MODEM_QMP_STATE_UP &&
+	    k60_modem_rd32(d, K60_MODEM_QMP_DESC_MCORE_LINK_ACK) == K60_MODEM_QMP_STATE_UP &&
+	    k60_modem_rd32(d, K60_MODEM_QMP_DESC_MCORE_CH) == K60_MODEM_QMP_STATE_UP &&
+	    k60_modem_rd32(d, K60_MODEM_QMP_DESC_UCORE_CH) == K60_MODEM_QMP_STATE_UP &&
+	    k60_modem_rd32(d, K60_MODEM_QMP_DESC_MCORE_CH_ACK) == K60_MODEM_QMP_STATE_UP) {
+		return 0;
+	}
+	for (phase = 0; phase < 4; phase++) {
+		if (k60_modem_rd32(d, K60_MODEM_QMP_DESC_MCORE_LINK) != K60_MODEM_QMP_STATE_UP ||
+		    k60_modem_rd32(d, K60_MODEM_QMP_DESC_MCORE_LINK_ACK) != K60_MODEM_QMP_STATE_UP) {
+			k60_modem_wr32(d, K60_MODEM_QMP_DESC_UCORE_LINK_ACK,
+			    k60_modem_rd32(d, K60_MODEM_QMP_DESC_UCORE_LINK));
+			k60_modem_wr32(d, K60_MODEM_QMP_DESC_MCORE_LINK, K60_MODEM_QMP_STATE_UP);
+			k60_modem_fence();
+			k60_modem_aop_kick(ipcc);
+			if (k60_modem_wait_word(d, K60_MODEM_QMP_DESC_MCORE_LINK_ACK,
+			    0xffffu, K60_MODEM_QMP_STATE_UP, 100000)) {
+				continue;
+			}
+		}
+		k60_modem_wr32(d, K60_MODEM_QMP_DESC_MCORE_CH, K60_MODEM_QMP_STATE_UP);
+		k60_modem_fence();
+		k60_modem_aop_kick(ipcc);
+		if (k60_modem_wait_word(d, K60_MODEM_QMP_DESC_UCORE_CH,
+		    0xffffu, K60_MODEM_QMP_STATE_UP, 100000)) {
+			continue;
+		}
+		k60_modem_wr32(d, K60_MODEM_QMP_DESC_UCORE_CH_ACK, K60_MODEM_QMP_STATE_UP);
+		k60_modem_fence();
+		k60_modem_aop_kick(ipcc);
+		if (k60_modem_wait_word(d, K60_MODEM_QMP_DESC_MCORE_CH_ACK,
+		    0xffffu, K60_MODEM_QMP_STATE_UP, 100000)) {
+			continue;
+		}
+		return 0;
+	}
+	return -1;
+}
+
+static int
+k60_modem_qmp_load_state(volatile uint8_t *aoss, volatile uint8_t *ipcc, uint32_t box)
+{
+	volatile uint8_t *mailbox = aoss + box;
+	static const char msg[] = "{class: image, res: load_state, name: modem, val: on}";
+	uint32_t words[K60_MODEM_QMP_WORDS] = { 0 };
+	const size_t n = sizeof(msg) - 1u;
+	size_t i;
+	unsigned w;
+
+	if (n + 1u > K60_MODEM_QMP_MSG_BYTES) {
+		return -1;
+	}
+	for (i = 0; i < n; i++) {
+		words[i / 4u] |= (uint32_t)(uint8_t)msg[i] << (8u * (i % 4u));
+	}
+	if (k60_modem_wait_word(aoss, box, 0xffffffffu, 0, 100000)) {
+		return -1;
+	}
+	for (w = 0; w < K60_MODEM_QMP_WORDS; w++) {
+		k60_modem_wr32(mailbox, 4u + w * 4u, words[w]);
+	}
+	k60_modem_fence();
+	k60_modem_wr32(mailbox, 0, K60_MODEM_QMP_MSG_BYTES);
+	k60_modem_fence();
+	k60_modem_aop_kick(ipcc);
+	return k60_modem_wait_word(aoss, box, 0xffffffffu, 0, 100000);
+}
+
+static int
+k60_modem_find_rail(volatile uint8_t *db, const char *name, uint32_t level,
+    K60RpmhResource *res, uint32_t *index)
+{
+	int rc = k60_cmd_db_find((const uint8_t *)(const void *)db,
+	    K60_CMD_DB_BYTES, name, res);
+
+	if (rc != K60RpmhOk) {
+		return rc;
+	}
+	return k60_rpmh_level_index(res, level, index);
+}
+
+static int
+k60_modem_tcs_conflict(const volatile uint8_t *rsc, const K60RscLayout *l,
+    uint32_t tcs, uint32_t capacity, uint32_t address)
+{
+	uint32_t enable = k60_modem_rd32(rsc, tcs + l->cmd_enable);
+	uint32_t i;
+
+	for (i = 0; i < capacity && i < 16u; i++) {
+		if ((enable & (1u << i)) != 0 &&
+		    k60_modem_rd32(rsc, tcs + (size_t)i * l->cmd_stride + l->cmd_addr) == address) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+/* One RPMh active-only command into TCS4, the sequence that powers the modem
+ * rails on this board. The TCS trigger lives at RSC_DRV + 0xd00; completion
+ * status and IRQ clear live at +0xd04 and +0xd08, not at the RSC DRV_ID page.
+ * Readback happens after wait_for_cmpl/cmd_enable, matching Pong rawVote. */
+static int
+k60_modem_vote_tcs4(volatile uint8_t *rsc, const K60RscLayout *l,
+    uint32_t address, uint32_t value, uint32_t capacity)
+{
+	const size_t base = K60_MODEM_TCS4;
+	uint32_t control;
+	uint32_t progressed = 0;
+	unsigned i;
+	int rc = -1;
+
+	if (k60_modem_rd32(rsc, K60_MODEM_TCS3 + l->status) == 0 &&
+	    k60_modem_tcs_conflict(rsc, l, K60_MODEM_TCS3, capacity, address)) {
+		return -1;
+	}
+	k60_modem_wr32(rsc, K60_MODEM_TCS_BASE,
+	    k60_modem_rd32(rsc, K60_MODEM_TCS_BASE) & ~K60_MODEM_RSC_CTRL_TCS);
+	control = k60_modem_rd32(rsc, base + l->control) & ~(1u << 24);
+	k60_modem_wr32(rsc, base + l->control, control);
+	if (k60_modem_wait_word(rsc, base + l->control, 0xffffffffu, control, 1000)) {
+		return -1;
+	}
+	control &= ~(1u << 16);
+	k60_modem_wr32(rsc, base + l->control, control);
+	if (k60_modem_wait_word(rsc, base + l->control, 0xffffffffu, control, 1000)) {
+		return -1;
+	}
+	k60_modem_wr32(rsc, base + l->cmd_enable, 0);
+	k60_modem_wr32(rsc, K60_MODEM_TCS_BASE + l->irq_clear, K60_MODEM_RSC_IRQ_DONE);
+	if (k60_modem_wait_word(rsc, K60_MODEM_TCS_BASE + l->irq_status,
+	    K60_MODEM_RSC_IRQ_DONE, 0, 1000)) {
+		return -1;
+	}
+	k60_modem_wr32(rsc, base + l->cmd_msgid, K60_MODEM_RSC_MSGID);
+	k60_modem_wr32(rsc, base + l->cmd_addr, address);
+	k60_modem_wr32(rsc, base + l->cmd_data, value);
+	k60_modem_wr32(rsc, base + l->wait_for_cmpl, 1);
+	k60_modem_fence();
+	k60_modem_wr32(rsc, base + l->cmd_enable, 1);
+	if (k60_modem_rd32(rsc, base + l->cmd_addr) != address ||
+	    k60_modem_rd32(rsc, base + l->cmd_data) != value) {
+		goto cleanup;
+	}
+	k60_modem_wr32(rsc, base + l->control, 1u << 16);
+	k60_modem_fence();
+	if (k60_modem_wait_word(rsc, base + l->control, 0xffffffffu, 1u << 16, 1000)) {
+		goto cleanup;
+	}
+	k60_modem_fence();
+	k60_modem_wr32(rsc, base + l->control, (1u << 16) | (1u << 24));
+	for (i = 0; i < 200000u; i++) {
+		const uint32_t status = k60_modem_rd32(rsc, base + l->cmd_data + 4u);
+		const uint32_t idle = k60_modem_rd32(rsc, base + l->status);
+
+		if ((status & K60_MODEM_RSC_CMD_DONE) == K60_MODEM_RSC_CMD_DONE && idle &&
+		    k60_modem_rd32(rsc, base + l->cmd_enable) == 1u &&
+		    k60_modem_rd32(rsc, base + l->cmd_addr) == address &&
+		    k60_modem_rd32(rsc, base + l->cmd_data) == value &&
+		    (progressed || (k60_modem_rd32(rsc, K60_MODEM_TCS_BASE + l->irq_status) &
+		    K60_MODEM_RSC_IRQ_DONE))) {
+			rc = 0;
+			break;
+		}
+		if ((status & K60_MODEM_RSC_CMD_DONE) != K60_MODEM_RSC_CMD_DONE || !idle) {
+			progressed = 1;
+		}
+		if ((i & 0x0fu) == 0) {
+			delay(10);
+		} else {
+			k60_modem_spin();
+		}
+	}
+cleanup:
+	k60_modem_wr32(rsc, base + l->cmd_enable, 0);
+	k60_modem_wr32(rsc, K60_MODEM_TCS_BASE + l->irq_clear, K60_MODEM_RSC_IRQ_DONE);
+	control = k60_modem_rd32(rsc, base + l->control) & ~(1u << 24);
+	k60_modem_wr32(rsc, base + l->control, control);
+	if (k60_modem_wait_word(rsc, base + l->control, 0xffffffffu, control, 1000)) {
+		return -1;
+	}
+	k60_modem_fence();
+	return rc;
+}
+
+/* Send AOP the modem load_state message, then vote the three rails Pong votes
+ * before PAS starts: cx.lvl and mss.lvl at corner 384, xo.lvl at 3. */
+int
+k60_modem_rails_vote(void)
+{
+	volatile uint8_t *aoss = NULL, *ipcc = NULL, *db = NULL, *rsc = NULL;
+	K60RpmhResource cx = { 0 }, mss = { 0 }, xo = { 0 };
+	uint32_t cx_index = 0, mss_index = 0, box = 0;
+	unsigned attempt;
+	uint32_t drv, caps, version, capacity;
+	K60RscLayout layout;
+	const char *why = "aoss map";
+
+	aoss = k60_modem_map(K60_MODEM_AOSS_BASE, K60_MODEM_AOSS_BYTES);
+	if (aoss == NULL) {
+		goto fail;
+	}
+	why = "ipcc map";
+	ipcc = k60_modem_map(K60_MODEM_IPCC_BASE, 0x1000);
+	if (ipcc == NULL) {
+		goto fail;
+	}
+	why = "qmp open";
+	/* qmp_open can spend up to 12 s in its four handshake phases; ten
+	 * attempts bound the wait at about two minutes instead of two hours. */
+	for (attempt = 0; attempt < 10u; attempt++) {
+		if (k60_modem_qmp_open(aoss, ipcc, &box) == 0) {
+			why = "qmp load_state";
+			if (k60_modem_qmp_load_state(aoss, ipcc, box) == 0) {
+				break;
+			}
+		}
+		delay(100000);
+	}
+	if (attempt == 10u) {
+		why = "qmp open/load_state";
+		goto fail;
+	}
+	why = "cmd-db map";
+	db = k60_modem_map(K60_CMD_DB_PHYS, K60_CMD_DB_BYTES);
+	if (db == NULL) {
+		goto fail;
+	}
+	why = "RSC map";
+	rsc = k60_modem_map(K60_RSC_DRV2_PHYS, K60_RSC_BYTES);
+	if (rsc == NULL) {
+		goto fail;
+	}
+	drv = k60_modem_rd32(rsc, 0);
+	caps = k60_modem_rd32(rsc, K60_MODEM_RSC_CAPS);
+	version = (drv >> 16) & 0xffu;
+	if (version != 2u) {
+		why = "RSC version";
+		goto fail;
+	}
+	layout = k60_rsc_layout(drv);
+	capacity = (caps >> 27) & 0x1fu;
+	if (((caps >> 12) & 0x3fu) < 8u || capacity < 1u) {
+		why = "RSC caps";
+		goto fail;
+	}
+	if (k60_modem_rd32(rsc, K60_MODEM_TCS4 + layout.status) == 0) {
+		why = "TCS4 unavailable";
+		goto fail;
+	}
+	if (k60_modem_find_rail(db, "cx.lvl", 384u, &cx, &cx_index) != K60RpmhOk) {
+		why = "cx.lvl";
+		goto fail;
+	}
+	if (k60_modem_find_rail(db, "mss.lvl", 384u, &mss, &mss_index) != K60RpmhOk) {
+		why = "mss.lvl";
+		goto fail;
+	}
+	/* Pong votes xo.lvl as the literal 3 and never converts it through the
+	 * cmd-db level table (PongModemRuntime.cpp:159); the XOB resource has no
+	 * level table, so an index conversion here would either fail or vote a
+	 * different value than the proven path. */
+	if (k60_cmd_db_find((const uint8_t *)(const void *)db, K60_CMD_DB_BYTES,
+	    "xo.lvl", &xo) != K60RpmhOk) {
+		why = "xo.lvl";
+		goto fail;
+	}
+	why = "cx.lvl vote";
+	if (k60_modem_vote_tcs4(rsc, &layout, cx.address, cx_index, capacity) != 0) {
+		goto fail;
+	}
+	why = "mss.lvl vote";
+	if (k60_modem_vote_tcs4(rsc, &layout, mss.address, mss_index, capacity) != 0) {
+		goto fail;
+	}
+	why = "xo.lvl vote";
+	if (k60_modem_vote_tcs4(rsc, &layout, xo.address, 3u, capacity) != 0) {
+		goto fail;
+	}
+	printf("K60MODEM power ok cx=%#x/%u mss=%#x/%u xo=%#x/%u\n",
+	    cx.address, cx_index, mss.address, mss_index, xo.address, 3u);
+	return 0;
+
+fail:
+	printf("K60MODEM power failed: %s\n", why);
+	return -1;
+}
+
+static int k60_qrtr_modem_ready(volatile uint8_t *smem, uint32_t offset,
+    uint32_t bytes, uint32_t *seen);
+static int k60_modem_glink_start(volatile uint8_t *window, uint32_t desc_offset,
+    uint32_t desc_bytes, uint32_t tx_offset, uint32_t tx_bytes,
+    uint32_t rx_offset, uint32_t rx_bytes);
+
+int
+k60_modem_transport_prepare(void)
+{
+	K60Smem smem;
+	K60SmemPartition partition;
+	const uint16_t ids[3] = { K60_MODEM_SMP2P_OURS, K60_MODEM_GLINK_DESC,
+	    K60_MODEM_GLINK_OURS };
+	const uint32_t bytes[3] = { K60_MODEM_SMP2P_ITEM_WORDS * 4u, 32u,
+	    K60_MODEM_GLINK_TX_BYTES };
+	uint32_t offsets[3] = { 0, 0, 0 }, sizes[3] = { 0, 0, 0 };
+	uint32_t guard_offset = 0, guard_size = 0, guard_seen = 0;
+	volatile uint8_t *window, *mutex;
+	volatile uint32_t *out, *desc;
+	unsigned i;
+	int rc, locked = 0;
+
+	window = (volatile uint8_t *)ml_io_map_unmappable(K60_MODEM_SMEM_BASE,
+	    K60_MODEM_SMEM_BYTES, 0x7);
+	if (window == NULL) {
+		printf("K60MODEM transport: smem map failed at %#x\n",
+		    K60_MODEM_SMEM_BASE);
+		return -1;
+	}
+	smem.base = window;
+	smem.size = K60_MODEM_SMEM_BYTES;
+	rc = k60_smem_partition(&smem, 0, 1, &partition);
+	if (rc != K60SmemOk) {
+		printf("K60MODEM transport: no modem smem partition rc=%d\n", rc);
+		return rc;
+	}
+	/* Pong refuses to reset a modem that still owns the inbound SMP2P
+	 * block. Read the old 435 state before touching 428 or the GLINK
+	 * descriptor so a stale modem is never silently overwritten. */
+	if (k60_smem_find(&smem, &partition, K60_MODEM_SMP2P_THEIRS,
+	    &guard_offset, &guard_size) == K60SmemOk &&
+	    k60_qrtr_modem_ready(window, guard_offset, guard_size, &guard_seen)) {
+		printf("K60MODEM transport: modem still owns smp2p entries=%u, refusing reset\n",
+		    guard_seen);
+		return -16;
+	}
+	/* The SMEM allocator is shared with the ADSP; take the TCSR SMEM
+	 * mutex 0x1f43000 exactly as Pong does around item allocation. */
+	mutex = (volatile uint8_t *)ml_io_map_unmappable(
+	    K60_MODEM_SMEM_MUTEX_BASE, 0x1000, 0x7);
+	if (mutex == NULL) {
+		printf("K60MODEM transport: smem mutex map failed\n");
+		return -1;
+	}
+	for (i = 0; i < 1000; i++) {
+		*(volatile uint32_t *)mutex = 1;
+		k60_modem_fence();
+		if (*(volatile uint32_t *)mutex == 1u) {
+			locked = 1;
+			break;
+		}
+		delay(10);
+	}
+	if (!locked) {
+		printf("K60MODEM transport: smem mutex timeout\n");
+		return -1;
+	}
+	for (i = 0; i < 3; i++) {
+		rc = k60_transport_item(&smem, &partition, ids[i], bytes[i],
+		    &offsets[i], &sizes[i]);
+		if (rc != K60SmemOk) {
+			*(volatile uint32_t *)mutex = 0;
+			k60_modem_fence();
+			printf("K60MODEM transport: item %u unavailable rc=%d\n",
+			    ids[i], rc);
+			return rc;
+		}
+	}
+	*(volatile uint32_t *)mutex = 0;
+	k60_modem_fence();
+	out = (volatile uint32_t *)(window + offsets[0]);
+	k60_smp2p_init_out(out);
+	k60_qrtr_smp2p_stop_entry = k60_smp2p_add_entry(out, "master-kernel");
+	k60_qrtr_smp2p_ipa_entry = k60_smp2p_add_entry(out, "ipa");
+	k60_qrtr_smp2p_out = out;
+	if (k60_qrtr_smp2p_stop_entry < 0 || k60_qrtr_smp2p_ipa_entry < 0) {
+		printf("K60MODEM transport: smp2p entries full\n");
+		return -1;
+	}
+	k60_smp2p_release_stop(out);
+	desc = (volatile uint32_t *)(window + offsets[1]);
+	/* Only the AP-owned indices are reset; desc[0]/desc[3] belong to the
+	 * remote and must stay intact so a live FIFO is never mistaken for fresh. */
+	desc[1] = 0;
+	desc[2] = 0;
+	k60_smp2p_barrier();
+	{
+		uint32_t rx_offset = 0, rx_size = 0;
+
+		if (k60_smem_find(&smem, &partition, K60_MODEM_GLINK_THEIRS,
+		    &rx_offset, &rx_size) == K60SmemOk) {
+			k60_qrtr_ipcc = (volatile uint8_t *)ml_io_map_unmappable(
+			    K60_MODEM_IPCC_BASE, 0x1000, 0x7);
+			if (k60_qrtr_ipcc == NULL) {
+				printf("K60MODEM transport: ipcc map failed\n");
+				return -1;
+			}
+			rc = k60_modem_glink_start(window, offsets[1], sizes[1],
+			    offsets[2], sizes[2], rx_offset, rx_size);
+			if (rc != 0) {
+				printf("K60MODEM transport: glink init rc=%d\n", rc);
+				return rc;
+			}
+		} else {
+			printf("K60MODEM transport: remote glink fifo absent, defer IPCRTR\n");
+		}
+	}
+	printf("K60MODEM transport ok smp2p=%#x/%u desc=%#x/%u tx=%#x/%u\n",
+	    offsets[0], sizes[0], offsets[1], sizes[1], offsets[2], sizes[2]);
+	return 0;
+}
+
+/* True when the modem's SMP2P block says the modem is up and not fatal. */
+static int
+k60_qrtr_modem_ready(volatile uint8_t *smem, uint32_t offset, uint32_t bytes, uint32_t *seen)
+{
+	volatile uint32_t *words = (volatile uint32_t *)(smem + offset);
+	uint32_t count, total, valid, i, word;
+
+	if (bytes < 20 || words[0] != K60_MODEM_SMP2P_MAGIC || (words[1] & 0xffu) != 1u) {
+		return 0;
+	}
+	if (words[2] != 1u) {   /* local processor id: 1 is the modem */
+		return 0;
+	}
+	count = words[3];
+	total = count & 0xffffu;
+	valid = count >> 16;
+	if (total > 16 || valid > total || 20u + valid * 20u > bytes) {
+		return 0;
+	}
+	*seen = valid;
+	for (i = 0; i < valid; i++) {
+		const volatile uint32_t *entry = words + 5 + i * 5;
+		const uint32_t state = entry[4];
+		const uint32_t name[4] = {entry[0], entry[1], entry[2], entry[3]};
+		static const char wanted[16] = "slave-kernel";
+		int same = 1;
+		unsigned b;
+
+		for (word = 0; word < 4; word++) {
+			for (b = 0; b < 4; b++) {
+				if ((uint8_t)(name[word] >> (b * 8)) != (uint8_t)wanted[word * 4 + b]) {
+					same = 0;
+				}
+			}
+		}
+		if (same) {
+			return (state & 2u) != 0 && (state & 1u) == 0;
+		}
+	}
+	return 0;
+}
+
+/* Read-only guard used by k60_modem_bring_up before it copies an image or
+ * touches PAS. Pong refuses a stale modem at item 435 before PAS_INIT_IMAGE. */
+int
+k60_modem_transport_stale(void)
+{
+	K60Smem smem;
+	K60SmemPartition partition;
+	uint32_t offset = 0, size = 0, seen = 0;
+	volatile uint8_t *window;
+	int rc;
+
+	window = (volatile uint8_t *)ml_io_map_unmappable(K60_MODEM_SMEM_BASE,
+	    K60_MODEM_SMEM_BYTES, 0x7);
+	if (window == NULL) {
+		printf("K60MODEM stale check: smem map failed\n");
+		return -1;
+	}
+	smem.base = window;
+	smem.size = K60_MODEM_SMEM_BYTES;
+	rc = k60_smem_partition(&smem, 0, 1, &partition);
+	if (rc != K60SmemOk) {
+		printf("K60MODEM stale check: no modem smem partition rc=%d\n", rc);
+		return -1;
+	}
+	rc = k60_smem_find(&smem, &partition, K60_MODEM_SMP2P_THEIRS, &offset, &size);
+	if (rc == K60SmemOk && k60_qrtr_modem_ready(window, offset, size, &seen)) {
+		printf("K60MODEM stale check: modem still owns smp2p entries=%u, refusing reset\n", seen);
+		return -16;
+	}
+	return 0;
+}
+
+/* Print the first unread GLINK message as eight little-endian words.
+ * A peer that has just booted writes nothing before our first VERSION, so at
+ * adopt the remote write index is the discriminator: zero means a clean ring,
+ * anything else means the ring still holds the previous session (the modem
+ * does not have to clear its own index when it reboots). */
+static void
+k60_qrtr_print_ring(const char *tag, const QcomGlinkFifo *tx,
+    const QcomGlinkFifo *rx)
+{
+	uint8_t m[32] = {0};
+	uint32_t w[8] = {0}, avail = 0, head = 0, tail = 0, b;
+
+	if (rx->data != NULL && rx->head != NULL && rx->tail != NULL) {
+		avail = k60m_glink_rx_avail(rx);
+		head = *rx->head;
+		tail = *rx->tail;
+		for (b = 0; b < 32u && b < avail; ++b) {
+			m[b] = rx->data[(tail + b) % rx->length];
+		}
+	}
+	for (b = 0; b < 8u; ++b) {
+		const uint32_t at = b * 4u;
+
+		w[b] = (uint32_t)m[at] | ((uint32_t)m[at + 1] << 8) |
+		    ((uint32_t)m[at + 2] << 16) | ((uint32_t)m[at + 3] << 24);
+	}
+	printf("K60MODEM qrtr: %s rx head=%u tail=%u avail=%u tx head=%u tail=%u cmd=%#x p1=%#x p2=%#x w2=%#x w3=%#x w4=%#x w5=%#x w6=%#x w7=%#x\n",
+	    tag, head, tail, avail,
+	    tx->head != NULL ? (unsigned)*tx->head : 0u,
+	    tx->tail != NULL ? (unsigned)*tx->tail : 0u,
+	    (unsigned)(w[0] & 0xffffu), (unsigned)(w[0] >> 16), w[1], w[2], w[3],
+	    w[4], w[5], w[6], w[7]);
+}
+
+/* Adopt the AP-owned GLINK pair and open IPCRTR as the initiator. Pong does
+ * this after PAS_INIT_IMAGE and before PAS_MEM_SETUP, not after AUTH. */
+static int
+k60_modem_glink_start(volatile uint8_t *window, uint32_t desc_offset,
+    uint32_t desc_bytes, uint32_t tx_offset, uint32_t tx_bytes,
+    uint32_t rx_offset, uint32_t rx_bytes)
+{
+	volatile uint32_t *desc;
+	QcomGlinkFifo tx, rx;
+	const QcomGlinkClient callbacks = {k60_qrtr_state_cb, k60_qrtr_receive_cb};
+	int rc;
+
+	if (desc_bytes != 32 || tx_bytes < 1024 || rx_bytes < 1024) {
+		printf("K60MODEM glink: geometry wrong desc=%u tx=%u rx=%u\n",
+		    desc_bytes, tx_bytes, rx_bytes);
+		return -1;
+	}
+	desc = (volatile uint32_t *)(window + desc_offset);
+	/* The AP-owned indices are cleared by transport_prepare after the item
+	 * 435 stale check; this function no longer pretends to gate freshness. */
+	tx.head = &desc[1];
+	tx.tail = &desc[0];
+	tx.data = (volatile uint8_t *)(window + tx_offset);
+	tx.length = tx_bytes;
+	rx.head = &desc[3];
+	rx.tail = &desc[2];
+	rx.data = (volatile uint8_t *)(window + rx_offset);
+	rx.length = rx_bytes;
+	rc = k60m_glink_adopt(&k60_qrtr_link, tx, rx, k60_qrtr_kick, NULL);
+	if (rc != QcomGlinkOk) {
+		printf("K60MODEM glink: adopt rc=%d\n", rc);
+		return rc;
+	}
+	/* A peer that has just booted writes nothing before our first
+	 * VERSION, so the ring is clean exactly when its head is zero. */
+	k60_qrtr_print_ring("glink adopt (transport)", &tx, &rx);
+	k60_qrtr_channel = k60m_glink_channel(&k60_qrtr_link, "IPCRTR",
+	    K60_QRTR_INTENT_SIZE, K60_QRTR_INTENT_COUNT, k60_qrtr_intents,
+	    &callbacks, NULL, 1);
+	if (k60_qrtr_channel == NULL) {
+		printf("K60MODEM glink: no channel slot for IPCRTR\n");
+		return -1;
+	}
+	k60_qrtr_glink_ready = 1;
+	printf("K60MODEM glink: IPCRTR opened as initiator\n");
+	return 0;
+}
+
+int
+k60_modem_qrtr_probe(void)
+{
+	K60Smem smem;
+	K60SmemPartition partition;
+	uint32_t offsets[4] = {0, 0, 0, 0}, sizes[4] = {0, 0, 0, 0};
+	const uint32_t items[4] = {K60_MODEM_GLINK_DESC, K60_MODEM_GLINK_OURS,
+	    K60_MODEM_GLINK_THEIRS, K60_MODEM_SMP2P_THEIRS};
+	volatile uint8_t *window;
+	volatile uint32_t *desc;
+	QcomGlinkFifo tx, rx;
+	const QcomGlinkClient callbacks = {k60_qrtr_state_cb, k60_qrtr_receive_cb};
+	uint32_t i, seen = 0;
+	int enabled = 0, qrtr_mode = 2, rc, bridge_reported = 0, ready_reported = 0;
+
+	if (!PE_parse_boot_argn("pong_modem", &enabled, sizeof(enabled)) || enabled < 2) {
+		return 0;   /* default: not one byte is touched */
+	}
+	/* k43: pong_qrtr selects what the probe says after the handshake, so one
+	 * image can tell whether our own requests silence the modem. 0 = HELLO
+	 * probes only, 1 = HELLO plus lookups, 2 = lookups and the fixed DMS port. */
+	if (!PE_parse_boot_argn("pong_qrtr", &qrtr_mode, sizeof(qrtr_mode))) {
+		qrtr_mode = 2;
+	}
+	window = (volatile uint8_t *)ml_io_map_unmappable(K60_MODEM_SMEM_BASE,
+	    K60_MODEM_SMEM_BYTES, 0x7);
+	if (window == NULL) {
+		printf("K60MODEM qrtr: smem map failed at %#x\n", K60_MODEM_SMEM_BASE);
+		return -1;
+	}
+	k60_qrtr_ipcc = (volatile uint8_t *)ml_io_map_unmappable(K60_MODEM_IPCC_BASE, 0x1000, 0x7);
+	if (k60_qrtr_ipcc == NULL) {
+		printf("K60MODEM qrtr: ipcc map failed at %#x\n", K60_MODEM_IPCC_BASE);
+		return -1;
+	}
+	smem.base = window;
+	smem.size = K60_MODEM_SMEM_BYTES;
+	rc = k60_smem_partition(&smem, 0, 1, &partition);
+	if (rc != K60SmemOk) {
+		printf("K60MODEM qrtr: no modem smem partition rc=%d\n", rc);
+		return -1;
+	}
+	/* 478/479 are AP-owned and must exist now. 480 and 435 are created by
+	 * the modem during its own boot; wait for both instead of failing the
+	 * cold boot before the readiness poll. */
+	for (i = 0; i < 2; i++) {
+		rc = k60_smem_find(&smem, &partition, (uint16_t)items[i], &offsets[i], &sizes[i]);
+		if (rc != K60SmemOk) {
+			printf("K60MODEM qrtr: smem item %u missing rc=%d\n", items[i], rc);
+			return -1;
+		}
+	}
+	for (i = 0; i < K60_QRTR_READY_POLLS; i++) {
+		if (sizes[2] == 0) {
+			(void)k60_smem_find(&smem, &partition, (uint16_t)items[2],
+			    &offsets[2], &sizes[2]);
+		}
+		rc = k60_smem_find(&smem, &partition, (uint16_t)items[3],
+		    &offsets[3], &sizes[3]);
+		if (rc == K60SmemOk && (i % 500u) == 0u) {
+			/* Which comes first: the modem-created glink fifo or the
+			 * smp2p readiness item?  k37 and k38 opened the channel only
+			 * after both, and by then most QRTR registrations were gone;
+			 * the gap decides whether opening earlier is even possible. */
+			printf("K60MODEM qrtr: ready wait %u ms fifo=%u smp2p=%u items=%u\n",
+			    (unsigned)(i * K60_QRTR_POLL_US / 1000u),
+			    sizes[2], rc == K60SmemOk ? 1u : 0u, seen);
+		}
+		if (sizes[2] != 0) {
+			/* k40 measured the gap between the glink fifo (item 480) and
+			 * the smp2p readiness item (435).  k41 opens IPCRTR as soon as
+			 * the fifo exists, so the channel is up before the modem
+			 * registers its QMI services; readiness is reported below and
+			 * polled again inside the QRTR loop. */
+			break;
+		}
+		delay(K60_QRTR_POLL_US);
+	}
+	if (i == K60_QRTR_READY_POLLS) {
+		printf("K60MODEM qrtr: modem not ready after %u ms (smp2p items=%u)\n",
+		    K60_QRTR_READY_POLLS * K60_QRTR_POLL_US / 1000u, seen);
+		return -2;
+	}
+	if (sizes[2] == 0) {
+		printf("K60MODEM qrtr: remote glink fifo item %u missing after %u ms\n",
+		    items[2], K60_QRTR_READY_POLLS * K60_QRTR_POLL_US / 1000u);
+		return -2;
+	}
+	printf("K60MODEM qrtr: glink desc=%#x/%u ours=%#x/%u theirs=%#x/%u\n",
+	    offsets[0], sizes[0], offsets[1], sizes[1], offsets[2], sizes[2]);
+	ready_reported = (k60_smem_find(&smem, &partition, (uint16_t)items[3],
+	    &offsets[3], &sizes[3]) == K60SmemOk &&
+	    k60_qrtr_modem_ready(window, offsets[3], sizes[3], &seen));
+	if (ready_reported) {
+		printf("K60MODEM qrtr: modem ready (smp2p items=%u)\n", seen);
+	} else {
+		printf("K60MODEM qrtr: fifo at %u ms, smp2p not ready yet; opening IPCRTR early\n",
+		    (unsigned)(i * K60_QRTR_POLL_US / 1000u));
+	}
+	if (!k60_qrtr_glink_ready) {
+		if (sizes[0] != 32 || sizes[1] < 1024 || sizes[2] < 1024) {
+			printf("K60MODEM qrtr: glink geometry wrong desc=%u ours=%u theirs=%u\n",
+			    sizes[0], sizes[1], sizes[2]);
+			return -1;
+		}
+		desc = (volatile uint32_t *)(window + offsets[0]);
+		/* A live Android epoch owns these indices; we never reset them. A
+		 * fresh epoch has our head and its tail at zero, which is what we adopt. */
+		if (desc[1] != 0 || desc[2] != 0) {
+			printf("K60MODEM qrtr: glink fifo not fresh (our_head=%u their_tail=%u), not adopted\n",
+			    desc[1], desc[2]);
+			return -1;
+		}
+		tx.head = &desc[1];
+		tx.tail = &desc[0];
+		tx.data = (volatile uint8_t *)(window + offsets[1]);
+		tx.length = sizes[1];
+		rx.head = &desc[3];
+		rx.tail = &desc[2];
+		rx.data = (volatile uint8_t *)(window + offsets[2]);
+		rx.length = sizes[2];
+		rc = k60m_glink_adopt(&k60_qrtr_link, tx, rx, k60_qrtr_kick, NULL);
+		if (rc != QcomGlinkOk) {
+			printf("K60MODEM qrtr: glink adopt rc=%d\n", rc);
+			return -1;
+		}
+		/* This is the path a B flight takes: transport_prepare defers
+		 * IPCRTR when the modem has not published item 480 yet. The ring
+		 * may still hold the previous session, and the modem's write
+		 * index is not ours to clear, so a non-zero head here cannot be
+		 * a reply to anything we have sent - drop it instead of replaying
+		 * another session's handshake as if it were ours. */
+		k60_qrtr_print_ring("glink adopt (probe)", &tx, &rx);
+		if (*rx.head != 0u) {
+			const uint32_t stale = k60m_glink_rx_avail(&rx);
+
+			*rx.tail = *rx.head;
+			k60_modem_fence();
+			printf("K60MODEM qrtr: glink adopt dropped %u stale bytes (head=%u)\n",
+			    stale, (unsigned)*rx.head);
+		}
+		k60_qrtr_channel = k60m_glink_channel(&k60_qrtr_link, "IPCRTR",
+		    K60_QRTR_INTENT_SIZE, K60_QRTR_INTENT_COUNT, k60_qrtr_intents,
+		    &callbacks, NULL, 1);
+		if (k60_qrtr_channel == NULL) {
+			printf("K60MODEM qrtr: no channel slot for IPCRTR\n");
+			return -1;
+		}
+	} else {
+		printf("K60MODEM qrtr: GLINK already opened by transport\n");
+	}
+	printf("K60MODEM qrtr: opening IPCRTR as initiator\n");
+	bridge_reported = coachz_baseband_enabled() != 0;
+	printf("K60MODEM baseband: bridge %s\n",
+	    bridge_reported ? "enabled" : "disabled");
+	coachz_baseband_configure(k60_baseband_send, k60_baseband_del_client);
+	for (i = 0; i < K60_QRTR_POLLS; i++) {
+		const int polls = k60m_glink_poll(&k60_qrtr_link);
+
+		if (polls < 0) {
+			/* QcomGlinkCorrupt leaves the offending message at the head of the
+			 * RX ring (receive_one peeks, never advances, and stop() keeps the
+			 * FIFO). Snapshot it so a single flight identifies the branch. */
+			const QcomGlinkFifo *rx = &k60_qrtr_link.rx;
+			uint32_t avail = rx->data != NULL ? k60m_glink_rx_avail(rx) : 0u;
+			uint32_t head = rx->head != NULL ? *rx->head : 0u;
+			uint32_t tail = rx->tail != NULL ? *rx->tail : 0u;
+			uint8_t m[32] = {0};
+			uint32_t w[8], b;
+
+			/* rx_peek() reads from the tail; head is the modem's write
+			 * index, so sampling there shows unused ring bytes (k30 did
+			 * exactly that and printed cmd=0 p1=0 p2=0). */
+			for (b = 0; b < 32u && b < avail && rx->data != NULL; ++b) {
+				m[b] = rx->data[(tail + b) % rx->length];
+			}
+			for (b = 0; b < 8u; ++b) {
+				const uint32_t at = b * 4u;
+
+				w[b] = (uint32_t)m[at] | ((uint32_t)m[at + 1] << 8) |
+				    ((uint32_t)m[at + 2] << 16) | ((uint32_t)m[at + 3] << 24);
+			}
+			printf("K60MODEM qrtr: glink poll rc=%d at %u rx avail=%u head=%u tail=%u tx head=%u tx tail=%u cmd=%#x p1=%#x p2=%#x w2=%#x w3=%#x w4=%#x w5=%#x w6=%#x w7=%#x\n",
+			    polls, i, avail, head, tail,
+			    k60_qrtr_link.tx.head != NULL ? (unsigned)*k60_qrtr_link.tx.head : 0u,
+			    k60_qrtr_link.tx.tail != NULL ? (unsigned)*k60_qrtr_link.tx.tail : 0u,
+			    (unsigned)(w[0] & 0xffffu), (unsigned)(w[0] >> 16), w[1],
+			    w[2], w[3], w[4], w[5], w[6], w[7]);
+			return polls;
+		}
+		coachz_baseband_poll();
+		if (i != 0u && i % 2500u == 0u) {
+			unsigned rbusy = 0, rvalid = 0, ladvertised = 0, lcount = 0;
+			unsigned lbusy = 0, ldone = 0;
+			uint32_t rxavail = 0, rxhead = 0, rxtail = 0;
+
+			k60_qrtr_intent_counts(&rbusy, &rvalid, &ladvertised, &lcount,
+			    &lbusy, &ldone);
+			if (k60_qrtr_link.rx.head != NULL && k60_qrtr_link.rx.tail != NULL) {
+				rxavail = k60m_glink_rx_avail(&k60_qrtr_link.rx);
+				rxhead = (unsigned)*k60_qrtr_link.rx.head;
+				rxtail = (unsigned)*k60_qrtr_link.rx.tail;
+			}
+			/* tx.tail is the modem's read index: a value that trails our
+			 * head means it consumed what we sent; one that never moves
+			 * means the DATA never left the ring. */
+			printf("K60MODEM qrtr: wait %u s services=%u wanted=%u dms=%u malformed=%u tx head=%u tail=%u rx avail=%u head=%u tail=%u intents=%u/%u local=%u/%u lbusy=%u ldone=%u msgs=%u/%u dropped=%u rxcmd=%u/%u/%u/%u replies=%u rmtfs=%u ipa=%#x\n",
+			    i / 500u, k60_qrtr_state.services, k60_qrtr_state.wanted,
+			    k60_qrtr_state.dms_found, k60_qrtr_state.malformed,
+			    k60_qrtr_link.tx.head != NULL ? (unsigned)*k60_qrtr_link.tx.head : 0u,
+			    k60_qrtr_link.tx.tail != NULL ? (unsigned)*k60_qrtr_link.tx.tail : 0u,
+			    rxavail, rxhead, rxtail, rbusy, rvalid, ladvertised, lcount,
+			    lbusy, ldone,
+			    k60_qrtr_link.rx_messages, k60_qrtr_link.tx_messages,
+			    k60_qrtr_link.dropped,
+			    k60_qrtr_rx_cmds[1], k60_qrtr_rx_cmds[2], k60_qrtr_rx_cmds[3],
+			    k60_qrtr_rx_cmds[4], k60_qrtr_lookup_replies,
+			    k60_qrtr_rmtfs_requests, k60_qrtr_ipa_state);
+			if (i == 2500u) {
+				k60_qrtr_dump_intents();
+			}
+			if (!ready_reported &&
+			    k60_smem_find(&smem, &partition, (uint16_t)items[3],
+			    &offsets[3], &sizes[3]) == K60SmemOk &&
+			    k60_qrtr_modem_ready(window, offsets[3], sizes[3], &seen)) {
+				ready_reported = 1;
+				printf("K60MODEM qrtr: modem ready (smp2p items=%u) at %u s\n",
+				    seen, i / 500u);
+			}
+		}
+		/* The ipa entry is a question, not a state: the modem raises bit 0 to
+		 * ask whether the AP retains the IPA clock, and the answer is bit 0
+		 * (complete) plus bit 1 (vote) written into our own entry
+		 * (PongModemControl.cpp:139-147). Nothing here answered it, and a modem
+		 * that never receives the answer has no reason to bring the rest of its
+		 * stack up. Answer 1 first: complete, with no clock claim, because IPA
+		 * votes its own clock when it starts. */
+		if (k60_qrtr_smp2p_ipa_entry >= 0 && k60_qrtr_smp2p_out != NULL &&
+		    k60_smem_find(&smem, &partition, (uint16_t)items[3],
+		    &offsets[3], &sizes[3]) == K60SmemOk &&
+		    k60_smp2p_find((volatile uint32_t *)(window + offsets[3]), sizes[3],
+		    "ipa", &k60_qrtr_ipa_state) &&
+		    (k60_qrtr_ipa_state & 1u) != 0u && !k60_qrtr_ipa_replied) {
+			++k60_qrtr_ipa_queries;
+			k60_qrtr_ipa_replied = 1;
+			k60_smp2p_update(k60_qrtr_smp2p_out, k60_qrtr_smp2p_ipa_entry,
+			    3u, K60_QRTR_IPA_ANSWER);
+			k60_smp2p_barrier();
+			printf("K60MODEM qrtr: ipa query=%#x reply=%#x at %u s\n",
+			    k60_qrtr_ipa_state, K60_QRTR_IPA_ANSWER, i / 500u);
+		}
+		/* k42: the modem answers HELLO even when it ignores every lookup, so a
+		 * repeated HELLO is the only liveness probe we have. A count that keeps
+		 * rising while tx tail stands still proves the tail is not the modem's
+		 * read pointer; one that stops proves the modem really went quiet. */
+		/* Mode 3 is the quiet control: one HELLO and then silence, so the next
+		 * flight shows whether our own periodic traffic is what silences the
+		 * modem about forty seconds in. */
+		if (qrtr_mode != 3 && k60_qrtr_hello_sent && i != 0u && i % 5000u == 0u) {
+			uint8_t probe[K60_QRTR_LOOKUP_BYTES];
+
+			if (k60_qrtr_build_hello(probe, sizeof(probe)) != 0) {
+				const int probe_rc = k60m_glink_send(&k60_qrtr_link,
+				    k60_qrtr_channel, probe, K60_QRTR_LOOKUP_BYTES);
+
+				if (probe_rc == QcomGlinkOk) {
+					++k60_qrtr_hello_probes;
+					printf("K60MODEM qrtr: hello probe #%u, acks=%u\n",
+					    k60_qrtr_hello_probes, k60_qrtr_state.hello_acks);
+				} else if (probe_rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: hello probe rc=%d\n", probe_rc);
+				}
+			}
+		}
+		if (i != 0u && i % 500u == 0u) {
+			/* QcomBaseband defers publication when IOResources is not ready;
+			 * retry once a second instead of latching the first failure. */
+			coachz_baseband_configure(k60_baseband_send, k60_baseband_del_client);
+			coachz_baseband_report(i / 500u);
+			/* The bridge state is printed once before the loop, before the
+			 * provider can publish. Announce the transition too, or a late
+			 * publication is invisible to the S6 criterion. */
+			if (!bridge_reported && coachz_baseband_enabled()) {
+				bridge_reported = 1;
+				printf("K60MODEM baseband: bridge enabled (poll %u)\n", i);
+			}
+		}
+		if (k60_qrtr_up && !k60_qrtr_hello_sent) {
+			uint8_t packet[K60_QRTR_LOOKUP_BYTES];
+
+			if (k60_qrtr_build_hello(packet, sizeof(packet)) != 0) {
+				const int send_rc = k60m_glink_send(&k60_qrtr_link,
+				    k60_qrtr_channel, packet, K60_QRTR_LOOKUP_BYTES);
+
+				if (send_rc == QcomGlinkOk) {
+					k60_qrtr_hello_sent = 1;
+					printf("K60MODEM qrtr: sent hello from node %u port %#x mode=%d\n",
+					    K60_QRTR_AP_NODE, K60_QRTR_CONTROL_PORT, qrtr_mode);
+				} else if (send_rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: hello send rc=%d\n", send_rc);
+					return send_rc;
+				}
+			}
+		}
+		/* Pong starts the modem only after its storage service answers; the
+		 * modem may be waiting for exactly that before it brings its QMI
+		 * stack up. Announce the service and log whatever it asks. */
+		if (k60_qrtr_server_sent && !k60_qrtr_rmtfs_sent) {
+			uint8_t packet[K60_QRTR_LOOKUP_BYTES];
+			uint32_t rmtfs_node = k60_qrtr_state.remote_node;
+
+			if (rmtfs_node == K60_QRTR_CONTROL_PORT ||
+			    rmtfs_node == K60_QRTR_AP_NODE) {
+				rmtfs_node = K60_QRTR_BROADCAST_NODE;
+			}
+			if (k60_qrtr_build_new_server(packet, sizeof(packet),
+			    K60_QRTR_RMTFS_SERVICE, K60_QRTR_RMTFS_INSTANCE,
+			    rmtfs_node, K60_QRTR_RMTFS_PORT) != 0) {
+				const int send_rc = k60m_glink_send(&k60_qrtr_link,
+				    k60_qrtr_channel, packet, K60_QRTR_LOOKUP_BYTES);
+
+				if (send_rc == QcomGlinkOk) {
+					k60_qrtr_rmtfs_sent = 1;
+					printf("K60MODEM qrtr: announced rmtfs service %u instance %u port %#x\n",
+					    K60_QRTR_RMTFS_SERVICE, K60_QRTR_RMTFS_INSTANCE,
+					    K60_QRTR_RMTFS_PORT);
+				} else if (send_rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: rmtfs announce rc=%d\n", send_rc);
+					return send_rc;
+				}
+			}
+		}
+		if (k60_qrtr_hello_sent && k60_qrtr_state.hello_acks != 0 &&
+		    !k60_qrtr_server_sent) {
+			uint8_t packet[K60_QRTR_LOOKUP_BYTES];
+			uint32_t to_node = k60_qrtr_state.remote_node;
+
+			if (to_node == K60_QRTR_CONTROL_PORT || to_node == K60_QRTR_AP_NODE) {
+				to_node = K60_QRTR_BROADCAST_NODE;
+			}
+			if (k60_qrtr_build_new_server(packet, sizeof(packet),
+			    K60_QRTR_SERVLOC_SERVICE, K60_QRTR_SERVLOC_INSTANCE,
+			    to_node, K60_QRTR_LOCATOR_PORT) != 0) {
+				const int send_rc = k60m_glink_send(&k60_qrtr_link,
+				    k60_qrtr_channel, packet, K60_QRTR_LOOKUP_BYTES);
+
+				if (send_rc == QcomGlinkOk) {
+					k60_qrtr_server_sent = 1;
+					printf("K60MODEM qrtr: announced servloc service %u instance %#x port %#x\n",
+					    K60_QRTR_SERVLOC_SERVICE, K60_QRTR_SERVLOC_INSTANCE,
+					    K60_QRTR_LOCATOR_PORT);
+				} else if (send_rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: servloc announce rc=%d\n", send_rc);
+					return send_rc;
+				}
+			}
+		}
+		/* k36 saw two spontaneous registrations (service 66 and 0x2b) and no
+		 * answer to the unicast lookup within ten seconds; k37 asked twice in
+		 * sixty seconds and still heard nothing. Keep asking for four minutes,
+		 * alternating an all-services query with a DMS-targeted one, because a
+		 * service that registers at the fourth minute is still a service. */
+		/* The reference registers the heap share service right after storage, so
+		 * the modem sees the same three services Pong offers. */
+		if (k60_qrtr_rmtfs_sent && !k60_qrtr_memshare_sent) {
+			uint8_t packet[K60_QRTR_LOOKUP_BYTES];
+			uint32_t memshare_node = k60_qrtr_state.remote_node;
+
+			if (memshare_node == K60_QRTR_CONTROL_PORT ||
+			    memshare_node == K60_QRTR_AP_NODE) {
+				memshare_node = K60_QRTR_BROADCAST_NODE;
+			}
+			if (k60_qrtr_build_new_server(packet, sizeof(packet),
+			    K60_MEMSHARE_SERVICE, K60_MEMSHARE_INSTANCE,
+			    memshare_node, K60_MEMSHARE_PORT) != 0) {
+				const int send_rc = k60m_glink_send(&k60_qrtr_link,
+				    k60_qrtr_channel, packet, K60_QRTR_LOOKUP_BYTES);
+
+				if (send_rc == QcomGlinkOk) {
+					k60_qrtr_memshare_sent = 1;
+					printf("K60MODEM qrtr: announced memshare service %u instance %u port %#x\n",
+					    K60_MEMSHARE_SERVICE, K60_MEMSHARE_INSTANCE,
+					    K60_MEMSHARE_PORT);
+				} else if (send_rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: memshare announce rc=%d\n", send_rc);
+					return send_rc;
+				}
+			}
+		}
+		if (k60_qrtr_hello_sent && k60_qrtr_state.hello_acks != 0 &&
+		    (qrtr_mode == 1 || qrtr_mode == 2) &&
+		    k60_qrtr_lookup_count < K60_QRTR_LOOKUP_MAX &&
+		    i >= (int)k60_qrtr_lookup_next) {
+			uint8_t packet[K60_QRTR_LOOKUP_BYTES];
+			const uint32_t to_node = ((k60_qrtr_lookup_count & 1u) != 0u) ?
+			    K60_QRTR_BROADCAST_NODE : 0u;
+			const uint32_t to_port = K60_QRTR_NS_PORT;
+			uint32_t built;
+			uint32_t service = 0;
+			uint32_t instance = 0;
+
+			if ((k60_qrtr_lookup_count & 1u) != 0u) {
+				service = K60_QRTR_DMS_SERVICE;
+				instance = 0;
+			}
+			built = k60_qrtr_build_lookup_at(packet, sizeof(packet),
+			    to_node, to_port, service, instance);
+			if (built != 0) {
+				const int send_rc = k60m_glink_send(&k60_qrtr_link,
+				    k60_qrtr_channel, packet, K60_QRTR_LOOKUP_BYTES);
+
+				if (send_rc == QcomGlinkOk) {
+					k60_qrtr_lookup_sent = 1;
+					++k60_qrtr_lookup_count;
+					k60_qrtr_lookup_next = (unsigned)i + K60_QRTR_LOOKUP_PERIOD;
+					printf("K60MODEM qrtr: sent new_lookup (0x0a) #%u service %u to node %u port %u\n",
+					    k60_qrtr_lookup_count, service, to_node, to_port);
+				} else if (send_rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: lookup send rc=%d\n", send_rc);
+					return send_rc;
+				}
+			}
+		}
+		if (k60_qrtr_lookup_sent && k60_qrtr_state.dms_found &&
+		    !k60_qrtr_dms_requested) {
+			uint8_t query[K60_QMI_HEADER];
+			uint16_t transaction = ++k60_qrtr_dms_transaction;
+
+			if (transaction == 0) {
+				transaction = ++k60_qrtr_dms_transaction;
+			}
+			if (k60_qmi_build_dms_revision(query, sizeof(query), transaction) != 0) {
+				k60_qrtr_state.dms_transaction = transaction;
+				rc = k60_qrtr_send_data_packet(K60_QRTR_DMS_PORT,
+				    k60_qrtr_state.dms_node, k60_qrtr_state.dms_port,
+				    query, sizeof(query));
+				if (rc == QcomGlinkOk) {
+					k60_qrtr_dms_requested = 1;
+					k60_qrtr_state.dms_sent = 1;
+					printf("K60MODEM qrtr: sent dms get_revision to node %u port %u txn %u\n",
+					    k60_qrtr_state.dms_node, k60_qrtr_state.dms_port,
+					    transaction);
+				} else if (rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: dms send rc=%d\n", rc);
+					return rc;
+				}
+			}
+		}
+		/* k37 answered no lookup and announced only two services in sixty
+		 * seconds: the modem's QMI services registered during bring-up, when
+		 * nothing was listening on the AP side. Fall back to the port the
+		 * Android inventory recorded for DMS on this very device (01-ANDROID-
+		 * INVENTORY.md 5.4.1: service 2, node 0, port 96). */
+		if (k60_qrtr_hello_sent && !k60_qrtr_state.dms_found &&
+		    qrtr_mode == 2 && k60_qrtr_static_count < K60_QRTR_STATIC_MAX &&
+		    i >= (int)k60_qrtr_static_next) {
+			uint8_t query[K60_QMI_HEADER];
+			uint16_t transaction = ++k60_qrtr_dms_transaction;
+
+			if (transaction == 0) {
+				transaction = ++k60_qrtr_dms_transaction;
+			}
+			k60_qrtr_state.dms_node = 0;
+			k60_qrtr_state.dms_port = K60_QRTR_DMS_STATIC_PORT;
+			if (k60_qmi_build_dms_revision(query, sizeof(query), transaction) != 0) {
+				k60_qrtr_state.dms_transaction = transaction;
+				rc = k60_qrtr_send_data_packet(K60_QRTR_DMS_PORT, 0,
+				    K60_QRTR_DMS_STATIC_PORT, query, sizeof(query));
+				if (rc == QcomGlinkOk) {
+					k60_qrtr_state.dms_static = 1;
+					k60_qrtr_dms_requested = 1;
+					k60_qrtr_state.dms_sent = 1;
+					++k60_qrtr_static_count;
+					k60_qrtr_static_next = (unsigned)i + K60_QRTR_STATIC_PERIOD;
+					printf("K60MODEM qrtr: sent dms get_revision (static) #%u to node 0 port %u txn %u\n",
+					    k60_qrtr_static_count, K60_QRTR_DMS_STATIC_PORT,
+					    transaction);
+				} else if (rc != QcomGlinkAgain) {
+					printf("K60MODEM qrtr: dms static send rc=%d\n", rc);
+					return rc;
+				}
+			}
+		}
+		rc = k60_qrtr_flush_replies();
+		if (rc != 0) {
+			printf("K60MODEM qrtr: reply send rc=%d at %u\n", rc, i);
+			return rc;
+		}
+		if (k60_qrtr_lookup_sent && k60_qrtr_state.dms_answered &&
+		    k60_qrtr_verdict(&k60_qrtr_state)) {
+			break;
+		}
+		delay(K60_QRTR_POLL_US);
+	}
+	printf("K60MODEM qrtr: verdict %s services=%u node0=%u wanted=%u malformed=%u locator=%u dms=%s polls=%u\n",
+	    k60_qrtr_verdict(&k60_qrtr_state) ? "ok" : "no reply",
+	    k60_qrtr_state.services, k60_qrtr_state.from_node0, k60_qrtr_state.wanted,
+	    k60_qrtr_state.malformed, k60_qrtr_state.locator_requests,
+	    k60_qrtr_state.dms_answered ? k60_qrtr_state.revision : "none", i);
+	if (!k60_qrtr_verdict(&k60_qrtr_state)) {
+		return -2;
+	}
+	if (!k60_qrtr_state.dms_answered) {
+		printf("K60MODEM qrtr: dms revision missing after %u ms (errors=%u)\n",
+		    K60_QRTR_POLLS * K60_QRTR_POLL_US / 1000u,
+		    k60_qrtr_state.dms_errors);
+		return -2;
+	}
+	return 0;
+}
+
+#endif /* K60_HOST_TEST */
diff --git a/bsd/dev/pong_modem_rmtfs.h b/bsd/dev/pong_modem_rmtfs.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_rmtfs.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* RMTFS: the storage service the modem asks for its EFS images before its RF
+ * and QMI stack can start. Pong blocks PAS_INIT_IMAGE until its native RFS
+ * storage is ready for exactly this reason (PongModemRuntime.cpp:271-277) and
+ * serves four images over QMI v1 service 14 (PongModemRmtfs.h:1-13).
+ *
+ * The wire layout follows linux-msm/rmtfs and the reference:
+ *   1 open   -- TLV 1 is the image path, the reply carries the storage id;
+ *   2 close  -- TLV 1 is the id;
+ *   3 rw     -- TLV 2 direction, TLV 3 the scatter list, TLV 4 force;
+ *   4 alloc  -- TLV 1 id, TLV 2 the size of the shared buffer;
+ *   5 sync   -- TLV 1 id, acknowledged with one zero byte.
+ * This file is protocol only: no buffer, no UFS, no SCM, so the kernel and the
+ * host test share one implementation of the parts that can be wrong on paper.
+ */
+#ifndef K60_MODEM_RMTFS_H
+#define K60_MODEM_RMTFS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define K60_RMTFS_MAX_PATH 64u
+#define K60_RMTFS_MAX_VECS 8u
+#define K60_RMTFS_STORAGE_COUNT 4u
+#define K60_RMTFS_BLOCK 512u
+
+/* QMI v1 message numbers on service 14, in the order the reference
+ * dispatches them (PongModemRmtfs.h:84-145). */
+#define K60_RMTFS_OPEN 1u
+#define K60_RMTFS_CLOSE 2u
+#define K60_RMTFS_RW 3u
+#define K60_RMTFS_ALLOC 4u
+#define K60_RMTFS_SYNC 5u
+
+typedef struct {
+	uint32_t block_offset;
+	uint32_t physical;
+	uint32_t block_length;
+} K60RmtfsVec;
+
+typedef struct {
+	uint16_t message;
+	uint16_t transaction;
+	uint32_t storage;
+	uint32_t direction;
+	uint32_t force;
+	uint32_t alloc_bytes;
+	char path[K60_RMTFS_MAX_PATH];
+	size_t path_length;
+	size_t vectors;
+	K60RmtfsVec table[K60_RMTFS_MAX_VECS];
+} K60RmtfsRequest;
+
+/* Parses one request. Returns 0 when every field the message defines is
+ * present and well formed, -1 otherwise; a rejected request still carries the
+ * message number and transaction so the caller can answer with result 2. */
+int k60_rmtfs_parse(const void *bytes, size_t length, K60RmtfsRequest *out);
+
+/* Builds the response: a seven byte header, the four byte result TLV and,
+ * when the reference answers with one, the value TLV (type 0x10). */
+uint32_t k60_rmtfs_build_reply(uint8_t *out, size_t cap, uint16_t message,
+    uint16_t transaction, uint16_t result, const void *value, size_t value_bytes);
+
+/* Validates every scatter entry against one image and the shared window: the
+ * offsets and lengths count 512-byte blocks, and the physical address must lie
+ * inside the window the modem was given. Returns 0 when all entries fit. */
+int k60_rmtfs_check_vectors(const K60RmtfsRequest *request, uint64_t image_bytes,
+    uint64_t window_base, uint64_t window_bytes);
+
+#endif /* K60_MODEM_RMTFS_H */
diff --git a/bsd/dev/pong_modem_rmtfs.c b/bsd/dev/pong_modem_rmtfs.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_rmtfs.c
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "pong_modem_rmtfs.h"
+
+#include <string.h>
+
+#define K60_RMTFS_TYPE_REQUEST 0u
+#define K60_RMTFS_TYPE_RESPONSE 2u
+#define K60_RMTFS_TLV_RESULT 0x02u
+#define K60_RMTFS_TLV_VALUE 0x10u
+
+static uint16_t
+le16(const uint8_t *at)
+{
+	return (uint16_t)(at[0] | (uint16_t)at[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *at)
+{
+	return (uint32_t)le16(at) | (uint32_t)le16(at + 2) << 16;
+}
+
+static void
+put16(uint8_t *at, uint16_t value)
+{
+	at[0] = (uint8_t)value;
+	at[1] = (uint8_t)(value >> 8);
+}
+
+/* One TLV walk over the region that starts after the seven byte header. */
+static const uint8_t *
+tlv(const uint8_t *tlvs, size_t length, uint8_t type, size_t *size)
+{
+	size_t at = 0;
+
+	while (at + 3 <= length) {
+		const uint8_t kind = tlvs[at];
+		const size_t span = le16(tlvs + at + 1);
+
+		if (at + 3 + span > length) {
+			return NULL;
+		}
+		if (kind == type) {
+			if (size != NULL) {
+				*size = span;
+			}
+			return tlvs + at + 3;
+		}
+		at += 3 + span;
+	}
+	return NULL;
+}
+
+static int
+take_word(const uint8_t *tlvs, size_t length, uint8_t type, uint32_t *out)
+{
+	size_t size = 0;
+	const uint8_t *field = tlv(tlvs, length, type, &size);
+
+	if (field == NULL || size != 4) {
+		return -1;
+	}
+	*out = le32(field);
+	return 0;
+}
+
+static int
+take_byte(const uint8_t *tlvs, size_t length, uint8_t type, uint32_t *out)
+{
+	size_t size = 0;
+	const uint8_t *field = tlv(tlvs, length, type, &size);
+
+	if (field == NULL || size != 1) {
+		return -1;
+	}
+	*out = field[0];
+	return 0;
+}
+
+int
+k60_rmtfs_parse(const void *bytes, size_t length, K60RmtfsRequest *out)
+{
+	const uint8_t *p = (const uint8_t *)bytes;
+	const uint8_t *tlvs;
+	size_t region;
+	size_t span = 0;
+	const uint8_t *field;
+	int rc = 0;
+
+	if (bytes == NULL || out == NULL || length < 7) {
+		return -1;
+	}
+	memset(out, 0, sizeof(*out));
+	if (p[0] != K60_RMTFS_TYPE_REQUEST) {
+		return -1;
+	}
+	out->transaction = le16(p + 1);
+	out->message = le16(p + 3);
+	region = le16(p + 5);
+	if (region > length - 7) {
+		return -1;
+	}
+	tlvs = p + 7;
+	switch (out->message) {
+	case K60_RMTFS_OPEN: {
+		field = tlv(tlvs, region, 1, &span);
+		if (field == NULL || span == 0 || span > K60_RMTFS_MAX_PATH) {
+			return -1;
+		}
+		if (field[span - 1] == 0) {
+			span--;
+		}
+		memcpy(out->path, field, span);
+		out->path_length = span;
+		break;
+	}
+	case K60_RMTFS_CLOSE:
+	case K60_RMTFS_SYNC:
+		rc = take_word(tlvs, region, 1, &out->storage);
+		break;
+	case K60_RMTFS_RW: {
+		size_t list_size = 0;
+		const uint8_t *list;
+
+		if (take_byte(tlvs, region, 2, &out->direction) != 0 ||
+		    take_byte(tlvs, region, 4, &out->force) != 0 ||
+		    take_word(tlvs, region, 1, &out->storage) != 0) {
+			rc = -1;
+			break;
+		}
+		list = tlv(tlvs, region, 3, &list_size);
+		if (list == NULL || list_size < 1) {
+			rc = -1;
+			break;
+		}
+		if (list[0] == 0 || list[0] > K60_RMTFS_MAX_VECS ||
+		    1u + (size_t)list[0] * 12u != list_size) {
+			rc = -1;
+			break;
+		}
+		out->vectors = list[0];
+		for (size_t i = 0; i < out->vectors; i++) {
+			const uint8_t *v = list + 1 + 12 * i;
+
+			out->table[i].block_offset = le32(v);
+			out->table[i].physical = le32(v + 4);
+			out->table[i].block_length = le32(v + 8);
+		}
+		break;
+	}
+	case K60_RMTFS_ALLOC:
+		if (take_word(tlvs, region, 1, &out->storage) != 0 ||
+		    take_word(tlvs, region, 2, &out->alloc_bytes) != 0) {
+			rc = -1;
+		}
+		break;
+	default:
+		rc = -1;
+		break;
+	}
+	return rc;
+}
+
+uint32_t
+k60_rmtfs_build_reply(uint8_t *out, size_t cap, uint16_t message,
+    uint16_t transaction, uint16_t result, const void *value, size_t value_bytes)
+{
+	size_t used = 7;
+	const uint8_t *payload = (const uint8_t *)value;
+
+	if (out == NULL || cap < 14) {
+		return 0;
+	}
+	if (value_bytes != 0 && (payload == NULL || cap < 14 + 3 + value_bytes)) {
+		return 0;
+	}
+	out[0] = K60_RMTFS_TYPE_RESPONSE;
+	put16(out + 1, transaction);
+	put16(out + 3, message);
+	/* Result TLV: error flag then the code, exactly as the reference sends. */
+	out[used++] = K60_RMTFS_TLV_RESULT;
+	put16(out + used, 4);
+	used += 2;
+	put16(out + used, result != 0 ? 1 : 0);
+	put16(out + used + 2, result);
+	used += 4;
+	if (result == 0 && value_bytes != 0) {
+		out[used++] = K60_RMTFS_TLV_VALUE;
+		put16(out + used, (uint16_t)value_bytes);
+		used += 2;
+		memcpy(out + used, payload, value_bytes);
+		used += value_bytes;
+	}
+	put16(out + 5, (uint16_t)(used - 7));
+	return (uint32_t)used;
+}
+
+int
+k60_rmtfs_check_vectors(const K60RmtfsRequest *request, uint64_t image_bytes,
+    uint64_t window_base, uint64_t window_bytes)
+{
+	if (request == NULL || image_bytes == 0 || window_bytes == 0) {
+		return -1;
+	}
+	if (request->vectors == 0 || request->vectors > K60_RMTFS_MAX_VECS) {
+		return -1;
+	}
+	for (size_t i = 0; i < request->vectors; i++) {
+		const uint64_t offset = (uint64_t)request->table[i].block_offset *
+		    K60_RMTFS_BLOCK;
+		const uint64_t span = (uint64_t)request->table[i].block_length *
+		    K60_RMTFS_BLOCK;
+		const uint64_t physical = request->table[i].physical;
+
+		if (span == 0 || offset > image_bytes || span > image_bytes - offset) {
+			return -1;
+		}
+		if (physical < window_base ||
+		    physical - window_base > window_bytes ||
+		    span > window_bytes - (physical - window_base)) {
+			return -1;
+		}
+	}
+	return 0;
+}
diff --git a/bsd/dev/pong_modem_efs.h b/bsd/dev/pong_modem_efs.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_efs.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The four EFS images the modem opens by name, and the copy plan its scatter
+ * list turns into. This is the piece between the RMTFS protocol and the UFS:
+ * it knows which GPT partition backs /boot/modem_fs1 and friends, how a
+ * 512-byte-block scatter entry maps onto that image and into the shared
+ * window, and nothing about how the bytes are actually read.
+ *
+ * Reference: PongModemRmtfs.h maps /boot/modem_fs1|fs2|fsg|fsc onto the Android
+ * partitions modemst1, modemst2, fsg and fsc; rmtfsAnswer() copies between the
+ * image and the region the scatter entry names.
+ */
+#ifndef K60_MODEM_EFS_H
+#define K60_MODEM_EFS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "pong_modem_rmtfs.h"
+
+#define K60_EFS_IMAGE_COUNT 4u
+/* A GPT partition entry name is 36 UTF-16LE code units (72 bytes). */
+#define K60_EFS_GPT_NAME_BYTES 72u
+
+/* Storage ids start at one, exactly as the open reply numbers them. */
+const char *k60_efs_partition(uint32_t storage);
+const char *k60_efs_boot_path(uint32_t storage);
+
+/* Compares a GPT partition entry name, which is UTF-16LE with the remainder
+ * zero filled, against an ASCII name. Returns 0 when they are the same. */
+int k60_efs_name_matches(const void *entry, size_t entry_bytes, const char *name);
+
+/* One copy the scatter list asks for: 'bytes' move from image_offset in the
+ * image to buffer_offset in the shared window. */
+typedef struct {
+	uint64_t image_offset;
+	uint64_t buffer_offset;
+	uint32_t bytes;
+} K60EfsSpan;
+
+/* Turns a validated rw request into the copies that serve it. The request must
+ * already have passed k60_rmtfs_check_vectors(); this function additionally
+ * requires every byte to fall inside the image. Returns the number of spans
+ * written to 'out', or -1 when the request does not fit (wrong message, no
+ * vectors, more vectors than 'cap', or an offset past the end of the image). */
+int k60_efs_plan(const K60RmtfsRequest *request, uint64_t image_bytes,
+    uint64_t window_base, uint64_t window_bytes, K60EfsSpan *out, size_t cap);
+
+/* Performs the copies a plan describes. direction 0 moves bytes from the image
+ * into the shared window (the modem reads the image), direction 1 moves them
+ * back (the modem writes it). 'image' and 'window' carry the whole image and
+ * the whole window, so a span indexes them directly; every span must stay
+ * inside both. Returns 0, or -1 when a span leaves a buffer or nothing is
+ * planned. */
+#define K60_EFS_TO_WINDOW 0
+#define K60_EFS_TO_IMAGE  1
+int k60_efs_copy(const K60EfsSpan *spans, size_t count, int direction,
+    uint8_t *image, size_t image_bytes, uint8_t *window, size_t window_bytes);
+
+/* Maps an open request path onto the storage id the reply must carry: 1..4 for
+ * the four EFS images, 0 for anything else. The comparison is byte for byte
+ * against k60_efs_boot_path(), because the wire path has no terminator. */
+uint32_t k60_efs_storage_for_path(const char *path, size_t length);
+
+/* Reads image bytes on the modem's behalf. 'read' must fill dst with 'bytes'
+ * from the image at 'offset' and return 0; anything else counts as a failure.
+ * The callback is what the kernel supplies once the UFS path exists. */
+typedef int (*K60EfsRead)(void *context, uint32_t storage, uint64_t offset,
+    uint8_t *dst, size_t bytes);
+
+/* Serves one read request end to end: it must be an rw request in the read
+ * direction, its vectors must fit the image and the window, and the reader must
+ * deliver every span. On success the window holds what the modem asked for and
+ * the caller answers result 0. Returns 0 on success, -1 otherwise. */
+int k60_efs_serve_read(const K60RmtfsRequest *request, K60EfsRead read,
+    void *context, uint8_t *image, size_t image_bytes, uint8_t *window,
+    size_t window_bytes, uint64_t window_base);
+
+/* Serves the write direction into a boot-session shadow: the bytes land in
+ * 'image' and nothing reaches the flash. Pong does the same (a write only ever
+ * reaches the shadow), so a modem write is acknowledged without a UFS writer.
+ * Returns 0 when the image now holds the bytes, -1 otherwise. */
+int k60_efs_serve_write(const K60RmtfsRequest *request, uint8_t *image,
+    size_t image_bytes, const uint8_t *window, size_t window_bytes,
+    uint64_t window_base);
+
+#endif /* K60_MODEM_RMTFS_EFS */
diff --git a/bsd/dev/pong_modem_efs.c b/bsd/dev/pong_modem_efs.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_efs.c
@@ -0,0 +1,238 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The EFS image table and the scatter-to-copy mapping. Protocol only: no UFS,
+ * no SCM, no allocation, so the host test and the kernel share it. */
+
+#include "pong_modem_efs.h"
+
+typedef struct {
+	const char *boot;
+	const char *partition;
+} K60EfsImage;
+
+static const K60EfsImage k60_efs_images[K60_EFS_IMAGE_COUNT] = {
+	{ "/boot/modem_fs1", "modemst1" },
+	{ "/boot/modem_fs2", "modemst2" },
+	{ "/boot/modem_fsg", "fsg" },
+	{ "/boot/modem_fsc", "fsc" },
+};
+
+const char *
+k60_efs_partition(uint32_t storage)
+{
+	if (storage == 0 || storage > K60_EFS_IMAGE_COUNT) {
+		return NULL;
+	}
+	return k60_efs_images[storage - 1].partition;
+}
+
+const char *
+k60_efs_boot_path(uint32_t storage)
+{
+	if (storage == 0 || storage > K60_EFS_IMAGE_COUNT) {
+		return NULL;
+	}
+	return k60_efs_images[storage - 1].boot;
+}
+
+int
+k60_efs_name_matches(const void *entry, size_t entry_bytes, const char *name)
+{
+	const uint8_t *at = (const uint8_t *)entry;
+	size_t units;
+	size_t i;
+
+	if (entry == NULL || name == NULL || entry_bytes < 2) {
+		return -1;
+	}
+	units = entry_bytes / 2;
+	if (units > K60_EFS_GPT_NAME_BYTES / 2) {
+		units = K60_EFS_GPT_NAME_BYTES / 2;
+	}
+	for (i = 0; i < units; i++) {
+		const uint16_t unit = (uint16_t)(at[2 * i] | (uint16_t)(at[2 * i + 1] << 8));
+
+		if (name[i] == '\0') {
+			/* The entry may not run past the end of the name. */
+			return unit == 0 ? 0 : -1;
+		}
+		if (unit != (uint16_t)(uint8_t)name[i]) {
+			return -1;
+		}
+	}
+	/* The name is longer than the entry: only a zero terminated entry can
+	 * match, and a 36-unit entry is never terminated. */
+	return -1;
+}
+
+int
+k60_efs_plan(const K60RmtfsRequest *request, uint64_t image_bytes,
+    uint64_t window_base, uint64_t window_bytes, K60EfsSpan *out, size_t cap)
+{
+	size_t written = 0;
+	size_t i;
+
+	if (request == NULL || out == NULL || request->message != K60_RMTFS_RW) {
+		return -1;
+	}
+	if (request->vectors == 0 || request->vectors > cap ||
+	    request->vectors > K60_RMTFS_MAX_VECS) {
+		return -1;
+	}
+	for (i = 0; i < request->vectors; i++) {
+		const K60RmtfsVec *vec = &request->table[i];
+		const uint64_t image_offset = (uint64_t)vec->block_offset * K60_RMTFS_BLOCK;
+		const uint64_t bytes = (uint64_t)vec->block_length * K60_RMTFS_BLOCK;
+
+		if (vec->block_length == 0) {
+			/* A zero-length scatter entry is malformed on the wire; the
+			 * protocol check refuses it, so the plan must not quietly drop
+			 * it and report success for the rest. */
+			return -1;
+		}
+		if (image_offset > image_bytes || bytes > image_bytes - image_offset) {
+			return -1;
+		}
+		if (vec->physical < window_base ||
+		    (uint64_t)vec->physical - window_base > window_bytes ||
+		    bytes > window_bytes - ((uint64_t)vec->physical - window_base)) {
+			return -1;
+		}
+		out[written].image_offset = image_offset;
+		out[written].buffer_offset = (uint64_t)vec->physical - window_base;
+		out[written].bytes = (uint32_t)bytes;
+		written++;
+	}
+	if (written == 0) {
+		return -1;
+	}
+	return (int)written;
+}
+
+int
+k60_efs_copy(const K60EfsSpan *spans, size_t count, int direction,
+    uint8_t *image, size_t image_bytes, uint8_t *window, size_t window_bytes)
+{
+	if (spans == NULL || image == NULL || window == NULL || count == 0) {
+		return -1;
+	}
+	if (direction != K60_EFS_TO_WINDOW && direction != K60_EFS_TO_IMAGE) {
+		return -1;
+	}
+	for (size_t i = 0; i < count; i++) {
+		const K60EfsSpan *span = &spans[i];
+
+		if ((uint64_t)span->bytes > image_bytes ||
+		    span->image_offset > image_bytes - span->bytes) {
+			return -1;
+		}
+		if ((uint64_t)span->bytes > window_bytes ||
+		    span->buffer_offset > window_bytes - span->bytes) {
+			return -1;
+		}
+		for (uint32_t b = 0; b < span->bytes; b++) {
+			uint64_t from = direction == K60_EFS_TO_WINDOW ?
+			    span->image_offset + b : span->buffer_offset + b;
+			uint64_t to = direction == K60_EFS_TO_WINDOW ?
+			    span->buffer_offset + b : span->image_offset + b;
+
+			if (direction == K60_EFS_TO_WINDOW) {
+				window[to] = image[from];
+			} else {
+				image[to] = window[from];
+			}
+		}
+	}
+	return 0;
+}
+
+int
+k60_efs_serve_read(const K60RmtfsRequest *request, K60EfsRead read,
+    void *context, uint8_t *image, size_t image_bytes, uint8_t *window,
+    size_t window_bytes, uint64_t window_base)
+{
+	K60EfsSpan spans[K60_RMTFS_MAX_VECS];
+	int count;
+
+	if (request == NULL || read == NULL || image == NULL || window == NULL) {
+		return -1;
+	}
+	if (request->message != K60_RMTFS_RW || request->direction != 0) {
+		return -1;      /* only the modem's read direction is served */
+	}
+	if (request->storage == 0 || request->storage > K60_EFS_IMAGE_COUNT) {
+		return -1;
+	}
+	if (k60_rmtfs_check_vectors(request, image_bytes, window_base,
+	    window_bytes) != 0) {
+		return -1;
+	}
+	count = k60_efs_plan(request, image_bytes, window_base, window_bytes,
+	    spans, K60_RMTFS_MAX_VECS);
+	if (count <= 0) {
+		return -1;
+	}
+	for (int i = 0; i < count; i++) {
+		if (read(context, request->storage, spans[i].image_offset,
+		    image + spans[i].image_offset, spans[i].bytes) != 0) {
+			return -1;
+		}
+	}
+	if (k60_efs_copy(spans, (size_t)count, K60_EFS_TO_WINDOW, image,
+	    image_bytes, window, window_bytes) != 0) {
+		return -1;
+	}
+	return 0;
+}
+
+int
+k60_efs_serve_write(const K60RmtfsRequest *request, uint8_t *image,
+    size_t image_bytes, const uint8_t *window, size_t window_bytes,
+    uint64_t window_base)
+{
+	K60EfsSpan spans[K60_RMTFS_MAX_VECS];
+	int count;
+
+	if (request == NULL || image == NULL || window == NULL) {
+		return -1;
+	}
+	if (request->message != K60_RMTFS_RW || request->direction != 1) {
+		return -1;      /* only the modem's write direction lands here */
+	}
+	if (request->storage == 0 || request->storage > K60_EFS_IMAGE_COUNT) {
+		return -1;
+	}
+	if (k60_rmtfs_check_vectors(request, image_bytes, window_base,
+	    window_bytes) != 0) {
+		return -1;
+	}
+	count = k60_efs_plan(request, image_bytes, window_base, window_bytes,
+	    spans, K60_RMTFS_MAX_VECS);
+	if (count <= 0) {
+		return -1;
+	}
+	if (k60_efs_copy(spans, (size_t)count, K60_EFS_TO_IMAGE, image,
+	    image_bytes, (uint8_t *)window, window_bytes) != 0) {
+		return -1;
+	}
+	return 0;
+}
+
+uint32_t
+k60_efs_storage_for_path(const char *path, size_t length)
+{
+	for (uint32_t storage = 1; storage <= K60_EFS_IMAGE_COUNT; storage++) {
+		const char *name = k60_efs_boot_path(storage);
+		size_t at = 0;
+
+		if (name == NULL || path == NULL) {
+			return 0;
+		}
+		while (at < length && name[at] != '\0' && name[at] == path[at]) {
+			at++;
+		}
+		if (at == length && name[at] == '\0') {
+			return storage;
+		}
+	}
+	return 0;
+}
diff --git a/bsd/dev/pong_modem_memshare.h b/bsd/dev/pong_modem_memshare.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_memshare.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Memshare, service 0x34 instance 1 on port 0x101.
+
+ * Pong registers three services to the modem before pas4: the servloc
+ * locator (0x40/0x101), heap memory share (0x34/0x101) and storage (14/1).
+ * The memory share is how the modem asks the AP for a contiguous region and
+ * how it hands it back; the transfer itself is the SCM 0x0c/0x16 ownership
+ * call this branch already carries in K60ModemPas.h.
+
+ * The wire shapes follow references/pong-baseband/PongModemMemshare.h: a QMI
+ * v1 request (type 0), seven byte header, little endian TLVs.  A query (0x24)
+ * reports the client limit, an allocate (0x22) asks for bytes and answers with
+ * a sequence number plus a 13 byte extent, and a free (0x23) hands back an
+ * extent that must match the one still held.  Rejections use QMI error 48
+ * (invalid argument), 2 (no memory), 3 (ownership transfer failed) or 71
+ * (message not supported), exactly as the reference does.
+ */
+#ifndef K60_MODEM_MEMSHARE_H
+#define K60_MODEM_MEMSHARE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define K60_MEMSHARE_SERVICE            0x34u
+#define K60_MEMSHARE_INSTANCE           1u
+#define K60_MEMSHARE_PORT               0x101u
+
+#define K60_MEMSHARE_QUERY              0x24u
+#define K60_MEMSHARE_ALLOCATE           0x22u
+#define K60_MEMSHARE_FREE               0x23u
+
+#define K60_MEMSHARE_MAXIMUM            0x500000u   /* five megabytes */
+#define K60_MEMSHARE_ALIGNMENT_LIMIT    11u
+#define K60_MEMSHARE_CLIENT             1u
+#define K60_MEMSHARE_CLIENT_LIMIT       2u
+#define K60_MEMSHARE_EXTENT_BYTES       13u
+#define K60_MEMSHARE_EXTENT_VERSION     1u
+
+#define K60_MEMSHARE_ERROR_NONE         0u
+#define K60_MEMSHARE_ERROR_NO_MEMORY    2u
+#define K60_MEMSHARE_ERROR_TRANSFER     3u
+#define K60_MEMSHARE_ERROR_ARGUMENT     48u
+#define K60_MEMSHARE_ERROR_UNSUPPORTED  71u
+
+enum {
+	K60MemshareOk = 0,
+	K60MemshareBadArgument = -1,
+	K60MemshareMalformed = -2,
+};
+
+typedef struct {
+	uint16_t message;
+	uint16_t transaction;
+	uint32_t client;
+	uint32_t processor;
+	uint32_t sequence;
+	uint32_t bytes;             /* allocate: the size asked for */
+	uint32_t alignment;
+	uint64_t physical;          /* free: the extent handed back */
+	uint32_t extent_bytes;
+	uint32_t error;             /* non zero: answer with this code, not memory */
+} K60MemshareRequest;
+
+/* Parses one request.  The protocol rejections the reference decides while
+ * parsing (wrong client, a processor id, a bad alignment, an extent that does
+ * not match the shape) are reported in out->error with a zero return, so the
+ * caller answers with that code instead of allocating.  A malformed header or
+ * a missing required TLV is K60MemshareMalformed. */
+int k60_memshare_parse(const void *bytes, size_t length, K60MemshareRequest *out);
+
+/* Builds the response.  error is one of the codes above; a successful query
+ * carries the client limit, a successful allocate carries the sequence and the
+ * extent, and nothing else carries a value TLV.  Returns the message length or
+ * zero when the buffer is too small. */
+size_t k60_memshare_build_reply(uint8_t *out, size_t capacity,
+    uint16_t transaction, uint16_t message, uint32_t error, uint32_t maximum,
+    const uint32_t *sequence, uint64_t physical, uint32_t bytes);
+
+/* Rounding and bounds the reference applies to a region before it is handed
+ * over: 4096 byte pages, no zero length, and every page below the ceiling.
+ * Returns 0 when the region is acceptable. */
+int k60_memshare_region_ok(uint64_t physical, uint32_t bytes, uint64_t ceiling);
+
+#endif
diff --git a/bsd/dev/pong_modem_memshare.c b/bsd/dev/pong_modem_memshare.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_memshare.c
@@ -0,0 +1,260 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Memshare request parsing and response building.  Self contained: the seven
+ * byte QMI header and the TLVs are little endian, and the shapes are the ones
+ * references/pong-baseband/PongModemMemshare.h uses. */
+
+#include "pong_modem_memshare.h"
+
+static uint16_t
+k60_memshare_le16(const uint8_t *at)
+{
+	return (uint16_t)((uint16_t)at[0] | ((uint16_t)at[1] << 8));
+}
+
+static uint32_t
+k60_memshare_le32(const uint8_t *at)
+{
+	return (uint32_t)k60_memshare_le16(at) |
+	    ((uint32_t)k60_memshare_le16(at + 2) << 16);
+}
+
+static uint64_t
+k60_memshare_le64(const uint8_t *at)
+{
+	return (uint64_t)k60_memshare_le32(at) |
+	    ((uint64_t)k60_memshare_le32(at + 4) << 32);
+}
+
+static void
+k60_memshare_put16(uint8_t *at, uint16_t value)
+{
+	at[0] = (uint8_t)(value & 0xffu);
+	at[1] = (uint8_t)(value >> 8);
+}
+
+static void
+k60_memshare_put32(uint8_t *at, uint32_t value)
+{
+	k60_memshare_put16(at, (uint16_t)(value & 0xffffu));
+	k60_memshare_put16(at + 2, (uint16_t)(value >> 16));
+}
+
+static void
+k60_memshare_put64(uint8_t *at, uint64_t value)
+{
+	k60_memshare_put32(at, (uint32_t)(value & 0xffffffffu));
+	k60_memshare_put32(at + 4, (uint32_t)(value >> 32));
+}
+
+/* A required TLV: present with exactly four bytes.  An optional one may be
+ * absent (returns 0 with *found cleared) but must still be four bytes when
+ * the modem sent it. */
+static int
+k60_memshare_u32(const uint8_t *tlvs, size_t bytes, uint8_t tag, uint32_t *value,
+    int *found)
+{
+	size_t at = 0;
+
+	if (found != NULL) {
+		*found = 0;
+	}
+	while (at + 3u <= bytes) {
+		const uint8_t type = tlvs[at];
+		const uint16_t length = k60_memshare_le16(tlvs + at + 1);
+
+		if (at + 3u + length > bytes) {
+			return K60MemshareMalformed;
+		}
+		if (type == tag) {
+			if (length != 4u) {
+				return K60MemshareMalformed;
+			}
+			*value = k60_memshare_le32(tlvs + at + 3);
+			if (found != NULL) {
+				*found = 1;
+			}
+			return K60MemshareOk;
+		}
+		at += 3u + length;
+	}
+	return K60MemshareOk;
+}
+
+int
+k60_memshare_parse(const void *bytes, size_t length, K60MemshareRequest *out)
+{
+	const uint8_t *data = (const uint8_t *)bytes;
+	const uint8_t *tlvs;
+	size_t payload;
+	int found;
+
+	if (bytes == NULL || out == NULL || length < 7u) {
+		return K60MemshareBadArgument;
+	}
+	if (data[0] != 0u) {
+		return K60MemshareMalformed;               /* not a request */
+	}
+	payload = (size_t)k60_memshare_le16(data + 5);
+	if (7u + payload > length) {
+		return K60MemshareMalformed;
+	}
+	tlvs = data + 7;
+	out->transaction = k60_memshare_le16(data + 1);
+	out->message = k60_memshare_le16(data + 3);
+	out->client = 0;
+	out->processor = 0;
+	out->sequence = 0;
+	out->bytes = 0;
+	out->alignment = 0;
+	out->physical = 0;
+	out->extent_bytes = 0;
+	out->error = K60_MEMSHARE_ERROR_NONE;
+
+	if (out->message == K60_MEMSHARE_QUERY) {
+		if (k60_memshare_u32(tlvs, payload, 1, &out->client, NULL) != 0) {
+			return K60MemshareMalformed;
+		}
+		if (k60_memshare_u32(tlvs, payload, 0x10, &out->processor,
+		    &found) != 0) {
+			return K60MemshareMalformed;
+		}
+		if (out->client > K60_MEMSHARE_CLIENT_LIMIT || out->processor != 0u) {
+			out->error = K60_MEMSHARE_ERROR_ARGUMENT;
+		}
+		return K60MemshareOk;
+	}
+
+	if (out->message == K60_MEMSHARE_ALLOCATE) {
+		if (k60_memshare_u32(tlvs, payload, 1, &out->bytes, NULL) != 0 ||
+		    k60_memshare_u32(tlvs, payload, 2, &out->client, NULL) != 0 ||
+		    k60_memshare_u32(tlvs, payload, 3, &out->processor, NULL) != 0 ||
+		    k60_memshare_u32(tlvs, payload, 4, &out->sequence, NULL) != 0 ||
+		    k60_memshare_u32(tlvs, payload, 0x11, &out->alignment,
+		    &found) != 0) {
+			return K60MemshareMalformed;
+		}
+		if (out->client != K60_MEMSHARE_CLIENT || out->processor != 0u ||
+		    out->alignment > K60_MEMSHARE_ALIGNMENT_LIMIT) {
+			out->error = K60_MEMSHARE_ERROR_ARGUMENT;
+		} else if (out->bytes == 0u || out->bytes > K60_MEMSHARE_MAXIMUM) {
+			out->error = K60_MEMSHARE_ERROR_NO_MEMORY;
+		}
+		return K60MemshareOk;
+	}
+
+	if (out->message == K60_MEMSHARE_FREE) {
+		size_t at = 0;
+		int have_extent = 0;
+
+		/* no client TLV means any client may hand the extent back */
+		out->client = 0xffffffffu;
+		if (k60_memshare_u32(tlvs, payload, 0x10, &out->client, &found) != 0 ||
+		    k60_memshare_u32(tlvs, payload, 0x11, &out->processor,
+		    &found) != 0) {
+			return K60MemshareMalformed;
+		}
+		while (at + 3u <= payload) {
+			const uint8_t type = tlvs[at];
+			const uint16_t extent = k60_memshare_le16(tlvs + at + 1);
+
+			if (at + 3u + extent > payload) {
+				return K60MemshareMalformed;
+			}
+			if (type == 1u) {
+				if (extent != K60_MEMSHARE_EXTENT_BYTES ||
+				    tlvs[at + 3] != K60_MEMSHARE_EXTENT_VERSION) {
+					return K60MemshareMalformed;
+				}
+				out->physical = k60_memshare_le64(tlvs + at + 4);
+				out->extent_bytes = k60_memshare_le32(tlvs + at + 12);
+				have_extent = 1;
+			}
+			at += 3u + extent;
+		}
+		if (!have_extent) {
+			return K60MemshareMalformed;
+		}
+		if (out->processor != 0u ||
+		    (out->client != 0xffffffffu && out->client != K60_MEMSHARE_CLIENT)) {
+			out->error = K60_MEMSHARE_ERROR_ARGUMENT;
+		}
+		return K60MemshareOk;
+	}
+
+	out->error = K60_MEMSHARE_ERROR_UNSUPPORTED;
+	return K60MemshareOk;
+}
+
+size_t
+k60_memshare_build_reply(uint8_t *out, size_t capacity, uint16_t transaction,
+    uint16_t message, uint32_t error, uint32_t maximum, const uint32_t *sequence,
+    uint64_t physical, uint32_t bytes)
+{
+	size_t used;
+
+	if (out == NULL || capacity < 14u) {
+		return 0;
+	}
+	out[0] = 2u;                                   /* response */
+	k60_memshare_put16(out + 1, transaction);
+	k60_memshare_put16(out + 3, message);
+	out[7] = 0x02u;                                /* result TLV */
+	k60_memshare_put16(out + 8, 4);
+	k60_memshare_put16(out + 10, error != 0u ? 1u : 0u);
+	k60_memshare_put16(out + 12, (uint16_t)error);
+	used = 14u;
+
+	if (error != 0u) {
+		goto done;
+	}
+	if (message == K60_MEMSHARE_QUERY) {
+		if (capacity < used + 7u) {
+			return 0;
+		}
+		out[used++] = 0x10u;
+		k60_memshare_put16(out + used, 4);
+		used += 2;
+		k60_memshare_put32(out + used, maximum);
+		used += 4;
+	} else if (message == K60_MEMSHARE_ALLOCATE) {
+		if (capacity < used + 7u + 16u) {
+			return 0;
+		}
+		out[used++] = 0x10u;
+		k60_memshare_put16(out + used, 4);
+		used += 2;
+		k60_memshare_put32(out + used,
+		    sequence != NULL ? *sequence : 0u);
+		used += 4;
+		out[used++] = 0x11u;
+		k60_memshare_put16(out + used, K60_MEMSHARE_EXTENT_BYTES);
+		used += 2;
+		out[used++] = K60_MEMSHARE_EXTENT_VERSION;
+		k60_memshare_put64(out + used, physical);
+		used += 8;
+		k60_memshare_put32(out + used, bytes);
+		used += 4;
+	}
+
+done:
+	k60_memshare_put16(out + 5, (uint16_t)(used - 7u));
+	return used;
+}
+
+int
+k60_memshare_region_ok(uint64_t physical, uint32_t bytes, uint64_t ceiling)
+{
+	uint64_t rounded;
+
+	if (physical == 0u || bytes == 0u || (physical & 0xfffu) != 0u) {
+		return -1;
+	}
+	rounded = ((uint64_t)bytes + 4095u) & ~(uint64_t)4095u;
+	if (rounded == 0u || physical + rounded < physical) {
+		return -1;
+	}
+	if (physical + rounded > ceiling) {
+		return -1;
+	}
+	return 0;
+}
diff --git a/bsd/dev/pong_modem_smp2p.h b/bsd/dev/pong_modem_smp2p.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_smp2p.h
@@ -0,0 +1,137 @@
+/*
+ * Shared memory point-to-point: the 340-byte item both sides publish.
+ *
+ * Both the AP-owned item (item 428) and the modem-owned item (item 435) use
+ * one layout: five header words, then sixteen 20-byte entries, each four
+ * little-endian name words and one value word.  The value word is a bitfield
+ * whose meaning belongs to the service that owns the entry: "slave-kernel"
+ * reports ready/fatal, "ipa" is a question the modem asks and the AP answers.
+ *
+ * These helpers only touch memory the caller already mapped; every write is
+ * ordered by the caller's own barrier, because the host test compiles on a
+ * different architecture than the kernel.
+ */
+
+#ifndef _K60_MODEM_SMP2P_H_
+#define _K60_MODEM_SMP2P_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define K60_SMP2P_MAGIC          0x504d5324u
+#define K60_SMP2P_VERSION        1u
+#define K60_SMP2P_HEADER_WORDS   5u
+#define K60_SMP2P_ENTRY_WORDS    5u
+#define K60_SMP2P_ENTRIES        16u
+#define K60_SMP2P_ITEM_BYTES     (K60_SMP2P_HEADER_WORDS * 4u + K60_SMP2P_ENTRIES * K60_SMP2P_ENTRY_WORDS * 4u)
+#define K60_SMP2P_NAME_BYTES     16u
+
+/* Value word of one entry; out of range reads as zero so a caller can never
+ * reach outside the item it mapped. */
+static inline uint32_t
+k60_smp2p_entry_word(volatile uint32_t *item, int index)
+{
+	if (item == NULL || index < 0 || (uint32_t)index >= K60_SMP2P_ENTRIES) {
+		return 0;
+	}
+	return item[K60_SMP2P_HEADER_WORDS +
+	    (uint32_t)index * K60_SMP2P_ENTRY_WORDS + 4u];
+}
+
+/* Replace the masked bits of one entry's value word.  Returns 1 when it wrote,
+ * 0 when the index is outside the item. */
+static inline int
+k60_smp2p_update(volatile uint32_t *item, int index, uint32_t mask, uint32_t value)
+{
+	volatile uint32_t *word;
+
+	if (item == NULL || index < 0 || (uint32_t)index >= K60_SMP2P_ENTRIES) {
+		return 0;
+	}
+	word = &item[K60_SMP2P_HEADER_WORDS +
+	    (uint32_t)index * K60_SMP2P_ENTRY_WORDS + 4u];
+	*word = (*word & ~mask) | (value & mask);
+	return 1;
+}
+
+/* Header check: magic, version and a valid count that fits the item.  The
+ * processor ids in word two are the caller's business, because the AP item
+ * and the modem item legitimately name different local processors. */
+static inline int
+k60_smp2p_header(volatile uint32_t *item, size_t bytes, uint32_t *valid)
+{
+	uint32_t total;
+
+	if (item == NULL || bytes < K60_SMP2P_HEADER_WORDS * 4u) {
+		return 0;
+	}
+	if (item[0] != K60_SMP2P_MAGIC || (item[1] & 0xffu) != K60_SMP2P_VERSION) {
+		return 0;
+	}
+	total = item[3] & 0xffffu;
+	if (total > K60_SMP2P_ENTRIES || (item[3] >> 16) > total) {
+		return 0;
+	}
+	if (valid != NULL) {
+		*valid = item[3] >> 16;
+	}
+	return 1;
+}
+
+/* A name occupies all four name words: a shorter name is zero padded, and a
+ * longer one cannot match because the sixteenth byte is already fixed. */
+static inline int
+k60_smp2p_name_matches(const volatile uint32_t *entry, const char *name)
+{
+	unsigned i;
+
+	if (entry == NULL || name == NULL) {
+		return 0;
+	}
+	/* Read the name only as far as its terminator: a caller passes a string
+	 * literal, and the bytes past it are not ours to read. */
+	for (i = 0; i < K60_SMP2P_NAME_BYTES; i++) {
+		if (name[i] == '\0') {
+			break;
+		}
+		if ((uint8_t)(entry[i / 4u] >> (8u * (i % 4u))) !=
+		    (uint32_t)(uint8_t)name[i]) {
+			return 0;
+		}
+	}
+	/* The rest of the field is zero padded, so a stored byte there means the
+	 * entry names something longer than the name just compared. */
+	for (; i < K60_SMP2P_NAME_BYTES; i++) {
+		if ((uint8_t)(entry[i / 4u] >> (8u * (i % 4u))) != 0u) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* Find one entry by name and hand back its value word.  Returns 1 when the
+ * entry is present, 0 when it is not or the item header is not usable. */
+static inline int
+k60_smp2p_find(volatile uint32_t *item, size_t bytes, const char *name,
+    uint32_t *value)
+{
+	uint32_t valid = 0, i;
+
+	if (!k60_smp2p_header(item, bytes, &valid)) {
+		return 0;
+	}
+	for (i = 0; i < valid; i++) {
+		volatile uint32_t *entry = item + K60_SMP2P_HEADER_WORDS +
+		    i * K60_SMP2P_ENTRY_WORDS;
+
+		if (k60_smp2p_name_matches(entry, name)) {
+			if (value != NULL) {
+				*value = entry[4];
+			}
+			return 1;
+		}
+	}
+	return 0;
+}
+
+#endif /* _K60_MODEM_SMP2P_H_ */
