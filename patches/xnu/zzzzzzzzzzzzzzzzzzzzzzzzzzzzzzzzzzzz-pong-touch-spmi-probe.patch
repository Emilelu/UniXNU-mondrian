 /* Declared ahead of its definition: goodix_apply_config resets the chip
  * through it so the SPI mode is re-confirmed on that path too. */
+/* SPMI read path, parameters per K60KeypadDeviceLib.c boot40 ground truth. */
+#define SPMI_CORE_PHYS     0xc400000UL
+#define SPMI_OBSERVER_PHYS 0xc440000UL
+
+static vm_offset_t spmi_core, spmi_obs;
+
+static uint32_t spmi_rd(uint32_t off)
+{
+    return *(volatile uint32_t *)(spmi_core + off);
+}
+
+static uint32_t spmi_read(uint32_t ppid, uint32_t reg)
+{
+    vm_offset_t ch = spmi_obs + 0x20u * ppid;
+    uint32_t st = 0;
+
+    wr(ch + 0x00, (15u << 27) | ((reg & 0xffu) << 4) | 0u);
+    for (uint32_t k = 0; k < 2000; k++) {
+        st = *(volatile uint32_t *)(ch + 0x08);
+        if (st & 0x1u) {
+            break;
+        }
+    }
+    if (st != 0x1u) {
+        return 0xee00u | st;
+    }
+    return *(volatile uint32_t *)(ch + 0x18) & 0xffu;
+}
+
+static void spmi_probe(void)
+{
+    uint32_t ppids[6];
+    uint32_t np = 0;
+
+    if (!spmi_core) {
+        spmi_core = ml_io_map(SPMI_CORE_PHYS, 0x3000);
+        spmi_obs = ml_io_map(SPMI_OBSERVER_PHYS, 0x80000);
+    }
+    if (!spmi_core || !spmi_obs) {
+        printf("K60SPMI map failed\n");
+        return;
+    }
+    for (uint32_t n = 0; n < 758 && np < 6; n++) {
+        uint32_t ppid = (spmi_rd(0x2000 + 4 * n) >> 8) & 0xfff;
+
+        if ((ppid >> 8) == 2) {
+            ppids[np++] = ppid;
+        }
+    }
+    printf("K60CFG rev=6 n=%u\n", np);
+    for (uint32_t i = 0; i < np; i++) {
+        uint32_t p = ppids[i];
+
+        if (spmi_read(p, 0x04) != 0x0bu) {
+            continue;
+        }
+        printf("K60R p=%#x 40:%#x %#x %#x %#x %#x %#x %#x %#x\n", p,
+            spmi_read(p, 0x40), spmi_read(p, 0x41), spmi_read(p, 0x42),
+            spmi_read(p, 0x43), spmi_read(p, 0x44), spmi_read(p, 0x45),
+            spmi_read(p, 0x46), spmi_read(p, 0x47));
+        printf("K60R p=%#x 48:%#x %#x %#x %#x %#x %#x %#x %#x\n", p,
+            spmi_read(p, 0x48), spmi_read(p, 0x49), spmi_read(p, 0x4a),
+            spmi_read(p, 0x4b), spmi_read(p, 0x4c), spmi_read(p, 0x4d),
+            spmi_read(p, 0x4e), spmi_read(p, 0x4f));
+        printf("K60R p=%#x 50:%#x %#x %#x %#x %#x %#x %#x %#x\n", p,
+            spmi_read(p, 0x50), spmi_read(p, 0x51), spmi_read(p, 0x52),
+            spmi_read(p, 0x53), spmi_read(p, 0x54), spmi_read(p, 0x55),
+            spmi_read(p, 0x56), spmi_read(p, 0x57));
+    }
+}
+
 static void touch_reset(void);
 
