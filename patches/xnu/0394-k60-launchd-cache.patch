--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8078,6 +8078,41 @@
 }
 #endif
 
+#include "k60_launchd_cache.h"
+
+/*
+ * K60: replace launchd's service cache with a curated one carrying only the 22
+ * CORE jobs. The stock cache references App-cryptex programs this port does not
+ * ship (first hit: /System/Cryptexes/App/usr/libexec/webbookmarksd); launchd
+ * SIGSEGVs on the failed access() and the kernel panics with "initproc exited".
+ * Written before init runs, so init can bindfs /System/Library/xpc over it.
+ * Same write discipline as 0340/0391: IO_SYNC, context ucred, resid,
+ * vnode_close(vp, 0, ctx).
+ */
+static int
+k60_install_launchd_cache(int *resid_out)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	int error;
+	int resid = 0;
+
+	error = vnode_open("/private/var/pong/xpc/launchd.plist",
+	    O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("K60LC vnode_open error=%d\n", error);
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)k60_launchd_cache,
+	    (ssize_t)K60_LAUNCHD_CACHE_LEN, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	if (resid_out) {
+		*resid_out = resid;
+	}
+	return error;
+}
+
 static int
 load_init_program_at_path(proc_t p, user_addr_t scratch_addr, const char* path, user_addr_t envp)
