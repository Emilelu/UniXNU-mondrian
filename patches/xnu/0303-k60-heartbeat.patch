+/* ---- 0303: storm table shared with the heartbeat reporter ---- */
+static struct k60_storm_ent {
+	char comm[24];
+	uint32_t status, sig, count;
+} k60_storm[16];
+
+unsigned int
+k60_storm_count(const char *comm)
+{
+	unsigned int i, total = 0;
+	for (i = 0; i < 16; i++) {
+		if (k60_storm[i].count != 0 && strncmp(k60_storm[i].comm, comm, 24) == 0) {
+			total += k60_storm[i].count;
+		}
+	}
+	return total;
+}
