+
+/* Existing Pong transport, K60 resources and no firmware upload. */
+static bool
+bring_up(void)
+{
+    if (touch_stage == 7) {
+        printf("Pong touch: GPIO-only identification, no GCC or serial-engine accesses\n");
+        if (!bitbang_init()) return false;
+        spi_transfer = bitbang_transfer;
+    } else {
+        printf("Pong touch: mapping serial engine %#llx after clock checks\n", se_phys);
+        se = ml_io_map(SE_PHYS, SE_SIZE);
+        if (!se) {
+            printf("Pong touch: serial-engine mapping unavailable\n");
+            return false;
+        }
+        bool gpio_spi;
+        const char *problem = geni_spi_init(spi_hz, &gpio_spi);
+        if (gpio_spi) {
+            printf("Pong touch: %s; use real GPIO SPI, not forced FIFO or guessed DMA\n", problem);
+            if (!bitbang_init()) return false;
+            spi_transfer = bitbang_transfer;
+        } else if (problem) {
+            printf("Pong touch: GENI unavailable: %s\n", problem);
+            return false;
+        } else {
+            spi_transfer = geni_transfer;
+        }
+    }
+    if (!goodix_probe(true)) {
+        printf("Pong touch: identification failed; retained IOVDD is unverified, no /dev/pong-touch\n");
+        return false;
+    }
+    return true;
+}
