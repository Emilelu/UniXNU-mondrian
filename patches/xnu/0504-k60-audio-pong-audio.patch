+static uint32_t
+pong_ar_open_speaker_device(uint8_t *out, uint32_t capacity, uint32_t port,
+    uint32_t token)
+{
+	static const PongSg sg = { AR_SG_SPEAKER, PERF_LOW_LATENCY, DIR_RX,
+		SCENARIO_PLAYBACK };
+	static const PongContainer c = { AR_SG_SPEAKER, POS_GLOBAL_DEV };
+	static const PongModule m[] = {
+		{ AR_MOD_I2S_SINK, AR_IID_SPEAKER_I2S, 1, 0 }
+	};
+	return pong_graph_open(out, capacity, port, token, &sg, &c, m, 1, NULL,
+	    0);
+}
