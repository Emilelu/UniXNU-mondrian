+			uint32_t fw_state = le32(info + offset + 12);
+			uint32_t fw_buf   = le32(info + offset + 18);
+			uint16_t fw_buf_max = (uint16_t)le16(info + offset + 22);
+			uint32_t frame_addr = le32(info + offset + 24);
+			uint32_t touch_data = le32(info + offset + 44);
