+	 * zzy-native-gpu-addon-mount unions /private/var/ngpu/addons during the
+	 * same prepare step. */
+	{
+		extern int k60_metal_deploy(void);
+
+		(void)k60_metal_deploy();
+	}
 	native_owner_data_stage = 3;
