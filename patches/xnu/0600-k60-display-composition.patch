+/* BGRA/RGBA scanout layers carry premultiplied alpha. The panel's fourth
+ * byte is reserved, so composition is over an opaque black display backdrop. */
+static inline uint32_t
+sourceOver(uint32_t top, uint32_t bottom)
+{
+	uint32_t alpha = top >> 24;
+	if (alpha == 0) {
+		return bottom;
+	}
+	if (alpha == 255) {
+		return top;
+	}
+	uint32_t result = 0xff000000;
+	for (unsigned shift = 0; shift < 24; shift += 8) {
+		uint32_t value = ((bottom >> shift) & 255) * (255 - alpha) + 128;
+		value = ((value + (value >> 8)) >> 8) + ((top >> shift) & 255);
+		result |= (value < 255 ? value : 255) << shift;
+	}
+	return result;
+}
