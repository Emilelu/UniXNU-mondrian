+/* ------------------------------------------------------------------------- */
+/* GPR packet format (ported from ShengGpr.c/h, BSD-2-Clause)                */
+/* ------------------------------------------------------------------------- */
+
+#define GPR_VERSION                 3u
+#define GPR_HEADER_BYTES            24u
+#define GPR_MAX_PACKET              560u
+#define GPR_DOMAIN_ADSP             2u
+#define GPR_DOMAIN_APPS             3u
+#define GPR_PORT_APM                1u
+#define GPR_OP_BASIC_RESULT         0x02000002u
+#define GPR_OP_APM_GET_SPF_STATE    0x0100100Du
+#define GPR_OP_APM_SPF_STATE        0x02001007u
+
+typedef struct {
+	uint8_t version;
+	uint8_t header_bytes;
+	uint16_t size;
+	uint8_t dst_domain;
+	uint8_t src_domain;
+	uint16_t reserved;
+	uint32_t src_port;
+	uint32_t dst_port;
+	uint32_t token;
+	uint32_t opcode;
+	const uint8_t *payload;
+	uint32_t payload_bytes;
+} PongGprPacket;
+
+enum {
+	PongGprOk = 0,
+	PongGprShort = -1,
+	PongGprBadVersion = -2,
+	PongGprBadHeader = -3,
+	PongGprBadSize = -4
+};
+
+static void
+pong_raw32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t
+pong_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+	    (uint32_t)p[3] << 24;
+}
+
+static uint32_t
+pong_gpr_encode(uint8_t *out, uint32_t capacity, const PongGprPacket *packet,
+    const void *payload, uint32_t payload_bytes)
+{
+	if (payload_bytes > GPR_MAX_PACKET - GPR_HEADER_BYTES ||
+	    (payload_bytes != 0 && payload == NULL)) {
+		return 0;
+	}
+	const uint32_t size = GPR_HEADER_BYTES + payload_bytes;
+	if (size > capacity) {
+		return 0;
+	}
+	pong_raw32(out, (GPR_VERSION & 0xfu) | (GPR_HEADER_BYTES / 4u) << 4 |
+	    size << 8);
+	pong_raw32(out + 4, (packet->dst_domain & 0xffu) |
+	    (packet->src_domain & 0xffu) << 8);
+	pong_raw32(out + 8, packet->src_port);
+	pong_raw32(out + 12, packet->dst_port);
+	pong_raw32(out + 16, packet->token);
+	pong_raw32(out + 20, packet->opcode);
+	if (payload_bytes != 0) {
+		memcpy(out + GPR_HEADER_BYTES, payload, payload_bytes);
+	}
+	return size;
+}
+
+static int
+pong_gpr_decode(const uint8_t *in, uint32_t length, PongGprPacket *packet)
+{
+	if (length < GPR_HEADER_BYTES) {
+		return PongGprShort;
+	}
+	const uint32_t w0 = pong_le32(in);
+	const uint32_t w1 = pong_le32(in + 4);
+	packet->version = (uint8_t)(w0 & 0xfu);
+	packet->header_bytes = (uint8_t)(((w0 >> 4) & 0xfu) * 4u);
+	packet->size = (uint16_t)(w0 >> 8);
+	if (packet->version != GPR_VERSION) {
+		return PongGprBadVersion;
+	}
+	if (packet->header_bytes < GPR_HEADER_BYTES) {
+		return PongGprBadHeader;
+	}
+	if (packet->size < packet->header_bytes || packet->size > length) {
+		return PongGprBadSize;
+	}
+	packet->dst_domain = (uint8_t)(w1 & 0xffu);
+	packet->src_domain = (uint8_t)((w1 >> 8) & 0xffu);
+	packet->src_port = pong_le32(in + 8);
+	packet->dst_port = pong_le32(in + 12);
+	packet->token = pong_le32(in + 16);
+	packet->opcode = pong_le32(in + 20);
+	packet->payload = in + packet->header_bytes;
+	packet->payload_bytes = packet->size - packet->header_bytes;
+	return PongGprOk;
+}
