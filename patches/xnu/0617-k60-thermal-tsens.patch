+	{ 3, { { 90000, 5000 }, { 115000, 5000 }, { 125000, 1000 } } },
+	/* tsens1[10] mdmss-0: 115000/5000 @8068, 125000/1000 @8048 active 102000 @8054, 105000 @8061 not used */
+	{ 2, { { 115000, 5000 }, { 125000, 1000 }, { 0, 0 } } },
+	/* tsens1[11] mdmss-1: 115000/5000 @8131, 125000/1000 @8111 active 102000 @8117, 105000 @8124 not used */
+	{ 2, { { 115000, 5000 }, { 125000, 1000 }, { 0, 0 } } },
+	/* tsens1[12] mdmss-2: 115000/5000 @8194, 125000/1000 @8174 active 102000 @8180, 105000 @8187 not used */
+	{ 2, { { 115000, 5000 }, { 125000, 1000 }, { 0, 0 } } },
+	/* tsens1[13] mdmss-3: 115000/5000 @8257, 125000/1000 @8237 active 102000 @8243, 105000 @8250 not used */
+	{ 2, { { 115000, 5000 }, { 125000, 1000 }, { 0, 0 } } },
+	/* tsens1[14] camera-0: 115000/5000 @8306, 125000/1000 @8300 */
+	{ 2, { { 115000, 5000 }, { 125000, 1000 }, { 0, 0 } } },
+	/* tsens1[15] camera-1: 115000/5000 @8327, 125000/1000 @8321 */
+	{ 2, { { 115000, 5000 }, { 125000, 1000 }, { 0, 0 } } },
+};
+
+/* The DTS name of each zone, in the same order. scripts/tests/test-k60-thermal-zones.c
+ * checks these against the sensor table in pong_thermal.h, which names the same zones. */
+static const char *const k60tz_names[K60TzZones] = {
+	"aoss-0", "cpuss-0", "cpuss-1", "cpuss-2",
+	"cpuss-3", "cpu-1-0", "cpu-1-1", "cpu-1-2",
+	"cpu-1-3", "cpu-1-4", "cpu-1-5", "cpu-1-6",
+	"cpu-1-7", "cpu-1-8", "gpuss-0", "gpuss-1",
+	"aoss-1", "cpu-0-0", "cpu-0-1", "cpu-0-2",
+	"cpu-0-3", "nspss-0", "nspss-1", "nspss-2",
+	"video", "ddr", "mdmss-0", "mdmss-1",
+	"mdmss-2", "mdmss-3", "camera-0", "camera-1",
+};
+
+const K60TzZone *
+k60tz_zone(unsigned slot)
+{
+	return slot < K60TzZones ? &k60tz_table[slot] : (const K60TzZone *)0;
+}
+
+const char *
+k60tz_name(unsigned slot)
+{
+	return slot < K60TzZones ? k60tz_names[slot] : "?";
+}
+
+unsigned
+k60tz_zone_level(uint8_t crossed_before, int32_t milli_c, unsigned slot,
+    uint8_t *crossed_after)
+{
+	const K60TzZone *zone = k60tz_zone(slot);
+	unsigned after = 0;
+	unsigned level;
+
+	if (crossed_after != (uint8_t *)0) {
+		*crossed_after = 0;
+	}
+	if (zone == (const K60TzZone *)0) {
+		return 0;
+	}
+	level = k60tl_input_level(crossed_before, milli_c, zone->trips, zone->tiers, &after);
+	if (crossed_after != (uint8_t *)0) {
+		*crossed_after = (uint8_t)after;
+	}
+	return level;
+}
+
+unsigned
+k60tz_step(K60TzState *state, const int32_t *milli_c)
+{
+	unsigned worst = 0;
+
+	for (unsigned slot = 0; slot < K60TzZones; slot++) {
+		const int32_t mc = milli_c != (const int32_t *)0 ? milli_c[slot] : K60TL_NO_READING;
+		const uint8_t before = state != (K60TzState *)0 ? state->crossed[slot] : 0u;
+		uint8_t after = 0;
+		const unsigned level = k60tz_zone_level(before, mc, slot, &after);
+
+		if (state != (K60TzState *)0) {
+			state->crossed[slot] = after;
+		}
+		if (level > worst) {
+			worst = level;
+		}
+	}
+	return worst;
+}
+
+int
+k60tz_closest(const int32_t *milli_c, struct K60TzClosest *out)
+{
+	int found = 0;
+	int32_t best_margin = 0;
+
+	if (out == (struct K60TzClosest *)0) {
+		return -1;
+	}
+	out->milli_c = K60TL_NO_READING;
+	out->margin_mc = 0;
+	out->slot = 0;
+	out->level = 0;
+	out->next_tier = 0;
+	if (milli_c == (const int32_t *)0) {
+		return -1;
+	}
+	for (unsigned slot = 0; slot < K60TzZones; slot++) {
+		const K60TzZone *zone = &k60tz_table[slot];
+		const int32_t mc = milli_c[slot];
+		unsigned level;
+		int32_t margin;
+
+		if (mc == K60TL_NO_READING) {
+			continue;
+		}
+		level = k60tz_zone_level(0u, mc, slot, (uint8_t *)0);
+		if (level >= zone->tiers) {
+			margin = -1;
+		} else {
+			margin = zone->trips[level].milli_c - mc;
+		}
+		if (found == 0 || margin < best_margin) {
+			found = 1;
+			best_margin = margin;
+			out->milli_c = mc;
+			out->margin_mc = margin;
+			out->slot = (uint8_t)slot;
+			out->level = (uint8_t)level;
+			out->next_tier = (uint8_t)(level < zone->tiers ? level : zone->tiers - 1u);
+		}
+	}
+	return found != 0 ? 0 : -1;
+}
diff --git a/bsd/dev/pong_thermal_pm.cpp b/bsd/dev/pong_thermal_pm.cpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/dev/pong_thermal_pm.cpp
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. */
+/* Pong SM8475 thermal pressure level: the publisher.
+ *
+ * This file is the master copy. patches/xnu/0617-k60-thermal-tsens.patch carries
+ * it into the XNU tree verbatim as bsd/dev/pong_thermal_pm.cpp;
+ * scripts/check-thermal-kernel-patch.py fails when the two copies differ.
+ *
+ * What it does: hands the board's own thermal level (0..3, computed by
+ * bsd/dev/pong_thermal_zones.c from the passive trips of the board DTS) to the one
+ * thermal entry point this kernel already has,
+ * IOPMrootDomain::systemPowerEventOccurred, under the key
+ * kIOPMThermalLevelWarningKey. It installs no actuator and programs no clock:
+ * docs/research/thermal/TRIP-DESIGN.md section 3.5 is the decision record, and
+ * docs/research/thermal/LEVEL-MAP.md section 4 records why the published number is
+ * the board's ladder and not one of Apple's OSThermalPressureLevel values.
+ *
+ * Why this is C++: systemPowerEventOccurred takes an OSSymbol and an OSObject,
+ * which only exist in C++. bsd/conf/files had no .cpp before this file; the
+ * build system has always supported it (makedefs/MakeInc.rule:423-428 turns
+ * .cpp into .cpo, bsd/conf/Makefile.template:72 has the %CXXFILES hook).
+ *
+ * The call is made from the thermal worker thread, not from the PM work loop.
+ * That is the supported shape: IOPMrootDomain::setThermalState re-dispatches
+ * itself through gIOPMWorkLoop->runAction when it is called outside the gate
+ * (iokit/Kernel/IOPMrootDomain.cpp:8119-8136), and the property update takes
+ * featuresDictLock (:8154-8156). What has not been shown on hardware is that a
+ * non-Apple kext-side caller is harmless; docs/research/thermal/08-KERNEL-DRIVER.md
+ * section 7.4 keeps that as an open question for the first boot. */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(PONG)
+
+#include <IOKit/IOService.h>
+#include <IOKit/pwr_mgt/IOPM.h>
+
+/* RootDomain.h pulls IOPMPrivate.h in its XNU_KERNEL_PRIVATE section
+ * (iokit/IOKit/pwr_mgt/RootDomain.h:37-39), and iokit/IOKit/pwr_mgt/Makefile
+ * lists IOPMPrivate.h in NOT_EXPORT_HEADERS, so the exported copy under
+ * EXPORT_HDRS/iokit/IOKit/pwr_mgt/ does not carry it and a bsd object cannot
+ * see it (bsd's INCFLAGS only reach EXPORT_HDRS, EXTERNAL_HEADERS and the
+ * fakeroot usr/local/include tree). Rather than copy a header into the build
+ * output or widen the upstream export list, close the private section for the
+ * length of this one include: the declarations this file needs, class
+ * IOPMrootDomain (:151) and both systemPowerEventOccurred overloads (:177-183),
+ * sit outside XNU_KERNEL_PRIVATE. The two headers RootDomain.h includes
+ * unconditionally are taken first so the window only covers RootDomain.h
+ * itself. */
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <sys/vnode.h>
+#undef XNU_KERNEL_PRIVATE
+#include <IOKit/pwr_mgt/RootDomain.h>
+#define XNU_KERNEL_PRIVATE 1
+
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+#include <sys/pong_thermal_level.h>
+#include <sys/systm.h>
+
+/* The event key, created once. Every IOPMrootDomain key in the tree is made this
+ * way and never released (iokit/Kernel/IOPMrootDomain.cpp:1535-1538). */
+static const OSSymbol *pong_thermal_pm_key;
+
+/* What was last accepted by the root domain, so an unchanged level costs nothing. */
+static unsigned int pong_thermal_pm_last_level;
+static int pong_thermal_pm_have_last;
+
+/* The value published is the level itself, 0..3. IOPMrootDomain records every value under
+ * the key in the "Power Status" dictionary and broadcasts it (:8172-8188), but only 100 and
+ * 110 move thermalWarningState (iokit/Kernel/IOPMrootDomain.cpp:8133-8134). 0..3 are
+ * therefore pure telemetry: this phase reports, it does not act. LEVEL-MAP.md section 4
+ * records what each Apple value means and what it would take to publish one of them. */
+
+/* Called once per sampling round by the worker in bsd/dev/pong_thermal.c.
+ *
+ * Before IOKit has started there is no root domain: bsd_init calls
+ * pong_thermal_init (bsd/kern/bsd_init.c:1166-1167) long before IOKitBSDInit
+ * (:1325), so the first rounds return here and the first successful call is the
+ * moment the publisher goes live. A missing root domain is not an error. */
+extern "C" void
+pong_thermal_pm_publish(unsigned int level)
+{
+	IOPMrootDomain *root;
+	OSNumber *number;
+	uint32_t value;
+
+	if (pong_thermal_pm_have_last && level == pong_thermal_pm_last_level) {
+		return;
+	}
+	root = IOService::getPMRootDomain();
+	if (root == NULL) {
+		return;
+	}
+	if (!pong_thermal_pm_key) {
+		pong_thermal_pm_key = OSSymbol::withCStringNoCopy(kIOPMThermalLevelWarningKey);
+		if (!pong_thermal_pm_key) {
+			return;
+		}
+	}
+	value = (uint32_t)level;
+	/* withNumber hands back a retained object; the root domain keeps its own
+	 * reference in the "Power Status" dictionary (:8172), so this one is dropped
+	 * right after the call, as overload one does (:8103-8116). */
+	number = OSNumber::withNumber((unsigned long long)value, 32);
+	if (number == NULL) {
+		return;
+	}
+	(void)root->systemPowerEventOccurred(pong_thermal_pm_key, (OSObject *)number);
+	number->release();
+	pong_thermal_pm_last_level = level;
+	pong_thermal_pm_have_last = 1;
+	printf("PongThermal: level %s (%u) published as %s=%u\n",
+	    k60tl_level_name(level), level, kIOPMThermalLevelWarningKey, value);
+}
+
+#endif /* PONG */
diff --git a/bsd/sys/pong_thermal.h b/bsd/sys/pong_thermal.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/sys/pong_thermal.h
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. */
+/* Board thermal-sensor description shared by the in-kernel tsens reader and its
+ * host test. Read-only by construction: nothing here writes a register.
+ *
+ * patches/xnu/0617-k60-thermal-tsens.patch carries a verbatim copy of this file
+ * into the XNU tree as bsd/sys/pong_thermal.h, because the kernel cannot see
+ * drivers/PongThermal. scripts/tests/test-k60-thermal-kernel.c extracts the copy
+ * out of the patch and fails if the two ever differ, so the code that ships is
+ * the code that is tested.
+ *
+ * Register map and field layout: mainline Linux drivers/thermal/qcom/tsens-v2.c
+ * (v6.6) lines 12-27 and 94-101, cross-checked against the vendor qcom_tsens.ko
+ * (see docs/research/thermal/04-ANDROID-EVIDENCE.md). Sensor order: board DTB
+ * /soc/thermal-zones, see docs/research/thermal/01-SAME-HARDWARE.md section 5.1. */
+#ifndef _SYS_PONG_THERMAL_H_
+#define _SYS_PONG_THERMAL_H_
+
+#include <stdint.h>
+
+/* /soc/thermal-sensor@c263000 and @c265000, each with #qcom,sensors = <16>. */
+enum {
+	PONG_THERMAL_CONTROLLERS = 2,
+	PONG_THERMAL_SENSORS_PER_CONTROLLER = 16,
+	PONG_THERMAL_SENSOR_COUNT = 32,
+	PONG_THERMAL_DOMAINS = 5
+};
+
+/* Pressure-level domains, the same five the macOS side consumes. */
+enum {
+	PONG_THERMAL_DOMAIN_LITTLE = 0,
+	PONG_THERMAL_DOMAIN_BIG = 1,
+	PONG_THERMAL_DOMAIN_GPU = 2,
+	PONG_THERMAL_DOMAIN_NPU = 3,
+	PONG_THERMAL_DOMAIN_DDR = 4,
+	PONG_THERMAL_DOMAIN_NONE = 0xff
+};
+
+/* TM block, tsens-v2.c:25-26. Byte offsets; the driver converts to word indexes. */
+#define PONG_THERMAL_TM_SN_STATUS(n) (0x0a0u + 4u * (uint32_t)(n))
+#define PONG_THERMAL_TM_TRDY         0x0e4u
+/* SROT block, tsens-v2.c:12-13. Read only: TSENS_EN is never set by this code. */
+#define PONG_THERMAL_SROT_HW_VER     0x000u
+#define PONG_THERMAL_SROT_CTRL       0x004u
+
+/* TM_Sn_STATUS fields, tsens-v2.c:94-101. */
+#define PONG_THERMAL_STATUS_TEMP_MASK 0x00000fffu
+#define PONG_THERMAL_STATUS_VALID     (1u << 21)
+#define PONG_THERMAL_STATUS_FLAG_MASK 0x001f0000u
+#define PONG_THERMAL_STATUS_FLAG_SHIFT 16
+
+/* SROT_HW_VER fields, tsens-v2.c:56-58. */
+#define PONG_THERMAL_VER_MAJOR(v) (((v) >> 28) & 0x0fu)
+#define PONG_THERMAL_VER_MINOR(v) (((v) >> 16) & 0x0fffu)
+#define PONG_THERMAL_VER_STEP(v)  ((v) & 0xffffu)
+
+/* Plausibility window used by the POCO X5 Pro port, hakios.thermal.c:15-16. */
+enum {
+	PONG_THERMAL_MIN_MILLI_C = -40000,
+	PONG_THERMAL_MAX_MILLI_C = 160000
+};
+
+enum {
+	PONG_THERMAL_OK = 0,
+	PONG_THERMAL_NO_VALID = -1,
+	PONG_THERMAL_BAD_ARG = -2,
+	PONG_THERMAL_OUT_OF_RANGE = -3
+};
+
+struct pong_thermal_reading {
+	int32_t milli_c;   /* meaningful only when valid != 0 */
+	uint32_t flags;    /* bits 0..4: min, lower, upper, critical, max */
+	int valid;
+};
+
+struct pong_thermal_sensor {
+	uint8_t controller;  /* 0 = 0xc263000, 1 = 0xc265000 */
+	uint8_t index;       /* 0..15, the DT thermal-sensor-cells argument */
+	uint8_t zone;        /* live Android thermal_zone id, cross-check only */
+	uint8_t domain;      /* PONG_THERMAL_DOMAIN_* */
+	const char *name;    /* DT thermal-zone name */
+};
+
+/* tsens.c:346-347: the v2 status word already holds deci-Celsius, so the value is
+ * sign_extend32(temp, 12) * 100 and no calibration slope/offset is applied. */
+static inline int32_t
+pong_thermal_status_to_mc(uint32_t status)
+{
+	int32_t raw = (int32_t)(status & PONG_THERMAL_STATUS_TEMP_MASK);
+
+	raw = (raw << 20) >> 20;   /* sign-extend the 12-bit field */
+	return raw * 100;
+}
+
+static inline uint32_t
+pong_thermal_status_flags(uint32_t status)
+{
+	return (status & PONG_THERMAL_STATUS_FLAG_MASK) >> PONG_THERMAL_STATUS_FLAG_SHIFT;
+}
+
+static inline int
+pong_thermal_decode(uint32_t status, struct pong_thermal_reading *out)
+{
+	int32_t mc;
+
+	if (out == 0) {
+		return PONG_THERMAL_BAD_ARG;
+	}
+	out->milli_c = 0;
+	out->flags = pong_thermal_status_flags(status);
+	out->valid = 0;
+	if ((status & PONG_THERMAL_STATUS_VALID) == 0) {
+		return PONG_THERMAL_NO_VALID;
+	}
+	mc = pong_thermal_status_to_mc(status);
+	if (mc < PONG_THERMAL_MIN_MILLI_C || mc > PONG_THERMAL_MAX_MILLI_C) {
+		return PONG_THERMAL_OUT_OF_RANGE;
+	}
+	out->milli_c = mc;
+	out->valid = 1;
+	return PONG_THERMAL_OK;
+}
+
+/* tsens-v2.c:60: TSENS_EN is SROT_CTRL[0]. Read only. */
+static inline int
+pong_thermal_ctrl_enabled(uint32_t ctrl)
+{
+	return (ctrl & 1u) != 0;
+}
+
+/* Zone order is the DT order: tsens0 index 0..15 = zones 24..39, then tsens1. */
+static const struct pong_thermal_sensor pong_thermal_sensors[PONG_THERMAL_SENSOR_COUNT] = {
+	{ 0,  0, 24, PONG_THERMAL_DOMAIN_NONE,   "aoss-0"   },
+	{ 0,  1, 25, PONG_THERMAL_DOMAIN_NONE,   "cpuss-0"  },
+	{ 0,  2, 26, PONG_THERMAL_DOMAIN_NONE,   "cpuss-1"  },
+	{ 0,  3, 27, PONG_THERMAL_DOMAIN_NONE,   "cpuss-2"  },
+	{ 0,  4, 28, PONG_THERMAL_DOMAIN_NONE,   "cpuss-3"  },
+	{ 0,  5, 29, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-0"  },
+	{ 0,  6, 30, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-1"  },
+	{ 0,  7, 31, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-2"  },
+	{ 0,  8, 32, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-3"  },
+	{ 0,  9, 33, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-4"  },
+	{ 0, 10, 34, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-5"  },
+	{ 0, 11, 35, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-6"  },
+	{ 0, 12, 36, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-7"  },
+	{ 0, 13, 37, PONG_THERMAL_DOMAIN_BIG,    "cpu-1-8"  },
+	{ 0, 14, 38, PONG_THERMAL_DOMAIN_GPU,    "gpuss-0"  },
+	{ 0, 15, 39, PONG_THERMAL_DOMAIN_GPU,    "gpuss-1"  },
+	{ 1,  0, 40, PONG_THERMAL_DOMAIN_NONE,   "aoss-1"   },
+	{ 1,  1, 41, PONG_THERMAL_DOMAIN_LITTLE, "cpu-0-0"  },
+	{ 1,  2, 42, PONG_THERMAL_DOMAIN_LITTLE, "cpu-0-1"  },
+	{ 1,  3, 43, PONG_THERMAL_DOMAIN_LITTLE, "cpu-0-2"  },
+	{ 1,  4, 44, PONG_THERMAL_DOMAIN_LITTLE, "cpu-0-3"  },
+	{ 1,  5, 45, PONG_THERMAL_DOMAIN_NPU,    "nspss-0"  },
+	{ 1,  6, 46, PONG_THERMAL_DOMAIN_NPU,    "nspss-1"  },
+	{ 1,  7, 47, PONG_THERMAL_DOMAIN_NPU,    "nspss-2"  },
+	{ 1,  8, 48, PONG_THERMAL_DOMAIN_NONE,   "video"    },
+	{ 1,  9, 49, PONG_THERMAL_DOMAIN_DDR,    "ddr"      },
+	{ 1, 10, 50, PONG_THERMAL_DOMAIN_NONE,   "mdmss-0"  },
+	{ 1, 11, 51, PONG_THERMAL_DOMAIN_NONE,   "mdmss-1"  },
+	{ 1, 12, 52, PONG_THERMAL_DOMAIN_NONE,   "mdmss-2"  },
+	{ 1, 13, 53, PONG_THERMAL_DOMAIN_NONE,   "mdmss-3"  },
+	{ 1, 14, 54, PONG_THERMAL_DOMAIN_NONE,   "camera-0" },
+	{ 1, 15, 55, PONG_THERMAL_DOMAIN_NONE,   "camera-1" },
+};
+
+static inline const struct pong_thermal_sensor *
+pong_thermal_sensor_at(unsigned slot)
+{
+	if (slot >= PONG_THERMAL_SENSOR_COUNT) {
+		return 0;
+	}
+	return &pong_thermal_sensors[slot];
+}
+
+/* Hottest reading per domain; domains without a valid sensor keep INT32_MIN. */
+static inline void
+pong_thermal_domain_max(const int32_t milli_c[PONG_THERMAL_SENSOR_COUNT],
+    int32_t out[PONG_THERMAL_DOMAINS])
+{
+	unsigned d, slot;
+
+	for (d = 0; d < PONG_THERMAL_DOMAINS; d++) {
+		out[d] = INT32_MIN;
+	}
+	for (slot = 0; slot < PONG_THERMAL_SENSOR_COUNT; slot++) {
+		unsigned domain = pong_thermal_sensors[slot].domain;
+
+		if (domain >= PONG_THERMAL_DOMAINS) {
+			continue;
+		}
+		if (milli_c[slot] > out[domain]) {
+			out[domain] = milli_c[slot];
+		}
+	}
+}
+
+#endif /* _SYS_PONG_THERMAL_H_ */
diff --git a/bsd/sys/pong_thermal_level.h b/bsd/sys/pong_thermal_level.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/sys/pong_thermal_level.h
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. */
+/* The board's temperatures as macOS's thermal pressure level (OSThermalPressureLevel).
+ *
+ * This is the half of the thermal line that does not touch hardware: the mapping from
+ * the 32 tsens sensors to five frequency/voltage domains and from those domains to the
+ * pressure level macOS acts on. Every threshold here is a trip point of the board DTB,
+ * cited by line in docs/research/thermal/05-PRESSURE-LEVEL.md; nothing is invented.
+ *
+ * The consumer side is macOS's: thermalmonitord copies the SMC key 'mTPL' into the
+ * notification com.apple.system.thermalpressurelevel once a second (ThermalLevel.h:6-25
+ * of the UniXNU-sheng port, which read that out of thermalmonitord of 27.3 26C5035r).
+ * Publishing that service needs IOKit and a kernel link, so it stays out of this file:
+ * here are the data and the arithmetic a host test can run, as in the reference port. */
+#ifndef K60_THERMAL_LEVEL_H
+#define K60_THERMAL_LEVEL_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* OSThermalPressureLevel (libkern/OSThermalNotification.h). Sleeping is never reported:
+ * no trip point of this board stands for it. */
+enum { K60TlNominal = 0, K60TlModerate = 1, K60TlHeavy = 2, K60TlTrapping = 3,
+       K60TlSleeping = 4 };
+
+/* The domains. Two CPU clusters, the GPU, the NPU and DDR: the five groups whose trip
+ * points differ on this board (docs/research/thermal/01-SAME-HARDWARE.md §5.1). */
+enum { K60TlInputs = 5,
+       K60TlCpuLittle = 0, K60TlCpuBig = 1, K60TlGpu = 2, K60TlNpu = 3, K60TlDdr = 4 };
+
+/* Three trip points per input: the domain's own warning trip, its reset-monitor trip and
+ * the board-wide thermal-engine trip. Ascending, each with the DT's hysteresis. */
+enum { K60TlTrips = 3 };
+
+/* A reading that does not exist. A sensor without a reading counts as nominal and
+ * forgets what it had crossed, so an unreadable sensor can neither raise the level nor
+ * hold it up (ThermalLevel.h:56-59). */
+#define K60TL_NO_READING INT32_MIN
+
+typedef struct { int32_t milli_c, hysteresis_mc; } K60TlTrip;
+
+/* Sensor index (0..31, the K60TsensTable order: tsens0 idx 0..15 then tsens1 0..15) to
+ * the domain it feeds, or K60TlNoInput for sensors the level does not use (aoss, cpuss,
+ * video, mdmss, camera: they have trips but no cooling action on this board). */
+enum { K60TlNoInput = 0xffu };
+
+typedef struct {
+    uint8_t crossed[K60TlInputs]; /* trip points crossed per input at the last step */
+} K60TlState;
+
+/* The trip table of one input, and its name. NULL / "?" for an out-of-range input. */
+const K60TlTrip *k60tl_trips(unsigned input);
+const char *k60tl_input_name(unsigned input);
+const char *k60tl_level_name(unsigned level);
+unsigned k60tl_input_of_sensor(unsigned sensor);
+
+/* The level of one input given how many of its trips were crossed before. A trip stays
+ * crossed until the reading falls below its temperature less its hysteresis, which is
+ * the thermal core's rule (ThermalLevel.h:73-83). Returns the new count (0..3) and
+ * writes it to *crossed_after when that is not NULL. */
+unsigned k60tl_input_level(unsigned crossed_before, int32_t milli_c,
+                           const K60TlTrip *trips, unsigned trips_count,
+                           unsigned *crossed_after);
+
+/* One sampling round over all inputs; milli_c[i] is the hottest sensor of input i, or
+ * K60TL_NO_READING. Returns the highest input level (the level macOS gets). state may be
+ * NULL for a stateless query. */
+unsigned k60tl_step(K60TlState *state, const int32_t *milli_c);
+
+/* This module stops at the level. What the number published to IOPMrootDomain is, and why
+ * it is the board's own 0..3 ladder rather than one of Apple's OSThermalPressureLevel
+ * values, is docs/research/thermal/LEVEL-MAP.md section 4: the zone ladder of
+ * bsd/dev/pong_thermal_zones.c is what bsd/dev/pong_thermal_pm.cpp hands to
+ * systemPowerEventOccurred. */
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* K60_THERMAL_LEVEL_H */
diff --git a/bsd/sys/pong_thermal_zones.h b/bsd/sys/pong_thermal_zones.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/bsd/sys/pong_thermal_zones.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. */
+/* The board DTS's own thermal ladder: one zone per tsens sensor, and the levels each
+ * zone can reach.
+ *
+ * The board declares 154 trip points under /thermal-zones (mondrian.dts:6643-8422); 146
+ * are passive and 8 are active. Every zone that reads a tsens sensor directly raises its
+ * own short ladder of passive trips: the thermal-engine and thermal-hal copies, the reset
+ * monitor, and for the CPU clusters the emergency shutdown trip. This module keeps that
+ * ladder, one row per sensor in the order the driver samples them (tsens0 idx 0..15 then
+ * tsens1 idx 0..15), so the level it reports is the board's own number and not a table
+ * invented here.
+ *
+ * What a level means (docs/research/thermal/LEVEL-MAP.md section 3):
+ *   0  no passive trip of this zone is crossed
+ *   1  the zone's lowest passive trip is crossed
+ *   2  its second one is crossed
+ *   3  its third one is crossed (zones with two trips stop at 2)
+ * A crossed trip is released only below its temperature minus the DT hysteresis, the
+ * thermal core's rule; k60tl_input_level in pong_thermal_level.h does that arithmetic and
+ * is reused here rather than duplicated.
+ *
+ * The board level is the highest zone level. Two kinds of DTS zone are deliberately not
+ * in the table: the 25 zones that read the QMI proxy (thermal-sensors = <0x5c ...>,
+ * phandle 0x5c is qmi-ts-sensors at mondrian.dts:16774), whose temperatures come from the
+ * modem and are not in any window this kernel maps; and the two zones whose "trips" are
+ * not temperatures at all (mx-pe, passive 1/2/3 with status = "disabled" at
+ * mondrian.dts:8336; isense_trim, passive 2 at :8397). LEVEL-MAP.md section 2 lists both.
+ *
+ * The same file ships twice: as this master copy and as bsd/sys/pong_thermal_zones.h
+ * inside patches/xnu/0617-k60-thermal-tsens.patch, where the level header is
+ * bsd/sys/pong_thermal_level.h. scripts/check-thermal-kernel-patch.py fails when the two
+ * copies differ. */
+#ifndef K60_THERMAL_ZONES_H
+#define K60_THERMAL_ZONES_H
+
+#include <stdint.h>
+#if defined(KERNEL)
+#include <sys/pong_thermal_level.h>
+#else
+#include "K60ThermalLevel.h"
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* One row per sampled sensor, in the driver's sensor order. */
+enum { K60TzZones = 32, K60TzTiers = 3 };
+
+/* The passive trips of one zone ascending by temperature, each with the DT hysteresis.
+ * A zone with fewer trips than K60TzTiers leaves the rest at zero and reports tiers. */
+typedef struct {
+	uint8_t tiers;
+	K60TlTrip trips[K60TzTiers];
+} K60TzZone;
+
+/* Trips crossed per zone at the last step, so a trip is only released below its
+ * temperature minus hysteresis. */
+typedef struct {
+	uint8_t crossed[K60TzZones];
+} K60TzState;
+
+/* The zone closest to its next trip. The sampler logs this, because a boot at 45 C still
+ * has to show how far the board is from level 1 (LEVEL-MAP.md section 5.2). */
+struct K60TzClosest {
+	int32_t milli_c;   /* the reading */
+	int32_t margin_mc; /* mC left before the next trip; -1 when every trip is crossed */
+	uint8_t slot;      /* sensor slot 0..31 */
+	uint8_t level;     /* that zone's level now */
+	uint8_t next_tier; /* index into the zone's trips, clamped to tiers - 1 */
+};
+
+/* The row of one sensor and the board DTS's name for its zone ("cpu-1-0", "ddr", ...).
+ * NULL and "?" for an out-of-range slot. */
+const K60TzZone *k60tz_zone(unsigned slot);
+const char *k60tz_name(unsigned slot);
+
+/* The level of one zone given how many of its trips were crossed before, with the new
+ * count in *crossed_after (may be NULL). A missing reading gives level 0 and forgets the
+ * crossings, so an unreadable sensor can neither raise the level nor hold it up. */
+unsigned k60tz_zone_level(uint8_t crossed_before, int32_t milli_c, unsigned slot,
+    uint8_t *crossed_after);
+
+/* One sampling round over all 32 zones; milli_c[slot] is that sensor's reading or
+ * K60TL_NO_READING. Returns the board level 0..3. state may be NULL for a stateless
+ * query. */
+unsigned k60tz_step(K60TzState *state, const int32_t *milli_c);
+
+/* The zone closest to its next trip. Returns 0 and fills *out when at least one sensor has
+ * a reading, -1 otherwise. */
+int k60tz_closest(const int32_t *milli_c, struct K60TzClosest *out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* K60_THERMAL_ZONES_H */
