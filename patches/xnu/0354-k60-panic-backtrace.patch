--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -491,6 +491,28 @@
 
 	/* 0348: the panic text itself only reaches the ramoops ring, which the
 	 * reset discards.  Emit the fault identity on the live console first. */
+	/* 0354: walk the frame-pointer chain so the caller of a fault reached
+	 * through a NULL object can be identified without a debugger. */
+	{
+		uint64_t k60_fp = (uint64_t)state->fp;
+		uint64_t k60_lr = (uint64_t)state->lr;
+		unsigned k60_i;
+
+		printf("K60KFRAME 0 ret=0x%llx fp=0x%llx\n",
+		    (unsigned long long)k60_lr, (unsigned long long)k60_fp);
+		for (k60_i = 1; k60_i <= 6 && k60_fp; k60_i++) {
+			uint64_t k60_next = *(uint64_t *)(uintptr_t)k60_fp;
+			uint64_t k60_ret = *(uint64_t *)(uintptr_t)(k60_fp + 8);
+
+			printf("K60KFRAME %u ret=0x%llx fp=0x%llx\n", k60_i,
+			    (unsigned long long)k60_ret, (unsigned long long)k60_next);
+			if (k60_next <= k60_fp) {
+				break;
+			}
+			k60_fp = k60_next;
+		}
+	}
+
 	printf("K60KEXC msg=%s pc=0x%llx lr=0x%llx sp=0x%llx esr=0x%x far=0x%llx\n",
 	    msg ? msg : "(null)",
 	    (unsigned long long)state->pc, (unsigned long long)state->lr,
