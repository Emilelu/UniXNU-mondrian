+/*
+ * 0410: P2-b vendor function loopback (RESEARCH.md 15.4(c) and 15.5).
+ *
+ * IF2 exposes EP 0x03 (bulk OUT, physical EP6) and EP 0x83 (bulk IN, physical
+ * EP7), the same pair the same-SoC mux uses (PongUsbDevice.h:69-74). Whatever
+ * the host writes to EP6 is copied to the IN buffer and sent back on EP7, so a
+ * host-side writer/reader pair exercises the whole path at once: descriptor,
+ * endpoint configuration, FIFO budget, TRB handling and both DMA directions.
+ *
+ * The state machine follows pong's mux() (PongUsbDevice.h:308-315) and its
+ * completion handlers (:256-265): one OUT transfer stays armed, the received
+ * length comes from the TRB residual, and a full-length IN is followed by a
+ * zero-length transfer so the host's read terminates.
+ */
+static void
+ud_vendor(void)
+{
+	if (!ud.vend_ok || !ud.configured || ud.failed) {
+		return;
+	}
+	if (!ud.vend_rx_active && !ud.vend_pending && !ud.vend_tx_active && !ud.vend_zlp) {
+		ud.vend_rx_active =
+		    ud_start(ud.vend_out_ep, UD_VEND_RX, UD_VEND_BYTES, TRBCTL_NORMAL) == 0;
+	}
+	if (ud.vend_zlp) {
+		ud.vend_zlp = false;
+		ud.vend_tx_active = ud_start(ud.vend_in_ep, UD_VEND_TX, 0, TRBCTL_NORMAL) == 0;
+		return;
+	}
+	if (ud.vend_tx_active || !ud.vend_pending) {
+		return;
+	}
+	uint32_t n = ud.vend_pending;
+	ud.vend_pending = 0;
+	ud.vend_sent = n;
+	ud.vend_tx_active = ud_start(ud.vend_in_ep, UD_VEND_TX, n, TRBCTL_NORMAL) == 0;
+	if (!ud.vend_tx_active) {
+		ud.vend_sent = 0;
+		printf("K60 USBLOG: vendor IN start failed (%u bytes)\n", n);
+		}
+}
