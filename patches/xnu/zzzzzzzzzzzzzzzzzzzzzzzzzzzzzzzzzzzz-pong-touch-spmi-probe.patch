 /* Declared ahead of its definition: goodix_apply_config resets the chip
  * through it so the SPI mode is re-confirmed on that path too. */
+/* Read-only look at the SPMI arbiter: identity, the map table at core+0x2000,
+ * and one register read per PM8350C (sid 2) channel through the observer. */
+#define SPMI_CORE_PHYS     0xc400000UL
+#define SPMI_OBSERVER_PHYS 0xc440000UL
+
+static vm_offset_t spmi_core, spmi_obs;
+
+static uint32_t spmi_rd(uint32_t off)
+{
+    return *(volatile uint32_t *)(spmi_core + off);
+}
+
+static void spmi_probe(void)
+{
+    uint32_t found = 0, first = 0, second = 0, third = 0;
+    uint32_t ppids[6];
+    uint32_t np = 0;
+
+    if (!spmi_core) {
+        spmi_core = ml_io_map(SPMI_CORE_PHYS, 0x3000);
+        spmi_obs = ml_io_map(SPMI_OBSERVER_PHYS, 0x80000);
+    }
+    if (!spmi_core || !spmi_obs) {
+        printf("K60SPMI map failed core=%#llx obs=%#llx\n",
+            (unsigned long long)spmi_core, (unsigned long long)spmi_obs);
+        return;
+    }
+    printf("K60SPMI ver=%#x channels=%u\n", spmi_rd(0x000), spmi_rd(0x004) & 0x7ff);
+    for (uint32_t n = 0; n < 758 && np < 6; n++) {
+        uint32_t v = spmi_rd(0x2000 + 4 * n);
+        uint32_t ppid = (v >> 8) & 0xfff;
+
+        if ((ppid >> 8) != 2) {
+            continue;
+        }
+        if (found == 0) {
+            first = ppid;
+        } else if (found == 1) {
+            second = ppid;
+        } else if (found == 2) {
+            third = ppid;
+        }
+        ppids[np++] = ppid;
+        found++;
+    }
+    printf("K60CFG rev=4 n=%u p=%#x,%#x,%#x\n", found, first, second, third);
+    for (uint32_t i = 0; i < np; i++) {
+        vm_offset_t ch = spmi_obs + 0x20u * ppids[i];
+        uint32_t st = 0;
+
+        wr(ch + 0x00, (15u << 27) | (0x04u << 4) | 0u);
+        for (uint32_t k = 0; k < 2000; k++) {
+            st = *(volatile uint32_t *)(ch + 0x08);
+            if (st & 0x1u) {
+                break;
+            }
+        }
+        printf("K60CFG q=%#x st=%#x v=%#x\n", ppids[i], st,
+            *(volatile uint32_t *)(ch + 0x18));
+    }
+}
+
 static void touch_reset(void);
 
