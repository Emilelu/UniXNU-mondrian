+def flash_items(hw, all_items):
+    """Keep the active floor and explicitly add parked/planned flash targets."""
+    raw = (os.environ.get("K60_FLASH_ITEMS") or "").strip()
+    names = [name.strip() for name in raw.split(",")]
+    if not raw or not all(names):
+        raise SystemExit("flash requires explicit K60_FLASH_ITEMS (for WiFi: wifi)")
+    unknown = [name for name in names if name not in all_items]
+    if unknown:
+        raise SystemExit("K60_FLASH_ITEMS unknown hardware: %s" % ", ".join(unknown))
+    if len(set(names)) != len(names):
+        raise SystemExit("K60_FLASH_ITEMS contains duplicate hardware")
+    if os.environ.get("K60_FLASH_OBSERVATION") and "wifi" not in names:
+        raise SystemExit("K60_FLASH_OBSERVATION requires explicit WiFi scope")
+    return dict(hw, **{name: all_items[name] for name in names})
+
+
+def wifi_observation_problems(steps):
+    """Bind offline verification and the prediction to this requested observation."""
+    problems = []
+    observation = (os.environ.get("K60_FLASH_OBSERVATION") or "").strip()
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", observation):
+        return ["wifi :: flash requires a valid K60_FLASH_OBSERVATION identifier"]
+    for step in ("verify", "device"):
+        entry = steps.get(step) or {}
+        if step == "device":
+            entry = entry.get("prediction") or {}
+        if entry.get("observation") != observation:
+            problems.append("wifi :: %s observation mismatch: expected %r, got %r"
+                            % (step, observation, entry.get("observation")))
+        reference = entry.get("reference") or ""
+        if not isinstance(reference, str) or not has_reference(reference):
+            problems.append("wifi :: %s missing observation reference" % step)
+    return problems
+
