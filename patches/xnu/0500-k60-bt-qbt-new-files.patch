+/* GIC SPI enable/disable helper.  armcpu_spi_attach owns routing; this only
+ * toggles the distributor enable bit, which is safe for a level IRQ. */
+static void k60_gic_mask(uint32_t intid, bool masked) {
+    volatile uint32_t *gicd = k60.gic.va;
+    uint32_t word = (intid / 32u) * 4u;
+    uint32_t bit = 1u << (intid % 32u);
+    if (!gicd) return;
+    gicd[(masked ? 0x180u : 0x100u) / 4u + word / 4u] = bit;
+    k60_barrier();
+}
+
+/* ------------------------------------------------------------------------- */
+/* GCC clock control (QUPV3_2 vote register + branch halt polling)            */
+/* ------------------------------------------------------------------------- */
+
+/* Program gcc_qupv3_wrap2_s5_clk_src (QUPV3_2 SE20) to an exact table rate.
+ * Register layout: CMD_RCGR + CFG/M/N/D = +0x4/+0x8/+0xc/+0x10
+ * (clk-rcg2.c:34-49); MND formula and dual-edge mode: clk-rcg2.c:285-350. */
+static int k60_gcc_set_se_rate(uint32_t hz) {
+    const struct k60_se_rate *r = NULL;
+    for (size_t i = 0; i < sizeof(k60_se_rates) / sizeof(k60_se_rates[0]); i++)
+        if (k60_se_rates[i].hz == hz) { r = &k60_se_rates[i]; break; }
+    if (!r) return -EINVAL;
+    uint32_t base = K60_GCC_WRAP2_SE20_CMD_RCGR;
+    uint32_t cfg = k60_read32(&k60.gcc, base + 0x4);
+    const uint32_t mask = 0x1fu | (7u << 8) | (3u << 12) | (1u << 20);
+    uint32_t value = (uint32_t)r->pre_div | ((uint32_t)r->src_cfg << 8) | (1u << 20);
+    if (r->m && r->n && r->m != r->n) value |= (2u << 12); /* CFG_MODE_DUAL_EDGE */
+    /* Linux writes M/N/D before CFG (clk-rcg2.c:285-350). */
+    if (r->m && r->n) {
+        const uint32_t width_mask = 0xffffu; /* mnd_width = 16 */
+        uint32_t n_minus_m = (uint32_t)(r->n - r->m);
+        uint32_t d_val = r->n;
+        uint32_t two_d = n_minus_m * 2u;
+        if (d_val < r->m) d_val = r->m;
+        if (d_val > two_d) d_val = two_d;
+        k60_write32(&k60.gcc, base + 0x8, r->m);
+        k60_write32(&k60.gcc, base + 0xc, (~n_minus_m) & width_mask);
+        k60_write32(&k60.gcc, base + 0x10, (~d_val) & width_mask);
+    }
+    k60_write32(&k60.gcc, base + 0x4, (cfg & ~mask) | value);
+    IODelay(10);
+    return 0;
+}
+
+static int k60_gcc_wait_halt(uint32_t halt_reg) {
+    for (unsigned i = 0; i < 1000; i++) {
+        /* CBCR_CLK_OFF = BIT(31); 0 means running (clk-branch.h:42). */
+        if (!(k60_read32(&k60.gcc, halt_reg) & (1u << 31))) return 0;
+        IODelay(1);
+    }
+    return -ETIMEDOUT;
+}
+
+static int k60_serial_clock(bool enabled) {
+    if (enabled) {
+        /* GPLL0 must be locked before the SE RCG can use it (gcc-sm8450.c:39-54). */
+        k60_write32(&k60.gcc, K60_GCC_GPLL0_CMD, k60_read32(&k60.gcc, K60_GCC_GPLL0_CMD) | 1u);
+        for (unsigned i = 0; i < 1000 && !(k60_read32(&k60.gcc, 0x0u) & (1u << 31)); i++)
+            IODelay(1);
+        if (!(k60_read32(&k60.gcc, 0x0u) & (1u << 31))) return -ETIMEDOUT;
+        k60_write32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE,
+                    k60_read32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE) | K60_GCC_VOTE_ALL);
+        int e;
+        if ((e = k60_gcc_wait_halt(K60_GCC_WRAP2_CORE_HALT))) return e;
+        if ((e = k60_gcc_wait_halt(K60_GCC_WRAP2_CORE_2X_HALT))) return e;
+        if ((e = k60_gcc_wait_halt(K60_GCC_WRAP2_M_AHB_HALT))) return e;
+        if ((e = k60_gcc_wait_halt(K60_GCC_WRAP2_S_AHB_HALT))) return e;
+        if ((e = k60_gcc_wait_halt(K60_GCC_WRAP2_SE20_HALT))) return e;
+        k60.clocked = true;
+        return 0;
+    }
+    /* Drop the SE vote first, then the wrapper infrastructure.  This skeleton
+     * does not poll for halt on disable; the vendor driver only delays 10 us
+     * for BRANCH_HALT_VOTED (clk-branch.c:69-73). */
+    k60_write32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE,
+                k60_read32(&k60.gcc, K60_GCC_QUPV3_WRAP2_VOTE) & ~K60_GCC_VOTE_ALL);
+    IODelay(10);
+    k60.clocked = false;
+    return 0;
+}
