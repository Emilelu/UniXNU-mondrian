diff --git a/bsd/dev/pong_ipa.h b/bsd/dev/pong_ipa.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_ipa.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* K60 IPA data path: constants, firmware validation and M1 staging.
+ *
+ * The live DT describes the IPA wrapper at 0x3e00000 with a 2 MiB
+ * qcom,entire-ipa-block-size. The IPA register block is the wrapper plus
+ * qcom,ipa-cfg-offset 0x140000, and the GSI has its own view at 0x3e04000.
+ * M0 records those facts without touching a register. M1 adds offline image
+ * validation and a staging routine for the 64 KiB ipa_fw_region; the PAS 15
+ * call is deliberately left to the caller of k60_ipa_firmware_begin().
+ *
+ * Sources: docs/research/cellular/20-IPA-V51-DATA-PATH.md sections 2 and 4,
+ *          docs/research/cellular/02-DT-TRUTH.md, dataipa ipa5.0/ipa_hwio.h.
+ */
+
+#ifndef K60_IPA_H
+#define K60_IPA_H
+
+#include <stdint.h>
+
+#include "pong_mdt.h"
+
+#define K60_IPA_WRAPPER_BASE          0x03e00000u
+#define K60_IPA_BLOCK_BYTES           0x00200000u
+#define K60_IPA_CFG_OFFSET            0x00140000u
+#define K60_IPA_CFG_BASE              (K60_IPA_WRAPPER_BASE + K60_IPA_CFG_OFFSET)
+#define K60_IPA_CFG_BYTES             0x00084000u
+#define K60_GSI_BASE                  0x03e04000u
+#define K60_GSI_BYTES                 0x000fc000u
+#define K60_IPA_COMP_HW_VERSION_REG   0x00000024u
+#define K60_IPA_VERSION_REG           0x00000028u
+#define K60_IPA_COMP_HW_VERSION_ADDR  (K60_IPA_CFG_BASE + K60_IPA_COMP_HW_VERSION_REG)
+#define K60_IPA_VERSION_ADDR          (K60_IPA_CFG_BASE + K60_IPA_VERSION_REG)
+#define K60_IPA_IRQ                   654u
+#define K60_GSI_IRQ                   432u
+#define K60_IPA_PAS_ID                15u
+#define K60_IPA_FW_NAME               "ipa_fws"
+#define K60_IPA_FW_REGION_BASE        0x8b900000u
+#define K60_IPA_FW_REGION_BYTES       0x00010000u
+#define K60_IPA_METADATA_OFFSET       0x0000e000u
+#define K60_IPA_METADATA_BYTES        0x00002000u
+#define K60_IPA_METADATA_BASE         (K60_IPA_FW_REGION_BASE + K60_IPA_METADATA_OFFSET)
+#define K60_IPA_GSI_REGION_BASE       0x8b910000u
+#define K60_IPA_GSI_REGION_BYTES      0x0000a000u
+#define K60_GSI_CH_DOORBELL_BASE      0x03e28000u
+#define K60_GSI_EV_DOORBELL_BASE      0x03e28800u
+#define K60_GSI_STATUS                0x03e29000u
+
+enum {
+    K60IpaOk = 0,
+    K60IpaNotReady = -1,
+    K60IpaBadArgument = -2,
+    K60IpaFirmwareBadImage = -3,
+    K60IpaFirmwareLayout = -4,
+    K60IpaFirmwareTooLarge = -5,
+    K60IpaMapFailed = -6,
+    K60IpaPasDenied = -7,
+};
+
+typedef struct {
+    uint32_t raw;
+    uint32_t major;
+    uint32_t minor;
+    uint32_t step;
+} K60IpaVersion;
+
+/* Decode IPA_COMP_HW_VERSION: major[31:28], minor[23:16], step[15:0]. */
+K60IpaVersion k60_ipa_decode_comp_hw_version(uint32_t raw);
+
+/* Offline check of an ipa_fws image against the K60 carveout layout. It parses
+ * the ELF headers and reports the span and metadata size without mapping or
+ * allocating anything; M1 uses the same parse before the PAS calls. */
+typedef struct {
+    uint64_t span;
+    uint64_t metadata;
+    uint32_t load_segments;
+    uint32_t relocatable;
+} K60IpaFirmwarePlan;
+
+int k60_ipa_firmware_check(const void *blob, uint64_t size, K60IpaFirmwarePlan *plan);
+
+/* M1 staging: copies a validated monolithic ipa_fws image into the caller's
+ * firmware region and writes its metadata blob into the caller's metadata
+ * buffer. Pure memory movement, so the host tests exercise the same code as
+ * the kernel. Both buffers must be writable and sized from the passed sizes;
+ * the region is zeroed before the segments are placed. */
+int k60_ipa_firmware_stage(const void *blob, uint64_t size, void *region,
+    uint64_t region_size, void *metadata, uint64_t metadata_size,
+    K60IpaFirmwarePlan *plan);
+
+/* M1 load: stages the image into the live IPA firmware carveout and hands it
+ * to PAS 15 (INIT_IMAGE, MEM_SETUP, AUTH_AND_RESET). This maps MMIO and makes
+ * SMC calls; it is not built in the host tests. */
+int k60_ipa_firmware_start(const void *blob, uint64_t size);
+
+/* M0 probe: reports that the data path is intentionally absent.  It must not
+ * map MMIO, write a register or call PAS; those begin in M1. */
+int k60_ipa_probe(void);
+
+extern const char k60_ipa_marker[];
+
+#endif /* K60_IPA_H */
diff --git a/bsd/dev/pong_ipa.c b/bsd/dev/pong_ipa.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_ipa.c
@@ -0,0 +1,295 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* K60 IPA data path M0 skeleton plus M1 firmware staging.
+ *
+ * M0 carries the register-map constants and the version decoder so later
+ * stages cannot invent a different base address. M1 validates a monolithic
+ * ipa_fws image, clears the 64 KiB ipa_fw_region, copies its load segments to
+ * their p_paddr offsets and builds the metadata block at the last 8 KiB.
+ * Nothing maps the IPA or GSI registers and no PAS call is made here; the
+ * caller owns the PAS 15 transitions and the GSI reset.
+ */
+
+#include "pong_ipa.h"
+#include "pong_modem_pas.h"
+
+#ifdef K60_HOST_TEST
+#include <stdio.h>
+#include <string.h>
+#else
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+/* osfmk/arm/machine_routines.h:703; declared here keeps the include path out
+ * of the leaky kernel header set (same choice as K60ModemBoot.c). */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys, vm_size_t size,
+    uint32_t flags);
+#endif
+
+static int
+k60_ipa_blob_read(void *context, uint64_t offset, void *to, size_t length)
+{
+    const uint8_t *blob = context;
+
+    memcpy(to, blob + offset, length);
+    return 0;
+}
+
+_Static_assert(K60_IPA_CFG_BASE == 0x03f40000u,
+    "IPA register block must be wrapper 0x3e00000 + cfg offset 0x140000");
+_Static_assert(K60_GSI_BASE == 0x03e04000u,
+    "GSI view must match the live DT gsi-base");
+_Static_assert(K60_IPA_VERSION_ADDR == 0x03f40028u,
+    "IPA_VERSION must be the IPA register block plus 0x28");
+_Static_assert(K60_IPA_IRQ == 654u && K60_GSI_IRQ == 432u,
+    "IPA/GSI GIC interrupts must match the live DT");
+_Static_assert(K60_IPA_PAS_ID == 15u,
+    "IPA firmware uses PAS id 15 on this board");
+_Static_assert(K60_IPA_METADATA_BASE + K60_IPA_METADATA_BYTES ==
+    K60_IPA_FW_REGION_BASE + K60_IPA_FW_REGION_BYTES,
+    "IPA metadata must be the last 8 KiB of the 64 KiB firmware region");
+
+const char k60_ipa_marker[] = "K60IPA M1 staging linked";
+
+K60IpaVersion
+k60_ipa_decode_comp_hw_version(uint32_t raw)
+{
+    K60IpaVersion version;
+
+    version.raw = raw;
+    version.major = (raw & 0xf0000000u) >> 28;
+    version.minor = (raw & 0x0fff0000u) >> 16;
+    version.step = raw & 0x0000ffffu;
+    return version;
+}
+
+int
+k60_ipa_firmware_check(const void *blob, uint64_t size, K60IpaFirmwarePlan *plan)
+{
+    K60MdtImage image;
+    uint32_t load = 0;
+    int rc;
+
+    if (!blob || !plan) {
+        return K60IpaBadArgument;
+    }
+    rc = k60_mdt_parse(&image, size, k60_ipa_blob_read, (void *)blob);
+    if (rc != K60MdtOk) {
+        return K60IpaFirmwareBadImage;
+    }
+    for (uint32_t i = 0; i < image.count; i++) {
+        if (image.segment[i].load) {
+            load++;
+        }
+    }
+    plan->span = k60_mdt_span(&image);
+    plan->metadata = k60_mdt_metadata_size(&image);
+    plan->load_segments = load;
+    plan->relocatable = image.relocatable;
+    if (image.elf64 || !image.relocatable || image.min_address != 0 ||
+        plan->span > K60_IPA_FW_REGION_BYTES ||
+        plan->metadata > K60_IPA_METADATA_BYTES) {
+        return K60IpaFirmwareLayout;
+    }
+    return K60IpaOk;
+}
+
+int
+k60_ipa_firmware_stage(const void *blob, uint64_t size, void *region,
+    uint64_t region_size, void *metadata, uint64_t metadata_size,
+    K60IpaFirmwarePlan *plan)
+{
+    K60MdtImage image;
+    K60IpaFirmwarePlan local;
+    int rc;
+
+    if (!blob || !region || !metadata) {
+        return K60IpaBadArgument;
+    }
+    rc = k60_ipa_firmware_check(blob, size, &local);
+    if (rc != K60IpaOk) {
+        return rc;
+    }
+    if (region_size < local.span) {
+        return K60IpaFirmwareTooLarge;
+    }
+    if (metadata_size < local.metadata) {
+        return K60IpaFirmwareTooLarge;
+    }
+    rc = k60_mdt_parse(&image, size, k60_ipa_blob_read, (void *)blob);
+    if (rc != K60MdtOk) {
+        return K60IpaFirmwareBadImage;
+    }
+    memset(region, 0, (size_t)region_size);
+    for (uint32_t i = 0; i < image.count; i++) {
+        const K60MdtSegment *s = &image.segment[i];
+        uint64_t offset;
+
+        if (!s->load) {
+            continue;
+        }
+        rc = k60_mdt_place(&image, i, K60_IPA_FW_REGION_BASE, region_size,
+            &offset);
+        if (rc != K60MdtOk) {
+            return K60IpaFirmwareLayout;
+        }
+        memcpy((uint8_t *)region + offset,
+            (const uint8_t *)blob + s->file_offset, (size_t)s->file_size);
+        if (s->memory_size > s->file_size) {
+            memset((uint8_t *)region + offset + s->file_size, 0,
+                (size_t)(s->memory_size - s->file_size));
+        }
+    }
+    rc = k60_mdt_metadata(&image, k60_ipa_blob_read, (void *)blob,
+        metadata, metadata_size);
+    if (rc != K60MdtOk) {
+        return K60IpaFirmwareLayout;
+    }
+    if (plan) {
+        *plan = local;
+    }
+    return K60IpaOk;
+}
+
+#ifndef K60_HOST_TEST
+static int
+k60_ipa_scm_call(uint32_t fn, uint32_t arginfo, uint64_t a, uint64_t b,
+    uint64_t c, uint64_t *rx0, uint64_t *rx1)
+{
+    register uint64_t x0 __asm__("x0") = fn;
+    register uint64_t x1 __asm__("x1") = arginfo;
+    register uint64_t x2 __asm__("x2") = a;
+    register uint64_t x3 __asm__("x3") = b;
+    register uint64_t x4 __asm__("x4") = c;
+    register uint64_t x5 __asm__("x5") = 0;
+    register uint64_t x6 __asm__("x6") = 0;
+    register uint64_t x7 __asm__("x7") = 0;
+
+    __asm__ volatile("smc #0"
+        : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+        : "r"(x4), "r"(x5), "r"(x6), "r"(x7)
+        : "memory");
+
+    *rx0 = x0;
+    *rx1 = x1;
+    return k60_modem_scm_ok(x0, x1) ? K60IpaOk : K60IpaPasDenied;
+}
+
+static int
+k60_ipa_pas_call(uint32_t cmd, uint32_t arginfo, uint64_t a, uint64_t b,
+    uint64_t c)
+{
+    uint64_t x0 = 0, x1 = 0;
+    int rc = k60_ipa_scm_call(k60_modem_scm_fn(K60M_SCM_SVC_PIL, cmd),
+        arginfo, a, b, c, &x0, &x1);
+
+    if (rc != K60IpaOk) {
+        printf("K60IPA scm cmd=%#x rc=%d x0=%#llx x1=%#llx\n", cmd, rc,
+            (unsigned long long)x0, (unsigned long long)x1);
+    }
+    return rc;
+}
+
+int
+k60_ipa_firmware_start(const void *blob, uint64_t size)
+{
+    K60IpaFirmwarePlan plan;
+    vm_offset_t firmware, metadata;
+    int rc;
+
+    if (!blob) {
+        return K60IpaBadArgument;
+    }
+    rc = k60_ipa_firmware_check(blob, size, &plan);
+    if (rc != K60IpaOk) {
+        printf("K60IPA firmware check failed rc=%d size=%llu\n", rc,
+            (unsigned long long)size);
+        return rc;
+    }
+    printf("K60IPA firmware plan span=%#llx metadata=%#llx loads=%u\n",
+        (unsigned long long)plan.span, (unsigned long long)plan.metadata,
+        plan.load_segments);
+    /* Both IPA regions are DDR carveouts, not device memory: use the same
+     * VM_WIMG_DEFAULT flag K60ModemBoot and K60AdspBoot use. */
+    firmware = ml_io_map_unmappable((vm_offset_t)K60_IPA_FW_REGION_BASE,
+        (vm_size_t)K60_IPA_FW_REGION_BYTES, 0x2);
+    if (firmware == 0) {
+        printf("K60IPA cannot map firmware region %#x\n",
+            K60_IPA_FW_REGION_BASE);
+        return K60IpaMapFailed;
+    }
+    metadata = ml_io_map_unmappable((vm_offset_t)K60_IPA_METADATA_BASE,
+        (vm_size_t)K60_IPA_METADATA_BYTES, 0x2);
+    if (metadata == 0) {
+        printf("K60IPA cannot map metadata region %#x\n",
+            K60_IPA_METADATA_BASE);
+        return K60IpaMapFailed;
+    }
+    rc = k60_ipa_firmware_stage(blob, size, (void *)firmware,
+        K60_IPA_FW_REGION_BYTES, (void *)metadata, K60_IPA_METADATA_BYTES,
+        &plan);
+    if (rc != K60IpaOk) {
+        printf("K60IPA firmware stage failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA firmware staged at %#x metadata=%#x\n",
+        K60_IPA_FW_REGION_BASE, K60_IPA_METADATA_BASE);
+    rc = k60_ipa_pas_call(K60M_SCM_PAS_INIT_IMAGE,
+        k60_modem_scm_args(2, K60M_SCM_VAL, K60M_SCM_RW, 0),
+        K60_IPA_PAS_ID, K60_IPA_METADATA_BASE, 0);
+    if (rc != K60IpaOk) {
+        printf("K60IPA init_image failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA init_image ok\n");
+    rc = k60_ipa_pas_call(K60M_SCM_PAS_MEM_SETUP,
+        k60_modem_scm_args(3, 0, 0, 0), K60_IPA_PAS_ID,
+        K60_IPA_FW_REGION_BASE, plan.span);
+    if (rc != K60IpaOk) {
+        printf("K60IPA mem_setup failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA mem_setup ok base=%#x span=%#llx\n",
+        K60_IPA_FW_REGION_BASE, (unsigned long long)plan.span);
+    rc = k60_ipa_pas_call(K60M_SCM_PAS_AUTH_AND_RESET,
+        k60_modem_scm_args(1, 0, 0, 0), K60_IPA_PAS_ID, 0, 0);
+    if (rc != K60IpaOk) {
+        printf("K60IPA auth_and_reset failed rc=%d\n", rc);
+        return rc;
+    }
+    printf("K60IPA auth_and_reset ok\n");
+    {
+        volatile uint8_t *cfg = (volatile uint8_t *)(uintptr_t)
+            ml_io_map_unmappable((vm_offset_t)K60_IPA_CFG_BASE, 0x1000, 0x7);
+        uint32_t version, comp;
+
+        if (cfg == NULL) {
+            printf("K60IPA cannot map cfg page %#x\n", K60_IPA_CFG_BASE);
+            return K60IpaMapFailed;
+        }
+        version = *(volatile uint32_t *)(cfg + K60_IPA_VERSION_REG);
+        comp = *(volatile uint32_t *)(cfg + K60_IPA_COMP_HW_VERSION_REG);
+        printf("K60IPA version=%#x comp=%#x\n", version, comp);
+        if (version == 0 || version == 0xffffffffu) {
+            printf("K60IPA IPAREADY not set\n");
+            return K60IpaNotReady;
+        }
+    }
+    return K60IpaOk;
+}
+#else /* K60_HOST_TEST */
+int
+k60_ipa_firmware_start(const void *blob, uint64_t size)
+{
+    (void)blob;
+    (void)size;
+    return K60IpaNotReady;
+}
+#endif /* K60_HOST_TEST */
+
+int
+k60_ipa_probe(void)
+{
+    printf("K60IPA probe: cfg=0x%x gsi=0x%x irq=%u/%u state=not-ready\n",
+        K60_IPA_CFG_BASE, K60_GSI_BASE, K60_IPA_IRQ, K60_GSI_IRQ);
+    return K60IpaNotReady;
+}
diff --git a/bsd/dev/pong_mdt.h b/bsd/dev/pong_mdt.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_mdt.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Ported from pong-power QcomMdt.h, Copyright (c) 2026 UniXNU contributors,
+ * SPDX-License-Identifier: BSD-2-Clause-Patent. Renamed to the K60 namespace.
+ *
+ * Qualcomm signed firmware images (.mbn, an ELF32 or ELF64 whose program headers carry the segment types in p_flags) as the peripheral
+ * authentication service takes them: the metadata handed to the secure world (the ELF and program headers followed by the hash
+ * segment), the extent of the loadable segments and where each one goes in the carveout. Pure parsing over a read callback: no
+ * allocation, no hardware, so the same code runs in the kernel and in the host tests. */
+#ifndef K60_MDT_H
+#define K60_MDT_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define K60_MDT_MAX_SEGMENTS 64u
+#define K60_MDT_TYPE_MASK (7u << 24)
+#define K60_MDT_TYPE_HASH (2u << 24)
+#define K60_MDT_RELOCATABLE (1u << 27)
+
+/* Reads length bytes at offset of the image file into to; returns 0 on success. */
+typedef int (*K60MdtRead)(void *context, uint64_t offset, void *to, size_t length);
+
+typedef struct {
+    uint64_t file_offset, file_size, memory_size, address;  /* address: p_paddr */
+    uint32_t flags;
+    uint8_t load;  /* a loadable segment (PT_LOAD, not the hash, memory size not zero) */
+} K60MdtSegment;
+
+typedef struct {
+    uint8_t elf64;
+    uint32_t count;
+    K60MdtSegment segment[K60_MDT_MAX_SEGMENTS];
+    int hash;                        /* index of the hash segment */
+    uint64_t header_size;            /* p_filesz of the first program header: ELF header plus program headers */
+    uint64_t min_address, max_address;  /* of the loadable segments */
+    uint8_t relocatable;
+    uint64_t file_size;
+} K60MdtImage;
+
+enum {
+    K60MdtOk = 0,
+    K60MdtReadError = -1,
+    K60MdtNotElf = -2,
+    K60MdtBadHeaders = -3,
+    K60MdtNoHash = -4,
+    K60MdtTooMany = -5,
+    K60MdtNoSegments = -6,
+    K60MdtOutside = -7,
+    K60MdtTooSmall = -8,
+};
+
+/* Parses the ELF and program headers of an image of file_size bytes. */
+int k60_mdt_parse(K60MdtImage *image, uint64_t file_size, K60MdtRead read, void *context);
+
+/* Bytes of the metadata blob for the authentication service: the header part and the hash segment. */
+uint64_t k60_mdt_metadata_size(const K60MdtImage *image);
+
+/* Writes the metadata blob (k60_mdt_metadata_size bytes) to to. The hash segment must lie inside the file: images split into .bNN
+ * files are joined into one .mbn on the host before they are installed. */
+int k60_mdt_metadata(const K60MdtImage *image, K60MdtRead read, void *context, uint8_t *to, uint64_t capacity);
+
+/* Bytes the loadable segments span (the end rounded up to 4 KiB, minus the lowest address): the size to hand to the memory setup call
+ * of a relocatable image. */
+uint64_t k60_mdt_span(const K60MdtImage *image);
+
+/* Offset of a loadable segment inside a carveout of region_size bytes at region_base: relocatable images are placed by their offset from
+ * the lowest segment, fixed ones by their address. Returns K60MdtOutside if the segment does not fit. */
+int k60_mdt_place(const K60MdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset);
+
+/* A split image (NAME.b00, NAME.b01, ... as found on the device's firmware partition) read as the joined image: the bytes of program
+ * header i's segment come from piece i (NAME.bNN) at the segment's file offset, piece 0 being the ELF and program headers; whatever
+ * lies between the pieces reads as zero. The pieces are the caller's files. */
+typedef int (*K60MdtPieceRead)(void *context, unsigned piece, uint64_t offset, void *to, size_t length);
+typedef struct {
+    uint32_t count;
+    struct {uint64_t offset, size;} piece[K60_MDT_MAX_SEGMENTS];  /* size 0: no piece file for this header */
+    uint64_t size;                                                  /* bytes of the joined image */
+} K60MdtSplit;
+
+/* Lays out the pieces from the headers (the bytes of NAME.b00, or the start of NAME.mdt). */
+int k60_mdt_split(K60MdtSplit *split, const uint8_t *headers, size_t length);
+/* Reads a range of the joined image. */
+int k60_mdt_split_read(const K60MdtSplit *split, K60MdtPieceRead read, void *context, uint64_t offset, void *to, size_t length);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/pong_mdt.c b/bsd/dev/pong_mdt.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/pong_mdt.c
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Ported from pong-power QcomMdt.c, Copyright (c) 2026 UniXNU contributors. */
+#include "pong_mdt.h"
+
+#define PT_LOAD_ 1u
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static uint64_t le64(const uint8_t *p) {return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+
+int k60_mdt_parse(K60MdtImage *image, uint64_t file_size, K60MdtRead read, void *context)
+{
+    uint8_t e[64];
+    if (!image || !read) return K60MdtReadError;
+    *image = (K60MdtImage){0};
+    image->hash = -1;
+    image->file_size = file_size;
+    if (file_size < 52 || read(context, 0, e, file_size < 64 ? 52 : 64)) return file_size < 52 ? K60MdtTooSmall : K60MdtReadError;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 /* little endian */) return K60MdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (!elf64 && e[4] != 1) return K60MdtNotElf;
+    if (elf64 && file_size < 64) return K60MdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return K60MdtBadHeaders;
+    if (phnum > K60_MDT_MAX_SEGMENTS) return K60MdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, file_size)) return K60MdtBadHeaders;
+    image->elf64 = (uint8_t)elf64;
+    image->count = phnum;
+    uint64_t lo = UINT64_MAX, hi = 0;
+    for (unsigned i = 0; i < phnum; ++i) {
+        uint8_t p[56];
+        if (read(context, phoff + (uint64_t)i * phentsize, p, phentsize)) return K60MdtReadError;
+        K60MdtSegment *s = &image->segment[i];
+        const uint32_t type = le32(p);
+        if (elf64) {
+            s->flags = le32(p + 4); s->file_offset = le64(p + 8); s->address = le64(p + 24);
+            s->file_size = le64(p + 32); s->memory_size = le64(p + 40);
+        } else {
+            s->file_offset = le32(p + 4); s->address = le32(p + 12); s->file_size = le32(p + 16);
+            s->memory_size = le32(p + 20); s->flags = le32(p + 24);
+        }
+        if ((s->flags & K60_MDT_TYPE_MASK) == K60_MDT_TYPE_HASH) {
+            if (image->hash < 0) image->hash = (int)i;
+            continue;
+        }
+        if (type != PT_LOAD_ || !s->memory_size) continue;
+        if (s->file_size > s->memory_size) return K60MdtBadHeaders;
+        if (s->address + s->memory_size < s->address) return K60MdtBadHeaders;
+        s->load = 1;
+        if (s->flags & K60_MDT_RELOCATABLE) image->relocatable = 1;
+        if (s->address < lo) lo = s->address;
+        if (s->address + s->memory_size > hi) hi = s->address + s->memory_size;
+    }
+    if (image->hash < 0) return K60MdtNoHash;
+    if (hi == 0) return K60MdtNoSegments;
+    image->header_size = image->segment[0].file_size;
+    /* The first program header (PT_NULL) covers the ELF header and the program headers themselves. */
+    if (!image->header_size || !fits(0, image->header_size, file_size) || image->header_size < phoff + (uint64_t)phentsize * phnum)
+        return K60MdtBadHeaders;
+    image->min_address = lo;
+    image->max_address = hi;
+    return K60MdtOk;
+}
+
+uint64_t k60_mdt_metadata_size(const K60MdtImage *image)
+{
+    return image->header_size + image->segment[image->hash].file_size;
+}
+
+int k60_mdt_metadata(const K60MdtImage *image, K60MdtRead read, void *context, uint8_t *to, uint64_t capacity)
+{
+    const K60MdtSegment *hash = &image->segment[image->hash];
+    if (capacity < k60_mdt_metadata_size(image)) return K60MdtTooSmall;
+    uint64_t hash_offset;
+    /* A hash packed right behind the headers (the split .mdt form) or a hash segment inside the file. */
+    if (image->header_size + hash->file_size == image->file_size) hash_offset = image->header_size;
+    else if (fits(hash->file_offset, hash->file_size, image->file_size)) hash_offset = hash->file_offset;
+    else return K60MdtOutside;
+    if (read(context, 0, to, (size_t)image->header_size)) return K60MdtReadError;
+    if (read(context, hash_offset, to + image->header_size, (size_t)hash->file_size)) return K60MdtReadError;
+    return K60MdtOk;
+}
+
+/* The secure world takes the span with its end rounded up to a 4 KiB page and refuses an unaligned one. */
+uint64_t k60_mdt_span(const K60MdtImage *image) {return ((image->max_address + 0xfff) & ~0xfffull) - image->min_address;}
+
+int k60_mdt_place(const K60MdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset)
+{
+    if (index >= image->count || !image->segment[index].load) return K60MdtOutside;
+    const K60MdtSegment *s = &image->segment[index];
+    uint64_t at;
+    if (image->relocatable) at = s->address - image->min_address;
+    else if (s->address >= region_base) at = s->address - region_base;
+    else return K60MdtOutside;
+    if (!fits(at, s->memory_size, region_size)) return K60MdtOutside;
+    if (s->file_size && !fits(s->file_offset, s->file_size, image->file_size)) return K60MdtOutside;
+    *offset = at;
+    return K60MdtOk;
+}
+
+int k60_mdt_split(K60MdtSplit *split, const uint8_t *headers, size_t length)
+{
+    if (!split || !headers) return K60MdtReadError;
+    *split = (K60MdtSplit){0};
+    if (length < 52) return K60MdtTooSmall;
+    const uint8_t *e = headers;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 || (e[4] != 1 && e[4] != 2)) return K60MdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (elf64 && length < 64) return K60MdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return K60MdtBadHeaders;
+    if (phnum > K60_MDT_MAX_SEGMENTS) return K60MdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, length)) return K60MdtBadHeaders;
+    split->count = phnum;
+    for (unsigned i = 0; i < phnum; ++i) {
+        const uint8_t *p = e + phoff + (uint64_t)i * phentsize;
+        const uint64_t offset = elf64 ? le64(p + 8) : le32(p + 4), size = elf64 ? le64(p + 32) : le32(p + 16);
+        if (offset + size < offset) return K60MdtBadHeaders;
+        split->piece[i].offset = offset;
+        split->piece[i].size = size;
+        if (size && offset + size > split->size) split->size = offset + size;
+    }
+    /* piece 0 must be the headers themselves */
+    if (split->piece[0].offset || split->piece[0].size < phoff + (uint64_t)phentsize * phnum) return K60MdtBadHeaders;
+    return K60MdtOk;
+}
+
+int k60_mdt_split_read(const K60MdtSplit *split, K60MdtPieceRead read, void *context, uint64_t offset, void *to, size_t length)
+{
+    uint8_t *out = to;
+    if (!split || !read || !to || !fits(offset, length, split->size)) return K60MdtOutside;
+    while (length) {
+        /* the piece holding offset, or else the distance to the next piece */
+        uint64_t take = length, gap_end = split->size;
+        int hit = -1;
+        for (unsigned i = 0; i < split->count; ++i) {
+            const uint64_t at = split->piece[i].offset, size = split->piece[i].size;
+            if (!size) continue;
+            if (offset >= at && offset - at < size) {hit = (int)i; break;}
+            if (at > offset && at < gap_end) gap_end = at;
+        }
+        if (hit >= 0) {
+            const uint64_t left = split->piece[hit].offset + split->piece[hit].size - offset;
+            if (take > left) take = left;
+            if (read(context, (unsigned)hit, offset - split->piece[hit].offset, out, (size_t)take)) return K60MdtReadError;
+        } else {
+            if (take > gap_end - offset) take = gap_end - offset;
+            for (uint64_t i = 0; i < take; ++i) out[i] = 0;
+        }
+        out += take;
+        offset += take;
+        length -= (size_t)take;
+    }
+    return K60MdtOk;
+}
