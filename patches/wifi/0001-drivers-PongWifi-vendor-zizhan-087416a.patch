+ const unsigned version=pmicCore.r(0);pmicChannels=pmicCore.r(4)&0x7ff;
+ if(version<0x70000000||version>=0x80000000||!pmicChannels||pmicChannels>1024)return fail("incompatible Pong SPMI observer");
