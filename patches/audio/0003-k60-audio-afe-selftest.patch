+static uint64_t
+pong_audio_le64(const uint8_t *bytes)
+{
+	uint64_t value = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		value |= (uint64_t)bytes[i] << (8u * i);
+	}
+	return value;
+}
+
+extern uint64_t kvtophys(vm_offset_t va);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+
+static bool
+pong_audio_dma_lease(void)
+{
+	DTEntry chosen;
+	void const *property = NULL;
+	unsigned int size = 0;
+	uint64_t pa = 0;
+	uint64_t bytes = PONG_AUDIO_DMA_BYTES;
+
+	if (g_pong_audio.dma_pa != 0) {
+		return true;
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "pong-audio-dma", &property, &size) == kSuccess &&
+	    size == 16u) {
+		const uint8_t *value = (const uint8_t *)property;
+		pa = pong_audio_le64(value);
+		bytes = pong_audio_le64(value + 8);
+		if (bytes != PONG_AUDIO_DMA_BYTES || (pa & 0xfffu) != 0u ||
+		    pa > 0x100000000ULL - bytes) {
+			printf("PongAudio: low DMA lease invalid pa=0x%llx size=0x%llx; allocating below 4 GiB\n",
+			    (unsigned long long)pa, (unsigned long long)bytes);
+			pa = 0;
+			bytes = PONG_AUDIO_DMA_BYTES;
+		}
+		if (pa != 0) {
+			vm_offset_t va = ml_io_map_wcomb((vm_offset_t)pa,
+			    (vm_size_t)bytes);
+			if (va == 0) {
+				printf("PongAudio: low DMA map failed pa=0x%llx size=0x%llx: %s\n",
+				    (unsigned long long)pa, (unsigned long long)bytes,
+				    pong_audio_error_name(PongAudioErrNoHandoff));
+				return false;
+			}
+			g_pong_audio.dma_pa = pa;
+			g_pong_audio.dma_size = (uint32_t)bytes;
+			g_pong_audio.dma_va = va;
+			printf("PongAudio: low DMA lease pa=0x%llx size=0x%x\n",
+			    (unsigned long long)pa, (unsigned)g_pong_audio.dma_size);
+			return true;
+		}
+	}
+	/* The loader lease is optional: allocate the same 64 KiB below 4 GiB.
+	 * Map it write-combined: the DSP reads the slots directly, so a cached
+	 * mapping would go stale, yet the period copy is a memcpy and an I/O
+	 * mapping is only guaranteed to take 1/2/4/8-byte accesses. */
+	vm_offset_t alloc_va = 0;
+	kern_return_t kr = kmem_alloc_contig(kernel_map, &alloc_va, bytes,
+	    PAGE_MASK, (ppnum_t)(atop_64(0x100000000ULL - bytes)), 0,
+	    KMA_DATA | KMA_KOBJECT, VM_KERN_MEMORY_IOKIT);
+	if (kr == KERN_SUCCESS) {
+		pa = kvtophys(alloc_va);
+		if (pa != 0 && (pa & 0xfffu) == 0u &&
+		    pa <= 0x100000000ULL - bytes) {
+			vm_offset_t va = ml_io_map_wcomb((vm_offset_t)pa,
+			    (vm_size_t)bytes);
+			if (va != 0) {
+				g_pong_audio.dma_pa = pa;
+				g_pong_audio.dma_size = (uint32_t)bytes;
+				g_pong_audio.dma_va = va;
+				printf("PongAudio: low DMA allocated pa=0x%llx size=0x%x\n",
+				    (unsigned long long)pa, (unsigned)g_pong_audio.dma_size);
+				return true;
+			}
+		}
+		kmem_free(kernel_map, alloc_va, bytes);
+	}
+	printf("PongAudio: low DMA unavailable: %s\n",
+	    pong_audio_error_name(PongAudioErrNoHandoff));
+	return false;
+}
+
+/* The DSP reads the PCM slots itself: the graph hands it the loader lease as
+ * a plain physical address. Those pages belong to VMID_HLOS and the audio VMs
+ * have no mapping for them, so the DSP faults on the first fetch and the ADSP
+ * restarts. The stock audio stack lends the same pages to LPASS and ADSP_HEAP
+ * before the graph runs (msm_audio_ion.c, IOCTL_MAP_HYP_ASSIGN), so issue the
+ * same assign call here and keep HLOS in the list: the write side has to stay
+ * able to fill the periods. */
+#define PONG_SCM_ASSIGN_FNID	0x42000c16u
+#define PONG_SCM_ASSIGN_ARGS	0x1117u
+#define PONG_VMID_HLOS		0x03u
+#define PONG_VMID_LPASS		0x16u
+#define PONG_VMID_ADSP_HEAP	0x25u
+#define PONG_SCM_PERM_RW	0x6u
+
+struct pong_scm_mem_info {
+	uint64_t addr;
+	uint64_t size;
+};
+
+struct pong_scm_perm_info {
+	uint32_t vmid;
+	uint32_t perm;
+	uint64_t ctx;
+	uint32_t ctx_size;
+	uint32_t unused;
+};
+
+static uint8_t g_pong_scm_page[4096] __attribute__((aligned(4096)));
+
+static int
+pong_audio_scm_call5(uint32_t fn, uint32_t arginfo, uint64_t a, uint64_t b,
+    uint64_t c, uint64_t d, uint64_t *rx0, uint64_t *rx1)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = arginfo;
+	register uint64_t x2 __asm__("x2") = a;
+	register uint64_t x3 __asm__("x3") = b;
+	register uint64_t x4 __asm__("x4") = c;
+	register uint64_t x5 __asm__("x5") = d;
+	register uint64_t x6 __asm__("x6") = 0;
+	register uint64_t x7 __asm__("x7") = 0;
+
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5),
+	      "+r"(x6), "+r"(x7)
+	    :
+	    : "memory");
+	*rx0 = x0;
+	*rx1 = x1;
+	return (int)(x0 & 0xffffffffu);
+}
+
+/* The assign call takes seven arguments, but the monitor reads only the first
+ * four from x2..x5: with a longer descriptor x5 carries the physical address of
+ * a buffer holding args[3..9] instead. */
+static const uint32_t g_pong_scm_hlos_first[3] = { PONG_VMID_HLOS,
+	PONG_VMID_LPASS, PONG_VMID_ADSP_HEAP };
+
+/* The monitor refuses a destination list that contains HLOS next to the audio
+ * VMs: image bi tried five framings (HLOS first with read/write, with read/
+ * write/execute and with the audio VMs in read/write/execute; HLOS plus one
+ * audio VM) and every one came back rc=-2 with x1=0x56, while the list that
+ * leaves HLOS out was accepted. That accepted form is the one image bg proved
+ * the DSP can read, but it also takes the page away from the kernel, which then
+ * faults on the first store into the period.
+ *
+ * So ownership travels with the period instead of staying put: the slot is lent
+ * to LPASS and ADSP_HEAP just before its write command, and taken back to HLOS
+ * when the write-done answer arrives. One slot is in flight at a time, so the
+ * page being copied into is always one HLOS still owns. */
+
+static int
+pong_audio_scm_transfer(uint64_t pa, uint64_t bytes, const uint32_t *src_vmids,
+    unsigned src_count, const uint32_t *dst_vmids, const uint32_t *dst_perms,
+    unsigned dst_count, const char *label)
+{
+	struct pong_scm_mem_info *mem =
+	    (struct pong_scm_mem_info *)(void *)g_pong_scm_page;
+	uint32_t *src = (uint32_t *)(void *)(g_pong_scm_page + 0x040);
+	struct pong_scm_perm_info *dst =
+	    (struct pong_scm_perm_info *)(void *)(g_pong_scm_page + 0x080);
+	uint64_t *ext = (uint64_t *)(void *)(g_pong_scm_page + 0x100);
+	const uint64_t base = kvtophys((vm_offset_t)(uintptr_t)g_pong_scm_page);
+	uint64_t x0 = 0, x1 = 0;
+	unsigned i;
+	int rc;
+
+	if (base == 0) {
+		printf("PongAudio: SCM %s skipped: page not mapped\n", label);
+		return -1;
+	}
+	memset(g_pong_scm_page, 0, sizeof(g_pong_scm_page));
+	mem->addr = pa;
+	mem->size = bytes;
+	for (i = 0; i < src_count; i++) {
+		src[i] = src_vmids[i];
+	}
+	for (i = 0; i < dst_count; i++) {
+		dst[i].vmid = dst_vmids[i];
+		dst[i].perm = dst_perms[i];
+	}
+	ext[0] = (uint64_t)src_count * 4u;
+	ext[1] = base + 0x080u;
+	ext[2] = (uint64_t)dst_count * sizeof(*dst);
+	flush_dcache64((uint64_t)(uintptr_t)g_pong_scm_page,
+	    sizeof(g_pong_scm_page), 0);
+	printf("PongAudio: SCM %s begin pa=0x%llx bytes=0x%llx src=%u dst=%u\n",
+	    label, (unsigned long long)pa, (unsigned long long)bytes,
+	    src_count, dst_count);
+	rc = pong_audio_scm_call5(PONG_SCM_ASSIGN_FNID, PONG_SCM_ASSIGN_ARGS,
+	    base, 16u, base + 0x040u, base + 0x100u, &x0, &x1);
+	printf("PongAudio: SCM %s pa=0x%llx bytes=0x%llx rc=%d x0=0x%llx x1=0x%llx\n",
+	    label, (unsigned long long)pa, (unsigned long long)bytes, rc,
+	    (unsigned long long)x0, (unsigned long long)x1);
+	return rc;
+}
+
+static int
+pong_audio_scm_lend(uint64_t pa, uint64_t bytes)
+{
+	static const uint32_t src[1] = { PONG_VMID_HLOS };
+	static const uint32_t dst[2] = { PONG_VMID_LPASS, PONG_VMID_ADSP_HEAP };
+	static const uint32_t perms[2] = { PONG_SCM_PERM_RW, PONG_SCM_PERM_RW };
+
+	return pong_audio_scm_transfer(pa, bytes, src, 1u, dst, perms, 2u,
+	    "lend");
+}
+
+static int
+pong_audio_scm_reclaim(uint64_t pa, uint64_t bytes)
+{
+	static const uint32_t src[2] = { PONG_VMID_LPASS, PONG_VMID_ADSP_HEAP };
+	static const uint32_t dst[1] = { PONG_VMID_HLOS };
+	/* Read/write is all the copy needs; the stock unmap also grants
+	 * execute, which the next lend would carry as a source permission. */
+	static const uint32_t perms[1] = { PONG_SCM_PERM_RW };
+
+	return pong_audio_scm_transfer(pa, bytes, src, 2u, dst, perms, 1u,
+	    "reclaim");
+}
+
+static void
+pong_audio_play_reset(PongAudioState *state)
+{
+	state->play_started = false;
+	state->play_graph_ready = false;
+	state->playback_running = false;
+	state->play_speaker_started = false;
+	state->play_step = 0;
+	state->play_token = 0;
+	state->map_handle = 0;
+	state->write_token = 0;
+	state->inflight = 0;
+	state->playback_frames = 0;
+	for (unsigned i = 0; i < PONG_AUDIO_SLOTS; i++) {
+		state->slot_busy[i] = false;
+		state->slot_token[i] = 0;
+		state->slot_age[i] = 0;
+	}
+}
+
+static void
+pong_audio_play_reap_slots(PongAudioState *state)
+{
+	{
+		static unsigned reap_logs;
+		if (reap_logs < 6u) {
+			reap_logs++;
+			printf("PongAudio: PCM reap enter inflight=%u\n",
+			    state->inflight);
+		}
+	}
+	for (unsigned i = 0; i < PONG_AUDIO_SLOTS; i++) {
+		if (!state->slot_busy[i]) {
+			continue;
+		}
+		state->slot_age[i]++;
+		if (!pong_play_slot_expired(state->slot_age[i])) {
+			continue;
+		}
+		/* A timed-out period must go back to the HLOS before the next
+		 * memcpy touches the buffer, or that copy takes an external
+		 * abort the way image bg did. */
+		if (!g_pong_smmu_leased &&
+		    pong_audio_scm_reclaim(state->dma_pa,
+		    PONG_AUDIO_DMA_BYTES) != 0) {
+			printf("PongAudio: PCM slot %u timeout reclaim failed\n", i);
+		}
+		state->slot_busy[i] = false;
+		state->slot_token[i] = 0;
+		state->slot_age[i] = 0;
+		if (state->inflight != 0u) {
+			state->inflight--;
+		}
+		printf("PongAudio: PCM slot %u write timed out\n", i);
+	}
+	{
+		static unsigned reap_exit_logs;
+		if (reap_exit_logs < 6u) {
+			reap_exit_logs++;
+			printf("PongAudio: PCM reap exit inflight=%u\n",
+			    state->inflight);
+		}
+	}
+}
+
+static void
+pong_audio_ring_reset(void)
+{
+	pong_ring_queue_init(&g_pong_audio.ring, g_pong_audio.ring_storage,
+	    PONG_RING_FRAMES);
+	g_pong_audio.ring_ready = true;
+	g_pong_audio.ring_frames = 0;
+	g_pong_audio.ring_dropped = 0;
+	pong_audio_play_reset(&g_pong_audio);
+}
+
+static void
+pong_audio_play_send_step(PongAudioState *state, unsigned step)
+{
+	uint8_t packet[GPR_MAX_PACKET];
+	const uint32_t token = pong_play_token(step);
+	const uint32_t opcode = pong_play_opcode(step);
+	const PongArFormat format = { PONG_AUDIO_RATE, 32, 2 };
+	uint32_t bytes = 0;
+
+	switch (step) {
+	case PongPlayOpenSpeaker:
+		bytes = pong_ar_open_speaker_device(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token);
+		break;
+	case PongPlayConfigSpeaker:
+		bytes = pong_ar_config_speaker_device(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token, &format);
+		break;
+	case PongPlayOpenPlayback:
+		bytes = pong_ar_open_playback_stream(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token);
+		break;
+	case PongPlayConfigPlayback:
+		bytes = pong_ar_config_playback_stream(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token, &format);
+		break;
+	case PongPlayConfigShmem:
+		bytes = pong_ar_config_playback_shmem(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token, &format);
+		break;
+	case PongPlayMap:
+		bytes = pong_ar_map(packet, sizeof(packet), PONG_AUDIO_GPR_PORT,
+		    token, pong_play_dsp_address(state->dma_pa),
+		    PONG_AUDIO_DMA_BYTES);
+		break;
+	case PongPlayClock:
+		bytes = pong_ar_prm_clock(packet, sizeof(packet),
+		    AR_PRM_IID, token, PONG_AFE_CLOCK_TERT_TDM_IBIT,
+		    PONG_AUDIO_TDM_CLK_HZ);
+		break;
+	case PongPlayPrepareSpeaker:
+		bytes = pong_ar_graph_command(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token, AR_OP_GRAPH_PREPARE,
+		    AR_SG_SPEAKER);
+		break;
+	case PongPlayPreparePlayback:
+		bytes = pong_ar_graph_command(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token, AR_OP_GRAPH_PREPARE,
+		    AR_SG_PLAY);
+		break;
+	case PongPlayStartPair:
+		bytes = pong_ar_graph_start_pair(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token);
+		break;
+	case PongPlayStartSpeaker:
+		bytes = pong_ar_graph_command(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token, AR_OP_GRAPH_START,
+		    AR_SG_SPEAKER);
+		break;
+	case PongPlayStartPlayback:
+		bytes = pong_ar_graph_command(packet, sizeof(packet),
+		    PONG_AUDIO_GPR_PORT, token, AR_OP_GRAPH_START, AR_SG_PLAY);
+		break;
+	default:
+		break;
+	}
+	if (bytes == 0u) {
+		state->last_error = PongAudioErrPlayback;
+		printf("PongAudio: playback step %u encode failed\n", step);
+		return;
+	}
+	/* The DSP can answer before this call returns, so the expected step
+	 * and token must be published first. */
+	state->play_step = step;
+	state->play_token = token;
+	const int rc = k60_pmic_glink_send_audio(packet, bytes);
+	printf("PongAudio: playback step %u send bytes=%u opcode=0x%08x token=0x%08x rc=%d\n",
+	    step, bytes, opcode, token, rc);
+	if (rc == K60_PMIC_GLINK_AUDIO_OK) {
+		state->last_error = PongAudioOk;
+		return;
+	}
+	state->play_token = 0;
+	state->last_error = PongAudioErrPlayback;
+	printf("PongAudio: playback step %u refused rc=%d\n", step, rc);
+}
+
+/* Set once the zero byte probe has run: this image then never hands the DSP a
+ * real period, so a live machine here separates the write command from the
+ * memory the DSP would have to read. */
+static bool g_pong_probe_only;
+
+/* Set by pong_audio_smmu_lease(): once the audio stream reads physical
+ * addresses, the periods stay in HLOS memory and no ownership handoff is
+ * needed. Until then the per-period SCM lending stays as the fallback. */
+static bool g_pong_smmu_leased;
+
+static bool
+pong_audio_play_submit_slot(PongAudioState *state)
+{
+	uint8_t packet[GPR_MAX_PACKET];
+	unsigned slot = PONG_AUDIO_SLOTS;
+
+	if (!state->playback_running || state->map_handle == 0u ||
+	    state->dma_va == 0u) {
+		return false;
+	}
+	if (g_pong_probe_only) {
+		return false;
+	}
+	/* Flow control: four buffers in flight were enough to kill the machine,
+	 * so one stays outstanding until the DSP reports it is done with it. */
+	if (state->inflight >= 1u) {
+		return false;
+	}
+	for (unsigned i = 0; i < PONG_AUDIO_SLOTS; i++) {
+		if (!state->slot_busy[i]) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == PONG_AUDIO_SLOTS) {
+		{
+			static unsigned full_logs;
+			if (full_logs < 4u) {
+				full_logs++;
+				printf("PongAudio: PCM no idle slot\n");
+			}
+		}
+		return false;
+	}
+	if (pong_ring_queue_used(&state->ring) < PONG_AUDIO_PERIOD_FRAMES) {
+		{
+			static unsigned short_logs;
+			if (short_logs < 6u) {
+				short_logs++;
+				printf("PongAudio: PCM slot %u short used=%u\n", slot,
+				    (unsigned)pong_ring_queue_used(&state->ring));
+			}
+		}
+		return false;
+	}
+	/* Pong, the SM8475 device that plays through this same GPR port, tags
+	 * each transfer 0x10000000 | sequence, and the DSP sizes the transfer
+	 * from the buffer size field, so the token carries no length. */
+	state->write_token++;
+	const uint32_t token = 0x10000000u |
+	    (state->write_token & 0x0fffffffu);
+	const uint64_t address = pong_play_slot_address(state->dma_pa, slot);
+	const uint32_t bytes = pong_ar_write(packet, sizeof(packet),
+	    PONG_AUDIO_GPR_PORT, token, address, state->map_handle,
+	    PONG_AUDIO_PERIOD_BYTES);
+	if (bytes == 0u) {
+		state->last_error = PongAudioErrPlayback;
+		printf("PongAudio: PCM slot %u encode failed\n", slot);
+		return false;
+	}
+	const uint32_t got = pong_ring_queue_read(&state->ring, state->period,
+	    PONG_AUDIO_PERIOD_FRAMES);
+	if (got != PONG_AUDIO_PERIOD_FRAMES) {
+		printf("PongAudio: PCM slot %u read got=%u\n", slot, got);
+		return false;
+	}
+	if (state->playback_frames == 0u) {
+		printf("PongAudio: PCM slot %u copy begin va=0x%llx\n", slot,
+		    (unsigned long long)state->dma_va);
+	}
+	/* The DSP reads the period from the low-DMA slot, not from the ring. */
+	memcpy((void *)(state->dma_va +
+	    (uint64_t)slot * PONG_PLAY_PERIOD_BYTES), state->period,
+	    PONG_PLAY_PERIOD_BYTES);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (state->playback_frames == 0u) {
+		printf("PongAudio: PCM slot %u copy done\n", slot);
+	}
+	/* The DSP validates the whole mapping, not only the write address:
+	 * lending one slot left the rest of the 64 KiB region on the HLOS
+	 * side and the firmware died while answering the first period. */
+	if (!g_pong_smmu_leased &&
+	    pong_audio_scm_lend(state->dma_pa, PONG_AUDIO_DMA_BYTES) != 0) {
+		printf("PongAudio: PCM slot %u lend refused\n", slot);
+		return false;
+	}
+	printf("PongAudio: PCM slot %u send begin bytes=%u\n", slot, bytes);
+	const int rc = k60_pmic_glink_send_audio(packet, bytes);
+	if (rc != K60_PMIC_GLINK_AUDIO_OK) {
+		state->ring_dropped += PONG_AUDIO_PERIOD_FRAMES;
+		state->last_error = PongAudioErrPlayback;
+		printf("PongAudio: PCM slot %u refused rc=%d\n", slot, rc);
+		return false;
+	}
+	state->slot_busy[slot] = true;
+	state->slot_token[slot] = token;
+	state->slot_age[slot] = 0;
+	state->inflight++;
+	state->playback_frames += PONG_AUDIO_PERIOD_FRAMES;
+	printf("PongAudio: PCM slot %u submit bytes=%u token=0x%08x address=0x%llx\n",
+	    slot, bytes, token, (unsigned long long)address);
+	return true;
+}
+
+/* Before the first real period, send one write whose buffer size is zero.
+ * The DSP then answers, refuses or dies without reading the buffer, which
+ * separates a command-path failure from a memory-access failure. */
+static void
+pong_audio_play_probe_zero(PongAudioState *state)
+{
+	uint8_t packet[GPR_MAX_PACKET];
+	const uint32_t token = 0x10000000u;
+	const uint64_t address = pong_play_slot_address(state->dma_pa, 0u);
+	const uint32_t bytes = pong_ar_write(packet, sizeof(packet),
+	    PONG_AUDIO_GPR_PORT, token, address, state->map_handle, 0u);
+
+	if (bytes == 0u) {
+		printf("PongAudio: PCM zero-byte probe encode failed\n");
+		return;
+	}
+	if (!g_pong_smmu_leased &&
+	    pong_audio_scm_lend(state->dma_pa, PONG_AUDIO_DMA_BYTES) != 0) {
+		printf("PongAudio: PCM zero-byte probe lend refused\n");
+		return;
+	}
+	printf("PongAudio: PCM zero-byte probe send bytes=%u address=0x%llx\n",
+	    bytes, (unsigned long long)address);
+	const int rc = k60_pmic_glink_send_audio(packet, bytes);
+	if (rc == 0) {
+		/* Book the probe like a real period so the write-done answer
+		 * finds slot 0 and proves the completion path end to end. */
+		state->slot_busy[0] = true;
+		state->slot_token[0] = token;
+		state->slot_age[0] = 0;
+		state->inflight++;
+	}
+	printf("PongAudio: PCM zero-byte probe rc=%d inflight=%u\n", rc,
+	    state->inflight);
+}
+
+static void
+pong_audio_play_begin_stream(PongAudioState *state)
+{
+	unsigned primed = 0;
+
+	while (primed < PONG_PLAY_PRIME_SLOTS &&
+	    pong_audio_play_submit_slot(state)) {
+		primed++;
+	}
+	printf("PongAudio: playback stream primed slots=%u inflight=%u\n",
+	    primed, state->inflight);
+}
+
+static void
+pong_audio_play_complete_step(PongAudioState *state)
+{
+	if (state->play_step == (unsigned)PongPlayStartSpeaker) {
+		state->play_speaker_started = true;
+	}
+	if (state->play_step == (unsigned)PongPlayStartPair) {
+		state->play_speaker_started = true;
+		state->playback_running = true;
+		state->last_error = PongAudioOk;
+		printf("PongAudio: playback and speaker started in one command; PCM streaming\n");
+		return;
+	}
+	if (state->play_step == (unsigned)PongPlayPreparePlayback) {
+		/* The av image sent both graphs in one command, was refused with
+		 * status 1, and then had both singles accepted: the pair still
+		 * left the TDM speaker running. Repeat that order here. */
+		printf("PongAudio: pair START follows the playback prepare\n");
+		pong_audio_play_send_step(state, PongPlayStartPair);
+		return;
+	}
+	if (state->play_step == (unsigned)PongPlayClock) {
+		state->play_graph_ready = true;
+		state->last_error = PongAudioOk;
+		printf("PongAudio: playback graph mapped; waiting for PCM lead\n");
+		return;
+	}
+	if (state->play_step + 1u >= (unsigned)PongPlayStepCount) {
+		/* Run the playback graph without speaker START so this probe can
+		 * distinguish slot-submission failure from a TDM speaker failure;
+		 * whether the DSP consumes these slots is the observation. */
+		state->playback_running = true;
+		state->last_error = PongAudioOk;
+		if (state->play_speaker_started) {
+			printf("PongAudio: playback graph started; PCM streaming\n");
+		} else {
+			printf("PongAudio: playback graph started without the speaker; streaming the slots anyway\n");
+		}
+		/* Both graphs now run, so the TDM interface supplies the bit clock the
+		 * amplifiers lock their PLL to; unmute them here, once. */
+		if (state->play_speaker_started) {
+			extern int pong_audio_amp_play(void);
+			(void)pong_audio_amp_play();
+		}
+		/* Probe the command path before the first real period: a zero byte
+		 * write never touches the buffer, so an answer here separates the
+		 * write command from the memory the DSP has to read. */
+		pong_audio_play_probe_zero(state);
+		/* The probe answered, so the write path is alive; the real
+		 * periods follow through the leased page group. */
+		printf("PongAudio: zero-byte probe answered; streaming real slots\n");
+		return;
+	}
+	pong_audio_play_send_step(state, state->play_step + 1u);
+}
+
+static void
+pong_audio_play_start(PongAudioState *state)
+{
+	if (state->play_started) {
+		return;
+	}
+	state->play_started = true;
+	printf("PongAudio: playback graph opening after AFE\n");
+	pong_audio_play_send_step(state, PongPlayOpenSpeaker);
+}
+
+static bool
+pong_audio_play_receive(PongAudioState *state, int kind, const PongArAnswer *answer)
+{
+	static unsigned play_skips;
+
+	if (kind == PongArMapped) {
+		if (answer->token != state->play_token ||
+		    state->play_step != (unsigned)PongPlayMap) {
+			return false;
+		}
+		state->map_handle = answer->handle;
+		printf("PongAudio: playback map done handle=0x%x\n", answer->handle);
+		pong_audio_play_complete_step(state);
+		return true;
+	}
+	if (kind == PongArPrmDone) {
+		if (answer->token != state->play_token ||
+		    state->play_step != (unsigned)PongPlayClock) {
+			return false;
+		}
+		if (answer->status != 0u) {
+			state->last_error = PongAudioErrPlayback;
+			printf("PongAudio: playback clock refused status=%u\n",
+			    answer->status);
+			return true;
+		}
+		pong_audio_play_complete_step(state);
+		return true;
+	}
+	if (kind == PongArBasicResult) {
+		if (answer->token != state->play_token) {
+			return false;
+		}
+		if (answer->result_opcode != pong_play_opcode(state->play_step) ||
+		    answer->status != 0u) {
+			state->last_error = PongAudioErrPlayback;
+			printf("PongAudio: playback step %u refused opcode=0x%08x status=%u\n",
+			    state->play_step, answer->result_opcode, answer->status);
+			if (state->play_step == (unsigned)PongPlayStartSpeaker) {
+				printf("PongAudio: speaker graph refused; the graph will not be streamed\n");
+			}
+			if (play_skips < 11u) {
+				play_skips++;
+				if (state->play_step == (unsigned)PongPlayClock) {
+					state->play_graph_ready = true;
+				}
+				printf("PongAudio: playback step %u skipped, continuing\n",
+				    state->play_step);
+				if (state->play_step + 1u < (unsigned)PongPlayStepCount) {
+					pong_audio_play_send_step(state, state->play_step + 1u);
+				} else {
+					pong_audio_play_complete_step(state);
+				}
+			}
+			return true;
+		}
+		pong_audio_play_complete_step(state);
+		return true;
+	}
+	if (kind == PongArWriteDone) {
+		unsigned slot = PONG_AUDIO_SLOTS;
+
+		if (answer->handle != state->map_handle) {
+			return false;
+		}
+		for (unsigned i = 0; i < PONG_AUDIO_SLOTS; i++) {
+			if (state->slot_busy[i] &&
+			    answer->address ==
+			    pong_play_slot_address(state->dma_pa, i)) {
+				slot = i;
+				break;
+			}
+		}
+		if (slot == PONG_AUDIO_SLOTS) {
+			printf("PongAudio: PCM write done for an unknown slot address=0x%llx\n",
+			    (unsigned long long)answer->address);
+			return true;
+		}
+		if (!g_pong_smmu_leased &&
+		    pong_audio_scm_reclaim(state->dma_pa,
+		    PONG_AUDIO_DMA_BYTES) != 0) {
+			printf("PongAudio: PCM slot %u reclaim failed\n", slot);
+		}
+		state->slot_busy[slot] = false;
+		state->slot_token[slot] = 0;
+		state->slot_age[slot] = 0;
+		if (state->inflight != 0u) {
+			state->inflight--;
+		}
+		if (answer->status != 0u) {
+			state->last_error = PongAudioErrPlayback;
+			printf("PongAudio: PCM slot %u write status=%u\n", slot,
+			    answer->status);
+		}
+		printf("PongAudio: PCM write done slot=%u address=0x%llx\n", slot,
+		    (unsigned long long)answer->address);
+		return true;
+	}
+	return false;
+}
+
+/* The audio buffer reaches the DSP through the apps SMMU, which aborts every
+ * stream it has no entry for. Before the first write, report how this kernel
+ * routed the audio stream ids so a silent ADSP reset can be attributed. The
+ * registers, the SMR array at 0x800 and the S2CR array at 0xc00 all fit in one
+ * 4 KiB page, which matters: the io_submap budget is nearly spent and running
+ * out of it panics before the console appears (P-63). */
+static bool g_pong_smmu_audited;
+
+static void
+pong_audio_smmu_audit(void)
+{
+	static const uint16_t audio_streams[] = { 0x1800u, 0x1801u, 0x1001u };
+	const uint32_t base = 0x15000000u;	/* apps SMMU, as the UFS takeover uses */
+	volatile uint32_t *r;
+
+	if (g_pong_smmu_audited) {
+		return;
+	}
+	g_pong_smmu_audited = true;
+	r = (volatile uint32_t *)ml_io_map(base, 0x1000);
+	if (r == NULL) {
+		printf("PongAudio: SMMU audit map failed\n");
+		return;
+	}
+	const uint32_t scr0 = r[0x00 / 4];
+	const uint32_t idr0 = r[0x20 / 4];
+	const uint32_t idr1 = r[0x24 / 4];
+	const uint32_t idr2 = r[0x28 / 4];
+	const uint32_t gfsr = r[0x48 / 4];
+	const unsigned smrs = idr0 & 0xffu;
+	const unsigned banks = idr1 & 0xffu;
+	unsigned valid = 0;
+	unsigned shown = 0;
+
+	printf("PongAudio: SMMU audit sCR0=0x%08x IDR0=0x%08x IDR1=0x%08x IDR2=0x%08x sGFSR=0x%08x\n",
+	    scr0, idr0, idr1, idr2, gfsr);
+	for (unsigned i = 0; i < smrs && i < 128u; i++) {
+		const uint32_t smr = r[(0x800 / 4) + i];
+		if ((smr & 0x80000000u) == 0u) {
+			continue;
+		}
+		valid++;
+		if (shown < 24u) {
+			const uint32_t s2cr = r[(0xc00 / 4) + i];
+			shown++;
+			printf("PongAudio: SMMU smr[%u] sid=0x%03x mask=0x%04x s2cr=0x%08x type=%u bank=%u\n",
+			    i, smr & 0xffffu, (smr >> 16) & 0xffffu, s2cr,
+			    (s2cr >> 16) & 3u, s2cr & 0xffu);
+		}
+	}
+	printf("PongAudio: SMMU audit smrs=%u valid=%u banks=%u\n", smrs, valid,
+	    banks);
+	for (unsigned a = 0; a < sizeof(audio_streams) / sizeof(audio_streams[0]); a++) {
+		const uint16_t sid = audio_streams[a];
+		bool found = false;
+
+		for (unsigned i = 0; i < smrs && i < 128u; i++) {
+			const uint32_t smr = r[(0x800 / 4) + i];
+			if ((smr & 0x80000000u) == 0u) {
+				continue;
+			}
+			if ((((uint32_t)sid ^ (smr & 0xffffu)) &
+			    ((smr >> 16) & 0xffffu)) != 0u) {
+				continue;
+			}
+			const uint32_t s2cr = r[(0xc00 / 4) + i];
+			printf("PongAudio: SMMU stream 0x%03x -> smr[%u] s2cr=0x%08x type=%u bank=%u\n",
+			    sid, i, s2cr, (s2cr >> 16) & 3u, s2cr & 0xffu);
+			found = true;
+			break;
+		}
+		if (!found) {
+			printf("PongAudio: SMMU stream 0x%03x has no matching SMR\n", sid);
+		}
+	}
+}
+
+/* The DSP reads the PCM period through apps SMMU stream 0x1801: the audio ion
+ * node in the device tree binds iommus <&apps_smmu 0x1801 0>, and the low four
+ * bits of the stream id come from the buffer address upper word, which is why
+ * the map and write commands carry bit 32. Firmware leaves that stream
+ * translating into a table this kernel never fills, so the first read faults
+ * and the ADSP resets. Lease the top context bank as a stage-1 bypass bank,
+ * the same handoff the Pong reference performs for its DMA buffer, and leave
+ * every other stream and bank alone. */
+static volatile uint32_t *g_pong_smmu_pages[3];
+static uint32_t g_pong_smmu_page_base[3];
+
+static volatile uint32_t *
+pong_smmu_page(uint32_t off)
+{
+	const uint32_t base = off & ~0xfffu;
+	unsigned i;
+
+	for (i = 0; i < 3u; i++) {
+		if (g_pong_smmu_pages[i] != NULL &&
+		    g_pong_smmu_page_base[i] == base) {
+			return g_pong_smmu_pages[i];
+		}
+	}
+	for (i = 0; i < 3u; i++) {
+		if (g_pong_smmu_pages[i] == NULL) {
+			break;
+		}
+	}
+	if (i == 3u) {
+		return NULL;
+	}
+	volatile uint32_t *page = (volatile uint32_t *)ml_io_map(0x15000000u + base,
+	    0x1000);
+
+	if (page == NULL) {
+		return NULL;
+	}
+	g_pong_smmu_pages[i] = page;
+	g_pong_smmu_page_base[i] = base;
+	return page;
+}
+
+static bool
+pong_smmu_read32(uint32_t off, uint32_t *value)
+{
+	volatile uint32_t *page = pong_smmu_page(off);
+
+	if (page == NULL) {
+		return false;
+	}
+	*value = page[(off & 0xfffu) / 4u];
+	return true;
+}
+
+static bool
+pong_smmu_write32(uint32_t off, uint32_t value)
+{
+	volatile uint32_t *page = pong_smmu_page(off);
+
+	if (page == NULL) {
+		return false;
+	}
+	page[(off & 0xfffu) / 4u] = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return true;
+}
+
+static bool
+pong_audio_smmu_lease(uint16_t sid)
+{
+	uint32_t scr0, idr0, idr1, idr2, value, smr_keep = 0, s2cr_keep = 0;
+	unsigned count, banks, pages, bank, slot = 0xffffffffu, i;
+	bool have_smr = false;
+
+	if (g_pong_smmu_leased) {
+		return true;
+	}
+	if (!pong_smmu_read32(0x00u, &scr0) || !pong_smmu_read32(0x20u, &idr0) ||
+	    !pong_smmu_read32(0x24u, &idr1) || !pong_smmu_read32(0x28u, &idr2)) {
+		printf("PongAudio: SMMU lease cannot map the register page\n");
+		return false;
+	}
+	if ((idr0 & (1u << 30)) == 0u || (idr2 & (1u << 12)) == 0u) {
+		printf("PongAudio: SMMU lease refused: no AArch64 stage 1\n");
+		return false;
+	}
+	count = idr0 & 0xffu;
+	banks = idr1 & 0xffu;
+	pages = 1u << (((idr1 >> 28) & 7u) + 1u);
+	if ((idr1 & 0x80000000u) != 0u || count == 0u || banks < 2u ||
+	    pages > 128u || (pages + banks) * 4096u > 0x100000u) {
+		printf("PongAudio: SMMU lease refused: geometry pages=%u banks=%u count=%u\n",
+		    pages, banks, count);
+		return false;
+	}
+	if (banks > 78u) {
+		banks = 78u;
+	}
+	if (count > 120u) {
+		count = 120u;
+	}
+	/* The firmware already routes these audio streams through a masked
+	 * group (slot 3 on this board). A stream-match register only wins
+	 * when its index is lower, so keep the lowest idle slot and never
+	 * accept a slot at or above the masked group. */
+	{
+		unsigned shadow = count;
+
+		slot = 0xffffffffu;
+		for (i = 0; i < count; i++) {
+			uint32_t smr, mask;
+
+			if (!pong_smmu_read32(0x800u + 4u * i, &smr)) {
+				return false;
+			}
+			mask = (smr >> 16) & 0x7fffu;
+			if ((smr & 0x80000000u) == 0u) {
+				if (slot == 0xffffffffu) {
+					slot = i;
+				}
+				continue;
+			}
+			if (((((uint32_t)sid ^ (smr & 0xffffu)) & 0xffffu) &
+			    ~mask) != 0u) {
+				continue;
+			}
+			if (mask == 0u && (smr & 0xffffu) == (uint32_t)sid) {
+				slot = i;
+				(void)pong_smmu_read32(0xc00u + 4u * i,
+				    &s2cr_keep);
+				have_smr = true;
+				break;
+			}
+			if (i < shadow) {
+				shadow = i;
+			}
+		}
+		if (have_smr) {
+			smr_keep = 0x80000000u | (uint32_t)sid;
+		}
+		if (slot == 0xffffffffu || (!have_smr && slot >= shadow)) {
+			printf("PongAudio: SMMU lease refused: no idle stream group below %u\n",
+			    shadow);
+			return false;
+		}
+	}
+	/* Take the highest bank that nothing references. The reference
+	 * handoff reserves one bank for pass-through and leaves every
+	 * firmware stream group and every other bank alone. */
+	bank = 0xffffffffu;
+	for (i = 0; i + 2u < banks && bank == 0xffffffffu; i++) {
+		const unsigned candidate = banks - 1u - i;
+		bool used = false;
+		unsigned j;
+
+		if (candidate < 2u) {
+			break;
+		}
+		if (!pong_smmu_read32((pages + candidate) * 4096u, &value) ||
+		    (value & 1u) != 0u) {
+			continue;
+		}
+		if (!pong_smmu_read32(0x1800u + 4u * candidate, &value) ||
+		    (value & ~1u) != 0u) {
+			continue;
+		}
+		if (!pong_smmu_read32(0x1000u + 4u * candidate, &value) ||
+		    value != 0x10000u) {
+			continue;
+		}
+		for (j = 0; j < count; j++) {
+			uint32_t smr, s2cr;
+
+			if (!pong_smmu_read32(0x800u + 4u * j, &smr) ||
+			    !pong_smmu_read32(0xc00u + 4u * j, &s2cr)) {
+				return false;
+			}
+			if ((smr & 0x80000000u) != 0u &&
+			    ((s2cr >> 16) & 3u) == 0u &&
+			    (s2cr & 0xffu) == candidate) {
+				used = true;
+				break;
+			}
+		}
+		if (!used) {
+			bank = candidate;
+		}
+	}
+	if (bank == 0xffffffffu) {
+		unsigned shown = 0;
+
+		printf("PongAudio: SMMU lease refused: no free context bank below %u\n",
+		    banks);
+		for (i = 0; i + 2u < banks && shown < 12u; i++) {
+			uint32_t sctlr = 0, cbar = 0, bank_cfg = 0;
+			bool referenced = false;
+			unsigned j;
+			const unsigned candidate = banks - 1u - i;
+
+			if (!pong_smmu_read32((pages + candidate) * 4096u, &sctlr) ||
+			    !pong_smmu_read32(0x1000u + 4u * candidate, &cbar) ||
+			    !pong_smmu_read32(0x1800u + 4u * candidate, &bank_cfg)) {
+				break;
+			}
+			for (j = 0; j < count; j++) {
+				uint32_t smr = 0, s2cr = 0;
+
+				if (!pong_smmu_read32(0x800u + 4u * j, &smr) ||
+				    !pong_smmu_read32(0xc00u + 4u * j, &s2cr)) {
+					break;
+				}
+				if ((smr & 0x80000000u) != 0u &&
+				    ((s2cr >> 16) & 3u) == 0u &&
+				    (s2cr & 0xffu) == candidate) {
+					referenced = true;
+					break;
+				}
+			}
+			shown++;
+			printf("PongAudio: SMMU bank %u sctlr=0x%08x cbar=0x%08x cfg=0x%08x used=%u\n",
+			    candidate, sctlr, cbar, bank_cfg, referenced ? 1u : 0u);
+		}
+		return false;
+	}
+	if (!pong_smmu_read32((pages + bank) * 4096u, &value) || (value & 1u) != 0u) {
+		printf("PongAudio: SMMU bank %u is not a disabled free bank\n", bank);
+		return false;
+	}
+	if (!pong_smmu_read32(0x1800u + 4u * bank, &value) || (value & ~1u) != 0u) {
+		printf("PongAudio: SMMU bank %u belongs to someone else\n", bank);
+		return false;
+	}
+	if (!pong_smmu_read32(0x1000u + 4u * bank, &value)) {
+		return false;
+	}
+	if (value != 0x10000u && !pong_smmu_write32(0x1000u + 4u * bank, 0x10000u)) {
+		return false;
+	}
+	if (value != 1u && !pong_smmu_write32(0x1800u + 4u * bank, 1u)) {
+		return false;
+	}
+	if (!pong_smmu_write32(0xc00u + 4u * slot, bank) ||
+	    !pong_smmu_read32(0xc00u + 4u * slot, &value) || value != bank) {
+		printf("PongAudio: SMMU lease: S2CR slot %u did not take bank %u\n",
+		    slot, bank);
+		return false;
+	}
+	if (!have_smr) {
+		smr_keep = 0x80000000u | (uint32_t)sid;
+		if (!pong_smmu_write32(0x800u + 4u * slot, smr_keep) ||
+		    !pong_smmu_read32(0x800u + 4u * slot, &value) ||
+		    value != smr_keep) {
+			printf("PongAudio: SMMU lease: SMR slot %u did not take stream 0x%03x\n",
+			    slot, sid);
+			return false;
+		}
+	}
+	if (!pong_smmu_read32((pages + bank) * 4096u, &value) ||
+	    !pong_smmu_read32(0x1000u + 4u * bank, &value) ||
+	    value != 0x10000u) {
+		printf("PongAudio: SMMU lease: bypass bank %u readback failed\n", bank);
+		return false;
+	}
+	g_pong_smmu_leased = true;
+	printf("PongAudio: SMMU stream 0x%03x leased to bypass bank %u slot %u smr=0x%08x SMMUEN=%u\n",
+	    sid, bank, slot, smr_keep, scr0 & 1u);
+	if ((scr0 & 1u) == 0u) {
+		printf("PongAudio: SMMU translation is off; the stream reads physical addresses\n");
+	}
+	return true;
+}
+
+static void
+pong_audio_pump_one(PongAudioState *state)
+{
+	if (!state->service_ready || !state->play_graph_ready ||
+	    !state->ring_ready) {
+		return;
+	}
+	if (!state->playback_running) {
+		if (state->play_step != (unsigned)PongPlayClock) {
+			return;
+		}
+		if (pong_ring_queue_used(&state->ring) < PONG_RING_LEAD_FRAMES) {
+			return;
+		}
+		printf("PongAudio: PCM lead reached frames=%u; starting playback graph\n",
+		    (unsigned)pong_ring_queue_used(&state->ring));
+		pong_audio_smmu_audit();
+		(void)pong_audio_smmu_lease(0x1801u);
+		pong_audio_play_send_step(state, PongPlayPrepareSpeaker);
+		return;
+	}
+	{
+		static unsigned pump_logs;
+		if (pump_logs < 6u) {
+			pump_logs++;
+			printf("PongAudio: PCM pump running inflight=%u used=%u step=%u\n",
+			    state->inflight,
+			    (unsigned)pong_ring_queue_used(&state->ring),
+			    state->play_step);
+		}
+	}
+	pong_audio_play_reap_slots(state);
+	if (state->inflight == 0u) {
+		if (pong_ring_queue_used(&state->ring) >=
+		    PONG_AUDIO_PERIOD_FRAMES) {
+			pong_audio_play_begin_stream(state);
+		}
+		return;
+	}
+	(void)pong_audio_play_submit_slot(state);
+}
+
+static void
+pong_audio_afe_selftest(void)
+{
+	uint8_t pkt[PONG_AFE_PRM_CLOCK_BYTES];
+	size_t n = pong_afe_prm_clock_request(pkt, sizeof(pkt),
+	    PONG_AFE_CLOCK_TERT_TDM_IBIT, PONG_AFE_TDM_CLK_HZ,
+	    PONG_AFE_CLOCK_ATTRIBUTE_NOCOUPLE, 1u);
+	printf("PongAudio: AFE encoder selftest bytes=%u\n", (unsigned)n);
+}
+
+static void
+pong_audio_afe_send_step(PongAudioState *state, unsigned step)
+{
+	uint8_t packet[PONG_AFE_STEP_PACKET_MAX];
+	const uint32_t token = 0x00020000u + step;
+	const uint32_t opcode = pong_afe_step_opcode(step);
+	const size_t n = pong_afe_step_packet(packet, sizeof(packet), step, token);
+	if (n == 0u) {
+		state->last_error = PongAudioErrAfeRefused;
+		printf("PongAudio: AFE step %u encode failed\n", step);
+		return;
+	}
+	const int rc = k60_pmic_glink_send_audio(packet, (unsigned)n);
+	printf("PongAudio: AFE step %u send bytes=%u opcode=0x%08x token=0x%08x rc=%d\n",
+	    step, (unsigned)n, opcode, token, rc);
+	if (rc == K60_PMIC_GLINK_AUDIO_OK) {
+		state->afe_step = step;
+		state->afe_token = token;
+		state->afe_retry = 0u;
+		return;
+	}
+	if (rc == K60_PMIC_GLINK_AUDIO_AGAIN && state->afe_retry < 3u) {
+		state->afe_retry++;
+		printf("PongAudio: AFE step %u retry %u\n", step, state->afe_retry);
+		pong_audio_afe_send_step(state, step);
+		return;
+	}
+	state->last_error = PongAudioErrAfeRefused;
+	printf("PongAudio: AFE step %u refused rc=%d\n", step, rc);
+}
+
+static void
+pong_audio_afe_next(PongAudioState *state)
+{
+	if (state->afe_group_probe && state->afe_step == (unsigned)PongAfeStepGroupTdm) {
+		state->afe_token = 0;
+		printf("PongAudio: AFE group probe accepted; not starting speaker or PCM\n");
+		return;
+	}
+	if (state->afe_step + 1u >= (unsigned)PongAfeStepCount) {
+		state->service_ready = true;
+		state->last_error = PongAudioOk;
+		printf("PongAudio: AFE six-step complete; speaker path ready\n");
+		pong_audio_play_start(state);
+		return;
+	}
+	pong_audio_afe_send_step(state, state->afe_step + 1u);
+}
+
+static void
+pong_audio_glink_state(void *context, bool up)
+{
+	PongAudioState *state = (PongAudioState *)context;
+	state->glink_up = up;
+	printf("PongAudio: glink adsp_apps %s\n", up ? "up" : "down");
+	if (!up) {
+		state->gpr_token = 0;
+		state->apm_ready = false;
+		state->afe_step = 0;
+		state->afe_retry = 0;
+		state->afe_token = 0;
+		state->service_ready = false;
+		pong_audio_play_reset(state);
+		state->last_error = PongAudioErrNoLease;
+		return;
+	}
+	if (state->gpr_token != 0) {
+		return;
+	}
+	uint8_t packet[GPR_MAX_PACKET];
+	const uint32_t token = 0x00010001u;
+	const uint32_t n = pong_afe_gpr_spf_state_query(packet, sizeof(packet), token);
+	if (n == 0) {
+		printf("PongAudio: GPR GET_SPF_STATE encode failed\n");
+		return;
+	}
+	const int rc = k60_pmic_glink_send_audio(packet, (unsigned)n);
+	printf("PongAudio: GPR GET_SPF_STATE send bytes=%u src=0x%x dst=0x%x rc=%d\n",
+	    (unsigned)n, PONG_AFE_GPR_PORT_CLIENT, PONG_AFE_GPR_PORT_APM, rc);
+	if (rc == K60_PMIC_GLINK_AUDIO_OK) {
+		state->gpr_token = token;
+	}
+}
+
+static void
+pong_audio_glink_receive(void *context, const uint8_t *data, unsigned bytes)
+{
+	PongAudioState *state = (PongAudioState *)context;
+	PongArAnswer answer;
+	static unsigned afe_skips;
+	const int kind = pong_ar_parse(data, bytes, &answer);
+	if (kind == PongArBad) {
+		printf("PongAudio: glink adsp_apps rx bytes=%u (bad gpr)\n", bytes);
+		return;
+	}
+	/* The parser has already validated the GPR header and payload. */
+	const uint32_t domains = pong_le32(data + 4);
+	printf("PongAudio: glink adsp_apps rx bytes=%u kind=%d opcode=0x%08x token=0x%08x status=%u "
+	    "src=%u:0x%x dst=%u:0x%x echoed=0x%08x\n",
+	    bytes, kind, answer.opcode, answer.token, answer.status,
+	    (domains >> 8) & 0xffu, answer.src_port, domains & 0xffu, pong_le32(data + 12),
+	    answer.result_opcode);
+	if (pong_audio_play_receive(state, kind, &answer)) {
+		return;
+	}
+	if (kind == PongArFrameworkState) {
+		if (answer.token != 0x00010001u) {
+			printf("PongAudio: APM response token mismatch 0x%08x\n", answer.token);
+			return;
+		}
+		if (answer.status != 1u) {
+			state->last_error = PongAudioErrApmNotReady;
+			printf("PongAudio: APM not ready status=%u: PongAudioErrApmNotReady\n",
+			    answer.status);
+			return;
+		}
+		state->apm_ready = true;
+		printf("PongAudio: APM ready; starting AFE six-step\n");
+		pong_audio_afe_send_step(state, PongAfeStepClock);
+		return;
+	}
+	if (kind == PongArPrmDone) {
+		if (answer.token == state->afe_token &&
+		    state->afe_step == (unsigned)PongAfeStepClock && answer.status == 0u) {
+			pong_audio_afe_next(state);
+		} else {
+			state->last_error = PongAudioErrAfeRefused;
+			printf("PongAudio: AFE clock refused token=0x%08x status=%u\n",
+			    answer.token, answer.status);
+		}
+		return;
+	}
+	if (kind == PongArBasicResult) {
+		if (state->afe_token == 0u || answer.token != state->afe_token) {
+			printf("PongAudio: AFE stale result token=0x%08x\n", answer.token);
+			return;
+		}
+		if (answer.result_opcode != pong_afe_step_opcode(state->afe_step) ||
+		    answer.status != 0u) {
+			state->last_error = PongAudioErrAfeRefused;
+			printf("PongAudio: AFE step %u refused opcode=0x%08x status=%u\n",
+			    state->afe_step, answer.result_opcode, answer.status);
+			if (!state->afe_group_probe && afe_skips < 8u) {
+				afe_skips++;
+				printf("PongAudio: AFE step %u skipped, continuing\n",
+				    state->afe_step);
+				pong_audio_afe_next(state);
+			}
+			return;
+		}
+		pong_audio_afe_next(state);
+	}
+}
