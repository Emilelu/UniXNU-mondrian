+#if !DEVELOPMENT && !DEBUG
+#error The Pong SystemOS shared-region binding is development-only
+#endif
+extern volatile int native_owner_cache_status;
+extern volatile int native_owner_cache_authorized;
+extern volatile int native_owner_cache_root_recheck;
+extern volatile int native_owner_cache_readonly;
+extern volatile uintptr_t native_owner_cache_current_root;
+extern volatile dev_t native_owner_cache_selected_device;
+extern volatile dev_t native_owner_cache_mounted_device;
+
+/* HackiOS accepts a Cryptex volume mounted below Preboot. Pong mounts the
+ * UUID-selected SystemOS volume directly at /private/preboot, so validate
+ * that exact mount/device/directory relationship instead of its parent. */
+static boolean_t
+pong_owner_shared_cache_mount(vnode_t process_root, vnode_t file)
+{
+	const char *directory = "/private/preboot/System/Library/Caches/com.apple.dyld";
+	vnode_t expected_parent = NULLVP;
+	vnode_t device_vnode = NULLVP;
+	boolean_t authorized = FALSE;
+	dev_t actual = NODEV;
 
+	if (process_root != rootvnode || !file || vnode_vtype(file) != VREG ||
+	    native_owner_cache_status != 0 || !native_owner_cache_authorized ||
+	    !native_owner_cache_root_recheck || !native_owner_cache_readonly ||
+	    native_owner_cache_current_root != (uintptr_t)rootvnode ||
+	    native_owner_cache_selected_device == NODEV ||
+	    native_owner_cache_selected_device != native_owner_cache_mounted_device) {
+		return FALSE;
+	}
+	mount_t root_mount = vnode_mount(process_root);
+	mount_t cache_mount = vnode_mount(file);
+	if (!root_mount || !cache_mount || root_mount == cache_mount ||
+	    !(vfs_flags(root_mount) & MNT_RDONLY) || !(vfs_flags(cache_mount) & MNT_RDONLY) ||
+	    strcmp(vfs_statfs(root_mount)->f_fstypename, "apfs") ||
+	    strcmp(vfs_statfs(cache_mount)->f_fstypename, "apfs")) return FALSE;
+	device_vnode = vfs_devvp(cache_mount);
+	if (device_vnode) {
+		actual = vnode_specrdev(device_vnode);
+		vnode_put(device_vnode);
+	}
+	if (actual != native_owner_cache_selected_device ||
+	    vnode_lookup(directory, 0, &expected_parent, vfs_context_current())) return FALSE;
+	authorized = vnode_vtype(expected_parent) == VDIR &&
+	    vnode_mount(expected_parent) == cache_mount && vnode_parent(file) == expected_parent;
+	vnode_put(expected_parent);
+	return authorized;
+}
