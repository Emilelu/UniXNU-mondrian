+static void
+pong_frame_size_factor(PongWriter *w, uint32_t iid)
+{
+	const uint32_t at = pong_param_begin(w, iid, PARAM_FRAME_SIZE_FACTOR);
+	pong_put32(w, 1);
+	pong_param_end(w, at);
+}
+
+static uint32_t
+pong_ar_config_speaker_device(uint8_t *out, uint32_t capacity, uint32_t port,
+    uint32_t token, const PongArFormat *f)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_APM_IID, token, AR_OP_SET_CFG);
+	const uint32_t cmd = pong_cmd_payload_start(&w);
+	const uint32_t at = pong_param_begin(&w, AR_IID_SPEAKER_I2S,
+	    PARAM_I2S_INTF);
+	pong_put32(&w, LPAIF_TYPE);
+	pong_put32(&w, I2S_TERTIARY);
+	pong_put16(&w, I2S_SPEAKER_SD);
+	pong_put16(&w, WS_INTERNAL);
+	pong_param_end(&w, at);
+	pong_hw_ep_mf(&w, AR_IID_SPEAKER_I2S, f);
+	pong_frame_size_factor(&w, AR_IID_SPEAKER_I2S);
+	pong_cmd_payload_end(&w, cmd);
+	return pong_finish(&w);
+}
+
+static void
+pong_pcm_output(PongWriter *w, uint32_t iid, const PongArFormat *f,
+    uint32_t interleaving)
+{
+	const uint32_t at = pong_param_begin(w, iid, PARAM_PCM_OUTPUT);
+	pong_put32(w, 1);
+	pong_put32(w, 0x09001000u);
+	pong_put32(w, (16u + f->channels + 3u) & ~3u);
+	pong_put16(w, f->bits);
+	pong_put16(w, 1);
+	pong_put16(w, f->bits);
+	pong_put16(w, f->bits - 1u);
+	pong_put16(w, 1);
+	pong_put16(w, interleaving);
+	pong_put16(w, 0);
+	pong_put16(w, f->channels);
+	for (unsigned i = 0; i < f->channels; ++i) {
+		pong_put8(w, i + 1u);
+	}
+	pong_param_end(w, at);
+}
+
+static uint32_t
+pong_ar_config_playback_stream(uint8_t *out, uint32_t capacity,
+    uint32_t port, uint32_t token, const PongArFormat *f)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_APM_IID, token, AR_OP_SET_CFG);
+	const uint32_t cmd = pong_cmd_payload_start(&w);
+	pong_pcm_output(&w, AR_IID_PLAY_DEC, f, INTERLEAVED);
+	pong_pcm_output(&w, AR_IID_PLAY_CNV, f, DEINTERLEAVED_UNPACKED);
+	pong_cmd_payload_end(&w, cmd);
+	return pong_finish(&w);
+}
+
+static uint32_t
+pong_ar_config_playback_shmem(uint8_t *out, uint32_t capacity,
+    uint32_t port, uint32_t token, const PongArFormat *f)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_IID_PLAY_SHMEM, token,
+	    AR_OP_SET_CFG);
+	const uint32_t cmd = pong_cmd_payload_start(&w);
+	const uint32_t at = pong_param_begin(&w, AR_IID_PLAY_SHMEM,
+	    PARAM_MEDIA_FORMAT);
+	const uint32_t pcm_bytes = (16u + f->channels + 3u) & ~3u;
+	pong_put32(&w, 1);
+	pong_put32(&w, 0x09001000u);
+	pong_put32(&w, pcm_bytes);
+	pong_put32(&w, f->rate);
+	pong_put16(&w, f->bits);
+	pong_put16(&w, 1);
+	pong_put16(&w, f->bits);
+	pong_put16(&w, f->bits - 1u);
+	pong_put16(&w, 1);
+	pong_put16(&w, f->channels);
+	for (unsigned i = 0; i < f->channels; ++i) {
+		pong_put8(&w, i + 1u);
+	}
+	pong_param_end(&w, at);
+	pong_cmd_payload_end(&w, cmd);
+	return pong_finish(&w);
+}
+
+static uint32_t
+pong_ar_graph_command(uint8_t *out, uint32_t capacity, uint32_t port,
+    uint32_t token, uint32_t opcode, uint32_t sg)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_APM_IID, token, opcode);
+	const uint32_t cmd = pong_cmd_payload_start(&w);
+	const uint32_t at = pong_param_begin(&w, AR_APM_IID, PARAM_SG_LIST);
+	pong_put32(&w, 1);
+	pong_put32(&w, sg);
+	pong_param_end(&w, at);
+	pong_cmd_payload_end(&w, cmd);
+	return pong_finish(&w);
+}
+
+static uint32_t
+pong_ar_map(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token,
+    uint64_t address, uint32_t bytes)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_APM_IID, token, AR_OP_MEM_MAP);
+	pong_put16(&w, 3);
+	pong_put16(&w, 1);
+	pong_put32(&w, 0);
+	pong_put32(&w, (uint32_t)address);
+	pong_put32(&w, (uint32_t)(address >> 32));
+	pong_put32(&w, (bytes + 4095u) & ~4095u);
+	pong_pad_to(&w, w.n + CMD_HEADER);
+	return pong_finish(&w);
+}
+
+static uint32_t
+pong_ar_write(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token,
+    uint64_t address, uint32_t handle, uint32_t bytes)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_IID_PLAY_SHMEM, token, AR_OP_WRITE);
+	pong_put32(&w, (uint32_t)address);
+	pong_put32(&w, (uint32_t)(address >> 32));
+	pong_put32(&w, handle);
+	pong_put32(&w, bytes);
+	pong_put32(&w, 0);
+	pong_put32(&w, 0);
+	pong_put32(&w, 0);
+	pong_put32(&w, 0);
+	pong_put32(&w, 0);
+	pong_put32(&w, 0);
+	pong_put32(&w, 0);
+	return pong_finish(&w);
+}
+
+static uint32_t
+pong_ar_prm_clock(uint8_t *out, uint32_t capacity, uint32_t port,
+    uint32_t token, uint32_t clock_id, uint32_t hz)
+{
+	PongWriter w;
+	pong_begin(&w, out, capacity, port, AR_PRM_IID, token,
+	    hz ? AR_OP_PRM_REQUEST : AR_OP_PRM_RELEASE);
+	const uint32_t cmd = pong_cmd_payload_start(&w);
+	const uint32_t at = pong_param_begin(&w, AR_PRM_IID, 0x0800102Cu);
+	pong_put32(&w, 1);
+	pong_put32(&w, clock_id);
+	if (hz != 0) {
+		pong_put32(&w, hz);
+		pong_put32(&w, 1);
+		pong_put32(&w, 0);
+	}
+	pong_set32(&w, at + 8, w.n - at - PARAM_HEADER);
+	pong_cmd_payload_end(&w, cmd);
+	return pong_finish(&w);
+}
+
+typedef struct {
+	uint32_t opcode;
+	uint32_t token;
+	uint32_t src_port;
+	uint32_t result_opcode;
+	uint32_t status;
+	uint32_t handle;
+	uint64_t address;
+	uint32_t data_bytes;
+	uint32_t offset;
+} PongArAnswer;
+
+enum {
+	PongArUnknown = 0,
+	PongArBasicResult = 1,
+	PongArMapped = 2,
+	PongArWriteDone = 3,
+	PongArFrameworkState = 5,
+	PongArPrmDone = 6,
+	PongArBad = -1
+};
+
+static int
+pong_ar_parse(const uint8_t *in, uint32_t length, PongArAnswer *a)
+{
+	PongGprPacket p;
+	memset(a, 0, sizeof(*a));
+	if (pong_gpr_decode(in, length, &p) != PongGprOk) {
+		return PongArBad;
+	}
+	a->opcode = p.opcode;
+	a->token = p.token;
+	a->src_port = p.src_port;
+	const uint8_t *d = p.payload;
+	switch (p.opcode) {
+	case GPR_OP_BASIC_RESULT:
+		if (p.payload_bytes < 8) {
+			return PongArBad;
+		}
+		a->result_opcode = pong_le32(d);
+		a->status = pong_le32(d + 4);
+		return PongArBasicResult;
+	case AR_OP_PRM_REQUEST_DONE:
+	case AR_OP_PRM_RELEASE_DONE:
+		if (p.payload_bytes < 4) {
+			return PongArBad;
+		}
+		a->status = pong_le32(d + (p.payload_bytes >= 8 ? 4 : 0));
+		return PongArPrmDone;
+	case GPR_OP_APM_SPF_STATE:
+		if (p.payload_bytes < 4) {
+			return PongArBad;
+		}
+		a->status = pong_le32(d);
+		return PongArFrameworkState;
+	case AR_OP_MEM_MAP_DONE:
+		if (p.payload_bytes < 4) {
+			return PongArBad;
+		}
+		a->handle = pong_le32(d);
+		return PongArMapped;
+	case AR_OP_WRITE_DONE:
+		if (p.payload_bytes < 16) {
+			return PongArBad;
+		}
+		a->address = pong_le32(d) | (uint64_t)pong_le32(d + 4) << 32;
+		a->handle = pong_le32(d + 8);
+		a->status = pong_le32(d + 12);
+		return PongArWriteDone;
+	default:
+		return PongArUnknown;
+	}
+}
+
+/* ------------------------------------------------------------------------- */
+/* Kernel-side state and skeleton entry points                               */
+/* ------------------------------------------------------------------------- */
+
+typedef struct {
+	vm_offset_t adsp;
+	vm_offset_t smem;
+	vm_offset_t ipcc;
+	vm_offset_t aoss;
+	uint64_t dma_pa;
+	uint32_t dma_size;
+	uint32_t graph_state;
+	bool mapped;
+	bool service_ready;
+} PongAudioState;
+
+static PongAudioState g_pong_audio;
+
+static bool
+pong_audio_map(void)
+{
+	if (g_pong_audio.mapped) {
+		return true;
+	}
+	/* TODO(k60): map only what the probe needs; PAS1 firmware loading
+	 * will map the full 0x9fd00000+0x3100000 carveout after the SCM
+	 * call path exists. Mapping the first page here is a compile-time
+	 * placeholder, not an ADSP access. */
+	g_pong_audio.adsp = ml_io_map(PONG_ADSP_PA, 0x1000);
+	g_pong_audio.smem = ml_io_map(PONG_SMEM_PA, PONG_SMEM_SIZE);
+	g_pong_audio.ipcc = ml_io_map(PONG_IPCC_PA, PONG_IPCC_SIZE);
+	g_pong_audio.aoss = ml_io_map(PONG_AOSS_PA, PONG_AOSS_SIZE);
+	if (!g_pong_audio.adsp || !g_pong_audio.smem || !g_pong_audio.ipcc ||
+	    !g_pong_audio.aoss) {
+		printf("PongAudio: map failed adsp=%lx smem=%lx ipcc=%lx aoss=%lx\n",
+		    (unsigned long)g_pong_audio.adsp,
+		    (unsigned long)g_pong_audio.smem,
+		    (unsigned long)g_pong_audio.ipcc,
+		    (unsigned long)g_pong_audio.aoss);
+		return false;
+	}
+	g_pong_audio.mapped = true;
+	printf("PongAudio: ADSP carveout 0x%x+0x%x, SMEM 0x%x+0x%x, "
+	    "IPCC 0x%x/IRQ261 (skeleton)\n", PONG_ADSP_PA, PONG_ADSP_SIZE,
+	    PONG_SMEM_PA, PONG_SMEM_SIZE, PONG_IPCC_PA);
+	return true;
+}
+
+int pong_audio_bootstrap(void);
+int pong_audio_start(void);
+int pong_audio_stop(void);
+int pong_audio_submit(const void *frames, uint32_t frame_count);
+int pong_audio_status(void);
+int pong_audio_selftest(void);
+extern int aw882xx_bootstrap(void);
+
+static void
+pong_audio_worker(void *arg __unused, wait_result_t wait __unused)
+{
+	(void)pong_audio_start();
+	thread_terminate_self();
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+int
+pong_audio_bootstrap(void)
+{
+	int mode = 0;
+	if (!PE_parse_boot_argn("pong_audio", &mode, sizeof(mode)) || mode == 0) {
+		return 0;
+	}
+	/* The amplifier driver has its own boot-arg gate (pong_aw882xx);
+	 * calling it here keeps the two components independent. */
+	(void)aw882xx_bootstrap();
+	thread_t thread = NULL;
+	if (kernel_thread_start(pong_audio_worker, NULL, &thread) !=
+	    KERN_SUCCESS) {
+		printf("PongAudio: worker thread creation failed\n");
+		return -1;
+	}
+	thread_deallocate(thread);
+	return 0;
+}
+
+int
+pong_audio_start(void)
+{
+	int mode = 0;
+	if (!PE_parse_boot_argn("pong_audio", &mode, sizeof(mode)) || mode == 0) {
+		return 0;
+	}
+	if (!pong_audio_map()) {
+		return -1;
+	}
+	printf("PongAudio: skeleton stage=ADSP_WINDOWS (PAS1 loader TODO)\n");
+	/* TODO(k60): implement PongAudio.cpp:511-588 (PAS1 authenticated
+	 * load, SMP2P, GLINK, GPR) before touching any ADSP register. */
+	printf("PongAudio: EXPERIMENTAL skeleton; PAS1/AudioReach not started\n");
+	return 0;
+}
+
+int
+pong_audio_stop(void)
+{
+	g_pong_audio.service_ready = false;
+	return 0;
+}
+
+int
+pong_audio_submit(const void *frames, uint32_t frame_count)
+{
+	(void)frames;
+	(void)frame_count;
+	/* TODO(k60): connect to PongAudio.cpp:285-327 submit() and the
+	 * AudioReach AR_OP_WRITE path once the graph is open. */
+	return ENOTSUP;
+}
+
+int
+pong_audio_status(void)
+{
+	return g_pong_audio.service_ready ? 1 : 0;
+}
+
+/* Compile-time coverage of every pure packet builder. This is not a hardware
+ * self-test and is not called from bsd_init; it keeps the builders linked and
+ * gives a future unit test a single entry point. */
+int
+pong_audio_selftest(void)
+{
+	uint8_t buf[512];
+	const PongArFormat f = { PONG_AUDIO_RATE, 32, 2 };
+	uint32_t built = 0;
+	built += pong_ar_open_speaker_device(buf, sizeof(buf), PONG_AUDIO_GPR_PORT,
+	    1);
+	built += pong_ar_config_speaker_device(buf, sizeof(buf),
+	    PONG_AUDIO_GPR_PORT, 2, &f);
+	built += pong_ar_open_playback_stream(buf, sizeof(buf),
+	    PONG_AUDIO_GPR_PORT, 3);
+	built += pong_ar_config_playback_stream(buf, sizeof(buf),
+	    PONG_AUDIO_GPR_PORT, 4, &f);
+	built += pong_ar_config_playback_shmem(buf, sizeof(buf),
+	    PONG_AUDIO_GPR_PORT, 5, &f);
+	built += pong_ar_graph_command(buf, sizeof(buf), PONG_AUDIO_GPR_PORT,
+	    6, AR_OP_GRAPH_PREPARE, AR_SG_PLAY);
+	built += pong_ar_map(buf, sizeof(buf), PONG_AUDIO_GPR_PORT, 7,
+	    0x10000000ull, PONG_AUDIO_DMA_BYTES);
+	built += pong_ar_write(buf, sizeof(buf), PONG_AUDIO_GPR_PORT, 8,
+	    0x10000000ull, 1, PONG_AUDIO_PERIOD_BYTES);
+	built += pong_ar_prm_clock(buf, sizeof(buf), PONG_AUDIO_GPR_PORT, 9,
+	    0x104u, PONG_AUDIO_TDM_CLK_HZ);
+	PongGprPacket p = { 0 };
+	p.dst_domain = GPR_DOMAIN_ADSP;
+	p.src_domain = GPR_DOMAIN_APPS;
+	p.src_port = PONG_AUDIO_GPR_PORT;
+	p.dst_port = GPR_PORT_APM;
+	p.token = 10;
+	p.opcode = GPR_OP_APM_GET_SPF_STATE;
+	built += pong_gpr_encode(buf, sizeof(buf), &p, NULL, 0);
+	PongArAnswer answer;
+	(void)pong_ar_parse(buf, built <= sizeof(buf) ? built : sizeof(buf),
+	    &answer);
+	printf("PongAudio: packet self-test bytes=%u (compile coverage only)\n",
+	    built);
+	return (int)built;
+}
