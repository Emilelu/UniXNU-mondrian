 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+	K60_FB_STAGE 3, 0xFFFF00FF
 
 #if !VMAPPLE
 	MOV64	x1, SCTLR_EL1_DEFAULT
