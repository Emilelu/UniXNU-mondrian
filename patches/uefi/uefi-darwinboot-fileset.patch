+     */
+    Kernel->Base = 0xfffffff007004000ULL;
+  }
   if (!Executable || (Kernel->Entry & 3) || (Kernel->Base & EFI_PAGE_MASK) ||
       (Kernel->Base > MAX_UINT64 - WINDOW_SIZE) ||
       (Kernel->End - Kernel->Base > WINDOW_SIZE - SIZE_2MB)) { return EFI_LOAD_ERROR; }
@@ -776,6 +843,12 @@ Boot (
   Stage = L"COPY PAYLOAD";
   DiagDrawVideo (Stage, 0, Video);
   ZeroMem ((VOID *)(UINTN)Address, (UINTN)Used);
+  // The collection image is a memory image: the outer fileset header sits at
+  // vmaddr - link and every entry follows. XNU's first arm_init check reads
+  // that header, so copy it with the segments instead of only the inner
