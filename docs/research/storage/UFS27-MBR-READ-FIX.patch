# UFS27-MBR-READ-FIX — draft only, not applied, not built.
#
# Base: feat/ufs-27 @ f60da7e0 (tree E:/k60-work/ufs27), 2026-11-24.
# Why: the 27 line publishes the SystemOS window first (RootPublication.h:17),
# while 16.6.1 published OS first (PongUfsTransport.cpp:604-612 on
# origin/archive/ios16-final-20261119). SystemOS is a raw APFS volume (NXSB at
# +32); OS is a GPT disk with a protective MBR (0x55AA at +510). A reader that
# probes "partition 0" / disk0 for the MBR therefore sees the APFS superblock
# and reports the 0x55AA tail missing. The second hunk makes the driver fail
# loudly instead of publishing a window whose first sector has no MBR. The
# third hunk moves the unit-test expectation to the new order.
#
# Apply with: git apply --check docs/research/storage/UFS27-MBR-READ-FIX.patch
#
diff --git a/drivers/NativeUfs/RootPublication.h b/drivers/NativeUfs/RootPublication.h
--- a/drivers/NativeUfs/RootPublication.h
+++ b/drivers/NativeUfs/RootPublication.h
@@ -14,10 +14,14 @@ static bool ufsBuildRootPlan (const char *const *names, unsigned count, UfsRootP
     if (!strcmp (names[i], "OS")) os = i;
   }
   if (system == count || os == count) return false;
-  plan.order[0] = system;
-  unsigned position = 1;
+  // K60: the first block device must be the OS disk. Its image starts with a
+  // protective MBR (0x55AA at +510); SystemOS is a raw APFS volume (NXSB at
+  // +32) and has no MBR, so publishing it first makes disk0 unpartitionable
+  // and the kernel's partition-0 MBR probe reads the APFS superblock.
+  plan.order[0] = os;
+  plan.order[1] = system;
+  unsigned position = 2;
   for (unsigned i = 0; i < count; ++i) if (i != system && i != os) plan.order[position++] = i;
-  plan.order[position] = os;
   plan.count = count;
   return true;
 }
diff --git a/drivers/NativeUfs/PongUfsTransport.cpp b/drivers/NativeUfs/PongUfsTransport.cpp
--- a/drivers/NativeUfs/PongUfsTransport.cpp
+++ b/drivers/NativeUfs/PongUfsTransport.cpp
@@ -599,6 +599,11 @@ bool PongUfsBlock::prepareForPublish(IOService *provider) {
     return transportFailure("first root read");
   if (memcmp(bounce + window.signatureOffset, window.signature, strlen(window.signature)))
     return transportFailure("SHNGROOT window signature mismatch");
+  // A GPT window must also carry the protective MBR that the kernel's
+  // partition scan looks for. Checking only the GPT header at +512 publishes a
+  // disk whose first sector is zero and whose 0x55AA is missing.
+  if (window.signatureOffset == 512 && (bounce[510] != 0x55 || bounce[511] != 0xAA))
+    return transportFailure("SHNGROOT window MBR signature missing");
 #if defined(NATIVE_VERIFIED_BLOCK) && NATIVE_VERIFIED_BLOCK
   // Data keeps the path that predates verified-root; P-152/P-153 apply there.
   if (strcmp(window.name, "Data") && !configureVerification()) {
