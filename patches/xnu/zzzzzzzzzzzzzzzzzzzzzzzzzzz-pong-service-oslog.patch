 	}
+#endif
+	/* Account for the extra string and pointer exactly as for caller envv. */
+#if defined(ARM64_BOARD_CONFIG_PONG) && (DEVELOPMENT || DEBUG)
+	if (exec_applog_oslog(imgp)) {
