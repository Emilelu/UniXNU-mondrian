+static void
+touch_thread(__unused void *parameter, __unused wait_result_t result)
+{
+    printf("Pong touch: deferred stage=%u delay=%u ms SPI<=%u Hz\n", touch_stage, touch_delay_ms, spi_hz);
+    sleep_ms(touch_delay_ms);
+    if (!pins_map()) {
+        printf("Pong touch: TLMM mapping unavailable; normal UI boot continues\n");
+        goto out;
+    }
+    if (touch_stage == 1) {
+        printf("Pong touch: stage 1 mapped only; no MMIO reads or writes\n");
+        goto out;
+    }
+    /* No TLMM interrupt is installed. Mask both raw capture and output for
+     * GPIO21 before reset can assert it; its input level remains readable. */
+    wr(GPIO_IRQ_CFG(PIN_INT), rd(GPIO_IRQ_CFG(PIN_INT)) & ~0x11u);
+    wr(GPIO_IRQ_STATUS(PIN_INT), 0);
+    gpio_configure(PIN_INT, 0, PULL_UP, 8, false);
+    gpio_output(PIN_RESET, false, PULL_UP, 8);
+    io_supply_on();
+    touch_reset();
+    if (touch_stage == 2) {
+        printf("Pong touch: stage 2 GPIO/AVDD complete; retained IOVDD not measured\n");
+        goto out;
+    }
+    if (touch_stage != 7) {
+        if (!clocks_map() || !clocks_on()) goto out;
+        if (touch_stage < 5) {
+            printf("Pong touch: stage %u clocks complete; no serial-engine access\n", touch_stage);
+            goto out;
+        }
+        for (unsigned i = 0; i < 3; i++) gpio_configure(pins[i], PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+        gpio_configure(PIN_CS, PIN_FUNCTION_SPI, PULL_UP, 6, false);
+    }
+    if (!bring_up()) {
+        printf("Pong touch: Goodix initialization failed; normal UI boot continues\n");
+        goto out;
+    }
+    if (touch_stage == 5 || touch_stage == 7) {
+        printf("Pong touch: stage %u real chip/IC-info identified, no input device or polling\n", touch_stage);
+        goto out;
+    }
+    /* The vendor's brl_resume() resets an already identified controller.
+     * Recheck the actual firmware/report ABI before publishing any input. */
+    touch_reset();
+    if (!goodix_probe(true)) {
+        printf("Pong touch: controller failed identification after resume reset\n");
+        goto out;
+    }
+    const uint8_t clear = 0;
+    if (!goodix_write(touch_address, &clear, 1)) {
+        printf("Pong touch: cannot clear the resumed report status\n");
+        goto out;
+    }
+    if (!goodix_apply_config(fw_buffer_address)) {
+        printf("Pong touch: config download failed; no input device published\n");
+        goto out;
+    }
+    if (!goodix_probe(true)) {
+        printf("Pong touch: identification lost after config reset\n");
+        goto out;
+    }
+    if (!pong_touch_device_ready()) {
+        printf("Pong touch: verified controller but devfs publication failed\n");
+        goto out;
+    }
+    printf("Pong touch: Berlin-D ready, SPI %#llx reset=%u irq=%u raw axes=%ux%u transport=%s\n",
+        se_phys, PIN_RESET, PIN_INT, max_x, max_y, spi_transfer == geni_transfer ? "GENI FIFO" : "GPIO SPI");
+    unsigned idle = 0, failures = 0;
+    for (;;) {
+        if (!gpio_get(PIN_INT) || ++idle >= 10) {
+            idle = 0;
+            if (goodix_poll()) failures = 0; else failures++;
+            if (!touch_address) {
+                goodix_release();
+                printf("Pong touch: controller identity lost after reset; stop input polling\n");
+                break;
+            }
+            if (failures >= 8) {
+                /* Only end contacts after a real transport/ABI failure,
+                 * never invent them from a timer or IRQ level. */
+                goodix_release();
+                printf("Pong touch: repeated real report failure; stop optional input polling\n");
+                break;
+            }
+        }
+        sleep_ms(8);
+    }
+out:
+    thread_terminate(current_thread());
+}
+
+void
+pong_goodix_init(void)
+{
+    uint32_t enabled = 1, stage = 6, seconds = 8, hz = 4000000, rcg = 0;
+    thread_t thread;
+    (void)PE_parse_boot_argn("pong_touch", &enabled, sizeof(enabled));
+    (void)PE_parse_boot_argn("k60_touch_se", &stage, sizeof(stage));
+    if (!enabled || !stage) return;
+    if (stage > 7) {
+        printf("Pong touch: unsupported k60_touch_se=%u; normal UI boot continues\n", stage);
+        return;
+    }
+    if (!configuration()) {
+        printf("Pong touch: missing/incompatible K60 DT; normal UI boot continues\n");
+        return;
+    }
+    (void)PE_parse_boot_argn("k60touchdelay", &seconds, sizeof(seconds));
+    (void)PE_parse_boot_argn("k60touchhz", &hz, sizeof(hz));
+    (void)PE_parse_boot_argn("k60_touch_rcg", &rcg, sizeof(rcg));
+    (void)PE_parse_boot_argn("touch_flip", &flip, sizeof(flip));
+    if (seconds > 60 || !hz || hz > 15000000 || flip > 3 || rcg > 1) {
+        printf("Pong touch: invalid delay/SPI/flip/clock arguments; normal UI boot continues\n");
+        return;
+    }
+    touch_stage = stage;
+    touch_delay_ms = seconds * 1000;
+    spi_hz = hz;
+    force_rcg = rcg != 0;
+    printf("Pong touch: K60 DT raw axes=%ux%u, AVDD=%u; stage %u (5 ID, 6 input, 7 GPIO ID)\n",
+        max_x, max_y, avdd_gpio, stage);
+    if (kernel_thread_start(touch_thread, NULL, &thread) == KERN_SUCCESS) {
+        thread_deallocate(thread);
+    } else {
+        printf("Pong touch: cannot start optional touch thread\n");
+    }
+}
+#endif /* PONG */

diff --git a/bsd/dev/pong_input.c b/bsd/dev/pong_input.c
new file mode 100644
index 0000000..57e74e5
--- /dev/null
+++ b/bsd/dev/pong_input.c
@@ -0,0 +1,88 @@
+/* Blocking touch queue, adapted from HackiOS redwood_input.c (APSL 2.0).
+ * Only the real Goodix driver publishes samples. No GPU/loader dependency. */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/pong_input.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+
+#define QUEUE_SIZE 512
+static LCK_GRP_DECLARE(touch_group,"pong-touch");
+static LCK_MTX_DECLARE(touch_lock,&touch_group);
+static struct pong_touch samples[QUEUE_SIZE];
+static uint32_t head,tail;
+static bool opened;
+
+void
+pong_touch_post(uint32_t type,uint32_t finger,uint32_t x,uint32_t y)
+{
+    if (type<PONG_TOUCH_DOWN || type>PONG_TOUCH_UP || finger>=10) return;
+    lck_mtx_lock(&touch_lock);
+    if (tail-head==QUEUE_SIZE) head++;
+    samples[tail++%QUEUE_SIZE]=(struct pong_touch){mach_absolute_time(),type,finger,
+        x>65535?65535:x,y>65535?65535:y};
+    lck_mtx_unlock(&touch_lock);
+    wakeup(samples);
+}
+
+static int
+touch_open(__unused dev_t dev,int flags,__unused int kind,__unused struct proc *p)
+{
+    if (flags&FWRITE) return EACCES;
+    lck_mtx_lock(&touch_lock);
+    int error=opened?EBUSY:0;
+    if (!error) {opened=true;head=tail;}
+    lck_mtx_unlock(&touch_lock);
+    return error;
+}
+
+static int
+touch_close(__unused dev_t dev,__unused int flags,__unused int kind,__unused struct proc *p)
+{
+    lck_mtx_lock(&touch_lock);opened=false;lck_mtx_unlock(&touch_lock);return 0;
+}
+
+static int
+touch_read(__unused dev_t dev,struct uio *uio,int flags)
+{
+    if (uio_resid(uio)<(user_ssize_t)sizeof(struct pong_touch)) return EINVAL;
+    int error=0;
+    lck_mtx_lock(&touch_lock);
+    while (head==tail) {
+        if (flags&IO_NDELAY) {error=EWOULDBLOCK;break;}
+        error=msleep(samples,&touch_lock,PZERO|PCATCH,"pong-touch",NULL);
+        if (error) break;
+    }
+    if (!error) {
+        struct pong_touch sample=samples[head++%QUEUE_SIZE];
+        lck_mtx_unlock(&touch_lock);
+        return uiomove((caddr_t)&sample,sizeof(sample),uio);
+    }
+    lck_mtx_unlock(&touch_lock);return error;
+}
+
+static const struct cdevsw touch_cdevsw={
+    .d_open=touch_open,.d_close=touch_close,.d_read=touch_read,.d_write=eno_rdwrt,
+    .d_ioctl=eno_ioctl,.d_stop=eno_stop,.d_reset=eno_reset,.d_select=eno_select,
+    .d_mmap=eno_mmap,.d_strategy=eno_strat,.d_type=0,
+};
+
+bool
+pong_touch_device_ready(void)
+{
+    int major=cdevsw_add(-1,&touch_cdevsw);
+    if (major<0) return false;
+    if (!devfs_make_node(makedev(major,0),DEVFS_CHAR,UID_ROOT,GID_WHEEL,0444,"pong-touch")) {
+        cdevsw_remove(major,&touch_cdevsw);return false;
+    }
+    return true;
+}
+#endif
