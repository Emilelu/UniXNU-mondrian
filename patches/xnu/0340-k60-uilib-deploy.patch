+int
+k60_uilib_deploy(void)
+{
+	static int done;
+	vfs_context_t ctx;
+	vnode_t vp = NULLVP;
+	int error, resid = 0;
+
+	if (done) {
+		return 0;
+	}
+	done = 1;
+
+	/* Always rewrite: content-addressed by the kernel build, so an existing
+	 * file from an earlier epoch is simply replaced with the same bytes. */
+	ctx = vfs_context_current();
+	error = vnode_open("/private/var/pong/libpong-ui.dylib",
+	    O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("K60UILIB vnode_open error=%d\n", error);
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)k60_uilib_blob,
+	    (ssize_t)sizeof(k60_uilib_blob), 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	printf("K60UILIB deploy bytes=%d resid=%d error=%d\n",
+	    (int)sizeof(k60_uilib_blob), resid, error);
+
+	/* 0341: same delivery for the Metal plugin bundle executable. */
+	{
+		vnode_t mp = NULLVP;
+		int merr, mresid = 0;
+
+		merr = vnode_open("/private/var/pong/PongAdrenoMetal.bundle/PongAdrenoMetal",
+		    O_CREAT | O_WRONLY | O_TRUNC, 0755, 0, &mp, ctx);
+		if (merr) {
+			printf("K60METALPLUGIN vnode_open error=%d\n", merr);
+		} else {
+			merr = vn_rdwr(UIO_WRITE, mp, (caddr_t)k60_metalplugin_blob,
+			    (ssize_t)sizeof(k60_metalplugin_blob), 0, UIO_SYSSPACE, IO_SYNC,
+			    vfs_context_ucred(ctx), &mresid, current_proc());
+			vnode_close(mp, 0, ctx);
+			printf("K60METALPLUGIN deploy bytes=%d resid=%d error=%d\n",
+			    (int)sizeof(k60_metalplugin_blob), mresid, merr);
+		}
+	}
+	return error;
+}
