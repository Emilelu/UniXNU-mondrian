+  if ((Kernel.End - Kernel.Base) > ImageSize) { Status = EFI_COMPROMISED_DATA; goto Fail; }
+  CopyMem ((VOID *)(UINTN)Address, Image, (UINTN)(Kernel.End - Kernel.Base));
