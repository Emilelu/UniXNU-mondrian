+    if (op == 0xfc00 && n && ((const uint8_t *)data)[0] == 0x1e) q->stats.tlv_sent++;
+    return run(q, deadline, 0);
+}
+int qbt_command(struct qbt *q, uint16_t op, const void *data, unsigned n, uint8_t ev,
