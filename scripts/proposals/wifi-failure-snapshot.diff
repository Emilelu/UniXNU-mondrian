+        ("int lx_pump(void) {\n  int ran = 0;",
+         "int lx_pump(void) {\n  int ran = 0;\n  __atomic_fetch_add(&diag_pumps,1,__ATOMIC_RELAXED);"),
+        ("last_raise = t; lx_irq_raise_all();",
+         "last_raise = t; __atomic_fetch_add(&diag_poll_raise,1,__ATOMIC_RELAXED); lx_irq_raise_all();"),
+        ("    g_irq[i].pending = 0; ran = 1;",
