+// ---- Read-only partition/benchmark exports (weakly imported by K60 UFS benchmark) --------------------------------
+// `native_ufs_part_find` maps the historical benchmark names "userdata"/"unixnu"
+// to the K60 LUN0 userdata partition (kPongUserdataFirst4k..Last4k); callers may
+// also pass an SHNGROOT window name "OS"/"SystemOS"/"Data".
+extern "C" int native_ufs_part_find(const char *name, uint32_t *lun, uint64_t *first, uint64_t *blocks) {
+  if (!name || !lun || !first || !blocks || !gHost.ready) return 0;
+  if (!strcmp(name, "userdata") || !strcmp(name, "unixnu")) {
+    *lun = 0;
+    *first = kPongUserdataFirst4k;
+    *blocks = kPongUserdataLast4k - kPongUserdataFirst4k + 1;
+    return 1;
+  }
+  for (unsigned i = 0; i < gRootWindowCount; ++i) {
+    if (strcmp(gRootWindows[i].name, name)) continue;
+    *lun = 0;
+    *first = gRootWindows[i].baseByte / 4096ULL;
+    *blocks = gRootWindows[i].size / 4096ULL;
+    return 1;
+  }
+  return 0;
+}
+extern "C" int native_ufs_part_read(uint32_t lun, uint64_t lba, uint32_t blocks, void *dst) {
