+static uint32_t
+pong_ar_open_playback_stream(uint8_t *out, uint32_t capacity, uint32_t port,
+    uint32_t token)
+{
+	static const PongSg sg = { AR_SG_PLAY, PERF_LOW_LATENCY, DIR_RX,
+		SCENARIO_PLAYBACK };
+	static const PongContainer c = { AR_SG_PLAY, POS_STREAM };
+	static const PongModule m[] = {
+		{ AR_MOD_WR_SHMEM, AR_IID_PLAY_SHMEM, 0, 1 },
+		{ AR_MOD_PCM_DEC, AR_IID_PLAY_DEC, 1, 1 },
+		{ AR_MOD_PCM_CNV, AR_IID_PLAY_CNV, 1, 1 }
+	};
+	static const PongLink l[] = {
+		{ AR_IID_PLAY_SHMEM, AR_IID_PLAY_DEC },
+		{ AR_IID_PLAY_DEC, AR_IID_PLAY_CNV },
+		{ AR_IID_PLAY_CNV, AR_IID_SPEAKER_I2S }
+	};
+	return pong_graph_open(out, capacity, port, token, &sg, &c, m, 3, l,
+	    3);
+}
