+/*
+ * 0334b: the automatic-reset worker.
+ *
+ * Runs in its own kernel thread, so a frozen user space, a dead USB host or an
+ * absent console cannot stop it.  It sleeps on a private wait channel: the
+ * gadget worker's ud.sleep_chan is woken by the poll loop, and reusing it
+ * would let that loop shorten this countdown.
+ *
+ * The one reset point is k60_usblog_reset_to_fastboot(), which publishes the
+ * restart reason (PMIC SDAM cell + IMEM cookie) before it resets; that is what
+ * makes ABL walk back into fastboot instead of the flashed boot image.
+ */
+static int k60_autoreset_chan;
+
+static void
+k60_autoreset_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&k60_autoreset_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+k60_autoreset_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	extern unsigned int k60_exec_count, k60_exit_count, k60_checkin_compat;
+	unsigned elapsed = 0;
+	unsigned idle = 0;
+	unsigned progress;
+
+	/*
+	 * Establish the restart reason NOW, before any timer can expire, instead
+	 * of waiting for the USB gadget worker to do it.  Without k60_usblog=2 the
+	 * gadget never starts, so on a console-less boot the SDAM cell and the
+	 * IMEM cookie used to stay untouched and every reset landed in Android.
+	 */
+	if (k60_prime_restart(2)) {
+		printf("K60AUTORESET: restart reason primed for fastboot\n");
+	} else {
+		printf("K60AUTORESET: restart reason priming FAILED\n");
+	}
+
+	progress = k60_exec_count + k60_exit_count + k60_checkin_compat;
+	printf("K60AUTORESET: armed absolute=%d idle=%d\n",
+	    k60_autoreset_secs, k60_autoreset_idle);
+	for (;;) {
+		unsigned now;
+
+		k60_autoreset_sleep_ms(1000);
+		elapsed++;
+		now = k60_exec_count + k60_exit_count + k60_checkin_compat;
+		if (now != progress) {
+			progress = now;
+			idle = 0;
+		} else {
+			idle++;
+		}
+		if (k60_autoreset_secs > 0 && (int)elapsed >= k60_autoreset_secs) {
+			printf("K60AUTORESET: %d s since boot; resetting to fastboot\n",
+			    k60_autoreset_secs);
+			break;
+		}
+		if (k60_autoreset_idle > 0 && elapsed >= K60_AUTORESET_ARM_DELAY &&
+		    (int)idle >= k60_autoreset_idle) {
+			printf("K60AUTORESET: no progress for %d s; resetting to fastboot\n",
+			    k60_autoreset_idle);
+			break;
+		}
+	}
+	k60_usblog_reset_to_fastboot();
+}
