diff --git a/bsd/kern/sys_work_interval.c b/bsd/kern/sys_work_interval.c
index 662bb00..69e04b8 100644
--- a/bsd/kern/sys_work_interval.c
+++ b/bsd/kern/sys_work_interval.c
@@ -283,6 +283,16 @@ work_interval_ctl(__unused proc_t p, struct work_interval_ctl_args *uap,
 
 		break;
 
+#if defined(PONG) && (DEVELOPMENT || DEBUG)
+	case 6:
+	case 7:
+	case 8:
+		/* HackiOS: CoreAudio performance-controller hints are optional on
+		 * this software platform. Normal render/scheduler validation remains. */
+		if (kern_work_interval_type_of_thread(current_thread()) == WORK_INTERVAL_TYPE_COREAUDIO)
+			return 0;
+		return ENOTSUP;
+#endif
 	default:
 		return ENOTSUP;
 	}
diff --git a/osfmk/kern/work_interval.c b/osfmk/kern/work_interval.c
index 95416ab..0912060 100644
--- a/osfmk/kern/work_interval.c
+++ b/osfmk/kern/work_interval.c
@@ -683,6 +683,15 @@ work_interval_get_priority(thread_t thread)
 	return priority;
 }
 
+#if defined(PONG) && (DEVELOPMENT || DEBUG)
+uint32_t
+kern_work_interval_type_of_thread(thread_t thread)
+{
+	const struct work_interval *work_interval = thread->th_work_interval;
+	return work_interval ? work_interval->wi_create_flags & WORK_INTERVAL_TYPE_MASK : WORK_INTERVAL_TYPE_LAST;
+}
+#endif
+
 /*
  * Switch to a policy driven by the work interval (if applicable).
  */
