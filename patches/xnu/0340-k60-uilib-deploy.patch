+int
+k60_uilib_deploy(void)
+{
+	static int done;
+	vfs_context_t ctx;
+	vnode_t vp = NULLVP;
+	int error, resid = 0;
+
+	if (done) {
+		return 0;
+	}
+	done = 1;
+
+	/* Always rewrite: content-addressed by the kernel build, so an existing
+	 * file from an earlier epoch is simply replaced with the same bytes. */
+	ctx = vfs_context_current();
+	error = vnode_open("/private/var/pong/libpong-ui.dylib",
+	    O_CREAT | O_WRONLY | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("K60UILIB vnode_open error=%d\n", error);
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)k60_uilib_blob,
+	    (ssize_t)sizeof(k60_uilib_blob), 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	printf("K60UILIB deploy bytes=%d resid=%d error=%d\n",
+	    (int)sizeof(k60_uilib_blob), resid, error);
+	return error;
+}
