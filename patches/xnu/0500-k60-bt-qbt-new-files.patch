+    }
+    if (q->ibs && pending && q->tx_state == QBT_ASLEEP) {
+        q->tx_state = QBT_WAKING; q->wake_attempts = 1; control(q, WAKE_IND);
+        q->retry_at = t + QBT_WAKE_RETRY; q->stats.wake_ind++;
