+static uint32_t k60_read32(const struct k60_region *r, uint32_t off) {
+    return r->va[off / 4u];
+}
+static void k60_write32(const struct k60_region *r, uint32_t off, uint32_t value) {
+    r->va[off / 4u] = value;
+#ifdef __aarch64__
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+static void k60_barrier(void) {
+#ifdef __aarch64__
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
