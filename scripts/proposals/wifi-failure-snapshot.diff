+extern "C" int nw_wifi_failure_range(const char *name,const void *cpu,
+ unsigned long long bus,unsigned long long bytes,unsigned long long low,unsigned long long high) {
+ const uint64_t begin=Iova+4096;
+ const uintptr_t va=reinterpret_cast<uintptr_t>(cpu),base=reinterpret_cast<uintptr_t>(arenaVa);
+ const bool cpuok=arenaVa&&cpu&&bytes&&va>=base&&va-base<ArenaBytes&&bytes<=ArenaBytes-(va-base);
+ const bool mapped=bytes&&bus>=begin&&bus-begin<ArenaBytes&&bytes<=ArenaBytes-(bus-begin);
+ const bool envelope=bytes&&bus>=low&&bus<=high&&bytes-1<=high-bus;
+ const bool match=cpuok&&mapped&&bus-begin==va-base;
+ IOLog("PongWifi range %s cpu=%p bus=%llx bytes=%llu arena_start=%llx arena_bytes=%llu envelope=[%llx,%llx] cpu_ok=%u mapped=%u match=%u envelope_ok=%u\n",
+  name,cpu,bus,bytes,begin,(unsigned long long)ArenaBytes,low,high,cpuok,mapped,match,envelope);
+ return cpuok&&mapped&&match&&envelope;
+}
