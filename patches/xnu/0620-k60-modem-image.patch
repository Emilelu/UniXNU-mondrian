diff --git a/bsd/dev/pong_modem_image.h b/bsd/dev/pong_modem_image.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_image.h
@@ -0,0 +1,55 @@
+/* Contract for the modem (MSS) PAS image loader (see K60ModemImage.c).
+ *
+ * Sibling of drivers/PongPower/K60AdspImage.h. Same shape on purpose: one
+ * table-driven loader per PAS subsystem, no ELF parsing at boot. The facts
+ * below come from the live Android DT and the shipped modem.mdt:
+ *
+ *   /reserved-memory/mpss_region@8bc00000  reg = 0x8bc00000 / 0x13200000
+ *   modem.mdt                              ELF32, e_phnum 32, 30 PT_LOAD
+ *
+ * Sources: docs/research/cellular/02-DT-TRUTH.md (DT bytes),
+ *          docs/research/cellular/05-MODEM-IMAGE.md (segment table).
+ */
+
+#ifndef K60_MODEM_IMAGE_H
+#define K60_MODEM_IMAGE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    K60ModemBadArg = -1,
+    K60ModemBadSegment = -2,
+    K60ModemOutsideWindow = -3,
+    K60ModemOverlap = -4,
+    K60ModemReadFailed = -5,
+};
+
+typedef struct {
+    uint32_t paddr;
+    uint32_t bytes;
+    uint32_t bss;
+    const char *part;
+} K60ModemSegment;
+
+#include "pong_modem_table.h" /* needs K60ModemSegment, declared above */
+
+typedef struct {
+    uint32_t base;
+    uint32_t window;
+    uint32_t segments;
+    uint32_t copied;
+    uint32_t zeroed;
+} K60ModemPlan;
+
+/* read(part, dst, bytes) fills dst from the named firmware file; 0 on success. */
+typedef int (*K60ModemRead)(const char *part, void *dst, uint32_t bytes);
+
+/* Validates the table only; no allocation, no device access. */
+int k60_modem_plan(K60ModemPlan *plan);
+
+/* Copies every segment and zeroes every bss tail. window is the mpss carveout. */
+int k60_modem_copy(void *window, size_t window_bytes, K60ModemRead read);
+
+#endif /* K60_MODEM_IMAGE_H */
diff --git a/bsd/dev/pong_modem_image.c b/bsd/dev/pong_modem_image.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/bsd/dev/pong_modem_image.c
@@ -0,0 +1,88 @@
+/* Modem (MSS) PAS image loader: table driven, no ELF parsing at boot.
+ *
+ * The table is generated by scripts/gen-modem-table.py from the shipped modem.mdt;
+ * scripts/tests/test-k60-modem-image.py proves it matches modem.b00..b31.
+ *
+ * Differences from the ADSP loader (drivers/PongPower/K60AdspImage.c), all of
+ * them facts about this image rather than design choices:
+ *
+ *   * base 0x8bc00000 / window 0x13200000 (306 MiB mpss_region), not 0x86300000.
+ *   * 30 PT_LOAD segments, of which three (b14, b21, b30) are pure bss with no
+ *     file at all; the ADSP image has one such row.
+ *   * the image is 109,060,761 bytes of file and 211,012,967 bytes of bss, so
+ *     zeroing dominates the copy; the loop below zeroes before it reads the
+ *     next segment's bytes and never assumes the carveout starts zeroed.
+ */
+
+#include "pong_modem_image.h"
+
+static bool in_window(uint32_t paddr, uint32_t bytes)
+{
+    return paddr >= K60_MODEM_BASE &&
+           (uint64_t)paddr + bytes <= (uint64_t)K60_MODEM_BASE + K60_MODEM_WINDOW;
+}
+
+int k60_modem_plan(K60ModemPlan *plan)
+{
+    if (!plan) {
+        return K60ModemBadArg;
+    }
+    uint32_t copied = 0, zeroed = 0;
+    uint32_t prev_end = 0;
+
+    for (uint32_t i = 0; i < K60_MODEM_SEGMENTS; i++) {
+        const K60ModemSegment *s = &k60_modem_segments[i];
+
+        if (!s->bytes && !s->bss) {
+            return K60ModemBadSegment;     /* an all-empty row hides a table bug */
+        }
+        if (s->bytes && !s->part) {
+            return K60ModemBadSegment;     /* bytes but nothing to read them from */
+        }
+        if (!in_window(s->paddr, s->bytes + s->bss)) {
+            return K60ModemOutsideWindow;
+        }
+        if (i && s->paddr < prev_end) {
+            return K60ModemOverlap;
+        }
+        prev_end = s->paddr + s->bytes + s->bss;
+        copied += s->bytes;
+        zeroed += s->bss;
+    }
+
+    plan->base = K60_MODEM_BASE;
+    plan->window = K60_MODEM_WINDOW;
+    plan->segments = K60_MODEM_SEGMENTS;
+    plan->copied = copied;
+    plan->zeroed = zeroed;
+    return 0;
+}
+
+int k60_modem_copy(void *window, size_t window_bytes, K60ModemRead read)
+{
+    if (!window || !read || window_bytes < K60_MODEM_WINDOW) {
+        return K60ModemBadArg;
+    }
+    uint8_t *dst = window;
+
+    for (uint32_t i = 0; i < K60_MODEM_SEGMENTS; i++) {
+        const K60ModemSegment *s = &k60_modem_segments[i];
+        uint8_t *at = dst + (s->paddr - K60_MODEM_BASE);
+
+        /* Byte copy, never page copy: every segment starts page aligned but
+         * its file ends elsewhere -- modem.b19 runs 0xfd0e0f bytes from
+         * 0x8fbad000 to 0x90b7de0f, modem.b25 0x13b25e bytes from 0x9dd40000
+         * to 0x9de7b25e -- so a page copy would either overrun or truncate.
+         */
+        if (s->bytes) {
+            int rc = read(s->part, at, s->bytes);
+            if (rc != 0) {
+                return K60ModemReadFailed;
+            }
+        }
+        for (uint32_t z = 0; z < s->bss; z++) {
+            at[s->bytes + z] = 0;
+        }
+    }
+    return 0;
+}
