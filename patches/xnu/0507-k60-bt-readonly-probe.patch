index 4b07f72..2170709 100644
--- a/bsd/dev/qbt_k60.c
+++ b/bsd/dev/qbt_k60.c
@@ -1004,6 +1004,148 @@ static void k60_xo_release(void) {
     k60_gpio_output(K60_BT_XO_GPIO, false, K60_TLMM_PULL_NONE, K60_TLMM_DRIVE_2MA);
