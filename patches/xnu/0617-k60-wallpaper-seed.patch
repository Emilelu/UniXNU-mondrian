+/*
+ * 0617: stage the 20G81 wallpaper catalogue in the Data view the 0616 helper
+ * inspects. The helper guards both wallpaper views with
+ * stat("/private/var/pong/stock-wallpaper/Collections/Collections~ipad.plist")
+ * and skips them while that path is missing - it only appears after the bind
+ * the guard is checking. The genuine catalogue is readable on the sealed OS
+ * volume, so copy it in; the bind then serves the real tree and hides the copy.
+ */
+static int
+k60_wallpaper_stage(void)
+{
+	static const char k60_wall_src[] =
+	    "/Library/Wallpaper/Collections/Collections~ipad.plist";
+	static const char k60_wall_dst[] =
+	    "/private/var/pong/stock-wallpaper/Collections/Collections~ipad.plist";
+	static char k60_wall_buf[8192];
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	int error;
+	int resid = 0;
+	int length;
+
+	error = vnode_open(k60_wall_src, O_RDONLY, 0, 0, &vp, ctx);
+	if (error) {
+		printf("K60WALL catalogue open error=%d\n", error);
+		return error;
+	}
+	error = vn_rdwr(UIO_READ, vp, k60_wall_buf, sizeof(k60_wall_buf), 0,
+	    UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	if (error) {
+		printf("K60WALL catalogue read error=%d\n", error);
+		return error;
+	}
+	length = (int)sizeof(k60_wall_buf) - resid;
+	if (length <= 0 || resid != 0) {
+		printf("K60WALL catalogue size=%d resid=%d rejected\n", length, resid);
+		return EINVAL;
+	}
+	error = vnode_open(k60_wall_dst, O_CREAT | O_WRONLY | O_TRUNC, 0644, 0,
+	    &vp, ctx);
+	if (error) {
+		printf("K60WALL catalogue create error=%d\n", error);
+		return error;
+	}
+	resid = 0;
+	error = vn_rdwr(UIO_WRITE, vp, k60_wall_buf, length, 0, UIO_SYSSPACE,
+	    IO_SYNC, vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, 0, ctx);
+	printf("K60WALL catalogue bytes=%d resid=%d error=%d\n",
+	    length, resid, error);
+	return error;
+}
